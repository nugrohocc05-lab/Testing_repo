<?php

namespace App\Http\Models;

use Illuminate\Database\Eloquent\Model;

class IntellocutLayermanShade extends Model
{
    protected $table = 'intellocut_layerman_shades';
    protected $guarded = [];
    public $timestamps = false;

    public function layerman()
    {
        return $this->belongsTo(IntellocutLayermanLay::class, 'idlayerman');
    }

    public function endbits()
    {
        return $this->hasMany(IntellocutLayermanEndbit::class, 'idshade');
    }
}
