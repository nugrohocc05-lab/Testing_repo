    function index()
    {
        preconnect(session('db'));

        $access = $this->getAccess();

        if (!str_contains($access, 'intellocut_layerman')) {
            return redirect(route('home'));
        }

        $table = session('layerman_table');

        if (!$table) {
            return redirect()->route('intellocutlayerman_select_table');
        }

        $tableName = MasterIntellocutTable::where('id', $table)
            ->value('nmtable');

        $data = IntellocutHeader::whereIn('id', function ($query) {
            $query->select('idheader')->from((new IntellocutShellHeader())->getTable());
        })->get();

        $shellHeaders = IntellocutShellHeader::whereIn('idheader', $data->pluck('id'))
            ->get()
            ->groupBy('idheader');

        $shellCons = $shellHeaders->flatten()->keyBy('id')->map(fn ($item) => $item->cons);

        $shellDetails = IntellocutShellDetail::whereIn('idshellheader', $shellHeaders->flatten()->pluck('id'))
            ->where('idtable', $table)
            ->orderBy('lay')
            ->get()
            ->groupBy('idshellheader');

        $styles = MasterIntellocutStyle::get()->keyBy('idstyle');
        $shells = MasterIntellocutShell::get()->keyBy('id');
        $colors = MasterIntellocutColor::get()->keyBy('id');
        $sizes  = MasterIntellocutSize::get()->keyBy('id');

        $intellocutDetails = IntellocutDetail::whereIn('idheader', $data->pluck('id'))
            ->get()
            ->groupBy('idheader');

        $layermanLays = IntellocutLayerman::whereIn('idheader', $data->pluck('id'))
            ->where('idtable', $table)
            ->get()
            ->keyBy(fn ($l) => $l->idheader . '-' . $l->idtable . '-' . $l->lay);

        $tableIds = collect([$table]);

        $data->each(function ($h) use (
            $shellHeaders,
            $shellDetails,
            $styles,
            $shells,
            $colors,
            $sizes,
            $shellCons,
            $intellocutDetails,
            $layermanLays,
            $table
        ) {
            $shellHeaderIds = ($shellHeaders[$h->id] ?? collect())->pluck('id');
            $details = $intellocutDetails[$h->id] ?? collect();

            $h->style_name = optional($styles->get($h->idstyle))->nmstyle ?? $h->idstyle;
            $h->color_name = optional($colors->get($h->idcolor))->nmcolor ?? $h->idcolor;

            $h->lay_groups = $shellHeaderIds
            ->flatMap(fn ($id) => $shellDetails[$id] ?? collect())
            ->where('idtable', $table)
            ->groupBy('idshellheader', 'lay', 'marker', 'idshell')
            ->flatMap(function ($rows) use (
                $shells,
                $colors,
                $sizes,
                $details,
                $shellCons,
                $layermanLays,
                $h,
                $table
            ) {

                return $rows->map(function ($row) use (
                    $shells,
                    $colors,
                    $sizes,
                    $details,
                    $shellCons,
                    $layermanLays,
                    $h,
                    $table
                ) {

                    $row->shell_name = optional($shells->get($row->idshell))->nmshell ?? $row->idshell;

                    $row->color_name = $details->where('idshell', $row->idshell)
                        ->pluck('idcolor')
                        ->unique()
                        ->filter()
                        ->map(fn ($id) => optional($colors->get($id))->nmcolor)
                        ->filter()
                        ->unique()
                        ->implode(', ');

                    $row->ratio_size = collect([
                        $row
                    ])->groupBy('idshellheader')->map(function ($shellRows) use ($sizes) {

                        $marker = $shellRows->first()->marker;

                        return $shellRows->values()->map(fn ($item, $index) => [
                            'ratio'  => $item->ratio,
                            'idsize' => $item->idsize,
                            'marker' => $index === 0 ? $marker : null,
                            'nmsize' => optional($sizes->get($item->idsize))->nmsize ?? $item->idsize,
                        ]);
                    });

                    $row->material_length = $shellCons->get($row->idshellheader) ?? 0;

                    $row->group_count = 1;

                    $savedLay = $layermanLays->get(
                        $h->id . '-' . $table . '-' . $row->lay
                    );

                    $row->layerman_status = $savedLay->status ?? 'not_started';

                    $row->layerman_status_label = $savedLay
                        ? $savedLay->status_label
                        : 'Not Started Yet';

                    $row->layerman_plies = $savedLay->actual_plies ?? 0;

                    return $row;
                });
            })
            ->reject(fn ($row) => $row->layerman_status === 'completed')
            ->values();
        });


        $hasActiveLay = $data->contains(fn ($d) => $d->lay_groups->isNotEmpty());

        return view('cutting::intellocutlayerman.index', compact('data', 'tableIds', 'access', 'hasActiveLay', 'tableName'));
    }

