    <script>
        $(document).ready(function() {
            var started = false;

            var urls = {
                play: "{{ route('intellocutlayerman_play', ['id' => $detail->id]) }}",
                stop: "{{ route('intellocutlayerman_stop', ['id' => $detail->id]) }}",
                save: "{{ route('intellocutlayerman_save', ['id' => $detail->id]) }}"
            };
            var homeUrl    = "{{ route('intellocutlayerman_home') }}";
            var saved      = {!! json_encode($saved ?? null, JSON_HEX_TAG | JSON_HEX_AMP) !!};
            var draftKey   = 'layerman_draft_{{ $header->id }}_{{ $detail->lay }}';
            var draftReady = false;
            var draftTimer = null;

            // ---------- Clock ----------
            function updateClock() {
                var now = new Date();
                var formattedDate = now.toLocaleDateString('en-US', {
                    weekday: 'long',
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                });
                var parts = formattedDate.replace(',', '').split(' ');
                $('#live-date').text(parts[0] + ', ' + parts[1] + ' ' + parts[2] + ' ' + parts[3]);
            }
            updateClock();
            setInterval(updateClock, 1000);

            // ---------- AJAX ----------
            function post(url, data) {
                return $.ajax({
                    url: url,
                    type: 'POST',
                    data: JSON.stringify(data || {}),
                    contentType: 'application/json',
                    dataType: 'json',
                    headers: { 'X-CSRF-TOKEN': '{{ csrf_token() }}' }
                });
            }

            function showError(xhr) {
                var msg = 'Terjadi kesalahan, coba lagi.';
                if (xhr.responseJSON) {
                    if (xhr.responseJSON.errors) {
                        msg = xhr.responseJSON.errors[Object.keys(xhr.responseJSON.errors)[0]][0];
                    } else if (xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    }
                }
                alert(msg);
            }

            // ---------- Helper ----------
            function esc(v) {
                return String(v === null || v === undefined ? '' : v)
                    .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
                    .replace(/</g, '&lt;').replace(/>/g, '&gt;');
            }

            // Nilai 0 / kosong ditampilkan sebagai placeholder
            function numVal(n) {
                return (n && parseFloat(n) !== 0) ? esc(n) : '';
            }

            // ---------- Play / Pause ----------
            function setRunning(on) {
                started = on;
                $('.lay-input, .lay-action').prop('disabled', !on);
                $('#topBar').toggleClass('running', on);
                $('.suggest-box').toggleClass('active', on);
                $('#btnPlay').toggleClass('playing', on)
                    .attr('title', on ? 'Pause' : 'Play')
                    .html(on
                        ? '<i class="bi bi-pause-fill" style="font-size: 13px;"></i>'
                        : '<i class="bi bi-play-fill" style="font-size: 13px; margin-left: 2px;"></i>');
            }

            // ---------- Templates ----------
            function yardInch(clsYard, clsInch, v, maxWidth) {
                v = v || {};
                return `
                    <input type="text" class="form-control shadow-none lay-input ${clsYard}" placeholder="0" value="${numVal(v.yard)}" style="max-width: ${maxWidth}px;">
                    <span class="text-nowrap me-1" style="font-size: 11px; font-weight: 600; color: #64748b;">- Yard</span>
                    <input type="text" class="form-control shadow-none lay-input ${clsInch}" placeholder="0" value="${numVal(v.inch)}" style="max-width: ${maxWidth}px;">
                    <span class="text-nowrap" style="font-size: 11px; font-weight: 600; color: #64748b;">- Inch</span>`;
            }

            function plusButton(cls) {
                return `
                    <button type="button" class="btn lay-action ${cls} p-0 border-0 rounded-circle d-inline-flex align-items-center justify-content-center text-white" style="width: 24px; height: 24px; background-color: #3b93b8; flex-shrink: 0;">
                        <i class="bi bi-plus-lg" style="font-size: 12px;"></i>
                    </button>`;
            }

            function endbitRowTemplate(v) {
                return `
                    <div class="endbit-row d-flex align-items-center gap-2">
                        ${yardInch('input-endbit-yard', 'input-endbit-inch', v, 115)}
                        ${plusButton('btn-add-endbit')}
                    </div>`;
            }

            function spliceRowTemplate(s) {
                s = s || {};
                return `
                    <div class="splice-row d-flex flex-wrap align-items-end gap-4 px-4 py-3" style="border-bottom: 1px solid #f1f5f9;">
                        <div style="width: 56px;">
                            <label class="form-label mb-2" style="font-size: 11px; font-weight: 600; color: #475569;">Heading</label>
                            <div class="splice-heading d-flex align-items-center" style="height: 34px; font-size: 13px; font-weight: 700; color: #1e293b;">1</div>
                        </div>
                        <div>
                            <label class="form-label mb-2" style="font-size: 11px; font-weight: 600; color: #475569;">Length</label>
                            <div class="d-flex align-items-center gap-2">
                                ${yardInch('input-splice-length-yard', 'input-splice-length-inch', s.length, 90)}
                            </div>
                        </div>
                        <div>
                            <label class="form-label mb-2" style="font-size: 11px; font-weight: 600; color: #475569;">Wastage</label>
                            <div class="d-flex align-items-center gap-2">
                                ${yardInch('input-splice-wastage-yard', 'input-splice-wastage-inch', s.wastage, 90)}
                                <span class="ms-1"></span>
                                ${plusButton('btn-add-splice')}
                            </div>
                        </div>
                    </div>`;
            }

            function shadeTemplate(s, removable) {
                s = s || {};
                var endbits = (s.endbits_generated && s.endbits_generated.length)
                    ? s.endbits_generated : [{}];
                var rows = endbits.map(function(e) { return endbitRowTemplate(e); }).join('');

                var removeBtn = removable ? `
                        <div class="d-flex justify-content-end mb-2">
                            <button type="button" class="btn lay-action btn-remove-shade p-0 border-0 text-danger" style="font-size: 11px; font-weight: 600;">
                                <i class="bi bi-trash"></i> Remove Shade
                            </button>
                        </div>` : '';
                var wrapCls = removable ? 'shade-item pt-4 mt-4' : 'shade-item';
                var wrapStyle = removable ? 'border-top: 1px solid #e2e8f0;' : '';

                return `
                    <div class="${wrapCls}" style="${wrapStyle}">
                        ${removeBtn}
                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <label class="form-label mb-2" style="font-size: 11px; font-weight: 700; color: #334155;">Shade</label>
                                <input type="text" class="form-control shadow-none lay-input input-shade" value="${esc(s.shade || '')}" style="max-width: 280px;">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-2" style="font-size: 11px; font-weight: 700; color: #334155;">Actual Plies</label>
                                <input type="text" class="form-control shadow-none lay-input input-actual-plies" placeholder="0" value="${numVal(s.actual_plies)}" style="max-width: 280px;">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-2" style="font-size: 11px; font-weight: 700; color: #334155;">Damages</label>
                                <div class="d-flex align-items-center gap-2">
                                    ${yardInch('input-damages-yard', 'input-damages-inch', s.damages, 115)}
                                </div>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label mb-2" style="font-size: 11px; font-weight: 700; color: #334155;">Endbits Generated</label>
                            <div class="endbits-list d-flex flex-column gap-2">${rows}</div>
                        </div>
                    </div>`;
            }

            // Baris terakhir = tombol +, baris lainnya = tombol -
            function syncRowButtons($rows, addCls, removeCls) {
                $rows.each(function(index) {
                    var $btn = $(this).find('.lay-action').last();
                    if (index === $rows.length - 1) {
                        $btn.removeClass(removeCls)
                            .addClass(addCls)
                            .css('background-color', '#3b93b8')
                            .html('<i class="bi bi-plus-lg" style="font-size: 12px;"></i>');
                    } else {
                        $btn.removeClass(addCls)
                            .addClass(removeCls)
                            .css('background-color', '#ef4444')
                            .html('<i class="bi bi-dash-lg" style="font-size: 12px;"></i>');
                    }
                });
            }

            // ---------- Endbits ----------
            function syncEndbitButtons($list) {
                syncRowButtons($list.find('.endbit-row'), 'btn-add-endbit', 'btn-remove-endbit');
            }

            $(document).on('click', '.btn-add-endbit', function() {
                if (!started) return;
                var $list = $(this).closest('.endbits-list');
                $list.append(endbitRowTemplate());
                syncEndbitButtons($list);
            });

            $(document).on('click', '.btn-remove-endbit', function() {
                if (!started) return;
                var $list = $(this).closest('.endbits-list');
                $(this).closest('.endbit-row').remove();
                syncEndbitButtons($list);
            });

            // ---------- Splice ----------
            function updateSpliceWastage() {
                var total = 0;
                $('#spliceList .splice-row').each(function() {
                    total += (parseFloat($(this).find('.input-splice-wastage-yard').val()) || 0) * 36
                        + (parseFloat($(this).find('.input-splice-wastage-inch').val()) || 0);
                });
                $('#sumWastageYard').val(Math.floor(total / 36));
                $('#sumWastageInch').val(+(total % 36).toFixed(4));
            }

            function syncSpliceRows() {
                var $rows = $('#spliceList .splice-row');
                $rows.each(function(index) {
                    $(this).find('.splice-heading').text(index + 1);
                });
                syncRowButtons($rows, 'btn-add-splice', 'btn-remove-splice');
                updateSpliceWastage();
            }

            function addSpliceRow(data) {
                $('#spliceList').append(spliceRowTemplate(data));
                syncSpliceRows();
            }

            $(document).on('input', '.input-splice-wastage-yard, .input-splice-wastage-inch', updateSpliceWastage);

            $('#btnAddSplice').on('click', function() {
                if (!started) return;
                addSpliceRow();
            });
            $(document).on('click', '.btn-add-splice', function() {
                if (!started) return;
                addSpliceRow();
            });
            $(document).on('click', '.btn-remove-splice', function() {
                if (!started) return;
                $(this).closest('.splice-row').remove();
                syncSpliceRows();
            });

            // ---------- Shade ----------
            function renderShades(list) {
                $('#shadeContainer').empty();
                list.forEach(function(s, i) {
                    $('#shadeContainer').append(shadeTemplate(s, i > 0));
                });
                $('.endbits-list').each(function() {
                    syncEndbitButtons($(this));
                });
            }

            $('#btnAddNewShade').on('click', function() {
                if (!started) return;
                var $new = $(shadeTemplate({}, true));
                $('#shadeContainer').append($new);
                syncEndbitButtons($new.find('.endbits-list'));
            });

            $(document).on('click', '.btn-remove-shade', function() {
                if (!started) return;
                $(this).closest('.shade-item').remove();
            });

            // ---------- Payload ----------
            function readField(field) {
                return {
                    yard: $('[data-field="' + field + '"][data-unit="yard"]').val(),
                    inch: $('[data-field="' + field + '"][data-unit="inch"]').val()
                };
            }

            function collectPayload() {
                var splices = [];
                $('#spliceList .splice-row').each(function() {
                    splices.push({
                        length: {
                            yard: $(this).find('.input-splice-length-yard').val(),
                            inch: $(this).find('.input-splice-length-inch').val()
                        },
                        wastage: {
                            yard: $(this).find('.input-splice-wastage-yard').val(),
                            inch: $(this).find('.input-splice-wastage-inch').val()
                        }
                    });
                });

                var shades = [];
                $('.shade-item').each(function() {
                    var endbits = [];
                    $(this).find('.endbit-row').each(function() {
                        endbits.push({
                            yard: $(this).find('.input-endbit-yard').val(),
                            inch: $(this).find('.input-endbit-inch').val()
                        });
                    });
                    shades.push({
                        shade: $(this).find('.input-shade').val(),
                        actual_plies: $(this).find('.input-actual-plies').val(),
                        damages: {
                            yard: $(this).find('.input-damages-yard').val(),
                            inch: $(this).find('.input-damages-inch').val()
                        },
                        endbits_generated: endbits
                    });
                });

                return {
                    material_width: readField('material_width'),
                    material_length: readField('material_length'),
                    end_loss_1: readField('end_loss_1'),
                    end_loss_2: readField('end_loss_2'),
                    splices: splices,
                    shades: shades
                };
            }

            // ---------- Draft (hanya di browser) ----------
            function saveDraft() {
                if (!draftReady) return;
                try { localStorage.setItem(draftKey, JSON.stringify(collectPayload())); } catch (e) {}
            }
            function readDraft() {
                try { return JSON.parse(localStorage.getItem(draftKey) || 'null'); } catch (e) { return null; }
            }
            function clearDraft() {
                try { localStorage.removeItem(draftKey); } catch (e) {}
            }

            $(document).on('input change click', '.lay-input, .lay-action', function() {
                clearTimeout(draftTimer);
                draftTimer = setTimeout(saveDraft, 300);
            });

            // ---------- Play / Pause ----------
            $('#btnPlay').on('click', function() {
                var $btn = $(this).prop('disabled', true);
                var turningOn = !started;

                if (!turningOn) saveDraft();   // pause: isian tetap di browser, tidak dikirim

                post(turningOn ? urls.play : urls.stop).done(function() {
                    setRunning(turningOn);
                }).fail(showError).always(function() {
                    $btn.prop('disabled', false);
                });
            });

            // ---------- Save ----------
            $('#btnSaveChanges').on('click', function() {
                if (!started) return;
                var $btn = $(this).prop('disabled', true);

                post(urls.save, collectPayload())
                    .done(function(res) {
                        clearDraft();
                        window.location.href = res.redirect || homeUrl;
                    })
                    .fail(function(xhr) {
                        showError(xhr);
                        $btn.prop('disabled', false);
                    });
            });

            // ---------- Isi form saat halaman dibuka ----------
            function fillField(field, v) {
                v = v || {};
                $('[data-field="' + field + '"][data-unit="yard"]').val(numVal(v.yard));
                $('[data-field="' + field + '"][data-unit="inch"]').val(numVal(v.inch));
            }

            function loadForm() {
                var isCompleted = !!(saved && saved.status === 'completed');

                if (isCompleted) clearDraft();

                var src = isCompleted ? saved : (readDraft() || saved);

                if (src) {
                    ['material_width', 'material_length', 'end_loss_1', 'end_loss_2'].forEach(function(f) {
                        fillField(f, src[f]);
                    });
                    (src.splices || []).forEach(function(s) { addSpliceRow(s); });
                }

                var shades = (src && src.shades && src.shades.length) ? src.shades : [{}];
                renderShades(shades);
                updateSpliceWastage();

                setRunning(!!(saved && saved.status === 'running'));

                if (isCompleted) {
                    $('#btnPlay, #btnSaveChanges, #btnAddNewShade, #btnAddSplice').hide();
                }

                draftReady = !isCompleted;
            }
            loadForm();
        });
    </script>
@endsection


