function play($id)
{
    $detail      = IntellocutShellDetail::findOrFail($id);
    $shellHeader = IntellocutShellHeader::findOrFail($detail->idshellheader);
    $header      = IntellocutHeader::findOrFail($shellHeader->idheader);

    $existing = IntellocutLayermanLay::where('idheader', $header->id)
        ->where('lay', $detail->lay)
        ->first();

    if ($existing && $existing->status === 'completed') {
        return response()->json(['message' => 'Lay ini sudah selesai.'], 422);
    }

    $lay = DB::transaction(function () use ($header, $detail) {
        $lay = IntellocutLayermanLay::firstOrCreate(
            ['idheader' => $header->id, 'lay' => $detail->lay],
            [
                'idshelldetail' => $detail->id,
                'idtable'       => $detail->idtable,
                'iduser'        => optional(session('user'))->id ?? auth()->id(),
            ]
        );

        $lay->status     = 'running';
        $lay->started_at = $lay->started_at ?: now();
        $lay->stopped_at = null;
        $lay->save();

        // Waktu Play pertama dicatat di shell detail, tidak ditimpa saat Play ulang
        if (!$detail->lays_started) {
            $detail->lays_started = now();
            $detail->save();
        }

        return $lay;
    });

    return response()->json([
        'success'      => true,
        'status'       => $lay->status,
        'status_label' => $lay->status_label,
    ]);
}