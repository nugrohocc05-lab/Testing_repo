    function laystarted($id)
    {
        preconnect(session('db'));

        $access = $this->getAccess();

        if (!str_contains($access, 'intellocut_layerman')) {
            return redirect(route('home'));
        }

        [$detail, $shellHeader, $header] = $this->resolveContext($id);

        $order = IntellocutDetail::where('idheader', $header->id)
            ->where('idshell', $detail->idshell)
            ->first();

        $orderRemark = $header->remark;

        $fabricId   = optional(IntellocutShellGroupFabric::where('idshellheader', $shellHeader->id)->first())->idfabric;
        $fabricName = optional(MasterIntellocutFabric::find($fabricId))->nmfabric ?? '-';

        $styleName = optional(MasterIntellocutStyle::where('idstyle', $header->idstyle)->first())->nmstyle
            ?? $header->idstyle;

        $shellName = optional(MasterIntellocutShell::find($detail->idshell))->nmshell
            ?? $detail->idshell;

        $colorName = optional(MasterIntellocutColor::find(optional($order)->idcolor))->nmcolor
            ?? optional($order)->idcolor;

        $sizes = MasterIntellocutSize::get()->keyBy('id');

        // Ratio hanya untuk part + lay ini
        $ratioSize = IntellocutShellDetail::where('idshellheader', $detail->idshellheader)
            ->where('lay', $detail->lay)
            ->where('idtable', $detail->idtable)
            ->where('idshell', $detail->idshell)
            ->orderBy('id')
            ->get()
            ->map(fn ($item) => [
                'ratio'  => $item->ratio,
                'idsize' => $item->idsize,
                'marker' => $item->marker,
                'nmsize' => optional($sizes->get($item->idsize))->nmsize ?? $item->idsize,
            ]);

        $saved = $this->formatSaved(
            IntellocutLayerman::with('splices', 'shades.endbits')
                ->where('idheader', $header->id)
                ->where('idtable', $detail->idtable)
                ->where('lay', $detail->lay)
                ->where('idshell', $detail->idshell)
                ->first()
        );

        $headerShellIds = IntellocutShellHeader::where('idheader', $header->id)->pluck('id');

        $defaultWidth      = (float) $detail->width;
        $defaultWidthInch  = (float) $detail->width_inch;
        $defaultLength     = (float) $detail->marker_length;
        $defaultLengthInch = (float) $detail->marker_length_inch;
        $defaultEndLoss    = (float) $detail->end_loss;

        $groupOptions = IntellocutShellDetail::where('idtable', $detail->idtable)
            ->whereIn('idshellheader', $headerShellIds)
            ->whereNotNull('group')
            ->where('group', '<>', '')
            ->distinct()
            ->orderBy('group')
            ->pluck('group')
            ->values();

        return view('cutting::intellocutlayerman.inputlayerman', compact(
            'access', 'header', 'detail', 'order', 'orderRemark', 'styleName', 'shellName', 'colorName',
            'fabricName', 'ratioSize', 'saved', 'defaultWidth', 'defaultWidthInch', 'defaultLength',
            'defaultLengthInch', 'defaultEndLoss', 'groupOptions'
        ));
    }

    function play($id)
    {
        [$detail, , $header] = $this->resolveContext($id);

        $existing = $this->findLay($header, $detail);

        if ($existing && $existing->status === 'completed') {
            return response()->json(['message' => 'This lay is finished.'], 422);
        }

        $lay = DB::transaction(function () use ($header, $detail) {
            $lay = IntellocutLayerman::firstOrCreate(
                [
                    'idheader' => $header->id,
                    'idtable'  => $detail->idtable,
                    'lay'      => $detail->lay,
                    'idshell'  => $detail->idshell,
                ],
                [
                    'idshelldetail' => $detail->id,
                    'marker'        => $detail->marker,
                    'iduser'        => optional(session('user'))->id ?? auth()->id(),
                ]
            );

            $lay->status     = 'running';
            $lay->started_at = $lay->started_at ?: now();
            $lay->stopped_at = null;
            $lay->save();

            // Tandai semua baris size milik part + lay ini
            $this->partDetailsQuery($header, $detail)
                ->whereNull('lays_started')
                ->update(['lays_started' => now()]);

            return $lay;
        });

        return $this->statusResponse($lay);
    }

    function stop($id)
    {
        [$detail, , $header] = $this->resolveContext($id);

        $lay = $this->findLay($header, $detail);

        if (!$lay) {
            return response()->json(['message' => "It hasn't started yet. Press Play first."], 422);
        }

        if ($lay->status === 'completed') {
            return response()->json(['message' => 'This lay is finished.'], 422);
        }

        $lay->status     = 'stopped';
        $lay->stopped_at = now();
        $lay->save();

        return $this->statusResponse($lay);
    }

    function save(Request $request, $id)
    {
        [$detail, , $header] = $this->resolveContext($id);

        $lay = $this->findLay($header, $detail);

        if (!$lay || $lay->status !== 'running') {
            return response()->json(['message' => 'Press Play first.'], 422);
        }

        $this->validate($request, $this->payloadRules());

        DB::transaction(function () use ($lay, $request, $detail, $header) {
            $this->persist($lay, $request);

            $lay->status     = 'completed';
            $lay->stopped_at = now();
            $lay->save();

            // Hanya part + lay ini yang ditandai selesai
            $this->partDetailsQuery($header, $detail)
                ->update([
                    'actual_plies'   => $lay->actual_plies,
                    'lays_completed' => now(),
                ]);
        });

        return response()->json([
            'success'  => true,
            'redirect' => route('intellocutlayerman_home'),
        ]);
    }

    /**
     * Daftar endbit yang bisa dipakai lay ini.
     * Sumber: lay completed di order yang sama, belum terpakai, bukan dari lay ini.
     * Suggested = panjang endbit lebih besar dari marker length lay ini.
     */
    function endbits($id)
    {
        [$detail, , $header] = $this->resolveContext($id);

        $lay  = $this->findLay($header, $detail);
        $myId = optional($lay)->id ?? 0;

        $conn = (new IntellocutLayermanEndbit())->getConnection();

        $eT = (new IntellocutLayermanEndbit())->getTable();
        $sT = (new IntellocutLayerman())->shades()->getRelated()->getTable();
        $lT = (new IntellocutLayerman())->getTable();

        // Marker length lay ini dalam inch.
        // Jika marker_length_inch ternyata sudah panjang TOTAL dalam inch, ganti jadi:
        //   $markerInch = (float) $detail->marker_length_inch;
        $markerInch = ((float) $detail->marker_length * 36) + (float) $detail->marker_length_inch;

        $shells = MasterIntellocutShell::pluck('nmshell', 'id');

        $rows = $conn->table("$eT as e")
            ->join("$sT as s", 's.id', '=', 'e.idshade')
            ->join("$lT as l", 'l.id', '=', 's.idlayerman')
            ->where('l.idheader', $header->id)
            ->where('l.status', 'completed')
            ->where('l.id', '<>', $myId)
            ->where(function ($q) use ($myId) {
                $q->whereNull('e.used_by_layerman');
                if ($myId) {
                    $q->orWhere('e.used_by_layerman', $myId); // sudah dipilih lay ini
                }
            })
            // abaikan endbit kosong (panjang 0)
            ->where(function ($q) {
                $q->where('e.length_yard', '>', 0)->orWhere('e.length_inch', '>', 0);
            })
            ->orderBy('l.lay')
            ->orderBy('e.id')
            ->get(['e.id', 'e.length_yard', 'e.length_inch', 's.shade', 'l.lay', 'l.idshell']);

        $endbits = $rows->map(function ($r) use ($markerInch, $shells) {
            $endbitInch = ((float) $r->length_yard * 36) + (float) $r->length_inch;

            return [
                'id'          => (int) $r->id,
                'lay'         => $r->lay,
                'part'        => $shells[$r->idshell] ?? $r->idshell,
                'shade'       => $r->shade,
                'length_yard' => (float) $r->length_yard,
                'length_inch' => (float) $r->length_inch,
                'suggested'   => $endbitInch > $markerInch,
            ];
        })->values();

        return response()->json(['success' => true, 'endbits' => $endbits]);
    }

    function selecttable()
    {
        preconnect(session('db'));

        $access = $this->getAccess();

        if (!str_contains($access, 'intellocut_layerman')) {
            return redirect(route('home'));
        }

        $tables = IntellocutShellDetail::whereNotNull('idtable')
            ->where('idtable', '<>', '')
            ->distinct()
            ->orderBy('idtable')
            ->pluck('idtable');

        $nmtable = MasterIntellocutTable::whereIn('id', $tables)
            ->pluck('nmtable', 'id');

        return view('cutting::intellocutlayerman.selecttable',
            compact('tables', 'nmtable', 'access')
        );
    }

    function settable(Request $request)
    {
        $this->validate($request, ['table' => 'required']);

        session(['layerman_table' => $request->table]);

        return redirect()->route('intellocutlayerman_home');
    }

    private function getAccess()
    {
        $user = ApprovalUser::select('approval_type')
            ->where('userid_approval', session('user')->nik)
            ->where('factory_id', session('db')->iddb)
            ->where('approval_type', 'LIKE', 'intellocut%')
            ->get();

        return $user->pluck('approval_type')->implode('-');
    }

    private function resolveContext($id)
    {
        $detail      = IntellocutShellDetail::findOrFail($id);
        $shellHeader = IntellocutShellHeader::findOrFail($detail->idshellheader);
        $header      = IntellocutHeader::findOrFail($shellHeader->idheader);

        return [$detail, $shellHeader, $header];
    }

    // Record layerman = header + table + lay + part
    private function findLay($header, $detail)
    {
        return IntellocutLayerman::where('idheader', $header->id)
            ->where('idtable', $detail->idtable)
            ->where('lay', $detail->lay)
            ->where('idshell', $detail->idshell)
            ->first();
    }

    // Semua baris shell detail (semua size) milik part + lay yang sedang dikerjakan
    private function partDetailsQuery($header, $detail)
    {
        return IntellocutShellDetail::where('idtable', $detail->idtable)
            ->where('lay', $detail->lay)
            ->where('idshell', $detail->idshell)
            ->whereIn(
                'idshellheader',
                IntellocutShellHeader::where('idheader', $header->id)->pluck('id')
            );
    }

    private function statusResponse($lay)
    {
        return response()->json([
            'success'      => true,
            'status'       => $lay->status,
            'status_label' => $lay->status_label,
        ]);
    }

    private function payloadRules()
    {
        $rules = [
            'splices'               => 'nullable|array',
            'shades'                => 'required|array|min:1',
            'shades.*.shade'        => 'required|string|max:50',
            'shades.*.actual_plies' => 'required|integer|min:0',
            'used_endbits'          => 'nullable|array',
            'used_endbits.*'        => 'integer',
        ];

        $measures = [
            'material_width', 'material_length',
            'splices.*.length', 'splices.*.wastage',
            'shades.*.damages', 'shades.*.endbits_generated.*',
        ];

        foreach ($measures as $m) {
            $rules[$m . '.yard'] = 'nullable|numeric|min:0';
            $rules[$m . '.inch'] = 'nullable|numeric|min:0';
        }

        foreach (['material_width', 'material_length', 'splices.*.length', 'splices.*.wastage'] as $m) {
            $rules[$m . '.yard'] = 'required_without:' . $m . '.inch|nullable|numeric|min:0';
            $rules[$m . '.inch'] = 'required_without:' . $m . '.yard|nullable|numeric|min:0';
        }

        return $rules;
    }

    private function yardInch($value)
    {
        return [
            round((float) data_get($value, 'yard', 0), 4),
            round((float) data_get($value, 'inch', 0), 4),
        ];
    }

    private function persist($lay, Request $request)
    {
        foreach (['material_width', 'material_length'] as $field) {
            if ($request->has($field)) {
                [$yard, $inch] = $this->yardInch($request->input($field));
                $lay->{$field . '_yard'} = $yard;
                $lay->{$field . '_inch'} = $inch;
            }
        }

        if ($request->has('end_loss')) {
            $lay->end_loss = round((float) $request->input('end_loss.inch', 0), 4);
        }

        $lay->splices()->delete();
        foreach (array_values($request->input('splices', [])) as $n => $row) {
            [$lengthYard, $lengthInch]   = $this->yardInch(data_get($row, 'length'));
            [$wastageYard, $wastageInch] = $this->yardInch(data_get($row, 'wastage'));

            $lay->splices()->create([
                'heading'      => $n + 1,
                'length_yard'  => $lengthYard,
                'length_inch'  => $lengthInch,
                'wastage_yard' => $wastageYard,
                'wastage_inch' => $wastageInch,
            ]);
        }

        IntellocutLayermanEndbit::whereIn('idshade', $lay->shades()->pluck('id'))->delete();
        $lay->shades()->delete();

        $totalPlies = 0;
        foreach (array_values($request->input('shades', [])) as $row) {
            $plies = (int) data_get($row, 'actual_plies', 0);
            $totalPlies += $plies;

            [$damageYard, $damageInch] = $this->yardInch(data_get($row, 'damages'));

            $shade = $lay->shades()->create([
                'shade'        => data_get($row, 'shade'),
                'actual_plies' => $plies,
                'damages_yard' => $damageYard,
                'damages_inch' => $damageInch,
            ]);

            foreach (array_values(data_get($row, 'endbits_generated', [])) as $endbit) {
                [$endbitYard, $endbitInch] = $this->yardInch($endbit);

                // Lewati baris kosong, supaya tidak tersimpan endbit panjang 0
                if ($endbitYard <= 0 && $endbitInch <= 0) {
                    continue;
                }

                $shade->endbits()->create([
                    'length_yard' => $endbitYard,
                    'length_inch' => $endbitInch,
                ]);
            }
        }

        $this->syncUsedEndbits($lay, $request);

        $lay->actual_plies = $totalPlies;
        $lay->save();
    }

    /**
     * Catat endbit yang dipakai lay ini (kolom used_by_layerman).
     * Dipanggil di dalam transaksi save().
     */
    private function syncUsedEndbits($lay, Request $request)
    {
        $ids = array_values(array_unique(array_map('intval', $request->input('used_endbits', []))));

        // Lepas pemakaian lama lay ini
        IntellocutLayermanEndbit::where('used_by_layerman', $lay->id)
            ->update(['used_by_layerman' => null]);

        if (!$ids) {
            return;
        }

        $eT = (new IntellocutLayermanEndbit())->getTable();
        $sT = $lay->shades()->getRelated()->getTable();
        $lT = $lay->getTable();

        // Kunci baris dan pastikan: satu order, lay completed, bukan milik lay ini, belum terpakai
        $allowed = $lay->getConnection()->table("$eT as e")
            ->join("$sT as s", 's.id', '=', 'e.idshade')
            ->join("$lT as l", 'l.id', '=', 's.idlayerman')
            ->whereIn('e.id', $ids)
            ->where('l.idheader', $lay->idheader)
            ->where('l.status', 'completed')
            ->where('l.id', '<>', $lay->id)
            ->whereNull('e.used_by_layerman')
            ->lockForUpdate()
            ->pluck('e.id');

        if ($allowed->count() !== count($ids)) {
            throw ValidationException::withMessages([
                'used_endbits' => 'Some selected endbits are no longer available. Press Refresh and select again.',
            ]);
        }

        IntellocutLayermanEndbit::whereIn('id', $ids)->update(['used_by_layerman' => $lay->id]);
    }

    private function formatSaved($lay)
    {
        if (!$lay) {
            return null;
        }

        $yi = fn ($yard, $inch) => [
            'yard' => (float) $yard,
            'inch' => (float) $inch,
        ];

        return [
            'status'          => $lay->status,
            'actual_plies'    => (int) $lay->actual_plies,
            'material_width'  => $yi($lay->material_width_yard, $lay->material_width_inch),
            'material_length' => $yi($lay->material_length_yard, $lay->material_length_inch),
            'end_loss'        => ['yard' => 0, 'inch' => (float) $lay->end_loss],
            'splices'         => $lay->splices->sortBy('heading')->values()->map(fn ($s) => [
                'length'  => $yi($s->length_yard, $s->length_inch),
                'wastage' => $yi($s->wastage_yard, $s->wastage_inch),
            ])->all(),
            'shades'          => $lay->shades->sortBy('id')->values()->map(fn ($s) => [
                'shade'             => $s->shade,
                'actual_plies'      => (int) $s->actual_plies,
                'damages'           => $yi($s->damages_yard, $s->damages_inch),
                'endbits_generated' => $s->endbits->values()
                    ->map(fn ($e) => $yi($e->length_yard, $e->length_inch))->all(),
            ])->all(),
            'used_endbits'    => IntellocutLayermanEndbit::where('used_by_layerman', $lay->id)
                ->pluck('id')->map(fn ($v) => (int) $v)->all(),
        ];
    }
