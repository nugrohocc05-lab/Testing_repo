// Nilai yang sama dengan yang tampil di index
$shellHeaderIds = IntellocutShellDetail::where('idtable', $detail->idtable)
    ->where('lay', $detail->lay)
    ->whereIn('idshellheader', IntellocutShellHeader::where('idheader', $header->id)->pluck('id'))
    ->pluck('idshellheader')
    ->unique();

$defaultWidth  = (float) $detail->width;
$defaultLength = (float) IntellocutShellHeader::whereIn('id', $shellHeaderIds)->sum('cons');

return view('cutting::intellocutlayerman.inputlayerman', compact(
    'header', 'detail', 'order', 'styleName', 'shellName', 'colorName',
    'fabricName', 'ratioSize', 'saved', 'defaultWidth', 'defaultLength'
));

// Nilai awal dari index. Width masuk ke Yard, Length masuk ke Inch.
var DEFAULTS = {
    material_width:  { yard: {{ $defaultWidth }}, inch: '' },
    material_length: { yard: '', inch: {{ $defaultLength }} }
};

function isEmptyMeasure(v) {
    return !v || ((!v.yard || parseFloat(v.yard) === 0) && (!v.inch || parseFloat(v.inch) === 0));
}

MEASURE_FIELDS.forEach(function(field) {
    var value = source ? source[field] : null;

    // Kosong dan lay belum selesai: pakai nilai dari index
    if (!isCompleted && isEmptyMeasure(value) && DEFAULTS[field]) {
        value = DEFAULTS[field];
    }

    fillField(field, value);
});

if (source) {
    (source.splices || []).forEach(addSpliceRow);
}

foreach (['material_width', 'material_length'] as $m) {
    $rules[$m . '.yard'] = 'required_without:' . $m . '.inch|nullable|numeric|min:0';
    $rules[$m . '.inch'] = 'required_without:' . $m . '.yard|nullable|numeric|min:0';
}

