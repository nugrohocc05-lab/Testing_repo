    private function getAccess()
    {
        $user = ApprovalUser::select('approval_type')
            ->where('userid_approval', session('user')->nik)
            ->where('factory_id', session('db')->iddb)
            ->where('approval_type', 'LIKE', 'intellocut%')
            ->get();

        return $user->pluck('approval_type')->implode('-');
    }

    private function resolveContext($id)
    {
        $detail      = IntellocutShellDetail::findOrFail($id);
        $shellHeader = IntellocutShellHeader::findOrFail($detail->idshellheader);
        $header      = IntellocutHeader::findOrFail($shellHeader->idheader);

        return [$detail, $shellHeader, $header];
    }

    private function findLay($header, $detail)
    {
        return IntellocutLayerman::where('idheader', $header->id)
            ->where('idtable', $detail->idtable)
            ->where('lay', $detail->lay)
            ->first();
    }

    private function statusResponse($lay)
    {
        return response()->json([
            'success'      => true,
            'status'       => $lay->status,
            'status_label' => $lay->status_label,
        ]);
    }

    private function payloadRules()
    {
        $rules = [
            'splices'               => 'nullable|array',
            'shades'                => 'required|array|min:1',
            'shades.*.shade'        => 'required|string|max:50',
            'shades.*.actual_plies' => 'required|integer|min:0',
        ];

        $measures = [
            'material_width', 'material_length',
            'splices.*.length', 'splices.*.wastage',
            'shades.*.damages', 'shades.*.endbits_generated.*',
        ];

        foreach ($measures as $m) {
            $rules[$m . '.yard'] = 'nullable|numeric|min:0';
            $rules[$m . '.inch'] = 'nullable|numeric|min:0';
        }

        foreach (['material_width', 'material_length', 'splices.*.length', 'splices.*.wastage'] as $m) {
            $rules[$m . '.yard'] = 'required_without:' . $m . '.inch|nullable|numeric|min:0';
            $rules[$m . '.inch'] = 'required_without:' . $m . '.yard|nullable|numeric|min:0';
        }

        return $rules;
    }

    private function yardInch($value)
    {
        return [
            round((float) data_get($value, 'yard', 0), 4),
            round((float) data_get($value, 'inch', 0), 4),
        ];
    }

    private function persist($lay, Request $request)
    {
        foreach (['material_width', 'material_length'] as $field) {
            if ($request->has($field)) {
                [$yard, $inch] = $this->yardInch($request->input($field));
                $lay->{$field . '_yard'} = $yard;
                $lay->{$field . '_inch'} = $inch;
            }
        }

        if ($request->has('end_loss')) {
            $lay->end_loss = round((float) $request->input('end_loss.inch', 0), 4);
        }

        $lay->splices()->delete();
        foreach (array_values($request->input('splices', [])) as $n => $row) {
            [$lengthYard, $lengthInch]   = $this->yardInch(data_get($row, 'length'));
            [$wastageYard, $wastageInch] = $this->yardInch(data_get($row, 'wastage'));

            $lay->splices()->create([
                'heading'      => $n + 1,
                'length_yard'  => $lengthYard,
                'length_inch'  => $lengthInch,
                'wastage_yard' => $wastageYard,
                'wastage_inch' => $wastageInch,
            ]);
        }

        IntellocutLayermanEndbit::whereIn('idshade', $lay->shades()->pluck('id'))->delete();
        $lay->shades()->delete();

        $totalPlies = 0;
        foreach (array_values($request->input('shades', [])) as $row) {
            $plies = (int) data_get($row, 'actual_plies', 0);
            $totalPlies += $plies;

            [$damageYard, $damageInch] = $this->yardInch(data_get($row, 'damages'));

            $shade = $lay->shades()->create([
                'shade'        => data_get($row, 'shade'),
                'actual_plies' => $plies,
                'damages_yard' => $damageYard,
                'damages_inch' => $damageInch,
            ]);

            foreach (array_values(data_get($row, 'endbits_generated', [])) as $endbit) {
                [$endbitYard, $endbitInch] = $this->yardInch($endbit);

                $shade->endbits()->create([
                    'length_yard' => $endbitYard,
                    'length_inch' => $endbitInch,
                ]);
            }
        }

        $lay->actual_plies = $totalPlies;
        $lay->save();
    }

    private function formatSaved($lay)
    {
        if (!$lay) {
            return null;
        }

        $yi = fn ($yard, $inch) => [
            'yard' => (float) $yard,
            'inch' => (float) $inch,
        ];

        return [
            'status'          => $lay->status,
            'actual_plies'    => (int) $lay->actual_plies,
            'material_width'  => $yi($lay->material_width_yard, $lay->material_width_inch),
            'material_length' => $yi($lay->material_length_yard, $lay->material_length_inch),
            'end_loss'        => ['yard' => 0, 'inch' => (float) $lay->end_loss],
            'splices'         => $lay->splices->sortBy('heading')->values()->map(fn ($s) => [
                'length'  => $yi($s->length_yard, $s->length_inch),
                'wastage' => $yi($s->wastage_yard, $s->wastage_inch),
            ])->all(),
            'shades'          => $lay->shades->sortBy('id')->values()->map(fn ($s) => [
                'shade'             => $s->shade,
                'actual_plies'      => (int) $s->actual_plies,
                'damages'           => $yi($s->damages_yard, $s->damages_inch),
                'endbits_generated' => $s->endbits->values()
                    ->map(fn ($e) => $yi($e->length_yard, $e->length_inch))->all(),
            ])->all(),
        ];
    }
