    /**
     * Dashboard: 1 order = 1 kartu induk,
     * anak = 1 part (idshell) + 1 lay. Semua size digabung jadi teks ratio.
     */
    function index()
    {
        preconnect(session('db'));

        $access = $this->getAccess();

        if (!str_contains($access, 'intellocut_layerman')) {
            return redirect(route('home'));
        }

        $table = session('layerman_table');

        if (!$table) {
            return redirect()->route('intellocutlayerman_select_table');
        }

        $tableName = MasterIntellocutTable::where('id', $table)->value('nmtable');

        $sd     = (new IntellocutShellDetail())->getTable();
        $sh     = (new IntellocutShellHeader())->getTable();
        $hd     = (new IntellocutHeader())->getTable();
        $detail = (new IntellocutDetail())->getTable();
        $lay    = (new IntellocutLayerman())->getTable();
        $style  = (new MasterIntellocutStyle())->getTable();
        $shell  = (new MasterIntellocutShell())->getTable();
        $size   = (new MasterIntellocutSize())->getTable();
        $color  = (new MasterIntellocutColor())->getTable();

        $rows = DB::table("$sd as sd")
            ->join("$sh as sh", 'sh.id', '=', 'sd.idshellheader')
            ->join("$hd as h", 'h.id', '=', 'sh.idheader')
            ->leftJoin("$style as st", 'st.idstyle', '=', 'h.idstyle')
            ->leftJoin("$shell as ms", 'ms.id', '=', 'sd.idshell')
            ->leftJoin("$size as sz", 'sz.id', '=', 'sd.idsize')
            ->leftJoin("$lay as l", function ($join) {
                $join->on('l.idheader', '=', 'sh.idheader')
                    ->on('l.idtable', '=', 'sd.idtable')
                    ->on('l.lay', '=', 'sd.lay')
                    ->on('l.idshell', '=', 'sd.idshell');
            })
            ->where('sd.idtable', $table)
            // sembunyikan lay yang sudah selesai
            ->where(function ($q) {
                $q->whereNull('l.status')->orWhere('l.status', '<>', 'completed');
            })
            // 1 baris = 1 part + 1 lay
            ->groupBy(
                'h.id', 'h.order_number', 'h.created_at', 'st.nmstyle',
                'sd.idshellheader', 'sd.lay', 'sd.idshell', 'ms.nmshell',
                'l.status', 'l.actual_plies'
            )
            ->orderBy('h.id')
            ->orderBy('sd.lay')
            ->orderBy('sd.idshell')
            ->selectRaw("
                h.id                    as idheader,
                h.order_number,
                h.created_at,
                COALESCE(st.nmstyle, h.idstyle) as style_name,
                COALESCE(ms.nmshell, sd.idshell) as shell_name,
                sd.idshellheader,
                sd.lay,
                sd.idshell,
                MIN(sd.id)              as id,
                GROUP_CONCAT(DISTINCT sd.`group` ORDER BY sd.`group` SEPARATOR ',') as grp,
                MAX(sd.marker)          as marker,
                MAX(sd.marker_length)   as marker_length,
                MAX(sd.width)           as width,
                MAX(sd.plies)           as plies,
                COALESCE(l.status, 'not_started') as layerman_status,
                COALESCE(l.actual_plies, 0)       as layerman_plies,
                GROUP_CONCAT(CONCAT(sd.ratio, '-', COALESCE(sz.nmsize, sd.idsize)) ORDER BY sd.id SEPARATOR ' | ') as ratio_text,
                (SELECT GROUP_CONCAT(DISTINCT c.nmcolor SEPARATOR ', ')
                   FROM $detail d
                   JOIN $color c ON c.id = d.idcolor
                  WHERE d.idheader = h.id AND d.idshell = sd.idshell) as color_name
            ")
            ->get();

        $orders       = $rows->groupBy('idheader');
        $hasActiveLay = $rows->isNotEmpty();

        return view('cutting::intellocutlayerman.index', compact('orders', 'access', 'hasActiveLay', 'tableName'));
    }

    function layassign()
    {
