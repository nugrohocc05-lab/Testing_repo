function actionButton(cls, color, icon) {
    return `
        <button type="button"
            class="btn lay-action ${cls} p-0 border-0 rounded-circle d-inline-flex align-items-center justify-content-center text-white"
            style="width: 24px; height: 24px; background-color: ${color}; flex-shrink: 0;">
            <i class="bi bi-${icon}-lg" style="font-size: 12px;"></i>
        </button>`;
}

// wadah tombol, isinya diatur oleh syncRowButtons
function rowActions() {
    return '<div class="row-actions d-flex align-items-center gap-1" style="min-width: 52px; flex-shrink: 0;"></div>';
}

${yardInch('input-endbit-yard', 'input-endbit-inch', value, 100)}
${rowActions()}

${yardInch('input-splice-wastage-yard', 'input-splice-wastage-inch', splice.wastage, 0)}
${rowActions()}

// Hanya baris terakhir yang punya tombol: + selalu, - jika baris > 1
function syncRowButtons($rows, addClass, removeClass) {
    $rows.each(function(index) {
        var isLast = index === $rows.length - 1;
        var $box = $(this).find('.row-actions').empty();

        if (!isLast) return;

        var html = actionButton(addClass, '#3b93b8', 'plus');
        if ($rows.length > 1) {
            html += actionButton(removeClass, '#ef4444', 'dash');
        }

        $box.html(html).find('.lay-action').prop('disabled', !started);
    });
}

