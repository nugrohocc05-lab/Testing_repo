function priorityFinal(Request $request)
{
    preconnect(session('db'));

    $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
    $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

    $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
    $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

    $fi  = (new OutputDetailFinalInspection())->getTable();
    $od  = (new OutputDetail())->getTable();
    $po  = (new PurchaseOrder())->getTable();
    $dbr = (new HistoryDataBreakdown())->getTable();

    // Filter umum
    $applyCommonFilters = function ($query) use ($request, $po, $dbr) {

        if ($request->filled('groupbuyer') && $request->groupbuyer !== 'all') {
            $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)
                ->pluck('idbuyer');

            $query->whereIn("$po.idbuyer", $buyerIds);
        }

        if ($request->filled('po') && $request->po !== 'all') {
            $query->where("$dbr.idpo", $request->po);
        }

        if ($request->filled('style') && $request->style !== 'all') {
            $query->where("$po.idstyle", $request->style);
        }

        return $query;
    };

    $requireHasFinalRecord = function ($query) use ($fi, $od, $dbr) {
        $query->whereExists(function ($q) use ($fi, $od, $dbr) {
            $q->select(DB::raw(1))
                ->from("$fi as fi3")
                ->join("$od as od3", "od3.barcode", '=', 'fi3.barcode')
                ->whereColumn('od3.idpo', "$dbr.idpo");
        });
        return $query;
    };

    $excludeIfAnyFinal = function ($query) use ($fi, $od, $dbr) {
        $query->whereNotExists(function ($q) use ($fi, $od, $dbr) {
            $q->select(DB::raw(1))
                ->from("$fi as fi2")
                ->join("$od as od2", "od2.barcode", '=', 'fi2.barcode')
                ->whereColumn('od2.idpo', "$dbr.idpo")
                ->where('fi2.is_output', 1);
        });
        return $query;
    };

    $listQuery = HistoryDataBreakdown::query()
        ->join($po, "$po.idpo", '=', "$dbr.idpo")
        ->whereBetween(
            "$dbr.deliverydate",
            [$dta, $dtb]
        )
        ->where("$dbr.production_status", "IH")
        ->whereNotExists(function ($q) use ($dbr) {
            $q->from("$dbr as dbr2")
                ->whereColumn("dbr2.combine_pro", "$dbr.combine_pro")
                ->where("dbr2.revisi_kp", 1)
                ->whereNotNull("dbr2.kp_item_ref")
                ->whereColumn("dbr2.idpo", ">", "$dbr.idpo");
        });

    $requireHasFinalRecord($listQuery);
    $excludeIfAnyFinal($listQuery);
    $applyCommonFilters($listQuery);

    // ============================
    // HARDCODED DEBUG — otomatis jalan tiap klik Find, ganti angka ini sesuai kebutuhan
    // ============================
    $debugTarget = '1292'; // <-- ganti ke PO yang mau dicek

    $poRow = PurchaseOrder::where('idpo', 'like', "%$debugTarget%")
        ->orWhere('po', 'like', "%$debugTarget%")
        ->select('idpo', 'po', 'idbuyer', 'idstyle')
        ->first();

    if ($poRow) {
        $idpo = $poRow->idpo;

        $breakdownRows = HistoryDataBreakdown::where('idpo', $idpo)
            ->select('idpo', 'combine_pro', 'deliverydate', 'production_status', 'is_cutoff', 'revisi_kp', 'kp_item_ref')
            ->get();

        $revisiConflicts = [];
        foreach ($breakdownRows as $row) {
            $conflicts = HistoryDataBreakdown::where('combine_pro', $row->combine_pro)
                ->where('revisi_kp', 1)
                ->whereNotNull('kp_item_ref')
                ->where('idpo', '>', $row->idpo)
                ->select('idpo', 'combine_pro', 'revisi_kp', 'kp_item_ref')
                ->get();

            if ($conflicts->isNotEmpty()) {
                $revisiConflicts[] = ['source_row' => $row, 'conflicts_with' => $conflicts];
            }
        }

        $finalInspectionRows = OutputDetailFinalInspection::query()
            ->join($od, "$od.barcode", '=', "$fi.barcode")
            ->where("$od.idpo", $idpo)
            ->select("$fi.barcode", "$fi.is_output", "$fi.date_output", "$fi.defect_code")
            ->get();

        $matchDateStatus = $breakdownRows->filter(function ($row) use ($dta, $dtb) {
            if (!$row->deliverydate) return false;
            $d = Carbon::parse($row->deliverydate);
            return $d->betweenIncluded($dta, $dtb) && $row->production_status === 'IH';
        })->values();

        $passesRawQuery = (clone $listQuery)->where("$dbr.idpo", $idpo)->exists();

        dd([
            'debug_target'           => $debugTarget,
            'idpo'                   => $idpo,
            'po'                     => $poRow->po,
            'date_from'              => $dta->toDateTimeString(),
            'date_to'                => $dtb->toDateTimeString(),
            'breakdown_rows'         => $breakdownRows,
            'match_date_status_rows' => $matchDateStatus, // kosong -> gagal whereBetween/production_status
            'revisi_conflicts'       => $revisiConflicts,  // ada isi -> ke-exclude logic revisi kartu produksi
            'final_inspection_rows'  => $finalInspectionRows,
            'has_any_final_record'   => $finalInspectionRows->isNotEmpty(), // false -> ke-exclude requireHasFinalRecord
            'has_any_output_1'       => $finalInspectionRows->where('is_output', 1)->isNotEmpty(), // true -> ke-exclude excludeIfAnyFinal
            'passes_raw_query'       => $passesRawQuery, // false -> gagal salah satu kondisi di atas (belum termasuk applyCommonFilters)
        ]);
    } else {
        dd("PO dengan keyword '$debugTarget' tidak ditemukan di tabel purchase_order");
    }

    // kode di bawah ini tidak akan jalan selama dd() di atas aktif
    $poList = $listQuery
        ->select("$dbr.idpo", "$po.po", "$po.idbuyer", "$po.idstyle")
        ->distinct()
        ->get();

    $buyerIds = $poList->pluck('idbuyer')->filter()->unique()->values();
    $buyerGroupMap = Buyer::whereIn('idbuyer', $buyerIds)->pluck('groupbuyer', 'idbuyer');
    $groupBuyerIds = $buyerGroupMap->filter()->unique()->values();
    $groupBuyerNames = MasterGroupBuyer::whereIn('id', $groupBuyerIds)->pluck('group_name', 'id');
    $styleIds = $poList->pluck('idstyle')->filter()->unique()->values();
    $styleMap = Style::whereIn('idstyle', $styleIds)->pluck('nmstyle', 'idstyle');

    $data = $poList->map(function ($item) use ($buyerGroupMap, $groupBuyerNames, $styleMap) {
        $groupBuyerId = $buyerGroupMap->get($item->idbuyer);
        return [
            'idpo'  => $item->idpo,
            'po'    => $item->po,
            'style' => $styleMap->get($item->idstyle) ?? '-',
            'buyer' => $groupBuyerId ? ($groupBuyerNames->get($groupBuyerId) ?? '-') : '-',
        ];
    })->values();

    return response()->json(['data' => $data]);
}