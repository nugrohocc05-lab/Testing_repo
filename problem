        function index(Request $request)
        {
            if ($this->myaccess() == '0') {
                return redirect()
                    ->back()
                    ->with('alert', [
                        'title' => 'Unauthorized!',
                        'message' => 'You Dont Have Any Access Here!',
                        'status' => 'warning',
                    ]);
            }

            preconnect(session('db'));

            return view('monitoring::endlineperformance.performance.index');
        }

        function selectline(Request $request)
        {
            preconnect(session('db'));

            $g = (new MasterEmployeeGroup())->getTable();
            $s = (new MasterEmployeeSection())->getTable();

            $data = MasterEmployeeGroup::select(
                    "$g.id as kodegroup", "$g.section_id as kodebagian",
                    "$g.name as namagroup", "$s.name as namabagian"
                )
                ->join($s, "$s.id", '=', "$g.section_id")
                ->distinct()
                ->whereHas('groupline', function($q){
                    $q->where('factory_id', session('db')->iddb)
                        ->where('is_show', 1)
                        ->where('is_line', 1);
                });

            if ($request->q) {
                $data = $data->where(function ($q) use ($request, $g) {
                    $q->where("$g.name", 'like', "%$request->q%");
                });
            }
            $data = $data->orderBy('kodegroup')->paginate(15, $request->page);

            return response()->json($data);
        }

        function groupbuyer(Request $request)
        {
            preconnect(session('db'));

            $q = $request->get('q');

            $data = MasterGroupBuyer::select('id', 'group_name')
                ->when($q, function ($query) use ($q) {
                    $query->where('group_name', 'like', '%' . $q . '%');
                })
                ->orderBy('group_name', 'asc')
                ->get()
                ->map(function ($item) {
                    return [
                        'id' => $item->id,
                        'text' => $item->group_name
                    ];
                });

            return response()->json([
                'results' => $data
            ]);
        }

        function summaryFilter(Request $request)
        {
            $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
            $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

            $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
            $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

            // Tanggal
            $headerQuery = SewingOutput::whereBetween('date', [$dta, $dtb]);

            // Line
            if ($request->line && $request->line != 'all') {
                $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');
                $poIds = PurchaseOrder::whereIn('idbuyer', $buyerIds)->pluck('idpo');
                $outputId = OutputDetail::whereIn('idpo', $poIds)->pluck('barcode');
                $headerQuery = $headerQuery->where('line', $request->line);
            }

            // Group Buyer -> idpo
            if ($request->groupbuyer && $request->groupbuyer != 'all') {
                $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');
                $poIds = PurchaseOrder::whereIn('idbuyer', $buyerIds)->pluck('idpo');
                $outputId = OutputDetail::whereIn('idpo', $poIds)->pluck('barcode');
                $headerQuery = $headerQuery->whereIn('barcode', $outputId)->where('is_qc', 1);
            }

            $headerIds = (clone $headerQuery)->pluck('id');

            // Total Output
            $totOutput = SewingOutput::whereIn('id', $headerIds)
                ->where('is_output', 1)
                ->count();

            // Qty Inspects
            $totInspect = $headerIds->count();

            // Qty Defects
            $totDefect = SewingOutput::whereIn('id', $headerIds)
                ->whereNotNull('defect_code')
                ->count();

            // RFT
            $rft = $totInspect > 0
                ? round((($totInspect - $totDefect) / $totInspect) * 100, 2)
                : 0;

            // WFT
            $wft = $totInspect > 0
                ? round(($totDefect / $totInspect) * 100, 2)
                : 0;

            // Kondisi warna target
            $target = Param::where('header', 'qc')
                ->where('key', 'rft_endline_target')
                ->value('value');

            $rftTarget = $rft <= $target ? true : false;

            // Top 5 Defect
            $topDefect = SewingOutput::whereIn('id', $headerIds)
                ->whereNotNull('defect_code')
                ->whereNotIn('defect_code', [800, 900])
                ->select(
                    'defect_code',
                    DB::raw('COUNT(*) as total')
                )
                ->groupBy('defect_code')
                ->orderByDesc('total')
                ->orderBy('defect_code', 'asc')
                ->limit(4)
                ->get();

            $defectIds = $topDefect->pluck('defect_code');

            // Master defect untuk Top 4
            $masterQcDefects = QCDefect::whereIn('kdcacat', $defectIds)
                ->pluck('deskripsi', 'kdcacat');

            $colors = [
                '#004FE0',
                '#3DAA25',
                '#F4947E',
                '#F24C4C',
                '#29B1AE',
            ];


            // Mapping Top 4
            $topDefect = $topDefect->values()->map(function ($item, $index) use (
                $masterQcDefects,
                $totDefect,
                $colors
            ) {
                $percent = $totDefect > 0
                    ? ($item->total / $totDefect) * 100
                    : 0;

                return [
                    'defect_id' => $item->defect_code,
                    'nmdefect'  => $masterQcDefects[$item->defect_code] ?? '-',
                    'total'     => (int) $item->total,
                    'percent'   => number_format($percent, 2),
                    'color'     => $colors[$index] ?? '#BDBDBD',
                ];
            });

            // Others
            $top4Total = $topDefect->sum('total');

            $othersTotal = $totDefect - $top4Total;

            if ($othersTotal > 0) {
                $othersPercent = $totDefect > 0
                    ? ($othersTotal / $totDefect) * 100
                    : 0;

                $topDefect->push([
                    'defect_id' => 'others',
                    'nmdefect'  => 'Others',
                    'total'     => (int) $othersTotal,
                    'percent'   => number_format($othersPercent, 2),
                    'color'     => '#29B1AE',
                ]);
            }

            return response()->json([
                'tot_output'  =>  $totOutput,
                'tot_inspect' => $totInspect,
                'tot_defect'  => $totDefect,
                'rft'         => $rft,
                'wft'         => $wft,
                'rft_target'  => $rftTarget,
                'top_defect'  => $topDefect,
            ]);
        }

        private function buildWeeks($year)
        {
            return Cache::remember("weeks_list_{$year}", now()->addDay(), function () use ($year) {
                $startOfYear = Carbon::createFromDate($year, 1, 1)->startOfDay();
                $endOfYear   = Carbon::createFromDate($year, 12, 31)->endOfDay();

                $weeks = [];
                $weekNumber = 1;
                $current = $startOfYear->copy();

                while ($current->lte($endOfYear)) {
                    $weekStart = $current->copy();
                    $weekEnd   = $current->copy()->addDays(6);

                    if ($weekEnd->gt($endOfYear)) {
                        $weekEnd = $endOfYear->copy();
                    }

                    $weeks[] = [
                        'id'    => $year . '-' . $weekNumber,
                        'year'  => $year,
                        'week'  => $weekNumber,
                        'start' => $weekStart->format('Y-m-d'),
                        'end'   => $weekEnd->format('Y-m-d'),
                        'text'  => 'Week ' . $weekNumber . ' (' . $weekStart->format('d M') . ' - ' . $weekEnd->format('d M Y') . ')',
                    ];

                    $weekNumber++;
                    $current->addDays(7);
                }

                return $weeks;
            });
        }


        // Deteksi year + week number dari tanggal (default hari ini)
        private function detectCurrentWeek($date = null)
        {
            $date = $date ? Carbon::parse($date) : Carbon::now();
            $year = $date->year;

            $startOfYear = Carbon::createFromDate($year, 1, 1)->startOfDay();
            $dayOfYear   = $startOfYear->diffInDays($date->copy()->startOfDay()) + 1;
            $weekNumber  = (int) ceil($dayOfYear / 7);

            return [
                'id'   => $year . '-' . $weekNumber,
                'year' => $year,
                'week' => $weekNumber,
            ];
        }

        // Endpoint select2 AJAX — HANYA tahun berjalan (tahun sekarang).
        public function selectWeek(Request $request)
        {
            $year   = Carbon::now()->year;
            $search = trim((string) $request->q);

            $weeks = collect($this->buildWeeks($year));

            if ($search !== '') {
                $needle = mb_strtolower($search);
                $weeks = $weeks->filter(fn ($w) => str_contains(mb_strtolower($w['text']), $needle))->values();
            }

            $perPage = 20;
            $page    = (int) ($request->page ?? 1);
            $paged   = $weeks->slice(($page - 1) * $perPage, $perPage)->values();

            return response()->json([
                'results'    => $paged->map(fn ($w) => ['id' => $w['id'], 'text' => $w['text']]),
                'pagination' => ['more' => $weeks->count() > $page * $perPage],
            ]);
        }

        public function currentWeek()
        {
            $current = $this->detectCurrentWeek();

            $weeks = collect($this->buildWeeks($current['year']));

            $selectedWeek = $weeks->first(function ($week) use ($current) {
                return $week['week'] === $current['week'];
            });

            return response()->json([
                'selected' => [
                    'id'   => $selectedWeek['id'],
                    'text' => $selectedWeek['text'],
                ],
            ]);
        }


        private function getTopStyleForDefect(Collection $headerIds, array $defectCodes, int $limit = 2): array
        {
            $barcodes = SewingOutput::whereIn('id', $headerIds)
                ->whereIn('defect_code', $defectCodes)
                ->pluck('barcode');

            if ($barcodes->isEmpty()) {
                return ['rows' => [], 'total' => 0];
            }

            $styleQty = OutputDetail::whereIn('barcode', $barcodes)
                ->select('idpo', DB::raw('COUNT(*) as total'))
                ->groupBy('idpo')
                ->get();

            $totalDefectQty = $styleQty->sum('total');

            $poToStyle = PurchaseOrder::whereIn('idpo', $styleQty->pluck('idpo'))
                ->pluck('idstyle', 'idpo');

            $styleNames = Style::whereIn('idstyle', $poToStyle->values()->unique())
                ->pluck('nmstyle', 'idstyle');

            $grouped = [];
            foreach ($styleQty as $row) {
                $idstyle = $poToStyle[$row->idpo] ?? null;
                $nmstyle = $idstyle ? ($styleNames[$idstyle] ?? '-') : '-';

                $grouped[$nmstyle] = ($grouped[$nmstyle] ?? 0) + $row->total;
            }

            arsort($grouped);

            $top = array_slice($grouped, 0, $limit, true);
            $othersQty = $totalDefectQty - array_sum($top);

            $rows = [];
            foreach ($top as $nmstyle => $qty) {
                $rows[] = [
                    'style'   => $nmstyle,
                    'qty'     => $qty,
                    'percent' => $totalDefectQty > 0 ? number_format(($qty / $totalDefectQty) * 100, 2) : '0.00',
                ];
            }

            if ($othersQty > 0) {
                $rows[] = [
                    'style'   => 'Others',
                    'qty'     => $othersQty,
                    'percent' => $totalDefectQty > 0 ? number_format(($othersQty / $totalDefectQty) * 100, 2) : '0.00',
                ];
            }

            return ['rows' => $rows, 'total' => $totalDefectQty];
        }



        public function getWeeklyData(Request $request)
        {
            preconnect(session('db'));

            $request->validate([
                'week_id' => 'required|string',
            ]);

            [$year, $weekNumber] = explode('-', $request->week_id);
            $weekNumber = (int) $weekNumber;

            if ($weekNumber < 1 || $weekNumber > 53) {
                abort(422, 'Week tidak valid');
            }

            $dta = Carbon::createFromDate($year, 1, 1)
                ->startOfDay()
                ->addDays(($weekNumber - 1) * 7);

            $dtb = $dta->copy()
                ->addDays(6)
                ->endOfDay();

            $endOfYear = Carbon::createFromDate($year, 12, 31)->endOfDay();

            if ($dtb->gt($endOfYear)) {
                $dtb = $endOfYear->copy();
            }

            $headerQuery = SewingOutput::whereBetween('date', [$dta, $dtb]);
            $headerIds = (clone $headerQuery)->pluck('id');

            $totInspect = $headerIds->count();

            $totDefect = SewingOutput::whereIn('id', $headerIds)
                ->whereNotNull('defect_code')
                ->count();

            $rft_qty = $totInspect - $totDefect;

            $rft = $totInspect > 0
                ? round((($totInspect - $totDefect) / $totInspect) * 100, 2)
                : 0;

            $wft = $totInspect > 0
                ? round(($totDefect / $totInspect) * 100, 2)
                : 0;

            $header = [
                'week'   => 'Week ' . $weekNumber,
                'period' => 'Week ' . $weekNumber . ' (' . $dta->format('d M') . ' - ' . $dtb->format('d M Y') . ')',
            ];

            // Top 4 Defect — HANYA di ranking Top-4 ini yang exclude 800/900
            // (biar 800/900 tidak jadi salah satu dari 4 defect teratas, tapi tetap dihitung di Others)
            $topDefect = SewingOutput::whereIn('id', $headerIds)
                ->whereNotNull('defect_code')
                ->whereNotIn('defect_code', [800, 900])
                ->select(
                    'defect_code',
                    DB::raw('COUNT(*) as total')
                )
                ->groupBy('defect_code')
                ->orderByDesc('total')
                ->orderBy('defect_code', 'asc')
                ->limit(4)
                ->get();

            $defectIds = $topDefect->pluck('defect_code');

            $masterQcDefects = QCDefect::whereIn('kdcacat', $defectIds)
                ->pluck('deskripsi', 'kdcacat');

            $colors = [
                '#004FE0',
                '#3DAA25',
                '#F4947E',
                '#F24C4C',
                '#29B1AE',
            ];

            $totTop4DefectQty = $topDefect->sum('total');

            $othersQty = max(0, $totDefect - $totTop4DefectQty);

            $othersPercent = $totDefect > 0
                ? ($othersQty / $totDefect) * 100
                : 0;

            // Mapping Top 4 Defect + Top Style tiap defect
            $topDefect = $topDefect->values()->map(function ($item, $index) use (
                $masterQcDefects,
                $totDefect,
                $colors,
                $headerIds
            ) {
                $percent = $totDefect > 0 ? ($item->total / $totDefect) * 100 : 0;

                return [
                    'defect_id'  => $item->defect_code,
                    'nmdefect'   => $masterQcDefects[$item->defect_code] ?? '-',
                    'defect_qty' => (int) $item->total,
                    'percent'    => number_format($percent, 2),
                    'color'      => $colors[$index] ?? '#29B1AE',
                    'top_style'  => $this->getTopStyleForDefect($headerIds, [$item->defect_code])['rows'],
                ];
            });

            $othersDefectCodes = SewingOutput::whereIn('id', $headerIds)
                ->whereNotNull('defect_code')
                ->whereNotIn('defect_code', $defectIds->toArray())
                ->pluck('defect_code')
                ->unique()
                ->values()
                ->toArray();

            $topDefect->push([
                'defect_id'  => 'others',
                'nmdefect'   => 'Others',
                'defect_qty' => (int) $othersQty,
                'percent'    => number_format($othersPercent, 2),
                'color'      => '#29B1AE',
                'top_style'  => $this->getTopStyleForDefect($headerIds, $othersDefectCodes)['rows'],
            ]);

            $totTopDefect = $topDefect->sum('defect_qty');

            return view('monitoring::endlineperformance.performance.partials.weekly', [
                'header'       => $header,
                'rft_qty'      => $rft_qty,
                'inspect_qty'  => $totInspect,
                'defect_qty'   => $totDefect,
                'rft'          => $rft,
                'wft'          => $wft,
                'top_defect'   => $topDefect,
                'totTopDefect' => $totTopDefect,
            ]);
        }

    }


