// Hitung qty inspect per PO (jumlah baris x 5), lalu total keseluruhan
$qtyPerPo = $tgldata->groupBy('idpo')->map(function ($group) use ($groupbuyerMap, $buyerMap, $poMap) {
    return [
        'idpo'        => $group->first()->idpo,
        'jumlah_data' => $group->count(),
        'qty_inspect' => $group->count() * 5,
        'groupbuyer'  => $group->first()->groupbuyer,
    ];
})->values();

$totalQtyInspect = $qtyPerPo->sum('qty_inspect');

return response()->json([
    'status'            => true,
    'count'              => $tgldata->count(),
    'data'               => $tgldata,
    'qty_inspect_per_po' => $qtyPerPo,
    'total_qty_inspect'  => $totalQtyInspect,
]);