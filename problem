  function datatable(Request $request)
    {
        preconnect(session('db'));

        $po = (new PurchaseOrder())->getTable();
        $fi = (new OutputDetailFinalInspection())->getTable();
        $od = (new OutputDetail())->getTable();

        $outputdata = OutputDetailFinalInspection::selectRaw("DATE($fi.date_output) as tanggal")
            ->addSelect(
                "$od.kpno","$od.sub_style_id","$od.combine_pro","$od.idpo","$od.idcolor",
                "$od.idsize","$po.idstyle","$fi.barcode","$fi.is_output","$fi.defect_code"
            )
            ->join($od,"$od.barcode","=","$fi.barcode")
            ->join($po,"$po.idpo","=","$od.idpo")
            ->whereNotNull("$fi.date_output")
            ->orderBy("tanggal", "DESC");

        $filter = false;

        if ($request->has('kp') and $request->kp != null) {
            $outputdata = $outputdata->where("$od.kpno", $request->kp);
            $filter = true;
        }

        if (
            $request->has('datea') and
            $request->has('dateb') and
            $request->datea != null and
            $request->dateb != null
        ) {
            if($request->datea == $request->dateb){
                $dta = Carbon::parse($request->datea);

                $outputdata = $outputdata->whereDate('date_output', $dta);
            }else{
                $m_da =
                    $request->datea > $request->dateb
                        ? $request->dateb
                        : $request->datea;
                $m_db =
                    $request->datea > $request->dateb
                        ? $request->datea
                        : $request->dateb;
                $dta = Carbon::parse($m_da);
                $dtb = Carbon::parse($m_db)->endOfDay();

                $diff = $dta->diffInDays($dtb);

                if ($diff > 31) {
                    return '<center><h3>Date Has More Than 31 Days in Range, Cannot View Data.</h3></center>';
                }

                $outputdata = $outputdata->whereBetween('date_output', [$dta, $dtb]);
            }

            $filter = true;
        }

        if ($filter) {
            $outputdata = $outputdata->get();
        } else {
            $outputdata = $outputdata->whereNull("$fi.barcode")->get();
        }

        $outputdata = $outputdata->sortBy('tanggal');

        $mpo = $outputdata
            ->pluck('idpo')
            ->unique()
            ->all();
        $msize = $outputdata
            ->pluck('idsize')
            ->unique()
            ->all();
        $mcolor = $outputdata
            ->pluck('idcolor')
            ->unique()
            ->all();
        $mstyle = $outputdata
            ->pluck('idstyle')
            ->unique()
            ->all();
        $msubstyle = $outputdata
            ->pluck('sub_style_id')
            ->unique()
            ->all();

        $po = null;
        $size = null;
        $color = null;
        $style = null;
        $substyle = null;

        foreach ($mpo as $p) {
            $m_p = PurchaseOrder::where('idpo', $p)->first();
            $po[$p] = $m_p ? $m_p->po : $p;
        }

        foreach ($mcolor as $c) {
            $m_s = Color::select('nmcolor')
                ->where('idcolor', $c)
                ->first();
            $color[$c] = $m_s ? $m_s->nmcolor : '-';
        }

        foreach ($msize as $u) {
            $m_s = Size::select('nmsize')
                ->where('idsize', $u)
                ->first();
            $size[$u] = $m_s ? $m_s->nmsize : '-';
        }

        foreach ($mstyle as $s) {
            $m_s = Style::select('nmstyle')
                ->where('idstyle', $s)
                ->first();
            $style[$s] = $m_s ? $m_s->nmstyle : '-';
        }

        foreach ($msubstyle as $ss) {
            $m_ss = SubStyle::find($ss);
            $substyle[$ss] = $m_ss ? $m_ss->name : '-';
        }

        $defects = QCDefect::select('kdcacat', 'pivot_code')
            ->whereNotNull('pivot_code')
            ->orderBy('pivot_code')
            ->get();

        session(['filterfikp' => $request->kp]);
        session(['filterfidatea' => $request->datea]);
        session(['filterfidateb' => $request->dateb]);

        $outputdata = $outputdata->groupBy(
            [
                'tanggal',
                'idstyle',
                'kpno',
                'sub_style_id',
                'combine_pro',
                'idpo',
                'idcolor',
                'idsize',
            ],
            false,
        );

        return view('qc::finalinspectionreport.datatable', [
            'defects' => $defects,
            'outputdata' => $outputdata,
            'mypo' => $po,
            'mystyle' => $style,
            'mysubstyle' => $substyle,
            'mycolor' => $color,
            'mysize' => $size,
            'ctrl' => $this,
        ]);
    }

