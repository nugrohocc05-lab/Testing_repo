// ============================
// HARDCODED DEBUG — otomatis jalan tiap klik Find, ganti angka ini sesuai kebutuhan
// ============================
$debugTarget = '4123'; // <-- cek PO 4123

$poRow = PurchaseOrder::where('idpo', 'like', "%$debugTarget%")
    ->orWhere('po', 'like', "%$debugTarget%")
    ->select('idpo', 'po', 'idbuyer', 'idstyle')
    ->first();

if ($poRow) {
    $idpo = $poRow->idpo;

    $breakdownRows = HistoryDataBreakdown::where('idpo', $idpo)
        ->select('idpo', 'combine_pro', 'deliverydate', 'production_status', 'is_cutoff', 'revisi_kp', 'kp_item_ref')
        ->get();

    // Cari SEMUA idpo lain yang share combine_pro yang sama (ini kunci masalahnya)
    $combineProValues = $breakdownRows->pluck('combine_pro')->unique();

    $sameCombineProRows = HistoryDataBreakdown::whereIn('combine_pro', $combineProValues)
        ->select('idpo', 'combine_pro', 'revisi_kp', 'kp_item_ref', 'deliverydate', 'production_status')
        ->get()
        ->groupBy('idpo');

    // Untuk tiap idpo yang share combine_pro, cek apakah dia punya barcode is_output = 1
    $od  = (new OutputDetail())->getTable();
    $fi  = (new OutputDetailFinalInspection())->getTable();

    $relatedIdpoFinalStatus = [];
    foreach ($sameCombineProRows as $relatedIdpo => $rows) {
        $finalRows = OutputDetailFinalInspection::query()
            ->join($od, "$od.barcode", '=', "$fi.barcode")
            ->where("$od.idpo", $relatedIdpo)
            ->select("$fi.barcode", "$fi.is_output")
            ->get();

        $relatedIdpoFinalStatus[$relatedIdpo] = [
            'combine_pro_rows' => $rows,
            'final_rows'       => $finalRows,
            'has_output_1'     => $finalRows->where('is_output', 1)->isNotEmpty(),
        ];
    }

    dd([
        'debug_target'              => $debugTarget,
        'idpo'                      => $idpo,
        'po'                        => $poRow->po,
        'breakdown_rows'            => $breakdownRows,
        'combine_pro_values'        => $combineProValues,
        'related_idpo_via_combine_pro' => $relatedIdpoFinalStatus, // <-- cek ini: idpo mana yang has_output_1 = true
    ]);
}