        return response($html)
            ->header('Content-Type', 'application/vnd.ms-excel')
            ->header('Content-Disposition', 'attachment; filename=Report_Endline_Summary.xls');
    }

    private function buildWeeks($year)
    {
        return Cache::remember("weeks_list_{$year}", now()->addDay(), function () use ($year) {
            $startOfYear = Carbon::createFromDate($year, 1, 1)->startOfDay();
            $endOfYear   = Carbon::createFromDate($year, 12, 31)->endOfDay();

            $weeks = [];
            $weekNumber = 1;
            $current = $startOfYear->copy();

            while ($current->lte($endOfYear)) {
                $weekStart = $current->copy();
                $weekEnd   = $current->copy()->addDays(6);

                if ($weekEnd->gt($endOfYear)) {
                    $weekEnd = $endOfYear->copy();
                }

                $weeks[] = [
                    'id'    => $year . '-' . $weekNumber,
                    'year'  => $year,
                    'week'  => $weekNumber,
                    'start' => $weekStart->format('Y-m-d'),
                    'end'   => $weekEnd->format('Y-m-d'),
                    'text'  => 'Week ' . $weekNumber . ' (' . $weekStart->format('d M') . ' - ' . $weekEnd->format('d M Y') . ')',
                ];

                $weekNumber++;
                $current->addDays(7);
            }

            return $weeks;
        });
    }

    private function detectCurrentWeek($date = null)
    {
        $date = $date ? Carbon::parse($date) : Carbon::now();
        $year = $date->year;

        $startOfYear = Carbon::createFromDate($year, 1, 1)->startOfDay();
        $dayOfYear   = $startOfYear->diffInDays($date->copy()->startOfDay()) + 1;
        $weekNumber  = (int) ceil($dayOfYear / 7);

        return [
            'id'   => $year . '-' . $weekNumber,
            'year' => $year,
            'week' => $weekNumber,
        ];
    }

    public function selectWeek(Request $request)
    {
        $year   = Carbon::now()->year;
        $search = trim((string) $request->q);

        $weeks = collect($this->buildWeeks($year));

        $currentWeek = $this->detectCurrentWeek();
        $weeks = $weeks->filter(fn ($w) => $w['week'] <= $currentWeek['week'])->values();

        if ($search !== '') {
            $needle = mb_strtolower($search);
            $weeks = $weeks->filter(fn ($w) => str_contains(mb_strtolower($w['text']), $needle))->values();
        }

        $perPage = 20;
        $page    = (int) ($request->page ?? 1);
        $paged   = $weeks->slice(($page - 1) * $perPage, $perPage)->values();

        return response()->json([
            'results'    => $paged->map(fn ($w) => ['id' => $w['id'], 'text' => $w['text']]),
            'pagination' => ['more' => $weeks->count() > $page * $perPage],
        ]);
    }

    public function currentWeek()
    {
        $current = $this->detectCurrentWeek();

        $weeks = collect($this->buildWeeks($current['year']));

        $selectedWeek = $weeks->first(function ($week) use ($current) {
            return $week['week'] === $current['week'];
        });

        return response()->json([
            'selected' => [
                'id'   => $selectedWeek['id'],
                'text' => $selectedWeek['text'],
            ],
        ]);
    }

    // FIX N+1: Fungsi ini sekarang menerima Base Query, BUKAN array ID raksasa.
    // Memanfaatkan SQL Join langsung tanpa looping dan pluck berlebihan.
    private function getTopStyleForDefect(Builder $baseQuery, array $defectCodes, int $limit = 2): array
    {
        if (empty($defectCodes)) {
            return ['rows' => [], 'total' => 0];
        }

        $sewingTb = (new SewingOutput)->getTable();
        $outputTb = (new OutputDetail)->getTable();
        $poTb     = (new PurchaseOrder)->getTable();
        $styleTb  = (new Style)->getTable();

        $query = (clone $baseQuery)->whereIn("$sewingTb.defect_code", $defectCodes)
            ->join($outputTb, "$sewingTb.barcode", '=', "$outputTb.barcode")
            ->join($poTb, "$outputTb.idpo", '=', "$poTb.idpo")
            ->join($styleTb, "$poTb.idstyle", '=', "$styleTb.idstyle")
            ->select("$styleTb.nmstyle as style", DB::raw("COUNT($sewingTb.id) as qty"))
            ->groupBy("$styleTb.idstyle", "$styleTb.nmstyle")
            ->orderByDesc('qty');

        $results = $query->get();
        $totalDefectQty = $results->sum('qty');

        $top = $results->take($limit);
        $othersQty = $results->skip($limit)->sum('qty');

        $rows = [];
        foreach ($top as $row) {
            $rows[] = [
                'style'   => $row->style,
                'qty'     => $row->qty,
                'percent' => $totalDefectQty > 0 ? number_format(($row->qty / $totalDefectQty) * 100, 2) : '0.00',
            ];
        }

        if ($othersQty > 0) {
            $rows[] = [
                'style'   => 'Others',
                'qty'     => $othersQty,
                'percent' => $totalDefectQty > 0 ? number_format(($othersQty / $totalDefectQty) * 100, 2) : '0.00',
            ];
        }

        return ['rows' => $rows, 'total' => $totalDefectQty];
    }

    public function getWeeklyData(Request $request)
    {
        preconnect(session('db'));

        $request->validate([
            'week_id' => 'required|string',
        ]);

        [$year, $weekNumber] = explode('-', $request->week_id);
        $weekNumber = (int) $weekNumber;

        if ($weekNumber < 1 || $weekNumber > 53) {
            abort(422, 'Week tidak valid');
        }

        $dta = Carbon::createFromDate($year, 1, 1)->startOfDay()->addDays(($weekNumber - 1) * 7);
        $dtb = $dta->copy()->addDays(6)->endOfDay();
        $endOfYear = Carbon::createFromDate($year, 12, 31)->endOfDay();

        if ($dtb->gt($endOfYear)) {
            $dtb = $endOfYear->copy();
        }

        $headerQuery = SewingOutput::whereBetween('date', [$dta, $dtb]);

        // FIX: Conditional Aggregation 1 Query
        $summary = (clone $headerQuery)->select(
            DB::raw('SUM(CASE WHEN is_qc = 1 THEN 1 ELSE 0 END) as totInspect'),
            DB::raw('SUM(CASE WHEN defect_code IS NOT NULL THEN 1 ELSE 0 END) as totDefect')
        )->first();

        $totInspect = (int) $summary->totInspect;
        $totDefect  = (int) $summary->totDefect;

        $rft_qty = $totInspect - $totDefect;
        $rft = $totInspect > 0 ? round((($totInspect - $totDefect) / $totInspect) * 100, 2) : 0;
        $wft = $totInspect > 0 ? round(($totDefect / $totInspect) * 100, 2) : 0;

        $header = [
            'week'   => 'Week ' . $weekNumber,
            'period' => 'Week ' . $weekNumber . ' (' . $dta->format('d M') . ' - ' . $dtb->format('d M Y') . ')',
        ];

        $topDefect = (clone $headerQuery)
            ->whereNotNull('defect_code')
            ->whereNotIn('defect_code', [800, 900])
            ->select('defect_code', DB::raw('COUNT(*) as total'))
            ->groupBy('defect_code')
            ->orderByDesc('total')
            ->orderBy('defect_code', 'asc')
            ->limit(4)
            ->get();

        $defectIds = $topDefect->pluck('defect_code');
        $masterQcDefects = QCDefect::whereIn('kdcacat', $defectIds)->pluck('deskripsi', 'kdcacat');
        $colors = ['#004FE0', '#3DAA25', '#F4947E', '#F24C4C', '#29B1AE'];

        $totTop4DefectQty = $topDefect->sum('total');
        $othersQty = max(0, $totDefect - $totTop4DefectQty);
        $othersPercent = $totDefect > 0 ? ($othersQty / $totDefect) * 100 : 0;

        $topDefect = $topDefect->values()->map(function ($item, $index) use (
            $masterQcDefects, $totDefect, $colors, $headerQuery
        ) {
            $percent = $totDefect > 0 ? ($item->total / $totDefect) * 100 : 0;
            return [
                'defect_id'  => $item->defect_code,
                'nmdefect'   => $masterQcDefects[$item->defect_code] ?? '-',
                'defect_qty' => (int) $item->total,
                'percent'    => number_format($percent, 2),
                'color'      => $colors[$index] ?? '#29B1AE',
                // FIX: Meneruskan BaseQuery, bukan array IDs raksasa
                'top_style'  => $this->getTopStyleForDefect($headerQuery, [$item->defect_code])['rows'],
            ];
        });

        $othersDefectCodes = (clone $headerQuery)
            ->whereNotNull('defect_code')
            ->whereNotIn('defect_code', $defectIds->toArray())
            ->pluck('defect_code')
            ->unique()
            ->values()
            ->toArray();

        $topDefect->push([
            'defect_id'  => 'others',
            'nmdefect'   => 'Others',
            'defect_qty' => (int) $othersQty,
            'percent'    => number_format($othersPercent, 2),
            'color'      => '#29B1AE',
            'top_style'  => $this->getTopStyleForDefect($headerQuery, $othersDefectCodes)['rows'],
        ]);

        $totTopDefect = $topDefect->sum('defect_qty');

        return view('monitoring::endlineperformance.performance.partials.weekly', [
            'header'       => $header,
            'rft_qty'      => $rft_qty,
            'inspect_qty'  => $totInspect,
            'defect_qty'   => $totDefect,
            'rft'          => $rft,
            'wft'          => $wft,
            'top_defect'   => $topDefect,
            'totTopDefect' => $totTopDefect,
        ]);
    }

    private function weekRange($year, int $weekNumber): array
    {
        $dta = Carbon::createFromDate($year, 1, 1)->startOfDay()->addDays(($weekNumber - 1) * 7);
        $dtb = $dta->copy()->addDays(6)->endOfDay();

        $endOfYear = Carbon::createFromDate($year, 12, 31)->endOfDay();
        if ($dtb->gt($endOfYear)) {
            $dtb = $endOfYear->copy();
        }

        return [$dta, $dtb];
    }

    // FIX N+1 CHART EXTREME: Fungsi helper Buckets dihapus. Query langsung digabung menggunakan GROUP BY.
    public function getDefectChartData(Request $request)
    {
        preconnect(session('db'));

        $request->validate([
            'mode' => 'required|in:weekly,day',
        ]);

        $defectCodes = collect($request->input('defects', []))->map(fn ($c) => (int) $c);
        $mode = $request->mode;

        $baseQuery = SewingOutput::query();
        $bucketKeys = [];
        
        $sewingTb = (new SewingOutput)->getTable();

        // Setup Rentang & Grouping Berdasarkan Mode
        if ($mode === 'day') {
            $baseQuery->whereDate("$sewingTb.date", Carbon::today());
            $groupField = DB::raw("HOUR($sewingTb.date) as bucket_key");
            $groupBy    = DB::raw("HOUR($sewingTb.date)");
            $bucketKeys = range(7, 23); // hours
            $formatLabel = fn($k) => sprintf('%02d:00', $k);
        } else {
            $dta = Carbon::now()->subDays(6)->startOfDay();
            $dtb = Carbon::now()->endOfDay();
            $baseQuery->whereBetween("$sewingTb.date", [$dta, $dtb]);
            $groupField = DB::raw("DATE($sewingTb.date) as bucket_key");
            $groupBy    = DB::raw("DATE($sewingTb.date)");
            
            $cursor = $dta->copy();
            while($cursor->lte($dtb)){
                $bucketKeys[] = $cursor->format('Y-m-d');
                $cursor->addDay();
            }
            $formatLabel = fn($k) => Carbon::parse($k)->format('d M');
        }

        // 1. Dapatkan semua Inspeksi per bucket dalam 1 Query
        $inspectData = (clone $baseQuery)->where("$sewingTb.is_qc", 1)
            ->select($groupField, DB::raw('COUNT(*) as total'))
            ->groupBy($groupBy)
            ->get()
            ->pluck('total', 'bucket_key');

        // 2. Dapatkan semua QTY Defect per kode per bucket dalam 1 Query
        $defectData = (clone $baseQuery)->where("$sewingTb.is_qc", 1)
            ->whereIn("$sewingTb.defect_code", $defectCodes)
            ->select($groupField, "$sewingTb.defect_code", DB::raw('COUNT(*) as total'))
            ->groupBy($groupBy, "$sewingTb.defect_code")
            ->get();

        // 3. Dapatkan Top Styles per bucket (menggabungkan semua $defectCodes) dalam 1 Query
        $outTb   = (new OutputDetail)->getTable();
        $poTb    = (new PurchaseOrder)->getTable();
        $styleTb = (new Style)->getTable();

        $styleDataGrouped = collect();
        if ($defectCodes->isNotEmpty()) {
            $styleDataRaw = (clone $baseQuery)->where("$sewingTb.is_qc", 1)
                ->whereIn("$sewingTb.defect_code", $defectCodes)
                ->join($outTb, "$sewingTb.barcode", '=', "$outTb.barcode")
                ->join($poTb, "$outTb.idpo", '=', "$poTb.idpo")
                ->join($styleTb, "$poTb.idstyle", '=', "$styleTb.idstyle")
                ->select(
                    $groupField,
                    "$styleTb.nmstyle as style",
                    DB::raw("COUNT($sewingTb.id) as qty")
                )
                ->groupBy($groupBy, "$styleTb.idstyle", "$styleTb.nmstyle")
                ->get();
                
            $styleDataGrouped = $styleDataRaw->groupBy('bucket_key');
        }

        // Persiapkan Output PHP (Tanpa Hit Database Sama Sekali Disini)
        $names = QCDefect::whereIn('kdcacat', $defectCodes)->pluck('deskripsi', 'kdcacat');
        $colors = ['#1B4FE0', '#F4977B', '#36B37E', '#FFAB00', '#8777D9', '#00B8D9', '#F24C4C', '#29B1AE'];

        $labels = [];
        $seriesData = [];
        $bucketMeta = [];

        foreach ($defectCodes as $c) {
            $seriesData[$c] = [];
        }

        foreach ($bucketKeys as $key) {
            $labels[] = $formatLabel($key);
            $inspectQty = $inspectData[$key] ?? 0;

            foreach ($defectCodes as $code) {
                // Cari QTY defect pada bucket dan kode spesifik ini dari data yang sudah diambil
                $qtyObj = $defectData->where('bucket_key', $key)->where('defect_code', $code)->first();
                $qty = $qtyObj ? $qtyObj->total : 0;
                $wft = $inspectQty > 0 ? round(($qty / $inspectQty) * 100, 2) : 0;
                $seriesData[$code][] = $wft;
            }

            // Map Styles dari collection yang sudah dikelompokkan
            $bucketStyles = $styleDataGrouped->get($key, collect());
            $topStyles = $bucketStyles->sortByDesc('qty')->take(3)->map(function($item) use ($inspectQty) {
                return [
                    'style' => $item->style,
                    'qty'   => $item->qty,
                    'wft'   => $inspectQty > 0 ? round(($item->qty / $inspectQty) * 100, 2) : 0,
                ];
            })->values()->toArray();

            $bucketMeta[] = [
                'topStyles' => $topStyles,
            ];
        }

        $series = $defectCodes->values()->map(function ($code, $i) use ($seriesData, $names, $colors) {
            return [
                'code'  => (string) $code,
                'name'  => $names[$code] ?? '-',
                'color' => $colors[$i % count($colors)],
                'data'  => $seriesData[$code],
            ];
        });

        return response()->json([
            'labels'     => $labels,
            'series'     => $series,
            'bucketMeta' => $bucketMeta,
        ]);
    }

    public function getDefectChartOptions(Request $request)
    {
        preconnect(session('db'));

        $request->validate([
            'mode' => 'required|in:weekly,day',
        ]);

        if ($request->mode === 'day') {
            $headerQuery = SewingOutput::whereDate('date', Carbon::now());
        } else {
            $dta = Carbon::now()->subDays(6)->startOfDay();
            $dtb = Carbon::now()->endOfDay();
            $headerQuery = SewingOutput::whereBetween('date', [$dta, $dtb]);
        }

        // FIX: Tidak perlu pluck ID, langsung gunakan (clone) Query Builder-nya
        $defectCodes = (clone $headerQuery)
            ->whereNotNull('defect_code')
            ->whereNotIn('defect_code', [800, 900])
            ->select('defect_code', DB::raw('COUNT(*) as total'))
            ->groupBy('defect_code')
            ->orderByDesc('total')
            ->limit(5)
            ->pluck('total', 'defect_code');

        $names = QCDefect::whereIn('kdcacat', $defectCodes->keys())
            ->pluck('deskripsi', 'kdcacat');

        $colors = [
            '#1B4FE0', '#F4977B', '#36B37E', '#FFAB00',
            '#8777D9', '#00B8D9', '#F24C4C', '#29B1AE',
        ];

        $options = $defectCodes->keys()
            ->values()
            ->map(function ($code, $index) use ($names, $colors) {
                return [
                    'code'  => (string) $code,
                    'name'  => $names[$code] ?? '-',
                    'color' => $colors[$index % count($colors)],
                ];
            });

        return response()->json([
            'options' => $options,
        ]);
    }
