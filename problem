<?php

// ... namespace & use statements tetap seperti punya Anda

class YourControllerName extends Controller
{
    /**
     * Warna dasar yang dipakai untuk defect chart & chip.
     */
    private array $defectColors = [
        '#1B4FE0',
        '#F4977B',
        '#36B37E',
        '#FFAB00',
        '#8777D9',
        '#00B8D9',
        '#F24C4C',
        '#29B1AE',
    ];

    /**
     * Single source of truth untuk ranking + warna defect code
     * berdasarkan mode (weekly/day). Dipakai bareng oleh
     * getDefectChartOptions() dan getDefectChartData()
     * supaya warna chip & chart selalu konsisten.
     *
     * Return format: [ '123' => ['name' => 'Skip Stitch', 'color' => '#1B4FE0'], ... ]
     * Urutan array = urutan ranking (index 0 = defect terbanyak).
     */
    private function getDefectColorMap(string $mode, int $limit = 5): array
    {
        if ($mode === 'day') {
            $headerQuery = SewingOutput::whereDate('date', Carbon::now());
        } else {
            $dta = Carbon::now()->subDays(6)->startOfDay();
            $dtb = Carbon::now()->endOfDay();
            $headerQuery = SewingOutput::whereBetween('date', [$dta, $dtb]);
        }

        $headerIds = $headerQuery->pluck('id');

        $rankedCodes = SewingOutput::whereIn('id', $headerIds)
            ->whereNotNull('defect_code')
            ->whereNotIn('defect_code', [800, 900])
            ->select('defect_code', DB::raw('COUNT(*) as total'))
            ->groupBy('defect_code')
            ->orderByDesc('total')
            ->limit($limit)
            ->pluck('total', 'defect_code')
            ->keys();

        $names = QCDefect::whereIn('kdcacat', $rankedCodes)
            ->pluck('deskripsi', 'kdcacat');

        $map = [];
        foreach ($rankedCodes->values() as $index => $code) {
            $map[(string) $code] = [
                'name'  => $names[$code] ?? '-',
                'color' => $this->defectColors[$index % count($this->defectColors)],
            ];
        }

        return $map;
    }

    public function getDefectChartOptions(Request $request)
    {
        preconnect(session('db'));

        $request->validate([
            'mode' => 'required|in:weekly,day',
        ]);

        $colorMap = $this->getDefectColorMap($request->mode);

        $options = collect($colorMap)
            ->map(function ($item, $code) {
                return [
                    'code'  => $code,
                    'name'  => $item['name'],
                    'color' => $item['color'],
                ];
            })
            ->values();

        return response()->json([
            'options' => $options,
        ]);
    }

    public function getDefectChartData(Request $request)
    {
        preconnect(session('db'));

        $request->validate([
            'mode' => 'required|in:weekly,day',
        ]);

        $defectCodes = collect($request->input('defects', []))->map(fn ($c) => (int) $c);

        if ($request->mode === 'day') {
            $buckets = $this->buildHourBuckets(Carbon::now());
        } else {
            $dta = Carbon::now()->subDays(6)->startOfDay();
            $dtb = Carbon::now()->endOfDay();
            $buckets = $this->buildDayBuckets($dta, $dtb);
        }

        // Ambil warna dari sumber yang SAMA dengan getDefectChartOptions
        $colorMap = $this->getDefectColorMap($request->mode);

        // Fallback nama untuk defect code yang mungkin tidak masuk top-N ranking
        $names = QCDefect::whereIn('kdcacat', $defectCodes)->pluck('deskripsi', 'kdcacat');

        $seriesData = [];
        foreach ($defectCodes as $c) {
            $seriesData[$c] = [];
        }

        $labels = [];
        $bucketMeta = [];

        foreach ($buckets as $bucket) {
            $labels[] = $bucket['label'];

            $inspectQty = SewingOutput::whereIn('id', $bucket['ids'])
                ->where('is_qc', 1)
                ->count();

            $defectQtyPerCode = SewingOutput::whereIn('id', $bucket['ids'])
                ->where('is_qc', 1)
                ->whereIn('defect_code', $defectCodes)
                ->select('defect_code', DB::raw('COUNT(*) as total'))
                ->groupBy('defect_code')
                ->pluck('total', 'defect_code');

            foreach ($defectCodes as $code) {
                $qty = $defectQtyPerCode[$code] ?? 0;
                $wft = $inspectQty > 0 ? round(($qty / $inspectQty) * 100, 2) : 0;
                $seriesData[$code][] = $wft;
            }

            $bucketMeta[] = [
                'topStyles' => $defectCodes->isNotEmpty()
                    ? $this->getTopStyleForBucket($bucket['ids'], $defectCodes->toArray(), $inspectQty)
                    : [],
            ];
        }

        $series = $defectCodes->values()->map(function ($code) use ($seriesData, $names, $colorMap) {
            $codeKey = (string) $code;
            $mapped  = $colorMap[$codeKey] ?? null;

            return [
                'code'  => $codeKey,
                'name'  => $mapped['name']  ?? ($names[$code] ?? '-'),
                // fallback abu-abu kalau defect code sudah tidak masuk ranking top-N
                // (mis. data lama / bucket yang dipilih di luar top-5 saat itu)
                'color' => $mapped['color'] ?? '#8A93A6',
                'data'  => $seriesData[$code],
            ];
        });

        return response()->json([
            'labels'     => $labels,
            'series'     => $series,
            'bucketMeta' => $bucketMeta,
        ]);
    }
}