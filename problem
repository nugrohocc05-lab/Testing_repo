    function filterInlineLts(Request $request)
    {
        if (!$request->line) {
            return response()->json(['message' => 'Line belum dipilih'], 422);
        }

        $date = Carbon::now();
        $dta = $date->copy()->startOfDay();
        $dtb = $date->copy()->endOfDay();

        $headerQuery = InlineHeader::whereBetween('date', [$dta, $dtb])
            ->where('group_id', $request->line);

        $headerIds = (clone $headerQuery)->pluck('id');
        $headerCount = $headerIds->count();

        $totInspect = $headerCount * 5;
        $totDefect = InlineDetail::whereIn('inline_header_id', $headerIds)->count();

        $rft = $totInspect > 0 ? (($totInspect - $totDefect) / $totInspect) * 100 : 0;
        $wft = $totInspect > 0 ? ($totDefect / $totInspect) * 100 : 0;

        $response = [
            'date'        => $date->format('Y-m-d'),
            'tot_inspect' => $totInspect,
            'tot_defect'  => $totDefect,
            'rft'         => number_format($rft, 2),
            'wft'         => number_format($wft, 2),
        ];

        try {
            $optData = $this->buildInlineOptData($request->line);

            $response['line_info']       = $optData['line'];
            $response['totaloutput']     = $optData['totaloutput'];
            $response['percentrft']      = $optData['percentrft'];
            $response['percentwft']      = $optData['percentwft'];
            $response['totalefficiency'] = $optData['totalefficiency'];
            $response['userinline']      = $optData['userinline'];
            $response['usertoday']       = $optData['usertoday'];
        } catch (\Exception $e) {
            \Log::error($e);
        }

        return response()->json($response);
    }

