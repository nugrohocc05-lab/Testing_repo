                var tooltipTimeout;
                function attachTooltipHandlers() {
                    clearTimeout(tooltipTimeout);

                    const isTouchDevice = ('ontouchstart' in window) || navigator.maxTouchPoints > 0;

                    if (isTouchDevice) {
                        $('.dropdown-menu li > a').off('touchstart').on('touchstart', function() {
                            const tooltipText = $(this).data('tooltip');
                            if (tooltipText != '' && tooltipText != undefined) {
                                $('#tooltips').text(tooltipText)
                                    .css({
                                        top: $(this).offset().top - $('#tooltips').outerHeight() - 10,
                                        left: $(this).offset().left + ($(this).outerWidth() / 2) - ($('#tooltips').outerWidth() / 2),
                                        border: '1px solid black',
                                    })
                                    .fadeIn();
                            }
                        });

                        $('.dropdown-menu li > a').off('touchend').on('touchend', function() {
                            tooltipTimeout = setTimeout(function() {
                                $('#tooltips').fadeOut();
                            }, 10000);
                        });
                    } else {
                        $('.dropdown-menu li > a').hover(
                            function() {
                                const tooltipText = $(this).data('tooltip');
                                if (tooltipText != '' && tooltipText != undefined) {
                                    $('#tooltips').text(tooltipText)
                                        .css({
                                            top: $(this).offset().top - $('#tooltips').outerHeight() - 10,
                                            left: $(this).offset().left + ($(this).outerWidth() / 2) - ($('#tooltips').outerWidth() / 2),
                                            border: '1px solid black',
                                        })
                                        .fadeIn();
                                }
                            },
                            function() {
                                tooltipTimeout = setTimeout(function() {
                                    $('#tooltips').fadeOut();
                                }, 10000);
                            }
                        );
                    }
                }


