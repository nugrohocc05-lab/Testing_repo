<script type="text/javascript">
$(document).ready(function() {
    @if(!session('tokenmenu'))
        window.location.href = `{{route('login')}}`;
    @endif
    var _route = '#';
    var delay = (function(){
        var timer = 0;
        return function(callback, ms){
            clearTimeout (timer);
                timer = setTimeout(callback, ms);
            };
    })();
    $("#niksewing").on("input", function() {
        delay(function(){
            if ($("#niksewing").val().length < 10) {
                $("#niksewing").val("");
            }
        }, 20);
    });
    $('#niksewing').on("paste",function(e) {
        e.preventDefault();
    });
    $('.authbtn').on('click', function(ev){
        $('#niksewing').focus();
        $('#modal-niksewing').modal('show');
        _route = $(this).data('route');
    });
    $('#modal-niksewing').on('shown.bs.modal', function () {
        $('#niksewing').removeAttr('readonly');
        $('#niksewing').val('')
        $('#niksewing').focus();
        $(this).on('click', function(){
            $('#niksewing').removeAttr('readonly');
            $('#niksewing').val('');
            $('#niksewing').focus();
        })
    });
    $('.close-modal').on('click', function(e) {
        e.preventDefault();
        $("#modal-niksewing").modal('hide');
    });
    $('#niksewing').change(function(ev){
        ev.preventDefault();
        const niksewing = $('#niksewing').val();
        if(niksewing.length >= 10){
            $('#niksewing').attr('readonly','readonly');
            $('#loading').show();
            $.ajax({
                type: "GET",
                url: `{!! route('loadingsewingmenugetdatanik') !!}`,
                dataType: "json",
                data: {
                    nik: niksewing,
                },
                success: function(r) {
                    $('#loading').show();
                    window.location.href = _route;
                },
                error: function(e) {
                    $('#loading').hide();
                    swal("Warning!", e.responseText, 'warning').then(()=>{
                        $('#niksewing').removeAttr('readonly');
                        $('#niksewing').val('');
                        $('#niksewing').focus();
                    });
                }
            });
        }
    });
});
</script>
