            return "Packing";
        })
        ->addColumn('status', function($d){
            $status = ($d->is_approve == 1) ? "Approved at ".$d->date_approve : 
            ($d->is_approve == 0 ? "Reject by ".$d->userid_approve : "Waiting to Approve");
            return $status;
        })
        ->addColumn('remark', function($d){
            return $d->remark ?? '-';
        })
