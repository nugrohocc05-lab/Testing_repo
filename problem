    function groupbuyer(Request $request)
    {
        preconnect(session('db'));

        $q = $request->get('q');
        $page = (int) $request->get('page', 1);

        $paginator = MasterGroupBuyer::select('id', 'group_name')
            ->when($q, function ($query) use ($q) {
                $query->where('group_name', 'like', '%' . $q . '%');
            })
            ->orderBy('group_name', 'asc')
            ->paginate($this->perPage, ['id', 'group_name'], 'page', $page);

        $data = collect($paginator->items())->map(function ($item) {
            return [
                'id' => $item->id,
                'text' => $item->group_name
            ];
        });

        return response()->json([
            'results' => $data,
            'pagination' => [
                'more' => $paginator->hasMorePages()
            ]
        ]);
    }

    function poSelect(Request $request)
    {
        preconnect(session('db'));

        $page = (int) $request->get('page', 1);

        // Purchase order ambil po dan juga idbuyer untuk select group buyer
        $fi = OutputDetailFinalInspection::select('barcode')
            ->distinct()
            ->pluck('barcode');

        $od = OutputDetail::whereIn('barcode', $fi)
            ->where('is_final_inspection', 1)
            ->distinct()
            ->pluck('idpo');

        $query = PurchaseOrder::whereIn('idpo', $od);

        if ($request->filled('groupbuyer') && $request->groupbuyer !== 'all') {
            $buyer = Buyer::where('groupbuyer', $request->groupbuyer)
                ->pluck('idbuyer');

            $query->whereIn('idbuyer', $buyer);
        }

        if ($request->filled('q')) {
            $query->where('po', 'like', '%' . $request->q . '%');
        }

        $paginator = $query
            ->select('idpo', 'po')
            ->distinct()
            ->paginate($this->perPage, ['idpo', 'po'], 'page', $page);

        $po = collect($paginator->items());

        return response()->json([
            'results' => $po->map(function ($item) {
                return [
                    'id' => $item->idpo,
                    'text' => $item->po
                ];
            })->values(),
            'pagination' => [
                'more' => $paginator->hasMorePages()
            ]
        ]);
    }

    function styleSelect(Request $request)
    {
        preconnect(session('db'));

        $page = (int) $request->get('page', 1);

        $fi = OutputDetailFinalInspection::select('barcode')
            ->distinct()
            ->pluck('barcode');

        $od = OutputDetail::whereIn('barcode', $fi)
            ->where('is_final_inspection', 1)
            ->distinct()
            ->pluck('idpo');

        $query = PurchaseOrder::whereIn('idpo', $od);

        if ($request->filled('selectpo') && $request->selectpo !== 'all') {
            $query->where('idpo', $request->selectpo);
        }

        if ($request->filled('q')) {
            $query->where('idstyle', 'like', '%' . $request->q . '%');
        }

        $style = $query
            ->select('idstyle')
            ->distinct()
            ->pluck('idstyle');

        $paginator = Style::whereIn('idstyle', $style)
            ->select('idstyle', 'nmstyle')
            ->paginate($this->perPage, ['idstyle', 'nmstyle'], 'page', $page);

        $styles = collect($paginator->items());

        return response()->json([
            'results' => $styles->map(function ($item) {
                return [
                    'id' => $item->idstyle,
                    'text' => $item->nmstyle
                ];
            })->values(),
            'pagination' => [
                'more' => $paginator->hasMorePages()
            ]
        ]);
    }
