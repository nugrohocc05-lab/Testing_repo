                        <!-- Data -->
                    </tbody>
                    <tfoot>
                        <tr>
                            <td class="total fw-bold text-center" style="color: #4C8CF2">TOTAL</td>
                            <td></td>
                            <td class="text-center fw-bold" id="footQtyRft" style="color: #4CF299">0</td>
                            <td class="text-center fw-bold" id="footQtyInspect" style="color: #4C8CF2">0</td>
                            <td class="text-center fw-bold" id="footQtyDefect" style="color: #F24C4C">0</td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Footer -->
        <div class="mt-2 text-white d-flex flex-wrap justify-content-between align-items-center gap-2 flex-shrink-0">
            <div class="d-flex align-items-center gap-2">
                <img src="{{ _asset('svg/inlinePerformance/time.svg') }}" style="width: 18px; height: 18px;">
                Data Update
                <span id="liveClock"></span>
            </div>
            <div class="d-flex align-items-center">
                <div class="mb-0 d-flex align-items-center gap-2">
