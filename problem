    function groupbuyer(Request $request)
    {
        preconnect(session('db'));

        $q = $request->get('q');
        $page = (int) $request->get('page', 1);

        $paginator = MasterGroupBuyer::select('id', 'group_name')
            ->when($q, function ($query) use ($q) {
                $query->where('group_name', 'like', '%' . $q . '%');
            })
            ->orderBy('group_name', 'asc')
            ->paginate($this->perPage, array('id', 'group_name'), 'page', $page);

        $data = collect($paginator->items())->map(function ($item) {
            return array(
                'id' => $item->id,
                'text' => $item->group_name
            );
        });

        return response()->json(array(
            'results' => $data,
            'pagination' => array(
                'more' => $paginator->hasMorePages()
            )
        ));
    }

    function poSelect(Request $request)
    {
        preconnect(session('db'));

        $page = (int) $request->get('page', 1);

        $leafRows = $this->getLeafHistoryRows($request, null, null, 'combine_pro', false);

        $qtyPerIdpo = $leafRows->groupBy('idpo')->map(function ($g) {
            return $g->sum('qty_ori');
        });

        $validIdpo = $qtyPerIdpo->filter(function ($qty) {
            return $qty > 0;
        })->keys()->values();

        $query = PurchaseOrder::whereIn('idpo', $validIdpo);

        if ($request->filled('groupbuyer') && $request->groupbuyer !== 'all') {
            $buyer = Buyer::where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');
            $query->whereIn('idbuyer', $buyer);
        }

        if ($request->filled('q')) {
            $query->where('po', 'like', '%' . $request->q . '%');
        }

        $paginator = $query
            ->select('idpo', 'po')
            ->distinct()
            ->paginate($this->perPage, array('idpo', 'po'), 'page', $page);

        $poResults = collect($paginator->items());

        return response()->json(array(
            'results' => $poResults->map(function ($item) {
                return array(
                    'id' => $item->idpo,
                    'text' => $item->po
                );
            })->values(),
            'pagination' => array(
                'more' => $paginator->hasMorePages()
            )
        ));
    }

