                        <td><span class="skeleton-box"></span></td>
                        <td><span class="skeleton-box"></span></td>
                        <td><span class="skeleton-box"></span></td>
                        <td><span class="skeleton-box"></span></td>
                        <td><span class="skeleton-box"></span></td>
                    </tr>`;
            }
            $('#tableInlineDefectBody').html(defectRows);

            $('#tableInlineDefectFoot').find('th').each(function (i) {
                if (i === 1) {
                    $(this).text('TOTAL');
                } else if (i === 0 || i === 4) {
                    $(this).html('');
                } else {
                    $(this).html('<span class="skeleton-box"></span>');
                }
            });
        }

        $('#selectWeek').select2({
            placeholder: 'Select Week',
            width: '100%',
            ajax: {
                url: "{{ route('monitoring_endlineperformance_selectweek') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: params => ({ q: params.term, page: params.page || 1 }),
                processResults: data => ({
                    results: data.results,
                    pagination: data.pagination
                }),
                cache: true
            }
        });

        showTableSkeleton();

        $.get("{{ route('monitoring_endlineperformance_currentweek') }}", function (res) {
            const id = res.selected.id;
            const text = res.selected.text;

            const option = new Option(text, id, true, true);

            $('#selectWeek')
                .append(option)
                .trigger('change');
        });


        $('#selectWeek').on('change', function () {
            const weekId = $(this).val();
            if (!weekId) return;

            const [year, week] = weekId.split('-');

            showTableSkeleton();

            $.get("{{ route('monitoring_endlineperformance_data') }}", { week_id: weekId }, function (html) {
                const $res = $(html);

                $('#tableInlinePerformanceBody').html(
