    public function getFilterData(Request $request)
    {
        $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
        $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

        $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
        $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

        $headerQuery = SewingOutput::whereBetween('date', [$dta, $dtb]);

        if ($request->line && $request->line != 'all') {
            $headerQuery = $headerQuery->where('line', $request->line);
        }

        if ($request->groupbuyer && $request->groupbuyer != 'all') {
            $buyerIds  = Buyer::where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');
            $poIds     = PurchaseOrder::whereIn('idbuyer', $buyerIds)->pluck('idpo');
            $outputId  = OutputDetail::whereIn('idpo', $poIds)->pluck('barcode');
            $headerQuery = $headerQuery->whereIn('barcode', $outputId)->where('is_qc', 1);
        }

        $totOutput  = (clone $headerQuery)->where('is_output', 1)->count();
        $totInspect = (clone $headerQuery)->where('is_qc', 1)->count();
        $totDefect  = (clone $headerQuery)->whereNotNull('defect_code')->count();

        $rft = $totInspect > 0 ? round((($totInspect - $totDefect) / $totInspect) * 100, 2) : 0;
        $wft = $totInspect > 0 ? round(($totDefect / $totInspect) * 100, 2) : 0;

        $target    = Param::where('header', 'qc')->where('key', 'rft_endline_target')->value('value');
        $rftTarget = ($totInspect > 0 && $rft <= $target) ? true : false;

        $topDefect = (clone $headerQuery)
            ->whereNotNull('defect_code')
            ->whereNotIn('defect_code', [800, 900])
            ->select('defect_code', DB::raw('COUNT(*) as total'))
            ->groupBy('defect_code')
            ->orderByDesc('total')
            ->orderBy('defect_code', 'asc')
            ->limit(4)
            ->get();

        $defectIds       = $topDefect->pluck('defect_code');
        $masterQcDefects = QCDefect::whereIn('kdcacat', $defectIds)->pluck('deskripsi', 'kdcacat');

        $colors = ['#004FE0', '#3DAA25', '#F4947E', '#F24C4C', '#29B1AE'];

        $topDefect = $topDefect->values()->map(function ($item, $index) use ($masterQcDefects, $totDefect, $colors) {
            $percent = $totDefect > 0 ? ($item->total / $totDefect) * 100 : 0;
            return [
                'defect_id' => $item->defect_code,
                'nmdefect'  => $masterQcDefects[$item->defect_code] ?? '-',
                'total'     => (int) $item->total,
                'percent'   => number_format($percent, 2),
                'color'     => $colors[$index] ?? '#BDBDBD',
            ];
        });

        $top4Total   = $topDefect->sum('total');
        $othersTotal = $totDefect - $top4Total;

        if ($othersTotal > 0) {
            $othersPercent = $totDefect > 0 ? ($othersTotal / $totDefect) * 100 : 0;
            $topDefect->push([
                'defect_id' => 'others',
                'nmdefect'  => 'Others',
                'total'     => (int) $othersTotal,
                'percent'   => number_format($othersPercent, 2),
                'color'     => '#29B1AE',
            ]);
        }

        return [
            'periode' => [
                'from' => $dta->format('d-m-Y'),
                'to'   => $dtb->format('d-m-Y'),
            ],
            'tot_output'  => $totOutput,
            'tot_inspect' => $totInspect,
            'tot_defect'  => $totDefect,
            'rft'         => $rft,
            'wft'         => $wft,
            'rft_target'  => $rftTarget,
            'top_defect'  => $topDefect,
            'line'        => $request->line,
            'group_buyer' => $request->groupbuyer,
        ];
    }

