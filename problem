<script type="text/javascript">
$(document).ready(function(){

    // Set kondisi awal
    $('#groupbuyer_container').show();
    $('#season_container').show();
    $('#po_container').hide();

    // Event onchange untuk Filter Utama
    $('#filter').on('change', function(){
        var selectedValue = $(this).val();
        
        // RESET dropdown lain setiap kali filter berubah
        $('#group_buyer').val(null).trigger('change');
        $('#season').val(null).trigger('change');
        $('#po').val(null).trigger('change');

        if(selectedValue === 'groupbuyer_filter') {
            $('#groupbuyer_container').show();
            $('#season_container').show();
            $('#po_container').hide();
        } else if(selectedValue === 'po_filter') {
            $('#groupbuyer_container').show();
            $('#season_container').show();
            $('#po_container').show();
        } else {
            $('#groupbuyer_container').show();
            $('#season_container').show();
            $('#po_container').hide();
        }
    });

    // Select2 Group Buyer
    $('#group_buyer').select2({
        placeholder: 'Select Group Buyer',
        ajax: {
            url: '{{ route("reportgoodissuelab.listgroupbuyer") }}',
            type: 'GET',
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return {
                    term: params.term,
                    // Kirim nilai filter ke Controller
                    filter_type: $('#filter').val() 
                };
            },
            processResults: function(data) {
                return {
                    results: $.map(data, function(item) {
                        return {
                            id: item.id,
                            text: item.group_name
                        }
                    })
                };
            }
        }
    });

    // Reset season & PO saat Group Buyer berubah
    $('#group_buyer').on('change', function () {
        $('#season').val(null).trigger('change');
        $('#po').val(null).trigger('change');
    });

    // Select2 Season
    $('#season').select2({
        placeholder: 'Select Season',
        ajax: {
            url: '{{ route("reportgoodissuelab.listseason") }}',
            type: 'GET',
            dataType: 'json',
            data: function (params) {
                return {
                    idbuyer: $('#group_buyer').val(),
                    // Kirim nilai filter ke Controller
                    filter_type: $('#filter').val(), 
                    search: params.term || ''
                };
            },
            processResults: function (data) {
                return {
                    results: $.map(data, function (item) {
                        return {
                            id: item.season,
                            text: item.season
                        };
                    })
                };
            }
        },
    });

    // Reset PO saat Season berubah (Opsional, tergantung alur bisnis)
    $('#season').on('change', function () {
        $('#po').val(null).trigger('change');
    });

    // Select2 PO (Tambahan baru)
    $('#po').select2({
        placeholder: 'Select PO',
        ajax: {
            url: '{{ route("reportgoodissuelab.listpo") }}', // Pastikan route ini ada
            type: 'GET',
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return {
                    idbuyer: $('#group_buyer').val(),
                    season: $('#season').val(),
                    // Kirim nilai filter ke Controller
                    filter_type: $('#filter').val(),
                    search: params.term || ''
                };
            },
            processResults: function (data) {
                return {
                    results: $.map(data, function (item) {
                        return {
                            id: item.po,
                            text: item.po
                        };
                    })
                };
            }
        }
    });

    // Data Table
    let table = $('#datalist').DataTable({
        processing: true,
        serverSide: true,
        deferLoading: 0,
        ajax: {
            url: '{{ route("reportgoodissuelab.datatable") }}',
            data: function (d) {
                d.filter_type = $('#filter').val(); // Kirim ke datatable
                d.group_buyer = $('#group_buyer').val();
                d.season = $('#season').val();
                d.po = $('#po').val(); // Kirim PO ke datatable
            }
        },
        columns: [
            { data: 'no' },
            { data: 'cartoncode' },
            { data: 'buyer' },
            { data: 'season' },
            { data: 'style' },
            { data: 'sub_style' },
            { data: 'po' },
            { data: 'qty' },
            { data: 'date' },
            { data: 'user' },
            { data: 'detail' }
        ]
    });

    // Button Find
    $('#findbtn').on('click', function () {
        table.ajax.reload();
    });

    // Button Reset
    $('#resetbtn').on('click', function () {
        $('#filter').val('').trigger('change');
        $('#group_buyer').val(null).trigger('change');
        $('#season').val(null).trigger('change');
        $('#po').val(null).trigger('change');
        table.ajax.reload();
    });

});
</script>
@endsection
