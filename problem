@section('extrascript')
<script type="text/javascript">
$(document).ready(function(){

    // 1. INISIALISASI AWAL SELECT2 (Cukup Sekali)
    $('#filter').select2({ placeholder: "Select Filter" });

    $('#group_buyer').select2({
        placeholder: 'Select Group Buyer',
        ajax: {
            // URL dibuat dinamis mendeteksi nilai dari tipe filter yang aktif
            url: function() {
                let filter = $('#filter').val();
                return filter === 'po_filter' 
                    ? '{{ route("reportgoodissuelab.listgroupbuyerpo") }}' 
                    : '{{ route("reportgoodissuelab.listgroupbuyer") }}';
            },
            type: 'GET',
            dataType: 'json',
            delay: 250,
            data: function (params) {
                return { term: params.term, filter_type: $('#filter').val() };
            },
            processResults: function(data) {
                return {
                    results: $.map(data, function(item) {
                        return { id: item.id, text: item.group_name };
                    })
                };
            }
        }
    });

    $('#season').select2({
        placeholder: 'Select Season',
        ajax: {
            url: function() {
                let filter = $('#filter').val();
                return filter === 'po_filter' 
                    ? '{{ route("reportgoodissuelab.listseasonpo") }}' 
                    : '{{ route("reportgoodissuelab.listseason") }}';
            },
            type: 'GET',
            dataType: 'json',
            data: function (params) {
                return {
                    idbuyer: $('#group_buyer').val(),
                    filter_type: $('#filter').val(),
                    search: params.term || ''
                };
            },
            processResults: function (data) {
                return {
                    results: $.map(data, function (item) {
                        return { id: item.season, text: item.season };
                    })
                };
            }
        },
    });

    // TODO: Inisialisasi Select2 untuk #po jika nanti dibutuhkan pencarian ajax
    $('#po').select2({ placeholder: 'Select PO' });


    // 2. EVENT HANDLER (Kontrol visibilitas & Reset data)
    $('#filter').on('change', function(){
        var selectedValue = $(this).val();

        // Reset semua pilihan di bawahnya setiap kali filter utama berubah
        clearSelectFields(['#group_buyer', '#season', '#po']);

        // Toggle Container berdasarkan pilihan
        if(selectedValue === 'po_filter') {
            $('#groupbuyer_container, #season_container, #po_container').show();
        } else {
            $('#groupbuyer_container, #season_container').show();
            $('#po_container').hide();
        }
    });

    $('#group_buyer').on('change', function () {
        clearSelectFields(['#season', '#po']);
    });

    $('#season').on('change', function () {
        clearSelectFields(['#po']);
    });

    // Helper function untuk mereset Select2 agar tidak mengulang kode .val(null).trigger('change')
    function clearSelectFields(elements) {
        elements.forEach(function(selector) {
            $(selector).val(null).trigger('change.select2'); 
        });
    }


    // 3. DATATABLES
    let table = $('#datalist').DataTable({
        processing: true,
        serverSide: true,
        deferLoading: 0,
        ajax: {
            url: '{{ route("reportgoodissuelab.datatable") }}',
            data: function (d) {
                d.filter_type = $('#filter').val();
                d.group_buyer = $('#group_buyer').val();
                d.season = $('#season').val();
                d.po = $('#po').val(); // Menambahkan parameter PO ke server side datatable
            }
        },
        columns: [
            { data: 'no' },
            { data: 'cartoncode' },
            { data: 'buyer' },
            { data: 'season' },
            { data: 'style' },
            { data: 'sub_style' },
            { data: 'po' },
            { data: 'qty' },
            { data: 'date' },
            { data: 'user' },
            {
                data: 'id',
                orderable: false,
                searchable: false,
                render: function (data) {
                    let url = '{{ route("reportgoodissuelab.detail", ":id" ) }}';
                    return `<a href="${url.replace(':id', data)}">
                                <i class="fa fa-info-circle fa-lg text-blue actiona"></i>
                            </a>`;
                }
            }
        ]
    });

    // 4. BUTTON ACTIONS
    $('#findbtn').on('click', function () {
        table.ajax.reload();
    });

    $('#resetbtn').on('click', function () {
        $('#filter').val('').trigger('change');
        table.ajax.reload();
    });
});
</script>
@endsection
