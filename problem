function qpFormatDateTime(date) {
    var pad = function (n) { return n < 10 ? '0' + n : n; };
    var day    = pad(date.getDate());
    var month  = pad(date.getMonth() + 1);
    var year   = date.getFullYear();
    var hour   = pad(date.getHours());
    var minute = pad(date.getMinutes());
    return day + '-' + month + '-' + year + ' ' + hour + '.' + minute + ' WIB';
}

$(document).ready(function () {
    // Set live clock pojok kanan atas: tanggal hari ini + jam saat halaman dibuka
    $('#liveClock').html(qpFormatDateTime(new Date()));

    let savedTime = localStorage.getItem('lastDataUpdate');
    if (savedTime) {
        $('#liveClock2').html(savedTime);
    }
});


var QP_LARGE_DESKTOP_BREAKPOINT = 1401;
var QP_LARGE_DESKTOP_CAPACITY   = 14;

function qpRenderRows() {
    var dataEl    = document.getElementById('qpRowData');
    var leftList  = document.getElementById('qpListLeft');
    var rightList = document.getElementById('qpListRight');

    if (!dataEl || !leftList || !rightList) return;

    var rows = [];

    try {
        rows = JSON.parse(dataEl.textContent || '[]');
    } catch (e) {
        rows = [];
    }

    leftList.innerHTML  = '';
    rightList.innerHTML = '';

    if (!qpIsDesktop()) {
        leftList.innerHTML = rows.map(function (r) {
            return qpBuildRowHtml(
                qpEscapeHtml(r.namagroup),
                r.tot_inspect, r.rft, r.wft, r.tot_defect, r.oil_defect, r.line_off, r.mps_off, r.cap_filled
            );
        }).join('');

        return;
    }

    var capacity;

    if (window.innerWidth >= QP_LARGE_DESKTOP_BREAKPOINT) {
        // Layar besar: fix 14 baris di kolom kiri
        capacity = QP_LARGE_DESKTOP_CAPACITY;
    } else {
        // Desktop kecil (992 - 1400px): tetap menyesuaikan otomatis
        var metrics = qpMeasureRowMetrics(leftList);
        var availableHeight = leftList.clientHeight;

        capacity = Math.max(
            1,
            Math.floor((availableHeight + metrics.gap) / (metrics.rowHeight + metrics.gap))
        );
    }

    var leftRows  = rows.slice(0, capacity);
    var rightRows = rows.slice(capacity);

    leftList.innerHTML = leftRows.map(function (r) {
        return qpBuildRowHtml(
            qpEscapeHtml(r.namagroup),
            r.tot_inspect, r.rft, r.wft, r.tot_defect, r.oil_defect, r.line_off, r.mps_off, r.cap_filled
        );
    }).join('');

    rightList.innerHTML = rightRows.map(function (r) {
        return qpBuildRowHtml(
            qpEscapeHtml(r.namagroup),
            r.tot_inspect, r.rft, r.wft, r.tot_defect, r.oil_defect, r.line_off, r.mps_off, r.cap_filled
        );
    }).join('');
}