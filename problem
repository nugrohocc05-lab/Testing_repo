<script>
    var QP_ROW_HEIGHT = 50; // px — samakan dengan height .bg-card-line

    function qpAdjustDashboardHeight() {
        var wrap = document.querySelector('.dashboard-wrap');
        if (!wrap) return;

        // reset dulu supaya perhitungan posisi (offsetTop) akurat,
        // tidak terpengaruh tinggi lama yang sudah di-set
        wrap.style.height = 'auto';

        var top = wrap.getBoundingClientRect().top;
        var available = window.innerHeight - top;

        // beri sedikit buffer bawah biar tidak mepet ke tepi layar
        wrap.style.height = Math.max(available - 8, 300) + 'px';
    }

    function qpEscapeHtml(str) {
        return String(str).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    function qpBuildRowHtml(name) {
        return '' +
            '<div class="qp-grid px-4">' +
                '<span class="bg-card-line rounded-3 d-flex justify-content-center align-items-center">' + name + '</span>' +
                '<span class="bg-card-line rounded-3 d-flex justify-content-center align-items-center text-center">234</span>' +
                '<span class="bg-card-line rounded-3 d-flex justify-content-center align-items-center">98.21</span>' +
                '<span class="bg-card-line rounded-3 d-flex justify-content-center align-items-center">1.79</span>' +
                '<div class="bg-card-line rounded-3 d-flex justify-content-center align-items-center gap-2">' +
                    '<span class="number-circle" style="background-color: #BD3F3F3D;"></span>' +
                    '<span class="number-circle" style="background-color: #F9A51D40;"></span>' +
                    '<span class="number-circle" style="background-color: #1D9A5C;"></span>' +
                    '<span class="number-circle" style="background-color: #1744B740;"></span>' +
                '</div>' +
            '</div>';
    }

    function qpRenderRows() {
        var dataEl   = document.getElementById('qpRowData');
        var leftList = document.getElementById('qpListLeft');
        var rightList = document.getElementById('qpListRight');
        if (!dataEl || !leftList || !rightList) return;

        var rows = [];
        try {
            rows = JSON.parse(dataEl.textContent || '[]');
        } catch (e) {
            rows = [];
        }

        // kosongkan dulu supaya clientHeight yang diukur adalah tinggi
        // container murni (bukan terpengaruh isi lama)
        leftList.innerHTML = '';
        rightList.innerHTML = '';

        // berapa baris yang MUAT PAS di kiri berdasar tinggi asli kolom
        var availableHeight = leftList.clientHeight;
        var capacity = Math.max(1, Math.floor(availableHeight / QP_ROW_HEIGHT));

        var leftRows  = rows.slice(0, capacity);
        var rightRows = rows.slice(capacity);

        leftList.innerHTML  = leftRows.map(function (r) { return qpBuildRowHtml(qpEscapeHtml(r.namagroup)); }).join('');
        rightList.innerHTML = rightRows.map(function (r) { return qpBuildRowHtml(qpEscapeHtml(r.namagroup)); }).join('');
    }

    function qpRefreshLayout() {
        qpAdjustDashboardHeight();
        // tunggu 1 frame supaya tinggi baru sudah ke-apply sebelum diukur
        requestAnimationFrame(qpRenderRows);
    }

    window.addEventListener('load', qpRefreshLayout);
    window.addEventListener('resize', qpRefreshLayout);
    document.addEventListener('DOMContentLoaded', qpRefreshLayout);
</script>
