    <script>
        $(document).ready(function () {

           $(document).ready(function () {
                let savedTime = localStorage.getItem('lastDataUpdate');
                if (savedTime) {
                    $('#liveClock2').html(savedTime);
                }
            });

            let currentLine      = @json($kodegroup ?? null);
            let currentLineLabel = @json($namaline ?? null);
            let currentDate       = @json($date);
            let skipInitialChange = true;
            let exportDT          = null;

            const formattedDate = new Date(currentDate).toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'long',
                year: 'numeric'
            });

           function formatDate(date) {
                const d = new Date(date);

                const months = [
                    'January', 'February', 'March', 'April', 'May', 'June',
                    'July', 'August', 'September', 'October', 'November', 'December'
                ];

                const day = d.getDate();
                const monthName = months[d.getMonth()];
                const year = d.getFullYear();

                const hours = String(d.getHours()).padStart(2, '0');
                const minutes = String(d.getMinutes()).padStart(2, '0');
                const seconds = String(d.getSeconds()).padStart(2, '0');

                return `${day} ${monthName} ${year}`;
            }

            function updateLiveClock() {
                const now = new Date();

                const formatted = formatDate(now);

                let currentDate = @json($date);

                const dateTime = currentDate ? formatDate(currentDate) : formatted;

                $('#liveClock').text(dateTime);
            }
            updateLiveClock();

            function updateClock() {
                const now = new Date();
                const hour = String(now.getHours()).padStart(2, '0');
                const minute = String(now.getMinutes()).padStart(2, '0');
                const second = String(now.getSeconds()).padStart(2, '0');

                const formatted = `${day} ${month[now.getMonth()]} ${year} - ${hour} : ${minute} : ${second}`;

                const addDate = `${formattedDate} - ${hour} : ${minute} : ${second}`;
                document.getElementById('liveClock').innerHTML = addDate;
            }

            $('#line').select2({
                placeholder: 'Select Line',
                width: '100%',
                ajax: {
                    url: "{{ route('monitoring_inlineperformanceselectline') }}",
                    type: "GET",
                    dataType: "json",
                    delay: 500,
                    data: function (params) {
                        return {
                            q: params.term,
                            page: params.page || 1
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: $.map(data.data, function (item) {
                                return {
                                    id: item.kodegroup,
                                    text: item.namabagian + ' - ' + item.namagroup
                                };
                            }),
                            pagination: {
                                more: data.to < data.total
                            }
                        };
                    },
                    cache: true
                }
            });

            if (currentLine) {
                const preOption = new Option(currentLineLabel, currentLine, true, true);
                $('#line').append(preOption).trigger('change');
            }

            function fetchInlineLts() {
                if (!currentLine) return;

                $('#datatable-container').css('opacity', 0.5);

                $.ajax({
                    url: "{{ route('monitoring_inlineperformance_filterInlineLts') }}",
                    type: "GET",
                    data: { line: currentLine, date: currentDate },
                    success: function (res) {
                        $('#tot_inspect').text(res.tot_inspect);
                        $('#tot_defect').text(res.tot_defect);
                        $('#rft').text(res.rft);
                        $('#wft').text(res.wft);
                        $('#datatable-container').html(res.html);
                    },
                    error: function (xhr) {
                        console.log(xhr.responseJSON ? xhr.responseJSON.message : 'Request failed');
                    },
                    complete: function () {
                        $('#datatable-container').css('opacity', 1);
                    }
                });
            }

            $('#line').on('change', function () {
                if (skipInitialChange) {
                    skipInitialChange = false;
                    return;
                }
                currentLine = $(this).val();
                fetchInlineLts();
            });

            function resetExportModal() {
                if (exportDT) {
                    exportDT.destroy();
                    exportDT = null;
                }
                $('#exportButtons').empty();
                $('#exportSummary').empty();
                $('#exportTableHead').empty();
                $('#exportTableBody').empty();
                $('#exportTable').addClass('d-none');
                $('#exportLoading').removeClass('d-none').text('Loading...');
            }

            let lastExportData = null;

            function loadExportPreview() {
                resetExportModal();

                $.ajax({
                    url: "{{ route('monitoring_inlineperformance_exportData') }}",
                    type: "GET",
                    data: { line: currentLine, date: currentDate },
                    dataType: "json",
                    success: function (res) {
                        if (!res) {
                            $('#exportLoading').text('Data export is not available.');
                            return;
                        }

                        lastExportData = res;

                            let summaryHtml = `
                                <div class="mb-3 text-white">
                                    <table class="exportPreviewModal table table-sm table-borderless mb-0" style="width:auto;">
                                        <tr>
                                            <td class="pe-4"><strong>Location</strong>: ${res.namaline ?? '-'}</td>
                                            <td class="pe-4"><strong>Date</strong>: ${res.date ?? '-'}</td>
                                            <td class="pe-4"><strong>Inspect Qty</strong>: ${res.tot_inspect ?? 0}</td>
                                            <td class="pe-4"><strong>Defect Qty</strong>: ${res.tot_defect ?? 0}</td>
                                            <td class="pe-4"><strong>RFT (%)</strong>: ${res.rft ?? '0.00'}</td>
                                            <td><strong>WFT (%)</strong>: ${res.wft ?? '0.00'}</td>
                                        </tr>
                                    </table>
                                </div>
                            `;
                            $('#exportSummary').html(summaryHtml);

                        let theadHtml = '<tr><th>Round</th>' +
                            res.operator_names.map(function (n) { return '<th>' + n + '</th>'; }).join('') +
                            '</tr>';
                        $('#exportTableHead').html(theadHtml);

                        let tbodyHtml = res.round_rows.map(function (row) {
                            return '<tr>' + row.map(function (cell) {
                                return '<td>' + (cell ?? '') + '</td>';
                            }).join('') + '</tr>';
                        }).join('');
                        $('#exportTableBody').html(tbodyHtml);

                        $('#exportLoading').addClass('d-none');
                        $('#exportTable').removeClass('d-none');

                        exportDT = $('#exportTable').DataTable({
                            scrollX: true,
                            paging: false,
                            searching: false,
                            lengthChange: false,
                            info: false,
                            dom: 'frtip',
                            buttons: [
                                {
                                    extend: 'excelHtml5',
                                    text: 'Download Excel',
                                    className: 'btn btn-success btn-sm',
                                    title: 'Inline LTS' + (currentLine || '') + '_' + (currentDate || ''),
                                    filename: 'Inline LTS' + (currentLine || '') + '_' + (currentDate || ''),
                                    exportOptions: { columns: ':visible' },
                                    customizeData: function (data) {
                                        if (!lastExportData) return;
                                        let d = lastExportData;

                                        // Baris 2: header summary
                                        let summaryHeader = ['Location', 'Date', 'Inspect Qty', 'Defect Qty', 'RFT (%)', 'WFT (%)'];

