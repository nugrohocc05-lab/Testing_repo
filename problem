<script>
$(function () {
    let allDefects = [];
    let selectedDefects = [];
    let hasFiltered = false;
    let currentMode = 'weekly';

    const $chips = $('#selectedChips');
    const $dropdown = $('#filterDropdown');
    const $optionsList = $('#filterOptionsList');

    const chartDom = document.getElementById('defectChart');
    const myChart = echarts.init(chartDom);

    let xAxisLabels = [];
    let xAxisTimes = [];
    let chartSeries = [];
    let bucketMeta = [];

    function styleRange(worksheet, startRow, endRow, startCol, endCol, style) {
        for (let row = startRow; row <= endRow; row++) {
            for (let col = startCol; col <= endCol; col++) {
                const cell = XLSX.utils.encode_cell({ r: row, c: col });
                if (worksheet[cell]) {
                    worksheet[cell].s = style;
                }
            }
        }
    }

    function exportExcel() {
        if (!xAxisLabels || xAxisLabels.length === 0) {
            swal('Warning!', `No data to export.`, 'warning');
            return;
        }

        const workbook = XLSX.utils.book_new();
        const exportData = [];

        const borderBase = { style: 'thin', color: { rgb: 'B7B7B7' } };
        const border = { top: borderBase, bottom: borderBase, left: borderBase, right: borderBase };

        const titleStyle = {
            font: { bold: true, color: { rgb: 'FFFFFF' }, sz: 12 },
            fill: { fgColor: { rgb: '1B2433' } },
            alignment: { horizontal: 'left', vertical: 'center' },
            border: border
        };

        const headerStyle = {
            font: { bold: true, color: { rgb: 'FFFFFF' } },
            fill: { fgColor: { rgb: '242E3E' } },
            alignment: { horizontal: 'center', vertical: 'center', wrapText: true },
            border: border
        };

        const bodyStyle = { alignment: { vertical: 'center' }, border: border };
        const centerStyle = { alignment: { horizontal: 'center', vertical: 'center' }, border: border };

        const titleRow = exportData.length;
        let modeText = currentMode === 'weekly' ? 'Weekly' : 'Daily';
        exportData.push([`DEFECT MONITORING (WFT%) - ${modeText}`]);

        const filterRow = exportData.length;
        let filterText = 'All Defect';

        if (selectedDefects.length > 0) {
            const selectedNames = selectedDefects.map(code => {
                const defect = allDefects.find(o => String(o.code) === String(code));
                return defect ? defect.name : code;
            });
            filterText = selectedNames.join(', ');
        }
        exportData.push(['Filter Defect:', filterText]);

        const headerRow = exportData.length;
        const header = [currentMode === 'weekly' ? 'Week / Periode' : 'Date'];
        chartSeries.forEach(series => {
            header.push(series.name + ' WFT (%)');
        });
        exportData.push(header);

        const dataStartRow = exportData.length;
        xAxisLabels.forEach((label, index) => {
            const row = [label];
            chartSeries.forEach(series => {
                const value = series.data && series.data[index] !== undefined ? series.data[index] : 0;
                row.push(value);
            });
            exportData.push(row);
        });
        const dataEndRow = exportData.length - 1;

        const worksheet = XLSX.utils.aoa_to_sheet(exportData);
        const totalColumns = Math.max(chartSeries.length + 1, 4);
        const cols = [];

        for (let i = 0; i < totalColumns; i++) {
            cols.push({ wch: i === 0 ? 25 : 20 });
        }
        worksheet['!cols'] = cols;

        worksheet['!merges'] = [
            { s: { r: titleRow, c: 0 }, e: { r: titleRow, c: totalColumns - 1 } }
        ];

        if (dataEndRow >= dataStartRow) {
            styleRange(worksheet, dataStartRow, dataEndRow, 0, chartSeries.length, bodyStyle);
            styleRange(worksheet, dataStartRow, dataEndRow, 0, 0, centerStyle);
            if (chartSeries.length > 0) {
                styleRange(worksheet, dataStartRow, dataEndRow, 1, chartSeries.length, centerStyle);
            }
        }

        worksheet['!rows'] = [];
        worksheet['!rows'][titleRow] = { hpt: 24 };
        worksheet['!rows'][headerRow] = { hpt: 28 };

        worksheet['!freeze'] = { xSplit: 0, ySplit: headerRow + 1 };
        XLSX.utils.book_append_sheet(workbook, worksheet, 'Defect Monitoring');

        const fileName = `Report_Defect_Endline_${modeText}.xlsx`;
        XLSX.writeFile(workbook, fileName);
    }

    function fetchDefectOptions() {
        return $.get("{{ route('monitoring_endlineperformance_defectoptions') }}", { mode: currentMode }, function (res) {
            allDefects = res.options;
            const validCodes = allDefects.map(o => o.code);
            selectedDefects = selectedDefects.filter(c => validCodes.includes(c));
        });
    }

    function fetchChartData() {
        const params = {
            mode: currentMode,
            defects: selectedDefects,
        };

        $.get("{{ route('monitoring_endlineperformance_defectdata') }}", params, function (res) {
            xAxisLabels = res.labels;
            xAxisTimes = res.times || [];
            chartSeries = res.series;
            bucketMeta = res.bucketMeta || [];
            renderChart();
            $('#loading').hide();
        });
    }

    function changeSchedule(type) {
        currentMode = type;
        selectedDefects = [];
        hasFiltered = false;
        $('#loading').show();
        fetchDefectOptions().then(function () {
            renderChips();
            renderOptions();
            fetchChartData();
        });
    }

    $('#weekly').on('change', function () { changeSchedule('weekly'); });
    $('#day').on('change', function () { changeSchedule('day'); });

    function clearChart() {
        xAxisLabels = [];
        chartSeries = [];
        renderChart();
    }

    function buildChartOption() {
        const series = chartSeries.map(s => ({
            name: s.name,
            code: s.code,
            type: 'line',
            smooth: false,
            symbol: 'circle',
            symbolSize: 15,
            data: s.data,
            itemStyle: { color: s.color },
            lineStyle: { width: 3, color: s.color }
        }));

        const xAxisConfig = {
            type: 'category',
            boundaryGap: true,
            data: xAxisLabels,
            axisLine: { lineStyle: { color: '#3A4557' } },
            axisTick: { show: false },
            axisLabel: { color: '#8A93A6', fontSize: 12 },
            splitLine: { show: false }
        };

        return {
            backgroundColor: 'transparent',
            textStyle: { color: '#8A93A6' },
            toolbox: {
                show: true,
                right: 10,
                top: 10,
                feature: {
                    saveAsImage: {
                        show: true,
                        title: 'Download',
                        type: 'png',
                        name: `Chart_Defect_Endline_${currentMode === 'weekly' ? 'Weekly' : 'Daily'}`
                    }
                }
            },
            tooltip: {
                trigger: 'item',
                backgroundColor: '#1B2434',
                borderColor: '#3A4557',
                borderWidth: 1,
                padding: 12,
                textStyle: { color: '#FFFFFF' },
                formatter: function (params) {
                    if (!params) return '';
                    const dataIndex = params.dataIndex;
                    const dateLabel = xAxisLabels[dataIndex] ?? params.axisValueLabel ?? params.name;
                    const wft = params.data || 0; // category axis -> data langsung berupa angka

                    const seriesObj = chartSeries[params.seriesIndex];
                    const seriesCode = seriesObj?.code;
                    const defectPcs = seriesObj?.qty?.[dataIndex] ?? 0;

                    const topStyles = bucketMeta[dataIndex]?.topStyles?.[seriesCode] || [];

                    const isSmallScreen = window.innerWidth <= 768;
                    const tooltipWidth = isSmallScreen ? 'min(85vw, 280px)' : 'clamp(220px, 24vw, 340px)';
                    const fontSize = isSmallScreen ? '11px' : '13px';

                    const rowStyle = `display:flex; align-items:flex-start; gap:6px; margin-bottom:4px;`;
                    const nameColStyle = `flex:1 1 auto; min-width:0; overflow-wrap:break-word; word-break:break-word; white-space:normal; line-height:1.3;`;
                    const pcsColStyle = `flex:0 0 55px; text-align:right; white-space:nowrap; font-variant-numeric:tabular-nums;`;
                    const pctColStyle = `flex:0 0 55px; text-align:right; white-space:nowrap; font-variant-numeric:tabular-nums;`;

                    const headerRowStyle = `${rowStyle} font-weight:500; color:#8A93A6; border-bottom:1px solid #3A4557; padding-bottom:4px;`;

                    let html = `
                        <div style="width:${tooltipWidth}; max-width:90vw; box-sizing:border-box; font-size:${fontSize};">
                            <div style="font-weight:600; margin-bottom:8px; overflow-wrap:break-word;">
                                ${dateLabel}
                            </div>

                            <div style="${headerRowStyle}">
                                <span style="${nameColStyle}">Defect</span>
                                <span style="${pcsColStyle}">Qty</span>
                                <span style="${pctColStyle}">WFT %</span>
                            </div>
                            <div style="${rowStyle}">
                                <span style="${nameColStyle}">${params.seriesName}</span>
                                <span style="${pcsColStyle}">${defectPcs}</span>
                                <span style="${pctColStyle}">${wft.toFixed(2)}%</span>
                            </div>

                            <hr style="border-color:#3A4557; margin:8px 0;">
                            <div style="margin-bottom:4px; font-weight:500;">Top Style Contribute</div>
                    `;

                    if (topStyles.length) {
                        html += `
                            <div style="${headerRowStyle}">
                                <span style="${nameColStyle}">Style</span>
                                <span style="${pcsColStyle}">Qty</span>
                                <span style="${pctColStyle}">WFT %</span>
                            </div>
                        `;
                        topStyles.forEach((s, i) => {
                            html += `
                                <div style="${rowStyle}">
                                    <span style="${nameColStyle}" title="${s.style}">${i + 1}. ${s.style}</span>
                                    <span style="${pcsColStyle}">${s.qty}</span>
                                    <span style="${pctColStyle}">${s.wft.toFixed(2)}%</span>
                                </div>
                            `;
                        });
                    } else {
                        html += `<div style="color:#8A93A6;">Style Not Found</div>`;
                    }

                    html += `</div>`;
                    return html;
                }
            },
            grid: { left: 55, right: 25, top: 45, bottom: 35, containLabel: false },
            xAxis: xAxisConfig,
            yAxis: {
                type: 'value',
                name: 'WFT (%)',
                nameLocation: 'end',
                nameGap: 20,
                nameTextStyle: { color: '#8A93A6', fontSize: 11, align: 'left' },
                min: 0,
                max: 100,
                interval: 20,
                axisLine: { show: false },
                axisTick: { show: false },
                axisLabel: { color: '#8A93A6', fontSize: 11, formatter: (val) => `${val.toFixed(2)}%` },
                splitLine: { lineStyle: { color: '#2A3446', type: 'solid' } }
            },
            series: series
        };
    }

    function renderChart() {
        myChart.setOption(buildChartOption(), true);
    }

    window.addEventListener('resize', function () { myChart.resize(); });
    if (window.ResizeObserver) {
        const ro = new ResizeObserver(() => myChart.resize());
        ro.observe(chartDom.parentElement);
    }

    let highlightedCode = null;

    function renderChips() {
        $chips.empty();
        selectedDefects.forEach(code => {
            code = String(code);
            const opt = allDefects.find(o => String(o.code) === code);
            const name = opt ? opt.name : code;
            const color = opt ? opt.color : '#999';
            const isActive = highlightedCode === code;

            $chips.append(`
                <span class="filter-chip ${isActive ? 'is-active' : ''}" data-code="${code}" style="background-color: ${color}; border-color: ${color}; color: #fff; ${isActive ? 'box-shadow: 0 0 0 2px #fff inset;' : ''}" title="${name}">
                    <span class="chip-name">${name}</span>
                    <button type="button" class="chip-remove" data-code="${code}">✕</button>
                </span>
            `);
        });
    }

    function renderOptions(searchKeyword = '') {
        $optionsList.empty();

        if (allDefects.length === 0) {
            $optionsList.append('<span class="filter-option-empty">No defect data</span>');
            return;
        }

        const keyword = searchKeyword.trim().toLowerCase();
        const filteredDefects = keyword
            ? allDefects.filter(opt => opt.name.toLowerCase().includes(keyword))
            : allDefects;

        if (filteredDefects.length === 0) {
            $optionsList.append('<span class="filter-option-empty">No defects found</span>');
            return;
        }

        const limitReached = selectedDefects.length >= MAX_DEFECT_SELECTION;

        filteredDefects.forEach(opt => {
            const code = String(opt.code);
            const isSelected = selectedDefects.includes(code);
            const color = opt.color || '#999';
            const disabledClass = (!isSelected && limitReached) ? 'is-disabled' : '';

            $optionsList.append(`
                <span class="filter-option-pill ${isSelected ? 'is-selected' : ''} ${disabledClass}" data-code="${code}" data-color="${color}" style="--defect-color: ${color};">
                    ${opt.name}
                </span>
            `);
        });
    }

    $(document).on('input', '#defectSearchInput', function () {
        renderOptions($(this).val());
    });

    $('#addFilterBtn').on('click', function (e) {
        e.stopPropagation();
        $('#defectSearchInput').val('');
        renderOptions();
        $dropdown.toggleClass('d-none');
    });

    const MAX_DEFECT_SELECTION = 5;

    $optionsList.on('click', '.filter-option-pill', function () {
        const code = String($(this).attr('data-code'));
        if (selectedDefects.includes(code)) {
            selectedDefects = selectedDefects.filter(c => c !== code);
        } else {
            if (selectedDefects.length >= MAX_DEFECT_SELECTION) {
                swal('Warning!', `Maximum can only choose ${MAX_DEFECT_SELECTION} defect`, 'warning');
                return;
            }
            selectedDefects.push(code);
        }
        renderChips();
        renderOptions();
    });

    $chips.on('click', '.filter-chip', function (e) {
        if ($(e.target).hasClass('chip-remove')) return;

        const code = String($(this).attr('data-code'));
        const opt = allDefects.find(o => String(o.code) === code);
        if (!opt) return;

        if (highlightedCode === code) {
            highlightedCode = null;
            myChart.dispatchAction({ type: 'downplay' });
        } else {
            highlightedCode = code;
            myChart.dispatchAction({ type: 'downplay' });
            myChart.dispatchAction({ type: 'highlight', seriesName: opt.name });
        }
        renderChips();
    });

    const series = chartSeries.map(s => ({
        name: s.name,
        code: s.code,
        type: 'line',
        smooth: false,
        symbol: 'circle',
        symbolSize: 15,
        data: isDayMode ? s.data.map((val, idx) => [xAxisTimes[idx], val]) : s.data,
        itemStyle: { color: s.color },
        lineStyle: { width: 3, color: s.color },
        emphasis: {
            lineStyle: { width: 5 },
            focus: 'series'
        },
        blur: {
            lineStyle: { opacity: 0.15 },
            itemStyle: { opacity: 0.15 }
        }
    }));

    $(document).on('click', function (e) {
        if (!$(e.target).closest('.defect-filter').length) {
            $dropdown.addClass('d-none');
        }
    });

    $('#findbtndefect').on('click', function () {
        fetchChartData();
        hasFiltered = true;
        $('#loading').show();
    });

    fetchDefectOptions().then(function () {
        renderChips();
        renderOptions();
    });

    fetchChartData();

    $('#export-datatable').on('click', function (e) {
        e.preventDefault();

        if (!hasFiltered) {
            swal('Warning!', 'Please click Find first before exporting!', 'warning');
            return;
        }

        exportExcel();
    });

    $chips.on('click', '.chip-remove', function (e) {
        e.stopPropagation();
        const code = String($(this).attr('data-code'));
        selectedDefects = selectedDefects.filter(c => c !== code);
        if (highlightedCode === code) {
            highlightedCode = null;
            myChart.dispatchAction({ type: 'downplay' });
        }
        renderChips();
        renderOptions();
    });

});
</script>
@include('layouts.loading')
