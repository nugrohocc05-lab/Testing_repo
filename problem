<script>
$(function () {

    let weeklyDataTable = null;

    let isTableLoading = false;


    /*
    |--------------------------------------------------------------------------
    | DESTROY DATATABLE
    |--------------------------------------------------------------------------
    */
    function destroyPerformanceDataTable() {

        if (
            $.fn.DataTable.isDataTable(
                '#tableInlinePerformance'
            )
        ) {

            $('#tableInlinePerformance')
                .DataTable()
                .destroy();
        }

        weeklyDataTable = null;
    }


    /*
    |--------------------------------------------------------------------------
    | INIT DATATABLE
    |--------------------------------------------------------------------------
    */
    function initPerformanceDataTable() {

        const rowCount =
            $('#tableInlinePerformanceBody tr').length;


        if (rowCount === 0) {
            return;
        }


        destroyPerformanceDataTable();


        weeklyDataTable =
            $('#tableInlinePerformance').DataTable({

                paging: false,

                ordering: false,

                searching: false,

                info: false,

                lengthChange: false,

                autoWidth: false,

                dom: ''
            });
    }


    /*
    |--------------------------------------------------------------------------
    | EXPORT 2 TABLES TO 1 EXCEL FILE
    |--------------------------------------------------------------------------
    */
function exportExcel() {

    if (typeof XLSX === 'undefined') {
        alert('Library SheetJS belum tersedia.');
        return;
    }

    const workbook = XLSX.utils.book_new();

    /*
    |--------------------------------------------------------------------------
    | HELPER
    |--------------------------------------------------------------------------
    */

    function addCellStyle(
        worksheet,
        cellAddress,
        style
    ) {

        if (!worksheet[cellAddress]) {
            return;
        }

        worksheet[cellAddress].s = style;
    }


    function styleRange(
        worksheet,
        startRow,
        endRow,
        startCol,
        endCol,
        style
    ) {

        for (
            let row = startRow;
            row <= endRow;
            row++
        ) {

            for (
                let col = startCol;
                col <= endCol;
                col++
            ) {

                const cell =
                    XLSX.utils.encode_cell({
                        r: row,
                        c: col
                    });

                if (!worksheet[cell]) {
                    continue;
                }

                worksheet[cell].s = style;
            }
        }
    }


    /*
    |--------------------------------------------------------------------------
    | STYLE
    |--------------------------------------------------------------------------
    */

    const border = {
        top: {
            style: 'thin',
            color: {
                rgb: 'B7B7B7'
            }
        },
        bottom: {
            style: 'thin',
            color: {
                rgb: 'B7B7B7'
            }
        },
        left: {
            style: 'thin',
            color: {
                rgb: 'B7B7B7'
            }
        },
        right: {
            style: 'thin',
            color: {
                rgb: 'B7B7B7'
            }
        }
    };


    const titleStyle = {

        font: {
            bold: true,
            color: {
                rgb: 'FFFFFF'
            },
            sz: 14
        },

        fill: {
            fgColor: {
                rgb: '1B2433'
            }
        },

        alignment: {
            horizontal: 'left',
            vertical: 'center'
        },

        border: border
    };


    const headerStyle = {

        font: {
            bold: true,
            color: {
                rgb: 'FFFFFF'
            }
        },

        fill: {
            fgColor: {
                rgb: '242E3E'
            }
        },

        alignment: {
            horizontal: 'center',
            vertical: 'center',
            wrapText: true
        },

        border: border
    };


    const bodyStyle = {

        alignment: {
            vertical: 'center'
        },

        border: border
    };


    const centerStyle = {

        alignment: {
            horizontal: 'center',
            vertical: 'center'
        },

        border: border
    };


    const totalStyle = {

        font: {
            bold: true,
            color: {
                rgb: 'FFFFFF'
            }
        },

        fill: {
            fgColor: {
                rgb: '1B2433'
            }
        },

        alignment: {
            vertical: 'center'
        },

        border: border
    };


    /*
    |--------------------------------------------------------------------------
    | EXPORT DATA
    |--------------------------------------------------------------------------
    */

    const exportData = [];


    /*
    |--------------------------------------------------------------------------
    | TABLE 1 TITLE
    |--------------------------------------------------------------------------
    */

    const performanceTitleRow =
        exportData.length;

    exportData.push([
        'WEEKLY ENDLINE PERFORMANCE'
    ]);

    exportData.push([]);


    /*
    |--------------------------------------------------------------------------
    | TABLE 1 HEADER
    |--------------------------------------------------------------------------
    */

    const performanceHeaderRow =
        exportData.length;

    exportData.push([
        'Week',
        'Periode Date',
        'RFT QTY (Pcs)',
        'Inspect QTY (Pcs)',
        'Defect QTY (Pcs)',
        'RFT (%)',
        'WFT (%)',
        'Non Process (%)',
        'Process (%)'
    ]);


    /*
    |--------------------------------------------------------------------------
    | TABLE 1 DATA
    |--------------------------------------------------------------------------
    */

    const performanceStartRow =
        exportData.length;


    if (
        weeklyDataTable &&
        $.fn.DataTable.isDataTable(
            '#tableInlinePerformance'
        )
    ) {

        weeklyDataTable
            .rows()
            .every(function () {

                const row = this.data();

                exportData.push(
                    row.map(function (value) {

                        return $('<div>')
                            .html(value)
                            .text()
                            .trim();

                    })
                );
            });

    } else {

        const performanceTable =
            document.getElementById(
                'tableInlinePerformance'
            );

        const sheet =
            XLSX.utils.table_to_sheet(
                performanceTable,
                {
                    raw: true
                }
            );

        const data =
            XLSX.utils.sheet_to_json(
                sheet,
                {
                    header: 1
                }
            );

        data
            .slice(1)
            .forEach(function (row) {

                exportData.push(row);

            });
    }


    const performanceEndRow =
        exportData.length - 1;


    /*
    |--------------------------------------------------------------------------
    | SPACE
    |--------------------------------------------------------------------------
    */

    exportData.push([]);
    exportData.push([]);
    exportData.push([]);


    /*
    |--------------------------------------------------------------------------
    | TABLE 2 TITLE
    |--------------------------------------------------------------------------
    */

    const defectTitleRow =
        exportData.length;

    exportData.push([
        'TOP 5 DEFECT DETAIL'
    ]);

    exportData.push([]);


    /*
    |--------------------------------------------------------------------------
    | TABLE 2 HEADER
    |--------------------------------------------------------------------------
    */

    const defectHeaderRow =
        exportData.length;

    exportData.push([
        'No.',
        'Defect',
        'Defect QTY',
        '% of Total Defect',
        'Top Style (Most Contribute)',
        'QTY Defect (Pcs)',
        '% of Defect'
    ]);


    /*
    |--------------------------------------------------------------------------
    | TABLE 2 DATA
    |--------------------------------------------------------------------------
    */

    const defectStartRow =
        exportData.length;


    const defectTable =
        document.getElementById(
            'tableInlineDefect'
        );


    const defectSheet =
        XLSX.utils.table_to_sheet(
            defectTable,
            {
                raw: true
            }
        );


    const defectData =
        XLSX.utils.sheet_to_json(
            defectSheet,
            {
                header: 1
            }
        );


    /*
    |--------------------------------------------------------------------------
    | Remove HTML Header
    |--------------------------------------------------------------------------
    */

    defectData
        .slice(1)
        .forEach(function (row) {

            exportData.push(row);

        });


    const defectEndRow =
        exportData.length - 1;


    /*
    |--------------------------------------------------------------------------
    | CREATE WORKSHEET
    |--------------------------------------------------------------------------
    */

    const worksheet =
        XLSX.utils.aoa_to_sheet(
            exportData
        );


    /*
    |--------------------------------------------------------------------------
    | COLUMN WIDTH
    |--------------------------------------------------------------------------
    */

    worksheet['!cols'] = [

        { wch: 8 },
        { wch: 30 },
        { wch: 18 },
        { wch: 20 },
        { wch: 32 },
        { wch: 20 },
        { wch: 18 },
        { wch: 17 },
        { wch: 15 }

    ];


    /*
    |--------------------------------------------------------------------------
    | MERGE TITLE 1
    |--------------------------------------------------------------------------
    */

    worksheet['!merges'] = [

        {
            s: {
                r: performanceTitleRow,
                c: 0
            },

            e: {
                r: performanceTitleRow,
                c: 8
            }
        },

        {
            s: {
                r: defectTitleRow,
                c: 0
            },

            e: {
                r: defectTitleRow,
                c: 8
            }
        }

    ];


    /*
    |--------------------------------------------------------------------------
    | TITLE STYLE 1
    |--------------------------------------------------------------------------
    */

    styleRange(
        worksheet,
        performanceTitleRow,
        performanceTitleRow,
        0,
        8,
        titleStyle
    );


    /*
    |--------------------------------------------------------------------------
    | HEADER STYLE 1
    |--------------------------------------------------------------------------
    */

    styleRange(
        worksheet,
        performanceHeaderRow,
        performanceHeaderRow,
        0,
        8,
        headerStyle
    );


    /*
    |--------------------------------------------------------------------------
    | BODY STYLE 1
    |--------------------------------------------------------------------------
    */

    if (
        performanceEndRow >= performanceStartRow
    ) {

        styleRange(
            worksheet,
            performanceStartRow,
            performanceEndRow,
            0,
            8,
            bodyStyle
        );

        styleRange(
            worksheet,
            performanceStartRow,
            performanceEndRow,
            0,
            0,
            centerStyle
        );

        styleRange(
            worksheet,
            performanceStartRow,
            performanceEndRow,
            2,
            8,
            centerStyle
        );
    }


    /*
    |--------------------------------------------------------------------------
    | TITLE STYLE 2
    |--------------------------------------------------------------------------
    */

    styleRange(
        worksheet,
        defectTitleRow,
        defectTitleRow,
        0,
        8,
        titleStyle
    );


    /*
    |--------------------------------------------------------------------------
    | HEADER STYLE 2
    |--------------------------------------------------------------------------
    */

    styleRange(
        worksheet,
        defectHeaderRow,
        defectHeaderRow,
        0,
        6,
        headerStyle
    );


    /*
    |--------------------------------------------------------------------------
    | BODY STYLE 2
    |--------------------------------------------------------------------------
    */

    if (
        defectEndRow >= defectStartRow
    ) {

        styleRange(
            worksheet,
            defectStartRow,
            defectEndRow,
            0,
            6,
            bodyStyle
        );

        styleRange(
            worksheet,
            defectStartRow,
            defectEndRow,
            0,
            0,
            centerStyle
        );

        styleRange(
            worksheet,
            defectStartRow,
            defectEndRow,
            2,
            3,
            centerStyle
        );

        styleRange(
            worksheet,
            defectStartRow,
            defectEndRow,
            5,
            6,
            centerStyle
        );
    }


    /*
    |--------------------------------------------------------------------------
    | ROW HEIGHT
    |--------------------------------------------------------------------------
    */

    worksheet['!rows'] = [];

    worksheet['!rows'][performanceTitleRow] = {
        hpt: 25
    };

    worksheet['!rows'][performanceHeaderRow] = {
        hpt: 35
    };

    worksheet['!rows'][defectTitleRow] = {
        hpt: 25
    };

    worksheet['!rows'][defectHeaderRow] = {
        hpt: 35
    };


    /*
    |--------------------------------------------------------------------------
    | FREEZE
    |--------------------------------------------------------------------------
    */

    worksheet['!freeze'] = {
        xSplit: 0,
        ySplit: performanceHeaderRow + 1
    };


    /*
    |--------------------------------------------------------------------------
    | ADD SHEET
    |--------------------------------------------------------------------------
    */

    XLSX.utils.book_append_sheet(
        workbook,
        worksheet,
        'Weekly Report'
    );


    /*
    |--------------------------------------------------------------------------
    | FILE NAME
    |--------------------------------------------------------------------------
    */

    let selectedWeek =
        $('#selectWeek option:selected').text();


    if (!selectedWeek) {
        selectedWeek = 'Weekly Performance';
    }


    selectedWeek =
        selectedWeek
            .replace(/[\\/:*?"<>|]/g, '-')
            .trim();


    const fileName =
        'Weekly_Endline_Performance_' +
        selectedWeek +
        '.xlsx';


    /*
    |--------------------------------------------------------------------------
    | DOWNLOAD
    |--------------------------------------------------------------------------
    */

    XLSX.writeFile(
        workbook,
        fileName
    );

    console.log(
        'Export berhasil:',
        fileName
    );
}





    /*
    |--------------------------------------------------------------------------
    | SELECT WEEK
    |--------------------------------------------------------------------------
    */
    $('#selectWeek').select2({

        placeholder: 'Select Week',

        width: '100%',

        ajax: {

            url: "{{ route('monitoring_endlineperformance_selectweek') }}",

            type: "GET",

            dataType: "json",

            delay: 500,

            data: function (params) {

                return {
                    q: params.term,
                    page: params.page || 1
                };
            },

            processResults: function (data) {

                return {

                    results: data.results,

                    pagination: data.pagination
                };
            },

            cache: true
        }
    });


    /*
    |--------------------------------------------------------------------------
    | CURRENT WEEK
    |--------------------------------------------------------------------------
    */
    $.get(
        "{{ route('monitoring_endlineperformance_currentweek') }}"
    )

    .done(function (res) {

        if (
            !res ||
            !res.selected ||
            !res.selected.id
        ) {

            console.error(
                'Current week tidak ditemukan.',
                res
            );

            return;
        }


        const option =
            new Option(
                res.selected.text,
                res.selected.id,
                true,
                true
            );


        $('#selectWeek')
            .append(option)
            .trigger('change');
    })

    .fail(function (xhr) {

        console.error(
            'Gagal mengambil current week.',
            xhr
        );
    });


    /*
    |--------------------------------------------------------------------------
    | WEEK CHANGED
    |--------------------------------------------------------------------------
    */
    $('#selectWeek').on(
        'change',
        function () {

            const weekId =
                $(this).val();


            if (!weekId) {
                return;
            }


            isTableLoading = true;


            /*
            |--------------------------------------------------------------------------
            | Destroy old DataTable
            |--------------------------------------------------------------------------
            */
            destroyPerformanceDataTable();


            /*
            |--------------------------------------------------------------------------
            | Week Number
            |--------------------------------------------------------------------------
            */
            const weekParts =
                weekId.split('-');


            const week =
                weekParts[1];


            /*
            |--------------------------------------------------------------------------
            | Event
            |--------------------------------------------------------------------------
            */
            $(document).trigger(
                'week:changed',
                {
                    week_id: weekId
                }
            );


            /*
            |--------------------------------------------------------------------------
            | Header
            |--------------------------------------------------------------------------
            */
            $('.subheader').text(
                'TOP 5 DEFECT DETAIL (WEEK ' +
                week +
                ')'
            );


            /*
            |--------------------------------------------------------------------------
            | Load Data
            |--------------------------------------------------------------------------
            */
            $.get(
                "{{ route('monitoring_endlineperformance_data') }}",
                {
                    week_id: weekId
                }
            )

            .done(function (html) {

                const $res =
                    $(html);


                /*
                |--------------------------------------------------------------------------
                | Performance
                |--------------------------------------------------------------------------
                */
                const performanceBody =
                    $res.find(
                        '#tableInlinePerformanceBody'
                    );


                if (performanceBody.length) {

                    $('#tableInlinePerformanceBody')
                        .html(
                            performanceBody.html()
                        );
                }


                /*
                |--------------------------------------------------------------------------
                | Defect
                |--------------------------------------------------------------------------
                */
                const defectBody =
                    $res.find(
                        '#tableInlineDefectBody'
                    );


                if (defectBody.length) {

                    $('#tableInlineDefectBody')
                        .html(
                            defectBody.html()
                        );
                }


                /*
                |--------------------------------------------------------------------------
                | Defect Footer
                |--------------------------------------------------------------------------
                */
                const defectFoot =
                    $res.find(
                        '#tableInlineDefectFoot'
                    );


                if (defectFoot.length) {

                    $('#tableInlineDefectFoot')
                        .html(
                            defectFoot.html()
                        );
                }


                /*
                |--------------------------------------------------------------------------
                | Reinitialize DataTable
                |--------------------------------------------------------------------------
                */
                initPerformanceDataTable();


                isTableLoading = false;
            })

            .fail(function (xhr) {

                console.error(
                    'Gagal mengambil data.',
                    xhr
                );

                isTableLoading = false;
            });
        }
    );


    /*
    |--------------------------------------------------------------------------
    | EXPORT BUTTON
    |--------------------------------------------------------------------------
    */
    $('#export-datatable-btn')
    .off('click.exportExcel')
    .on('click.exportExcel', function (e) {

        e.preventDefault();
        e.stopPropagation();

        console.log('EXPORT BUTTON CLICKED');

        if (isTableLoading) {

            console.warn(
                'Data masih loading, export dibatalkan.'
            );

            return;
        }

        exportExcel();
    });



});
</script>

@include('layouts.loading')

@endpush


