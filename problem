        }

        preconnect(session('db'));

        $data = $this->getFilterData($request);

        $lineLabel = (empty($data['line']) || $data['line'] === 'all')
            ? 'All Lines'
            : $data['line'];

        $groupBuyerName = 'All Buyers';
