// Process dan Non Process
// 1. Ambil data defect yang ada pada rentang minggu yang dipilih
// 2. Cek apakah defect itu termasuk kategori 1 (Process) atau 0 (Non Process)
//    dari masterqcdefect (kolom `category`)

$defectCodesInRange = (clone $headerQuery)
    ->whereNotNull('defect_code')
    ->pluck('defect_code')
    ->unique()
    ->values();

// Ambil peta kdcacat => category dari master, sekali query saja
$categoryMap = QCDefect::whereIn('kdcacat', $defectCodesInRange)
    ->pluck('category', 'kdcacat');

$processDefectCodes = $defectCodesInRange
    ->filter(fn ($code) => (int) ($categoryMap[$code] ?? 0) === 1)
    ->values();

$nonProcessDefectCodes = $defectCodesInRange
    ->filter(fn ($code) => (int) ($categoryMap[$code] ?? 0) === 0)
    ->values();

$processQty = $processDefectCodes->isEmpty()
    ? 0
    : (clone $headerQuery)->whereIn('defect_code', $processDefectCodes)->count();

$nonProcessQty = $nonProcessDefectCodes->isEmpty()
    ? 0
    : (clone $headerQuery)->whereIn('defect_code', $nonProcessDefectCodes)->count();

$processPercent = $totDefect > 0
    ? round(($processQty / $totDefect) * 100, 2)
    : 0;

$nonProcessPercent = $totDefect > 0
    ? round(($nonProcessQty / $totDefect) * 100, 2)
    : 0;

// Flag ringkas: true kalau ada minimal 1 defect kategori Process
$process = $processQty > 0;


return view('monitoring::endlineperformance.performance.partials.weekly', [
    'header'             => $header,
    'rft_qty'            => $rft_qty,
    'inspect_qty'        => $totInspect,
    'defect_qty'         => $totDefect,
    'rft'                => $rft,
    'wft'                => $wft,
    'top_defect'         => $topDefect,
    'totTopDefect'       => $totTopDefect,
    'process'            => $process,
    'process_qty'        => $processQty,
    'non_process_qty'    => $nonProcessQty,
    'process_percent'    => $processPercent,
    'non_process_percent'=> $nonProcessPercent,
]);