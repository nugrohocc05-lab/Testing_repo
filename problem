<template>
  <div class="flex justify-center items-center h-screen">
    <p>Checking token...</p>
  </div>
</template>

<script setup>
import { onMounted } from "vue";
import { useRoute, useRouter } from "vue-router";
import api from "@/services/api";
import { useAuthStore } from "@/stores/auth";

const route = useRoute();
const router = useRouter();

const auth = useAuthStore();

const API_URL = import.meta.env.VITE_API_URL;

const startExpireTimer = () => {
  setTimeout(() => {
    console.log("Token expired");

    // hapus localStorage
    localStorage.removeItem("access_token");
    localStorage.removeItem("factory");

    // hapus pinia
    auth.token = null;

    // keluar otomatis
    router.replace({
      name: "login",
    });
  }, EXPIRE_TIME);
};

const EXPIRE_TIME = 1 * 60 * 1000;

const setExpireStorage = (key, value) => {
  const data = {
    value: value,
    expireAt: Date.now() + EXPIRE_TIME,
  };

  localStorage.setItem(key, JSON.stringify(data));
};

const getExpireStorage = (key) => {
  const item = localStorage.getItem(key);

  if (!item) {
    return null;
  }

  try {
    const data = JSON.parse(item);

    if (Date.now() > data.expireAt) {
      localStorage.removeItem(key);
      return null;
    }

    return data.value;
  } catch (error) {
    localStorage.removeItem(key);
    return null;
  }
};

// claim token
const claim = async () => {
  try {
    const menu = route.params.menu;
    const token = route.params.token;

    const { data } = await api.get(`${API_URL}api/token/v1/claim`, {
      params: {
        token,
      },
    });

    console.log("Claim response:", data);

    auth.token = data.access_token;

    setExpireStorage("access_token", data.access_token);

    setExpireStorage("factory", data.factory_id);

    // mulai hitung expire
    startExpireTimer();

    console.log("Token:", getExpireStorage("access_token"));

    if (menu === "humidity") {
      router.replace({
        name: "humidity-token",
      });
    }
  } catch (error) {
    console.error("Claim error:", error);

    alert("Token tidak valid");
  }
};

onMounted(() => {
  claim();
});
</script>
