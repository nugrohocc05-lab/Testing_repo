@section('extrascript')
<script type="text/javascript">
    $(document).ready(function(){

    $('#groupbuyer_container').show();
    $('#season_container').show();
    $('#po_container').hide();

    $('#filter').val('').trigger('change');

   $('#filter').on('change', function(){
    var selectedValue = $(this).val();
    console.log("Value yang dipilih:", selectedValue);

    if(selectedValue === 'groupbuyer_filter') {

        $('#groupbuyer_container').show();
        $('#season_container').show();
        $('#po_container').hide();

    } else if(selectedValue === 'po_filter') {

        $('#groupbuyer_container').show();
        $('#season_container').show();
        $('#po_container').show();

    } else {

        $('#groupbuyer_container').show();
        $('#season_container').show();
        $('#po_container').hide();
    }
});




    // Group Buyer
    $('#group_buyer').select2({
    placeholder: 'Select Group Buyer',
    ajax: {
        url: '{{ route("reportgoodissuelab.listgroupbuyer") }}',
        type: 'GET',
        dataType: 'json',
        delay: 250,
        data: function (params) {
            return {
                term: params.term
            };
        },

        processResults: function(data) {
            return {
                results: $.map(data, function(item) {
                    return {
                        id: item.id,
                        text: item.group_name
                        }
                    })
                };
            }
        }
    });

    // Onchange Group Buyer
    $('#group_buyer').on('change', function () {
        let buyerId = $(this).val();

        $('#season').val(null).trigger('change');
    });

    // Filter Season
   $('#season').select2({
        placeholder: 'Select Season',
        ajax: {
            url: '{{ route("reportgoodissuelab.listseason") }}',
            type: 'GET',
            dataType: 'json',

            data: function (params) {
                return {
                    idbuyer: $('#group_buyer').val(),
                    search: params.term || ''
                };
            },

            processResults: function (data) {
                return {
                    results: $.map(data, function (item) {
                        return {
                            id: item.season,
                            text: item.season
                        };
                    })
                };
            }
        },
    });

    // Data Table
    let table = $('#datalist').DataTable({
        processing: true,
        serverSide: true,
        deferLoading: 0,
        ajax: {
            url: '{{ route("reportgoodissuelab.datatable") }}',
            data: function (d) {
                d.group_buyer = $('#group_buyer').val();
                d.season = $('#season').val();
            }
        },
        columns: [
            { data: 'no' },
            { data: 'cartoncode' },
            { data: 'buyer' },
            { data: 'season' },
            { data: 'style' },
            { data: 'sub_style' },
            { data: 'po' },
            { data: 'qty' },
            { data: 'date' },
            { data: 'user' },
            { data: 'detail' }
        ]
    });

    // Button Find
    $('#findbtn').on('click', function () {
        table.ajax.reload();
    });

    // Button Reset
    $('#resetbtn').on('click', function () {
        $('#group_buyer').val(null).trigger('change');
        $('#season').val(null).trigger('change');

        table.ajax.reload();
    });

	});
</script>
