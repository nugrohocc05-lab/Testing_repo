function priorityFinal(Request $request)
{
    preconnect(session('db'));

    $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
    $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

    $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
    $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

    $fi  = (new OutputDetailFinalInspection())->getTable();
    $od  = (new OutputDetail())->getTable();
    $po  = (new PurchaseOrder())->getTable();
    $dbr = (new HistoryDataBreakdown())->getTable();

    $applyCommonFilters = function ($query) use ($request, $po, $dbr) {
        if ($request->filled('groupbuyer') && $request->groupbuyer !== 'all') {
            $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');
            $query->whereIn("$po.idbuyer", $buyerIds);
        }
        if ($request->filled('po') && $request->po !== 'all') {
            $query->where("$dbr.idpo", $request->po);
        }
        if ($request->filled('style') && $request->style !== 'all') {
            $query->where("$po.idstyle", $request->style);
        }
        return $query;
    };

    // Idpo efektif untuk pengecekan final: kalau PO ini hasil revisi (revisi_kp=1 + kp_item_ref terisi),
    // cek ke PO pendahulunya (combine_pro sama, idpo lebih kecil, terdekat).
    // Kalau bukan revisi, cek dirinya sendiri saja.
    $effectiveIdpoSql = function () use ($dbr) {
        return "(CASE WHEN $dbr.revisi_kp = 1 AND $dbr.kp_item_ref IS NOT NULL
            THEN (SELECT dbr_prev.idpo FROM $dbr as dbr_prev
                  WHERE dbr_prev.combine_pro = $dbr.combine_pro
                    AND dbr_prev.idpo < $dbr.idpo
                  ORDER BY dbr_prev.idpo DESC LIMIT 1)
            ELSE $dbr.idpo END)";
    };

    $requireHasFinalRecord = function ($query) use ($fi, $od, $effectiveIdpoSql) {
        $expr = $effectiveIdpoSql();
        $query->whereExists(function ($q) use ($fi, $od, $expr) {
            $q->select(DB::raw(1))
                ->from("$fi as fi3")
                ->join("$od as od3", "od3.barcode", '=', 'fi3.barcode')
                ->whereRaw("od3.idpo = $expr");
        });
        return $query;
    };

    $excludeIfAnyFinal = function ($query) use ($fi, $od, $effectiveIdpoSql) {
        $expr = $effectiveIdpoSql();
        $query->whereNotExists(function ($q) use ($fi, $od, $expr) {
            $q->select(DB::raw(1))
                ->from("$fi as fi2")
                ->join("$od as od2", "od2.barcode", '=', 'fi2.barcode')
                ->whereRaw("od2.idpo = $expr")
                ->where('fi2.is_output', 1);
        });
        return $query;
    };

    $listQuery = HistoryDataBreakdown::query()
        ->join($po, "$po.idpo", '=', "$dbr.idpo")
        ->whereBetween("$dbr.deliverydate", [$dta, $dtb])
        ->where("$dbr.production_status", "IH")
        // Exclude PO lama yang sudah digantikan revisi kartu produksi
        ->whereNotExists(function ($q) use ($dbr) {
            $q->from("$dbr as dbr2")
                ->whereColumn("dbr2.combine_pro", "$dbr.combine_pro")
                ->where("dbr2.revisi_kp", 1)
                ->whereNotNull("dbr2.kp_item_ref")
                ->whereColumn("dbr2.idpo", ">", "$dbr.idpo");
        });

    $requireHasFinalRecord($listQuery);
    $excludeIfAnyFinal($listQuery);
    $applyCommonFilters($listQuery);

    $poList = $listQuery
        ->select("$dbr.idpo", "$po.po", "$po.idbuyer", "$po.idstyle")
        ->distinct()
        ->get();

    $buyerIds = $poList->pluck('idbuyer')->filter()->unique()->values();
    $buyerGroupMap = Buyer::whereIn('idbuyer', $buyerIds)->pluck('groupbuyer', 'idbuyer');
    $groupBuyerIds = $buyerGroupMap->filter()->unique()->values();
    $groupBuyerNames = MasterGroupBuyer::whereIn('id', $groupBuyerIds)->pluck('group_name', 'id');
    $styleIds = $poList->pluck('idstyle')->filter()->unique()->values();
    $styleMap = Style::whereIn('idstyle', $styleIds)->pluck('nmstyle', 'idstyle');

    $data = $poList->map(function ($item) use ($buyerGroupMap, $groupBuyerNames, $styleMap) {
        $groupBuyerId = $buyerGroupMap->get($item->idbuyer);
        return [
            'idpo'  => $item->idpo,
            'po'    => $item->po,
            'style' => $styleMap->get($item->idstyle) ?? '-',
            'buyer' => $groupBuyerId ? ($groupBuyerNames->get($groupBuyerId) ?? '-') : '-',
        ];
    })->values();

    return response()->json(['data' => $data]);
}