<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://unpkg.com/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/js/select2.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="{{ asset('/js/flatpickr.min.js') }}"></script>
<script src="{{ asset('js/flatpickr_language_id.js') }}"></script>
<script src="{{ _asset('js/sweetalert.min.js') }}"></script>


<script>
$(function(){
    $(document).ready(function() {
        // Time Tracking
        function updateClock(){
            let now = new Date();
            let day = String(now.getDate()).padStart(2,'0');
            let month = [
                "January","February","March","April","May","June",
                "July","August","September","October","November","December"
            ];
            let year = now.getFullYear();
            let hour = String(now.getHours()).padStart(2,'0');
            let minute = String(now.getMinutes()).padStart(2,'0');
            let second = String(now.getSeconds()).padStart(2,'0');

            document.getElementById('liveClock').innerHTML =
                `${day} ${month[now.getMonth()]} ${year} - ${hour} : ${minute} : ${second}`;
        }
        updateClock();
        setInterval(updateClock,1000);

        // let today = new Date().toISOString().split('T')[0];

        // console.log(today);

        // $('#datea').val(today);
        // $('#dateb').val(today);
        // $('#datedatatables').val(today);

        flatpickr("#datea", {
            dateFormat: "d-m-Y",
            altInput: true,
            altFormat: "d F Y",
            allowInput: true,
            monthSelectorType: "static",
            disableMobile: true,
            defaultDate: "today"
        });

        flatpickr("#dateb", {
            dateFormat: "d-m-Y",
            altInput: true,
            altFormat: "d F Y",
            allowInput: true,
            monthSelectorType: "static",
            disableMobile: true,
            defaultDate: "today"

        });

        flatpickr("#datedatatables", {
            dateFormat: "d-m-Y",
            altInput: true,
            altFormat: "d F Y",
            allowInput: true,
            monthSelectorType: "static",
            disableMobile: true,
            defaultDate: "today"
        });

        $('#line').select2({
            placeholder: 'Select Line',
            width: '100%',
            ajax: {
                url: "{{ route('monitoring_inlineperformanceselectline') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function(params){
                    return{
                        q: params.term,
                        page: params.page || 1
                    }
                },
                processResults:function(data){
                    if(data.current_page == 1){
                        data.data.unshift({ kodegroup:'all' });
                    }
                    return{
                        results: $.map(data.data,function(item){
                            if(item.kodegroup == 'all'){
                                return{ id:'all', text:'All Lines' }
                            }
                            return{
                                id:item.kodegroup,
                                text:item.namabagian + ' - ' + item.namagroup
                            }
                        }),
                        pagination:{
                            more:data.to < data.total
                        }
                    }
                },
                cache:true
            }
        });

        $('#groupbuyer').select2({
            placeholder: 'Select Buyer',
            width: '100%',
            ajax: {
                url: "{{ route('monitoring_inlineperformancegroupbuyer') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function(params){
                    return {
                        q: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function(data){
                    return { results: data.results };
                },
                cache: true
            }
        });

        // Load Cards (QTY Inspect, Defect, RFT, WFT)
        let currentFilter = {
            line: 'all',
            datea: $('#datea').val(),
            dateb: $('#dateb').val(),
            groupbuyer: 'all'
        };

        function loadCards(filter) {
            $.ajax({
                url: "{{ route('monitoring_inlineperformancefilterdata') }}",
                type: "GET",
                data: filter,
                success: function (response) {
                    $('#cardQtyInspect').text(response.tot_inspect ?? '-');
                    $('#cardQtyDefect').text(response.tot_defect ?? '-');
                    $('#cardRft').text(response.rft ?? '-');
                    $('#cardWft').text(response.wft ?? '-');

                    // TOP DEFECT
                    let html = '';

                    if (response.top_defect && response.top_defect.length > 0) {

                        response.top_defect.forEach(function(item) {
                            html += `
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center">
                                        <div style="
                                            width:15px;
                                            height:15px;
                                            background:${item.color};
                                        "></div>

                                        <span class="ms-2 text-white small">
                                            ${item.total} ${item.nmdefect}
                                        </span>
                                    </div>
                                </div>
                            `;
                        });

                    } else {
                        html = `
                            <div class="text-white small text-center">

                            </div>
                        `;
                    }

                    $('#topDefectList').html(html);


                    // logic warna defect
                    const card = $('#cardQtyDefect').closest('.stat-card');

                    if (Number(response.tot_defect) === 0) {
                        card.removeClass('color-box-red')
                            .addClass('color-box-green');
                    } else {
                        card.removeClass('color-box-green')
                            .addClass('color-box-red');
                    }

                    // Logic warna target
                    const target = $('#targetColor');

                    if(response.target === true) {
                        target.removeClass('color-box-red').addClass('color-box-green')
                    } else {
                        target.removeClass('color-box-green').addClass('color-box-red')
                    }
                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                }
            });
        }

        $('#findbtn').on('click', function(e){
            e.preventDefault();

            currentFilter = {
                line: $('#line').val() || 'all',
                datea: $('#datea').val(),
                dateb: $('#dateb').val(),
                groupbuyer: $('#groupbuyer').val() || 'all'
            };

            loadCards(currentFilter);
        });

        loadCards(currentFilter);

        // Datatables
        var table = $('#tableInlinePerformance').DataTable({
            processing: true,
            serverSide: false,
            paging: false,
            ajax: {
                url: "{{ route('monitoring_inlineperformancedatatables') }}",
                type: "GET",
                data: function(d){
                    d.date = $('#datedatatables').val();
                },
                dataSrc: function(json){
                    let totalRft = 0, totalInspect = 0, totalDefect = 0;
                    json.data.forEach(function (row) {
                        totalRft += Number(row.qty_rft) || 0;
                        totalInspect += Number(row.qty_inspect) || 0;
                        totalDefect += Number(row.qty_defect) || 0;
                    });
                    $('#footQtyRft').text(totalRft);
                    $('#footQtyInspect').text(totalInspect);
                    $('#footQtyDefect').text(totalDefect);

                    return json.data;
                }
            },
            columns: [
                { data: 'line', className: 'text-center fw-normal', orderable: false },
                {
                    data: 'style',
                    className: 'text-center fw-normal',
                    render: function (data) {
                        if (!data) return '-';

                        return Object.values(data).join(', ');
                    },
                    orderable: false
                },
                { data: 'qty_rft', className: 'text-center fw-normal', orderable: false },
                { data: 'qty_inspect', className: 'text-center fw-normal', orderable: false },
                { data: 'qty_defect', className: 'text-center fw-normal', orderable: false },
                { data: 'rft', className: 'text-center fw-normal', orderable: false },
                { data: 'wft', className: 'text-center fw-normal', orderable: false },
                { data: 'last_status', className: 'text-center fw-normal', orderable: false }
            ],
            dom:'',
            order:[]
        });

        // Search box tabel
        $('#searchLine, #find').on('keyup click', function(e){
            if (e.type === 'click' || e.key === 'Enter' || e.type === 'keyup') {
                table.search($('#searchLine').val()).draw();
            }
        });

        $('#datedatatables').on('change', function () {
            table.ajax.reload();
        });

    })
});
</script>

</body>
</html>
