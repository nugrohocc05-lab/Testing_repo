    public function exportExcel(Request $request)
    {
        $data = $this->getFilterData($request);

        header("Content-Type: application/vnd.ms-excel");
        header("Content-Disposition: attachment; filename=Report_Inline_Dashboard.xls");


        echo '
        <table border="1">
            <tr>
                <td colspan="6" style="font-weight:bold;font-size:16px;text-align:center">
                    REPORT INLINE DASHBOARD
                </td>
            </tr>

            <tr>
                <td colspan="6">
                    '.$data['periode']['from'].' s/d '.$data['periode']['to'].'
                </td>
            </tr>

            <tr>
                <th>Line</th>
                <th>Group Buyer</th>
                <th>Total Inspect</th>
                <th>Total Defect</th>
                <th>RFT</th>
                <th>Status</th>
            </tr>

            <tr>
                <td>'.$data['line'].'</td>
                <td>'.$data['group_buyer'].'</td>
                <td>'.$data['tot_inspect'].'</td>
                <td>'.$data['tot_defect'].'</td>
                <td>'.$data['rft'].'%</td>
                <td>'.$data['target'].'</td>
            </tr>
        </table>
        ';

        exit;
    }

