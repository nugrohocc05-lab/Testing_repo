            ajax: {
                url: "{{ route('monitoring_inlineperformanceselectline') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function(params){
                    return{
                        q: params.term,
                        page: params.page || 1
                    }
                },
                processResults:function(data){
                    if(data.current_page == 1){
                        data.data.unshift({ kodegroup:'all' });
                    }
                    return{
                        results: $.map(data.data,function(item){
                            if(item.kodegroup == 'all'){
                                return{ id:'all', text:'All Lines' }
                            }
                            return{
                                id:item.kodegroup,
                                text:item.namabagian + ' - ' + item.namagroup
                            }
                        }),
                        pagination:{ more:data.to < data.total }
                    }
                },
                cache:true
            }
        });

        $('#groupbuyer').select2({
            placeholder: 'Select Buyer',
            width: '60%',
            ajax: {
                url: "{{ route('monitoring_inlineperformancegroupbuyer') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function(params){
                    return {
                        q: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function(data){
                    return { results: data.results };
                },
                cache: true
            }
        });

        // ==========================================
        // INISIALISASI DATATABLES DENGAN DUMMY AJAX
        // ==========================================
        let dataTable = $('#performanceTable').DataTable({
            processing: true,
            serverSide: false, // Set false dulu karena pakai dummy client-side
            ajax: function (data, callback, settings) {
                // Simulasi loading dari server menggunakan setTimeout
                setTimeout(function() {
                    callback({
                        data: [
                            { no: 1, line_name: "Line A - Sewing", group_buyer: "Nike", qty_inspect: 312, qty_defect: 12, rft: 96, wft: 4, status: "Good" },
                            { no: 2, line_name: "Line B - Assembling", group_buyer: "Adidas", qty_inspect: 250, qty_defect: 25, rft: 90, wft: 10, status: "Warning" },
                            { no: 3, line_name: "Line C - Packing", group_buyer: "Puma", qty_inspect: 400, qty_defect: 4, rft: 99, wft: 1, status: "Excellent" },
                            { no: 4, line_name: "Line D - Sewing", group_buyer: "Nike", qty_inspect: 150, qty_defect: 30, rft: 80, wft: 20, status: "Critical" },
                            { no: 5, line_name: "Line E - Cutting", group_buyer: "Reebok", qty_inspect: 500, qty_defect: 10, rft: 98, wft: 2, status: "Excellent" }
                        ]
                    });
                }, 800); // delay 800ms
            },
            columns: [
                { data: 'no', className: 'text-center' },
                { data: 'line_name' },
                { data: 'group_buyer' },
                { data: 'qty_inspect', className: 'text-end' },
                { data: 'qty_defect', className: 'text-end' },
                { 
                    data: 'rft', 
                    className: 'text-end',
                    render: function(data, type, row) {
                        return `<span class="${data >= 95 ? 'text-success' : 'text-warning'}">${data}%</span>`;
                    }
                },
                { 
                    data: 'wft', 
                    className: 'text-end',
                    render: function(data, type, row) {
                        return `<span class="${data <= 5 ? 'text-info' : 'text-danger'}">${data}%</span>`;
                    }
                },
                {
                    data: 'status',
                    className: 'text-center',
                    render: function(data, type, row) {
                        let badgeClass = "bg-secondary";
                        if(data === "Excellent" || data === "Good") badgeClass = "bg-success";
                        if(data === "Warning") badgeClass = "bg-warning text-dark";
                        if(data === "Critical") badgeClass = "bg-danger";
                        return `<span class="badge ${badgeClass}">${data}</span>`;
                    }
                }
            ],
            language: {
                search: "Search Data:",
                lengthMenu: "Show _MENU_ entries"
            }
        });

