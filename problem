.header-left {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 32px;
}

.header-back {
    position: relative;
    z-index: 2;
    flex: 0 0 auto;
}

.header-clock {
    position: relative;
    z-index: 2;
    flex: 0 0 auto;
    text-align: right;
    white-space: nowrap;
    font-size: 20px;
    font-weight: 700;
}

/* Title diposisikan absolute supaya benar-benar center
   terhadap container, tidak terpengaruh lebar tombol back
   atau jam di kiri-kanannya */
.header-title {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 70%;
    max-width: 70%;
    text-align: center;
    z-index: 1;
    pointer-events: none;
}