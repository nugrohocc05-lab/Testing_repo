    function buildInlineLtsData($line, $date = null)
    {
        $date = $date ? Carbon::parse($date) : Carbon::now();
        $dta = $date->copy()->startOfDay();
        $dtb = $date->copy()->endOfDay();

        $headers = InlineHeader::whereBetween('date', [$dta, $dtb])
            ->where('group_id', $line)
            ->get(['id', 'round', 'sequence_process', 'userid_operator']);

        $headerIds = $headers->pluck('id');
        $headerCount = $headerIds->count();

        $totInspect = $headerCount * 5;
        $totDefect = InlineDetail::whereIn('inline_header_id', $headerIds)->count();

        $rft = $totInspect > 0 ? (($totInspect - $totDefect) / $totInspect) * 100 : 0;
        $wft = $totInspect > 0 ? ($totDefect / $totInspect) * 100 : 0;

        $detailsByHeader = InlineDetail::whereIn('inline_header_id', $headerIds)
            ->get(['inline_header_id', 'problem', 'action', 'rootcause'])
            ->groupBy('inline_header_id');

        $operatorsMeta = $headers
            ->groupBy('userid_operator')
            ->map(fn($rows) => $rows->sortBy('round')->first())
            ->sortBy('sequence_process')
            ->values();

        $niks = $operatorsMeta->pluck('userid_operator')->unique()->values();
        $employeeNames = Employee::whereIn('nik', $niks)->pluck('name', 'nik');

        $operators = $operatorsMeta->map(function ($h) use ($employeeNames) {
            return [
                'nik'              => $h->userid_operator,
                'nama'             => $employeeNames[$h->userid_operator] ?? null,
                'sequence_process' => $h->sequence_process,
            ];
        })->values();

        $headersByOperatorRound = $headers->groupBy(function ($h) {
            return $h->userid_operator . '-' . $h->round;
        });

        $maxRound = 5;
        $rounds = [];
        for ($r = 1; $r <= $maxRound; $r++) {
            $cells = [];
            $roundHasDefect = false;
            $roundHasCap    = false;
            foreach ($operators as $op) {
                $key = $op['nik'] . '-' . $r;
                $headerGroup = $headersByOperatorRound->get($key);

                if (!$headerGroup || $headerGroup->isEmpty()) {
                    $cells[] = ['status' => 'empty'];
                    continue;
                }

                $hIdsThisCell = $headerGroup->pluck('id');
                $details = collect();
                foreach ($hIdsThisCell as $hid) {
                    $details = $details->merge($detailsByHeader->get($hid, collect()));
                }

                $defectCount = $details->count();
                $hasCap = $details->contains(function ($d) {
                    return !empty($d->problem) || !empty($d->action) || !empty($d->rootcause);
                });

                $status = $hasCap
                    ? 'cap'
                    : ($defectCount == 0 ? 'none' : ($defectCount == 1 ? 'one' : 'multi'));

                if ($defectCount > 0) {
                    $roundHasDefect = true;
                }
                if ($hasCap) {
                    $roundHasCap = true;
                }

                $cells[] = ['status' => $status];
            }
            $rounds[] = [
                'round' => $r,
                'cells' => $cells,
                'has_defect' => $roundHasDefect,
                'has_cap'    => $roundHasCap,
            ];
        }

        return [
            'tot_inspect' => $totInspect,
            'tot_defect'  => $totDefect,
            'rft'         => number_format($rft, 2),
            'wft'         => number_format($wft, 2),
            'operators'   => $operators,
            'rounds'      => $rounds,
        ];
    }

