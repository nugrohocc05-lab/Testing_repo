<script>
    $(function () {
        const dateOpt = {
            dateFormat: "d-m-Y",
            altInput: true,
            altFormat: "d F Y",
            allowInput: true,
            monthSelectorType: "static",
            disableMobile: true,
            defaultDate: "today",
            maxDate: "today"
        };
        flatpickr("#datea", dateOpt);
        flatpickr("#dateb", dateOpt);

        $('#line').select2({
            placeholder: 'Select Line',
            width: '100%',
            ajax: {
                url: "{{ route('monitoring_inlineperformanceselectline') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function (params) {
                    return {
                        q: params.term,
                        page: params.page || 1
                    }
                },
                processResults: function (data) {
                    if (data.current_page == 1) {
                        data.data.unshift({ kodegroup: 'all' });
                    }
                    return {
                        results: $.map(data.data, function (item) {
                            if (item.kodegroup == 'all') {
                                return { id: 'all', text: 'All Lines' }
                            }
                            return {
                                id: item.kodegroup,
                                text: item.namabagian + ' - ' + item.namagroup
                            }
                        }),
                        pagination: {
                            more: data.to < data.total
                        }
                    }
                },
                cache: true
            }
        });

        $('#groupbuyer').select2({
            placeholder: 'Select Buyer',
            width: '100%',
            ajax: {
                url: "{{ route('monitoring_inlineperformancegroupbuyer') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function (params) {
                    return {
                        q: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data) {
                    return { results: data.results };
                },
                cache: true
            }
        });

        window.currentFilter = {
            line: 'all',
            datea: $('#datea').val(),
            dateb: $('#dateb').val(),
            groupbuyer: 'all'
        };

        function loadCards(filter) {
            $.ajax({
                url: "{{ route('monitoring_inlineperformancefilterdata') }}",
                type: "GET",
                data: filter,
                beforeSend: function () {
                    $('#loading').show();
                },
                success: function (response) {
                    $('#cardQtyInspect').text(response.tot_inspect ?? '-');
                    $('#cardQtyDefect').text(response.tot_defect ?? '-');
                    $('#cardRft').text(response.rft ?? '-');
                    $('#cardWft').text(response.wft ?? '-');

                    // TOP DEFECT
                    let html = '';

                    if (response.top_defect && response.top_defect.length > 0) {

                        response.top_defect.forEach(function (item) {
                            html += `
                                <div class="d-flex align-items-center mb-2 w-100">
                                    <div style="
                                        width:15px;
                                        height:15px;
                                        background:${item.color};
                                        flex-shrink:0;
                                    "></div>

                                    <span class="text-white small ms-2 flex-grow-1 text-truncate"
                                        style="min-width:0;">
                                        ${item.total} ${item.nmdefect}
                                    </span>

                                    <span class="small ms-2 flex-shrink-0"
                                        style="color:${item.color}">
                                        ${item.percent}%
                                    </span>
                                </div>
                            `;
                        });

                    } else {
                        html = `
                            <div class="text-white small text-center">

                            </div>
                        `;
                    }

                    $('#topDefectList').html(html);
                    updateTopDefectChart(response.top_defect);

                    // logic warna defect
                    const card = $('#cardQtyDefect').closest('.stat-card');
                    const cardText = $('#defectText');

                    if (Number(response.tot_defect) === 0) {
                        card.removeClass('color-box-red')
                            .addClass('color-box-green');
                        cardText.removeClass('text-red')
                            .addClass('text-green');
                    } else {
                        card.removeClass('color-box-green')
                            .addClass('color-box-red');
                        cardText.removeClass('text-green')
                            .addClass('text-red');
                    }

                    // Logic warna target
                    const target = $('#targetColor');
                    const targetText = $('#targetText');

                    if (response.target === true) {
                        target.removeClass('color-box-green').addClass('color-box-red');
                        targetText.removeClass('text-green').addClass('text-red');
                    } else {
                        target.removeClass('color-box-red').addClass('color-box-green');
                        targetText.removeClass('text-red').addClass('text-green');
                    }

                    updateDataTime();

                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                },
                complete: function () {
                    $('#loading').hide();
                }
            });
        }

        $('#export-btn').click(function () {
            let url = "{{ route('monitoring_inlineperformance_exportexcel') }}" +
                "?datea=" + currentFilter.datea +
                "&dateb=" + currentFilter.dateb +
                "&line=" + currentFilter.line +
                "&groupbuyer=" + currentFilter.groupbuyer;

            window.location.href = url;
        });

        $('#findbtn').on('click', function (e) {
            e.preventDefault();

            currentFilter = {
                line: $('#line').val(),
                datea: $('#datea').val(),
                dateb: $('#dateb').val(),
                groupbuyer: $('#groupbuyer').val()
            };

            if (currentFilter.line == null || currentFilter.line == '') {
                swal('Warning!', 'Please select Line first!', 'warning');
                return;
            }

            if (currentFilter.groupbuyer == null || currentFilter.groupbuyer == '') {
                swal('Warning!', 'Please select Group Buyer!', 'warning');
                return;
            }

            if (currentFilter.datea == null || currentFilter.datea == '' ||
                currentFilter.dateb == null || currentFilter.dateb == '') {
                swal('Warning!', 'Please select Periode Date!', 'warning');
                return;
            }

            function parseDMY(str) {
                const [d, m, y] = str.split('-');
                return new Date(`${y}-${m}-${d}`);
            }

            if (parseDMY(currentFilter.datea) > parseDMY(currentFilter.dateb)) {
                swal('Warning!', 'Start date cannot be later than end date!', 'warning');
                return;
            }

            updateDataTime();
            loadCards(currentFilter);
        });
    });
</script>
