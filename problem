<script>
    $(function () {
        const allDefects = ['Open Seam', 'Skip Stitch', 'Dirty', 'Broken Stitch', 'Uneven Stitch', 'Puckering'];
        let selectedDefects = ['Open Seam'];

        const $chips = $('#selectedChips');
        const $dropdown = $('#filterDropdown');
        const $optionsList = $('#filterOptionsList');

        const chartDom = document.getElementById('defectChart');
        const myChart = echarts.init(chartDom);

        const defectColors = {
            'Open Seam': '#1B4FE0',
            'Skip Stitch': '#F4977B',
            'Dirty': '#36B37E',
            'Broken Stitch': '#FFAB00',
            'Uneven Stitch': '#8777D9',
            'Puckering': '#00B8D9'
        };

        // Data
        const dummySource = {
            'Open Seam':      [1.2, 3.5, 2.5, 0.9, 6.4, 2.5],
            'Skip Stitch':    [5.8, 1.8, 7.2, 5.8, 4.7, 7.0],
            'Dirty':          [0.5, 0.6, 0.4, 0.8, 0.6, 0.7],
            'Broken Stitch':  [1.5, 1.2, 1.8, 1.6, 2.1, 1.7],
            'Uneven Stitch':  [0.9, 1.1, 1.0, 0.8, 1.3, 1.0],
            'Puckering':      [0.6, 0.7, 0.5, 0.9, 0.6, 0.8],
        };
        const xAxisLabels = ['20 Mei', '21 Mei', '22 Mei', '23 Mei', '24 Mei', '25 Mei'];

        function buildChartOption() {
            const series = selectedDefects.map(defect => ({
                name: defect,
                type: 'line',
                smooth: false,
                symbol: 'circle',
                symbolSize: 15,
                data: dummySource[defect] || [],
                itemStyle: { color: defectColors[defect] || '#999' },
                lineStyle: { width: 4, color: defectColors[defect] || '#999' }
            }));

            // Sumbu Y 0.00% - 10.00% dengan step 2.5%
            const step = 2.5;
            const yMax = 10;

            return {
                backgroundColor: 'transparent',
                textStyle: { color: '#8A93A6' },
                tooltip: {
                    trigger: 'axis',
                    backgroundColor: '#1B2434',
                    borderColor: '#3A4557',
                    textStyle: { color: '#FFFFFF' },
                    valueFormatter: (val) => `${val}%`
                },
                grid: {
                    left: 55,
                    right: 25,
                    top: 45,
                    bottom: 35,
                    containLabel: false
                },
                xAxis: {
                    type: 'category',
                    boundaryGap: true,
                    data: xAxisLabels,
                    axisLine: { lineStyle: { color: '#3A4557' } },
                    axisTick: { show: false },
                    axisLabel: { color: '#8A93A6', fontSize: 12 },
                    splitLine: { show: false }
                },
                yAxis: {
                    type: 'value',
                    name: 'WFT (%)',
                    nameLocation: 'end',
                    nameGap: 20,
                    nameTextStyle: { color: '#8A93A6', fontSize: 12, align: 'left' },
                    min: 0,
                    max: yMax,
                    interval: step,
                    axisLine: { show: false },
                    axisTick: { show: false },
                    axisLabel: {
                        color: '#8A93A6',
                        fontSize: 12,
                        formatter: (val) => `${val.toFixed(2)}%`
                    },
                    splitLine: { lineStyle: { color: '#2A3446', type: 'solid' } }
                },
                series: series
            };
        }

        function renderChart() {
            myChart.setOption(buildChartOption(), true);
        }

        window.addEventListener('resize', function () {
            myChart.resize();
        });

        if (window.ResizeObserver) {
            const ro = new ResizeObserver(() => {
                myChart.resize();
            });
            ro.observe(chartDom.parentElement);
        }

        function renderChips() {
            $chips.empty();
            selectedDefects.forEach(defect => {
                $chips.append(`
                    <span class="filter-chip" data-defect="${defect}">
                        ${defect}
                        <button type="button" class="chip-remove" data-defect="${defect}">✕</button>
                    </span>
                `);
            });
        }

        // Semua opsi tetap tampil di panel (bukan hilang setelah dipilih),
        // tapi yang sudah aktif diberi state "is-selected" — klik lagi = toggle off
        function renderOptions() {
            $optionsList.empty();

            if (allDefects.length === 0) {
                $optionsList.append('<span class="filter-option-empty">Tidak ada data defect</span>');
                return;
            }

            allDefects.forEach(defect => {
                const isSelected = selectedDefects.includes(defect);
                $optionsList.append(`
                    <span class="filter-option-pill ${isSelected ? 'is-selected' : ''}" data-defect="${defect}">
                        ${defect}
                    </span>
                `);
            });
        }

        function applyFilter() {
            console.log('Filter aktif:', selectedDefects);
            renderChart();
        }

        $('#addFilterBtn').on('click', function (e) {
            e.stopPropagation();
            renderOptions();
            $dropdown.toggleClass('d-none');
        });

        $('#weekly').on('click', function(){
            alert('Ambil data week');
        })
        $('#day').on('click', function(){
            alert('Ambil data hari');
        })

        $optionsList.on('click', '.filter-option-pill', function () {
            const defect = $(this).data('defect');
            if (selectedDefects.includes(defect)) {
                selectedDefects = selectedDefects.filter(d => d !== defect);
            } else {
                selectedDefects.push(defect);
            }
            renderChips();
            renderOptions();
            applyFilter();
        });

        $chips.on('click', '.chip-remove', function () {
            const defect = $(this).data('defect');
            selectedDefects = selectedDefects.filter(d => d !== defect);
            renderChips();
            renderOptions();
            applyFilter();
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('.defect-filter').length) {
                $dropdown.addClass('d-none');
            }
        });

        $('#findbtn').on('click', function () {
            applyFilter();
        });

        renderChips();
        renderOptions();
        renderChart();
    });
</script>
