    public function listGroupBuyer(Request $request)
    {
        if (!$request->ajax()) {
                return;
        }

        preconnect(session('db'));

        $fgreceive = "mesprima1_restore.fgreceivegarment_stocks";
        $dos = "mesprima1_restore.delivery_order_stocks";

        $gbuyer = DB::table($fgreceive . ' as fr')
                ->join($dos . ' as do', function ($join) {
                    $join->on('fr.delivery_order', '=', 'do.delivery_order');
                })
                ->join('mainmes.masterbuyer as mb', 'do.masterbuyer_id', '=', 'mb.idbuyer')
                ->join('mainmes.master_group_buyers as mgb', 'mb.groupbuyer', '=', 'mgb.id')
                ->whereNotNull('fr.date_gi')
                ->select(
                    'mgb.id',
                    'mgb.group_name'
                )
                ->distinct()
                ->orderBy('mgb.group_name')
                ->get();
        return response()->json($gbuyer);
    }

    function listSeason(Request $request)
    {
        $query = DB::table('mesprima1_restore.fgreceivegarment_stocks as fr')
            ->join('mesprima1_restore.delivery_order_stocks as do', 'fr.delivery_order', '=', 'do.delivery_order')
            ->join('mainmes.masterbuyer as mb', 'do.masterbuyer_id', '=', 'mb.idbuyer')
            ->whereNotNull('fr.date_gi');

        if ($request->group_buyer) {
            $query->where('mb.groupbuyer', $request->group_buyer);
        }

        $data = $query
            ->select('do.season')
            ->whereNotNull('do.season')
            ->distinct()
            ->orderBy('do.season')
            ->get();

        return response()->json($data);
    }

    function listPO(Request $request)
    {
        $query = DB::table('mesprima1_restore.fgreceivegarment_stocks as fr')
            ->join('mesprima1_restore.outputdetail as od', 'od.barcode', '=', 'fr.barcode')
            ->join('mesprima1_restore.purchase_order as po', 'po.idpo', '=', 'od.idpo')
            ->whereNotNull('fr.date_gi');

        $data = $query
            ->select('po.po')
            ->distinct()
            ->get();

        return response()->json($data);
    }


    function dataTable(Request $request)
    {
        preconnect(session('db'));

        // Data Detail
        if ($request->has('detail_id') && $request->detail_id != '') {

            $data = DB::table('mesprima1_restore.delivery_order_stocks as do')
                ->join('mesprima1_restore.fgreceivegarment_stocks as fr', 'fr.delivery_order', '=', 'do.delivery_order')
                ->join('mesprima1_restore.outputdetail as od', 'od.barcode', '=', 'fr.barcode')
                ->join('mesprima1_restore.purchase_order as po', 'po.idpo', '=', 'od.idpo')
                ->join('mesprima1_restore.mastercolor as mc', 'do.mastercolor_id', '=', 'mc.idcolor')
                ->join('mesprima1_restore.mastersize as mz', 'do.mastersize_id', '=', 'mz.idsize')
                ->join('mainmes.masterbuyer as mb', 'do.masterbuyer_id', '=', 'mb.idbuyer')
                ->join('mainmes.masterstyle as ms', 'do.masterstyle_id', '=', 'ms.idstyle')
                ->join('mainmes.sub_styles as ss', 'ms.sub_style_id', '=', 'ss.id')

                ->select(
                    DB::raw('ROW_NUMBER() OVER (ORDER BY do.cartoncode) as no'),
                    'fr.barcode',
                    'mb.nmbuyer as buyer',
                    'ms.nmstyle as style',
                    'mc.nmcolor as color',
                    'mz.nmsize as size',
                    'do.season',
                    'do.remark',
                    'ss.name as sub_style',
                    'po.po',
                )
                ->where('do.id', $request->detail_id);

            return DataTables::of($data)->toJson();
        }


        $fg = DB::table('mesprima1_restore.fgreceivegarment_stocks')
            ->select('delivery_order', 'barcode', 'date_out', 'user_id')
            ->whereNotNull('date_gi');

        $od = DB::table('mesprima1_restore.outputdetail as od')
            ->join('mesprima1_restore.purchase_order as po', 'po.idpo', '=', 'od.idpo')
            ->select(
                'od.barcode',
                DB::raw('MAX(po.po) as po')
            )
            ->groupBy('od.barcode');

        $data = DB::table('mesprima1_restore.delivery_order_stocks as do')

            // join fg (barcode)
            ->joinSub($fg, 'fr', function ($join) {
                $join->on('fr.delivery_order', '=', 'do.delivery_order');
            })

            // join outputdetail
            ->joinSub($od, 'od', function ($join) {
                $join->on('od.barcode', '=', 'fr.barcode');
            })

            ->join('mainmes.masterbuyer as mb', 'do.masterbuyer_id', '=', 'mb.idbuyer')
            ->join('mainmes.masterstyle as ms', 'do.masterstyle_id', '=', 'ms.idstyle')
            ->join('mainmes.sub_styles as ss', 'ms.sub_style_id', '=', 'ss.id')

            ->select(
                DB::raw('ROW_NUMBER() OVER (ORDER BY do.cartoncode) as no'),
                'do.id',
                'do.cartoncode',
                'do.season',
                'do.qty',
                'fr.user_id as user',
                'fr.date_out as date',
                'mb.nmbuyer as buyer',
                'ms.nmstyle as style',
                'ss.name as sub_style',
                DB::raw('MAX(od.po) as po')
            )

            ->groupBy(
                'do.cartoncode',
                'do.season',
                'mb.nmbuyer',
                'ms.nmstyle',
                'ss.name'
            );

        if ($request->filter == 'group_buyer') {

                if ($request->group_buyer) {
                    $data->where('mb.groupbuyer', $request->group_buyer);
                }

                if ($request->season) {
                    $data->where('do.season', $request->season);
                }
            }

        if ($request->filter == 'po') {

            if ($request->po) {
                $data->where('po.po', $request->po);
            }
        }

        return DataTables::of($data)->toJson();
    }

     function detail($id)
    {
        $data = DB::table('mesprima1_restore.delivery_order_stocks as do')
            ->where('do.id', $id)
            ->first();

        return view('laboratory::reportgoodissuelab.detail', compact('data', 'id'));
    }


