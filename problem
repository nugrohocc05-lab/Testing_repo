<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Flatpickr Local di Laravel</title>
    
    <!-- 1. Panggil CSS Flatpickr dari folder public lokal -->
    <link rel="stylesheet" href="{{ asset('assets/flatpickr/flatpickr.min.css') }}">
</head>
<body>

    <div style="margin: 50px;">
        <label for="tanggal">Pilih Tanggal:</label>
        <input type="text" id="tanggal" class="datepicker" placeholder="Pilih tanggal...">
    </div>

    <!-- 2. Panggil JS Flatpickr dari folder public lokal -->
    <script src="{{ asset('assets/flatpickr/flatpickr.min.js') }}"></script>
    
    <!-- (Opsional) Panggil file Bahasa Indonesia -->
    <script src="{{ asset('assets/flatpickr/id.js') }}"></script>

    <!-- 3. Inisialisasi Flatpickr -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            flatpickr(".datepicker", {
                locale: "id", // Gunakan Bahasa Indonesia (hapus baris ini jika tidak butuh)
                dateFormat: "Y-m-d", // Format: Tahun-Bulan-Tanggal
                allowInput: true
            });
        });
    </script>

</body>
</html>
