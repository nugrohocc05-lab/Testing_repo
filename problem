    function datatable(Request $request)
    {
        preconnect(session('db'));

        $data = MainDOStock::select(
            "request_id", "created_at", "user_id",
            "remark", "delivery_date", "is_approve", "factory_id"
        )
        ->where('is_lab', 0)
        ->whereNull('date_approve')
        ->groupBy("request_id")
        ->orderBy('id', 'desc');
        if (session('admin') != 'admin') {
            $data = $data
                ->where('factory_id', session('db')->iddb)
                ->where('userid_approve', session('user')->nik);
        }

        if (
            $request->has('datea') and
            $request->datea != null and
            $request->has('dateb') and
            $request->dateb != null
        ) {
            $m_da =
                $request->datea > $request->dateb
                    ? $request->dateb
                    : $request->datea;
            $m_db =
                $request->datea > $request->dateb
                    ? $request->datea
                    : $request->dateb;
            $m_da = Carbon::parse($m_da);
            $m_db = Carbon::parse($m_db);
            $data = $data->whereBetween('delivery_date', [$m_da, $m_db]);
        }

        return DataTables::of($data)
        ->addIndexColumn()
        ->addColumn('factory', function($d){
            return MasterFactory::find($d->factory_id)->name ?? '';
        })
