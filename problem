    function summaryFilter(Request $request)
    {
        $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
        $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

        $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
        $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

        // Tanggal
        $headerQuery = SewingOutput::whereBetween('date', [$dta, $dtb]);

        // Line
        if ($request->line && $request->line != 'all') {
            $headerQuery = $headerQuery->where('line', $request->line);
        }

        // Group Buyer -> idpo
        if ($request->groupbuyer && $request->groupbuyer != 'all') {
            $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');
            $poIds = PurchaseOrder::whereIn('idbuyer', $buyerIds)->pluck('idpo');
            $outputId = OutputDetail::whereIn('idpo', $poIds)->pluck('barcode');
            $headerQuery = $headerQuery->whereIn('barcode', $outputId)->where('is_qc', 1);
        }

        // Total Output — clone builder langsung, tidak materialize ID lalu whereIn ulang
        $totOutput = (clone $headerQuery)
            ->where('is_output', 1)
            ->count();

        // Qty Inspects
        $totInspect = (clone $headerQuery)
            ->where('is_qc', 1)
            ->count();

        // Qty Defects
        $totDefect = (clone $headerQuery)
            ->whereNotNull('defect_code')
            ->count();

        // RFT
        $rft = $totInspect > 0
            ? round((($totInspect - $totDefect) / $totInspect) * 100, 2)
            : 0;

        // WFT
        $wft = $totInspect > 0
            ? round(($totDefect / $totInspect) * 100, 2)
            : 0;

        // Kondisi warna target
        $target = Param::where('header', 'qc')
            ->where('key', 'rft_endline_target')
            ->value('value');

        $rftTarget = $rft <= $target ? true : false;

        // Top 5 Defect
        $topDefect = (clone $headerQuery)
            ->whereNotNull('defect_code')
            ->whereNotIn('defect_code', [800, 900])
            ->select(
                'defect_code',
                DB::raw('COUNT(*) as total')
            )
            ->groupBy('defect_code')
            ->orderByDesc('total')
            ->orderBy('defect_code', 'asc')
            ->limit(4)
            ->get();

        $defectIds = $topDefect->pluck('defect_code');

        // Master defect untuk Top 4
        $masterQcDefects = QCDefect::whereIn('kdcacat', $defectIds)
            ->pluck('deskripsi', 'kdcacat');

        $colors = [
            '#004FE0',
            '#3DAA25',
            '#F4947E',
            '#F24C4C',
            '#29B1AE',
        ];


        // Mapping Top 4
        $topDefect = $topDefect->values()->map(function ($item, $index) use (
            $masterQcDefects,
            $totDefect,
            $colors
        ) {
            $percent = $totDefect > 0
                ? ($item->total / $totDefect) * 100
                : 0;

            return [
                'defect_id' => $item->defect_code,
                'nmdefect'  => $masterQcDefects[$item->defect_code] ?? '-',
                'total'     => (int) $item->total,
                'percent'   => number_format($percent, 2),
                'color'     => $colors[$index] ?? '#BDBDBD',
            ];
        });

        // Others
        $top4Total = $topDefect->sum('total');

        $othersTotal = $totDefect - $top4Total;

        if ($othersTotal > 0) {
            $othersPercent = $totDefect > 0
                ? ($othersTotal / $totDefect) * 100
                : 0;

            $topDefect->push([
                'defect_id' => 'others',
                'nmdefect'  => 'Others',
                'total'     => (int) $othersTotal,
                'percent'   => number_format($othersPercent, 2),
                'color'     => '#29B1AE',
            ]);
        }

        return response()->json([
            'tot_output'  =>  $totOutput,
            'tot_inspect' => $totInspect,
            'tot_defect'  => $totDefect,
            'rft'         => $rft,
            'wft'         => $wft,
            'rft_target'  => $rftTarget,
            'top_defect'  => $topDefect,
        ]);
    }

    private function buildWeeks($year)
    {
        return Cache::remember("weeks_list_{$year}", now()->addDay(), function () use ($year) {
            $startOfYear = Carbon::createFromDate($year, 1, 1)->startOfDay();
            $endOfYear   = Carbon::createFromDate($year, 12, 31)->endOfDay();

            $weeks = [];
            $weekNumber = 1;
            $current = $startOfYear->copy();

            while ($current->lte($endOfYear)) {
                $weekStart = $current->copy();
                $weekEnd   = $current->copy()->addDays(6);

                if ($weekEnd->gt($endOfYear)) {
                    $weekEnd = $endOfYear->copy();
                }

                $weeks[] = [
                    'id'    => $year . '-' . $weekNumber,
                    'year'  => $year,
                    'week'  => $weekNumber,
                    'start' => $weekStart->format('Y-m-d'),
                    'end'   => $weekEnd->format('Y-m-d'),
                    'text'  => 'Week ' . $weekNumber . ' (' . $weekStart->format('d M') . ' - ' . $weekEnd->format('d M Y') . ')',
                ];

                $weekNumber++;
                $current->addDays(7);
            }

            return $weeks;
        });
    }


    // Deteksi year + week number dari tanggal (default hari ini)
    private function detectCurrentWeek($date = null)
    {
        $date = $date ? Carbon::parse($date) : Carbon::now();
        $year = $date->year;

        $startOfYear = Carbon::createFromDate($year, 1, 1)->startOfDay();
        $dayOfYear   = $startOfYear->diffInDays($date->copy()->startOfDay()) + 1;
        $weekNumber  = (int) ceil($dayOfYear / 7);

        return [
            'id'   => $year . '-' . $weekNumber,
            'year' => $year,
            'week' => $weekNumber,
        ];
    }

    public function selectWeek(Request $request)
    {
        $year   = Carbon::now()->year;
        $search = trim((string) $request->q);

        $weeks = collect($this->buildWeeks($year));

        // Batasi hanya sampai week yang mencakup hari ini
        $currentWeek = $this->detectCurrentWeek();
        $weeks = $weeks->filter(fn ($w) => $w['week'] <= $currentWeek['week'])->values();

        if ($search !== '') {
            $needle = mb_strtolower($search);
            $weeks = $weeks->filter(fn ($w) => str_contains(mb_strtolower($w['text']), $needle))->values();
        }

        $perPage = 20;
        $page    = (int) ($request->page ?? 1);
        $paged   = $weeks->slice(($page - 1) * $perPage, $perPage)->values();

        return response()->json([
            'results'    => $paged->map(fn ($w) => ['id' => $w['id'], 'text' => $w['text']]),
            'pagination' => ['more' => $weeks->count() > $page * $perPage],
        ]);
    }

    public function currentWeek()
    {
        $current = $this->detectCurrentWeek();

        $weeks = collect($this->buildWeeks($current['year']));

        $selectedWeek = $weeks->first(function ($week) use ($current) {
            return $week['week'] === $current['week'];
        });

        return response()->json([
            'selected' => [
                'id'   => $selectedWeek['id'],
                'text' => $selectedWeek['text'],
            ],
        ]);
    }


    /**
     * Hitung top-style untuk beberapa "grup defect code" sekaligus secara BULK.
     * Menggantikan pola lama (getTopStyleForDefect dipanggil per defect code =
     * N+1, tiap panggilan 4 query) dengan hanya ~4 query TETAP total,
     * berapa pun jumlah grup/defect code yang diminta.
     *
     * $headerQuery: query builder dasar (mis. SewingOutput::whereBetween('date', [...]))
     *               — di-clone di dalam, builder aslinya tidak berubah.
     * $groupedDefectCodes: ['groupKey' => [defect_code, ...], ...]
     *   contoh: ['101' => [101], '205' => [205], 'others' => [300, 410, ...]]
     *
     * Return: ['groupKey' => [ ['style'=>.., 'qty'=>.., 'percent'=>..], ... ], ...]
     */
    private function bulkTopStylesByDefectGroup($headerQuery, array $groupedDefectCodes, int $limit = 2): array
    {
        $allCodes = collect($groupedDefectCodes)->flatten()->unique()->values();

        if ($allCodes->isEmpty()) {
            return [];
        }

        // 1 query: ambil defect_code + barcode untuk seluruh grup sekaligus
        $rows = (clone $headerQuery)
            ->whereIn('defect_code', $allCodes)
            ->select('defect_code', 'barcode')
            ->get();

        $rowsByCode = $rows->groupBy('defect_code');

        $barcodesByGroup = [];
        foreach ($groupedDefectCodes as $groupKey => $codes) {
            $barcodesByGroup[$groupKey] = collect($codes)
                ->flatMap(fn ($code) => $rowsByCode->get($code, collect())->pluck('barcode'))
                ->filter()
                ->values();
        }

        $allBarcodes = collect($barcodesByGroup)->flatten()->unique()->values();

        if ($allBarcodes->isEmpty()) {
            return [];
        }

        // 1 query: OutputDetail untuk semua barcode sekaligus
        $outputDetailsByBarcode = OutputDetail::whereIn('barcode', $allBarcodes)
            ->select('barcode', 'idpo')
            ->get()
            ->groupBy('barcode');

        $allIdpo = $outputDetailsByBarcode->flatten()->pluck('idpo')->unique()->values();

        // 1 query: PurchaseOrder -> idstyle
        $poToStyle = PurchaseOrder::whereIn('idpo', $allIdpo)->pluck('idstyle', 'idpo');

        // 1 query: Style -> nama style
        $styleNames = Style::whereIn('idstyle', $poToStyle->values()->unique())
            ->pluck('nmstyle', 'idstyle');

        $result = [];

        foreach ($barcodesByGroup as $groupKey => $barcodes) {
            $grouped = [];

            foreach ($barcodes as $barcode) {
                foreach ($outputDetailsByBarcode->get($barcode, collect()) as $row) {
                    $idstyle = $poToStyle[$row->idpo] ?? null;
                    $nmstyle = $idstyle ? ($styleNames[$idstyle] ?? '-') : '-';
                    $grouped[$nmstyle] = ($grouped[$nmstyle] ?? 0) + 1;
                }
            }

            if (empty($grouped)) {
                $result[$groupKey] = [];
                continue;
            }

            $totalQty = array_sum($grouped);

            arsort($grouped);
            $top = array_slice($grouped, 0, $limit, true);
            $othersQty = $totalQty - array_sum($top);

            $rowsOut = [];
            foreach ($top as $nmstyle => $qty) {
                $rowsOut[] = [
                    'style'   => $nmstyle,
                    'qty'     => $qty,
                    'percent' => $totalQty > 0 ? number_format(($qty / $totalQty) * 100, 2) : '0.00',
                ];
            }

            if ($othersQty > 0) {
                $rowsOut[] = [
                    'style'   => 'Others',
                    'qty'     => $othersQty,
                    'percent' => $totalQty > 0 ? number_format(($othersQty / $totalQty) * 100, 2) : '0.00',
                ];
            }

            $result[$groupKey] = $rowsOut;
        }

        return $result;
    }



    public function getWeeklyData(Request $request)
    {
        preconnect(session('db'));

        $request->validate([
            'week_id' => 'required|string',
        ]);

        [$year, $weekNumber] = explode('-', $request->week_id);
        $weekNumber = (int) $weekNumber;

        if ($weekNumber < 1 || $weekNumber > 53) {
            abort(422, 'Week tidak valid');
        }

        $dta = Carbon::createFromDate($year, 1, 1)
            ->startOfDay()
            ->addDays(($weekNumber - 1) * 7);

        $dtb = $dta->copy()
            ->addDays(6)
            ->endOfDay();

        $endOfYear = Carbon::createFromDate($year, 12, 31)->endOfDay();

        if ($dtb->gt($endOfYear)) {
            $dtb = $endOfYear->copy();
        }

        $headerQuery = SewingOutput::whereBetween('date', [$dta, $dtb]);

        // Clone builder langsung, tidak materialize ID lalu whereIn ulang
        $totInspect = (clone $headerQuery)
            ->where('is_qc', 1)
            ->count();

        $totDefect = (clone $headerQuery)
            ->whereNotNull('defect_code')
            ->count();

        $rft_qty = $totInspect - $totDefect;

        $rft = $totInspect > 0
            ? round((($totInspect - $totDefect) / $totInspect) * 100, 2)
            : 0;

        $wft = $totInspect > 0
            ? round(($totDefect / $totInspect) * 100, 2)
            : 0;

        $header = [
            'week'   => 'Week ' . $weekNumber,
            'period' => 'Week ' . $weekNumber . ' (' . $dta->format('d M') . ' - ' . $dtb->format('d M Y') . ')',
        ];

        $topDefect = (clone $headerQuery)
            ->whereNotNull('defect_code')
            ->whereNotIn('defect_code', [800, 900])
            ->select(
                'defect_code',
                DB::raw('COUNT(*) as total')
            )
            ->groupBy('defect_code')
            ->orderByDesc('total')
            ->orderBy('defect_code', 'asc')
            ->limit(4)
            ->get();

        $defectIds = $topDefect->pluck('defect_code');

        $masterQcDefects = QCDefect::whereIn('kdcacat', $defectIds)
            ->pluck('deskripsi', 'kdcacat');

        $colors = [
            '#004FE0',
            '#3DAA25',
            '#F4947E',
            '#F24C4C',
            '#29B1AE',
        ];

        $totTop4DefectQty = $topDefect->sum('total');

        $othersQty = max(0, $totDefect - $totTop4DefectQty);

        $othersPercent = $totDefect > 0
            ? ($othersQty / $totDefect) * 100
            : 0;

        // Defect code lain di luar top4, digabung jadi grup "others"
        $othersDefectCodes = (clone $headerQuery)
            ->whereNotNull('defect_code')
            ->whereNotIn('defect_code', $defectIds->toArray())
            ->pluck('defect_code')
            ->unique()
            ->values()
            ->toArray();

        // Bangun grup: tiap defect code top4 jadi grup sendiri, plus grup "others"
        $groupedDefectCodes = [];
        foreach ($defectIds as $code) {
            $groupedDefectCodes[(string) $code] = [$code];
        }
        if (!empty($othersDefectCodes)) {
            $groupedDefectCodes['others'] = $othersDefectCodes;
        }

        // BULK: hitung top-style untuk SEMUA grup sekaligus (~4 query tetap,
        // menggantikan N+1 lama yang bisa ~20 query per request)
        $topStylesByGroup = $this->bulkTopStylesByDefectGroup($headerQuery, $groupedDefectCodes);

        // Mapping Top 4 Defect + Top Style tiap defect
        $topDefect = $topDefect->values()->map(function ($item, $index) use (
            $masterQcDefects,
            $totDefect,
            $colors,
            $topStylesByGroup
        ) {
            $percent = $totDefect > 0 ? ($item->total / $totDefect) * 100 : 0;

            return [
                'defect_id'  => $item->defect_code,
                'nmdefect'   => $masterQcDefects[$item->defect_code] ?? '-',
                'defect_qty' => (int) $item->total,
                'percent'    => number_format($percent, 2),
                'color'      => $colors[$index] ?? '#29B1AE',
                'top_style'  => $topStylesByGroup[(string) $item->defect_code] ?? [],
            ];
        });

        $topDefect->push([
            'defect_id'  => 'others',
            'nmdefect'   => 'Others',
            'defect_qty' => (int) $othersQty,
            'percent'    => number_format($othersPercent, 2),
            'color'      => '#29B1AE',
            'top_style'  => $topStylesByGroup['others'] ?? [],
        ]);

        $totTopDefect = $topDefect->sum('defect_qty');

        return view('monitoring::endlineperformance.performance.partials.weekly', [
            'header'       => $header,
            'rft_qty'      => $rft_qty,
            'inspect_qty'  => $totInspect,
            'defect_qty'   => $totDefect,
            'rft'          => $rft,
            'wft'          => $wft,
            'top_defect'   => $topDefect,
            'totTopDefect' => $totTopDefect,
        ]);
    }

    // Helper: hitung range tanggal dari week_id
    private function weekRange($year, int $weekNumber): array
    {
        $dta = Carbon::createFromDate($year, 1, 1)->startOfDay()->addDays(($weekNumber - 1) * 7);
        $dtb = $dta->copy()->addDays(6)->endOfDay();

        $endOfYear = Carbon::createFromDate($year, 12, 31)->endOfDay();
        if ($dtb->gt($endOfYear)) {
            $dtb = $endOfYear->copy();
        }

        return [$dta, $dtb];
    }

    /**
     * Menentukan window waktu + definisi bucket untuk chart defect.
     * PENTING: kedua mode sekarang konsisten pakai kolom `date` (bukan created_at),
     * karena `date` sudah dipastikan DATETIME (simpan tanggal + jam).
     *
     * Return: [Carbon $dta, Carbon $dtb, array $buckets, string $bucketSqlExpr]
     * - $buckets: list ['key' => ..., 'label' => ...]
     * - $bucketSqlExpr: ekspresi SQL RAW untuk menghasilkan bucket_key per row
     */
    private function resolveChartBuckets(string $mode): array
    {
        if ($mode === 'day') {
            $dta = Carbon::now()->startOfDay();
            $dtb = Carbon::now()->endOfDay();

            $buckets = [];
            foreach (range(7, 23) as $h) {
                $buckets[] = ['key' => (string) $h, 'label' => sprintf('%02d:00', $h)];
            }

            $bucketSqlExpr = 'HOUR(date)';
        } else {
            $dta = Carbon::now()->subDays(6)->startOfDay();
            $dtb = Carbon::now()->endOfDay();

            $buckets = [];
            $cursor = $dta->copy();
            while ($cursor->lte($dtb)) {
                $buckets[] = ['key' => $cursor->format('Y-m-d'), 'label' => $cursor->format('d M')];
                $cursor->addDay();
            }

            $bucketSqlExpr = 'DATE(date)';
        }

        return [$dta, $dtb, $buckets, $bucketSqlExpr];
    }

    /**
     * Hitung top style per (bucket, defect_code) secara BULK.
     * Hanya menjalankan 3 query total (OutputDetail, PurchaseOrder, Style)
     * berapa pun jumlah bucket & defect code yang diminta — menggantikan
     * pola lama yang query per-bucket (bisa puluhan query per request).
     *
     * $barcodeGroups: [bucketKey => [defectCode => Collection barcode]]
     * $inspectQtyByBucket: [bucketKey => int]
     */
    private function bulkTopStylesByBucketDefect(
        array $barcodeGroups,
        array $inspectQtyByBucket,
        int $limit = 3
    ): array {
        $allBarcodes = collect($barcodeGroups)
            ->flatMap(fn ($byDefect) => collect($byDefect)->flatMap(fn ($b) => $b))
            ->filter()
            ->unique()
            ->values();

        if ($allBarcodes->isEmpty()) {
            return [];
        }

        // 1 query: ambil semua OutputDetail relevan sekaligus, lalu group per barcode di PHP
        $outputDetailsByBarcode = OutputDetail::whereIn('barcode', $allBarcodes)
            ->select('barcode', 'idpo')
            ->get()
            ->groupBy('barcode');

        $allIdpo = $outputDetailsByBarcode->flatten()->pluck('idpo')->unique()->values();

        // 1 query: PurchaseOrder -> idstyle
        $poToStyle = PurchaseOrder::whereIn('idpo', $allIdpo)->pluck('idstyle', 'idpo');

        // 1 query: Style -> nama style
        $styleNames = Style::whereIn('idstyle', $poToStyle->values()->unique())
            ->pluck('nmstyle', 'idstyle');

        $result = [];

        foreach ($barcodeGroups as $bucketKey => $byDefect) {
            foreach ($byDefect as $defectCode => $barcodes) {
                $grouped = [];

                foreach ($barcodes as $barcode) {
                    $rows = $outputDetailsByBarcode->get($barcode, collect());

                    foreach ($rows as $row) {
                        $idstyle = $poToStyle[$row->idpo] ?? null;
                        $nmstyle = $idstyle ? ($styleNames[$idstyle] ?? '-') : '-';
                        $grouped[$nmstyle] = ($grouped[$nmstyle] ?? 0) + 1;
                    }
                }

                if (empty($grouped)) {
                    continue;
                }

                arsort($grouped);
                $top = array_slice($grouped, 0, $limit, true);
                $inspectQty = $inspectQtyByBucket[$bucketKey] ?? 0;

                $rows = [];
                foreach ($top as $nmstyle => $qty) {
                    $rows[] = [
                        'style' => $nmstyle,
                        'qty'   => $qty,
                        'wft'   => $inspectQty > 0 ? round(($qty / $inspectQty) * 100, 2) : 0,
                    ];
                }

                $result[$bucketKey][$defectCode] = $rows;
            }
        }

        return $result;
    }

    /**
     * Bangun payload chart (labels, series, bucketMeta) untuk 1 mode + 1 set defect code.
     * Hanya menjalankan query dalam jumlah TETAP (~5 query total), tidak peduli
     * berapa banyak bucket atau defect code yang diminta.
     */
    private function buildDefectChartPayload(string $mode, Collection $defectCodes): array
    {
        [$dta, $dtb, $buckets, $bucketSqlExpr] = $this->resolveChartBuckets($mode);

        // 1 query besar untuk seluruh rentang waktu, bukan per-bucket
        $rows = SewingOutput::whereBetween('date', [$dta, $dtb])
            ->select('id', 'barcode', 'is_qc', 'defect_code', DB::raw("$bucketSqlExpr as bucket_key"))
            ->get();

        $rowsByBucket = $rows->groupBy(fn ($r) => (string) $r->bucket_key);

        $names = QCDefect::whereIn('kdcacat', $defectCodes)->pluck('deskripsi', 'kdcacat');

        $colors = ['#1B4FE0', '#F4977B', '#36B37E', '#FFAB00', '#8777D9', '#00B8D9', '#F24C4C', '#29B1AE'];

        $labels = [];
        $seriesData = [];
        foreach ($defectCodes as $c) {
            $seriesData[$c] = [];
        }

        $barcodeGroups = [];       // [bucketKey][defectCode] = Collection barcode
        $inspectQtyByBucket = [];  // [bucketKey] = int

        foreach ($buckets as $bucket) {
            $key = $bucket['key'];
            $labels[] = $bucket['label'];

            $bucketRows = $rowsByBucket->get($key, collect());
            $inspectRows = $bucketRows->where('is_qc', 1);

            $inspectQty = $inspectRows->count();
            $inspectQtyByBucket[$key] = $inspectQty;

            $defectRowsGrouped = $inspectRows
                ->whereIn('defect_code', $defectCodes->all())
                ->groupBy('defect_code');

            foreach ($defectCodes as $code) {
                $codeRows = $defectRowsGrouped->get($code, collect());
                $qty = $codeRows->count();

                $wft = $inspectQty > 0 ? round(($qty / $inspectQty) * 100, 2) : 0;
                $seriesData[$code][] = $wft;

                if ($qty > 0) {
                    $barcodeGroups[$key][$code] = $codeRows->pluck('barcode')->filter()->values();
                }
            }
        }

        // Top style per bucket per defect code, dihitung sekaligus (bulk)
        $topStylesByBucketDefect = $this->bulkTopStylesByBucketDefect($barcodeGroups, $inspectQtyByBucket);

        $bucketMeta = [];
        foreach ($buckets as $bucket) {
            $key = $bucket['key'];
            $topStylesByDefect = [];

            foreach ($defectCodes as $code) {
                $topStylesByDefect[(string) $code] = $topStylesByBucketDefect[$key][$code] ?? [];
            }

            $bucketMeta[] = [
                'topStylesByDefect' => $topStylesByDefect,
            ];
        }

        $series = $defectCodes->values()->map(function ($code, $i) use ($seriesData, $names, $colors) {
            return [
                'code'  => (string) $code,
                'name'  => $names[$code] ?? '-',
                'color' => $colors[$i % count($colors)],
                'data'  => $seriesData[$code],
            ];
        });

        return [
            'labels'     => $labels,
            'series'     => $series,
            'bucketMeta' => $bucketMeta,
        ];
    }

    public function getDefectChartData(Request $request)
    {
        preconnect(session('db'));

        $request->validate([
            'mode' => 'required|in:weekly,day',
        ]);

        $mode = $request->mode;
        $defectCodes = collect($request->input('defects', []))
            ->map(fn ($c) => (int) $c)
            ->unique()
            ->sort()
            ->values();

        $cacheKey = sprintf(
            'endline_defect_chart:%s:%s:%s',
            session('db')->iddb,
            $mode,
            $defectCodes->implode('-')
        );

        $payload = Cache::remember($cacheKey, now()->addSeconds($this->chartCacheTtl), function () use ($mode, $defectCodes) {
            return $this->buildDefectChartPayload($mode, $defectCodes);
        });

        return response()->json($payload);
    }

    private function buildDefectChartOptionsPayload(string $mode): array
    {
        if ($mode === 'day') {
            // Hari ini saja
            $headerQuery = SewingOutput::whereDate('date', Carbon::now());
        } else {
            // Rolling 7 hari terakhir, termasuk hari ini
            $dta = Carbon::now()->subDays(6)->startOfDay();
            $dtb = Carbon::now()->endOfDay();

            $headerQuery = SewingOutput::whereBetween('date', [$dta, $dtb]);
        }

        $headerIds = $headerQuery->pluck('id');

        $defectCodes = SewingOutput::whereIn('id', $headerIds)
            ->whereNotNull('defect_code')
            ->whereNotIn('defect_code', [800, 900])
            ->select('defect_code', DB::raw('COUNT(*) as total'))
            ->groupBy('defect_code')
            ->orderByDesc('total')
            ->limit(5)
            ->pluck('total', 'defect_code');

        $names = QCDefect::whereIn('kdcacat', $defectCodes->keys())
            ->pluck('deskripsi', 'kdcacat');

        $colors = [
            '#1B4FE0',
            '#F4977B',
            '#36B37E',
            '#FFAB00',
            '#8777D9',
            '#00B8D9',
            '#F24C4C',
            '#29B1AE',
        ];

        $options = $defectCodes->keys()
            ->values()
            ->map(function ($code, $index) use ($names, $colors) {
                return [
                    'code'  => (string) $code,
                    'name'  => $names[$code] ?? '-',
                    'color' => $colors[$index % count($colors)],
                ];
            });

        return ['options' => $options];
    }

    public function getDefectChartOptions(Request $request)
    {
        preconnect(session('db'));

        $request->validate([
            'mode' => 'required|in:weekly,day',
        ]);

        $mode = $request->mode;

        $cacheKey = sprintf('endline_defect_chart_options:%s:%s', session('db')->iddb, $mode);

        $payload = Cache::remember($cacheKey, now()->addSeconds($this->chartCacheTtl), function () use ($mode) {
            return $this->buildDefectChartOptionsPayload($mode);
        });

        return response()->json($payload);
    }

