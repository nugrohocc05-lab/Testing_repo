 function dataTable(Request $request)
    {
        preconnect(session('db'));

        // Detail
        if ($request->has('detail_id') && $request->detail_id != '') {
            $cartoncode = $request->detail_id;

            $doRows = DOStock::select('delivery_order', 'cartoncode', 'masterbuyer_id', 'masterstyle_id', 'season', 'remark')
                ->where('cartoncode', $cartoncode)
                ->get()
                ->unique(function ($item) {
                    return $item->delivery_order . '-' . $item->cartoncode;
                });

            $result = collect();

            foreach ($doRows as $do) {

                $buyer    = Buyer::select('nmbuyer')->where('idbuyer', $do->masterbuyer_id)->first();
                $style    = Style::select('nmstyle', 'sub_style_id')->where('idstyle', $do->masterstyle_id)->first();
                $subStyle = $style ? SubStyle::select('name')->where('id', $style->sub_style_id)->first() : null;

                // Menampilkan data yang sudah di softdelete
                $frRows = FGReceiveGarmentStock::withTrashed()
                    ->whereIn('delivery_order', $do)
                    ->get();

                // $frRows = FGReceiveGarmentStock::where('delivery_order', $do->delivery_order)->get();

                foreach ($frRows as $fr) {
                    $od = OutputDetail::select('idpo', 'idcolor', 'idsize')
                        ->where('barcode', $fr->barcode)
                        ->first();

                    if (!$od) {
                        continue;
                    }

                    $po    = PurchaseOrder::select('po')->where('idpo', $od->idpo)->first();
                    $color = Color::select('nmcolor')->where('idcolor', $od->idcolor)->first();
                    $size  = Size::select('nmsize')->where('idsize', $od->idsize)->first();

                    $result->push([
                        'barcode'    => $fr->barcode,
                        'cartoncode' => $do->cartoncode,
                        'buyer'      => $buyer->nmbuyer ?? '-',
                        'style'      => $style->nmstyle ?? '-',
                        'color'      => $color->nmcolor ?? '-',
                        'size'       => $size->nmsize ?? '-',
                        'season'     => $do->season,
                        'remark'     => $do->remark,
                        'sub_style'  => $subStyle->name ?? '-',
                        'po'         => $po->po ?? '-',
                    ]);
                }
            }

            return DataTables::of($result)
                ->addIndexColumn()
                ->toJson();
        }

        // Listing Utama
        $filterType = $request->filter_type;
        $groupBuyer = $request->group_buyer;
        $season     = $request->season;
        $po         = $request->po;

        if (!$filterType) {
            return DataTables::of(collect([]))->toJson();
        }

        if ($filterType == 'groupbuyer_filter' && (!$groupBuyer || !$season)) {
            return DataTables::of(collect([]))->toJson();
        }

        if ($filterType == 'po_filter' && !$po) {
            return DataTables::of(collect([]))->toJson();
        }

        // Query groupbuyer (db atas)
        $buyerIds = null;
        if ($filterType == 'groupbuyer_filter') {
            $buyerIds = Buyer::where('groupbuyer', $groupBuyer)->pluck('idbuyer')->toArray();
        }

        // Query group per cartoncode (db bawah)
        $doQuery = DOStock::select('delivery_order', 'cartoncode', 'masterbuyer_id', 'masterstyle_id', 'season')
            ->selectRaw('SUM(qty) as total_qty')
            ->groupBy('delivery_order', 'cartoncode', 'masterbuyer_id', 'masterstyle_id', 'season');

        if ($filterType == 'groupbuyer_filter') {
            $doQuery->whereIn('masterbuyer_id', $buyerIds)
                    ->where('season', $season);
        }

        $doRows = $doQuery->get();

        $result = collect();

        foreach ($doRows as $do) {

        // Menampilkan data yang sudah di softdelete
            $frRows = FGReceiveGarmentStock::withTrashed()
                ->where('delivery_order', $do->delivery_order)
                ->whereNotNull('date_gi')
                ->orderByDesc('date_out')
                ->get();

            if ($frRows->isEmpty()) {
                continue;
            }

            $poList          = collect();
            $matchesPoFilter = $filterType != 'po_filter';

            foreach ($frRows as $fr) {
                $od = OutputDetail::select('idpo')->where('barcode', $fr->barcode)->first();

                if ($od) {
                    $poModel = PurchaseOrder::select('po')->where('idpo', $od->idpo)->first();

                    if ($poModel) {
                        $poList->push($poModel->po);

                        if ($filterType == 'po_filter' && $poModel->po == $po) {
                            $matchesPoFilter = true;
                        }
                    }
                }
            }

            if (!$matchesPoFilter) {
                continue;
            }

            $buyer    = Buyer::select('nmbuyer')->where('idbuyer', $do->masterbuyer_id)->first();
            $style    = Style::select('nmstyle', 'sub_style_id')->where('idstyle', $do->masterstyle_id)->first();
            $subStyle = $style ? SubStyle::select('name')->where('id', $style->sub_style_id)->first() : null;

            $latestFr = $frRows->first();

            $result->push([
                'no'                   => $do->cartoncode,
                'cartoncode'           => $do->cartoncode,
                'season'               => $do->season,
                'qty'                  => $do->total_qty,
                'user'                 => $latestFr->user_id,
                'date'                 => $latestFr->date_out,
                'buyer'                => $buyer->nmbuyer ?? '-',
                'style'                => $style->nmstyle ?? '-',
                'sub_style'            => $subStyle->name ?? '-',
                'po'                   => $poList->unique()->implode(', '),
                'encrypted_cartoncode' => encrypt($do->cartoncode),
            ]);
        }

        $result = $result->unique('cartoncode')->values();

        return DataTables::of($result)
            ->addIndexColumn()
            ->toJson();
    }

