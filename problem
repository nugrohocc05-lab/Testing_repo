<?php

namespace Modules\Monitoring\Http\Controllers;

use DB;
use Carbon\Carbon;
use Illuminate\Http\Request;
use App\Http\Controllers\Controller;
use App\Http\Models\Main\MasterEmployeeGroup;
use App\Http\Models\Main\MasterEmployeeSection;
use App\Http\Models\Main\MasterGroupBuyer;
use App\Http\Models\PurchaseOrder;
use App\Http\Models\Main\Buyer;
use App\Http\Models\InlineDetail;
use App\Http\Models\InlineHeader;


class InlinePerformanceController extends Controller
{
    protected $m_modul = 'report';

    function __construct()
    {
        $this->middleware('auth');
    }

    function index()
    {
        if ($this->myaccess() == '0') {
            return redirect()
                ->back()
                ->with('alert', [
                    'title' => 'Unauthorized!',
                    'message' => 'You Dont Have Any Access Here!',
                    'status' => 'warning',
                ]);
        }

        preconnect(session('db'));

        return view('monitoring::inlineperformance.index');
    }

    function selectline(Request $request)
    {
        $g = (new MasterEmployeeGroup())->getTable();
        $s = (new MasterEmployeeSection())->getTable();

        $data = MasterEmployeeGroup::select(
                "$g.id as kodegroup", "$g.section_id as kodebagian",
                "$g.name as namagroup", "$s.name as namabagian"
            )
            ->join($s, "$s.id", '=', "$g.section_id")
            ->distinct()
            ->whereHas('groupline', function($q){
                $q->where('factory_id', session('db')->iddb)
                    ->where('is_show', 1)
                    ->where('is_line', 1);
            });

        if ($request->q) {
            $data = $data->where(function ($q) use ($request, $g) {
                $q->where("$g.name", 'like', "%$request->q%");
            });
        }
        $data = $data->orderBy('kodegroup')->paginate(15, $request->page);

        return response()->json($data);
    }

    function groupbuyer(Request $request)
    {
        $data = MasterGroupBuyer::select('id', 'group_name')
            ->get()
            ->map(function($item){
                return [
                    'id' => $item->id,
                    'text' => $item->group_name
                ];
            });

        return response()->json([
            'results' => $data
        ]);
    }

    function inlinetls(Request $request){
        return view('monitoring::inlineperformance.inline');
    }

    function filterData(Request $request)
    {
        preconnect(session('db'));

        try {

            $m_da = $request->datea > $request->dateb
                ? $request->dateb
                : $request->datea;

            $m_db = $request->datea > $request->dateb
                ? $request->datea
                : $request->dateb;

            $dta = Carbon::parse($m_da);
            $dtb = Carbon::parse($m_db)->endOfDay();

            $diff = $dta->diffInDays($dtb);

            if ($diff > 30) {
                return '<center><h3>Date Has More Than 30 Days in Range, Cannot View Data.</h3></center>';
            }

            $filteredPoIds = null;

            if ($request->groupbuyer && $request->groupbuyer != 'all') {

                $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)
                    ->pluck('idbuyer');

                $filteredPoIds = PurchaseOrder::whereIn('idbuyer', $buyerIds)
                    ->pluck('idpo');
            }

            $tgldata = InlineHeader::select(
                    'idpo',
                    'idcolor',
                    'idsize',
                    'group_id as line',
                    'round'
                )
                ->addSelect(DB::raw("SUBSTR(date,1,10) as tanggal"))
                ->whereBetween("date", [$dta, $dtb]);

            if ($request->line != 'all') {
                $tgldata = $tgldata->where('group_id', $request->line);
            }

            // if ($filteredPoIds !== null) {
            //     $tgldata = $tgldata->whereIn('idpo', $filteredPoIds);
            // }

            $tgldata = $tgldata
                ->groupBy(
                    "tanggal","line","idpo","idcolor","idsize","round"
                )
                ->get();

            // Join Group data
            $poIds = $tgldata
                ->pluck('idpo')
                ->unique()
                ->filter()
                ->values();


            $poMap = PurchaseOrder::select(
                    'idpo',
                    'idbuyer'
                )
                ->whereIn('idpo', $poIds)
                ->get()
                ->keyBy('idpo');

            $buyerIds = $poMap
                ->pluck('idbuyer')
                ->unique()
                ->filter()
                ->values();

            $buyerMap = Buyer::select(
                    'idbuyer',
                    'groupbuyer'
                )
                ->whereIn('idbuyer', $buyerIds)
                ->get()
                ->keyBy('idbuyer');

            $groupbuyerIds = $buyerMap
                ->pluck('groupbuyer')
                ->unique()
                ->filter()
                ->values();

            $groupbuyerMap = MasterGroupBuyer::select(
                    'id',
                    'group_name'
                )
                ->whereIn('id', $groupbuyerIds)
                ->get()
                ->keyBy('id');

            $tgldata = $tgldata->map(function ($item) use ($poMap, $buyerMap, $groupbuyerMap) {
                $po = $poMap->get($item->idpo);

                $buyer = $po
                    ? $buyerMap->get($po->idbuyer)
                    : null;

                $groupbuyer = $buyer
                    ? $groupbuyerMap->get($buyer->groupbuyer)
                    : null;

                $item->groupbuyer = $groupbuyer->group_name ?? '-';
                return $item;

            });


            return response()->json($tgldata);

        } catch (\Throwable $e) {
            return $e->getMessage();
        }
    }

    function datatables(Request $request)
    {
        preconnect(session('db'));

        try {

            $date = $request->date ?: InlineHeader::max('date');
            $date = Carbon::parse($date)->format('Y-m-d');

            $g = (new MasterEmployeeGroup())->getTable();
            $s = (new MasterEmployeeSection())->getTable();

            $data = MasterEmployeeGroup::select(
                    "$g.id as kodegroup", "$g.section_id as kodebagian",
                    "$g.name as namagroup", "$s.name as namabagian"
                )
                ->join($s, "$s.id", '=', "$g.section_id")
                ->distinct()
                ->whereHas('groupline', function($q){
                    $q->where('factory_id', session('db')->iddb)
                        ->where('is_show', 1)
                        ->where('is_line', 1);
                });

            if ($request->q) {
                $data = $data->where(function ($q) use ($request, $g) {
                    $q->where("$g.name", 'like', "%$request->q%");
                });
            }

            $data = $data->orderBy('kodegroup')->get();

            return response()->json([
                'date' => $date,
                'data' => $data
            ]);

        } catch (\Throwable $e) {
            return $e->getMessage();
        }
    }

}
