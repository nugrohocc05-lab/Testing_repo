            return "Packing";
        })
        ->addColumn('status', function($d){
            $status = "Waiting to approved";
            return $status;
        })
        ->addColumn('remark', function($d){
            return $d->remark ?? '-';
        })
        ->addColumn('action', function ($d) {
            $kode = encrypt($d->request_id);
            $access = $this->myaccess();
            $button = "";
            
            if ($access != 'f') {
                return '';
            }
            $button .=
                '<a href="'.route('approvalstorageapprovalform', ['id'=>$kode]).'" class="actionbtn" data-tooltip="tooltip" title="Action ' .
                $d->request_id .
                '"><i class="fa fa-arrow-circle-right fa-lg text-blue actiona"></i></a>';

            return $button;
        })
        ->make(true);
    }

    function approvalform(Request $request)
    {
        if ($this->myaccess() == '0') {
            return redirect()
                ->back()
                ->with('alert', [
                    'title' => 'Unauthorized!',
                    'message' => 'You Dont Have Any Access Here!',
                    'status' => 'warning',
                ]);
        }

        try {
            $decrypt = decrypt($request->id);

            $data = MainDOStock::whereNull('date_approve')
                ->where('is_lab', 0)
                ->where("request_id", $decrypt);
                if(session('admin') != 'admin'){
                    $data = $data
                        ->where('factory_id', session('db')->iddb)
                        ->where("userid_approve", session('user')->nik);
                }
            $data = $data
                    ->groupBy("masterstyle_id", "mastercolor_id", "mastersize_id")
                    ->get();
            foreach ($data as $d) {
                $d->key = $d->masterbuyer_id.'_'.$d->masterstyle_id.'_'.$d->mastercolor_id.'_'.$d->mastersize_id;
                $d->nmstyle = Style::find($d->masterstyle_id)->nmstyle ?? '-';
                $d->nmcolor = Color::find($d->mastercolor_id)->nmcolor ?? '-';
                $d->nmsize = Size::find($d->mastersize_id)->nmsize ?? '-';
