function datatable(Request $request)
    {
        preconnect(session('db'));
        $header = (new ResultTestLabHeader())->getTable();
        $routing = (new ProcessRoutingLab())->getTable();
        $rcv = (new ReceivedLab())->getTable();
        $data = ResultTestLabHeader::select(
                "$header.id", "$rcv.factory_id", "$rcv.barcode", "$rcv.idbuyer", "$rcv.season",
                "$rcv.idstyle", "$rcv.sub_style_id", "$rcv.idcolor", "$header.date_in", 
                "$header.date_out", "$rcv.idsize", "$routing.received_lab_id", "$rcv.idpo"
            )
            ->join($routing, "$routing.id", "=", "$header.process_routing_id")
            ->join($rcv, "$rcv.id", "=", "$routing.received_lab_id")
            ->whereNotNull("$header.date_out");
        if($request->has('buyer') and $request->buyer != null){
            $data = $data->where("$rcv.idbuyer", $request->buyer);
        }
        if($request->has('style') and $request->style != null){
            $data = $data->where("$rcv.idstyle", $request->style);
        }
        $data = $data
            ->groupBy("$rcv.barcode", "$rcv.idstyle", "$rcv.idcolor", "$rcv.idsize");

        return DataTables::of($data)
            ->addIndexColumn()
            ->filterColumn('barcode', function($q, $key){
                $q->where("barcode", "like", "%$key%");
            })
            ->filterColumn('season', function($q, $key){
                $q->where("season", "like", "%$key%");
            })
            ->addColumn('buyer', function($d){
                $b = Buyer::find($d->idbuyer);
                return $b ? $b->nmbuyer : '';
            })
            ->addColumn('po', function($d){
                $po = PurchaseOrder::where("idpo", $d->idpo)
                    ->first();
                return $po ? $po->po : '';
            })
            ->addColumn('style', function($d){
                $s = Style::find($d->idstyle);
                return $s ? $s->nmstyle : '';
            })
            ->addColumn('substyle', function($d){
                $ss = SubStyle::find($d->sub_style_id);
                return $ss ? $ss->name : '';
            })
            ->addColumn('article', function($d){
                $db = get_db($d->factory_id);
                $c = Color::on($db)->find($d->idcolor);
                return $c ? $c->nmcolor : '';
            })
            ->filterColumn('article', function($q, $key){
                $db = getconnection(session('db'));
                $c = Color::on($db)
                    ->where("nmcolor", 'like', "%$key%")
                    ->get();
                $q->whereIn("idcolor", $c->pluck('idcolor'));
            })
            ->addColumn('size', function($d){
                $db = get_db($d->factory_id);
                $s = Size::on($db)->find($d->idsize);
                return $s ? $s->nmsize : '';
            })
            ->filterColumn('size', function($q, $key){
                $db = getconnection(session('db'));
                $s = Size::on($db)
                    ->where("nmsize", 'like', "%$key%")
                    ->get();
                $q->whereIn("idsize", $s->pluck('idsize'));
            })
            ->addColumn('date', function($d){
                $date = Carbon::parse($d->date_in)->format("Y/m/d H:i")." - ".Carbon::parse($d->date_out)->format("Y/m/d H:i");
                return $date ?? '';
            })
            ->addColumn('status', function($d){
                $detail = ResultTestLabDetail::where("result_test_header_id", $d->id)
                    ->where("result", 0)
                    ->first();
                return $detail ? "Fail" : "Pass";
            })
            ->addColumn('action', function($d){
                $kode = encrypt($d->received_lab_id);
                return '<a href="#" class="detailbtn" data-id="'.
                $kode
                .'"><i class="fa fa-info-circle fa-lg text-blue actiona"></i></a>';
            })
            ->toJson();
    }

