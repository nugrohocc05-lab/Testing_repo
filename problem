        $fgreceive = "mesprima1_restore.fgreceivegarment_stocks";
        $dos = "mesprima1_restore.delivery_order_stocks";

        $gbuyer = DB::table($fgreceive . ' as fr')
                ->join($dos . ' as do', function ($join) {
                    $join->on('fr.delivery_order', '=', 'do.delivery_order');
                })
                ->join('mainmes.masterbuyer as mb', 'do.masterbuyer_id', '=', 'mb.idbuyer')
                ->join('mainmes.master_group_buyers as mgb', 'mb.groupbuyer', '=', 'mgb.id')
                ->whereNotNull('fr.date_gi')
                ->select(
                    'mgb.id',
                    'mgb.group_name'
                )
                ->distinct()
                ->orderBy('mgb.group_name')
                ->get();
        return response()->json($gbuyer);
    }

    function listSeason(Request $request)
    {
        $query = DB::table('mesprima1_restore.fgreceivegarment_stocks as fr')
            ->join('mesprima1_restore.delivery_order_stocks as do', 'fr.delivery_order', '=', 'do.delivery_order')
            ->join('mainmes.masterbuyer as mb', 'do.masterbuyer_id', '=', 'mb.idbuyer')
            ->whereNotNull('fr.date_gi');

        if ($request->group_buyer) {
            $query->where('mb.groupbuyer', $request->group_buyer);
        }

        $data = $query
            ->select('do.season')
            ->whereNotNull('do.season')
            ->distinct()
            ->orderBy('do.season')
            ->get();

        return response()->json($data);
    }

