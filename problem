<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>


<div class="row mt-3 border-custom-datatable rounded p-3 text-white" style="min-height:370px">
    <div class="col-12 mb-3 d-flex align-items-center gap-4">
        <img src="{{ _asset('svg/inlinePerformance/line.svg') }}" style="width: 30px; height: 30px;">
        <h4 class="mb-0 fw-normal">DETAIL PER LINE INLINE PERFORMANCE</h4>
    </div>
    
    <div class="col-12 table-responsive">
        <table id="performanceTable" class="table table-dark table-hover table-striped w-100">
            <thead>
                <tr>
                    <th>No</th>
                    <th>Line Name</th>
                    <th>Group Buyer</th>
                    <th>Qty Inspect</th>
                    <th>Qty Defect</th>
                    <th>RFT (%)</th>
                    <th>WFT (%)</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                </tbody>
        </table>
    </div>
</div>

let dataTable = $('#performanceTable').DataTable({
    processing: true, // Menampilkan tulisan "processing" saat loading data
    serverSide: false, // Set false jika manipulasi data (pencarian/page) dilakukan di browser pembaca (Client-side)
    
    // Tempat melakukan Request AJAX
    ajax: function (data, callback, settings) {
        // Karena ini manual/dummy, kita simulasikan delay loading server selama 800ms
        setTimeout(function() {
            callback({
                // Ini adalah replika format JSON yang biasanya dikirim oleh Controller/Backend Anda
                data: [
                    { no: 1, line_name: "Line A - Sewing", group_buyer: "Nike", qty_inspect: 312, qty_defect: 12, rft: 96, wft: 4, status: "Good" },
                    { no: 2, line_name: "Line B - Assembling", group_buyer: "Adidas", qty_inspect: 250, qty_defect: 25, rft: 90, wft: 10, status: "Warning" },
                    { no: 3, line_name: "Line C - Packing", group_buyer: "Puma", qty_inspect: 400, qty_defect: 4, rft: 99, wft: 1, status: "Excellent" }
                ]
            });
        }, 800);
    },
    
    // Memetakan key dari JSON data dummy ke dalam kolom HTML <th> secara berurutan
    columns: [
        { data: 'no', className: 'text-center' },
        { data: 'line_name' },
        { data: 'group_buyer' },
        { data: 'qty_inspect', className: 'text-end' },
        { data: 'qty_defect', className: 'text-end' },
        { 
            data: 'rft', 
            className: 'text-end',
            render: function(data, type, row) {
                // Di sini Anda bisa memodifikasi tampilan teks, misal memberi warna kuning jika RFT rendah
                return `<span class="${data >= 95 ? 'text-green' : 'text-yellow'}">${data}%</span>`;
            }
        },
        { 
            data: 'wft', 
            className: 'text-end',
            render: function(data, type, row) { return data + '%'; }
        },
        {
            data: 'status',
            className: 'text-center',
            render: function(data, type, row) {
                // Modifikasi status menjadi bentuk badge Bootstrap
                let badge = data === "Good" || data === "Excellent" ? "bg-success" : "bg-warning text-dark";
                return `<span class="badge ${badge}">${data}</span>`;
            }
        }
    ]
});


$('#findbtn').on('click', function(e){
    e.preventDefault();
    
    // Perintah ini akan memicu fungsi `ajax:` di Langkah 3 untuk berjalan kembali
    dataTable.ajax.reload(); 
});
