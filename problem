            return [
                'defect_id'  => $item->defect_code,
                'nmdefect'   => $masterQcDefects[$item->defect_code] ?? '-',
                'defect_qty' => (int) $item->total,
                'percent'    => number_format($percent, 2),
                'color'      => $colors[$index] ?? '#29B1AE',
                'top_style'  => $topStyles[(string) $item->defect_code]['rows'] ?? [],
            ];
        });

        $topDefect->push([
            'defect_id'  => 'others',
            'nmdefect'   => 'Others',
            'defect_qty' => (int) $othersQty,
            'percent'    => number_format($othersPercent, 2),
            'color'      => '#29B1AE',
            'top_style'  => $topStyles['others']['rows'] ?? [],
        ]);

        $totTopDefect = $topDefect->sum('defect_qty');

        return view('monitoring::endlineperformance.performance.partials.weekly', [
            'header'       => $header,
            'rft_qty'      => $rft_qty,
            'inspect_qty'  => $totInspect,
            'defect_qty'   => $totDefect,
            'rft'          => $rft,
            'wft'          => $wft,
            'top_defect'   => $topDefect,
            'totTopDefect' => $totTopDefect,
        ]);
    }

    // Helper: hitung range tanggal dari week_id
    private function weekRange($year, int $weekNumber): array
    {
        $dta = Carbon::createFromDate($year, 1, 1)->startOfDay()->addDays(($weekNumber - 1) * 7);
        $dtb = $dta->copy()->addDays(6)->endOfDay();

        $endOfYear = Carbon::createFromDate($year, 12, 31)->endOfDay();
        if ($dtb->gt($endOfYear)) {
            $dtb = $endOfYear->copy();
        }

        return [$dta, $dtb];
    }

    // Helper: pecah range tanggal jadi bucket per hari
    private function buildDayBuckets(Carbon $dta, Carbon $dtb): array
    {
        $rows = SewingOutput::whereBetween('date', [$dta, $dtb])
            ->select('id', DB::raw('DATE(date) as dd'))
            ->get()
            ->groupBy('dd');

        $buckets = [];
        $cursor = $dta->copy();

        while ($cursor->lte($dtb)) {
            $key = $cursor->format('Y-m-d');
            $buckets[] = [
                'label' => $cursor->format('d M'),
                'ids'   => $rows->has($key) ? $rows[$key]->pluck('id') : collect(),
            ];
            $cursor->addDay();
        }

        return $buckets;
    }

    // Helper: pecah satu hari jadi bucket per jam
    private function buildHourBuckets(Carbon $date): array
    {
        $rows = SewingOutput::whereDate('date', $date)
            ->select('id', DB::raw('HOUR(date) as hh'))
            ->get()
            ->groupBy('hh');

        $buckets = [];
        foreach (range(7, 23) as $h) {
            $mid = $date->copy()->setTime($h, 30, 0);

            $buckets[] = [
                'label' => sprintf('%02d:00', $h),
                'time'  => $mid->format('Y-m-d H:i:s'),
                'ids'   => $rows->has($h) ? $rows[$h]->pluck('id') : collect(),
            ];
        }

        return $buckets;
    }

    private function buildBucketTopStyles(Collection $rowsMap, array $buckets, Collection $defectCodes, array $inspectQtyPerBucket, int $limit = 3): array
    {
        if ($defectCodes->isEmpty()) {
            return array_fill(0, count($buckets), []);
        }

        $allBarcodes = collect();
        $bucketCodeBarcodes = [];

        foreach ($buckets as $i => $bucket) {
            $rowsInBucket = $bucket['ids']->map(fn ($id) => $rowsMap->get($id))->filter();

            foreach ($defectCodes as $code) {
                $barcodes = $rowsInBucket
                    ->filter(fn ($r) => (int) $r->is_qc === 1 && $r->defect_code == $code)
                    ->pluck('barcode')
                    ->unique()
                    ->values();

                $bucketCodeBarcodes[$i][$code] = $barcodes;
                $allBarcodes = $allBarcodes->merge($barcodes);
            }
        }

        $allBarcodes = $allBarcodes->unique()->values();

        if ($allBarcodes->isEmpty()) {
            return array_fill(0, count($buckets), []);
        }

        $outputRows = OutputDetail::whereIn('barcode', $allBarcodes)
            ->select('idpo', 'barcode')
            ->get();

        $poToStyle = PurchaseOrder::whereIn('idpo', $outputRows->pluck('idpo')->unique())
            ->pluck('idstyle', 'idpo');

        $styleNames = Style::whereIn('idstyle', $poToStyle->values()->unique())
            ->pluck('nmstyle', 'idstyle');

        $results = [];

        foreach ($buckets as $i => $bucket) {
            $inspectQty = $inspectQtyPerBucket[$i] ?? 0;
            $results[$i] = [];

            foreach ($defectCodes as $code) {
                $barcodeSet = ($bucketCodeBarcodes[$i][$code] ?? collect())->flip();

                if ($barcodeSet->isEmpty()) {
                    $results[$i][(string) $code] = [];
                    continue;
                }

                $styleQty = $outputRows->filter(fn ($r) => $barcodeSet->has($r->barcode))
                    ->groupBy('idpo')
                    ->map->count();

                $grouped = [];
                foreach ($styleQty as $idpo => $total) {
                    $idstyle = $poToStyle[$idpo] ?? null;
                    $nmstyle = $idstyle ? ($styleNames[$idstyle] ?? '-') : '-';
                    $grouped[$nmstyle] = ($grouped[$nmstyle] ?? 0) + $total;
                }

                arsort($grouped);
                $top = array_slice($grouped, 0, $limit, true);

                $rows = [];
                foreach ($top as $nmstyle => $qty) {
                    $rows[] = [
                        'style' => $nmstyle,
                        'qty'   => $qty,
                        'wft'   => $inspectQty > 0 ? round(($qty / $inspectQty) * 100, 2) : 0,
                    ];
                }

                $results[$i][(string) $code] = $rows;
            }
        }

        return $results;
    }

    private function generateDistinctColors(int $count): array
    {
        if ($count <= 0) {
            return [];
        }

        $baseColors = $this->defectColors;

        $colors = [];
            for ($i = 0; $i < $count; $i++) {
            if ($i < count($baseColors)) {
                $colors[] = $baseColors[$i];
                continue;
            }

            $hue = fmod($i * 137.508, 360);
            $saturation = 65; // %
            $lightness  = 55; // %

            $colors[] = $this->hslToHex($hue, $saturation, $lightness);
        }

        return $colors;
    }

    private function hslToHex(float $h, float $s, float $l): string
    {
        $s /= 100;
        $l /= 100;

        $c = (1 - abs(2 * $l - 1)) * $s;
        $x = $c * (1 - abs(fmod($h / 60, 2) - 1));
        $m = $l - $c / 2;

        if ($h < 60)       { [$r, $g, $b] = [$c, $x, 0]; }
        elseif ($h < 120)  { [$r, $g, $b] = [$x, $c, 0]; }
        elseif ($h < 180)  { [$r, $g, $b] = [0, $c, $x]; }
        elseif ($h < 240)  { [$r, $g, $b] = [0, $x, $c]; }
        elseif ($h < 300)  { [$r, $g, $b] = [$x, 0, $c]; }
        else               { [$r, $g, $b] = [$c, 0, $x]; }

        $r = round(($r + $m) * 255);
        $g = round(($g + $m) * 255);
        $b = round(($b + $m) * 255);

        return sprintf('#%02X%02X%02X', $r, $g, $b);
    }

    private function getDefectColorMap(string $mode): array
    {
        $cacheKey = "defect_color_map_{$mode}_" . Carbon::now()->format('Y-m-d_H:i');

        return Cache::remember($cacheKey, now()->addMinutes(2), function () use ($mode) {
            if ($mode === 'day') {
                $headerQuery = SewingOutput::whereDate('date', Carbon::now());
            } else {
                $dta = Carbon::now()->subDays(6)->startOfDay();
                $dtb = Carbon::now()->endOfDay();
                $headerQuery = SewingOutput::whereBetween('date', [$dta, $dtb]);
            }

            $rankedCodes = (clone $headerQuery)
                ->whereNotNull('defect_code')
                ->whereNotIn('defect_code', [800, 900])
                ->select('defect_code', DB::raw('COUNT(*) as total'))
                ->groupBy('defect_code')
                ->orderByDesc('total')
                ->orderBy('defect_code', 'asc')
                ->pluck('total', 'defect_code')
                ->keys();

            $names = QCDefect::whereIn('kdcacat', $rankedCodes)
                ->pluck('deskripsi', 'kdcacat');

            $palette = $this->generateDistinctColors($rankedCodes->count());

            $map = [];
            foreach ($rankedCodes->values() as $index => $code) {
                $map[(string) $code] = [
                    'name'  => $names[$code] ?? '-',
                    'color' => $palette[$index],
                ];
            }

            return $map;
        });
    }

    public function getDefectChartOptions(Request $request)
    {
        preconnect(session('db'));

        $request->validate([
            'mode' => 'required|in:weekly,day',
        ]);

        $colorMap = $this->getDefectColorMap($request->mode);

        $options = collect($colorMap)
            ->map(function ($item, $code) {
                return [
                    'code'  => $code,
                    'name'  => $item['name'],
                    'color' => $item['color'],
                ];
            })
            ->values();

        return response()->json([
            'options' => $options,
        ]);
    }

    public function getDefectChartData(Request $request)
    {
        preconnect(session('db'));

        $request->validate([
            'mode' => 'required|in:weekly,day',
        ]);

        $defectCodes = collect($request->input('defects', []))->map(fn ($c) => (int) $c);

        if ($request->mode === 'day') {
            $buckets = $this->buildHourBuckets(Carbon::now());
        } else {
            $dta = Carbon::now()->subDays(6)->startOfDay();
            $dtb = Carbon::now()->endOfDay();
            $buckets = $this->buildDayBuckets($dta, $dtb);
        }

        $colorMap = $this->getDefectColorMap($request->mode);

        $names = QCDefect::whereIn('kdcacat', $defectCodes)->pluck('deskripsi', 'kdcacat');

        $allIds = collect($buckets)->pluck('ids')->flatten()->unique()->values();

        $rowsMap = $allIds->isNotEmpty()
            ? SewingOutput::whereIn('id', $allIds)
                ->select('id', 'is_qc', 'defect_code', 'barcode')
                ->get()
                ->keyBy('id')
            : collect();

        $labels = [];
        $seriesData = [];
        $seriesQty  = [];
        foreach ($defectCodes as $c) {
            $seriesData[$c] = [];
            $seriesQty[$c]  = [];
        }

        $inspectQtyPerBucket = [];

        foreach ($buckets as $i => $bucket) {
            $labels[] = $bucket['label'];

            $bucketRows = $bucket['ids']->map(fn ($id) => $rowsMap->get($id))->filter();

            $inspectQty = $bucketRows->where('is_qc', 1)->count();
            $inspectQtyPerBucket[$i] = $inspectQty;

            $defectQtyPerCode = $bucketRows->where('is_qc', 1)
                ->whereIn('defect_code', $defectCodes->toArray())
                ->groupBy('defect_code')
                ->map->count();

            foreach ($defectCodes as $code) {
                $qty = $defectQtyPerCode[$code] ?? 0;
                $wft = $inspectQty > 0 ? round(($qty / $inspectQty) * 100, 2) : 0;

                $seriesData[$code][] = $wft;
                $seriesQty[$code][]  = (int) $qty;
            }
        }

        $topStylesPerBucket = $this->buildBucketTopStyles($rowsMap, $buckets, $defectCodes, $inspectQtyPerBucket);

        $bucketMeta = [];
        foreach ($buckets as $i => $bucket) {
            $bucketMeta[] = [
                'topStyles'  => $topStylesPerBucket[$i] ?? [],
                'inspectQty' => $inspectQtyPerBucket[$i] ?? 0,
            ];
        }

        $series = $defectCodes->values()->map(function ($code) use ($seriesData, $seriesQty, $names, $colorMap) {
            $codeKey = (string) $code;
            $mapped  = $colorMap[$codeKey] ?? null;

            return [
                'code'  => $codeKey,
                'name'  => $mapped['name']  ?? ($names[$code] ?? '-'),
                'color' => $mapped['color'] ?? '#8A93A6',
                'data'  => $seriesData[$code],
                'qty'   => $seriesQty[$code],
            ];
        });

        $times = $request->mode === 'day'
            ? collect($buckets)->pluck('time')->values()
            : [];

        return response()->json([
            'labels'     => $labels,
            'times'      => $times,
            'series'     => $series,
            'bucketMeta' => $bucketMeta,
        ]);
    }
