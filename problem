            }
            $button .=
                '<a href="'.route('approvalstoragehistdetail', ['id'=>$kode]).'" class="detailbtn" data-tooltip="tooltip" title="Action ' .
                $d->request_id .
                '"><i class="fa fa-info-circle fa-lg text-blue actiona"></i></a>';

            return $button;
        })
        ->make(true);
    }

    function store(Request $request)
    {
        preconnect(session('db'));

        try {
            if($request->approval === null){
                throw new \Exception("You must select approval!");
            }
            $id = decrypt($request->do);

            $data = MainDOStock::where('request_id', $id)
                ->where('is_lab', 0)
                ->where('factory_id', session('db')->iddb)
                ->update([
                    'is_approve' => $request->approval,
                    'date_approve' => Carbon::now()->format('Y-m-d H:i:s'),
                    'userid_approve' => session('user')->nik ?? null
                ]);
            if($data){
                if($request->approval != 1){
                    DeliveryOrderStorageController::cancelrequest($request);
                }

                $data = [
                    's'=>'success',
                    'm'=>$request->approval == 1 ? "Successfully Approved!" : "Successfully Reject!"
                ];
                return response()->json($data);
            }
            throw new \Exception("Failed to update data!");
        } catch (\Throwable $e) {
            return response()->json($e->getMessage(), 400);
        }
    }

