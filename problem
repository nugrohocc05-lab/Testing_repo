            // Solve bug dropdown
            $(document).on('click', '.dropdown-submenu > a', function(e) {
            const $li = $(this).parent('.dropdown-submenu');

            e.preventDefault();
            e.stopPropagation();

            const isOpen = $li.hasClass('open');

            $li.siblings('.dropdown-submenu').removeClass('open');
            $li.siblings('.dropdown-submenu').find('.dropdown-menu').hide();

            if (isOpen) {
                $li.removeClass('open');
                $li.children('.dropdown-menu').hide();
            } else {
                $li.addClass('open');
                $li.children('.dropdown-menu').show();
            }
