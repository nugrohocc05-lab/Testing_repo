    // ============================================================
    // HELPER: ambil baris "aktif/leaf" dari historydbreakdown.
    // Dedup per (idpo, idcolor, kp_item) ambil revisi_kp terbesar,
    // lalu buang kp_item yang sudah dirujuk oleh kp_item lain
    // dalam family (combine_pro) yang sama -> sisanya = idpo aktif.
    //
    // $dta/$dtb bisa di-pass manual (untuk range custom seperti
    // need-final / overdue). Kalau null, fallback baca dari
    // $request->datea / $request->dateb.
    // ============================================================
    private function getLeafHistoryRows(Request $request, $dta = null, $dtb = null, $familyColumn = 'combine_pro', $applyPoFilter = true)
    {
        $po  = (new PurchaseOrder())->getTable();
        $dbr = (new HistoryDataBreakdown())->getTable();

        if (is_null($dta) && is_null($dtb) && $request->filled('datea') && $request->filled('dateb')) {
            $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
            $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();
            $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
            $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();
        }

        $rawQuery = HistoryDataBreakdown::query()
            ->join($po, "$po.idpo", '=', "$dbr.idpo")
            ->where("$dbr.production_status", "IH");

        if ($dta && $dtb) {
            $rawQuery->whereBetween("$dbr.deliverydate", array($dta, $dtb));
        }

        if ($request->filled('groupbuyer') && $request->groupbuyer !== 'all') {
            $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');
            $rawQuery->whereIn("$po.idbuyer", $buyerIds);
        }
        if ($applyPoFilter && $request->filled('po') && $request->po !== 'all') {
            $rawQuery->where("$dbr.idpo", $request->po);
        }
        if ($request->filled('style') && $request->style !== 'all') {
            $rawQuery->where("$po.idstyle", $request->style);
        }

        $rawRows = $rawQuery->select(
            "$dbr.idpo", "$dbr.idcolor", "$dbr.qty_ori", "$dbr.kp_item",
            "$dbr.kp_item_ref", "$dbr.revisi_kp", "$dbr.deliverydate",
            "$dbr.$familyColumn as family_key",
            "$po.po", "$po.idbuyer", "$po.idstyle"
        )->get();

        // dedup: per (idpo, idcolor, kp_item) ambil baris dengan revisi_kp terbesar
        $deduped = $rawRows
            ->groupBy(function ($r) {
                return $r->idpo . '|' . $r->idcolor . '|' . $r->kp_item;
            })
            ->map(function ($group) {
                return $group->sortByDesc('revisi_kp')->first();
            })
            ->values();

        // kumpulkan semua kp_item_ref yang pernah dipakai per family
        $refByFamily = $deduped
            ->filter(function ($r) {
                return !is_null($r->kp_item_ref);
            })
            ->groupBy('family_key')
            ->map(function ($group) {
                return $group->pluck('kp_item_ref')->unique()->values();
            });

        // leaf = kp_item yang TIDAK pernah dirujuk oleh kp_item lain di family yang sama
        $leafRows = $deduped->filter(function ($row) use ($refByFamily) {
            $refs = $refByFamily->get($row->family_key);
            return !($refs && $refs->contains($row->kp_item));
        })->values();

        return $leafRows;
    }

    function summaryFilter(Request $request)
    {
        preconnect(session('db'));

        $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
        $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

        $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
        $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

        $fi  = (new OutputDetailFinalInspection())->getTable();
        $od  = (new OutputDetail())->getTable();
        $po  = (new PurchaseOrder())->getTable();
        $dbr = (new HistoryDataBreakdown())->getTable();

        $applyCommonFilters = function ($query) use ($request, $po, $od) {
            if ($request->filled('groupbuyer') && $request->groupbuyer !== 'all') {
                $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');
                $query->whereIn("$po.idbuyer", $buyerIds);
            }
            if ($request->filled('po') && $request->po !== 'all') {
                $query->where("$od.idpo", $request->po);
            }
            if ($request->filled('style') && $request->style !== 'all') {
                $query->where("$po.idstyle", $request->style);
            }
            return $query;
        };

        // PO dikecualikan kalau ada minimal satu barcode di PO itu yang sudah is_output = 1
        $excludeIfAnyFinal = function ($query) use ($fi, $od) {
            $query->whereNotExists(function ($q) use ($fi, $od) {
                $q->select(DB::raw(1))
                    ->from("$fi as fi2")
                    ->join("$od as od2", "od2.barcode", '=', 'fi2.barcode')
                    ->whereColumn('od2.idpo', "$od.idpo")
                    ->where('fi2.is_output', 1);
            });
            return $query;
        };

        // ===== Header / Total PO (pakai is_cutoff, TIDAK DIUBAH sesuai instruksi) =====
        $headerQuery = OutputDetailFinalInspection::query()
            ->join($od, "$od.barcode", '=', "$fi.barcode")
            ->join($po, "$po.idpo", '=', "$od.idpo")
            ->whereExists(function ($query) use ($dbr, $od, $dta, $dtb) {
                $query->select(DB::raw(1))
                    ->from($dbr)
                    ->whereColumn("$dbr.idpo", "$od.idpo")
                    ->whereBetween("$dbr.deliverydate", array($dta, $dtb))
                    ->where("$dbr.is_cutoff", "1")
                    ->where("$dbr.production_status", "IH");
            });

        $applyCommonFilters($headerQuery);

        $leafRows = $this->getLeafHistoryRows($request, $dta, $dtb, 'combine_pro', true);
        $leafPoIds = $leafRows->pluck('idpo')->unique()->values();

        $poIds = (clone $headerQuery)
            ->select("$od.idpo")
            ->distinct()
            ->pluck("$od.idpo");

        $totalPo = $leafPoIds->count();

        $totalQty = HistoryDataBreakdown::whereIn('idpo', $poIds)
            ->where('is_cutoff', '1')
            ->sum('qty_ori');

        $totalQtyInspect = (clone $headerQuery)
            ->whereNotNull("$fi.date_output")
            ->count(DB::raw("DISTINCT $fi.id"));

        // ===== PO Need Final: today s/d dtb =====
        $today = Carbon::today()->startOfDay();

        $needFinalFrom = $today->copy();
        $needFinalTo   = $dtb->copy();

        if ($needFinalFrom->lessThanOrEqualTo($needFinalTo)) {

            $needFinalQuery = OutputDetailFinalInspection::query()
                ->join($od, "$od.barcode", '=', "$fi.barcode")
                ->join($po, "$po.idpo", '=', "$od.idpo")
                ->whereExists(function ($query) use ($dbr, $od, $needFinalFrom, $needFinalTo) {
                    $query->select(DB::raw(1))
                        ->from($dbr)
                        ->whereColumn("$dbr.idpo", "$od.idpo")
                        ->whereBetween("$dbr.deliverydate", array($needFinalFrom, $needFinalTo))
                        ->where("$dbr.production_status", "IH");
                });

            $excludeIfAnyFinal($needFinalQuery);
            $applyCommonFilters($needFinalQuery);

            // idpo mentah yang lolos kondisi need-final (sebelum dikoreksi reroute)
            $needFinalIdpoRaw = $needFinalQuery
                ->select("$po.idpo")
                ->distinct()
                ->pluck("$po.idpo");

            // koreksi pakai leaf-detection: ambil idpo aktif dalam range yang sama,
            // lalu irisan dengan idpo yang lolos kondisi need-final di atas.
            $leafRowsNeedFinal = $this->getLeafHistoryRows($request, $needFinalFrom, $needFinalTo, 'combine_pro', true);
            $leafIdpoNeedFinal = $leafRowsNeedFinal->pluck('idpo')->unique()->values();

            // family (combine_pro) mana saja yang tersentuh oleh idpo mentah di atas
            $familyByIdpo = $leafRowsNeedFinal->groupBy('idpo')->map(function ($g) {
                return $g->first()->family_key;
            });

            $touchedFamilies = collect();
            foreach ($needFinalIdpoRaw as $idpoRaw) {
                if ($familyByIdpo->has($idpoRaw)) {
                    $touchedFamilies->push($familyByIdpo->get($idpoRaw));
                }
            }
            $touchedFamilies = $touchedFamilies->unique()->values();

            // idpo aktif (leaf) yang keluarganya tersentuh -> ini hasil final yang benar
            $finalPOList = $leafRowsNeedFinal
                ->filter(function ($row) use ($touchedFamilies) {
                    return $touchedFamilies->contains($row->family_key);
                })
                ->pluck('idpo')
                ->unique()
                ->values();

            $poNeedFinal = $finalPOList->count();
        } else {
            $poNeedFinal = 0;
        }

        // ===== Overdue: today-7 s/d today =====
        $overdueFrom = $today->copy()->subDays(7)->startOfDay();
        $overdueTo   = $today->copy()->endOfDay();

        $overdueQuery = OutputDetailFinalInspection::query()
            ->join($od, "$od.barcode", '=', "$fi.barcode")
            ->join($po, "$po.idpo", '=', "$od.idpo")
            ->whereExists(function ($query) use ($dbr, $od, $overdueFrom, $overdueTo) {
                $query->select(DB::raw(1))
                    ->from($dbr)
                    ->whereColumn("$dbr.idpo", "$od.idpo")
                    ->whereBetween("$dbr.deliverydate", array($overdueFrom, $overdueTo))
                    ->where("$dbr.is_cutoff", "1")
                    ->where("$dbr.production_status", "IH");
            });

        $excludeIfAnyFinal($overdueQuery);
        $applyCommonFilters($overdueQuery);

        $overdueIdpoRaw = $overdueQuery
            ->select("$po.idpo")
            ->distinct()
            ->pluck("$po.idpo");

        $leafRowsOverdue = $this->getLeafHistoryRows($request, $overdueFrom, $overdueTo, 'combine_pro', true);

        $familyByIdpoOverdue = $leafRowsOverdue->groupBy('idpo')->map(function ($g) {
            return $g->first()->family_key;
        });

        $touchedFamiliesOverdue = collect();
        foreach ($overdueIdpoRaw as $idpoRaw) {
            if ($familyByIdpoOverdue->has($idpoRaw)) {
                $touchedFamiliesOverdue->push($familyByIdpoOverdue->get($idpoRaw));
            }
        }
        $touchedFamiliesOverdue = $touchedFamiliesOverdue->unique()->values();

        $finalOverduePOs = $leafRowsOverdue
            ->filter(function ($row) use ($touchedFamiliesOverdue) {
                return $touchedFamiliesOverdue->contains($row->family_key);
            })
            ->pluck('idpo')
            ->unique()
            ->values();

        $overdue = $finalOverduePOs->count();

        // ===== Final Completed: PO dengan is_output = 1, dalam range asli (dta - dtb) =====
        $finalCom = (clone $headerQuery)
            ->where("$fi.is_output", 1)
            ->count(DB::raw("DISTINCT $po.po"));

        // ===== OQL =====
        $totDefect = (clone $headerQuery)
            ->whereNotNull("$fi.date_output")
            ->whereNotNull("$fi.defect_code")
            ->count(DB::raw("DISTINCT $fi.id"));

        $oql = $totalQtyInspect > 0 ? round(($totDefect / $totalQtyInspect) * 100, 2) : 0;

        // ===== Passing / Reject Rate =====
        $poNoDefect = (clone $headerQuery)
            ->whereNotNull("$fi.date_output")
            ->whereNull("$fi.defect_code")
            ->count(DB::raw("DISTINCT $fi.id"));

        $poWithDefect = (clone $headerQuery)
            ->whereNotNull("$fi.date_output")
            ->whereNotNull("$fi.defect_code")
            ->count(DB::raw("DISTINCT $fi.id"));

        $passingRate = $totalPo > 0 ? round(($poNoDefect / $totalPo) * 100, 2) : 0;
        $rejectRate  = $totalPo > 0 ? round(($poWithDefect / $totalPo) * 100, 2) : 0;

        return response()->json(array(
            'total_po'          => $totalPo,
            'total_qty'         => $totalQty,
            'total_qty_inspect' => $totalQtyInspect,
            'po_need_final'     => $poNeedFinal,
            'overdue'           => $overdue,
            'final_completed'   => $finalCom,
            'oql'               => $oql,
            'passing_rate'      => $passingRate,
            'reject_rate'       => $rejectRate,
        ));
    }

    function priorityFinal(Request $request)
    {
        preconnect(session('db'));

        $fi  = (new OutputDetailFinalInspection())->getTable();
        $od  = (new OutputDetail())->getTable();
        $po  = (new PurchaseOrder())->getTable();
        $dbr = (new HistoryDataBreakdown())->getTable();
        $so  = (new SewingOutput())->getTable();

        // LEAF ROWS (qty & list PO)
        $leafRows = $this->getLeafHistoryRows($request, null, null, 'combine_pro', true);

        $byIdpoLeaf = $leafRows->groupBy('idpo');

        $qtyPerIdpo = array();
        $etdPerIdpo = array();
        foreach ($byIdpoLeaf as $idpo => $rows) {
            $qtyPerIdpo[$idpo] = (int) $rows->sum('qty_ori');
            $etdPerIdpo[$idpo] = $rows->max('deliverydate');
        }

        $qualifiedIdpo = collect($qtyPerIdpo)->filter(function ($qty) {
            return $qty > 0;
        })->keys()->values();

        $effectiveIdpoSql = function () use ($dbr) {
            return "(CASE WHEN $dbr.revisi_kp = 1 AND $dbr.kp_item_ref IS NOT NULL
                THEN (SELECT dbr_prev.idpo FROM $dbr as dbr_prev
                    WHERE dbr_prev.combine_pro = $dbr.combine_pro
                        AND dbr_prev.idpo < $dbr.idpo
                    ORDER BY dbr_prev.idpo DESC LIMIT 1)
                ELSE $dbr.idpo END)";
        };

        $requireHasFinalRecord = function ($query) use ($fi, $od, $effectiveIdpoSql) {
            $expr = $effectiveIdpoSql();
            $query->whereExists(function ($q) use ($fi, $od, $expr) {
                $q->select(DB::raw(1))
                    ->from("$fi as fi3")
                    ->join("$od as od3", "od3.barcode", '=', 'fi3.barcode')
                    ->whereRaw("od3.idpo = $expr");
            });
            return $query;
        };

        $excludeIfAnyFinal = function ($query) use ($fi, $od, $effectiveIdpoSql) {
            $expr = $effectiveIdpoSql();
            $query->whereNotExists(function ($q) use ($fi, $od, $expr) {
                $q->select(DB::raw(1))
                    ->from("$fi as fi2")
                    ->join("$od as od2", "od2.barcode", '=', 'fi2.barcode')
                    ->whereRaw("od2.idpo = $expr")
                    ->where('fi2.is_output', 1);
            });
            return $query;
        };

        $finalCheckQuery = HistoryDataBreakdown::query()
            ->join($po, "$po.idpo", '=', "$dbr.idpo")
            ->whereIn("$dbr.idpo", $qualifiedIdpo);

        $requireHasFinalRecord($finalCheckQuery);
        $excludeIfAnyFinal($finalCheckQuery);

        $finalIdpoList = $finalCheckQuery->select("$dbr.idpo")->distinct()->pluck('idpo');

        $poList = $finalIdpoList->map(function ($idpo) use ($byIdpoLeaf) {
            $rows = $byIdpoLeaf->get($idpo);
            $first = $rows->first();
            return (object) array(
                'idpo' => $idpo, 'po' => $first->po, 'idbuyer' => $first->idbuyer,
                'idstyle' => $first->idstyle, 'idcolor' => $first->idcolor,
            );
        });

        $idpoList = $poList->pluck('idpo')->unique()->values();

        $buyerIds = $poList->pluck('idbuyer')->filter()->unique()->values();
        $buyerGroupMap = Buyer::whereIn('idbuyer', $buyerIds)->pluck('groupbuyer', 'idbuyer');
        $groupBuyerIds = $buyerGroupMap->filter()->unique()->values();
        $groupBuyerNames = MasterGroupBuyer::whereIn('id', $groupBuyerIds)->pluck('group_name', 'id');
        $styleIds = $poList->pluck('idstyle')->filter()->unique()->values();
        $styleMap = Style::whereIn('idstyle', $styleIds)->pluck('nmstyle', 'idstyle');
        $colorIds = $poList->pluck('idcolor')->filter()->unique()->values();
        $colorMap = Color::whereIn('idcolor', $colorIds)->pluck('nmcolor', 'idcolor');

        // OUTPUT murni per idpo sendiri, TANPA rollup
        $outputRows = OutputDetail::query()
            ->join("$so as so_out", 'so_out.barcode', '=', "$od.barcode")
            ->whereIn("$od.idpo", $idpoList)
            ->where('so_out.is_output', 1)
            ->selectRaw("$od.idpo as idpo, COUNT(DISTINCT so_out.barcode) as total_output")
            ->groupBy("$od.idpo")
            ->get()
            ->keyBy('idpo');

        $today = Carbon::today()->startOfDay();

        $data = $poList->map(function ($item) use (
            $buyerGroupMap, $groupBuyerNames, $styleMap, $colorMap,
            $qtyPerIdpo, $etdPerIdpo, $outputRows, $today
        ) {
            $groupBuyerId = $buyerGroupMap->get($item->idbuyer);
            $outputRow = $outputRows->get($item->idpo);

            $etd = isset($etdPerIdpo[$item->idpo]) ? $etdPerIdpo[$item->idpo] : null;
            $daysToEtd = null;
            if ($etd) {
                $daysToEtd = $today->diffInDays(Carbon::parse($etd)->startOfDay(), false);
            }

            $totalQty = isset($qtyPerIdpo[$item->idpo]) ? (int) $qtyPerIdpo[$item->idpo] : 0;
            $totalOutput = $outputRow ? (int) $outputRow->total_output : 0;
            $progressOutput = $totalQty > 0 ? round(($totalOutput / $totalQty) * 100, 2) : 0;

            return array(
                'idpo' => $item->idpo, 'po' => $item->po,
                'style' => $styleMap->get($item->idstyle) ? $styleMap->get($item->idstyle) : '-',
                'color' => $colorMap->get($item->idcolor) ? $colorMap->get($item->idcolor) : '-',
                'buyer' => $groupBuyerId ? ($groupBuyerNames->get($groupBuyerId) ? $groupBuyerNames->get($groupBuyerId) : '-') : '-',
                'qty_order' => $totalQty,
                'output' => $totalOutput,
                'progress_output' => $progressOutput,
                'etd' => $etd ? Carbon::parse($etd)->format('d-m-Y') : '-',
                'days_to_etd' => $daysToEtd,
            );
        })->values();

        $totalQtyOrderAll = $data->sum('qty_order');
        $totalOutputAll   = $data->sum('output');
        $totalProgressOutputAll = $totalQtyOrderAll > 0
            ? round(($totalOutputAll / $totalQtyOrderAll) * 100, 2) : 0;

        return response()->json(array(
            'data'  => $data,
            'total' => array(
