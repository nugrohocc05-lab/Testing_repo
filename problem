// Top Defect (exclude id 1 = no defect)
$topDefect = InlineDetail::whereIn('inline_header_id', $headerIds)
    ->where('defect_id', '!=', 1)
    ->select('defect_id', DB::raw('count(*) as total'))
    ->groupBy('defect_id')
    ->orderByDesc('total')
    ->limit(3)
    ->get();

$defectIds = $topDefect->pluck('defect_id');

$masterDefects = MasterInlineDefect::whereIn('id', $defectIds)
    ->pluck('nmdefect', 'id');

$topDefect = $topDefect->map(function ($item) use ($masterDefects) {
    return [
        'defect_id' => $item->defect_id,
        'nmdefect'  => $masterDefects[$item->defect_id] ?? '-',
        'total'     => $item->total,
    ];
});