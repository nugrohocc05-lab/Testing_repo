
    const dateOpt = {
        dateFormat: "d-m-Y",
        altInput: true,
        altFormat: "d F Y",
        allowInput: false,
        monthSelectorType: "static",
        disableMobile: true,
        defaultDate: "today",
        onChange: function () {
            checkDateSelection();
        }
    };
    flatpickr("#datea", dateOpt);
    flatpickr("#dateb", dateOpt);

    $('#groupbuyer').select2({ /* ...tetap sama... */ });
    $('#selectpo').select2({ /* ...tetap sama, tapi tambahkan datea/dateb di data:... */ });
    $('#selectstyle').select2({ /* ...tetap sama, tambahkan datea/dateb juga... */ });

    // semua disabled dari awal (select2 butuh trigger ulang agar UI ikut disabled)
    $('#groupbuyer').prop('disabled', true).trigger('change.select2');
    $('#selectpo').prop('disabled', true).trigger('change.select2');
    $('#selectstyle').prop('disabled', true).trigger('change.select2');

    function parseDMY(str) {
        const [d, m, y] = str.split('-');
        return new Date(`${y}-${m}-${d}`);
    }

    function checkDateSelection() {
        let datea = $('#datea').val();
        let dateb = $('#dateb').val();

        // reset semua step berikutnya setiap kali tanggal berubah
        $('#groupbuyer').val(null).trigger('change');
        $('#selectpo').val(null).trigger('change');
        $('#selectstyle').val(null).trigger('change');

        if (!datea || !dateb) {
            $('#groupbuyer').prop('disabled', true);
            return;
        }

        const start = parseDMY(datea);
        const end = parseDMY(dateb);

        if (start > end) {
            swal('Warning!', 'Start date cannot be later than end date!', 'warning');
            $('#groupbuyer').prop('disabled', true);
            return;
        }

        const diffDays = (end - start) / (1000 * 60 * 60 * 24);
        if (diffDays > 31) {
            swal('Warning!', 'Date Has More Than 31 Days in Range, Cannot View Data.', 'warning');
            $('#groupbuyer').prop('disabled', true);
            return;
        }

        // tanggal valid -> baru boleh pilih Group Buyer
        $('#groupbuyer').prop('disabled', false);
    }

    $('#groupbuyer').on('change', function () {
        let buyer = $(this).val();
        $('#selectpo').val(null).trigger('change');
        $('#selectstyle').val(null).trigger('change');
        $('#selectpo').prop('disabled', !buyer);
        $('#selectstyle').prop('disabled', true);
    });

    $('#selectpo').on('change', function () {
        let po = $(this).val();
        $('#selectstyle').val(null).trigger('change');
        $('#selectstyle').prop('disabled', !po);
    });
    



private function getFilteredIdpo(Request $request)
{
    $fi = OutputDetailFinalInspection::select('barcode')->distinct()->pluck('barcode');

    $query = OutputDetail::whereIn('barcode', $fi)
        ->where('is_final_inspection', 1);

    if ($request->filled('datea') && $request->filled('dateb')) {
        $start = \Carbon\Carbon::createFromFormat('d-m-Y', $request->datea)->format('Y-m-d');
        $end = \Carbon\Carbon::createFromFormat('d-m-Y', $request->dateb)->format('Y-m-d');
        $query->whereBetween('etd', [$start, $end]); // sesuaikan kolom ETD
    }

    return $query->distinct()->pluck('idpo');
}

function groupbuyer(Request $request)
{
    preconnect(session('db'));

    $q = $request->get('q');
    $page = (int) $request->get('page', 1);

    $idpo = $this->getFilteredIdpo($request);
    $idbuyer = PurchaseOrder::whereIn('idpo', $idpo)->distinct()->pluck('idbuyer');
    $groupIds = Buyer::whereIn('idbuyer', $idbuyer)->distinct()->pluck('groupbuyer');

    $paginator = MasterGroupBuyer::select('id', 'group_name')
        ->whereIn('id', $groupIds)
        ->when($q, function ($query) use ($q) {
            $query->where('group_name', 'like', '%' . $q . '%');
        })
        ->orderBy('group_name', 'asc')
        ->paginate($this->perPage, ['id', 'group_name'], 'page', $page);

    $data = collect($paginator->items())->map(function ($item) {
        return ['id' => $item->id, 'text' => $item->group_name];
    });

    return response()->json([
        'results' => $data,
        'pagination' => ['more' => $paginator->hasMorePages()]
    ]);
}

function poSelect(Request $request)
{
    preconnect(session('db'));

    $page = (int) $request->get('page', 1);
    $idpo = $this->getFilteredIdpo($request);

    $query = PurchaseOrder::whereIn('idpo', $idpo);

    if ($request->filled('groupbuyer') && $request->groupbuyer !== 'all') {
        $buyer = Buyer::where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');
        $query->whereIn('idbuyer', $buyer);
    }

    if ($request->filled('q')) {
        $query->where('po', 'like', '%' . $request->q . '%');
    }

    $paginator = $query->select('idpo', 'po')->distinct()
        ->paginate($this->perPage, ['idpo', 'po'], 'page', $page);

    $po = collect($paginator->items());

    return response()->json([
        'results' => $po->map(fn($item) => ['id' => $item->idpo, 'text' => $item->po])->values(),
        'pagination' => ['more' => $paginator->hasMorePages()]
    ]);
}

function styleSelect(Request $request)
{
    preconnect(session('db'));

    $page = (int) $request->get('page', 1);
    $idpo = $this->getFilteredIdpo($request);

    $query = PurchaseOrder::whereIn('idpo', $idpo);

    if ($request->filled('selectpo') && $request->selectpo !== 'all') {
        $query->where('idpo', $request->selectpo);
    }

    if ($request->filled('q')) {
        $query->where('idstyle', 'like', '%' . $request->q . '%');
    }

    $style = $query->select('idstyle')->distinct()->pluck('idstyle');

    $paginator = Style::whereIn('idstyle', $style)
        ->select('idstyle', 'nmstyle')
        ->paginate($this->perPage, ['idstyle', 'nmstyle'], 'page', $page);

    $styles = collect($paginator->items());

    return response()->json([
        'results' => $styles->map(fn($item) => ['id' => $item->idstyle, 'text' => $item->nmstyle])->values(),
        'pagination' => ['more' => $paginator->hasMorePages()]
    ]);
}

