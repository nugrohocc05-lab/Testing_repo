// ==== Helper: hitung range tanggal dari week_id (dipakai juga oleh getWeeklyData) ====
private function weekRange($year, int $weekNumber): array
{
    $dta = Carbon::createFromDate($year, 1, 1)->startOfDay()->addDays(($weekNumber - 1) * 7);
    $dtb = $dta->copy()->addDays(6)->endOfDay();

    $endOfYear = Carbon::createFromDate($year, 12, 31)->endOfDay();
    if ($dtb->gt($endOfYear)) {
        $dtb = $endOfYear->copy();
    }

    return [$dta, $dtb];
}

// ==== Ambil daftar defect yang tersedia untuk populate chip filter (dinamis, bukan hardcode) ====
public function getDefectChartOptions(Request $request)
{
    preconnect(session('db'));

    if ($request->mode === 'day') {
        $date = $request->date ? Carbon::parse($request->date) : Carbon::now();
        $headerQuery = SewingOutput::whereDate('date', $date);
    } else {
        [$year, $weekNumber] = explode('-', $request->week_id);
        [$dta, $dtb] = $this->weekRange($year, (int) $weekNumber);
        $headerQuery = SewingOutput::whereBetween('date', [$dta, $dtb]);
    }

    $headerIds = $headerQuery->pluck('id');

    $defectCodes = SewingOutput::whereIn('id', $headerIds)
        ->whereNotNull('defect_code')
        ->whereNotIn('defect_code', [800, 900])
        ->select('defect_code', DB::raw('COUNT(*) as total'))
        ->groupBy('defect_code')
        ->orderByDesc('total')
        ->limit(10) // batasi biar chip filter gak kebanjiran
        ->pluck('total', 'defect_code');

    $names = QCDefect::whereIn('kdcacat', $defectCodes->keys())
        ->pluck('deskripsi', 'kdcacat');

    $options = $defectCodes->keys()->map(function ($code) use ($names) {
        return [
            'code' => (string) $code,
            'name' => $names[$code] ?? '-',
        ];
    })->values();

    return response()->json(['options' => $options]);
}

// ==== Data chart (dipakai untuk mode weekly & day) ====
public function getDefectChartData(Request $request)
{
    preconnect(session('db'));

    $request->validate([
        'mode' => 'required|in:weekly,day',
    ]);

    $defectCodes = collect($request->input('defects', []))->map(fn ($c) => (int) $c);

    if ($request->mode === 'day') {
        $date = $request->date ? Carbon::parse($request->date) : Carbon::now();
        $buckets = $this->buildHourBuckets($date);
        $labelFormat = 'H:i';
    } else {
        $request->validate(['week_id' => 'required|string']);
        [$year, $weekNumber] = explode('-', $request->week_id);
        [$dta, $dtb] = $this->weekRange($year, (int) $weekNumber);
        $buckets = $this->buildDayBuckets($dta, $dtb);
        $labelFormat = 'd M';
    }

    // Kalau defect belum dipilih user, default ambil top 3 defect di periode ini
    if ($defectCodes->isEmpty()) {
        $allIds = collect($buckets)->flatMap(fn ($b) => $b['ids']);
        $defectCodes = SewingOutput::whereIn('id', $allIds)
            ->whereNotNull('defect_code')
            ->whereNotIn('defect_code', [800, 900])
            ->select('defect_code', DB::raw('COUNT(*) as total'))
            ->groupBy('defect_code')
            ->orderByDesc('total')
            ->limit(3)
            ->pluck('defect_code');
    }

    $names = QCDefect::whereIn('kdcacat', $defectCodes)->pluck('deskripsi', 'kdcacat');

    $colors = ['#1B4FE0', '#F4977B', '#36B37E', '#FFAB00', '#8777D9', '#00B8D9', '#F24C4C', '#29B1AE'];

    $labels = [];
    $seriesData = $defectCodes->mapWithKeys(fn ($c) => [$c => []]);

    foreach ($buckets as $bucket) {
        $labels[] = $bucket['label'];
        $inspectQty = count($bucket['ids']);

        $defectQtyPerCode = SewingOutput::whereIn('id', $bucket['ids'])
            ->whereIn('defect_code', $defectCodes)
            ->select('defect_code', DB::raw('COUNT(*) as total'))
            ->groupBy('defect_code')
            ->pluck('total', 'defect_code');

        foreach ($defectCodes as $code) {
            $qty = $defectQtyPerCode[$code] ?? 0;
            $wft = $inspectQty > 0 ? round(($qty / $inspectQty) * 100, 2) : 0;
            $seriesData[$code][] = $wft;
        }
    }

    $series = $defectCodes->values()->map(function ($code, $i) use ($seriesData, $names, $colors) {
        return [
            'code'  => (string) $code,
            'name'  => $names[$code] ?? '-',
            'color' => $colors[$i % count($colors)],
            'data'  => $seriesData[$code],
        ];
    });

    return response()->json(['labels' => $labels, 'series' => $series]);
}

private function buildDayBuckets(Carbon $dta, Carbon $dtb): array
{
    $buckets = [];
    $cursor = $dta->copy();

    while ($cursor->lte($dtb)) {
        $ids = SewingOutput::whereDate('date', $cursor)->pluck('id');
        $buckets[] = ['label' => $cursor->format('d M'), 'ids' => $ids];
        $cursor->addDay();
    }

    return $buckets;
}

private function buildHourBuckets(Carbon $date): array
{
    $rows = SewingOutput::whereDate('date', $date)
        ->select('id', DB::raw('HOUR(created_at) as hh'))
        ->get()
        ->groupBy('hh');

    $buckets = [];
    foreach (range(0, 23) as $h) {
        if (!isset($rows[$h])) continue; // skip jam yang gak ada aktivitas sama sekali
        $buckets[] = [
            'label' => sprintf('%02d:00', $h),
            'ids'   => $rows[$h]->pluck('id'),
        ];
    }

    return $buckets;
}
