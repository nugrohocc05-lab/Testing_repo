@media (min-width: 992px) and (max-width: 1400px) {
    /* Table */
    .table-wrapper {
        max-height: 140px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .table-res {
        font-size: 10px !important;
    }

    .subheader {
        font-size: 15px;
    }

    /* Header */
    .datatable-header-left h5 {
        font-size: 12px !important;
        line-height: 1.2;
    }

    .detailIcon {
        width: 18px !important;
        height: 18px !important;
    }

    .export-icon {
        width: 18px !important;
        height: 18px !important;
    }

    /* Toggle weekly/day */
    .toggle-wrapper {
        display: inline-flex;
        background-color: #212B3E;
        border-radius: 8px;
        gap: 0;
        overflow: hidden;
    }

    .toggle-btn {
        min-width: 50px;
        padding: 3px 8px;
        font-size: 11px;
        text-align: center;
        color: #fff;
        background-color: transparent;
        cursor: pointer;
        font-weight: 400;
        transition: all 0.2s ease;
        margin: 0;
    }

    /* Filter defect */
    .filter-label {
        font-size: 11px;
    }

    .filter-chip {
        font-size: 11px;
        padding: 2px 8px;
        gap: 4px;
    }

    .filter-chip .chip-remove {
        font-size: 10px;
    }

    .add-filter-btn {
        width: 22px;
        height: 22px;
        font-size: 13px;
        line-height: 22px;
    }

    .filter-dropdown {
        width: 220px;
        max-height: 180px;
        padding: 8px;
    }

    .filter-option-pill {
        font-size: 11px;
        padding: 3px 9px;
    }

    .btn-find {
        font-size: 11px;
        padding: 3px 10px;
    }

    .defect-filter-container {
        gap: 8px;
    }

    .defect-filter {
        gap: 6px;
    }

    #selectedChips {
        gap: 6px;
    }

    /* Chart */
    .chart-wrapper {
        min-height: 160px;
        padding: 10px;
    }

    #defectChart {
        min-height: 160px;
    }
}