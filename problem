            return $op['nama'] ?? $op['nik'];
        })->toArray();

        $roundRows = collect($result['rounds'])->map(function ($round) use ($statusLabel) {
            $row = ['Round ' . $round['round']];
            foreach ($round['cells'] as $cell) {
                $row[] = $statusLabel[$cell['status']] ?? '-';
            }
            return $row;
        })->toArray();

        return response()->json([
            'namaline'      => $namaline,
            'date'          => $request->date ?? Carbon::now()->format('Y-m-d'),
            'tot_inspect'   => $result['tot_inspect'],
            'tot_defect'    => $result['tot_defect'],
            'rft'           => $result['rft'],
            'wft'           => $result['wft'],
            'operator_names'=> $operatorNames,
            'round_rows'    => $roundRows,
        ]);
    }
}
