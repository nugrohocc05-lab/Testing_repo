    function buildInlineOptData($lineId)
    {
        preconnect(session('db'));

        $date = Carbon::now();
        $line = MasterEmployeeGroup::select('id as kodegroup', 'name as namagroup')
            ->find($lineId);

        $worktimeline = WorktimeSettingController::getLineWorkingTime($line, $date);
        $worktime = $worktimeline->workingtime;

        $get_worktimeline = WorktimeSettingController::get_worktime_range($worktimeline, $worktime);
        $swt = $get_worktimeline->startworktime;
        $fwt = $get_worktimeline->finishworktime;

        if ($swt->greaterThan($fwt)) {
            $fwt->addDay();
        }

        $sto = Carbon::parse($worktimeline->date . ' ' . $worktime->starttimeoff);
        $fto = Carbon::parse($worktimeline->date . ' ' . $worktime->endtimeoff);
        if ($sto->greaterThan($fto)) {
            $fto->addDay();
        }

        $sto2 = null;
        $fto2 = null;

        if ($worktime->startsecondtimeoff) {
            $sto2 = Carbon::parse($worktimeline->date . ' ' . $worktime->startsecondtimeoff);
            $fto2 = Carbon::parse($worktimeline->date . ' ' . $worktime->endsecondtimeoff);
            if ($sto2->greaterThan($fto2)) {
                $fto2->addDay();
            }
        }

        $totalworktime = $date->diffInMinutes($swt);

        if ($date->greaterThan($sto)) {
            if ($date->greaterThan($fto)) {
                $timeoff = $sto->diffInMinutes($fto);
                $totalworktime -= $timeoff;
            } else {
                $timeoff_diff = $sto->diffInMinutes($date);
                $totalworktime -= $timeoff_diff;
            }
        }

        if ($sto2) {
            if ($date->greaterThan($sto2)) {
                if ($date->greaterThan($fto2)) {
                    $timeoff = $sto2->diffInMinutes($fto2);
                    $totalworktime -= $timeoff;
                } else {
                    $timeoff_diff = $sto2->diffInMinutes($date);
                    $totalworktime -= $timeoff_diff;
                }
            }
        }

        $totaloutput = 0;
        $totalefficiency = 0;
        $totalrft = 0;
        $totalwft = 0;
        $percentrft = 0;
        $percentwft = 0;

        try {
            $idmps = MpsDetail::select('idmps')
                ->distinct()
                ->where('date', $swt->format('Y-m-d'))
                ->whereHas('header', function ($q) use ($lineId) {
                    $q->where('line', $lineId);
                })
                ->get();

            $mps_header = MpsHeader::whereIn('id', $idmps->pluck('idmps'))
                ->orderBy('lastoutput', 'desc')
                ->first();

            $mps_detail = MpsDetail::where('idmps', $mps_header->id)
                ->where('date', $swt->format('Y-m-d'))
                ->first();

            $m_kpno = $mps_header->kpno;
        } catch (\Exception $e) {
            $m_kpno = null;
        }

        $out = SewingOutput::whereBetween('date', [$swt, $fwt])
            ->where('line', $lineId)
            ->where('is_output', 1)
            ->groupBy('barcode')
            ->get();

        $totaloutput = $out->count();

        $firstScanneds = SewingOutput::select('barcode', 'defect_code')
            ->whereBetween('date', [$swt, $fwt])
            ->where('line', $lineId)
            ->where('qc_seq', 0)
            ->groupBy('barcode')
            ->get();

        $totalrft = $firstScanneds->where('defect_code', null)->count();
        $totalwft = $firstScanneds->count() - $totalrft;

        if ($firstScanneds->count() > 0) {
            $percentrft = number_format(($totalrft / $firstScanneds->count()) * 100, 2, '.', '');
            $percentwft = number_format(($totalwft / $firstScanneds->count()) * 100, 2, '.', '');
        }

        $po = PurchaseOrder::select('idstyle')->where('kpno', $m_kpno)->first();
        $style = $po ? Style::find($po->idstyle) : null;

        try {
            $m_smv = SmvController::getSmv(
                $style->idstyle,
                $mps_header->order_step_id,
                $mps_detail->order_part_id,
                $mps_detail->sub_style_id,
            );
            $smv = $m_smv->smv;
        } catch (\Exception $e) {
            $smv = 0;
        }

        $start_mp_time = Carbon::parse($swt->format('Y-m-d H:i:s'));

        $mp_line_param = ($lp = FactoryParameter::find('line_mapping_tolerance'))
            ? $lp->value * 1
            : 30;

        $fwt = Carbon::parse($fwt->format('Y-m-d H:i:s'));
        $start_mp_time->subMinute($mp_line_param);
        $fwt->addMinute($mp_line_param);

        $m_mp = EmployeeAttendance::select('nik', 'status')
            ->where('factory_id', session('db')->iddb)
            ->where('group_id', $lineId)
            ->where('is_efficiency', 1)
            ->where('shift', $worktime->shift)
            ->whereBetween('time', [$start_mp_time, $fwt])
            ->orderBy('time', 'desc')
            ->get();

        try {
            $mpminus = FactoryParameter::where('key', 'line_mpminus')->first();
            $mpminus = $mpminus ? $mpminus->value : -3;
            $m_mp = max(
                0,
                $m_mp->where('status', 'IN')->count() - $m_mp->where('status', 'OUT')->count() + $mpminus,
            );
        } catch (\Exception $e) {
            $m_mp = 0;
        }

        $totalefficiency = ($totaloutput > 0 && $smv > 0 && $m_mp > 0 && $totalworktime > 0)
            ? number_format((($totaloutput * $smv) / ($m_mp * $totalworktime)) * 100, 2, '.', '')
            : 0;

        $groupedinline = InlineHeader::with('detail')
            ->whereBetween('date', [$swt->format('Y-m-d H:i:s'), $fwt->format('Y-m-d H:i:s')])
            ->where('group_id', $lineId)
            ->orderBy('sequence_process')
            ->get()
            ->groupBy('userid_operator');

        $today_inline = InlineHeader::with('detail')
            ->whereBetween('date', [$swt->format('Y-m-d H:i:s'), $fwt->format('Y-m-d H:i:s')])
            ->where('group_id', $lineId)
            ->groupBy('userid_operator')
            ->orderBy('sequence_process')
            ->get();

        foreach ($today_inline as $d) {
            try {
                $m_hr_dk = Employee::where('nik', $d->userid_operator)->first();
                $d->nama = $m_hr_dk->name;
            } catch (\Exception $e) {
                $d->nama = null;
            }
        }

        return [
            'line'            => $line,
            'totaloutput'     => $totaloutput,
            'userinline'      => $groupedinline,
            'usertoday'       => $today_inline,
            'percentrft'      => $percentrft,
            'percentwft'      => $percentwft,
            'totalefficiency' => $totalefficiency,
        ];
    }

}


