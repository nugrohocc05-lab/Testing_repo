                    </button>
                    <button class="export-btn bg-transparent border-0 p-0">
                        <img src="{{ _asset('svg/inlinePerformance/export.svg') }}"
                            style="width:27px; height:27px;">
                        <span class="custom-tooltip">Export</span>
                    </button>
                </div>
            </div>

            <!-- Datatable Main -->
            <div class="table-responsive mt-3 table-scroll-area">
                <table id="tableInlinePerformance" class="table-custom table table-borderless align-middle w-100">
                    <thead>
                        <tr class="">
                            <th class="text-center">Line</th>
                            <th class="text-center">Style</th>
