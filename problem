    function processauth(Request $request)
    {
        try {
            $um = Employee::where('nik', $request->nik)->first();
            $_auth = ApprovalUser::where('factory_id', session('db')->iddb)
                ->where('userid_approval', $request->nik)
                ->where('approval_type', 'do_storage')
                ->first();

            if ($um and $_auth) {
                $access = Access::where('nik', $um->nik)
                    ->where('factory', session('db')->iddb)
                    ->where('is_web', '1')
                    ->first();

                if ($access) {
                    if (Hash::check($request->password, $um->password)) {
                        $borndate = $um->date_of_birth;
                        session(['authapprovalstorage_borndate' => $borndate]); 
                        return view('finishgoods::approvalstorage.moreauth');
                    }
                }
            }
        } catch (\Exception $e) {
            //
        }

        return redirect()
            ->route('approvalstorageauth')
            ->with('alert', [
                'title' => 'Unauthorized!',
                'message' => 'You Dont Have Any Access Here!',
                'status' => 'warning',
            ]);
    }

    function moreauth(Request $request)
    {
        if ($request->borndate == session('authapprovalstorage_borndate')) {
            session(['authapprovalstorage' => 'auth']);
            return redirect()->route('approvalstorageprint', [
                'gi'=>encrypt(session('approval_gi')),
                'do'=>session('approval_do'),
            ]);
        }
        return redirect()
            ->route('approvalstorageauth')
            ->with('alert', [
                'title' => 'Born Date Not Match!',
                'message' => 'Please Make Sure Your Born Date Is Match!',
                'status' => 'warning',
            ]);
    }

    function print($dgi, $do)
    {
        preconnect(session('db'));

        session(['approval_gi'=>decrypt($dgi)]);
        session(['approval_do'=>$do]);

        if(session('admin') != 'admin'){
            if (
                session('authapprovalstorage') != 'auth'
            ) {
                return redirect()
                    ->route('approvalstorageauth')
                    ->with('alert', [
                        'title' => 'Unauthorized!',
                        'message' => 'You need to do authorization first!',
                        'status' => 'warning',
                    ]);
            }
        }

        $gi = session('approval_gi') ?? decrypt($dgi);
        $do = session('approval_do') ?? $do;

        try {
            $sr = (new MainDOStock())->getTable();
            $ss = (new FGStorageStock())->getTable();

            $fgs = FGStorageStock::select(
                    "$ss.barcode", "$sr.masterbuyer_id", "$sr.season",
                    "$sr.userid_approve", "$sr.request_id", "$ss.delivery_order_out"
                )
                ->join($sr, "$sr.request_id", '=', "$ss.gi_number")
                ->whereNotNull("$sr.date_approve")
                ->where("$sr.is_lab", 0)
                ->where("$ss.factory_id", session('db')->iddb)
                ->where("$ss.gi_number", $gi)
                ->where("$ss.delivery_order_out", $do)
                ->groupBy("$ss.barcode")
                ->get();

            $header = $fgs->first();
            $header->destination = 'Packing';
            $header->hod = Employee::where('nik', $header->userid_approve)->first()->name ?? '';
            $header->factory_name = FactoryParameter::find('factory_name')->value ?? '';
            $header->factory_address = FactoryParameter::find('factory_address')->value ?? '';
            $header->factory_city = FactoryParameter::find('factory_city')->value ?? '';

            $od = (new OutputDetail())->getTable();
            $cpo = (new HistoryPO())->getTable();
            $data = OutputDetail::selectRaw("COUNT($od.barcode) as qty")
                ->addSelect(
                    "$cpo.idbuyer", "$cpo.idstyle", "$od.idcolor", "$od.idsize"
                )
                ->join(DB::raw("(SELECT idstyle, kpno, idpo, idbuyer FROM historypo GROUP BY kpno, idpo) AS $cpo"), function($q)use($cpo, $od){
                    $q->on("$cpo.kpno", '=', "$od.kpno")
                    ->on("$cpo.idpo", '=', "$od.idpo");
                })
                ->whereIn("$od.barcode", $fgs->pluck('barcode'))
                ->groupBy("$cpo.idstyle", "$od.idcolor", "$od.idsize")
                ->get();
    
            foreach ($data as $d) {
                $d->nmstyle = Style::find($d->idstyle)->nmstyle ?? '-';
                $d->nmcolor = Color::find($d->idcolor)->nmcolor ?? '-';
                $d->nmsize = Size::find($d->idsize)->nmsize ?? '-';
            }

            session(['authapprovalstorage' => false]);

            return view('finishgoods::approvalstorage.print', [
                'header' => $header,
                'data' => $data
            ]);
            
            
        } catch (\Throwable $e) {
            //
        }

        return redirect()
            ->route('approvalstorageauth')
            ->with('alert', [
                'title' => 'Unauthorized!',
                'message' => 'You Dont Have Any Access Here!',
                'status' => 'warning',
            ]);
    }

    function selectdo(Request $request){
        $gi = decrypt($request->gi);
        $data = FGStorageStock::select('delivery_order_out')
            ->distinct()
            ->where('gi_number', $gi);

        if ($request->q) {
            $data = $data->where('delivery_order_out', 'like', "%$request->q%");
        }

        $data = $data
            ->orderBy('delivery_order_out')
            ->paginate(10, $request->page);

        return response()->json($data);
    }

    function countnotif()
    {
        try {
            $data = MainDOStock::whereNull('date_approve')
            ->where('is_lab', 0)
            ->whereNull('is_approve');
            if (session('admin') != 'admin') {
                $data = $data
                    ->where('factory_id', session('db')->iddb)
                    ->where('userid_approve', session('user')->nik);
            }
            $data = $data->groupBy("request_id")->get();
            return response()->json($data->count());
        } catch (\Throwable $e) {
            return response()->json(false, 400);
        }
    }
