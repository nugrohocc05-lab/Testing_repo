<?php

namespace App\Http\Models;

use Illuminate\Database\Eloquent\Model;

class IntellocutLayermanEndbit extends Model
{
    protected $table = 'intellocut_layerman_endbits';
    protected $guarded = [];
    public $timestamps = false;

    public function shade()
    {
        return $this->belongsTo(IntellocutLayermanShade::class, 'idshade');
    }
}
