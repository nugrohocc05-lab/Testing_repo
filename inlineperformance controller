    function index(Request $request)
    {
        if ($this->myaccess() == '0') {
            return redirect()
                ->back()
                ->with('alert', [
                    'title' => 'Unauthorized!',
                    'message' => 'You Dont Have Any Access Here!',
                    'status' => 'warning',
                ]);
        }

        preconnect(session('db'));

        $table = $this->getInlinePerformanceTable($request->date);

        return view('monitoring::inlineperformance.index.index', [
