    function getInlinePerformanceTable($dateInput = null)
    {
        $date = $dateInput
            ? Carbon::parse($dateInput)
            : Carbon::today();

        $dta = $date->copy()->startOfDay();
        $dtb = $date->copy()->endOfDay();

        $g = (new MasterEmployeeGroup())->getTable();
        $s = (new MasterEmployeeSection())->getTable();

        $lines = MasterEmployeeGroup::select(
                "$g.id as kodegroup", "$g.name as namagroup", "$s.name as namabagian"
            )
            ->join($s, "$s.id", '=', "$g.section_id")
            ->distinct()
            ->whereHas('groupline', function ($q) {
                $q->where('factory_id', session('db')->iddb)
                    ->where('is_show', 1)
                    ->where('is_line', 1);
            })
            ->orderBy("$g.id", "asc")
            ->get();

        $headers = InlineHeader::whereBetween('date', [$dta, $dtb])
            ->get(['id', 'group_id', 'idpo', 'round']);

        $headersByLine = $headers->groupBy('group_id');

        $allHeaderIds = $headers->pluck('id');

        $defectsByHeader = InlineDetail::whereIn('inline_header_id', $allHeaderIds)
            ->get(['inline_header_id', 'problem', 'action', 'rootcause'])
            ->groupBy('inline_header_id');

        $result = $lines->map(function ($line) use ($headersByLine, $defectsByHeader) {
            $headers = $headersByLine->get($line->kodegroup, collect());
            $hIds = $headers->pluck('id');

            $lastRound = $headers->max('round');

            $lastRoundHeaderIds = $headers->where('round', $lastRound)->pluck('id');
            $lastRoundDefectCount = InlineDetail::whereIn('inline_header_id', $lastRoundHeaderIds)->count();
            $lastRoundHasDefect = $lastRoundDefectCount > 0;

            $idpos = $headers->pluck('idpo')->unique();

            $styles = PurchaseOrder::whereIn('idpo', $idpos)->pluck('idstyle')->unique()->values();
            $nmstyles = Style::whereIn('idstyle', $styles)->pluck('nmstyle')->values();

            $totInspect = $hIds->count() * 5;
            $totDefect = $hIds->sum(function ($id) use ($defectsByHeader) {
                return $defectsByHeader->get($id, collect())->count();
            });

            $hasCap = $lastRoundHeaderIds->contains(function ($id) use ($defectsByHeader) {
            return $defectsByHeader->get($id, collect())->contains(function ($detail) {
                return !empty($detail->problem)
                    || !empty($detail->action)
                    || !empty($detail->rootcause);
            });
        });

            $rft = $totInspect > 0 ? (($totInspect - $totDefect) / $totInspect) * 100 : 0;
            $wft = $totInspect > 0 ? ($totDefect / $totInspect) * 100 : 0;

            return [
                'line'                  => $line->namagroup,
                'kodegroup'             => $line->kodegroup,
                'style'                 => $nmstyles->toArray(),
                'qty_rft'               => $totInspect - $totDefect,
                'qty_inspect'           => $totInspect,
                'qty_defect'            => $totDefect,
                'rft'                   => number_format($rft, 2),
                'wft'                   => number_format($wft, 2),
                'last_round'            => $lastRound,
                'last_round_has_defect' => $lastRoundHasDefect,
                'has_cap'               => $hasCap,
            ];
        });

        return [
            'date' => $date->format('Y-m-d'),
            'data' => $result->values(),
        ];
    }

