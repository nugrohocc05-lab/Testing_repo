if ($request->query('debug_index')) {
    $od  = (new OutputDetail())->getTable();
    $odp = (new OutputDetailPacking())->getTable();
    $fi  = (new OutputDetailFinalInspection())->getTable();

    $indexes = function ($table) {
        return collect(DB::select("SHOW INDEX FROM `$table`"))
            ->groupBy('Key_name')
            ->map(fn ($g) => $g->sortBy('Seq_in_index')->pluck('Column_name')->implode(', '))
            ->toArray();
    };

    $ids = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb)
        ->pluck('idpo')->unique()->values();

    $q = OutputDetail::query()
        ->whereIn("$od.idpo", $ids)
        ->whereNotNull("$od.barcode")
        ->leftJoin($odp, "$odp.barcode", '=', "$od.barcode")
        ->select("$od.idpo", "$od.idcolor", DB::raw("COUNT(DISTINCT $odp.id_set) as total_output"))
        ->groupBy("$od.idpo", "$od.idcolor");

    $status = collect(DB::select("SHOW TABLE STATUS WHERE Name IN (?, ?, ?)", [$od, $odp, $fi]))
        ->map(fn ($r) => ['table' => $r->Name, 'approx_rows' => $r->Rows, 'engine' => $r->Engine])
        ->toArray();

    dd([
        'cache_driver'  => config('cache.default'),
        'table_status'  => $status,
        'index_od'      => $indexes($od),
        'index_odp'     => $indexes($odp),
        'index_fi'      => $indexes($fi),
        'explain_output_query' => DB::select('EXPLAIN ' . $q->toSql(), $q->getBindings()),
    ]);
}