if ($request->query('profile')) {
    DB::enableQueryLog();
    $t = microtime(true);
    $lap = fn ($n) => Log::info("[perf] $n " . round((microtime(true) - $t) * 1000) . 'ms') ?: ($t = microtime(true));

    $priority = $this->buildPriorityFinalData($request, $dta, $dtb); $lap('priority');
    $this->buildSummaryFilterData($request, $dta, $dtb);             $lap('summary');
    $this->buildFinalOverviewData($request, $dta, $dtb, $priority);  $lap('overview');
    $this->buildChartData($request, $dta, $dtb);                     $lap('chart');
    $this->buildTopDefectsData($request, $dta, $dtb);                $lap('topDefects');

    $q = collect(DB::getQueryLog())->sortByDesc('time')->take(10)->values();
    dd(['total_queries' => count(DB::getQueryLog()), 'slowest' => $q->toArray()]);
}