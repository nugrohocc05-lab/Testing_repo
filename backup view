$validKeys = $poList->map(fn ($i) => $i->idpo . '|' . $i->idcolor)->flip();

$outputPerIdpoTotal = collect();
foreach ($outputPerIdpoColor as $key => $val) {
    if (!$validKeys->has($key)) {
        continue;
    }
    $idpo = explode('|', $key, 2)[0];
    $outputPerIdpoTotal->put($idpo, $outputPerIdpoTotal->get($idpo, 0) + $val);
}