                                    </td>
                                </tr>
                            `);
                        });

                        $('#footTotalDefectQty').text(
                            total.toLocaleString('id-ID')
                        );

                        $('#footTotalDefectPct').text('100%');
                    }
                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                }
            });
        }

       let defectCategoryChart = null;
        function renderDefectCategoryChart(
            chartId,
            processValue,
            nonProcessValue,
            processPercent,
            nonProcessPercent,
            processTextId,
            nonProcessTextId
        ) {

            processValue = Number(processValue) || 0;
            nonProcessValue = Number(nonProcessValue) || 0;
            processPercent = Number(processPercent) || 0;
            nonProcessPercent = Number(nonProcessPercent) || 0;

            const MIN_BAR_HEIGHT = 5;

            const processChartValue =
                processPercent === 0 ? MIN_BAR_HEIGHT : processPercent;

            const nonProcessChartValue =
                nonProcessPercent === 0 ? MIN_BAR_HEIGHT : nonProcessPercent;


            const getResponsiveFontSize = () => {
                const width = window.innerWidth;

                if (width <= 480) {
                    return 9;
                } else if (width <= 768) {
                    return 11;
                } else if (width <= 1200) {
                    return 13;
                } else {
                    return 15;
                }
            };

            const processText = document.getElementById(processTextId);

            if (processText) {
                processText.innerText =
                    processValue.toLocaleString('id-ID') +
                    ' (' +
                    processPercent.toFixed(2) +
                    '%)';
            }

            const nonProcessText = document.getElementById(nonProcessTextId);

            if (nonProcessText) {
                nonProcessText.innerText =
                    nonProcessValue.toLocaleString('id-ID') +
                    ' (' +
                    nonProcessPercent.toFixed(2) +
                    '%)';
            }

            const chartDom = document.getElementById(chartId);

            if (!chartDom) {
                return;
            }

            if (defectCategoryChart) {
                defectCategoryChart.dispose();
                defectCategoryChart = null;
            }

            defectCategoryChart = echarts.init(chartDom);
            const option = {
                backgroundColor: 'transparent',
                grid: {
                    left: '10%',
                    right: '10%',
                    top: '35%',
                    bottom: '5%',
                    containLabel: false
                },
                xAxis: {
                    type: 'category',
                    data: [
                        'Process',
                        'Non Process'
                    ],
                    show: false
                },
                yAxis: {
                    type: 'value',
                    show: false,
                    min: 0,
                    max: 100
                },
                tooltip: {
                    trigger: 'axis',
                    axisPointer: {
                        type: 'shadow'
                    },
                    formatter: function (params) {
                        const item = params[0];
                        if (!item) {
                            return '';
                        }
                        return `
                            <div>
                                <strong>${item.name}</strong><br>
                                Qty: ${item.name === 'Process'
                                    ? processValue.toLocaleString('id-ID')
