<script>
    $(function () {
        function parseDMY(str) {
            const [d, m, y] = str.split('-');
            return new Date(`${y}-${m}-${d}`);
        }

        function checkDateSelection() {
            let datea = $('#datea').val();
            let dateb = $('#dateb').val();

            $('#groupbuyer').val(null).trigger('change');
            $('#selectstyle').val(null).trigger('change');
            $('#selectpo').val(null).trigger('change');
            $('#selectstyle').prop('disabled', true).trigger('change.select2');
            $('#selectpo').prop('disabled', true).trigger('change.select2');

            if (!datea || !dateb) {
                $('#groupbuyer').prop('disabled', true).trigger('change.select2');
                return;
            }

            const start = parseDMY(datea);
            const end = parseDMY(dateb);

            const diffDays = (end - start) / (1000 * 60 * 60 * 24);

            if (diffDays > 31) {
                swal('Warning!', 'Date Has More Than 31 Days in Range, Cannot View Data.', 'warning');
                $('#groupbuyer').prop('disabled', true).trigger('change.select2');
                return;
            }

            $('#groupbuyer').prop('disabled', false).trigger('change.select2');
        }

        const dateOpt = {
            dateFormat: "d-m-Y",
            altInput: true,
            altFormat: "d F Y",
            allowInput: false,
            monthSelectorType: "static",
            disableMobile: true,
            defaultDate: "today",
            onChange: function () {
                checkDateSelection();
            }
        };

        flatpickr("#datea", dateOpt);
        flatpickr("#dateb", dateOpt);

        $('#groupbuyer').select2({
            placeholder: 'Select Buyer',
            width: '100%',
            ajax: {
                url: "{{ route('monitoring_finalinspection_groupbuyer') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function (params) {
                    return {
                        q: params.term || '',
                        page: params.page || 1,
                        datea: $('#datea').val(),
                        dateb: $('#dateb').val()
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    let results = data.results || [];
                    if (params.page === 1 && !params.term) {
                        results = [
                            { id: 'all', text: 'All Buyer' },
                            ...results
                        ];
                    }
                    return {
                        results: results
                    };
                },
                cache: true
            }
        });

        $('#selectstyle').select2({
            placeholder: 'Select Style',
            width: '100%',
            ajax: {
                url: "{{ route('monitoring_finalinspection_selectstyle') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function (params) {
                    return {
                        q: params.term || '',
                        page: params.page || 1,
                        datea: $('#datea').val(),
                        dateb: $('#dateb').val(),
                        groupbuyer: $('#groupbuyer').val()
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    let results = data.results || [];

                    if (params.page === 1 && !params.term && results.length > 0) {
                        results = [
                            { id: 'all', text: 'All Style' },
                            ...results
                        ];
                    }

                    return { results: results };
                },
                cache: true
            },
            language: {
                noResults: function () {
                    return 'Style Not Found';
                }
            }
        });

        $('#selectpo').select2({
            placeholder: 'Select PO',
            width: '100%',
            ajax: {
                url: "{{ route('monitoring_finalinspection_selectpo') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function (params) {
                    return {
                        q: params.term || '',
                        page: params.page || 1,
                        datea: $('#datea').val(),
                        dateb: $('#dateb').val(),
                        groupbuyer: $('#groupbuyer').val(),
                        style: $('#selectstyle').val()
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    let results = data.results || [];

                    if (params.page === 1 && !params.term && results.length > 0) {
                        results = [
                            { id: 'all', text: 'All PO' },
                            ...results
                        ];
                    }

                    return {
                        results: results
                    };
                },
                cache: true
            },
            language: {
                noResults: function () {
                    return 'PO Not Found';
                }
            }
        });

        $('#groupbuyer').prop('disabled', true).trigger('change.select2');
        $('#selectstyle').prop('disabled', true).trigger('change.select2');
        $('#selectpo').prop('disabled', true).trigger('change.select2');

        checkDateSelection();

        $('#groupbuyer').on('change', function () {
            let buyer = $(this).val();

            $('#selectstyle').val(null).trigger('change');
            $('#selectpo').val(null).trigger('change');

            $('#selectstyle').prop('disabled', !buyer).trigger('change.select2');
            $('#selectpo').prop('disabled', true).trigger('change.select2');
        });

        $('#selectstyle').on('change', function () {
            let style = $(this).val();

            $('#selectpo').val(null).trigger('change');
            $('#selectpo').prop('disabled', !style).trigger('change.select2');
        });

        window.currentFilter = {
            line: 'all',
            datea: $('#datea').val(),
            dateb: $('#dateb').val(),
            groupbuyer: 'all',
        };

        let hasFiltered = false;

        $('#groupbuyer, #selectstyle, #selectpo, #datea, #dateb').on('change input', function () {
            hasFiltered = false;
        });

        function loadCards(filter) {
            $.ajax({
                url: "{{ route('monitoring_finalinspection_summaryfilter') }}",
                type: "GET",
                data: filter,

                beforeSend: function () {
                    $('#loading').show();
                },

                success: function (response) {

                    $('#totalpo').text(response.total_po ?? '-');
                    $('#totalqty').text(response.total_qty ?? '-');
                    $('#totalqtyinspect').text(response.total_qty_inspect ?? '-');
                    $('#poneedfinal').text(response.po_need_final ?? '-');
                    $('#overdue').text(response.overdue ?? '-');
                    $('#final').text(response.final_completed ?? '-');
                    $('#oql').text(response.oql ?? '-');

                    let passingRate = Number(response.passing_rate ?? 0);
                    let rejectRate = Number(response.reject_rate ?? 0);

                    // Text
                    $('#passingRateValue').text(
                        passingRate.toLocaleString('en-US', {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }) + '%'
                    );

                    $('#rejectRateValue').text(
                        rejectRate.toLocaleString('en-US', {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }) + '%'
                    );

                    $('#passingRateBar')
                        .css('width', passingRate + '%')
                        .attr('title', 'Passing Rate: ' + passingRate.toLocaleString('id-ID') + '%');

                    $('#rejectRateBar')
                        .css('width', rejectRate + '%')
                        .attr('title', 'Reject Rate: ' + rejectRate.toLocaleString('id-ID') + '%');

                    updateDataTime();
                },

                error: function (xhr) {
                    console.log(xhr.responseText);
                },

                complete: function () {
                    $('#loading').hide();
                }
            });
        }

        function loadTable(filter) {
            $.ajax({
                url: "{{ route('monitoring_finalinspection_priorityfinal') }}",
                type: "GET",
                data: filter,

                success: function (response) {
                    let rows = response.data || [];
                    let total = response.total || {};

                    let $body = $('#tablePriorityFinalBody');
                    $body.empty();

                    if (rows.length === 0) {
                        $body.append(
                            '<tr><td colspan="11" class="text-center">No Data</td></tr>'
                        );
                    } else {
                        rows.forEach(function (row, idx) {
                            $body.append(`
                                <tr>
                                    <td class="text-center">
                                        ${idx + 1}
                                    </td>

                                    <td
                                        class="text-center po-cell"
                                        title="${row.po ?? '-'}"
                                    >
                                        ${row.po ?? '-'}
                                    </td>

                                    <td class="text-center">
                                        ${row.buyer ?? '-'}
                                    </td>

                                    <td class="text-center">
                                        ${row.style ?? '-'}
                                    </td>

                                    <td class="text-center">
                                        ${row.color ?? '-'}
                                    </td>

                                    <td class="text-center">
                                        ${row.qty_order ?? '-'}
                                    </td>

                                    <td class="text-center">
                                        ${row.output ?? '-'}
                                    </td>

                                    <td
                                        class="text-center"
                                        style="color:#4CF299;"
                                    >
                                        ${row.progress_output ?? '-'}%
                                    </td>

                                    <td class="text-center">
                                        ${row.etd ?? '-'}
                                    </td>

                                    <td class="text-center ${row.days_to_etd < 0 ? 'text-danger' : ''}">
                                        ${row.days_to_etd ?? '-'}
                                    </td>

                                    <td class="text-center" style="
                                        color: ${
                                            row.status === 'Pass'
                                                ? '#4CF299'
                                                : row.status === 'Reject'
                                                    ? '#EB5757'
                                                    : row.status === 'Need final'
                                                        ? '#ffffff'
                                                        : '#ffffff'
                                        };
                                    ">
                                        ${row.status ?? '-'}
                                    </td>
                                </tr>
                            `);
                        });

                    }

                    $('#footQtyOrder').text(
                        (total.qty_order ?? 0).toLocaleString()
                    );

                    $('#footOutput').text(
                        (total.output ?? 0).toLocaleString()
                    );

                    $('#footProgressOutput').text(
                        (total.progress_output ?? 0) + '%'
                    );
                },

                error: function (xhr) {
                    console.log(xhr.responseText);
                }
            });
        }

        function loadTableTopDefect(filter) {
            $.ajax({
                url: "{{ route('monitoring_finalinspection_topdefect') }}",
                type: "GET",
                data: filter,

                success: function (response) {

                    let rows = response.data || [];
                    let total = Number(response.total || 0);

                    let $body = $('#tableDefectFinalBody');

                    $body.empty();

                    loadDefectCategoryChart(response);
                    if (rows.length === 0) {

                        $body.append(`
                            <tr>
                                <td colspan="5" class="text-center">
                                    No Data
                                </td>
                            </tr>
                        `);

                        $('#footTotalDefectQty').text('0');
                        $('#footTotalDefectPct').text('0%');

                    } else {
                        rows.forEach(function (row, idx) {
                            let pct = Number(row.percentage || 0);
                            $body.append(`
                                <tr>
                                    <td class="text-center">
                                        ${idx + 1}
                                    </td>

                                    <td class="text-left po-cell"
                                        title="${row.defect_name ?? '-'}"
                                    >
                                        ${row.defect_name ?? '-'}
                                    </td>

                                    <td class="text-center">
                                        ${(Number(row.qty) || 0)
                                            .toLocaleString('id-ID')}
                                    </td>

                                    <td class="text-center">
                                        ${pct}%
                                    </td>

                                    <td>
                                        <div style="background:#1C2536;border-radius:10px;width:100%;height:10px;overflow:hidden;">
                                            <div style="background:#0d6efd;width:${pct}%;height:100%;"></div>
