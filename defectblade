    //   - qtypo = 0  -> buang X dari list, pakai Y saja
    //   - qtypo != 0 -> X dan Y tetap dua-duanya
    private function resolveRerouteDuplicates(Collection $idpoList): Collection
    {
        if ($idpoList->isEmpty()) {
            return $idpoList;
        }

        $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
            ->pluck('combine_pro')
            ->filter()
            ->unique()
            ->values();

        if ($combineProList->isEmpty()) {
            return $idpoList;
        }


        $rows = HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
            ->select('idpo', 'combine_pro', 'kp_item', 'kp_item_ref', 'revisi_kp')
            ->get();

        $ownerByCombineKpItem = $rows
            ->groupBy(fn ($r) => $r->combine_pro . '|' . $r->kp_item)
            ->map(fn ($group) => (string) $group->sortBy('idpo')->first()->idpo);

        $reroutedPairs = $rows
            ->filter(fn ($r) => $r->revisi_kp == 1 && !is_null($r->kp_item_ref))
            ->map(function ($r) use ($ownerByCombineKpItem) {
                $originalIdpo = $ownerByCombineKpItem->get($r->combine_pro . '|' . $r->kp_item_ref);
                return ($originalIdpo && $originalIdpo !== (string) $r->idpo)
                    ? ['original' => $originalIdpo, 'rerouted' => (string) $r->idpo]
                    : null;
            })
            ->filter()
            ->unique(fn ($p) => $p['original'] . '|' . $p['rerouted'])
            ->values();

        $excludedOriginals = collect();

        foreach ($reroutedPairs as $pair) {
            $maxRevisiRow = HistoryPO::where('idpo', $pair['original'])
                ->orderByDesc('revisi')
                ->first();

            if ($maxRevisiRow && (int) $maxRevisiRow->qtypo === 0) {
                $excludedOriginals->push($pair['original']);
            }
        }

        return $idpoList->reject(function ($idpo) use ($excludedOriginals) {
            return $excludedOriginals->contains(function ($excluded) use ($idpo) {
                return (string) $excluded === (string) $idpo;
            });
        })->values();
    }

    private function getNetCutoffQty(Collection $idpoList): int
    {
        if ($idpoList->isEmpty()) {
            return 0;
        }

        $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
            ->pluck('combine_pro')
            ->filter()
            ->unique()
            ->values();

        if ($combineProList->isEmpty()) {
            return (int) HistoryDataBreakdown::whereIn('idpo', $idpoList)
                ->where('is_cutoff', '1')
                ->sum('qty_ori');
        }

        // $familyRows = HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
        //     ->select('idpo', 'combine_pro', 'kp_item', 'kp_item_ref', 'revisi_kp', 'qty_ori', 'is_cutoff')
        //     ->get();

        $familyRows = HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
            ->select(
                'idpo',
                'combine_pro',
                'combine_pro_set',
                'kp_item',
                'kp_item_ref',
                'revisi_kp',
                'qty_ori',
                'is_cutoff'
            )
            ->get();



        $ownerByCombineKpItem = $familyRows
            ->groupBy(fn ($r) => $r->combine_pro . '|' . $r->kp_item)
            ->map(fn ($group) => (string) $group->sortBy('idpo')->first()->idpo);

        $reroutedPairs = $familyRows
            ->filter(fn ($r) => $r->revisi_kp == 1 && !is_null($r->kp_item_ref))
            ->map(function ($r) use ($ownerByCombineKpItem) {
                $originalIdpo = $ownerByCombineKpItem->get($r->combine_pro . '|' . $r->kp_item_ref);
                return ($originalIdpo && $originalIdpo !== (string) $r->idpo)
                    ? [
                        'original'    => $originalIdpo,
                        'rerouted'    => (string) $r->idpo,
                        'combine_pro' => $r->combine_pro,
                        'kp_item_ref' => $r->kp_item_ref,
                    ]
                    : null;
            })
            ->filter()
            ->unique(fn ($p) => $p['original'] . '|' . $p['rerouted'])
            ->values();


        // idpo asli yang qtypo=0 -> exclude TOTAL (bukan dikurangi sebagian)
        $excludedOriginals = collect();
        // idpo baru -> qty yang di-"take over" penuh dari idpo asalnya
        $qtyTakeoverByNewIdpo = collect();

        foreach ($reroutedPairs as $pair) {
            $maxRevisiRow = HistoryPO::where('idpo', $pair['original'])
                ->orderByDesc('revisi')
                ->first();

            if ($maxRevisiRow && (int) $maxRevisiRow->qtypo === 0) {
                $excludedOriginals->push($pair['original']);

                $originalCutoffQty = $familyRows
                    ->where('idpo', $pair['original'])
                    ->where('kp_item', $pair['kp_item_ref'])
                    ->where('is_cutoff', '1')
                    ->sum('qty_ori');

                $qtyTakeoverByNewIdpo->put(
                    $pair['rerouted'],
                    $qtyTakeoverByNewIdpo->get($pair['rerouted'], 0) + (int) $originalCutoffQty
                );
            }
        }

        $netQty = 0;
        foreach ($idpoList as $idpo) {
            $idpoStr = (string) $idpo;

            if ($excludedOriginals->contains($idpoStr)) {
                continue;
            }

            $ownRows = $familyRows
                ->where('idpo', $idpo)
                ->where('is_cutoff', '1');

            $ownQty = $ownRows
                ->filter(fn ($row) => is_null($row->combine_pro_set))
                ->sum('qty_ori');

            $ownQty += $ownRows
                ->filter(fn ($row) => !is_null($row->combine_pro_set))
                ->groupBy('combine_pro_set')
                ->sum(fn ($group) => (int) $group->first()->qty_ori);


            $netQty += (int) $ownQty;
        }

        $netQty += (int) $qtyTakeoverByNewIdpo->sum();

        return $netQty;
    }

    function summaryFilter(Request $request)
    {
        preconnect(session('db'));

        $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
        $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

        $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
        $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

        $fi = (new OutputDetailFinalInspection())->getTable();
        $od = (new OutputDetail())->getTable();
        $po = (new PurchaseOrder())->getTable();

        $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);

        $qtyPerIdpo = $leafRows->groupBy('idpo')->map(function ($rows) {
            return (int) $rows->sum('qty_ori');
        });

        $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();

        $today = Carbon::today()->startOfDay();
        $split = $this->getSplitFinalCheckIdpoList($request, $dta, $dtb, $today);
        $overdueList    = $split['overdue'];
        $needFinalList  = $split['need_final'];

        // ===== header query tetap dipakai untuk final_completed / reject / OQL =====
        $barcodesForHeader = OutputDetail::whereIn('idpo', $qualifiedIdpo)
            ->pluck('barcode');

        $headerQuery = OutputDetailFinalInspection::query()
            ->join($od, "$od.barcode", '=', "$fi.barcode")
            ->join($po, "$po.idpo", '=', "$od.idpo")
            ->whereIn("$fi.barcode", $barcodesForHeader);

        $finalComIdpoList = (clone $headerQuery)
            ->where("$fi.is_output", 1)
            ->select("$od.idpo")
            ->distinct()
            ->pluck("$od.idpo");

        // ===== SAMAKAN basis idpo dengan priorityFinal =====
        $finalIdpoList = $overdueList
            ->merge($needFinalList)
            ->merge($finalComIdpoList)
            ->unique()
            ->values();

        // total_qty sekarang dihitung dari basis yang sama persis dengan priorityFinal
        $totalQty = $finalIdpoList->sum(function ($idpo) use ($qtyPerIdpo) {
            return $qtyPerIdpo->get($idpo, 0);
        });

        $totalQtyInspect = (clone $headerQuery)
            ->whereNotNull("$fi.date_output")
            ->count(DB::raw("DISTINCT $fi.id"));

        $overdue     = $overdueList->count();
        $poNeedFinal = $needFinalList->count();
        $finalCom    = $finalComIdpoList->count();
        $totalPo     = $poNeedFinal + $overdue + $finalCom;

        // ===== OQL =====
        $totDefect = (clone $headerQuery)
            ->whereNotNull("$fi.date_output")
            ->whereNotNull("$fi.defect_code")
            ->count(DB::raw("DISTINCT $fi.id"));

        $oql = $totalQtyInspect > 0 ? round(($totDefect / $totalQtyInspect) * 100, 2) : 0;

        $rejectIdpoList = (clone $headerQuery)
            ->whereIn("$od.idpo", $finalComIdpoList)
            ->whereNotNull("$fi.defect_code")
            ->select("$od.idpo")
            ->distinct()
            ->pluck("$od.idpo");

        $poWithDefect = $rejectIdpoList->count();
        $poNoDefect   = $finalCom - $poWithDefect;

        $passingRate = $finalCom > 0 ? round(($poNoDefect / $finalCom) * 100, 2) : 0;
        $rejectRate  = $finalCom > 0 ? round(($poWithDefect / $finalCom) * 100, 2) : 0;

        return response()->json([
            'total_po'          => $totalPo,
            'total_qty'         => $totalQty,
            'total_qty_inspect' => $totalQtyInspect,
            'po_need_final'     => $poNeedFinal,
            'overdue'           => $overdue,
            'final_completed'   => $finalCom,
            'oql'               => $oql,
            'passing_rate'      => $passingRate,
            'reject_rate'       => $rejectRate,
        ]);
    }

    private function getLeafHistoryRows(
        Request $request,
        $familyColumn = 'combine_pro',
        $applyPoFilter = true,
        $fromDate = null,
        $toDate = null
    ) {
        $po  = (new PurchaseOrder())->getTable();
        $dbr = (new HistoryDataBreakdown())->getTable();

        $rawQuery = HistoryDataBreakdown::query()
            ->join($po, "$po.idpo", '=', "$dbr.idpo")
            ->where("$dbr.production_status", "IH");

        if ($request->filled('groupbuyer') && $request->groupbuyer !== 'all') {
            $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)
                ->pluck('idbuyer');

            $rawQuery->whereIn("$po.idbuyer", $buyerIds);
        }

        if ($applyPoFilter && $request->filled('po') && $request->po !== 'all') {

            $resolvedIdpo = $this->resolveRerouteIdpo(
                $request->po
            );

            $rawQuery->whereIn(
                "$dbr.idpo",
                $resolvedIdpo
            );
        }


        if ($request->filled('style') && $request->style !== 'all') {
            $rawQuery->where("$po.idstyle", $request->style);
        }

        if ($fromDate && $toDate) {

            // Dipakai kalau caller memberikan tanggal khusus
            $dta = $fromDate->copy()->startOfDay();
            $dtb = $toDate->copy()->endOfDay();

        } elseif ($request->filled('datea') && $request->filled('dateb')) {
            // Default: gunakan tanggal dari input
            $dateA = Carbon::createFromFormat(
                'd-m-Y',
                $request->datea
            )->startOfDay();

            $dateB = Carbon::createFromFormat(
                'd-m-Y',
                $request->dateb
            )->startOfDay();

            $dta = $dateA->lessThanOrEqualTo($dateB)
                ? $dateA
                : $dateB;

            $dtb = $dateA->lessThanOrEqualTo($dateB)
                ? $dateB->copy()->endOfDay()
                : $dateA->copy()->endOfDay();

        } else {
            $dta = null;
            $dtb = null;
        }
        // Kalau ada range tanggal, filter DBR dari awal
        if ($dta && $dtb) {
            $rawQuery->whereBetween(
                "$dbr.deliverydate",
                [$dta, $dtb]
            );
        }
        $rawRows = $rawQuery->select(
            "$dbr.idpo",
            "$dbr.idcolor",
            "$dbr.qty_ori",
            "$dbr.kp_item",
            "$dbr.kp_item_ref",
            "$dbr.revisi_kp",
            "$dbr.deliverydate",
            "$dbr.$familyColumn as family_key",
            "$po.po",
            "$po.idbuyer",
            "$po.idstyle"
        )->get();

        $deduped = $rawRows
            ->groupBy(function ($r) {
                return $r->idpo . '|' . $r->idcolor . '|' . $r->kp_item;
            })
            ->map(function ($group) {
                return $group
                    ->sortByDesc('revisi_kp')
                    ->first();
            })
            ->values();

        $refByFamily = $deduped
            ->filter(fn ($r) => !is_null($r->kp_item_ref))
            ->groupBy(fn ($r) => $r->idpo . '|' . $r->family_key)   // <-- tambah idpo
            ->map(fn ($group) => $group->pluck('kp_item_ref')->unique()->values());

        $leafRows = $deduped->filter(function ($row) use ($refByFamily) {
            $key = $row->idpo . '|' . $row->family_key;             // <-- samakan key
            $refs = $refByFamily->get($key);
            return !($refs && $refs->contains($row->kp_item));
        })->values();

        return $leafRows;
    }

    private function resolveRerouteIdpo($idpo)
    {
        if (!$idpo || $idpo === 'all') {
            return collect();
        }

        // Cari combine_pro dari IDPO yang dipilih
        $combineProList = HistoryDataBreakdown::where('idpo', $idpo)
            ->pluck('combine_pro')
            ->filter()
            ->unique()
            ->values();

        // Tidak punya combine_pro = bukan reroute
        if ($combineProList->isEmpty()) {
            return collect([$idpo]);
        }

        // Cari semua IDPO yang memiliki combine_pro yang sama
        $relatedIdpo = HistoryDataBreakdown::whereIn(
            'combine_pro',
            $combineProList
        )
            ->pluck('idpo')
            ->filter()
            ->unique()
            ->values();

        // Ambil HistoryPO
        $historyRows = HistoryPO::whereIn('idpo', $relatedIdpo)
            ->orderBy('idpo')
            ->orderByDesc('revisi')
            ->get([
                'idpo',
                'revisi',
                'qtypo',
            ]);

        // Ambil revisi terakhir setiap IDPO
        $lastHistory = $historyRows
            ->groupBy('idpo')
            ->map(function ($rows) {
                return $rows->sortByDesc('revisi')->first();
            });

        /*
        * Hanya IDPO yang qtypo revisi terakhir > 0
        * yang dianggap aktif.
        */
        $activeIdpo = $lastHistory
            ->filter(function ($row) {
                return (int) $row->qtypo > 0;
            })
            ->keys()
            ->values();

        return $activeIdpo->isNotEmpty()
            ? $activeIdpo
            : collect([$idpo]);
    }


    private function redistributeReroutedOutput(Collection $idpoList, Collection $outputPerIdpo): Collection
    {
        if ($idpoList->isEmpty()) {
            return $outputPerIdpo;
        }

        $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
            ->pluck('combine_pro')
            ->filter()
            ->unique()
            ->values();

        if ($combineProList->isEmpty()) {
            return $outputPerIdpo;
        }

        $rows = HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
            ->select('idpo', 'combine_pro', 'kp_item', 'kp_item_ref', 'revisi_kp', 'qty_ori')
            ->get();

        $allIdpoList = $idpoList
            ->merge($rows->pluck('idpo'))
            ->unique()
            ->values();

        $ownerByCombineKpItem = $rows
            ->groupBy(fn ($r) => $r->combine_pro . '|' . $r->kp_item)
            ->map(fn ($group) => (string) $group->sortBy('idpo')->first()->idpo);

        $childrenByOriginal = collect();

        $rows->filter(fn ($r) => $r->revisi_kp == 1 && !is_null($r->kp_item_ref))
            ->each(function ($r) use ($ownerByCombineKpItem, $childrenByOriginal) {
                $originalIdpo = $ownerByCombineKpItem->get($r->combine_pro . '|' . $r->kp_item_ref);
                $childIdpo = (string) $r->idpo;

                if ($originalIdpo && $originalIdpo !== $childIdpo) {
                    if (!$childrenByOriginal->has($originalIdpo)) {
                        $childrenByOriginal->put($originalIdpo, collect());
                    }
                    $childrenByOriginal->get($originalIdpo)->push([
                        'child' => $childIdpo,
                        'qty'   => (int) $r->qty_ori,
                    ]);
                }
            });

        $result = [];
        foreach ($outputPerIdpo as $idpo => $qty) {
            $result[(string) $idpo] = (int) $qty;
        }

        foreach ($childrenByOriginal as $originalIdpo => $children) {
            $remainingRawOutput = $result[$originalIdpo] ?? 0;

            foreach ($children as $child) {
                $moveQty = min($child['qty'], $remainingRawOutput);
                if ($moveQty <= 0) {
                    continue;
                }
                $result[$child['child']] = ($result[$child['child']] ?? 0) + $moveQty;
                $remainingRawOutput -= $moveQty;
            }

            $result[$originalIdpo] = $remainingRawOutput;
        }

        return collect($result);
    }

    private function getRerouteIdpoList($idpoList)
    {
        $idpoList = collect($idpoList)
            ->filter()
            ->unique()
            ->values();

        if ($idpoList->isEmpty()) {
            return collect();
        }

        /*
        * 1. Cari combine_pro dari IDPO awal
        */
        $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
            ->pluck('combine_pro')
            ->filter()
            ->unique()
            ->values();

        if ($combineProList->isEmpty()) {
            return $idpoList;
        }

        /*
        * 2. Cari semua IDPO yang mempunyai combine_pro yang sama
        */
        $allIdpo = HistoryDataBreakdown::whereIn(
            'combine_pro',
            $combineProList
        )
            ->pluck('idpo')
            ->filter()
            ->unique()
            ->values();

        /*
        * 3. Ambil seluruh history PO untuk IDPO tersebut
        */
        $historyRows = HistoryPO::whereIn('idpo', $allIdpo)
            ->orderBy('idpo')
            ->orderByDesc('revisi')
            ->get([
                'idpo',
                'revisi',
                'qtypo',
                'created_at',
            ]);

        /*
        * 4. Ambil revisi terbesar masing-masing IDPO
        */
        $lastHistory = $historyRows
            ->groupBy('idpo')
            ->map(function ($rows) {
                return $rows
                    ->sortByDesc('revisi')
                    ->first();
            });

        /*
        * 5. Tentukan IDPO yang aktif
        */
        $result = collect();

        foreach ($lastHistory as $idpo => $last) {

            /*
            * Kalau qtypo revisi terakhir > 0,
            * berarti IDPO masih aktif.
            */
            if ((int) $last->qtypo > 0) {
                $result->push($idpo);
            }
        }

        return $result
            ->unique()
            ->values();
    }

    private function getActiveRerouteIdpoList($idpoList)
    {
        $idpoList = collect($idpoList)
            ->filter()
            ->unique()
            ->values();

        if ($idpoList->isEmpty()) {
            return collect();
        }

        /*
        * Cari combine_pro dari IDPO yang masuk priority.
        */
        $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
            ->pluck('combine_pro')
            ->filter()
            ->unique()
            ->values();

        if ($combineProList->isEmpty()) {
            return $idpoList;
        }

        /*
        * Cari SEMUA idpo dalam combine_pro tersebut.
        */
        $allIdpo = HistoryDataBreakdown::whereIn(
            'combine_pro',
            $combineProList
        )
            ->pluck('idpo')
            ->filter()
            ->unique()
            ->values();

        /*
        * Ambil history PO.
        *
        * revisi terbesar = kondisi terakhir PO.
        */
        $historyRows = HistoryPO::whereIn('idpo', $allIdpo)
            ->orderBy('idpo')
            ->orderByDesc('revisi')
            ->get([
                'idpo',
                'revisi',
                'qtypo',
            ]);

        /*
        * Ambil row terakhir setiap IDPO.
        */
        $lastHistory = $historyRows
            ->groupBy('idpo')
            ->map(function ($rows) {
                return $rows
                    ->sortByDesc('revisi')
                    ->first();
            });

        /*
        * HANYA IDPO yang qtypo terakhir > 0
        * yang dianggap aktif.
        */
        return $lastHistory
            ->filter(function ($row) {
                return (int) $row->qtypo > 0;
            })
            ->keys()
            ->values();
    }



    function priorityFinal(Request $request)
    {
        preconnect(session('db'));

        $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
        $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

        $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
        $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

        $fi  = (new OutputDetailFinalInspection())->getTable();
        $od  = (new OutputDetail())->getTable();
        $po  = (new PurchaseOrder())->getTable();
        $dbr = (new HistoryDataBreakdown())->getTable();
        $so  = (new SewingOutput())->getTable();
        $odp = (new OutputDetailPacking())->getTable();

        $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);

        $byIdpoLeaf = $leafRows->groupBy('idpo');

        $qtyPerIdpo = array();
        $etdPerIdpo = array();
        foreach ($byIdpoLeaf as $idpo => $rows) {
            $qtyPerIdpo[$idpo] = (int) $rows->sum('qty_ori');
            $etdPerIdpo[$idpo] = $rows->max('deliverydate');
        }

        $today = Carbon::today()->startOfDay();
        $split = $this->getSplitFinalCheckIdpoList($request, $dta, $dtb, $today);

        // ===== Tambahan: ambil idpo yang sudah Final Completed =====
        $qualifiedIdpo = collect($qtyPerIdpo)
            ->filter(fn ($qty) => $qty > 0)
            ->keys()
            ->values();

        $barcodesForHeader = OutputDetail::whereIn('idpo', $qualifiedIdpo)
            ->pluck('barcode');

        $headerQuery = OutputDetailFinalInspection::query()
            ->join($od, "$od.barcode", '=', "$fi.barcode")
            ->join($po, "$po.idpo", '=', "$od.idpo")
            ->whereIn("$fi.barcode", $barcodesForHeader);

        $finalComIdpoList = (clone $headerQuery)
            ->where("$fi.is_output", 1)
            ->select("$od.idpo")
            ->distinct()
            ->pluck("$od.idpo");

        $rejectIdpoList = (clone $headerQuery)
            ->whereIn("$od.idpo", $finalComIdpoList)
            ->whereNotNull("$fi.date_output")
            ->whereNotNull("$fi.defect_code")
            ->select("$od.idpo")
            ->distinct()
            ->pluck("$od.idpo");

        $passIdpoList = $finalComIdpoList->diff($rejectIdpoList)->values();

        $statusByIdpo = collect();

        foreach ($split['overdue'] as $idpo) {
            $statusByIdpo->put((string) $idpo, 'overdue');
        }

        foreach ($split['need_final'] as $idpo) {
            $statusByIdpo->put((string) $idpo, 'need_final');
        }

        foreach ($passIdpoList as $idpo) {
            $statusByIdpo->put((string) $idpo, 'pass');
        }

        foreach ($rejectIdpoList as $idpo) {
            $statusByIdpo->put((string) $idpo, 'reject');
        }

        $originalFinalIdpoList = $split['overdue']
            ->merge($split['need_final'])
            ->merge($finalComIdpoList)
            ->unique()
            ->values();

        $finalIdpoList = $this->getActiveRerouteIdpoList($originalFinalIdpoList);

        $poList = $finalIdpoList->map(function ($idpo) use ($byIdpoLeaf) {
            $rows = $byIdpoLeaf->get($idpo);

            if (!$rows) {
                return null;
            }

            $first = $rows->first();

            return (object) array(
                'idpo' => $idpo,
                'po' => $first->po,
                'idbuyer' => $first->idbuyer,
                'idstyle' => $first->idstyle,
                'idcolor' => $first->idcolor,
            );
        })->filter()->values();


        $idpoList = $poList->pluck('idpo')
            ->unique()
            ->values();

        $buyerIds = $poList->pluck('idbuyer')->filter()->unique()->values();
        $buyerGroupMap = Buyer::whereIn('idbuyer', $buyerIds)->pluck('groupbuyer', 'idbuyer');
        $groupBuyerIds = $buyerGroupMap->filter()->unique()->values();
        $groupBuyerNames = MasterGroupBuyer::whereIn('id', $groupBuyerIds)->pluck('group_name', 'id');
        $styleIds = $poList->pluck('idstyle')->filter()->unique()->values();
        $styleMap = Style::whereIn('idstyle', $styleIds)->pluck('nmstyle', 'idstyle');
        $colorIds = $poList->pluck('idcolor')->filter()->unique()->values();
        $colorMap = Color::whereIn('idcolor', $colorIds)->pluck('nmcolor', 'idcolor');

        $idpoList = $poList->pluck('idpo')->unique()->values();

        $allIdpoList = $this->getRerouteIdpoList($idpoList);


        $outputPerIdpo = OutputDetail::query()
            ->whereIn("$od.idpo", $allIdpoList)
            ->whereNotNull("$od.barcode")
            ->leftJoin("$odp", "$odp.barcode", '=', "$od.barcode")
            ->select(
                "$od.idpo",
                DB::raw("COUNT(DISTINCT $odp.id_set) as total_output")
            )
            ->groupBy("$od.idpo")
            ->pluck('total_output', 'idpo');

        $statusOrder = array(
            'overdue'    => 0,
            'need_final' => 1,
            'reject'     => 2,
            'pass'       => 3,
        );

        $data = $poList->map(function ($item) use (
            $buyerGroupMap, $groupBuyerNames, $styleMap, $colorMap,
            $qtyPerIdpo, $etdPerIdpo, $outputPerIdpo, $today, $statusByIdpo
        ) {
            $groupBuyerId = $buyerGroupMap->get($item->idbuyer);

            $totalOutput = $outputPerIdpo->get($item->idpo, 0);

            $etd = isset($etdPerIdpo[$item->idpo]) ? $etdPerIdpo[$item->idpo] : null;

            $daysToEtd = null;
            if ($etd) {
                $daysToEtd = $today->diffInDays(
                    Carbon::parse($etd)->startOfDay(),
                    false
                );
            }

            $totalQty = isset($qtyPerIdpo[$item->idpo])
                ? (int) $qtyPerIdpo[$item->idpo]
                : 0;

            $progressOutput = $totalQty > 0
                ? round(($totalOutput / $totalQty) * 100, 2)
                : 0;

            $rawStatus = $statusByIdpo->get((string) $item->idpo, '-');

            $status = in_array($rawStatus, array('overdue', 'need_final'))
                ? 'Need Final'
                : (
                    $rawStatus === 'pass'
                        ? 'Pass'
                        : (
                            $rawStatus === 'reject'
                                ? 'Reject'
                                : '-'
                        )
                );

            return array(
                'idpo' => $item->idpo,
                'po' => $item->po,
                'style' => $styleMap->get($item->idstyle)
                    ? $styleMap->get($item->idstyle)
                    : '-',
                'color' => $colorMap->get($item->idcolor)
                    ? $colorMap->get($item->idcolor)
                    : '-',
                'buyer' => $groupBuyerId
                    ? (
                        $groupBuyerNames->get($groupBuyerId)
                            ? $groupBuyerNames->get($groupBuyerId)
                            : '-'
                    )
                    : '-',
                'qty_order' => $totalQty,
                'output' => $totalOutput,
                'progress_output' => $progressOutput,
                'etd' => $etd
                    ? Carbon::parse($etd)->format('d-m-Y')
                    : '-',
                'days_to_etd' => $daysToEtd,
                'status' => $status,
            );

        })
        // Sorting: overdue dulu (paling lama duluan), lalu need_final (paling dekat duluan),
        // final_completed di paling bawah.
        ->sort(function ($a, $b) use ($statusOrder) {
            $orderA = $statusOrder[$a['status']] ?? 99;
            $orderB = $statusOrder[$b['status']] ?? 99;

            if ($orderA !== $orderB) {
                return $orderA <=> $orderB;
            }

            return ($a['days_to_etd'] ?? PHP_INT_MAX) <=> ($b['days_to_etd'] ?? PHP_INT_MAX);
        })
        ->values();

        $totalQtyOrderAll = $data->sum('qty_order');
        $totalOutputAll   = $data->sum('output');
        $totalProgressOutputAll = $totalQtyOrderAll > 0
            ? round(($totalOutputAll / $totalQtyOrderAll) * 100, 2) : 0;

        return response()->json(array(
            'data'  => $data,
            'total' => array(
                'qty_order' => $totalQtyOrderAll, 'output' => $totalOutputAll,
                'progress_output' => $totalProgressOutputAll,
            ),
        ));
    }

    function finalOverview(Request $request)
    {
        preconnect(session('db'));

        $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
        $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

        $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
        $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

        $fi = (new OutputDetailFinalInspection())->getTable();
        $od = (new OutputDetail())->getTable();
        $po = (new PurchaseOrder())->getTable();

        $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);

        $qtyPerIdpo = $leafRows->groupBy('idpo')->map(function ($rows) {
            return (int) $rows->sum('qty_ori');
        });

        $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();

        $barcodes = OutputDetail::whereIn('idpo', $qualifiedIdpo)
            ->pluck('barcode');

        $headerQuery = OutputDetailFinalInspection::query()
            ->join($od, "$od.barcode", '=', "$fi.barcode")
            ->join($po, "$po.idpo", '=', "$od.idpo")
            ->whereIn("$fi.barcode", $barcodes);

        $finalComIdpoList = (clone $headerQuery)
            ->where("$fi.is_output", 1)
            ->select("$od.idpo")
            ->distinct()
            ->pluck("$od.idpo");

        $finalCom = $finalComIdpoList->count();

        $rejectIdpoList = (clone $headerQuery)
            ->whereIn("$od.idpo", $finalComIdpoList)
            ->whereNotNull("$fi.date_output")
            ->whereNotNull("$fi.defect_code")
            ->select("$od.idpo")
            ->distinct()
            ->pluck("$od.idpo");

        $passIdpoList = $finalComIdpoList->diff($rejectIdpoList)->values();

        $poWithDefect = $rejectIdpoList->count();
        $poNoDefect   = $passIdpoList->count();

        $qtyPass = $this->getNetCutoffQty($passIdpoList);

        $qtyReject = $this->getNetCutoffQty($rejectIdpoList);

        $qtyInspectPass = (clone $headerQuery)
            ->whereIn("$od.idpo", $passIdpoList)
            ->whereNotNull("$fi.date_output")
            ->count(DB::raw("DISTINCT $od.barcode"));

        $qtyInspectReject = (clone $headerQuery)
            ->whereIn("$od.idpo", $rejectIdpoList)
            ->whereNotNull("$fi.date_output")
            ->count(DB::raw("DISTINCT $od.barcode"));

        $so = (new SewingOutput())->getTable();

        // Not final
        $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);

        $byIdpoLeaf = $leafRows->groupBy('idpo');

        $qtyPerIdpo = array();
        $etdPerIdpo = array();
        foreach ($byIdpoLeaf as $idpo => $rows) {
            $qtyPerIdpo[$idpo] = (int) $rows->sum('qty_ori');
            $etdPerIdpo[$idpo] = $rows->max('deliverydate');
        }

        $today = Carbon::today()->startOfDay();
        $split = $this->getSplitFinalCheckIdpoList($request, $dta, $dtb, $today);

        $finalIdpoList = $split['overdue']->merge($split['need_final'])->unique()->values();

        $poList = $finalIdpoList->map(function ($idpo) use ($byIdpoLeaf) {
            $rows = $byIdpoLeaf->get($idpo);
            if (!$rows) {
                return null;
            }
            $first = $rows->first();
            return (object) array(
                'idpo' => $idpo, 'po' => $first->po, 'idbuyer' => $first->idbuyer,
                'idstyle' => $first->idstyle, 'idcolor' => $first->idcolor,
            );
        })->filter()->values();

        $idpoList = $poList->pluck('idpo')
            ->unique()
            ->values();

        $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
            ->pluck('combine_pro')
            ->filter()
            ->unique()
            ->values();

        $rows = HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
            ->select(
                'idpo',
                'combine_pro',
                'kp_item',
                'kp_item_ref',
                'revisi_kp',
                'qty_ori'
            )
            ->get();

        $ownerByCombineKpItem = $rows
            ->groupBy(fn ($r) => $r->combine_pro . '|' . $r->kp_item)
            ->map(fn ($group) => (string) $group->sortBy('idpo')->first()->idpo);

        $originalIdpoList = $rows
            ->filter(fn ($r) =>
                $r->revisi_kp == 1 &&
                !is_null($r->kp_item_ref)
            )
            ->map(function ($r) use ($ownerByCombineKpItem) {
                return $ownerByCombineKpItem->get(
                    $r->combine_pro . '|' . $r->kp_item_ref
                );
            })
            ->filter()
            ->unique()
            ->values();

        $allIdpoList = $idpoList
            ->merge($originalIdpoList)
            ->unique()
            ->values();


        $outputRows = OutputDetail::query()
            ->whereIn("$od.idpo", $allIdpoList)
            ->whereNotNull("$od.barcode")
            ->join("$so", "$so.barcode", '=', "$od.barcode")
            ->where("$so.is_output", 1)
            ->select(
                "$od.idpo",
                "$od.barcode"
            )
            ->distinct()
            ->get();

        $outputPerIdpo = $outputRows
            ->groupBy('idpo')
            ->map(function ($rows) {
                return $rows->pluck('barcode')->unique()->count();
            });

        $outputPerIdpo = $this->redistributeReroutedOutput($idpoList, $outputPerIdpo);

        $notFinalIdpoList = $idpoList;

        // $qtyInspectNotFinal = (clone $headerQuery)
        //     ->whereIn("$od.idpo", $notFinalIdpoList)
        //     ->whereNotNull("$fi.date_output")
        //     ->count(DB::raw("DISTINCT $od.barcode"));

        $qtyInspectNotFinal = 0;

        $getOutputCount = function ($idpoList) use ($od, $so) {
            return OutputDetail::query()
                ->whereIn("$od.idpo", $idpoList)
                ->whereNotNull("$od.barcode")
                ->join("$so", "$so.barcode", '=', "$od.barcode")
                ->where("$so.is_output", 1)
                ->select("$od.barcode")
                ->distinct()
                ->count();
        };

        $outputPass     = $getOutputCount($passIdpoList);
        $outputReject   = $getOutputCount($rejectIdpoList);
        $outputNotFinal = $outputPerIdpo->sum();

        $qtyNotFinal = $this->getNetCutoffQty($notFinalIdpoList);

        // ===== Progress output per bucket =====
        $progressPass = $qtyPass > 0
            ? round(($outputPass / $qtyPass) * 100, 2)
            : 0;

        $progressReject = $qtyReject > 0
            ? round(($outputReject / $qtyReject) * 100, 2)
            : 0;

        $progressNotFinal = $qtyNotFinal > 0
            ? round(($outputNotFinal / $qtyNotFinal) * 100, 2)
            : 0;

        // Total
        $totalPoAll = $poNoDefect + $poWithDefect + $notFinalIdpoList->count();

        $totalQtyOrderAll = $qtyPass + $qtyReject + $qtyNotFinal;

        $totalQtyInspectAll = $qtyInspectPass + $qtyInspectReject;

        $totalOutputAll = $outputPass + $outputReject + $outputNotFinal;

        $totalProgressOutputAll = $totalQtyOrderAll > 0
            ? round(($totalOutputAll / $totalQtyOrderAll) * 100, 2)
            : 0;

        return response()->json([
            'data' => [[
                'pass' => [
                    'count'           => $poNoDefect,
                    'qty'             => $qtyPass,
                    'qty_inspect'     => $qtyInspectPass,
                    'output'          => $outputPass,
                    'progress_output' => $progressPass,
                ],
                'reject' => [
                    'count'           => $poWithDefect,
                    'qty'             => $qtyReject,
                    'qty_inspect'     => $qtyInspectReject,
                    'output'          => $outputReject,
                    'progress_output' => $progressReject,
                ],
                'not_final' => [
                    'count'           => $notFinalIdpoList->count(),
                    'qty'             => $qtyNotFinal,
                    'qty_inspect'     => $qtyInspectNotFinal,
                    'output'          => $outputNotFinal,
                    'progress_output' => $progressNotFinal,
                ],
                'total' => [
                    'total_po'        => $totalPoAll,
                    'qty_order'       => $totalQtyOrderAll ? $totalQtyOrderAll : 0,
                    'qty_inspect'     => $totalQtyInspectAll ? $totalQtyInspectAll : 0,
                    'output'          => $totalOutputAll ? $totalOutputAll : 0,
                    'progress_output' => $totalProgressOutputAll,
                ],
            ]]
        ]);
    }

