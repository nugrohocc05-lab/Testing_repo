  function loadTableTopDefect(filter) {
            $.ajax({
                url: "{{ route('monitoring_finalinspection_topdefect') }}",
                type: "GET",
                data: filter,

                success: function (response) {
                    let rows = response.data || [];
                    let total = response.total || {};

                    let $body = $('#tableDefectFinalBody');
                    $body.empty();

                    if (rows.length === 0) {
                        $body.append(
                            '<tr><td colspan="12" class="text-center">No Data</td></tr>'
                        );
                    } else {
                        rows.forEach(function (row, idx) {
                            $body.append(`
                                <tr>
                                    <td class="text-center">${idx + 1}</td>
                                    <td class="text-center">${row.data ?? '-'}</td>
                                    <td class="text-center">-</td>
                                    <td class="text-center">-</td>
                                    <td class="text-center">-</td>
                                </tr>
                            `);
                        });
                    }

                    // Update footer
                    $('#footQtyOrder').text(
                        (total.qty_order ?? 0).toLocaleString()
                    );

                    $('#footOutput').text(
                        (total.output ?? 0).toLocaleString()
                    );

                    $('#footProgressOutput').text(
                        (total.progress_output ?? 0) + '%'
                    );
                },

                error: function (xhr) {
                    console.log(xhr.responseText);
                }
            });
        }
