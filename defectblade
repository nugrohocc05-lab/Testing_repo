    static function getReroutePO(string $idpo)
    {
        preconnect(session('db'));

        try {
            // Ambil original_pro dari PO lama
            $originalPro = HistoryDataBreakdown::query()
                ->where('idpo', $idpo)
                ->whereNotNull('original_pro')
                ->distinct()
                ->pluck('original_pro');

            if ($originalPro->isEmpty()) {
                return collect();
            }

            // Ambil kp_item dari data cutoff
            $cutoffItems = HistoryDataBreakdown::query()
                ->whereIn('original_pro', $originalPro)
                ->where('is_cutoff', 1)
                ->pluck('kp_item')
                ->filter()
                ->unique();

            if ($cutoffItems->isEmpty()) {
                return collect();
            }

            // Cari PO yang menggunakan kp_item_ref dari PO lama
            return HistoryDataBreakdown::query()
                ->whereIn('original_pro', $originalPro)
                ->whereIn('kp_item_ref', $cutoffItems)
                ->where('idpo', '!=', $idpo)
                ->select([
                    'idpo',
                    'original_pro',
                    'kp_item',
                    'kp_item_ref',
                    'qty_ori',
                ])
                ->distinct()
                ->get();

        } catch (\Throwable $e) {
            return collect();
        }
    }

    /**
     * Memecah rentang [dta, dtb]
     * berdasarkan posisi $today, sesuai acuan "Based on ETD" :
     *   - Overdue    = ETD dalam [dta, dtb] DAN ETD <= today (termasuk hari ini)
     *   - Need Final = ETD dalam [dta, dtb] DAN ETD >  today (strict, tidak termasuk hari ini)
     */
    private function splitOverdueNeedFinalRange(Carbon $dta, Carbon $dtb, Carbon $today): array
    {
        $todayEnd      = $today->copy()->endOfDay();             // batas atas overdue (inklusif hari ini)
        $tomorrowStart = $today->copy()->addDay()->startOfDay(); // batas bawah need_final

        // Irisan [dta, dtb] dengan (-∞, todayEnd]
        $overdueFrom = $dta->copy();
        $overdueTo   = $dtb->lessThan($todayEnd) ? $dtb->copy() : $todayEnd;

        // Irisan [dta, dtb] dengan [tomorrowStart, +∞)
        $needFinalFrom = $dta->greaterThan($tomorrowStart) ? $dta->copy() : $tomorrowStart;
        $needFinalTo   = $dtb->copy();

        return [
            'overdue'    => $overdueFrom->lessThanOrEqualTo($overdueTo)
                ? [$overdueFrom, $overdueTo] : null,
            'need_final' => $needFinalFrom->lessThanOrEqualTo($needFinalTo)
                ? [$needFinalFrom, $needFinalTo] : null,
        ];
    }

    private function getSplitFinalCheckIdpoList(Request $request, Carbon $dta, Carbon $dtb, Carbon $today): array
    {
        $fi  = (new OutputDetailFinalInspection())->getTable();
        $od  = (new OutputDetail())->getTable();
        $po  = (new PurchaseOrder())->getTable();
        $dbr = (new HistoryDataBreakdown())->getTable();

        // Leaf rows dihitung SEKALI atas seluruh [dta, dtb], bukan per sub-rentang.
        $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);

        $qtyPerIdpo = $leafRows->groupBy('idpo')->map(function ($rows) {
            return (int) $rows->sum('qty_ori');
        });

        $etdPerIdpo = $leafRows->groupBy('idpo')->map(function ($rows) {
            return $rows->max('deliverydate');
        });

        $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();

        $effectiveIdpoSql = function () use ($dbr) {
            return "(CASE WHEN $dbr.revisi_kp = 1 AND $dbr.kp_item_ref IS NOT NULL
                THEN (SELECT dbr_prev.idpo FROM $dbr as dbr_prev
                    WHERE dbr_prev.combine_pro = $dbr.combine_pro
                        AND dbr_prev.idpo < $dbr.idpo
                    ORDER BY dbr_prev.idpo DESC LIMIT 1)
                ELSE $dbr.idpo END)";
        };

        $requireHasFinalRecord = function ($query) use ($fi, $od, $effectiveIdpoSql) {
            $expr = $effectiveIdpoSql();
            $query->whereExists(function ($q) use ($fi, $od, $expr) {
                $q->select(DB::raw(1))
                    ->from("$fi as fi3")
                    ->join("$od as od3", "od3.barcode", '=', 'fi3.barcode')
                    ->whereRaw("od3.idpo = $expr");
            });
            return $query;
        };

        $excludeIfAnyFinalEffective = function ($query) use ($fi, $od, $effectiveIdpoSql) {
            $expr = $effectiveIdpoSql();
            $query->whereNotExists(function ($q) use ($fi, $od, $expr) {
                $q->select(DB::raw(1))
                    ->from("$fi as fi2")
                    ->join("$od as od2", "od2.barcode", '=', 'fi2.barcode')
                    ->whereRaw("od2.idpo = $expr")
                    ->where('fi2.is_output', 1);
            });
            return $query;
        };

        $query = HistoryDataBreakdown::query()
            ->join($po, "$po.idpo", '=', "$dbr.idpo")
            ->whereIn("$dbr.idpo", $qualifiedIdpo);

        $requireHasFinalRecord($query);
        $excludeIfAnyFinalEffective($query);

        $candidateIdpoList = $query->select("$dbr.idpo")->distinct()->pluck('idpo');

        // ===== Reroute dedup SEKALI di batch gabungan (bukan per sub-rentang) =====
        $dedupedIdpoList = $this->resolveRerouteDuplicates($candidateIdpoList);

        // ===== Baru sekarang dipecah overdue vs need_final berdasarkan ETD masing2 idpo =====
        $overdue   = collect();
        $needFinal = collect();

        foreach ($dedupedIdpoList as $idpo) {
            $etd = $etdPerIdpo->get($idpo);
            if (!$etd) {
                continue;
            }
            $etdDate = Carbon::parse($etd)->startOfDay();
            if ($etdDate->lessThanOrEqualTo($today)) {
                $overdue->push($idpo);
            } else {
                $needFinal->push($idpo);
            }
        }

        return [
            'overdue'    => $overdue->values(),
            'need_final' => $needFinal->values(),
        ];
    }

