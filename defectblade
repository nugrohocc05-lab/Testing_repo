function loadTableTopDefect(filter) {
    $.ajax({
        url: "{{ route('monitoring_finalinspection_topdefect') }}",
        type: "GET",
        data: filter,

        success: function (response) {
            let rows = response.data || [];
            let totalDefect = response.total_defect || 0;

            let $body = $('#tableDefectFinalBody');
            $body.empty();

            if (rows.length === 0) {
                $body.append(
                    '<tr><td colspan="6" class="text-center">No Data</td></tr>'
                );
            } else {
                rows.forEach(function (row, idx) {
                    let pct = row.percentage ?? 0;

                    $body.append(`
                        <tr>
                            <td class="text-center">${idx + 1}</td>
                            <td class="text-center">${row.defect_code ?? '-'}</td>
                            <td class="text-left">${row.defect_name ?? '-'}</td>
                            <td class="text-center">${(row.qty ?? 0).toLocaleString()}</td>
                            <td class="text-center">${pct}%</td>
                            <td>
                                <div style="background:#e9ecef; border-radius:4px; width:100%; height:14px; overflow:hidden;">
                                    <div style="background:#0d6efd; width:${pct}%; height:100%;"></div>
                                </div>
                            </td>
                        </tr>
                    `);
                });
            }

            // Update footer
            $('#footTotalDefect').text(
                totalDefect.toLocaleString()
            );
        },

        error: function (xhr) {
            console.log(xhr.responseText);
        }
    });
}

