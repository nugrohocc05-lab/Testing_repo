    function poSelect(Request $request)
    {
        preconnect(session('db'));

        $page = (int) $request->get('page', 1);

        $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
        $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

        $dta = $dateA->lessThanOrEqualTo($dateB)
            ? $dateA
            : $dateB;

        $dtb = $dateA->lessThanOrEqualTo($dateB)
            ? $dateB->copy()->endOfDay()
            : $dateA->copy()->endOfDay();

        $leafRows = $this->getLeafHistoryRows(
            $request,
            'combine_pro',
            true, // HARUS sama dengan priorityFinal
            $dta,
            $dtb
        );

        $byIdpoLeaf = $leafRows->groupBy('idpo');

        $qtyPerIdpo = $byIdpoLeaf->map(function ($rows) {
            return (int) $rows->sum('qty_ori');
        });

        $qualifiedIdpo = $qtyPerIdpo
            ->filter(fn ($qty) => $qty > 0)
            ->keys()
            ->values();

        /*
        * ============================
        * LOGIC SAMA DENGAN priorityFinal
        * ============================
        */

        $today = Carbon::today()->startOfDay();

        $split = $this->getSplitFinalCheckIdpoList(
            $request,
            $dta,
            $dtb,
            $today
        );

        $fi  = (new OutputDetailFinalInspection())->getTable();
        $od  = (new OutputDetail())->getTable();
        $po  = (new PurchaseOrder())->getTable();

        $barcodesForHeader = OutputDetail::whereIn(
            'idpo',
            $qualifiedIdpo
        )->pluck('barcode');

        $headerQuery = OutputDetailFinalInspection::query()
            ->join($od, "$od.barcode", '=', "$fi.barcode")
            ->join($po, "$po.idpo", '=', "$od.idpo")
            ->whereIn("$fi.barcode", $barcodesForHeader);

        $finalComIdpoList = (clone $headerQuery)
            ->where("$fi.is_output", 1)
            ->select("$od.idpo")
            ->distinct()
            ->pluck("$od.idpo");

        /*
        * PO yang ditampilkan harus sama dengan priorityFinal
        */
        $finalIdpoList = $split['overdue']
            ->merge($split['need_final'])
            ->merge($finalComIdpoList)
            ->unique()
            ->values();

        /*
        * Ambil PO dari leafRows
        */
        $poRows = $leafRows
            ->whereIn('idpo', $finalIdpoList)
            ->unique('idpo')
            ->values();

        /*
        * Search
        */
        if ($request->filled('q')) {
            $poRows = $poRows
                ->filter(function ($row) use ($request) {
                    return stripos($row->po, $request->q) !== false;
                })
                ->values();
        }

        /*
        * Pagination
        */
        $total = $poRows->count();

        $items = $poRows
            ->forPage($page, $this->perPage)
            ->values();

        return response()->json([
            'results' => $items->map(function ($item) {
                return [
                    'id'   => $item->idpo,
                    'text' => $item->po,
                ];
            })->values(),

            'pagination' => [
                'more' => ($page * $this->perPage) < $total,
            ],
        ]);
    }


    static function getReroutePO(string $idpo)
    {
        preconnect(session('db'));

        try {
            // Ambil original_pro dari PO lama
            $originalPro = HistoryDataBreakdown::query()
                ->where('idpo', $idpo)
                ->whereNotNull('original_pro')
                ->distinct()
                ->pluck('original_pro');

            if ($originalPro->isEmpty()) {
                return collect();
            }

            // Ambil kp_item dari data cutoff
            $cutoffItems = HistoryDataBreakdown::query()
                ->whereIn('original_pro', $originalPro)
                ->where('is_cutoff', 1)
                ->pluck('kp_item')
                ->filter()
                ->unique();

            if ($cutoffItems->isEmpty()) {
                return collect();
            }

            // Cari PO yang menggunakan kp_item_ref dari PO lama
            return HistoryDataBreakdown::query()
                ->whereIn('original_pro', $originalPro)
                ->whereIn('kp_item_ref', $cutoffItems)
                ->where('idpo', '!=', $idpo)
                ->select([
                    'idpo',
                    'original_pro',
                    'kp_item',
                    'kp_item_ref',
                    'qty_ori',
                ])
                ->distinct()
                ->get();

        } catch (\Throwable $e) {
            return collect();
        }
    }

    private function splitOverdueNeedFinalRange(Carbon $dta, Carbon $dtb, Carbon $today): array
    {
        $todayEnd      = $today->copy()->endOfDay();
        $tomorrowStart = $today->copy()->addDay()->startOfDay();

        $overdueFrom = $dta->copy();
        $overdueTo   = $dtb->lessThan($todayEnd) ? $dtb->copy() : $todayEnd;

        $needFinalFrom = $dta->greaterThan($tomorrowStart) ? $dta->copy() : $tomorrowStart;
        $needFinalTo   = $dtb->copy();

        return [
            'overdue'    => $overdueFrom->lessThanOrEqualTo($overdueTo)
                ? [$overdueFrom, $overdueTo] : null,
            'need_final' => $needFinalFrom->lessThanOrEqualTo($needFinalTo)
                ? [$needFinalFrom, $needFinalTo] : null,
        ];
    }

    private function getSplitFinalCheckIdpoList(Request $request, Carbon $dta, Carbon $dtb, Carbon $today): array
    {
        $fi  = (new OutputDetailFinalInspection())->getTable();
        $od  = (new OutputDetail())->getTable();
        $po  = (new PurchaseOrder())->getTable();
        $dbr = (new HistoryDataBreakdown())->getTable();

        // Leaf rows dihitung SEKALI atas seluruh [dta, dtb], bukan per sub-rentang.
        $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);

        $qtyPerIdpo = $leafRows->groupBy('idpo')->map(function ($rows) {
            return (int) $rows->sum('qty_ori');
        });

        $etdPerIdpo = $leafRows->groupBy('idpo')->map(function ($rows) {
            return $rows->max('deliverydate');
        });

        $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();

        $effectiveIdpoSql = function () use ($dbr) {
            return "(CASE WHEN $dbr.revisi_kp = 1 AND $dbr.kp_item_ref IS NOT NULL
                THEN (SELECT dbr_prev.idpo FROM $dbr as dbr_prev
                    WHERE dbr_prev.combine_pro = $dbr.combine_pro
                        AND dbr_prev.idpo < $dbr.idpo
                    ORDER BY dbr_prev.idpo DESC LIMIT 1)
                ELSE $dbr.idpo END)";
        };

        $requireHasFinalRecord = function ($query) use ($fi, $od, $effectiveIdpoSql) {
            $expr = $effectiveIdpoSql();
            $query->whereExists(function ($q) use ($fi, $od, $expr) {
                $q->select(DB::raw(1))
                    ->from("$fi as fi3")
                    ->join("$od as od3", "od3.barcode", '=', 'fi3.barcode')
                    ->whereRaw("od3.idpo = $expr");
            });
            return $query;
        };

        $excludeIfAnyFinalEffective = function ($query) use ($fi, $od, $effectiveIdpoSql) {
            $expr = $effectiveIdpoSql();
            $query->whereNotExists(function ($q) use ($fi, $od, $expr) {
                $q->select(DB::raw(1))
                    ->from("$fi as fi2")
                    ->join("$od as od2", "od2.barcode", '=', 'fi2.barcode')
                    ->whereRaw("od2.idpo = $expr")
                    ->where('fi2.is_output', 1);
            });
            return $query;
        };

        $query = HistoryDataBreakdown::query()
            ->join($po, "$po.idpo", '=', "$dbr.idpo")
            ->whereIn("$dbr.idpo", $qualifiedIdpo);

        $requireHasFinalRecord($query);
        $excludeIfAnyFinalEffective($query);

        $candidateIdpoList = $query->select("$dbr.idpo")->distinct()->pluck('idpo');

        $dedupedIdpoList = $this->resolveRerouteDuplicates($candidateIdpoList);

        $overdue   = collect();
        $needFinal = collect();

        // foreach ($dedupedIdpoList as $idpo) {
        //     $etd = $etdPerIdpo->get($idpo);

        //     if (!$etd) {
        //         continue;
        //     }

        //     $etdDate = Carbon::parse($etd)->startOfDay();

        //     if ($etdDate->lessThanOrEqualTo($today)) {
        //         // Hitung berapa hari sudah overdue
        //         $overdueDays = $etdDate->diffInDays($today);

        //         // Maksimal 7 hari overdue
        //         if ($overdueDays <= 7) {
        //             $overdue->push($idpo);
        //         }

        //         // Lebih dari 7 hari → tidak dimasukkan
        //         continue;
        //     }

        //     // Delivery date masih di masa depan
        //     $needFinal->push($idpo);
        // }

        foreach ($dedupedIdpoList as $idpo) {
            $etd = $etdPerIdpo->get($idpo);

            if (!$etd) {
                continue;
            }
            $etdDate = Carbon::parse($etd)->startOfDay();

            $overdueLimit = $today->copy()->addDay();

            if ($etdDate->lessThanOrEqualTo($overdueLimit)) {
                $overdue->push($idpo);

                continue;
            }

            $needFinal->push($idpo);

        }

        return [
            'overdue'    => $overdue->values(),
            'need_final' => $needFinal->values(),
        ];
    }

    private function resolveActiveRerouteIdpoList($idpoList)
    {
        $idpoList = collect($idpoList)
            ->filter()
            ->unique()
            ->values();

        if ($idpoList->isEmpty()) {
            return collect();
        }

        /*
        * Cari combine_pro dari IDPO yang masuk priority.
        */
        $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
            ->pluck('combine_pro')
            ->filter()
            ->unique()
            ->values();

        if ($combineProList->isEmpty()) {
            return $idpoList;
        }

        /*
        * Cari semua IDPO yang berada dalam combine_pro
        * yang sama.
        */
        $allIdpo = HistoryDataBreakdown::whereIn(
            'combine_pro',
            $combineProList
        )
            ->pluck('idpo')
            ->filter()
            ->unique()
            ->values();

        /*
        * Ambil HistoryPO.
        */
        $historyRows = HistoryPO::whereIn('idpo', $allIdpo)
            ->orderBy('idpo')
            ->orderByDesc('revisi')
            ->get([
                'idpo',
                'revisi',
                'qtypo',
            ]);

        /*
        * Ambil revisi TERBESAR setiap IDPO.
        */
        $lastHistory = $historyRows
            ->groupBy('idpo')
            ->map(function ($rows) {
                return $rows
                    ->sortByDesc('revisi')
                    ->first();
            });

        /*
        * Hanya IDPO dengan qtypo terakhir > 0
        * yang dianggap aktif.
        */
        $activeIdpo = $lastHistory
            ->filter(function ($row) {
                return (int) $row->qtypo > 0;
            })
            ->keys()
            ->values();

        /*
        * Kalau tidak ketemu history aktif,
        * jangan sampai PO hilang.
        */
        if ($activeIdpo->isEmpty()) {
            return $idpoList;
        }

        return $activeIdpo;
    }


