private function buildPriorityFinalAdditionalData(Collection $idpoList): Collection
{
    $fi = (new OutputDetailFinalInspection())->getTable();
    $od = (new OutputDetail())->getTable();

    if ($idpoList->isEmpty()) {
        return collect();
    }

    $rows = OutputDetailFinalInspection::query()
        ->join($od, "$od.barcode", '=', "$fi.barcode")
        ->whereIn("$od.idpo", $idpoList)
        ->whereNotNull("$fi.date_output")
        ->select("$od.idpo", "$od.idcolor", "$fi.id as fi_id", "$fi.barcode", "$fi.defect_code")
        ->distinct()
        ->get();

    $keyOf = fn ($r) => $r->idpo . '|' . $r->idcolor;

    $qtyInspectMap = $rows->groupBy($keyOf)
        ->map(fn ($g) => $g->pluck('barcode')->unique()->count());

    $defectRows = $rows->whereNotNull('defect_code');

    $defectQtyMap = $defectRows->groupBy($keyOf)
        ->map(fn ($g) => $g->pluck('fi_id')->unique()->count());

    // defect terbanyak per idpo+idcolor dipakai sbg representasi defect_name/category
    $topDefectCodeMap = $defectRows->groupBy($keyOf)
        ->map(fn ($g) => $g->groupBy('defect_code')->map->count()->sortDesc()->keys()->first());

    $defectCodes = $topDefectCodeMap->filter()->unique()->values();
    $defectNames = QCDefect::whereIn('kdcacat', $defectCodes)->pluck('deskripsi', 'kdcacat');
    $defectCategories = QCDefect::whereIn('kdcacat', $defectCodes)->pluck('category', 'kdcacat');

    $result = collect();
    foreach ($qtyInspectMap as $key => $qty) {
        $code = $topDefectCodeMap->get($key);
        $result->put($key, [
            'qty_inspect' => $qty,
            'defect_qty' => $defectQtyMap->get($key, 0),
            'defect_name' => $code ? ($defectNames->get($code) ?: $code) : '-',
            'defect_category' => $code
                ? ((int) $defectCategories->get($code, 0) === 1 ? 'Process' : 'Non Process')
                : '-',
        ]);
    }

    return $result;
}

function exportData(Request $request)
{
    preconnect(session('db'));

    $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
    $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();
    $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
    $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

    $summary = $this->buildSummaryFilterData($request, $dta, $dtb);
    $priorityFinal = $this->buildPriorityFinalData($request, $dta, $dtb);
    $overview = $this->buildFinalOverviewData($request, $dta, $dtb);
    $topDefects = $this->buildTopDefectsData($request, $dta, $dtb);

    $idpoList = $priorityFinal['data']->pluck('idpo')->unique()->values();
    $additionalMap = $this->buildPriorityFinalAdditionalData($idpoList);

    $priorityFinalData = $priorityFinal['data']->map(function ($item) use ($additionalMap) {
        $key = $item['idpo'] . '|' . $item['idcolor'];
        $extra = $additionalMap->get($key, [
            'qty_inspect' => 0, 'defect_qty' => 0, 'defect_name' => '-', 'defect_category' => '-',
        ]);
        return array_merge($item, $extra);
    })->values();

    $filterInfo = [
        'periode' => $dta->format('d-m-Y') . ' s/d ' . $dtb->format('d-m-Y'),
        'groupbuyer' => $this->resolveFilterLabel(
            $request->groupbuyer,
            fn($ids) => MasterGroupBuyer::whereIn('id', $ids)->pluck('group_name')
        ),
        'style' => $this->resolveFilterLabel(
            $request->style,
            fn($ids) => Style::whereIn('idstyle', $ids)->pluck('nmstyle')
        ),
        'po' => $this->resolveFilterLabel(
            $request->po,
            fn($ids) => PurchaseOrder::whereIn('idpo', $ids)->pluck('po')
        ),
    ];

    $payload = [
        'filter' => $filterInfo,
        'summary' => $summary,
        'detail_po' => $priorityFinalData,
        'detail_po_total' => $priorityFinal['total'],
        'overview' => [
            'pass' => $overview['pass'],
            'reject' => $overview['reject'],
            'need_final' => $overview['not_final'],
            'total' => $overview['total'],
        ],
        'top_defects' => [
            'data' => $topDefects['data'],
            'total_defect' => $topDefects['total_defect'],
            'process' => $topDefects['process'],
            'non_process' => $topDefects['non_process'],
            'non_process_no_grade' => $topDefects['non_process_no_grade'],
            'process_percent' => $topDefects['process_percent'],
            'non_process_percent' => $topDefects['non_process_percent'],
        ],
    ];

    if ($request->query('format') === 'json') {
        return response()->json($payload);
    }

    return view('monitoring::finalinspection.partials.exportdatatable', $payload);
}