        $nonProcess = (int) $priorityFinalData->sum('non_process');

        $priorityFinalTotal = [
            'qty_order' => $qtyOrder,

            'output' => $output,

            'progress_output' => $qtyOrder > 0
                ? round(($output / $qtyOrder) * 100, 2)
                : 0,

            'qty_inspect' => $qtyInspect,

            'defect_qty' => $defectQty,

            'process' => $process,

            'non_process' => $nonProcess,

            'process_percentage' => $defectQty > 0
                ? round(($process / $defectQty) * 100, 2)
                : 0,

            'non_process_percentage' => $defectQty > 0
                ? round(($nonProcess / $defectQty) * 100, 2)
                : 0,
        ];


        $filterInfo = [
            'periode' => $dta->format('d-m-Y') . ' s/d ' . $dtb->format('d-m-Y'),
            'groupbuyer' => $this->resolveFilterLabel(
