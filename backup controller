    private function resolveFilterLabel($value, ?callable $lookup): string
    {
        if (empty($value) || $value === 'all') {
            return 'All';
        }

        $values = is_array($value) ? $value : [$value];

        if ($lookup) {
            $labels = $lookup($values);
            return $labels->isNotEmpty() ? $labels->implode(', ') : implode(', ', $values);
        }

        return implode(', ', $values);
    }

