use App\Http\Models\HistoryPO;

/**
 * Kalau idpo X sudah di-reroute ke idpo Y (via kp_item_ref, combine_pro sama),
 * cek qtypo di revisi terbesar HistoryPO milik X:
 * - qtypo = 0  -> buang X dari list, pakai Y saja
 * - qtypo != 0 -> X dan Y tetap dua-duanya
 */
private function resolveRerouteDuplicates(Collection $idpoList): Collection
{
    if ($idpoList->isEmpty()) {
        return $idpoList;
    }

    $rows = HistoryDataBreakdown::whereIn('idpo', $idpoList)
        ->select('idpo', 'combine_pro', 'kp_item', 'kp_item_ref', 'revisi_kp')
        ->get();

    // Siapa "pemilik asli" tiap kp_item dalam combine_pro yang sama (idpo terkecil)
    $ownerByCombineKpItem = $rows
        ->groupBy(fn ($r) => $r->combine_pro . '|' . $r->kp_item)
        ->map(fn ($group) => $group->sortBy('idpo')->first()->idpo);

    // Pasangan reroute: idpo baru (revisi_kp=1, ada ref) -> idpo asli
    $reroutedPairs = $rows
        ->filter(fn ($r) => $r->revisi_kp == 1 && !is_null($r->kp_item_ref))
        ->map(function ($r) use ($ownerByCombineKpItem) {
            $originalIdpo = $ownerByCombineKpItem->get($r->combine_pro . '|' . $r->kp_item_ref);
            return ($originalIdpo && $originalIdpo != $r->idpo)
                ? ['original' => $originalIdpo, 'rerouted' => $r->idpo]
                : null;
        })
        ->filter()
        ->unique(fn ($p) => $p['original'] . '|' . $p['rerouted'])
        ->values();

    $excludedOriginals = collect();

    foreach ($reroutedPairs as $pair) {
        $maxRevisiRow = HistoryPO::where('idpo', $pair['original'])
            ->orderByDesc('revisi')
            ->first();

        if ($maxRevisiRow && (int) $maxRevisiRow->qtypo === 0) {
            $excludedOriginals->push($pair['original']);
        }
    }

    return $idpoList->diff($excludedOriginals)->values();
}



