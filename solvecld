$dbr = (new HistoryDataBreakdown())->getTable();

$missingIdpo = ['0051931', '0051935', '0051945'];

// Ambil combine_pro dari masing-masing idpo yang hilang
$missingCombinePro = HistoryDataBreakdown::whereIn('idpo', $missingIdpo)
    ->pluck('combine_pro', 'idpo');

// Ambil SEMUA row (lintas idpo, tanpa filter tanggal) yang combine_pro-nya sama
// dengan salah satu dari 3 idpo yang hilang ini
$siblingRows = HistoryDataBreakdown::whereIn('combine_pro', $missingCombinePro->values())
    ->select(
        'idpo', 'idcolor', 'kp_item', 'kp_item_ref',
        'revisi_kp', 'combine_pro', 'production_status',
        'qty_ori', 'deliverydate'
    )
    ->orderBy('combine_pro')
    ->orderBy('idpo')
    ->get();

dd([
    'missing_combine_pro_map' => $missingCombinePro,
    'sibling_rows_same_family' => $siblingRows,
]);