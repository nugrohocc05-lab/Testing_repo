@media (min-width: 992px) and (max-width: 1399.98px) {
        .subheader { font-size: 0.60rem; }

        .wrapper-sub {
            margin: 1px 2px;
        }
    }

    @media (min-width: 1400px) {
        .subheader { font-size: 0.9rem; }
    }

    /* Kunci ukuran filter, stat cards, footer agar tidak ikut terkompres.
       Hanya area tengah (tabel + chart) yang boleh menyusut & scroll sendiri. */
    .dashboard-wrap > .row.margin-cstm,
    .dashboard-wrap > .row.card-wrapper,
    .dashboard-wrap > .footer-title {
        flex-shrink: 0;
    }

    /* Tinggi chart donut responsif per breakpoint */
    .chart-donut { height: 158px; }

    @media (min-width: 992px) and (max-width: 1399.98px) {
        .chart-donut { height: 120px; }
    }

    @media (max-width: 768px) {
        .chart-donut { height: 180px; }
    }


