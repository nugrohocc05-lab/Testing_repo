// ===== Total keseluruhan (pass + reject + not_final) =====
$totalPoAll = $poNoDefect + $poWithDefect + $notFinalIdpoList->count();

$totalQtyOrderAll = $qtyPass + $qtyReject + $qtyNotFinal;

$totalQtyInspectAll = $qtyInspectPass + $qtyInspectReject; // not_final belum diinspeksi final, jadi 0 kontribusinya

$totalOutputAll = $outputPass + $outputReject + $outputNotFinal;

$totalProgressOutputAll = $totalQtyOrderAll > 0
    ? round(($totalOutputAll / $totalQtyOrderAll) * 100, 2)
    : 0;


return response()->json([
    'data' => [[
        'pass' => [
            'count'           => $poNoDefect,
            'qty'             => $qtyPass,
            'qty_inspect'     => $qtyInspectPass,
            'output'          => $outputPass,
            'progress_output' => $progressPass,
        ],
        'reject' => [
            'count'           => $poWithDefect,
            'qty'             => $qtyReject,
            'qty_inspect'     => $qtyInspectReject,
            'output'          => $outputReject,
            'progress_output' => $progressReject,
        ],
        'not_final' => [
            'count'           => $notFinalIdpoList->count(),
            'qty'             => $qtyNotFinal,
            'output'          => $outputNotFinal,
            'progress_output' => $progressNotFinal,
        ],
        'total' => [
            'total_po'        => $totalPoAll,
            'qty_order'       => $totalQtyOrderAll,
            'qty_inspect'     => $totalQtyInspectAll,
            'output'          => $totalOutputAll,
            'progress_output' => $totalProgressOutputAll,
        ],
    ]]
]);