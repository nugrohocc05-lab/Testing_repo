    /* =========================================
       UNIFIED DATATABLE STYLES 
       ========================================= */
    .border-custom-datatable {
        display: flex;
        flex-direction: column;
        min-height: 0;
        min-width: 0;
        width: 100%;
        flex: 1 1 auto;
        overflow: hidden;
    }

    .wrapper-sub {
        display: flex;
        flex-direction: column;
        min-height: 0;
        min-width: 0;
        width: 100%;
        flex: 1 1 auto;
        overflow: hidden;
        margin: 5px; /* Margin default */
    }

    .table-scroll-wrapper {
        flex: 1 1 auto;
        min-height: 0;
        min-width: 0;
        width: 100%;
        overflow-y: auto;
        overflow-x: auto;
    }

    /* Lebar minimum agar tabel bisa di-scroll horizontal di layar kecil */
    .table-progress { min-width: 1050px; }
    .table-overview { min-width: 600px; }

    .table-res {
        width: 100%;
        margin-bottom: 0;
        table-layout: fixed;
        border-collapse: collapse;
    }

    .table-res thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background-color: #1B2331;
        vertical-align: middle;
        word-wrap: break-word;
        font-weight: 400;
        font-size: 12px;
        padding: 0.75rem 0.5rem;
        line-height: 12px !important;
    }

    .table-res tbody td {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
        padding: 0.5rem;
        font-weight: 400;
        font-size: 12px;
        line-height: 25px !important;
    }

    .table-res tfoot th {
        position: sticky;
        bottom: 0;
        z-index: 2;
        background-color: #1B2331;
        font-weight: 600;
        font-size: 14px;
        line-height: 12px !important;
        padding: 0.75rem 0.5rem;
    }

    @media (min-width: 992px) and (max-width: 1399.98px) {
        .wrapper-sub { margin: 1px 2px; }
        .table-res thead th { font-size: 11px; padding: 0.4rem 0.25rem; }
        .table-res tbody td { font-size: 11px; line-height: 24px; padding: 0.4rem 0.25rem; }
        .table-res tfoot th { font-size: 12px; line-height: 24px; padding: 0.4rem 0.25rem; }
    }

    @media (min-width: 1400px) {
        .wrapper-sub { margin: 10px 12px; }
    }
