// ===== STEP 1-2 (sama seperti priorityFinal): leaf rows -> qty per idpo =====
$leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);

$qtyPerIdpo = $leafRows->groupBy('idpo')->map(function ($rows) {
    return (int) $rows->sum('qty_ori');
});

$qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();

// ===== DEBUG: bandingkan leaf vs raw (sebelum dedup) =====
$dbr = (new HistoryDataBreakdown())->getTable();
$po  = (new PurchaseOrder())->getTable();

// Semua idpo yang PUNYA row dalam range tanggal & IH, TANPA dedup leaf
$rawIdpoInRange = HistoryDataBreakdown::query()
    ->join($po, "$po.idpo", '=', "$dbr.idpo")
    ->where("$dbr.production_status", "IH")
    ->whereBetween("$dbr.deliverydate", [$dta, $dtb])
    ->when($request->filled('groupbuyer') && $request->groupbuyer !== 'all', function ($q) use ($request) {
        $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');
        $q->whereIn("$po.idbuyer", $buyerIds);
    })
    ->select("$dbr.idpo")
    ->distinct()
    ->pluck('idpo');

// Idpo yang hilang gara-gara qty leaf = 0 atau ke-dedup habis
$missingFromLeaf = $rawIdpoInRange->diff($qtyPerIdpo->keys());

// Idpo yang qty-nya 0 (lolos jadi row leaf tapi qty_ori totalnya 0)
$zeroQtyIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty <= 0)->keys()->values();

// Untuk tiap idpo yang hilang, tampilkan raw row-nya biar kelihatan kenapa dibuang
$missingRawRows = HistoryDataBreakdown::query()
    ->join($po, "$po.idpo", '=', "$dbr.idpo")
    ->whereIn("$dbr.idpo", $missingFromLeaf)
    ->select(
        "$dbr.idpo", "$dbr.idcolor", "$dbr.kp_item", "$dbr.kp_item_ref",
        "$dbr.revisi_kp", "$dbr.combine_pro", "$dbr.production_status",
        "$dbr.qty_ori", "$dbr.deliverydate"
    )
    ->orderBy("$dbr.idpo")
    ->get();

dd([
    'total_raw_idpo_in_range'   => $rawIdpoInRange->count(),
    'total_qualified_idpo'      => $qualifiedIdpo->count(),
    'raw_idpo_list'             => $rawIdpoInRange->sort()->values(),
    'qualified_idpo_list'       => $qualifiedIdpo->sort()->values(),
    'missing_idpo'              => $missingFromLeaf->sort()->values(),
    'zero_qty_idpo'             => $zeroQtyIdpo,
    'missing_raw_rows'          => $missingRawRows,
]);