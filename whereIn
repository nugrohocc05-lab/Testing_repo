                    .val() != null));
                if (!con) {
                    return;
                }
                $('#loading').show();
                $.ajax({
                        url: '{!! route('qc_dailyinlinereportdatatable') !!}',
                        type: 'POST',
                        dataType: 'html',
                        data: {
                            _token: $('meta[name=csrf-token]').attr('content'),
                            datea: $('#datea').val(),
                            dateb: $('#dateb').val(),
                            line: $('#line').val()
                        },
                    })
                    .done(function(data) {
                        $('#b-bod').html(data);
                    })
                    .fail(function() {
                        $('#b-bod').html('Cannot View Data');
                    })
                    .always(function() {
                        $('#loading').hide();
                    });
            });
            $('#line').select2({
                placeholder: '-- Select Line --',
                ajax: {
                    url: '{!! route('sewing_summarymappinglineselectline') !!}',
                    dataType: 'json',
                    delay: 500,
                    type: 'get',
                    data: function(params) {
                        var query = {
                            q: params.term,
                            page: params.page || 1,
                        }
                        return query;
                    },
                    processResults: function(data, params) {
                        if (data.current_page == 1) {
                            const newArray = [{
                                'kodegroup': 'all',
                            }];
                            newArray.forEach(e => {
                                data.data.unshift(e);
                            });
                        }
                        return {
                            results: $.map(data.data, function(item) {
                                if (item.kodegroup == 'all') {
                                    return {
                                        text: 'All',
                                        id: 'all'
                                    }
                                }
                                return {
                                    text: item.namabagian + ' - ' + item.namagroup,
                                    id: item.kodegroup
                                }
                            }),
                            pagination: {
                                more: data.to < data.total
                            }
                        };
                    },
                    cache: true
                }
            });
        });
    </script>
