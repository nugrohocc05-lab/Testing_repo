<?php

namespace Modules\QC\Http\Controllers;

use DB;
use Carbon\Carbon;
use Illuminate\Http\Request;
use App\Http\Controllers\Controller;
use App\Http\Models\Main\MasterInlineDefect;
use App\Http\Models\Color;
use App\Http\Models\Size;
use App\Http\Controllers\WatchController;
use App\Http\Models\HistoryPO;
use App\Http\Models\InlineDetail;
use App\Http\Models\InlineHeader;
use App\Http\Models\Main\MasterEmployeeGroup;

class DailyInlineReportController extends Controller
{
    protected $m_modul = 'qc';

    function __construct()
    {
        $this->middleware('auth');
    }

    function index()
    {
        if ($this->myaccess() == '0') {
            return redirect()
                ->back()
                ->with('alert', [
                    'title' => 'Unauthorized!',
                    'message' => 'You Dont Have Any Access Here!',
                    'status' => 'warning',
                ]);
        }

        WatchController::watch($this->get_class_name());
        return view('qc::dailyinlinereport.index');
    }

    function datatable(Request $request)
    {
        preconnect(session('db'));

        try {
            $m_da =
                $request->datea > $request->dateb
                    ? $request->dateb
                    : $request->datea;
            $m_db =
                $request->datea > $request->dateb
                    ? $request->datea
                    : $request->dateb;
            $dta = Carbon::parse($m_da);
            $dtb = Carbon::parse($m_db)->endOfDay();
    
            $diff = $dta->diffInDays($dtb);
    
            if ($diff > 30) {
                return '<center><h3>Date Has More Than 30 Days in Range, Cannot View Data.</h3></center>';
            }

            $tgldata = InlineHeader::select(
                'idpo', 'idcolor', 'idsize',
                'group_id as  line', 'round'
            )
            ->addSelect(DB::raw("SUBSTR(date, 1, 10) as tanggal"))
            ->whereBetween("date", [$dta, $dtb]);

            if ($request->line != 'all') {
                $tgldata = $tgldata->where('group_id', $request->line);
            }
    
            $tgldata = $tgldata->groupBy("tanggal", "line", "idpo", "idcolor", "idsize")->get();

            $he = (new InlineHeader())->getTable();
            $de = (new InlineDetail())->getTable();
            foreach ($tgldata as $d) {
                $namaline = MasterEmployeeGroup::find($d->line);
                $d->namaline = $namaline ? $namaline->name : null;
                $po = HistoryPO::select('po')->where('idpo', $d->idpo)->first();
                $d->po = $po ? $po->po : null;
                $color = Color::find($d->idcolor);
                $d->color = $color ? $color->nmcolor : null;
                $size = Size::find($d->idsize);
                $d->size = $size ? $size->nmsize : null;
                $hi = InlineHeader::select('id')
                    ->whereDate('date', $d->tanggal)
                    ->where('group_id', $d->line)
                    ->where('idpo', $d->idpo)
                    ->where('idcolor', $d->idcolor)
                    ->where('idsize', $d->idsize)
                    ->get();

                $qi = InlineDetail::select("$he.round", "$de.defect_id as kode")
                    ->join($he, "$he.id", '=', "$de.inline_header_id")
                    ->whereIn('inline_header_id', $hi->pluck('id'))
                    ->get();

                $d->tot_inspect = $hi->count() * 5;
                $d->tot_defect = $qi->count();
                $rft = (($d->tot_inspect - $d->tot_defect) / ($d->tot_inspect ?: 1)) * 100;
                $d->rft = number_format($rft, 2);
                $d->isdefect = $qi;
            }

            $inlinedata = MasterInlineDefect::select('kddefect', 'nmdefect', 'pivot_code')
                ->where('kddefect', '!=', '0')
                ->orderBy('pivot_code')
                ->get();
    
            return view('qc::dailyinlinereport.datatable', [
                'tgldata' => $tgldata,
                'inlinedata' => $inlinedata,
                'ctrl' => $this,
            ]);
        } catch (\Throwable $e) {
            return $e->getMessage();
        }
    }

    function get_operator_count($round, $date, $line)
    {
        preconnect(session('db'));
        return InlineHeader::selectRaw("COUNT(DISTINCT userid_operator) as total")
            ->where('round', $round)
            ->whereDate('date', $date)
            ->where('group_id', $line)
            ->first()->total ?? 0;
    }
}
