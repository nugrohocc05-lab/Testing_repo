<script>
document.addEventListener('DOMContentLoaded', function () {
    const chartInstances = {};

    function getFontScale(width, height) {
        const size = Math.min(width, height);
        if (size <= 90) return { center: 10, sub: 8 };
        if (size <= 120) return { center: 12, sub: 9 };
        if (size <= 160) return { center: 14, sub: 10 };
        return { center: 16, sub: 11 };
    }

    function renderDonutChart(chartId, passValue, rejectValue, totalValue, passTextId, rejectTextId,
        passColor = '#4ade80', rejectColor = '#f87171', centerLabel = 'Pcs') {

        const total = Number(totalValue) || 0;
        const pass = Number(passValue) || 0;
        const reject = Number(rejectValue) || 0;
        const passPct = total > 0 ? ((pass / total) * 100).toFixed(0) : 0;
        const rejectPct = total > 0 ? ((reject / total) * 100).toFixed(0) : 0;

        if (passTextId && document.getElementById(passTextId)) {
            document.getElementById(passTextId).innerText = pass.toLocaleString('id-ID') + ' (' + passPct + '%)';
        }
        if (rejectTextId && document.getElementById(rejectTextId)) {
            document.getElementById(rejectTextId).innerText = reject.toLocaleString('id-ID') + ' (' + rejectPct + '%)';
        }

        const chartDom = document.getElementById(chartId);
        if (!chartDom) return;

        const myChart = echarts.init(chartDom);
        chartInstances[chartId] = myChart;

        const data = [{ value: pass, name: 'PASS', itemStyle: { color: passColor } }];
        if (rejectTextId) data.push({ value: reject, name: 'REJECT', itemStyle: { color: rejectColor } });

        function buildOption() {
            const width = chartDom.clientWidth || 150;
            const height = chartDom.clientHeight || 150;
            const { center, sub } = getFontScale(width, height);

            return {
                backgroundColor: 'transparent',
                tooltip: { trigger: 'item', formatter: '{b}: {c} ({d}%)' },
                series: [{
                    name: 'Inspection Result',
                    type: 'pie',
                    radius: ['52%', '70%'],
                    center: ['50%', '50%'],
                    avoidLabelOverlap: false,
                    label: { show: false },
                    labelLine: { show: false },
                    data: data
                }],
                graphic: [
                    {
                        type: 'text', left: 'center', top: '43%',
                        style: { text: total.toLocaleString('id-ID'), textAlign: 'center', fill: '#ffffff', fontSize: center, fontWeight: 'bold' }
                    },
                    {
                        type: 'text', left: 'center', top: '57%',
                        style: { text: centerLabel, textAlign: 'center', fill: '#ffffff', fontSize: sub, fontWeight: 'normal' }
                    }
                ]
            };
        }

        myChart.setOption(buildOption());

        const ro = new ResizeObserver(() => {
            myChart.resize();
            myChart.setOption(buildOption());
        });
        ro.observe(chartDom);
    }

    renderDonutChart('chart-1', 0, 0, 0, 'pass-text-1', 'reject-text-1');
    renderDonutChart('chart-2', 0, 0, 0, 'pass-text-2', null, '#3F3184', '#ffffff', 'Defect Rate');
    renderDonutChart('chart-3', 0, 0, 0, 'pass-text-3', 'reject-text-3');

    window.__renderDonutChart = renderDonutChart; // dipakai ulang oleh summary.blade saat loadChart()
});
</script>

