<script>
document.addEventListener('DOMContentLoaded', function () {
    function renderDefectCategoryChart(chartId, processValue, nonProcessValue, processTextId, nonProcessTextId) {
        const total = processValue + nonProcessValue;
        const processPct = total > 0 ? ((processValue / total) * 100).toFixed(0) : 0;
        const nonProcessPct = total > 0 ? ((nonProcessValue / total) * 100).toFixed(0) : 0;

        if (processTextId && document.getElementById(processTextId)) {
            document.getElementById(processTextId).innerText = processValue.toLocaleString('id-ID') + ' (' + processPct + '%)';
        }
        if (nonProcessTextId && document.getElementById(nonProcessTextId)) {
            document.getElementById(nonProcessTextId).innerText = nonProcessValue.toLocaleString('id-ID') + ' (' + nonProcessPct + '%)';
        }

        const chartDom = document.getElementById(chartId);
        if (!chartDom) return;

        const myChart = echarts.init(chartDom);

        const option = {
            backgroundColor: 'transparent',
            grid: { left: '10%', right: '10%', top: '25%', bottom: '5%', containLabel: false },
            xAxis: { type: 'category', data: ['Process', 'Non Process'], show: false },
            yAxis: { type: 'value', show: false, max: 100 },
            series: [{
                type: 'bar',
                barWidth: '35%',
                data: [
                    { value: processPct, itemStyle: { color: '#3b82f6', borderRadius: [4, 4, 0, 0] } },
                    { value: nonProcessPct, itemStyle: { color: '#4ade80', borderRadius: [4, 4, 0, 0] } }
                ],
                label: {
                    show: true, position: 'top', color: '#ffffff', fontSize: 13,
                    formatter: (p) => p.value + ' %'
                }
            }]
        };

        myChart.setOption(option);
        window.addEventListener('resize', () => myChart.resize());
    }

    renderDefectCategoryChart('chart-defect-category', 0, 0, 'process-text', 'non-process-text');
    window.__renderDefectCategoryChart = renderDefectCategoryChart;
});
</script>



