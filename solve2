/* Aturan Default (Desktop & Mobile) */
.dropdown-submenu {
    position: relative;
}
.dropdown-submenu > .dropdown-menu {
    display: none;
    position: absolute;
    /* Pastikan tidak ada inline style display yang mengganggu */
    display: none !important; 
}

/* -------------------------------------------
   ATURAN DESKTOP (Gunakan Hover Murni)
------------------------------------------- */
@media (min-width: 768px) {
    .dropdown-submenu:hover > .dropdown-menu {
        display: block !important;
        top: 0;
        left: 100%; /* Membuka submenu ke arah luar kanan */
        margin-top: -1px; /* Sesuaikan sedikit margin jika meleset */
    }
}

/* -------------------------------------------
   ATURAN MOBILE (Matikan Hover, Gunakan Click Class)
------------------------------------------- */
@media (max-width: 767px) {
    .dropdown-submenu > .dropdown-menu {
        position: static; /* Mode accordion, dorong konten ke bawah */
        background-color: transparent !important;
    }
    
    /* Paksa matikan hover di mobile agar tidak merespons sentuhan acak */
    .dropdown-submenu:hover > .dropdown-menu {
        display: none !important;
    }

    /* Submenu hanya tampil jika Javascript memasang class .open */
    .dropdown-submenu.open > .dropdown-menu,
    .dropdown-submenu.open:hover > .dropdown-menu {
        display: block !important;
    }
}
