
function goShortcut(event, element) {
    let url = element.getAttribute('href');

    // 1. Cek apakah user mencoba membuka di tab baru (Ctrl+Click, Meta/Cmd+Click, Middle Click)
    if (event.ctrlKey || event.shiftKey || event.metaKey || (event.button && event.button === 1)) {
        // Biarkan browser yang bekerja, JANGAN tampilkan loading dan JANGAN preventDefault
        return; 
    }

    // 2. Jika link adalah '#', tidak perlu melakukan apa-apa
    if (url === '#' || url === 'javascript:void(0)') {
        event.preventDefault();
        return;
    }

    // 3. Untuk klik kiri biasa, cegah perpindahan instan, tampilkan loading, lalu pindah halaman
    event.preventDefault(); 
    
    // Tampilkan animasi loading kamu
    document.getElementById('loading').style.display = 'block'; 

    // Pindah ke halaman tujuan
    window.location.href = url;
}
