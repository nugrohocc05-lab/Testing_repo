$(function () {
    $(document).ready(function () {

        flatpickr("#datea", {
            dateFormat: "d-m-Y",
            altInput: true,
            altFormat: "d F Y",
            allowInput: true,
            monthSelectorType: "static",
            disableMobile: true,
            defaultDate: "today"
        });

        flatpickr("#dateb", {
            dateFormat: "d-m-Y",
            altInput: true,
            altFormat: "d F Y",
            allowInput: true,
            monthSelectorType: "static",
            disableMobile: true,
            defaultDate: "today"
        });

        $('#line').select2({
            placeholder: 'Select Line',
            width: '100%',
            ajax: {
                url: window.routes.selectLine,
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function (params) {
                    return {
                        q: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data) {
                    if (data.current_page == 1) {
                        data.data.unshift({ kodegroup: 'all' });
                    }
                    return {
                        results: $.map(data.data, function (item) {
                            if (item.kodegroup == 'all') {
                                return { id: 'all', text: 'All Lines' };
                            }
                            return {
                                id: item.kodegroup,
                                text: item.namabagian + ' - ' + item.namagroup
                            };
                        }),
                        pagination: {
                            more: data.to < data.total
                        }
                    };
                },
                cache: true
            }
        });

        $('#groupbuyer').select2({
            placeholder: 'Select Buyer',
            width: '100%',
            ajax: {
                url: window.routes.groupBuyer,
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function (params) {
                    return {
                        q: params.term,
                        page: params.page || 1
                    };
                },
                processResults: function (data) {
                    return { results: data.results };
                },
                cache: true
            }
        });

        // Load Cards (QTY Inspect, Defect, RFT, WFT, Target, Top Defect)
        let currentFilter = {
            line: 'all',
            datea: $('#datea').val(),
            dateb: $('#dateb').val(),
            groupbuyer: 'all'
        };

        function loadCards(filter) {
            $.ajax({
                url: window.routes.filterData,
                type: "GET",
                data: filter,
                beforeSend: function () {
                    $('#loading').show();
                },
                success: function (response) {
                    $('#cardQtyInspect').text(response.tot_inspect ?? '-');
                    $('#cardQtyDefect').text(response.tot_defect ?? '-');
                    $('#cardRft').text(response.rft ?? '-');
                    $('#cardWft').text(response.wft ?? '-');

                    // TOP DEFECT
                    let html = '';

                    if (response.top_defect && response.top_defect.length > 0) {
                        response.top_defect.forEach(function (item) {
                            html += `
                                <div class="d-flex align-items-center mb-2 w-100">
                                    <div style="
                                        width:15px;
                                        height:15px;
                                        background:${item.color};
                                        flex-shrink:0;
                                    "></div>

                                    <span class="text-white small ms-2 flex-grow-1 text-truncate"
                                        style="min-width:0;">
                                        ${item.total} ${item.nmdefect}
                                    </span>

                                    <span class="small ms-2 flex-shrink-0"
                                        style="color:${item.color}">
                                        ${item.percent}%
                                    </span>
                                </div>
                            `;
                        });
                    } else {
                        html = `<div class="text-white small text-center"></div>`;
                    }

                    $('#topDefectList').html(html);

                    // logic warna defect
                    const card = $('#cardQtyDefect').closest('.stat-card');

                    if (Number(response.tot_defect) === 0) {
                        card.removeClass('color-box-red').addClass('color-box-green');
                    } else {
                        card.removeClass('color-box-green').addClass('color-box-red');
                    }

                    // Logic warna target
                    const target = $('#targetColor');

                    if (response.target === true) {
                        target.removeClass('color-box-red').addClass('color-box-green');
                    } else {
                        target.removeClass('color-box-green').addClass('color-box-red');
                    }
                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                },
                complete: function () {
                    $('#loading').hide();
                }
            });
        }

        $('#findbtn').on('click', function (e) {
            e.preventDefault();

            currentFilter = {
                line: $('#line').val() || 'all',
                datea: $('#datea').val(),
                dateb: $('#dateb').val(),
                groupbuyer: $('#groupbuyer').val() || 'all'
            };

            $('#loading').show();
            loadCards(currentFilter);
        });

        loadCards(currentFilter);
    });
});
