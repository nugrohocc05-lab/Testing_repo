public function exportExcel(Request $request)
{
    $data = $this->getFilterData($request);

    $html = view('monitoring::exports.inline_report', [
        'data' => $data
    ])->render();

    header('Content-Type: application/vnd.ms-excel');
    header('Content-Disposition: attachment; filename="Report_Inline.xls"');
    header('Pragma: no-cache');
    header('Expires: 0');

    echo $html;
    exit;
}

