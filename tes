{{-- 
    Partial ini menampung markup tabel Round Status.
    Di-render di server (Blade) lalu dikirim sebagai HTML string
    lewat AJAX (return view), bukan lagi dirakit manual pakai JS.

    Variabel yang dibutuhkan:
    - $operators : array of ['sequence_process','nik','nama']
    - $rounds    : array of ['round', 'cells' => [['status' => 'none|one|multi|cap|empty']]]
--}}

@php
    $roundColors = [
        1 => ['bg' => '#219653', 'border' => '#4CF299'],
        2 => ['bg' => '#219653', 'border' => '#4CF299'],
        3 => ['bg' => '#219653', 'border' => '#4CF299'],
        4 => ['bg' => '#219653', 'border' => '#4CF299'],
        5 => ['bg' => '#219653', 'border' => '#4CF299'],
    ];

    $statusIcon = [
        'none'  => '<img src="' . _asset('svg/inlinePerformance/checklist.svg') . '" alt="No Defect">',
        'one'   => '',
        'multi' => '<img src="' . _asset('svg/inlinePerformance/defect2.svg') . '" alt="Multi Defect">',
        'cap'   => '<img src="' . _asset('svg/inlinePerformance/pencil.svg') . '" alt="CAP Filled">',
    ];

    $operators = $operators ?? [];
    $rounds    = $rounds ?? [];
    $colCount  = count($operators) > 0 ? count($operators) : 10;
@endphp

<div class="table-scroll-wrapper">
    {{-- min-width dihitung dari jumlah kolom operator, supaya kalau > 10 data,
         tabel otomatis melebar dan wrapper ini yang men-scroll ke kanan --}}
    <table id="datalist"
           class="table table-bordered table-hover round-status-table"
           style="min-width: {{ 110 + ($colCount * 90) }}px;">
        <thead style="background-color:#242E3E;">
            <tr id="operators">
                <th class="text-center">OPERATORS</th>

                @forelse($operators as $op)
                    @php
                        $nm = explode(' ', $op['nama'] ?? '');
                        $displayName = count($nm) > 1 ? $nm[0] . ' ' . $nm[1] : ($nm[0] ?: 'No Data');
                    @endphp
                    <th class="text-center">
                        <p class="mb-0">
                            {{ $op['sequence_process'] ?? '-' }}<br>
                            {{ $op['nik'] ?? '-' }}<br>
                            {{ $displayName }}
                        </p>
                    </th>
                @empty
                    @for ($i = 1; $i <= 10; $i++)
                        <th class="text-center"><p class="mb-0"><br><br></p></th>
                    @endfor
                @endforelse
            </tr>
        </thead>

        <tbody>
            @forelse($rounds as $roundData)
                @php $rc = $roundColors[$roundData['round']] ?? $roundColors[1]; @endphp
                <tr>
                    <td class="text-center round-label">
                        <span class="badge px-4 py-2 rounded-5"
                              style="background-color:{{ $rc['bg'] }}; border:2px solid {{ $rc['border'] }}; font-size:15px; font-weight:400">
                            Round {{ $roundData['round'] }}
                        </span>
                    </td>

                    @foreach(($roundData['cells'] ?? []) as $cell)
                        @if (($cell['status'] ?? 'empty') === 'empty')
                            <td class="text-center status-empty"></td>
                        @else
                            <td class="text-center">
                                <div class="btn-detail status-{{ $cell['status'] }}">
                                    {!! $statusIcon[$cell['status']] ?? '' !!}
                                </div>
                            </td>
                        @endif
                    @endforeach
                </tr>
            @empty
                {{-- Default: tetap tampil Round 1-5 dengan 10 kolom kosong --}}
                @for ($round = 1; $round <= 5; $round++)
                    @php $rc = $roundColors[$round]; @endphp
                    <tr>
                        <td class="text-center round-label">
                            <span class="badge px-4 py-2 rounded-5"
                                  style="background-color:{{ $rc['bg'] }}; border:2px solid {{ $rc['border'] }}; font-size:15px; font-weight:400">
                                Round {{ $round }}
                            </span>
                        </td>
                        @for ($i = 1; $i <= 10; $i++)
                            <td class="text-center status-empty"></td>
                        @endfor
                    </tr>
                @endfor
            @endforelse
        </tbody>
    </table>
</div>
