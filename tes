    function getoperator($line, $starttime, $endtime, $shift = null)
    {
        preconnect(session('db'));
        try {
            $isToday = !session('endline.shift');
            if($shift != null){
                $data = EmployeeAttendance::select('nik', 'status', 'time')
                    ->where('factory_id', session('db')->iddb)
                    ->whereBetween('time', [$starttime, $endtime])
                    ->where('group_id', $line)
                    ->where('is_efficiency', 1)
                    ->where('shift', $shift)
                    ->get();
            }else{
                $data = EmployeeAttendance::select('nik', 'status', 'time')
                    ->where('factory_id', session('db')->iddb)
                    ->whereBetween('time', [$starttime, $endtime])
                    ->where('group_id', $line)
                    ->where('is_efficiency', 1)
                    ->get();
            }
            
            $datas = collect();
            foreach ($data->unique('nik')->pluck('nik') as $nik) {
                if($isToday){
                    $m_mp = max(0,
                        $data->where('nik', $nik)->where('status', 'IN')->count() - $data->where('nik', $nik)->where('status', '!=', 'IN')->count(),
                    );
                }else{
                    $m_mp = max(0, ($data->where('status', 'IN')->groupBy('nik')->count()));
                }
                if($m_mp > 0){
                    $u = Employee::select('name')->where('nik', $nik)->first();
                    $name = $u ? $u->name : '-';
                    $mass = MatrixAssessment::where('nik', $nik)->first();
                    $grade = $mass ? $mass->grade : "PTS";
                    $obj = new \stdClass();
                    $obj->nik = $nik;
                    $obj->name = $name;
                    $obj->grade = $grade;
                    $datas->push($obj);
                }
            }

            $view = view('monitoring::conventional.detailoperator', ['data'=>$datas]);

            return response()->json($view->render());
        } catch (\Throwable $e) {
            return response()->json($e->getMessage(), 400);
        }
    }
