<script>
    $(document).ready(function() {
        function updateClock(){
        let now = new Date();
        let day = String(now.getDate()).padStart(2,'0');
        let month = [
            "January",
            "February",
            "March",
            "April",
            "May",
            "June",
            "July",
            "August",
            "September",
            "October",
            "November",
            "December"
        ];

        let year = now.getFullYear();

        let hour = String(now.getHours()).padStart(2,'0');
        let minute = String(now.getMinutes()).padStart(2,'0');
        let second = String(now.getSeconds()).padStart(2,'0');


        document.getElementById('liveClock').innerHTML =
            `${day} ${month[now.getMonth()]} ${year} - ${hour} : ${minute} : ${second}`;
        document.getElementById('liveClock2').innerHTML =
            `${day} ${month[now.getMonth()]} ${year} - ${hour} : ${minute} : ${second}`;
        }
        updateClock();
        setInterval(updateClock,1000);

        $('#line').select2({
            placeholder: 'Select Line',
            width: '100%',
            ajax: {
                url: "{{ route('monitoring_inlineperformance_filterInlineLts') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function(params){
                    return{
                        q: params.term,
                        page: params.page || 1
                    }
                },
                processResults:function(data){
                    return{
                        results: $.map(data.line.data,function(item){
                            return{
                                id:item.kodegroup,
                                text:item.namabagian + ' - ' + item.namagroup
                            }
                        }),
                        pagination:{
                            more:data.to < data.total
                        }
                    }
                },
                cache:true
            }
        });
    })
</script>

