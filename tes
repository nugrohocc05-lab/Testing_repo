<script type="text/javascript">
    $(document).ready(function() {
        setInterval(function() {
            d = new Date();
            h = set(d.getHours());
            m = set(d.getMinutes());
            s = set(d.getSeconds());
            $('#hours').text(h + ':' + m + ':' + s);
        }, 1000);
        function set(e)
        {
            e = e < 10 ? '0' + e : e;
            return e;
        }
        $('#datalist').DataTable({
            scrollX: true,
            paging: false,
            lengthChange: false,
            searching: false,
            ordering: false,
            info: false,
        	fixedColumns: {
        		leftColumns: 1
        	}
        });
        $('body').on('click', '.btn-detail', function(event) {
        	event.preventDefault();
        	var link = $(this).attr('href');
        	if(link == '#') return;
        	$('#loading').show();
        	$.ajax({
        		url: link,
        		type: 'GET',
        		dataType: 'html',
        	})
        	.done(function(data) {
        		$('#cap-modal').modal('show').find('.modal-body').html(data);
        	})
        	.always(function() {
        		$('#loading').hide();
        	});
        });
    });
</script>
