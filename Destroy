<template>
    <div class="px-6">
        <UiTitle align="center" title="Order Artwork Allocation"/>

        <div class="mb-4 flex w-full flex-col gap-3 lg:flex-row lg:items-end">
            <div class="flex-col flex gap-3 md:flex-row mb-2 md:mb-0">
                <div class="w-full md:w-60">
                    <UiMultiSelect v-model="form.filter" label="Filter" :options="filters"
                        placeholder="-- Select Filter --" @change="onFilterChange"/>
                </div>

                <div v-if="form.filter === 'po'" class="w-full md:w-60">
                    <UiMultiSelect v-model="form.po" label="PO" :options="pos"
                        placeholder="-- Select PO --" @change="(v) => fetchGrid(v ? `?po=${v}` : '')"/>
                </div>

                <template v-if="form.filter === 'kp'">
                    <div class="w-full md:w-60">
                        <UiMultiSelect v-model="form.buyer" label="Buyer" :options="buyers"
                            placeholder="-- Select Buyer --" @change="onBuyerChange"/>
                    </div>
                    <div v-if="form.buyer" class="w-full md:w-60">
                        <UiMultiSelect v-model="form.kpno" label="KP" :options="kps"
                            placeholder="-- Select KP --" @change="(v) => fetchGrid(v ? `?kpno=${v}` : '')"/>
                    </div>
                </template>
            </div>

            <div class="flex w-full justify-between gap-3 lg:ml-auto lg:w-auto lg:flex-row lg:items-end">
                <div class="flex items-center justify-start gap-1">
                    <UiTooltip content="PDF" position="bottom">
                        <UiButton variant="teritary" class="shrink-0" @click="onExportPdf">
                            <i class="fa-regular text-2xl fa-file-pdf"></i>
                        </UiButton>
                    </UiTooltip>
                    <UiTooltip content="Excel" position="bottom">
                        <UiButton variant="teritary" class="shrink-0" @click="onExportExcel">
                            <i class="fa-regular text-2xl fa-file-excel"></i>
                        </UiButton>
                    </UiTooltip>
                </div>
                <div class="w-full sm:w-50">
                    <UiInput v-model="searchKeyword" placeholder="Search" class="w-full rounded-lg">
                        <template #prefix>
                            <MagnifyingGlassIcon class="h-5 w-5 text-gray-400" />
                        </template>
                    </UiInput>
                </div>
            </div>
        </div>

        <UiAgGrid ref="gridRef" :rowData="rows" :columnDefs="columnDefs" class="mb-10 my-zebra-grid" :quickFilterText="searchKeyword" @grid-ready="onGridReady"/>
    </div>

    <UiModal v-model="showUndo" size="md">
        <div class="space-y-4 -mt-2">
            <div class="flex justify-center">
                <div class="flex h-32 w-32 items-center justify-center rounded-full bg-amber-100">
                    <ExclamationCircleIcon class="h-28 w-28 text-amber-600" />
                </div>
            </div>
            <div class="mt-4 text-center">
                <p class="mt-1 text-xl font-bold text-gray-500">Are you sure going to undo waiting list?</p>
                <p class="mt-1 text-md text-gray-500">
                    Once data processed, you can`t retrieve it again or recover the data! please do this action carefully!
                </p>
            </div>
        </div>
        <template #footer>
            <div class="flex justify-end gap-3">
                <UiButton variant="secondary" @click="showUndo = false">Cancel</UiButton>
                <UiButton @click="undo">OK</UiButton>
            </div>
        </template>
    </UiModal>
</template>

<script setup>
import { exportToPdf } from '@/utils/pdfExporter';
import { exportToExcel } from "@/utils/excelExporter";
import { getCurrentDateTime } from '@/utils/date';
import { encrypt } from "@/utils/crypto";
import { ref, shallowRef, onMounted, defineComponent, h } from "vue";
import { useRouter } from "vue-router";
import { useLoadingStore } from "@/stores/loading";
import { ArrowUturnLeftIcon, DocumentArrowUpIcon, ExclamationCircleIcon, InformationCircleIcon, MagnifyingGlassIcon } from "@heroicons/vue/24/outline";
import { customSwal } from "@/composable/customSwal";

import UiButton from "@/components/ui/UiButton.vue";
import UiInput from "@/components/ui/UiInput.vue";
import UiModal from "@/components/ui/UiModal.vue";
import UiTitle from "@/components/ui/UiTitle.vue";
import UiMultiSelect from "@/components/ui/UiMultiSelect.vue";
import UiAgGrid from '@/components/ui/UiAgGrid.vue';
import UiTooltip from '@/components/ui/UiTooltip.vue';

import api from "@/services/api";

defineOptions({ name: 'Allocation' });

const { success, error } = customSwal;
const { datetime } = getCurrentDateTime('-', '-');
const loading = useLoadingStore();
const router = useRouter();

const BASE = "/api/v1/order-artwork";
const rows = shallowRef([]);
const buyers = ref([]);
const kps = ref([]);
const pos = ref([]);
const searchKeyword = ref("");
const gridApi = shallowRef(null); 
const query = ref("");
const filters = [{ value: "po", label: "PO" }, { value: "kp", label: "KP" }];
const form = ref({ filter: "", buyer: "", kpno: "", po: "" });
const showUndo = ref(false);
const undoRow = ref(null);

const run = async (fn, msg = "Something went wrong") => {
    try {
        loading.show();
        await fn();
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
        else error(err?.response?.data?.message ?? msg);
    } finally {
        loading.hide();
    }
};

const onGridReady = (e) => {
    gridApi.value = e.api;
};

const toOptions = (list, value, label = value) => (list ?? []).map((i) => ({ value: i[value], label: i[label] }));

const fetchGrid = (q = "") => run(async () => {
    query.value = q;
    const { data } = await api.get(`${BASE}/getdata${q}`);
    rows.value = (data?.data ?? []).map((item, i) => ({ ...item, no: i + 1 }));
});

const exportOptions = {
    headers: ["NO", "PO", "KP", "Order Number", "Style", "CM Factory", "PO CMT", "Status"],
    fields: ["no", "po", "kpno", "ordernumber", "style", "factory", "po_sap", "status"],
};

const doExport = (fn, extra) => {
    if (!gridApi.value) return alert("Please Wait!");
    fn({
        title: `Orders Artwork Allocation Report ${datetime}`,
        fileName: `orders-artwork-${datetime.replace(' ', '_')}${extra.ext ?? ""}`,
        gridData: gridApi,
        ...exportOptions,
        ...extra.opts,
    });
};

const onExportExcel = () => doExport(exportToExcel, { ext: ".xlsx", opts: { sheetName: "Orders Artwork" } });
const onExportPdf = () => doExport(exportToPdf, { opts: { orientation: "l" } });

const onFilterChange = (val) => {
    form.value = { filter: val ?? "", buyer: "", kpno: "", po: "" };
    kps.value = [];
    fetchGrid();
    if (val === "po" && !pos.value.length) {
        run(async () => {
            const { data } = await api.get(`${BASE}/pos`);
            pos.value = toOptions(data?.data, "po");
        });
    }
};

const onBuyerChange = (idbuyer) => {
    form.value.kpno = "";
    kps.value = [];
    if (!idbuyer) return fetchGrid();
    run(async () => {
        const { data } = await api.get(`${BASE}/kps?idbuyer=${idbuyer}`);
        kps.value = toOptions(data?.data, "kpno");
    });
};

// Pindah ke halaman Upload KK
// SESUAIKAN nama route & cara kirim parameter dengan route yang sudah kamu buat
const openUpload = (row) => router.push({
    name: "order-artwork-allocation-upload-kk",
    params: { id: row.id },
    query: { kpno: row.kpno },
});

const undo = () => run(async () => {
    const { data } = await api.post(`${BASE}/cancel-complete/${undoRow.value.id}`);
    success(data?.message ?? "Waiting list has been undone");
    showUndo.value = false;
    await fetchGrid(query.value);
}, "Failed to undo");

const ActionRenderer = defineComponent({
    props: { params: { type: Object, required: true } },
    setup(props) {
        const row = () => props.params.data;

        const btn = (title, color, icon, onClick) =>
            h("button", {
                type: "button",
                title,
                class: `cursor-pointer text-${color}-500 transition hover:text-${color}-700`,
                onClick,
            }, [h(icon, { class: "h-5 w-5" })]);

        const detail = () => router.push({
            name: "order-artwork-allocation-detail-kk",
            params: { kk: encodeURIComponent(encrypt(row().kk)) },
        });

        const openUndo = () => {
            undoRow.value = row();
            showUndo.value = true;
        };

        return () => h("div", { class: "flex h-full gap-2" }, [
            btn("Detail", "amber", InformationCircleIcon, detail),
            row()?.status === "New" && btn("Upload KK", "cyan", DocumentArrowUpIcon, () => openUpload(row())),
            row()?.status === "Waiting" && btn("Undo Waiting List", "red", ArrowUturnLeftIcon, openUndo),
        ]);
    },
});

const col = (field, headerName, extra = {}) => ({ field, headerName, minWidth: 125, flex: 1, ...extra });

const columnDefs = [
    { headerName: "No", field: "no", width: 80, filter: false, resizable: false },
    col("po", "PO"),
    col("kpno", "KP"),
    col("ordernumber", "Order Number"),
    col("style", "Style"),
    col("factory", "CM Factory", { minWidth: 150, valueGetter: (p) => p.data?.factory ?? "-" }),
    col("po_sap", "PO CMT"),
    col("status", "Status"),
    { headerName: "Action", maxWidth: 150, sortable: false, filter: false, resizable: false, cellRenderer: ActionRenderer },
];

onMounted(() => {
    fetchGrid();
    run(async () => {
        const { data } = await api.get(`${BASE}/buyers`);
        buyers.value = toOptions(data?.data, "idbuyer", "namabuyer");
    });
});
</script>