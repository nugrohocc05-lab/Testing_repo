-- 0. (Opsional) cek tipe kolom idshell di shell detail,
--    sesuaikan tipe di langkah 1 jika bukan BIGINT UNSIGNED
-- SHOW COLUMNS FROM intellocut_shell_details LIKE 'idshell';

-- 1. Tambah kolom idshell
ALTER TABLE intellocut_layerman_lays
    ADD COLUMN idshell BIGINT UNSIGNED NULL AFTER idtable;

-- 2. Isi data lama dari shell detail
UPDATE intellocut_layerman_lays l
JOIN intellocut_shell_details d ON d.id = l.idshelldetail
SET l.idshell = d.idshell;

-- 3. Ganti unique key lama (idheader, lay, marker)
--    menjadi (idheader, idtable, lay, idshell)
ALTER TABLE intellocut_layerman_lays
    DROP INDEX uq_layerman_header_lay_marker,
    ADD UNIQUE KEY uq_layerman_header_table_lay_shell (idheader, idtable, lay, idshell);

-- 4. (Opsional tapi disarankan) yard boleh desimal, sebelumnya INT UNSIGNED
--    sehingga 1.5 yard terpotong jadi 1. Lewati jika yard memang selalu bulat.
ALTER TABLE intellocut_layerman_splices
    MODIFY length_yard  DECIMAL(8,4) NOT NULL DEFAULT 0,
    MODIFY wastage_yard DECIMAL(8,4) NOT NULL DEFAULT 0;

ALTER TABLE intellocut_layerman_shades
    MODIFY damages_yard DECIMAL(8,4) NOT NULL DEFAULT 0;

ALTER TABLE intellocut_layerman_endbits
    MODIFY length_yard DECIMAL(8,4) NOT NULL DEFAULT 0;

