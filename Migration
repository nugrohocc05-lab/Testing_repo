-- 1. intellocut_layerman_lays
CREATE TABLE intellocut_layerman_lays (
    id                   BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    idheader             BIGINT UNSIGNED NOT NULL,
    idshelldetail        BIGINT UNSIGNED NOT NULL,
    lay                  INT             NOT NULL,
    idtable              VARCHAR(50)     NULL,
    material_width_yard  INT UNSIGNED    NOT NULL DEFAULT 0,
    material_width_inch  DECIMAL(8,4)    NOT NULL DEFAULT 0,
    material_length_yard INT UNSIGNED    NOT NULL DEFAULT 0,
    material_length_inch DECIMAL(8,4)    NOT NULL DEFAULT 0,
    end_loss_1_yard      INT UNSIGNED    NOT NULL DEFAULT 0,
    end_loss_1_inch      DECIMAL(8,4)    NOT NULL DEFAULT 0,
    end_loss_2_yard      INT UNSIGNED    NOT NULL DEFAULT 0,
    end_loss_2_inch      DECIMAL(8,4)    NOT NULL DEFAULT 0,
    actual_plies         INT             NOT NULL DEFAULT 0,
    status               VARCHAR(20)     NOT NULL DEFAULT 'not_started',
    started_at           DATETIME        NULL,
    stopped_at           DATETIME        NULL,
    iduser               BIGINT UNSIGNED NULL,
    created_at           TIMESTAMP       NULL DEFAULT NULL,
    updated_at           TIMESTAMP       NULL DEFAULT NULL,
    PRIMARY KEY (id),
    UNIQUE KEY uq_layerman_header_lay (idheader, lay),
    KEY idx_layerman_shelldetail (idshelldetail)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 2. intellocut_layerman_splices
CREATE TABLE intellocut_layerman_splices (
    id            BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    idlayerman    BIGINT UNSIGNED NOT NULL,
    heading       INT UNSIGNED    NOT NULL,
    length_yard   INT UNSIGNED    NOT NULL DEFAULT 0,
    length_inch   DECIMAL(8,4)    NOT NULL DEFAULT 0,
    wastage_yard  INT UNSIGNED    NOT NULL DEFAULT 0,
    wastage_inch  DECIMAL(8,4)    NOT NULL DEFAULT 0,
    PRIMARY KEY (id),
    KEY idx_splices_layerman (idlayerman),
    CONSTRAINT fk_splices_layerman FOREIGN KEY (idlayerman)
        REFERENCES intellocut_layerman_lays (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 3. intellocut_layerman_shades
CREATE TABLE intellocut_layerman_shades (
    id            BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    idlayerman    BIGINT UNSIGNED NOT NULL,
    shade         VARCHAR(50)     NULL,
    actual_plies  INT             NOT NULL DEFAULT 0,
    damages_yard  INT UNSIGNED    NOT NULL DEFAULT 0,
    damages_inch  DECIMAL(8,4)    NOT NULL DEFAULT 0,
    PRIMARY KEY (id),
    KEY idx_shades_layerman (idlayerman),
    CONSTRAINT fk_shades_layerman FOREIGN KEY (idlayerman)
        REFERENCES intellocut_layerman_lays (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- 4. intellocut_layerman_endbits
CREATE TABLE intellocut_layerman_endbits (
    id           BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    idshade      BIGINT UNSIGNED NOT NULL,
    length_yard  INT UNSIGNED    NOT NULL DEFAULT 0,
    length_inch  DECIMAL(8,4)    NOT NULL DEFAULT 0,
    PRIMARY KEY (id),
    KEY idx_endbits_shade (idshade),
    CONSTRAINT fk_endbits_shade FOREIGN KEY (idshade)
        REFERENCES intellocut_layerman_shades (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
