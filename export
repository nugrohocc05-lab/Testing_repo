private function buildPriorityFinalData(Request $request, Carbon $dta, Carbon $dtb): array
{
    $fi = (new OutputDetailFinalInspection())->getTable();
    $od = (new OutputDetail())->getTable();
    $po = (new PurchaseOrder())->getTable();
    $odp = (new OutputDetailPacking())->getTable();

    $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);

    $byIdpoThenColor = $leafRows->groupBy('idpo')->map(fn ($rows) => $rows->groupBy('idcolor'));
    $byIdpoLeaf = $leafRows->groupBy('idpo');

    $qtyPerIdpo = [];
    foreach ($byIdpoLeaf as $idpo => $rows) {
        $qtyPerIdpo[$idpo] = (int) $rows->sum('qty_ori');
    }

    $today = Carbon::today()->startOfDay();
    $split = $this->getSplitFinalCheckIdpoList($request, $dta, $dtb, $today);

    $qualifiedIdpo = collect($qtyPerIdpo)->filter(fn ($qty) => $qty > 0)->keys()->values();
    $barcodesForHeader = OutputDetail::whereIn('idpo', $qualifiedIdpo)->pluck('barcode');
    $headerQuery = OutputDetailFinalInspection::query()
        ->join($od, "$od.barcode", '=', "$fi.barcode")
        ->join($po, "$po.idpo", '=', "$od.idpo")
        ->whereIn("$fi.barcode", $barcodesForHeader);

    $finalComIdpoList = (clone $headerQuery)
        ->where("$fi.is_output", 1)
        ->select("$od.idpo")->distinct()->pluck("$od.idpo");

    $rejectIdpoList = (clone $headerQuery)
        ->whereIn("$od.idpo", $finalComIdpoList)
        ->whereNotNull("$fi.date_output")
        ->whereNotNull("$fi.defect_code")
        ->select("$od.idpo")->distinct()->pluck("$od.idpo");

    $finalComIdpoList = $this->remapToReroutedIdpo($finalComIdpoList);
    $rejectIdpoList = $this->remapToReroutedIdpo($rejectIdpoList);
    $passIdpoList = $finalComIdpoList->diff($rejectIdpoList)->values();

    $statusByIdpo = collect();
    foreach ($split['overdue'] as $idpo) {
        $statusByIdpo->put((string) $idpo, 'overdue');
    }
    foreach ($split['need_final'] as $idpo) {
        $statusByIdpo->put((string) $idpo, 'need_final');
    }
    foreach ($passIdpoList as $idpo) {
        $statusByIdpo->put((string) $idpo, 'pass');
    }
    foreach ($rejectIdpoList as $idpo) {
        $statusByIdpo->put((string) $idpo, 'reject');
    }

    $originalFinalIdpoList = $split['overdue']->merge($split['need_final'])
        ->merge($finalComIdpoList)->unique()->values();
    $finalIdpoList = $this->getActiveRerouteIdpoList($originalFinalIdpoList);

    $poList = collect();
    foreach ($finalIdpoList as $idpo) {
        $colorGroups = $byIdpoThenColor->get($idpo);
        if (!$colorGroups) {
            continue;
        }
        foreach ($colorGroups as $idcolor => $rows) {
            $first = $rows->first();
            $poList->push((object) [
                'idpo' => $idpo,
                'idcolor' => $idcolor,
                'po' => $first->po,
                'idbuyer' => $first->idbuyer,
                'idstyle' => $first->idstyle,
                'qty' => (int) $rows->sum('qty_ori'),
                'etd' => $rows->max('deliverydate'),
            ]);
        }
    }
    $poList = $poList->values();

    $idpoList = $poList->pluck('idpo')->unique()->values();
    $buyerIds = $poList->pluck('idbuyer')->filter()->unique()->values();
    $buyerGroupMap = Buyer::whereIn('idbuyer', $buyerIds)->pluck('groupbuyer', 'idbuyer');
    $groupBuyerIds = $buyerGroupMap->filter()->unique()->values();
    $groupBuyerNames = MasterGroupBuyer::whereIn('id', $groupBuyerIds)->pluck('group_name', 'id');
    $styleIds = $poList->pluck('idstyle')->filter()->unique()->values();
    $styleMap = Style::whereIn('idstyle', $styleIds)->pluck('nmstyle', 'idstyle');
    $colorIds = $poList->pluck('idcolor')->filter()->unique()->values();
    $colorMap = Color::whereIn('idcolor', $colorIds)->pluck('nmcolor', 'idcolor');

    $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
        ->pluck('combine_pro')->filter()->unique()->values();

    $allHistoryIdpo = HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
        ->pluck('idpo')->filter()->unique()->values();

    $outputRows = OutputDetail::query()
        ->whereIn("$od.idpo", $allHistoryIdpo)
        ->whereNotNull("$od.barcode")
        ->leftJoin("$odp", "$odp.barcode", '=', "$od.barcode")
        ->select(
            "$od.idpo",
            "$od.idcolor",
            DB::raw("COUNT(DISTINCT $odp.id_set) as total_output")
        )
        ->groupBy("$od.idpo", "$od.idcolor")
        ->get();

    $outputPerIdpoColor = collect();

    foreach ($outputRows as $row) {
        $activeIdpo = $this->remapToReroutedIdpo(
            collect([(string) $row->idpo])
        )->first();

        $activeIdpo = $activeIdpo ?: $row->idpo;

        $key = $activeIdpo . '|' . $row->idcolor;

        $outputPerIdpoColor->put(
            $key,
            ($outputPerIdpoColor->get($key, 0) + (int) $row->total_output)
        );
    }

    $statusOrder = ['overdue' => 0, 'need_final' => 1, 'reject' => 2, 'pass' => 3];

    $data = $poList->map(function ($item) use (
        $buyerGroupMap, $groupBuyerNames, $styleMap, $colorMap,
        $outputPerIdpoColor, $today, $statusByIdpo
    ) {
        $groupBuyerId = $buyerGroupMap->get($item->idbuyer);
        $outputKey = $item->idpo . '|' . $item->idcolor;
        $totalOutput = $outputPerIdpoColor->get($outputKey, 0);
        $etd = $item->etd;

        $daysToEtd = $etd
            ? $today->diffInDays(Carbon::parse($etd)->startOfDay(), false)
            : null;

        $totalQty = (int) $item->qty;
        $progressOutput = $totalQty > 0 ? round(($totalOutput / $totalQty) * 100, 2) : 0;

        $rawStatus = $statusByIdpo->get((string) $item->idpo, '-');
        $status = in_array($rawStatus, ['overdue', 'need_final'])
            ? 'Need Final'
            : ($rawStatus === 'pass' ? 'Pass' : ($rawStatus === 'reject' ? 'Reject' : '-'));

        return [
            'idpo' => $item->idpo,
            'po' => $item->po,
            'style' => $styleMap->get($item->idstyle) ?: '-',
            'color' => $colorMap->get($item->idcolor) ?: '-',
            'buyer' => $groupBuyerId ? ($groupBuyerNames->get($groupBuyerId) ?: '-') : '-',
            'qty_order' => $totalQty,
            'output' => $totalOutput,
            'progress_output' => $progressOutput,
            'etd' => $etd ? Carbon::parse($etd)->format('d-m-Y') : '-',
            'days_to_etd' => $daysToEtd,
            'status' => $status,
        ];
    })
    ->sort(function ($a, $b) use ($statusOrder) {
        $orderA = $statusOrder[$a['status']] ?? 99;
        $orderB = $statusOrder[$b['status']] ?? 99;
        if ($orderA !== $orderB) {
            return $orderA <=> $orderB;
        }
        return ($a['days_to_etd'] ?? PHP_INT_MAX) <=> ($b['days_to_etd'] ?? PHP_INT_MAX);
    })
    ->values();

    $totalQtyOrderAll = $data->sum('qty_order');
    $totalOutputAll = $data->sum('output');
    $totalProgressOutputAll = $totalQtyOrderAll > 0
        ? round(($totalOutputAll / $totalQtyOrderAll) * 100, 2) : 0;

    return [
        'data' => $data,
        'total' => [
            'qty_order' => $totalQtyOrderAll,
            'output' => $totalOutputAll,
            'progress_output' => $totalProgressOutputAll,
        ],
    ];
}

