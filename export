private function buildTopDefectsData(Request $request, Carbon $dta, Carbon $dtb): array
{
    $fi = (new OutputDetailFinalInspection())->getTable();
    $od = (new OutputDetail())->getTable();
    $po = (new PurchaseOrder())->getTable();

    $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);
    $qtyPerIdpo = $leafRows->groupBy('idpo')->map(fn ($rows) => (int) $rows->sum('qty_ori'));
    $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();

    $barcodes = OutputDetail::whereIn('idpo', $qualifiedIdpo)->pluck('barcode');
    $headerQuery = OutputDetailFinalInspection::query()
        ->join($od, "$od.barcode", '=', "$fi.barcode")
        ->join($po, "$po.idpo", '=', "$od.idpo")
        ->whereIn("$fi.barcode", $barcodes);

    $defectRows = (clone $headerQuery)
        ->whereNotNull("$fi.date_output")
        ->whereNotNull("$fi.defect_code")
        ->select("$fi.id", "$fi.defect_code")
        ->distinct()->get();
    $totalDefect = $defectRows->count();

    $grouped = $defectRows
        ->map(function ($row) {
            if (in_array((string) $row->defect_code, ['800', '900'], true)) {
                $row->defect_code = 'Others';
            }
            return $row;
        })
        ->groupBy('defect_code')
        ->map(fn ($rows, $code) => [
            'defect_code' => $code,
            'qty' => $rows->count(),
            'percentage' => $totalDefect > 0 ? round(($rows->count() / $totalDefect) * 100, 2) : 0,
        ])
        ->values();

    $defectCodes = $grouped->pluck('defect_code')
        ->filter(fn ($code) => $code !== 'Others')->unique()->values();
    $categoryMap = QCDefect::whereIn('kdcacat', $defectCodes)->pluck('category', 'kdcacat');

    $processQty = 0;
    $nonProcessQty = 0;
    $nonProcessQtyNoGrade = 0;

    foreach ($grouped as $item) {
        $code = $item['defect_code'];
        $qty = (int) $item['qty'];
        if ($code === 'Others') {
            continue;
        }
        $category = (int) ($categoryMap->get($code, 0));
        if ($category === 1) {
            $processQty += $qty;
            continue;
        }
        $nonProcessQty += $qty;
        if (!in_array((int) $code, [800, 900, 888], true)) {
            $nonProcessQtyNoGrade += $qty;
        }
    }

    $totDefectProcess = $processQty + $nonProcessQty;
    $processPercent = $totDefectProcess > 0 ? round(($processQty / $totalDefect) * 100, 2) : 0;
    $nonProcessPercent = $totDefectProcess > 0 ? round(($nonProcessQtyNoGrade / $totalDefect) * 100, 2) : 0;

    $defectNames = QCDefect::whereIn('kdcacat', $defectCodes)->pluck('deskripsi', 'kdcacat');

    $result = $grouped
        ->filter(fn ($item) => $item['defect_code'] !== 'Others')
        ->map(function ($item) use ($defectNames) {
            $code = $item['defect_code'];
            $item['defect_name'] = $defectNames->get($code, $code);
            return $item;
        })
        ->sort(function ($a, $b) {
            if ($a['qty'] !== $b['qty']) {
                return $b['qty'] <=> $a['qty'];
            }
            return (int) $a['defect_code'] <=> (int) $b['defect_code'];
        })
        ->take(5)
        ->values();

    $total = $result->sum('qty');

    return [
        'data' => $result,
        'total' => $total,
        'total_defect' => $totalDefect,
        'process' => $processQty,
        'non_process' => $nonProcessQty,
        'non_process_no_grade' => $nonProcessQtyNoGrade,
        'process_percent' => $processPercent,
        'non_process_percent' => $nonProcessPercent,
    ];
}

