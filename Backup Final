import api from "@/services/api";

const loading = useLoadingStore();
const router = useRouter();
const route = useRoute();

const rawData = ref([]);
const completed = ref(false);
const allFilled = ref(false);
const kk = ref("");
const id = ref("");
const dataSelected = ref([]);

const showModal = ref(false);

const encryptedID = route.params.idorder;
const decodedID = decodeURIComponent(encryptedID);
const ID = decrypt(decodedID);

onMounted(() => {
    loadData();
});

const loadData = async () => {
    try {
        loading.show();
        const endpoint = `/api/v1/samplereference/file/${ID}`;
        const { data } = await api.get(endpoint);

        rawData.value = data?.data ?? [];
        kk.value = data?.data.kk ?? "0";
        id.value = data?.data.idorder ?? "0";
        setChecklist();
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

const isCompleted = (key) => {
    const files = rawData.value?.[key] || [];

    if (!files.length) return false;

    const latestFile = files[0];

    return !!latestFile.completedate;
};

const confimForm = ref({
    kkbc: null,
    kkdetail: null,
    bomf: null,
    boma: null,
    bom: null,
});

const uploaded = ref({
    date: null,
    kkbc: null,
    kkdetail: null,
    bomf: null,
    boma: null,
    bom: null,
});

const uploadFields = ref([
    {
        key: 'sr',
        label: 'Sample Reference',
        expiredate: 'expiredate',
        link: 'linksr',
        file: 'filesr',
    },
    {
        key: 'ms',
        label: 'Material Sample',
        link: 'linkms',
        file: 'filems',
    },
    {
