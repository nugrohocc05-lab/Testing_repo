    <script>
        $(document).ready(function() {
            var inputStyle = 'background-color: #f4f7fa; border: 1px solid #d1d9e6; border-radius: 6px; font-size: 12px; color: #475569; height: 34px;';

            function updateClock() {
                var now = new Date();
                var optionsDate = {
                    weekday: 'long',
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                };
                var formattedDate = now.toLocaleDateString('en-US', optionsDate);
                var parts = formattedDate.replace(',', '').split(' ');
                var customDate = parts[0] + ', ' + parts[1] + ' ' + parts[2] + ' ' + parts[3];
                $('#live-date').text(customDate);
            }
            updateClock();
            setInterval(updateClock, 1000);

            // ---------- Template ----------
            function endbitRowTemplate() {
                return `
                    <div class="endbit-row d-flex align-items-center gap-2">
                        <input type="text" class="form-control shadow-none input-endbit-yard" value="0" style="${inputStyle} max-width: 115px;">
                        <span class="text-nowrap me-1" style="font-size: 11px; font-weight: 600; color: #64748b;">- Yard</span>
                        <input type="text" class="form-control shadow-none input-endbit-inch" value="0" style="${inputStyle} max-width: 115px;">
                        <span class="text-nowrap me-2" style="font-size: 11px; font-weight: 600; color: #64748b;">- Inch</span>
                        <button type="button" class="btn btn-add-endbit p-0 border-0 rounded-circle d-inline-flex align-items-center justify-content-center text-white" style="width: 24px; height: 24px; background-color: #3b93b8; flex-shrink: 0;">
                            <i class="bi bi-plus-lg" style="font-size: 12px;"></i>
                        </button>
                    </div>`;
            }

            function shadeTemplate() {
                return `
                    <div class="shade-item pt-4 mt-4" style="border-top: 1px solid #e2e8f0;">
                        <div class="d-flex justify-content-end mb-2">
                            <button type="button" class="btn btn-remove-shade p-0 border-0 text-danger" style="font-size: 11px; font-weight: 600;">
                                <i class="bi bi-trash"></i> Remove Shade
                            </button>
                        </div>
                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <label class="form-label mb-2" style="font-size: 11px; font-weight: 700; color: #334155;">Shade</label>
                                <input type="text" class="form-control shadow-none input-shade" value="" style="${inputStyle} max-width: 280px;">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-2" style="font-size: 11px; font-weight: 700; color: #334155;">Actual Plies</label>
                                <input type="text" class="form-control shadow-none input-actual-plies" value="0" style="${inputStyle} max-width: 280px;">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-2" style="font-size: 11px; font-weight: 700; color: #334155;">Damages</label>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="text" class="form-control shadow-none input-damages-yard" value="0" style="${inputStyle} max-width: 115px;">
                                    <span class="text-nowrap me-1" style="font-size: 11px; font-weight: 600; color: #64748b;">- Yard</span>
                                    <input type="text" class="form-control shadow-none input-damages-inch" value="0" style="${inputStyle} max-width: 115px;">
                                    <span class="text-nowrap" style="font-size: 11px; font-weight: 600; color: #64748b;">- Inch</span>
                                </div>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label mb-2" style="font-size: 11px; font-weight: 700; color: #334155;">Endbits Generated</label>
                            <div class="endbits-list d-flex flex-column gap-2">
                                ${endbitRowTemplate()}
                            </div>
                        </div>
                    </div>`;
            }

            // ---------- Endbits ----------
            function syncEndbitButtons($list) {
                var $rows = $list.find('.endbit-row');
                $rows.each(function(index) {
                    var $btn = $(this).find('button');
                    if (index === $rows.length - 1) {
                        $btn.removeClass('btn-remove-endbit')
                            .addClass('btn-add-endbit')
                            .css('background-color', '#3b93b8')
                            .html('<i class="bi bi-plus-lg" style="font-size: 12px;"></i>');
                    } else {
                        $btn.removeClass('btn-add-endbit')
                            .addClass('btn-remove-endbit')
                            .css('background-color', '#ef4444')
                            .html('<i class="bi bi-dash-lg" style="font-size: 12px;"></i>');
                    }
                });
            }

            $(document).on('click', '.btn-add-endbit', function() {
                var $list = $(this).closest('.endbits-list');
                $list.append(endbitRowTemplate());
                syncEndbitButtons($list);
            });

            $(document).on('click', '.btn-remove-endbit', function() {
                var $list = $(this).closest('.endbits-list');
                $(this).closest('.endbit-row').remove();
                syncEndbitButtons($list);
            });

            // ---------- Shade ----------
            $('#btnAddNewShade').on('click', function() {
                $('#shadeContainer').append(shadeTemplate());
            });

            $(document).on('click', '.btn-remove-shade', function() {
                $(this).closest('.shade-item').remove();
            });

            // ---------- Save ----------
            $('#btnSaveChanges').on('click', function() {
                var resultData = [];
                $('.shade-item').each(function() {
                    var endbitsArray = [];
                    $(this).find('.endbit-row').each(function() {
                        endbitsArray.push({
                            yard: $(this).find('.input-endbit-yard').val(),
                            inch: $(this).find('.input-endbit-inch').val()
                        });
                    });
                    resultData.push({
                        shade: $(this).find('.input-shade').val(),
                        actual_plies: $(this).find('.input-actual-plies').val(),
                        damages: {
                            yard: $(this).find('.input-damages-yard').val(),
                            inch: $(this).find('.input-damages-inch').val()
                        },
                        endbits_generated: endbitsArray
                    });
                });
                console.log(resultData);
            });
        });
    </script>
