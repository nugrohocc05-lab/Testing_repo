const sendData = async () => {
    try {
        const selectedRows = rawData.value.filter(
            (item) => item.selected
        );

        if (selectedRows.length === 0) {
            await warning({
                title: "Incomplete Data",
                text: "Select at least one material first.",
            });
            return;
        }

        // Pastikan file sudah dipilih
        if (!(deliveryorders.value instanceof File)) {
            await warning({
                title: "File Required",
                text: "Please select a delivery order file.",
            });
            return;
        }

        loading.show();

        const formData = new FormData();

        formData.append("kpno", kpno);
        formData.append("combine_pro", pro);
        formData.append("kk", kk);

        selectedRows.forEach((item) => {
            formData.append(
                `inputqty[${item.idmaterial}]`,
                String(item.sendQty)
            );
        });

        formData.append("description", description.value);
        formData.append("bppb_number", bppbNumber.value);
        formData.append("do_number", doNumber.value);

        formData.append(
            "deliveryorders",
            deliveryorders.value
        );

        for (const [key, value] of formData.entries()) {
            console.log(
                key,
                value instanceof File
                    ? `FILE: ${value.name}`
                    : `TEXT: ${value}`
            );
        }

        const { data } = await api.post(
            "/api/v1/deliverymaterial/storeinput",
            formData
        );

        showSendModal.value = false;

        await success({
            title: "Success",
            text: data?.message || "Data successfully sent.",
        });

        await loadData();
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        console.error("Upload error:", err.response?.data);

        await error({
            title: "Upload Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to deliver materials.",
        });
    } finally {
        loading.hide();
    }
};

const loadData = async () => {
    try {
        loading.show();
        const endpoint = `/api/v1/deliverymaterial/inputmaterial?kpno=${kpno}&combine_pro=${pro}&kk=${kk}`;

        const { data } = await api.get(endpoint);

        rawData.value = (data?.data ?? []).map((item, index) => {
            const balanceQty = (item.balance ?? []).reduce(
                (total, delivery) => {
                    return total + Number(delivery.qty ?? 0);
                },
                0
            );

            return {
                ...item,
                no: index + 1,
                balanceQty,
                sendQty: 0,
                selected: false,
            };
        });

    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

onMounted(() => {
    loadData();
