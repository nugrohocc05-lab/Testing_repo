<UiMultiSelect
    v-model="selectedDates"
    :options="all_date"
    label="Date"
    placeholder="-- Select Date --"
    class="w-full"
/>

import { ref, computed, onMounted, watch } from "vue";

// Normalisasi: selalu array of string (tahan kalau multiselect mengembalikan object)
const normalizedDates = computed(() => {
    const v = selectedDates.value;
    const arr = Array.isArray(v) ? v : v ? [v] : [];
    return arr
        .map((d) => (typeof d === "object" && d !== null ? d.value : d))
        .filter(Boolean);
});

const resetDateFilter = () => {
    selectedDates.value = []; // watch otomatis memanggil loadData
};

watch(
    selectedDates,
    () => loadData(),
    { deep: true }
);

let loadSeq = 0;

const loadData = async () => {
    const seq = ++loadSeq;
    try {
        loading.show();

        const params = new URLSearchParams({
            kpno,
            combine_pro: pro,
            kk,
        });

        normalizedDates.value.forEach((date) => {
            params.append("dates[]", date);
        });

        const { data } = await api.get(
            `/api/v1/receivematerial/input?${params.toString()}`
        );

        if (seq !== loadSeq) return; // abaikan response lama

        if (!data?.success) {
            rawData.value = [];
            return;
        }

        description.value = data?.data?.deliverymaterial?.description ?? "";

        rawData.value = (data?.data?.materials ?? []).map((item, index) => {
            const qty = (item.deliverydetail ?? []).reduce(
                (total, detail) => total + Number(detail.qty ?? 0),
                0
            );
            return { ...item, no: index + 1, qty, selected: false };
        });
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }
        await error({
            title: "Failed to Load Data",
            text: err?.response?.data?.message || err?.message || "Failed to load material data.",
        });
    } finally {
        loading.hide();
    }
};