            display: "flex",
            alignItems: "center",
            justifyContent: "center",
        },
        cellRenderer: (params) => {
            const percentage = Number(params.value);

            let colorClass = "";

            if (percentage < 50) {
                colorClass = "background-color:#FEE2E2;color:#DC2626;";
            } else if (percentage < 71) {
                colorClass = "background-color:#FEF3C7;color:#A16207;";
            } else if (percentage <= 100) {
                colorClass = "background-color:#DCFCE7;color:#15803D;";
            } else {
                colorClass = "background-color:#DCFCE7;color:#15803D;";
            }

            const wrapper = document.createElement("span");

            wrapper.textContent = `${params.value ?? 0}%`;
            wrapper.style.cssText = `
                display: inline-block;
                padding: 3px 10px;
                border-radius: 6px;
                font-size: 12px;
                font-weight: 600;
                line-height: 1.5;
                ${colorClass}
            `;

            return wrapper;
        },
    },
    {
        field: "mstatus",
        headerName: "Material Status",
        minWidth: 120,
        filter: false,
        flex: 1,
    },
    {
        headerName: "Action",
        width: 100,
        sortable: false,
        filter: false,
        resizable: false,
        cellRenderer: ActionRenderer,
    },
];

const loadData = async () => {
    await loadDataFilter();
};

const loadFilter = async () => {
    await nextTick();
