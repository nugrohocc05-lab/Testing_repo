// Carton Qty
{
    field: "cartonQty",
    headerName: "Carton Qty",
    minWidth: 130,
    editable: true,
    flex: 1,
    cellClass: "editable-cell",   // <-- ganti cellStyle jadi ini
    valueFormatter: (params) =>
        params.value === null || params.value === undefined || params.value === ""
            ? "Input qty"
            : params.value,
    cellClassRules: {
        "editable-cell-empty": (params) =>
            params.value === null ||
            params.value === undefined ||
            params.value === "",
    },
    // ...sisanya tetap
},

<style scoped>
.label {
    white-space: nowrap;
    display: inline-block;
    width: 120px;
    font-weight: 600;
}

/* Sel yang bisa diedit: tampil seperti input */
:deep(.editable-cell) {
    color: #1d4ed8;
    font-weight: 600;
    cursor: text;
    background-color: #eff6ff;          /* biru muda */
    border: 1px solid #bfdbfe !important;
    border-radius: 6px;
    transition: border-color 0.15s, box-shadow 0.15s, background-color 0.15s;
}

/* Hover: lebih menonjol */
:deep(.editable-cell:hover) {
    background-color: #dbeafe;
    border-color: #60a5fa !important;
}

/* Placeholder saat kosong */
:deep(.editable-cell-empty) {
    color: #9ca3af;
    font-weight: 400;
    font-style: italic;
}

/* Saat sedang diedit (ada kursor kedip) */
:deep(.ag-cell-inline-editing) {
    border: 2px solid #2563eb !important;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.25);
    border-radius: 6px;
    background: #fff;
}

:deep(.ag-cell-inline-editing input) {
    color: #1d4ed8;
    font-weight: 600;
    caret-color: #2563eb;
}
</style>

<UiAgGrid
    ...
    :singleClickEdit="true"
    :stopEditingWhenCellsLoseFocus="true"
/>