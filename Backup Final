function getinputdetail(Request $request){
    try {
        preconnect(session('db'));
        if(!$request->bundlecode){
            throw new \Exception("Input bundlecode!");
        }

        $od = (new OutputDetail())->getTable();
        $so = (new SewingOutput())->getTable();

        $outputdetail = OutputDetail::select(
            "$od.bundlecode",
            "$so.line",
            "$so.is_assembly"
        )
        ->selectRaw("DATE($so.date) as date")
        ->selectRaw("COUNT(DISTINCT $so.barcode) as qty")
        ->join($so, "$od.barcode", "=", "$so.barcode")
        ->where("$od.bundlecode", $request->bundlecode)
        ->where("$so.station_id", '0')
        ->when($request->line, function ($q) use ($so, $request) {
            $q->where("$so.line", $request->line);
        })
        ->when($request->datea && $request->dateb, function ($q) use ($so, $request) {
            $q->whereBetween("$so.date", [
                Carbon::parse($request->datea)->startOfDay(),
                Carbon::parse($request->dateb)->endOfDay(),
            ]);
        })
        ->when($request->datea && !$request->dateb, function ($q) use ($so, $request) {
            $q->whereDate("$so.date", Carbon::parse($request->datea));
        })
        ->when(!$request->datea && $request->dateb, function ($q) use ($so, $request) {
            $q->whereDate("$so.date", Carbon::parse($request->dateb));
        })
        ->groupBy(
            "$od.bundlecode",
            "$so.line",
            "$so.is_assembly",
            DB::raw("DATE($so.date)")
        )
        ->get();

        return response()->json($outputdetail);
    } catch (\Throwable $th) {
        return response()->json($th->getMessage(), 400);
    }
}



