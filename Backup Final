<template>
    <div class="px-6">
        <UiTitle :is-back="true" align="center" title="Delivery Material">
            <template #action-left>
                <UiButton variant="teritary" @click="router.back()">
                    <ArrowLeftStartOnRectangleIcon class="h-5 w-5" />
                    <span class="text-xl ml-1">Back</span>
                </UiButton>
            </template>
        </UiTitle>

        <div class="mb-4 grid w-full grid-cols-1 items-end gap-3 sm:grid-cols-2 xl:grid-cols-12">
            <div class="xl:col-span-2">
                <UiMultiSelect
                    v-model="selectedDates"
                    label="Date"
                    placeholder="-- Select Date --"
                    class="w-full"
                    :options="dateOptions"
                />
            </div>

            <div class="flex w-full gap-2 xl:col-span-3 items-end">
                <UiButton variant="warning" @click="resetDateFilter">
                    Reset
                </UiButton>
            </div>

            <div class="flex w-full items-end justify-end gap-2 xl:col-span-4 xl:col-start-9">
                <div class="min-w-0 w-50">
                    <UiInput
                        v-model="searchKeyword"
                        placeholder="Search"
                        class="w-full rounded-lg"
                    >
                        <template #prefix>
                            <MagnifyingGlassIcon class="h-5 w-5 text-gray-400" />
                        </template>
                    </UiInput>
                </div>
            </div>
        </div>

        <UiCard class="my-4 text-xs md:text-lg">
            <UiGrid cols="8" gap="sm">
                <div><span class="label">Description</span> : {{ description }}</div>
            </UiGrid>
            <UiAgGrid
                class="my-zebra-grid mt-3"
                :rowData="rawData"
                :columnDefs="columnDefs"
                :quickFilterText="searchKeyword"
                :defaultColDef="defaultColDef"
            />
        </UiCard>

        <div class="mt-4 flex justify-end">
            <UiButton @click="openReceiveModal">
                Receive
            </UiButton>
        </div>
    </div>

    <UiModal
        v-model="showSendModal"
        title="Receiving Confirmation"
        size="2xl"
    >
        <div class="space-y-4 -mt-3">
            <UiInput
                type="file"
                variant="dropzone"
                label="File Delivery Orders"
                placeholder="Choose File"
                dropzone-hint="Only PDF, XLS, or XLSX formats, up to 8MB"
                accept=".pdf,.xls,.xlsx"
                @change="handleFile"
            />

            <div class="flex justify-end gap-2 pt-3">
                <UiButton variant="teritary" @click="showSendModal = false">
                    Cancel
                </UiButton>

                <UiButton @click="confirmSend">
                    Confirm
                </UiButton>
            </div>
        </div>
    </UiModal>
</template>

<script setup>
import { ref, onMounted, watch } from "vue";
import { useRouter, useRoute } from "vue-router";
import { MagnifyingGlassIcon, ArrowLeftStartOnRectangleIcon } from "@heroicons/vue/24/outline";

import { decrypt } from "@/utils/crypto";
import { useLoadingStore } from "@/stores/loading";
import { customSwal } from "@/composable/customSwal";
import api from "@/services/api";

import UiButton from "@/components/ui/UiButton.vue";
import UiInput from "@/components/ui/UiInput.vue";
import UiTitle from "@/components/ui/UiTitle.vue";
import UiAgGrid from "@/components/ui/UiAgGrid.vue";
import UiModal from "@/components/ui/UiModal.vue";
import UiCard from "@/components/ui/UiCard.vue";
import UiMultiSelect from "@/components/ui/UiMultiSelect.vue";
import UiGrid from "@/components/ui/UiGrid.vue";

const { success, warning, error } = customSwal;

const loading = useLoadingStore();
const router = useRouter();
const route = useRoute();

const kk = decrypt(decodeURIComponent(route.params.kk));
const kpno = decrypt(decodeURIComponent(route.params.kpno));
const pro = decrypt(decodeURIComponent(route.params.pro));

const rawData = ref([]);
const searchKeyword = ref("");
const description = ref("");
const showSendModal = ref(false);
const deliveryOrderFile = ref(null);
const id = route.params.id;

const dateOptions = ref([]);
const selectedDates = ref([]);

let dateOptionsLoaded = false;

const resetDateFilter = () => {
    if (selectedDates.value.length === 0) {
        loadData();
        return;
    }
    selectedDates.value = [];
};

watch(
    selectedDates,
    () => {
        loadData();
    },
    { deep: true }
);
const defaultColDef = {
    sortable: true,
    filter: false,
    resizable: true,
};

const getBalance = (data) => {
    return (data?.deliverydetail ?? []).reduce(
        (total, detail) => total + Number(detail.qty ?? 0),
        0
    );
};

const handleFile = (event) => {
    const file =
        event?.target?.files?.[0] ??
        event?.files?.[0] ??
        event?.[0] ??
        (event instanceof File ? event : null);

    deliveryOrderFile.value = file;
};

class SelectAllHeader {
    init(params) {
        this.params = params;

        this.eGui = document.createElement("div");
        this.eGui.style.display = "flex";
        this.eGui.style.alignItems = "center";
        this.eGui.style.justifyContent = "center";
        this.eGui.style.height = "100%";

        this.checkbox = document.createElement("input");
        this.checkbox.type = "checkbox";
        this.checkbox.title = "Select All";

        this.onChange = (event) => {
            const checked = event.target.checked;

            this.params.api.forEachNode((node) => {
                node.setDataValue("selected", checked);
                node.setDataValue(
                    "qty",
                    checked ? getBalance(node.data) : 0
                );
            });
        };

        this.checkbox.addEventListener("change", this.onChange);
        this.eGui.appendChild(this.checkbox);
    }

    getGui() {
        return this.eGui;
    }

    refresh() {
        return false;
    }

    destroy() {
        this.checkbox.removeEventListener("change", this.onChange);
    }
}

const columnDefs = [
    {
        headerName: "No",
        field: "no",
        width: 80,
        sortable: false,
        filter: false,
        resizable: false,
    },
    {
        field: "itemdesc",
        headerName: "Item Number",
        minWidth: 120,
        flex: 1,
    },
    {
        field: "matcontents",
        headerName: "Item Desc",
        minWidth: 160,
        flex: 1,
    },
    {
        field: "colorcode",
        headerName: "Color Code",
        minWidth: 120,
        flex: 1,
    },
    {
        field: "size",
        headerName: "Size",
        minWidth: 180,
        flex: 1,
    },
    {
        headerName: "Sent Quantity",
        minWidth: 120,
        flex: 1,
        valueGetter: (params) =>
            (params.data?.deliverydetail ?? []).reduce(
                (total, item) => total + Number(item.qty ?? 0),
                0
            ),
    },
    {
        field: "qty",
        headerName: "Receive Qty",
        minWidth: 120,
        flex: 1,
        editable: true,
        cellEditor: "agNumberCellEditor",
        valueGetter: (params) => {
            return params.data?.qty ??
                params.data?.deliverydetail?.reduce(
                    (total, detail) => total + Number(detail.qty ?? 0),
                    0
                ) ?? 0;
        },
    },
    {
        field: "unit",
        headerName: "Unit",
        minWidth: 90,
        flex: 1,
    },
    {
        headerName: "",
        field: "selected",
        width: 80,
        sortable: false,
        filter: false,
        resizable: false,

        headerComponent: SelectAllHeader,

        cellRenderer: (params) => {
            const checkbox = document.createElement("input");
            checkbox.type = "checkbox";
            checkbox.checked = Boolean(params.data?.selected);

            checkbox.addEventListener("change", (event) => {
                const checked = event.target.checked;

                params.node.setDataValue("selected", checked);

                const balance = getBalance(params.data);
                const qty = checked ? balance : 0;

                params.node.setDataValue("qty", qty);

                // CEK HASIL CHECKBOX
                console.log("=== CHECKBOX MATERIAL ===");
                console.log("ID Material:", params.data.idmaterial);
                console.log("Checked:", checked);
                console.log("Selected:", params.data.selected);
                console.log("Balance:", balance);
                console.log("Qty:", params.data.qty);
                console.log("Data Row:", params.data);
            });

            return checkbox;
        },
    },
];

const openReceiveModal = async () => {
    console.log("=== DATA SEBELUM RECEIVE ===");

    console.table(
        rawData.value.map((item) => ({
            idmaterial: item.idmaterial,
            itemdesc: item.itemdesc,
            selected: item.selected,
            qty: item.qty,
            sendQty: item.sendQty,
            balance: getBalance(item),
        }))
    );

    const selectedRows = rawData.value.filter(
        (item) => item.selected === true
    );

    console.log("Selected Rows:", selectedRows);

    if (selectedRows.length === 0) {
        console.warn("Belum ada material yang dipilih.");
    }

    showSendModal.value = true;
};

const confirmSend = async () => {
    await sendData();
};

const sendData = async () => {
    try {
        const selectedRows = rawData.value.filter(
    (item) => item.selected === true
);

console.log(
    "Selected Rows:",
    selectedRows.map((item) => ({
        idmaterial: item.idmaterial,
        selected: item.selected,
        qty: item.qty,
        sendQty: item.sendQty,
    }))
);

        if (selectedRows.length === 0) {
            await warning({
                title: "Incomplete Data",
                text: "Pilih material dengan Qty lebih besar dari 0.",
            });
            return;
        }

        const invalidQty = selectedRows.some((item) => {
            const qty = Number(item.sendQty);
            return !Number.isFinite(qty) || qty <= 0 || qty > getBalance(item);
        });

        if (invalidQty) {
            await warning({
                title: "Invalid Quantity",
                text: "The Receive Qty must be greater than 0 and cannot exceed the Balance.",
            });
            return;
        }

        if (!deliveryOrderFile.value) {
            await warning({
                title: "Incomplete Data",
                text: "Upload the Delivery Order file first.",
            });
            return;
        }

        loading.show();

        const formData = new FormData();

        formData.append("kpno", kpno);
        formData.append("combine_pro", pro);
        formData.append("kk", kk);

        selectedRows.forEach((item) => {
            formData.append(
                `inputqty[${item.idmaterial}]`,
                String(item.sendQty)
            );
        });

        formData.append("deliveryorders[]", deliveryOrderFile.value);

        const { data } = await api.post(
            `/api/v1/receivematerial/receive`,
            formData
        );

        console.log("Payload:", [...formData.entries()]);
        showSendModal.value = false;
        deliveryOrderFile.value = null;

        await success({
            title: "Success",
            text: data?.message ?? "Material received successfully.",
        });

        if (selectedDates.value.length > 0) {
            selectedDates.value = [];
        } else {
            await loadData();
        }
    } catch (err) {
        loading.hide();
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Receive Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to receive materials.",
        });
    } finally {
        loading.hide();
    }
};

const loadData = async () => {
    try {
        loading.show();

        const params = new URLSearchParams({    
            kpno,
            combine_pro: pro,
            kk,
        });

        const dates = Array.isArray(selectedDates.value)
            ? selectedDates.value
            : selectedDates.value
                ? [selectedDates.value]
                : [];

        dates.forEach((date) => {
            params.append("dates[]", date);
        });

        const { data } = await api.get(
            `/api/v1/receivematerial/input?${params.toString()}`
        );

        if (!data?.success) {
            rawData.value = [];
            return;
        }

        description.value = data?.data?.deliverymaterial?.description ?? "";

        if (!dateOptionsLoaded) {
            const dates = data?.data?.dates ?? [];
            dateOptions.value = dates.map((item) => ({
                label: item.date,
                value: item.date,
            }));
            dateOptionsLoaded = dates.length > 0;
        }

        rawData.value = (data?.data?.materials ?? []).map((item, index) => {
            const deliveryDetails = item.deliverydetail ?? [];

            const qty = deliveryDetails.reduce(
                (total, detail) => total + Number(detail.qty ?? 0),
                0
            );

            return {
                ...item,
                no: index + 1,
                qty,
                selected: false,
            };
        });
    } catch (err) {
        loading.hide();
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Failed to Load Data",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to load material data.",
        });
    } finally {
        loading.hide();
    }
};

onMounted(() => {
    loadData();
});
</script>

<style scoped>
.label {
    white-space: nowrap;
    display: inline-block;
    width: 120px;
    font-weight: 600;
}
</style>
