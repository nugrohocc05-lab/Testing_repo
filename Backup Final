<template>
    <div class="px-6">
        <UiTitle align="center" title="Upload KK"/>

        <div class="mx-auto max-w-3xl">
            <div class="mb-4">
                <UiButton variant="secondary" @click="goBack">
                    <ArrowLeftIcon class="mr-1 inline h-4 w-4" /> Back
                </UiButton>
            </div>

            <div class="divide-y divide-gray-200 rounded-xl border border-gray-200 bg-white px-6 text-sm md:text-base">
                <div class="grid grid-cols-1 gap-1 py-4 md:grid-cols-[140px_1fr] md:gap-4">
                    <span class="font-semibold text-gray-700">KP Number</span>
                    <span class="text-gray-900">{{ selected?.kpno ?? '-' }}</span>
                </div>

                <div class="grid grid-cols-1 gap-1 py-4 md:grid-cols-[140px_1fr] md:gap-4">
                    <span class="font-semibold text-gray-700">Factory</span>
                    <span class="text-gray-900">{{ selected?.factory ?? '-' }}</span>
                </div>

                <div class="flex items-end gap-3 py-4">
                    <div class="flex-1">
                        <UiMultiSelect v-model="selectedKk" label="KK" :options="kkOptions"
                            placeholder="-- Select KK --"/>
                    </div>
                </div>

                <div class="space-y-3 py-4">
                    <UiInput :key="dropKey" type="file" variant="dropzone" label="KK BC"
                        placeholder="Choose File" accept=".pdf,.xls,.xlsx"
                        dropzone-hint="only PDF, XLS, or XLSX Formats, up to 2MB"
                        @change="onFileChange" />

                    <div v-if="files.length" class="space-y-2">
                        <div
                            v-for="f in files"
                            :key="f.id"
                            class="group flex items-center justify-between gap-3 rounded-xl border border-gray-200 bg-white p-3 transition hover:border-gray-300 hover:bg-gray-50"
                        >
                            <div
                                class="flex min-w-0 flex-1 cursor-pointer items-center gap-3"
                                @click="downloadFile(f)"
                            >
                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                                    <DocumentIcon class="h-5 w-5" />
                                </div>

                                <div class="min-w-0 flex-1">
                                    <p class="truncate text-sm font-medium text-gray-800">
                                        {{ f.filename }}.{{ f.extension }}
                                    </p>
                                    <p class="mt-0.5 text-xs text-gray-400">
                                        Click to download the file
                                    </p>
                                </div>
                            </div>

                            <button
                                type="button"
                                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-gray-400 transition hover:bg-red-50 hover:text-red-600"
                                @click.stop="deleteFile(f)"
                                title="Delete file"
                                aria-label="Delete file"
                            >
                                <TrashIcon class="h-5 w-5" />
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 text-end">
                <UiButton variant="primary" :disabled="!selectedKk || (!newFile && !files.length)" @click="complete">Complete Upload</UiButton>
            </div>
        </div>
    </div>
</template>

<script setup>
import { ref, onMounted } from "vue";
import { useRoute, useRouter } from "vue-router";
import { useLoadingStore } from "@/stores/loading";
import { ArrowLeftIcon, DocumentIcon } from "@heroicons/vue/24/outline";
import { TrashIcon } from "@heroicons/vue/24/solid";
import { customSwal } from "@/composable/customSwal";

import UiButton from "@/components/ui/UiButton.vue";
import UiInput from "@/components/ui/UiInput.vue";
import UiTitle from "@/components/ui/UiTitle.vue";
import UiMultiSelect from "@/components/ui/UiMultiSelect.vue";

import api from "@/services/api";

defineOptions({ name: "UploadKk" });

const { confirmDelete, success, warning, error } = customSwal;
const loading = useLoadingStore();
const route = useRoute();
const router = useRouter();

const BASE = "/api/v1/order-artwork";
const EXTS = ["pdf", "xls", "xlsx"];
// SESUAIKAN dengan nama route halaman list allocation
const LIST_ROUTE = "order-artwork-allocation";

const selected = ref(null);
const kkOptions = ref([]);
const selectedKk = ref("");
const newFile = ref(null);
const files = ref([]);
const dropKey = ref(0);

const run = async (fn, msg = "Something went wrong") => {
    try {
        loading.show();
        await fn();
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
        else error(err?.response?.data?.message ?? msg);
    } finally {
        loading.hide();
    }
};

const toOptions = (list, value, label = value) => (list ?? []).map((i) => ({ value: i[value], label: i[label] }));

const goBack = () => router.push({ name: LIST_ROUTE });

const resetDropzone = () => {
    newFile.value = null;
    dropKey.value++;
};

const applyRow = (row) => {
    selected.value = row;
    files.value = Array.isArray(row.file) ? row.file : (row.file ? [row.file] : []);
};

// Ambil ulang data row dari API (pengganti syncFromGrid di versi modal)
const fetchRow = async () => {
    const { data } = await api.get(`${BASE}/getdata`, { params: { kpno: route.query.kpno } });
    const row = (data?.data ?? []).find((r) => String(r.id) === String(route.params.id));
    if (!row) {
        error("Data not found");
        return goBack();
    }
    applyRow(row);
    return row;
};

const fetchKkOptions = async (row) => {
    const { data } = await api.get(`${BASE}/selectkk`, { params: { kpno: row.kpno } });
    const list = toOptions(data?.data, "kk");
    if (row.kk && !list.some((o) => o.value === row.kk)) list.unshift({ value: row.kk, label: row.kk });
    kkOptions.value = list;
};

// Tidak lagi dipanggil dari tombol, tapi dari complete()
// (tanpa run, karena loading & error sudah ditangani oleh complete)
const saveKk = async () => {
    await api.put(
        `${BASE}/update-kk/${selectedKk.value}`,
        { kk: selected.value.kk }
    );
    selected.value.kk = selected.value.kk;
};

const onFileChange = (e) => {
    const file = e?.target?.files?.[0] ?? e?.[0] ?? (e instanceof File ? e : null);
    newFile.value = null;
    if (!file) return;

    if (!EXTS.includes(file.name.split(".").pop().toLowerCase())) {
        warning("Only PDF, XLS, or XLSX formats are allowed");
        return dropKey.value++;
    }
    newFile.value = file;
};

// Sama seperti sebelumnya, hanya dipanggil dari complete()
const uploadFile = async () => {
    const fd = new FormData();
    fd.append("kkbc", newFile.value);
    await api.post(`${BASE}/upload-kkbc/${selectedKk.value}`, fd, {
        headers: { "Content-Type": "multipart/form-data" },
    });
    resetDropzone();
};

const downloadFile = (f) => run(async () => {
    const res = await api.get(`${BASE}/showfile/${f.id}`, { responseType: "blob" });
    const url = URL.createObjectURL(res.data);
    const a = Object.assign(document.createElement("a"), {
        href: url,
        download: `${f.filename}.${f.extension}`,
    });
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
}, "Failed to download file");

const deleteFile = async (f) => {
    const result = await confirmDelete();
    if (!result.isConfirmed) return;

    try {
        loading.show();
        const { data } = await api.delete(`${BASE}/delete/${f.id}`);
        loading.hide();
        await success({ title: "Success", text: data?.message || "Data has been deleted successfully." });
        loading.show();
        await fetchRow();
        loading.hide();
    } catch (err) {
        loading.hide();
        if (err?.response?.status === 401) return router.push("/login");
        await error({
            title: "Delete Failed",
            text: err?.response?.data?.message || err?.message || "Failed to delete the data. Please try again.",
        });
    }
};

// Satu tombol: simpan KK -> upload file (jika ada file baru) -> complete
const complete = () => run(async () => {
    await saveKk();
    if (newFile.value) await uploadFile();

    const { data } = await api.post(`${BASE}/complete/${selected.value.id}`);
    success(data?.message ?? "Upload completed");
    goBack();
}, "Failed to complete upload");

onMounted(() => run(async () => {
    const row = await fetchRow();
    if (!row) return;
    selectedKk.value = row.kk ?? "";
    await fetchKkOptions(row);
}));
</script>