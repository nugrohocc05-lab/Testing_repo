    function getgroupbagianselect(Request $request)
    {
        $g = (new MasterEmployeeGroup())->getTable();
        $s = (new MasterEmployeeSection())->getTable();

        $gb = MasterEmployeeGroup::select(
            "$g.id as kodegroup",
            "$g.section_id as kodebagian",
            "$g.name as namagroup",
            "$s.name as namabagian"
        )
            ->join($s, "$s.id", '=', "$g.section_id")
            ->distinct()
            ->whereHas('groupline', function ($q) {
                $q->where('factory_id', session('db')->iddb)
                    ->where('is_show', 1)
                    ->where('is_line', 1);
            });

        if ($request->has('q')) {
            $search = $request->q;
            $gb = $gb->where("$s.name", 'like', "%$search%")
                ->orWhere("$g.name", 'like', "%$search%");
        }

        $gb = $gb->orderBy('kodegroup')->paginate(10, $request->page);
        return response()->json($gb);
    }

    function selectline(Request $request)
    {
        preconnect(session('db'));

        $od = (new OutputDetail())->getTable();
        $so = (new SewingOutput())->getTable();

        $data = OutputDetail::select("$so.line")
            ->join($so, "$so.barcode", "=", "$od.barcode")
            // ->where("$so.line", "=", session('db')->line)
            ->where("$so.station_id", "=", '0')
            ->groupBy("$so.line")
            ->orderBy("$so.line", 'asc');

        if ($request->datea && $request->dateb) {
            $start_date = Carbon::parse($request->datea)->startOfDay();
            $end_date = Carbon::parse($request->dateb)->endOfDay();

            $data = $data->whereBetween("$so.date", [$start_date, $end_date]);

        } else if (($request->datea && !$request->dateb) || (!$request->datea && $request->dateb)) {
            if ($request->dateb) {
                $date = Carbon::parse($request->dateb)->endOfDay();
            } else {
                $date = Carbon::parse($request->datea)->startOfDay();
            }

            $data = $data->whereDate("$so.date", $date);
        }

        if ($request->q) {
            $data = $data->where("$so.line", 'like', "%$request->q%");
        }

        $data = $data->paginate(15, ['*'], 'page', $request->page);

        return response()->json($data);
    }

    public function getreport(Request $request)
    {
        try {
            preconnect(session('db'));

            if (!$request->datea && !$request->dateb && !$request->line) {
                throw new \Exception("Select Date or Line First!");
            }

            $od = (new OutputDetail())->getTable();
            $po = (new PurchaseOrder())->getTable();
            $cb = (new CuttingBundle())->getTable();
            $so = (new SewingOutput())->getTable();

            $line = $request->line;

            // Filter tanggal
            $start_date = null;
            $end_date = null;

            if ($request->datea && $request->dateb) {

                $start_date = Carbon::parse($request->datea)->startOfDay();
                $end_date = Carbon::parse($request->dateb)->endOfDay();

                if ($start_date->gt($end_date)) {
                    throw new \Exception(
                        "Start Date Cannot Be Greater Than End Date."
                    );
                }

                if ($start_date->diffInDays($end_date) > 31) {
                    throw new \Exception(
                        "Date Has More Than 31 Days in Range, Cannot View Data."
                    );
                }

            } elseif ($request->datea) {

                $start_date = Carbon::parse($request->datea)->startOfDay();
                $end_date = Carbon::parse($request->datea)->endOfDay();

            } elseif ($request->dateb) {

                $start_date = Carbon::parse($request->dateb)->startOfDay();
                $end_date = Carbon::parse($request->dateb)->endOfDay();
            }

            // Query data output
            $outputdetail = OutputDetail::query()
                ->from("$od as od")
                ->select("od.*")

                // Quantity Input
                ->selectSub(function ($query) use (
                    $od,
                    $so,
                    $start_date,
                    $end_date,
                    $line
                ) {
                    $query->from("$so as so2")
                        ->selectRaw('COUNT(DISTINCT so2.barcode)')
                        ->join("$od as od2", 'od2.barcode', '=', 'so2.barcode')
                        ->whereColumn('od2.bundlecode', 'od.bundlecode')
                        ->where('so2.station_id', '0')

                        ->when($line, function ($q) use ($line) {
                            $q->where('so2.line', $line);
                        })

                        ->when($start_date && $end_date, function ($q) use (
                            $start_date,
                            $end_date
                        ) {
                            $q->whereBetween('so2.date', [
                                $start_date,
                                $end_date
                            ]);
                        });

                }, 'qty_input')

                ->addSelect(
                    "$po.idstyle",
                    "$so.date",
                    "$so.user_id as user",
                    "$so.line",
                    "$po.po",
                    "$po.kpno",
                    "$cb.qty as qty_bundle"
                )

                ->join($po, "od.idpo", "=", "$po.idpo")
                ->join($cb, "od.bundlecode", "=", "$cb.bundlecode")
                ->join($so, "od.barcode", "=", "$so.barcode")

                ->where("$so.station_id", '0')

                // Filter Line
                ->when($line, function ($q) use ($so, $line) {
                    $q->where("$so.line", $line);
                })

                // Filter Date
                ->when($start_date && $end_date, function ($q) use (
                    $so,
                    $start_date,
                    $end_date
                ) {
                    $q->whereBetween("$so.date", [
                        $start_date,
                        $end_date
                    ]);
                })

                // Mengambil output terakhir setiap bundle
                // berdasarkan filter tanggal dan line
                ->whereRaw("
                    $so.date = (
                        SELECT MAX(so2.date)
                        FROM $so so2
                        INNER JOIN $od od2
                            ON od2.barcode = so2.barcode
                        WHERE od2.bundlecode = od.bundlecode
                            AND so2.station_id = '0'
                            AND so2.line = $so.line
                            " . ($start_date && $end_date ? "
                                AND so2.date BETWEEN ? AND ?
                            " : "") . "
                    )
                ", $start_date && $end_date
                    ? [$start_date, $end_date]
                    : []
                )

                ->groupBy("od.bundlecode", "$so.line")
                ->get();

            $cb = (new CuttingBundle())->getTable();
            $ods = (new OutputDetailShell())->getTable();

            $bundle_number = [];

            foreach ($outputdetail as $o) {

                // Style
                $style = Style::where('idstyle', $o->idstyle)->first();
                $o->nmstyle = $style ? $style->nmstyle : '-';

                // Color
                $color = Color::where('idcolor', $o->idcolor)->first();
                $o->nmcolor = $color ? $color->nmcolor : '-';

                // Size
                $size = Size::where('idsize', $o->idsize)->first();
                $o->nmsize = $size ? $size->nmsize : '-';

                // Numbering Bundle
                if (!isset($bundle_number[$o->bundlecode])) {

                    $cutting = CuttingBundle::select(
                        "$ods.numa",
                        "$ods.numb"
                    )
                        ->join(
                            "$ods",
                            "$ods.bundlecode",
                            "=",
                            "$cb.bundlecode"
                        )
                        ->where("$ods.master", 1)
                        ->where("$cb.bundlecode", $o->bundlecode)
                        ->whereNotNull("$cb.scandate")
                        ->first();

                    $bundle_number[$o->bundlecode] = $cutting
                        ? $cutting->numa . ' - ' . $cutting->numb
                        : '-';
                }

                $o->numbering = $bundle_number[$o->bundlecode];
            }

            return response()->json($outputdetail);

        } catch (\Throwable $th) {

            return response()->json($th->getMessage(), 400);
        }
    }


