                label="Shipment Mode"
                placeholder="Shipment Mode"
                class="w-full"
                readonly
            />

            <div class="flex justify-end gap-2 pt-3">
                <UiButton
                    variant="teritary"
                    @click="showSendModal = false"
                >
                    Cancel
                </UiButton>

                <UiButton @click="confirmSend">
                    Confirm
                </UiButton>
            </div>
        </div>
