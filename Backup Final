    function claim($token) {
        try {
            $data = decrypt($token);
        } catch (\Exception $e) {
            $data = null;
        }

        if (!$data) {
            return 'Unknown token';
        }

        if(!session('tokenmenu') or session('token') == null){
            session()->flush();
        }

        $db = DbList::find($data->factory);
        $mf = MasterFactory::find($data->factory);
        $db->keterangan = $mf ? $mf->name : '-';
        $db->name = $mf ? $mf->name : '-';
        $group = MasterEmployeeGroup::find($data->line);
        $db->department = "SEWING" ?? "-";
        $db->group = $group ? $group->name : '-';
        $db->ip = $data->ip;
        $db->line = $data->line;
        $db->home_link = route('loadingsewingmenu');
        preconnect($db);

        session(['idfactory' => $data->factory]);
        session(['db' => $db]);
        session(['tokenmenu'=>true]);

        return redirect()->route('loadingsewingmenu');
    }

    function getdatanik(Request $request) {
        try {
            $line = session('db')->line;
            if(!$line){
                throw new \Exception("Line not found!");
            }

            $nik = Employee::where("card_id", $request->nik)
                ->first();
            if(!$nik){
                throw new \Exception("Wrong NIK!");
            }

            $start_time = Carbon::now()->subHour(15);
            $end_time = Carbon::now();

            $attendance = EmployeeAttendance::where("nik", $nik->nik)
                ->where("factory_id", session('db')->iddb)
                ->whereBetween("time", [$start_time, $end_time])
                ->where("group_id", $line)
                ->orderBy("time", "DESC")
                ->first();

            if(!$attendance){
                throw new \Exception("Attendance not found!");
            }

            if(strpos($attendance->status, "OUT") !== false){
                throw new \Exception("Already Attendance OUT!");
            }

            $dept = MasterEmployeeDepartment::where("name", "SEWING")
                ->first();
            if(!$dept){
                throw new \Exception("Department Sewing not found!");
            }
            if($nik->department_id != $dept->id){
                throw new \Exception("Unauthorize!");
            }

            session(['user' => $nik]);
            Session::put('last_activity', time());
            return response()->json(true);
        } catch (\Throwable $e) {
            return response()->json($e->getMessage(), 400);
        }
    }

