    {
        field: "sendQty",
        headerName: "Send Qty",
        minWidth: 120,
        editable: true,
        flex: 1,

        valueSetter: (params) => {
            const value = Number(params.newValue);
            const balance = Number(params.data.balanceQty ?? 0);

            if (
                params.newValue === "" ||
                !Number.isFinite(value) ||
                value < 0 ||
                value > balance
            ) {
                return false;
            }

            params.data.sendQty = value;

            return true;
        },
    },
    {
        field: "unit",
        headerName: "Unit",
        minWidth: 100,
        flex: 1,
    },
    {
        headerName: "",
        field: "selected",
        width: 80,
        sortable: false,
        filter: false,
        resizable: false,
        headerComponent: SelectAllHeader,
        cellRenderer: (params) => {
            const checkbox = document.createElement("input");
            checkbox.type = "checkbox";
            checkbox.checked = params.value ?? false;

            checkbox.addEventListener("change", (event) => {
                const checked = event.target.checked;

                params.node.setDataValue("selected", checked);
                params.node.setDataValue(
                    "sendQty",
                    checked ? Number(params.data.balanceQty ?? 0) : 0
                );

                rawData.value = rawData.value.map((item) =>
                    item.idmaterial === params.data.idmaterial
                        ? {
                            ...item,
                            selected: checked,
                            sendQty: checked
                                ? Number(item.balanceQty ?? 0)
                                : 0,
                        }
                        : item
                );
            });

            return checkbox;
        },
    },
];

