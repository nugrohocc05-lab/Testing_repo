        headerName: "CRD",
        filter: "agDateColumnFilter",
        minWidth: 90,
        flex: 1,
        suppressHeaderFilterButton: true,  
        suppressHeaderMenuButton: true,
        filterParams: {
            comparator: (filterLocalDateAtMidnight, cellValue) => {
                if (!cellValue) return -1;

                const cellDate = new Date(cellValue);
                const cellDateMidnight = new Date(
                    cellDate.getFullYear(),
                    cellDate.getMonth(),
                    cellDate.getDate()
                );

                if (cellDateMidnight < filterLocalDateAtMidnight) return -1;
                if (cellDateMidnight > filterLocalDateAtMidnight) return 1;

                return 0;
            },
            inRangeInclusive: true
        }
    },
    {
        field: "qty_needed",
        headerName: "Qty Needed",
        minWidth: 120,
        width: 140,
        filter: false,
        flex: 1,
    },
    {
        field: "qty_sent",
        headerName: "Total Sent",
        minWidth: 100,
        filter: false,
        flex: 1,
    },
    {
        field: "balance",
        headerName: "Balance",
        minWidth: 100,
        filter: false,
        flex: 1,
    },
    {
        field: "percentage",
        headerName: "Delivery Pct (%)",
        minWidth: 140,
        filter: false,
        flex: 1,
