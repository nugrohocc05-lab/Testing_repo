const loadDataDetail = async () => {
    try {
        const id = dataSelected.value?.id;

        if (!id) {
            console.error("ID not found:", dataSelected.value);
            return;
        }

        loading.show();

        const { data } = await api.get(
            `/api/v1/ci/sizecolor/${encodeURIComponent(id)}`
        );

        const result = data?.data ?? {};

        const colors = result.colors ?? [];
        const sizes = result.sizes ?? [];
        const detail = result.detail ?? {};

        columnDetails.value = [
            {
                field: "color",
                headerName: "Color / Size",
                minWidth: 130,
                pinned: "left",
                sortable: false,
            },
            ...sizes.map((item) => ({
                field: item.size?.namasize,
                headerName: item.size?.namasize,
                minWidth: 80,
                flex: 1,
                sortable: false,
                valueFormatter: (params) =>
                    params.value == null || params.value === 0
                        ? "-"
                        : params.value,
            })),
        ];

        detailData.value = colors.map((item) => {
            const row = {
                color: item.color?.namacolor ?? "-",
            };

            sizes.forEach((sizeItem) => {
                const sizeId = sizeItem.idsize;
                const colorId = item.idcolor;
                const sizeName = sizeItem.size?.namasize;

                const key = `${sizeId}${colorId}`;

                row[sizeName] = detail[key] ?? 0;
            });

            return row;
        });
    } catch (err) {
        console.error(
            "Failed to retrieve size and color details:",
            err?.response?.data || err.message
        );

        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

const uploadFile = async () => {
    const id = dataSelected.value?.id;
    const file = fileUpload.value;
    const kk = dataSelected.value?.kk;

    if (!id) {
        await warning({
            title: "Invalid Data",
            text: "ID not found.",
        });
        return;
    }

    if (!kk) {
        console.log("Data selected:", dataSelected.value);
        await warning({
            title: "Invalid Data",
            text: "KK not found.",
        });
        return;
    }

    if (!(file instanceof File)) {
        await warning({
            title: "No File Selected",
            text: "Please select the Cutting Instruction file first.",
        });
        return;
    }

    const extension = file.name.split(".").pop()?.toLowerCase();
    const allowedExtensions = ["pdf", "xls", "xlsx"];

    if (!allowedExtensions.includes(extension)) {
        await warning({
            title: "Invalid File Format",
            text: "The file must be in PDF, XLS, or XLSX format.",
        });
        return;
    }

    if (file.size > 8 * 1024 * 1024) {
        await warning({
            title: "File Too Large",
            text: "Maximum file size is 8 MB.",
        });
        return;
    }

    try {
        loading.show();

        const formData = new FormData();
        formData.append("fs[]", file);
        formData.append("kk", String(kk));

        const { data } = await api.post(
            "/api/v1/ci/planning",
            formData
        );

        fileUpload.value = null;
        dropKey.value++;
        showModal.value = false;

        await loadData();

        await success({
            title: "Success",
            text: data?.message || "Cutting Instruction uploaded successfully.",
        });
    } catch (err) {
        console.error(
            "Upload error:",
            err?.response?.data || err.message
        );

        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Upload Failed",
            text:
                err?.response?.data?.message ||
                "The CI file failed to upload. Please try again.",
        });
    } finally {
        loading.hide();
    }
};
