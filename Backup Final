function get_data(Request $request)
    {
        try {
            $payload = decrypt($request->en);
        } catch (\Exception $e) {
            $payload = null;
        }

        if (!$payload) {
            return response()->json([
                'wip' => '-',
                'balance' => '-',
            ]);
        }

        con_db($payload->factory);

        if (!$request->kpno) {
            return response()->json(null);
        }

        $so = (new SewingOutput())->getTable();
        $od = (new OutputDetail())->getTable();
        $sz = (new Size())->getTable();
        $hdb = (new HistoryDataBreakdown())->getTable();

        $idpos = OutputDetail::select('idpo')
            ->join($so, "$so.barcode", '=', "$od.barcode")
            ->where('line', $payload->line)
            ->where('kpno', $request->kpno)
            ->groupBy('idpo')
            ->get();

        $pos = HistoryPO::select('id', 'idpo', 'kpno', 'po')
            ->whereHas('cuttingpo', function($q) use($request,$idpos){
                $q->whereIn('idpo', $idpos->pluck('idpo'))
                ->where('kpno', $request->kpno);
            })
            ->get();

        $sizes = HistoryDataBreakdown::select("$hdb.idsize", "$sz.nmsize")
            ->whereHas('cuttingdbreakdown')
            ->join($sz, "$sz.idsize", '=', "$hdb.idsize")
            ->whereIn('id', $pos->pluck('id'))
            ->groupBy("$hdb.idsize")
            ->get();
 
        $view = view('monitoring::loadingdashboard.table', [
            'sizes' => $sizes,
            'pos' => $pos,
            'kpno' => $request->kpno,
            'en' => $request->en,
            'ctrl' => $this,
        ]);

        return response()->json($view->render());
    }

