				@if($ishanger)
				var eff_g = {!! $param ? $param->where('key', 'line_hanger_effgreen')->first()->value : 0 !!};
				var eff_o = {!! $param ? $param->where('key', 'line_hanger_efforange')->first()->value : 0 !!};
				@else
				var eff_g = {!! $param ? $param->where('key', 'line_effgreen')->first()->value : 0 !!};
				var eff_o = {!! $param ? $param->where('key', 'line_efforange')->first()->value : 0 !!};
				@endif

				var out_g = {!! $param ? $param->where('key', 'line_outputgreen')->first()->value : 0 !!};
				var out_o = {!! $param ? $param->where('key', 'line_outputorange')->first()->value : 0 !!};

				var rft_g = {!! $param ? $param->where('key', 'line_rftgreen')->first()->value : 0 !!};
				var rft_o = {!! $param ? $param->where('key', 'line_rftorange')->first()->value : 0 !!};

				var img_def = '{!! $ishanger ? _asset('img/fff.png') : "" !!}';

				var target_perhour = 40;

				var data_style = '';

                @if(session('monitoring'))
		        setInterval(function() {
		            d = new Date();
		            h = set(d.getHours());
		            m = set(d.getMinutes());
		            s = set(d.getSeconds());
		            $('#hours').text(h + ':' + m + ':' + s);
		        }, 1000);
                @endif

		        getheader();
		        getsumoutput();
		        getdataoutput();
		        getimage();

		        function set(e) {
		            e = e < 10 ? '0' + e : e;
		            return e;
		        }

		        function getimage() {
		        	if(!data_style) {
		        		setTimeout(function() {
		        			getimage();
		        		}, 60000);
	        			return;
	        		}

		        	$.ajax({
		        		url: '{!! $imagelink !!}',
		        		type: 'GET',
		        		dataType: 'json',
		        		data: {
		        			style: data_style
		        		},
		        	})
		        	.done(function(d) {
		        		if(d) {
							if(d.status == 'success') {
								$('#styleimg').attr('src', d.data);
							} else {
		        				$('#styleimg').attr('src', img_def);
							}
		        		} else {
		        			$('#styleimg').attr('src', img_def);
		        		}
		        	})
		        	.fail(function() {
		        		$('#styleimg').attr('src', img_def);
		        	})
		        	.always(function() {
		        		setTimeout(function() {
		        			getimage();
		        		}, 600000);
		        	});
		        }

		        function getdataoutput() {
		        	$.ajax({
		        		url: '{!! $dataoutputlink !!}',
		        		type: 'GET',
		        		dataType: 'json',
		        	})
		        	.done(function(data) {
		        		if(data.status == 'success') {
			        		$('#smvwarning').hide();
			        		$('.table-output').show();

		        			$('.table-output').find('tbody').html('');
		        			$.each(data.data, function(i, v) {
		        				if(v.status != 'ok')
		        				{
			        				$('.table-output').find('tbody').append('<tr>' +
				        				'<td><small>' + v.stime + '-' + v.ftime + '</small></td>' +
				        				'<td style="width: 3%"></td>' +
				        				'<td style="background-color: gray; color: white;" colspan="5">Time Off</td>' +
				        				'<tr><td height="15px"></td></tr>'
			        				);
		        				}
		        				else
		        				{
		        					var _out_percent = (v.output / v.target) * 100;
		        					var _out_clr = (_out_percent >= out_g ? c_green : (_out_percent >= out_o ? c_orange : c_red));
		        					var _rft_clr = (v.rft >= rft_g ? c_green : (v.rft >= rft_o ? c_orange : c_red));
		        					var _eff_clr = (v.eff >= eff_g ? c_green : (v.eff >= eff_o ? c_orange : c_red));

		        					if(v.islast)
		        					{
		        						_out_clr = 'gray';
		        						_rft_clr = 'gray';
		        						_eff_clr = 'gray';
		        					}

			        				$('.table-output').find('tbody').append(
			        					'<tr>' +
					        				'<td><small>' + v.stime + '-' + v.ftime + '</small></td>' +
					        				'<td style="width: 3%"></td>' +
					        				'<td style="background-color: ' + _out_clr + '; color: white;">' + v.output + '</td>' +
					        				'<td style="width: 3%"></td>' +
					        				'<td style="background-color: ' + _rft_clr + '; color: white;">' +parseFloat(v.rft).toFixed(2) + '</td>' +
					        				'<td style="width: 3%"></td>' +
					        				'<td style="background-color: ' + _eff_clr + '; color: '+ (v.islast && !v.isfull ? 'gray' : (v.islast && v.isfull ? 'white' : 'white')) +';">' + v.eff + '</td>' +
				        				'</tr>' +
				        				'<tr><td height="15px"></td></tr>'
			        				);
		        				}
		        			});
		        		} else {
			        		$('#smvwarning').show();
			        		$('.table-output').hide();
		        		}
		        	})
		        	.fail(function(x, h, r) {
		        		$('#smvwarning').show();
		        		$('.table-output').hide();
                        swal('Warning!', x.responseText, 'warning');
		        	})
		        	.always(function() {
		        		setTimeout(function() {
		        			getdataoutput();
		        		}, 60000);
		        	});
		        }

		        function getheader() {
		        	$.ajax({
		        		url: '{!! $headerlink !!}',
		        		type: 'GET',
		        		dataType: 'json',
		        	})
		        	.done(function(data) {
		        		if(data.status == 'success') {
		        			$('#td-kp').text(data.kpno);
		        			$('#td-style').text(data.style.nmstyle);
		        			data_style = data.style.idstyle;
		        			$('#td-taktime').text((3600/data.targetperhour).toFixed(2) + ' SEC');
		        			$('#td-target').text(data.targetperhour + ' PCS/HOUR');
		        			$('#td-mp').html(data.mp+" of "+data.target_mp);
		        			$('#td-runday').text(data.runday + ' DAY(S)');
		        			target_perhour = data.targetperhour;
		        		}else{
							if(data.status == 'warning'){
								$('#td-mp').html(data.mp+" of "+data.target_mp);
							}
						}

						if(data.magicbtn){
							$('.block-wip').hide();
						}
		        	})
		        	.fail(function(x, h, r) {
		        		swal('Warning!', x.responseText, 'warning');
		        	})
		        	.always(function() {
		        		setTimeout(function() {
		        			getheader();
		        		}, 200000);
		        	});
		        }

		        function getsumoutput() {
		        	$.ajax({
		        		url: '{!! $sumoutputlink !!}',
		        		type: 'GET',
		        		dataType: 'json',
		        	})
		        	.done(function(data) {
		        		if(data.status == 'success' && data.smv > 0) {
		        			$('#td-output').text(data.output+' / '+data.target);
		        			$('#td-rft').text(data.rft);
		        			$('#td-eff').text(data.eff);
		        			$('#worktime').text((data.tot_worktime).toFixed(2) + ' Hour(s)');
		        			let _m_output = data.outputpercent;
		        			let _c_out = _m_output > out_g ? c_green : (_m_output > out_o ? c_orange : c_red);
		        			let _c_rft = data.rft > rft_g ? c_green : (data.rft > rft_o ? c_orange : c_red);
		        			let _c_eff = data.eff > eff_g ? c_green : (data.eff > eff_o ? c_orange : c_red);
		        			$('#td-output-col').attr('fill', _c_out);
		        			$('#td-rft-col').attr('fill', _c_rft);
		        			$('#td-eff-col').attr('fill', _c_eff);
		        			$('#wip').find('svg').find('circle').show();
                            const rat = data.wip.ratio * 100;
							const valWip = data.wip.wip;
							const targetWip = data.wip.wip_target;
		        			$('#wip').find('svg').find('.donut-segment').attr('stroke-dasharray', `${rat} ${100 - rat}`);
							$('#valWip').text(valWip+' / '+targetWip);
                            $('#greenlight').css('background-color', '#37683a');
                            $('#redlight').css('background-color', '#724f4f');
                            $('#orangelight').css('background-color', '#5e5232');
                            $('#greenlight').removeClass('blink');
                            $('#redlight').removeClass('blink');
                            $('#orangelight').removeClass('blink');
                            if (data.defect < 1) {
                                $('#greenlight').css('background-color', '#0cfc00');
                                $('#greenlight').addClass('blink');
                            } else if (data.defect >= 3) {
                                $('#redlight').css('background-color', c_red);
                                $('#redlight').addClass('blink');
                            } else {
                                $('#orangelight').css('background-color', '#fff200');
                                $('#orangelight').addClass('blink');
                            }
                            $('#soilmon').css('background-color', '#272751');
                            $('#soilmon').removeClass('blink');
                            if (data.soil >= 10) {
                                $('#soilmon').css('background-color', '#00fcfc');
                                $('#soilmon').addClass('blink');
                            }
		        		}
		        		else
		        		{
		        			swal('SMV not Found!', 'Please fill in the SMV and the Target from the web.', 'warning');

		        			$('#td-output').text('-');
		        			$('#td-rft').text('-');
		        			$('#td-eff').text('-');
		        			$('#worktime').text('-');
		        			$('#td-output-col').attr('fill', '#000000');
		        			$('#td-rft-col').attr('fill', '#000000');
		        			$('#td-eff-col').attr('fill', '#000000');
		        			$('#wip').find('svg').find('circle').hide();
		        		}
		        	})
		        	.fail(function(x, h, r) {
		        		swal('Warning!', x.responseText, 'warning');
		        	})
		        	.always(function() {
		        		setTimeout(function() {
		        			getsumoutput();
		        		}, 60000);
		        	});
		        }
				$('body').on('click', '#mpbtn', function(e) {
					e.preventDefault();
					const link = $(this).data('link');
					$('#loading').show();
					$.ajax({
							url: link,
							type: 'GET',
							dataType: 'json',
						})
						.done(function(data) {
							$('#detail-operator').modal('show').find('.modal-body').html(data);
						})
						.fail((e) => {
							swal('Warning!', e.responseText, 'warning');
						})
						.always(function() {
							$('#loading').hide();
						});
				});
			});

			$(document).on('click', '.btn-close-modal', function () {
				$(this).closest('#detail-modal2').modal('hide');
			});

			$(document).on('click', '.detailbtn', function (e) {
				e.preventDefault();

				const data = $(this).data('nik');
				const url = `{!! route('ie_matrixscorereportnikdetail', ['nik' => '']) !!}/${data}`;

				$('#loading').show();

				$.get(url, function (r) {
					$('#detail-body').html(r);

					$('#detail-modal2').modal({
						backdrop: 'static',
						keyboard: false
					});
				}).always(() => {
					$('#loading').hide();
				});
			});
		</script>
	</body>
</html>
