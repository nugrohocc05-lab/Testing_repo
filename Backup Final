                            </p>
                        </div>
                    </div>
            </div>
        </UiCard>
    </div>

    <UiModal
        v-model="showSendModal"
        title="Receiving Confirmation"
        size="2xl"
    >
        <div class="space-y-4 -mt-3">
            <UiInput
                type="file"
                variant="dropzone"
                label="File Delivery Orders"
                placeholder="Choose File"
                dropzone-hint="Only PDF, XLS, or XLSX formats, up to 2MB"
                accept=".pdf,.xls,.xlsx"
                @change="handleFile"
            />

            <div class="flex justify-end gap-2 pt-3">
                <UiButton variant="teritary" @click="showSendModal = false">
                    Cancel
                </UiButton>

                <UiButton @click="confirmSend">
                    Confirm
                </UiButton>
            </div>
        </div>
    </UiModal>
</template>

<script setup>
import { ref, shallowRef, computed, onMounted, watch } from "vue";

import { useRouter, useRoute } from "vue-router";
import { MagnifyingGlassIcon, ArrowLeftStartOnRectangleIcon } from "@heroicons/vue/24/outline";

import { decrypt } from "@/utils/crypto";
import { useLoadingStore } from "@/stores/loading";
import { customSwal } from "@/composable/customSwal";
import api from "@/services/api";

import UiButton from "@/components/ui/UiButton.vue";
import UiInput from "@/components/ui/UiInput.vue";
import UiTitle from "@/components/ui/UiTitle.vue";
import UiAgGrid from "@/components/ui/UiAgGrid.vue";
import UiModal from "@/components/ui/UiModal.vue";
import UiCard from "@/components/ui/UiCard.vue";
import UiMultiSelect from "@/components/ui/UiMultiSelect.vue";
import FileIcon from "@/components/ui/FileIcon.vue";

const { success, warning, error } = customSwal;

const loading = useLoadingStore();
const router = useRouter();
const route = useRoute();

const kk = decrypt(decodeURIComponent(route.params.kk));
const kpno = decrypt(decodeURIComponent(route.params.kpno));
const pro = decrypt(decodeURIComponent(route.params.pro));

const rawData = shallowRef([]);
const rawDataFiles = ref([]);
const rawDataFilesDelivery = ref([]);

const searchKeyword = ref("");
const description = ref("");
const showSendModal = ref(false);
const deliveryOrderFile = ref(null);

const selectedDo = ref([]);
const all_do = ref([]);
const defaultDo = ref("");
const selectedCount = ref(0);

const updateSelectedCount = () => {
    selectedCount.value = rawData.value.filter(
        (item) => item.selected === true && !item.isReceived
    ).length;
};

const allMaterialsSelected = computed(() => {
    const unreceivedMaterials = rawData.value.filter(
        (item) => !item.isReceived
    );

    const allSelected =
        unreceivedMaterials.length > 0 &&
        unreceivedMaterials.every(
            (item) => item.selected === true
        );

    return allSelected;
});

const normalizedDates = computed(() => {
    const v = selectedDo.value;
    const arr = Array.isArray(v) ? v : v ? [v] : [];
    return arr
        .map((d) => (typeof d === "object" && d !== null ? d.value : d))
        .filter(Boolean);
});

const resetDateFilter = () => {
    selectedDo.value = [];
};

const formatDate = (date) => {
    if (!date) return '-';

    const d = new Date(date);

    const isDate = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Jakarta',
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
    }).format(d).replace(/\//g, '-');

    const time = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Jakarta',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
    }).format(d);

    return `${isDate} | ${time}`;
};

watch(
    selectedDo,
    () => {
        loadData();
    },
    { deep: true }
);
const defaultColDef = {
    sortable: true,
    filter: false,
    resizable: true,
};

const getBalance = (data) => {
    return (data?.deliverydetail ?? []).reduce(
        (total, detail) => total + Number(detail.sendqty ?? 0),
        0
    );
};

const handleFile = (event) => {
    const file =
        event?.target?.files?.[0] ??
        event?.files?.[0] ??
        event?.[0] ??
        (event instanceof File ? event : null);

    deliveryOrderFile.value = file;
};

class SelectAllHeader {
    init(params) {
        this.params = params;

        this.eGui = document.createElement("div");
        this.eGui.style.display = "flex";
        this.eGui.style.alignItems = "center";
        this.eGui.style.justifyContent = "center";
        this.eGui.style.height = "100%";

        this.checkbox = document.createElement("input");
        this.checkbox.type = "checkbox";
        this.checkbox.title = "Select All";
        this.checkbox.style.cursor = "pointer";

        this.onChange = (event) => {
            const checked = event.target.checked;

            this.params.api.forEachNode((node) => {
                if (!node.data || node.data.isReceived) return;

                const receiveQty = checked
                    ? getBalance(node.data)
                    : 0;

                node.setDataValue("selected", checked);
                node.setDataValue("qty", receiveQty);

                const row = rawData.value.find(
                    (item) =>
                        item.idmaterial === node.data.idmaterial
                );

                if (row) {
                    row.selected = checked;
                    row.qty = receiveQty;
                }
            });

            updateSelectedCount();

            this.params.api.refreshCells({ force: true });
        };

        this.checkbox.addEventListener("change", this.onChange);

        this.eGui.appendChild(this.checkbox);

        this.onModelUpdated = () => this.updateVisibility();

        this.params.api.addEventListener(
            "modelUpdated",
            this.onModelUpdated
        );

        this.params.api.addEventListener(
            "cellValueChanged",
            this.onModelUpdated
        );

        this.updateVisibility();
    }

    updateVisibility() {
        let hasUnreceived = false;
        let allSelected = true;

        this.params.api.forEachNode((node) => {
            if (!node.data || node.data.isReceived) return;

            hasUnreceived = true;

            if (!node.data.selected) {
                allSelected = false;
            }
        });

        this.eGui.style.display = hasUnreceived ? "flex" : "none";

        this.checkbox.checked = hasUnreceived && allSelected;
    }

    getGui() {
        return this.eGui;
    }

    refresh() {
        return false;
    }

    destroy() {
        this.params.api.removeEventListener(
            "modelUpdated",
            this.onModelUpdated
        );

        this.params.api.removeEventListener(
            "cellValueChanged",
            this.onModelUpdated
        );

        this.checkbox.removeEventListener(
            "change",
            this.onChange
        );
    }
}


const columnDefs = [
    {
        headerName: "No",
        field: "no",
        width: 80,
        sortable: false,
        filter: false,
        resizable: false,
    },
    {
        field: "itemdesc",
        headerName: "Item Number",
        minWidth: 120,
        flex: 1,
    },
    {
        field: "matcontents",
        headerName: "Item Desc",
        minWidth: 160,
        flex: 1,
    },
    {
        field: "colorcode",
        headerName: "Color Code",
        minWidth: 120,
        flex: 1,
    },
    {
        field: "size",
        headerName: "Size",
        minWidth: 180,
        flex: 1,
    },
    {
        headerName: "Sent Quantity",
        minWidth: 120,
        flex: 1,
        valueGetter: (params) =>
            (params.data?.deliverydetail ?? []).reduce(
                (total, item) => total + Number(item.sendqty ?? 0),
                0
            ),
    },
    {
        field: "qty",
        headerName: "Receive Qty",
        minWidth: 120,
        flex: 1,
        valueGetter: (params) => Number(params.data?.qty ?? 0),
    },
    {
        field: "unit",
        headerName: "Unit",
        minWidth: 90,
        flex: 1,
    },
    {
    headerName: "",
    field: "selected",
    width: 110,
    sortable: false,
    filter: false,
    resizable: false,
    headerComponent: SelectAllHeader,

    cellRenderer: (params) => {
        if (params.data?.isReceived) {
            const badge = document.createElement("span");
            badge.textContent = "Received";
            badge.className =
                "inline-flex items-center rounded-lg bg-green-100 px-4 py-1 text-xs font-medium text-green-700";

            return badge;
        }

            const checkbox = document.createElement("input");

            checkbox.type = "checkbox";
            checkbox.checked = Boolean(params.data?.selected);
            checkbox.style.cursor = "pointer";

            checkbox.addEventListener("click", (event) => {
                event.stopPropagation();
            });

            checkbox.addEventListener("change", (event) => {
                const checked = event.target.checked;

                params.node.setDataValue("selected", checked);

                const receiveQty = checked
                    ? getBalance(params.data)
                    : 0;

                params.node.setDataValue("qty", receiveQty);

                const row = rawData.value.find(
                    (item) => item.idmaterial === params.data.idmaterial
                );

                if (row) {
                    row.selected = checked;
                    row.qty = receiveQty;
                }

                updateSelectedCount();

                params.api.refreshHeader();
            });

            return checkbox;
        },
    },
];

const openReceiveModal = async () => {
    const unreceivedMaterials = rawData.value.filter(
        (item) => !item.isReceived
    );

    const allSelected =
        unreceivedMaterials.length > 0 &&
        unreceivedMaterials.every(
            (item) => item.selected === true
        );

    if (!allSelected) {
        await warning({
            title: "Incomplete Selection",
            text: "Please select all materials before proceeding.",
        });

        return;
    }

    showSendModal.value = true;
};

const confirmSend = async () => {
    await sendData();
};

const sendData = async () => {
    try {

        if (!allMaterialsSelected.value) {
            await warning({
                title: "Incomplete Selection",
                text: "All materials must be selected before receiving.",
            });
            return;
        }

        const selectedRows = rawData.value.filter(
            (item) => item.selected === true && !item.isReceived
        );

        if (selectedRows.length === 0) {
            await warning({
                title: "Incomplete Data",
                text: "Select material with Qty greater than 0.",
            });

            return;
        }

        const invalidQty = selectedRows.some((item) => {
            const qty = Number(item.qty);
            return !Number.isFinite(qty) || qty <= 0 || qty > getBalance(item);
        });

        if (invalidQty) {
            await warning({
                title: "Invalid Quantity",
                text: "The Receive Qty must be greater than 0 and cannot exceed the Balance.",
            });
            return;
        }

        if (!deliveryOrderFile.value) {
            await warning({
                title: "Incomplete Data",
                text: "Upload the Delivery Order file first.",
            });
            return;
        }

        // loading.show();

        const formData = new FormData();

        formData.append("kpno", kpno);
        formData.append("combine_pro", pro);
        formData.append("kk", kk);

        const doNumber =
        normalizedDates.value[0] || defaultDo.value;

        formData.append("do_number", doNumber);

        selectedRows.forEach((item) => {
            formData.append(
                `inputqty[${item.idmaterial}]`,
                String(item.qty)
            );
        });

        formData.append("deliveryorders", deliveryOrderFile.value);

        const { data } = await api.post(
            `/api/v1/receivematerial/receive`,
            formData
        );

        // loading.hide();

        showSendModal.value = false;
        deliveryOrderFile.value = null;

        await success({
            title: "Success",
            text: data?.message ?? "Material received successfully.",
        });

        if (selectedDo.value.length > 0) {
            selectedDo.value = [];
        } else {
            await loadData();
        }
    } catch (err) {
        loading.hide();
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Receive Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to receive materials.",
        });
    } finally {
        loading.hide();
    }
};

let loadSeq = 0;

const loadData = async () => {
    const seq = ++loadSeq;

    try {
        loading.show();

        const params = new URLSearchParams({
            kpno,
            combine_pro: pro,
            kk,
        });

        const doNumber = normalizedDates.value.length > 0
            ? normalizedDates.value
            : defaultDo.value
                ? [defaultDo.value]
                : [];

        doNumber.forEach((doNumber) => {
            params.append("do_number", doNumber);
        });

        const { data } = await api.get(
            `/api/v1/receivematerial/input?${params.toString()}`
        );

        if (seq !== loadSeq) return;

        if (!data?.success) {
            rawData.value = [];
            rawDataFiles.value = [];
            description.value = "";
            return;
        }

        description.value =
            data?.data?.description[0] ?? "";

        rawData.value = (data?.data?.materials ?? [])
            .map((item, index) => {
                const details = item.deliverydetail ?? [];

                const sentQty = details.reduce(
                    (total, detail) =>
                        total + Number(detail.sendqty ?? 0),
                    0
                );

                const isReceived =
                    details.length > 0 &&
                    details.every(
                        (detail) => detail.status === "Received"
                    );

                const receivedQty = details.reduce(
                    (total, detail) =>
                        total + Number(detail.receiveqty ?? detail.recieveqty ?? 0),
                    0
                );

                return {
                    ...item,
                    no: index + 1,
                    isReceived,
                    qty: isReceived ? receivedQty : 0,
                    selected: false,
                };
            })
            .filter((item) =>
                item.deliverydetail.some(
                    (detail) => Number(detail.sendqty ?? 0) > 0
                )
            );

        updateSelectedCount();

        const receiveFiles = data?.data?.receivefiles;

        rawDataFiles.value = (
            Array.isArray(receiveFiles)
                ? receiveFiles
                : receiveFiles
                    ? [receiveFiles]
                    : []
        ).map((item, index) => ({
            ...item,
            no: index + 1,
        }));

        const files = data?.data?.files;

        rawDataFilesDelivery.value = (
            Array.isArray(files)
                ? files
                : files
                    ? [files]
                    : []
        ).map((item, index) => ({
            ...item,
            no: index + 1,
        }));

    } catch (err) {
        loading.hide();
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Failed to Load Data",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to load material data.",
        });
    } finally {
        loading.hide();
    }
};

const loadDataDO = async () => {
    try {
        loading.show();

        const endpoint =
            `/api/v1/receivematerial/selectdo?kpno=${encodeURIComponent(kpno)}` +
            `&kk=${encodeURIComponent(kk)}` +
            `&combine_pro=${encodeURIComponent(pro)}`;

        const { data } = await api.get(endpoint);

        all_do.value = (data?.data?.do_numbers ?? []).map((item) => ({
            value: item.do_number,
            label: item.do_number,
        }));

        defaultDo.value = all_do.value[0]?.value ?? "";

        selectedDo.value = [];

        defaultDo.value = all_do.value[0]?.value ?? "";

        selectedDo.value = defaultDo.value
            ? [defaultDo.value]
            : [];
    } catch (err) {
        loading.hide();
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Failed to Load DO",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to load DO options.",
        });
    } finally {
        loading.hide();
    }
};  


const downloadFile = async (file) => {
    let url = null;

    try {
        loading.show();

        const endpoint = `/api/v1/deliverymaterial/showfile/${encodeURIComponent(file.filename)}`;

        const response = await api.get(endpoint, {
            responseType: "blob",
        });

        if (!response.data || response.data.size === 0) {
            throw new Error("File is empty or unavailable.");
        }

        const blob = new Blob([response.data], {
            type: response.data.type || "application/octet-stream",
        });

        url = window.URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = url;
        link.download = `${file.filename}.${file.extension}`;

        document.body.appendChild(link);
        link.click();
        link.remove();

        setTimeout(() => {
            window.URL.revokeObjectURL(url);
        }, 1000);

    } catch (err) {
        console.error("Download error:", err);

        let message = "An error occurred while downloading the file.";

        if (err.response?.data instanceof Blob) {
            try {
                const text = await err.response.data.text();
                const errorData = JSON.parse(text);
                message = errorData.message || message;
            } catch {
                message = "Failed to download file.";
            }
        } else {
            message =
                err.response?.data?.message ||
                err.message ||
                message;
        }

        await customSwal.error({
            title: "Download Failed",
            text: message,
        });

    } finally {
        loading.hide();
    }
};


onMounted(async () => {
    await loadDataDO();
    await loadData();
});
</script>

