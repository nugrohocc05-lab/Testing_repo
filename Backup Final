                        <div
                            class="flex min-w-0 flex-1 cursor-pointer items-center gap-3">
                                <div
                                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-gray-50"
                                >
                                    <!-- <FileIcon :extension="f.extension" /> -->
                                    <FileIcon />
                                </div>

                                <div class="min-w-0 flex-1">
                                    <p class="truncate text-sm font-medium text-gray-800">
                                        Testing.txt
                                    </p>
                                    <p class="mt-0.5 text-xs text-gray-400">
                                        Click to download the file
                                    </p>
                                </div>
                            </div>
                        </div>
<!-- 
                        <p
                            v-if="!rawDataArtwork.file?.length"
                            class="text-sm italic text-gray-400"
                        >
                            No files available.
                        </p> -->
                    </div>
            <UiGrid cols="8" gap="sm">
                <div><span class="label">Description</span> : {{ description }}</div>
            </UiGrid>
            <UiAgGrid
                class="my-zebra-grid mt-3"
                :rowData="rawData"
                :columnDefs="columnDefs"
                :quickFilterText="searchKeyword"
                :defaultColDef="defaultColDef"
            />
