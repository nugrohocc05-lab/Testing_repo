const loadDataFilter = async () => {
    const currentRequest = ++requestId;

    try {
        loading.show();

        const params = new URLSearchParams();

        const season = form.value.season ?? "";
        const factory = form.value.factory ?? "";

        if (season) {
            params.append("season", season);
        }

        if (factory) {
            params.append("factory", factory);
        }

        const endpoint = `/api/v1/deliverymaterial/getdata?${params.toString()}`;

        const { data } = await api.get(endpoint);

        // Abaikan response dari request sebelumnya
        if (currentRequest !== requestId) return;

        rawData.value = (data?.data ?? []).map((item, index) => ({
            ...item,
            no: index + 1,
        }));

        await nextTick();

    } catch (err) {
        if (currentRequest !== requestId) return;

        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        if (currentRequest === requestId) {
            loading.hide();
        }
    }
};

const loadDataSeason = async () => {
    try {
        loading.show();
        const endpoint = "/api/v1/deliverymaterial/selectseason";
        const { data } = await api.get(endpoint);
        all_season.value = (data?.data ?? []).map((item) => ({
            value: item,
            label: item,
        }));
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};
const loadDataFactory = async () => {
    try {
        loading.show();
        const endpoint = `/api/v1/deliverymaterial/selectfactory`;
        const { data } = await api.get(endpoint);
        factorys.value = (data?.data ?? []).map((item) => ({
            value: item.idfactory,
            label: item.namafactory,
        }));
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

