<script type="text/javascript">
    $(document).ready(() => {
        function set(e) {
            e = e < 10 ? '0' + e : e;
            return e;
        }

        @if(session('monitoring'))
        setInterval(function() {
            d = new Date();
            h = set(d.getHours());
            m = set(d.getMinutes());
            s = set(d.getSeconds());
            $('#hours').text(h + ':' + m + ':' + s);
        }, 1000);
        @endif

        function getdata() {
            $.ajax({
                type: "get",
                url: "{!! route('chief_monitoring_endlinesummarydata') !!}",
                dataType: "html",
                success: (r) => {
                    $('#data-container').html(r);
                },
                complete: () => {
                    setTimeout(() => {
                        getdata();
                    }, 60000);
                }
            });
        }

        setTimeout(() => {
            getdata();
        }, 60000);

        $('body').on('click', '.clickable', (e) => {
            window.location = $(e.currentTarget).data('href');
        });
    });
</script>
