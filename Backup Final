    <script>
        $(document).ready(function() {
            var started = false;

            // ---------- Clock ----------
            function updateClock() {
                var now = new Date();
                var optionsDate = {
                    weekday: 'long',
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                };
                var formattedDate = now.toLocaleDateString('en-US', optionsDate);
                var parts = formattedDate.replace(',', '').split(' ');
                var customDate = parts[0] + ', ' + parts[1] + ' ' + parts[2] + ' ' + parts[3];
                $('#live-date').text(customDate);
            }
            updateClock();
            setInterval(updateClock, 1000);

            // ---------- Play: buka semua input ----------
            $('#btnPlay').on('click', function() {
                if (started) return;
                started = true;
                $('.lay-input, .lay-action').prop('disabled', false);
                $(this).addClass('started').attr('title', 'Started');
            });

            // ---------- Templates ----------
            function yardInch(clsYard, clsInch, valYard, valInch, maxWidth) {
                return `
                    <input type="text" class="form-control shadow-none lay-input ${clsYard}" value="${valYard}" style="max-width: ${maxWidth}px;">
                    <span class="text-nowrap me-1" style="font-size: 11px; font-weight: 600; color: #64748b;">- Yard</span>
                    <input type="text" class="form-control shadow-none lay-input ${clsInch}" value="${valInch}" style="max-width: ${maxWidth}px;">
                    <span class="text-nowrap" style="font-size: 11px; font-weight: 600; color: #64748b;">- Inch</span>`;
            }

            function plusButton(cls) {
                return `
                    <button type="button" class="btn lay-action ${cls} p-0 border-0 rounded-circle d-inline-flex align-items-center justify-content-center text-white" style="width: 24px; height: 24px; background-color: #3b93b8; flex-shrink: 0;">
                        <i class="bi bi-plus-lg" style="font-size: 12px;"></i>
                    </button>`;
            }

            function endbitRowTemplate() {
                return `
                    <div class="endbit-row d-flex align-items-center gap-2">
                        ${yardInch('input-endbit-yard', 'input-endbit-inch', '0', '0', 115)}
                        ${plusButton('btn-add-endbit')}
                    </div>`;
            }

            function spliceRowTemplate() {
                return `
                    <div class="splice-row row g-3 px-4 py-3 align-items-end">
                        <div class="col-lg-1 col-md-4">
                            <label class="form-label mb-2" style="font-size: 11px; font-weight: 600; color: #475569;">Heading</label>
                            <div class="splice-heading d-flex align-items-center" style="height: 38px; font-size: 13px; font-weight: 700; color: #1e293b;">1</div>
                        </div>
                        <div class="col-lg-4 col-md-4">
                            <label class="form-label mb-2" style="font-size: 11px; font-weight: 600; color: #475569;">Length</label>
                            <div class="d-flex align-items-center gap-2">
                                ${yardInch('input-splice-length-yard', 'input-splice-length-inch', '0', '01', 115)}
                            </div>
                        </div>
                        <div class="col-lg-5 col-md-4">
                            <label class="form-label mb-2" style="font-size: 11px; font-weight: 600; color: #475569;">Wastage</label>
                            <div class="d-flex align-items-center gap-2">
                                ${yardInch('input-splice-wastage-yard', 'input-splice-wastage-inch', '0', '01', 115)}
                                ${plusButton('btn-add-splice')}
                            </div>
                        </div>
                    </div>`;
            }

            function shadeTemplate() {
                return `
                    <div class="shade-item pt-4 mt-4" style="border-top: 1px solid #e2e8f0;">
                        <div class="d-flex justify-content-end mb-2">
                            <button type="button" class="btn lay-action btn-remove-shade p-0 border-0 text-danger" style="font-size: 11px; font-weight: 600;">
                                <i class="bi bi-trash"></i> Remove Shade
                            </button>
                        </div>
                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <label class="form-label mb-2" style="font-size: 11px; font-weight: 700; color: #334155;">Shade</label>
                                <input type="text" class="form-control shadow-none lay-input input-shade" value="" style="max-width: 280px;">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-2" style="font-size: 11px; font-weight: 700; color: #334155;">Actual Plies</label>
                                <input type="text" class="form-control shadow-none lay-input input-actual-plies" value="0" style="max-width: 280px;">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-2" style="font-size: 11px; font-weight: 700; color: #334155;">Damages</label>
                                <div class="d-flex align-items-center gap-2">
                                    ${yardInch('input-damages-yard', 'input-damages-inch', '0', '01', 115)}
                                </div>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label mb-2" style="font-size: 11px; font-weight: 700; color: #334155;">Endbits Generated</label>
                            <div class="endbits-list d-flex flex-column gap-2">
                                ${endbitRowTemplate()}
                            </div>
                        </div>
                    </div>`;
            }

            // Baris terakhir = tombol +, baris lainnya = tombol -
            function syncRowButtons($rows, addCls, removeCls) {
                $rows.each(function(index) {
                    var $btn = $(this).find('.lay-action').last();
                    if (index === $rows.length - 1) {
                        $btn.removeClass(removeCls)
                            .addClass(addCls)
                            .css('background-color', '#3b93b8')
                            .html('<i class="bi bi-plus-lg" style="font-size: 12px;"></i>');
                    } else {
                        $btn.removeClass(addCls)
                            .addClass(removeCls)
                            .css('background-color', '#ef4444')
                            .html('<i class="bi bi-dash-lg" style="font-size: 12px;"></i>');
                    }
                });
            }

            // ---------- Endbits ----------
            function syncEndbitButtons($list) {
                syncRowButtons($list.find('.endbit-row'), 'btn-add-endbit', 'btn-remove-endbit');
            }

            $(document).on('click', '.btn-add-endbit', function() {
                if (!started) return;
                var $list = $(this).closest('.endbits-list');
                $list.append(endbitRowTemplate());
                syncEndbitButtons($list);
            });

            $(document).on('click', '.btn-remove-endbit', function() {
                if (!started) return;
                var $list = $(this).closest('.endbits-list');
                $(this).closest('.endbit-row').remove();
                syncEndbitButtons($list);
            });

            // ---------- Splice ----------
            function syncSpliceRows() {
                var $rows = $('#spliceList .splice-row');
                $rows.each(function(index) {
                    $(this).find('.splice-heading').text(index + 1);
                });
                syncRowButtons($rows, 'btn-add-splice', 'btn-remove-splice');
            }

            function addSpliceRow() {
                if (!started) return;
                $('#spliceList').append(spliceRowTemplate());
                syncSpliceRows();
            }

            $('#btnAddSplice').on('click', addSpliceRow);
            $(document).on('click', '.btn-add-splice', addSpliceRow);

            $(document).on('click', '.btn-remove-splice', function() {
                if (!started) return;
                $(this).closest('.splice-row').remove();
                syncSpliceRows();
            });

            // ---------- Shade ----------
            $('#btnAddNewShade').on('click', function() {
                if (!started) return;
                $('#shadeContainer').append(shadeTemplate());
            });

            $(document).on('click', '.btn-remove-shade', function() {
                if (!started) return;
                $(this).closest('.shade-item').remove();
            });

            // ---------- Save ----------
            $('#btnSaveChanges').on('click', function() {
                if (!started) return;

                var splices = [];
                $('#spliceList .splice-row').each(function(index) {
                    splices.push({
                        heading: index + 1,
                        length: {
                            yard: $(this).find('.input-splice-length-yard').val(),
                            inch: $(this).find('.input-splice-length-inch').val()
                        },
                        wastage: {
                            yard: $(this).find('.input-splice-wastage-yard').val(),
                            inch: $(this).find('.input-splice-wastage-inch').val()
                        }
                    });
                });

                var shades = [];
                $('.shade-item').each(function() {
                    var endbitsArray = [];
                    $(this).find('.endbit-row').each(function() {
                        endbitsArray.push({
                            yard: $(this).find('.input-endbit-yard').val(),
                            inch: $(this).find('.input-endbit-inch').val()
                        });
                    });
                    shades.push({
                        shade: $(this).find('.input-shade').val(),
                        actual_plies: $(this).find('.input-actual-plies').val(),
                        damages: {
                            yard: $(this).find('.input-damages-yard').val(),
                            inch: $(this).find('.input-damages-inch').val()
                        },
                        endbits_generated: endbitsArray
                    });
                });

                console.log({ splices: splices, shades: shades });
            });
        });
    </script>
@endsection
