import { defineStore } from "pinia"

export const useLoadingStore = defineStore("loading", {
  state: () => ({
    loading: false,
    text: "Loading...",
    count: 0,
  }),

  actions: {
    show(text = "Loading...") {
      this.count++
      this.text = text
      this.loading = true
    },

    hide() {
      this.count = Math.max(0, this.count - 1)
      if (this.count === 0) this.loading = false
    },

    reset() {
      this.count = 0
      this.loading = false
    },
  },
})

