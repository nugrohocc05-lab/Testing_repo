    },
    {
        key: 'fs',
        label: 'Fabric Standart',
        link: 'linkfs',
        file: 'filefs',
    },
    {
        key: 'dsp',
        label: 'Detail Secondary Process',
        link: 'linkdsp',
        file: 'filedsp',
    },
    {
        key: 'pa',
        label: 'Pattern Artwork',
        link: 'linkpa',
        file: 'filepa',
    },
])

// const setChecklist = () => {
