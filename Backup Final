        </div>

        <!-- Search -->
        <div class="mb-2 mt-5 flex justify-end">
            <div class="w-full sm:w-64">
                <UiInput
                    v-model="searchKeyword"
                    placeholder="Search"
                    class="w-full rounded-lg"
                >
                    <template #prefix>
                        <MagnifyingGlassIcon class="h-5 w-5 text-gray-400" />
                    </template>
                </UiInput>
            </div>
        </div>

        <!-- Data Table -->
        <UiAgGrid
            class="my-zebra-grid"
            :rowData="rawDataBreakdown"
            :columnDefs="columnDefs"
            :quickFilterText="searchKeyword"
            :defaultColDef="defaultColDef"
        />
    </UiCard>

</template>

<script setup>
import { decrypt } from "@/utils/crypto";
import { ref, onMounted, reactive} from "vue";
import { useRouter, useRoute } from "vue-router";
import { useLoadingStore } from "@/stores/loading";
import { MagnifyingGlassIcon, ArrowLeftStartOnRectangleIcon } from "@heroicons/vue/24/outline";

import UiButton from "@/components/ui/UiButton.vue"
import UiInput from "@/components/ui/UiInput.vue"
import UiCard from "@/components/ui/UiCard.vue"
import UiTitle from "@/components/ui/UiTitle.vue"
import UiGrid from "@/components/ui/UiGrid.vue";
import UiAgGrid from "@/components/ui/UiAgGrid.vue";

import api from "@/services/api";
import UiAccordion from "@/components/ui/UiAccordion.vue";

const loading = useLoadingStore();
const router = useRouter();
const route = useRoute();
const rawDataBreakdown = ref([]);
const rawDataOrder = ref([]);
const rawDataFiles = ref([]);
const rawDataOrderAllocation = ref([]);
const searchKeyword = ref('')

const encryptedKK = route.params.kk;
const decodedKK = decodeURIComponent(encryptedKK);
const kk = decrypt(decodedKK);

const encryptedKP = route.params.kpno;
const decodedKP = decodeURIComponent(encryptedKP);
const kpno = decrypt(decodedKP);

const encryptedPRO = route.params.pro;
const decodedPRO = decodeURIComponent(encryptedPRO);
const pro = decrypt(decodedPRO);

const defaultColDef = {
    sortable: true,
    filter: false,
    resizable: true,
};

let nextRollId = 2;
let nextEndBitId = 2;

const createEndBit = () => ({
    id: nextEndBitId++,
    yard: "",
    inch: "",
});

const createRoll = () => ({
    id: nextRollId++,
    value: "",
    shade: "",
    actualPlies: "",
    splice: "",
    damageYard: "",
    damageInch: "",
    endBits: [createEndBit()],
});

const form = reactive({
    widthYard: "",
    widthInch: "",
    lengthYard: "",
    lengthInch: "",
});

const rolls = ref([createRoll()]);

const addRoll = () => {
    rolls.value.push(createRoll());
};

const removeRoll = (rollId) => {
    if (rolls.value.length <= 1) return;

    rolls.value = rolls.value.filter(
        (roll) => roll.id !== rollId
    );
};

const addEndBit = (roll) => {
    roll.endBits.push(createEndBit());
};

const removeEndBit = (roll, endBitId) => {
    if (roll.endBits.length <= 1) return;

    roll.endBits = roll.endBits.filter(
        (endBit) => endBit.id !== endBitId
    );
};

const columnDefs = [
    {
        headerName: "No",
        field: "no",
        width: 80,
        filter: false,
        resizable: false,
    },
    {
        field: "item_number",
        headerName: "Order Number",
        minWidth: 100,
        sortable: false,
        flex: 1,
    },
    {
        field: "item_desc",
        headerName: "Part",
        minWidth: 100,
        flex: 1,
    },
    {
        field: "color_code",
        headerName: "Marker",
        minWidth: 100,
        flex: 1,
    },
    {
        field: "size",
        headerName: "Ratio",
        minWidth: 100,
        flex: 1,
    },
];

const loadData = async () => {
    try {
        loading.show();
        const endpoint = `/api/v1/receivematerial/detailmaterial?kk=${kk}&combine_pro=${pro}`;

        const { data } = await api.get(endpoint);

        rawDataBreakdown.value = data?.data ?? [];
        rawDataBreakdown.value = (data?.data ?? []).map((item, index) => ({
            ...item,
            no: index + 1,
        }));
        
        rawDataOrder.value = data ?? [];
        rawDataOrderAllocation.value = data ?? [];

        rawDataFiles.value = (data?.receivefiles ?? []).map(
            (item, index) => ({
                ...item,
                no: index + 1,
            })
        );
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

onMounted(() => {
    loadData();
});
</script>

