{
    field: "sendQty",
    headerName: "Send Qty",
    minWidth: 120,
    editable: true,
    flex: 1,
    cellEditor: "agNumberCellEditor",
    cellEditorParams: (params) => ({
        min: 0,
        max: Number(params.data.balanceQty ?? 0),
        precision: 0, // hapus kalau qty boleh desimal
    }),
    valueParser: (params) => Number(params.newValue),
    valueSetter: (params) => {
        const balance = Number(params.data.balanceQty ?? 0);
        let value = Number(params.newValue);

        if (!Number.isFinite(value) || value < 0) value = 0;
        if (value > balance) value = balance; // dipaksa maksimal balance

        params.data.sendQty = value;

        // sinkronkan ke rawData
        const row = rawData.value.find(
            (item) => item.idmaterial === params.data.idmaterial
        );
        if (row) {
            row.sendQty = value;
            row.selected = value > 0;
        }

        return true;
    },
},

const invalidQty = selectedRows.some((item) => {
    const qty = Number(item.sendQty);
    const balance = Number(item.balanceQty ?? 0);
    return !Number.isFinite(qty) || qty <= 0 || qty > balance;
});

if (invalidQty) {
    await warning({
        title: "Invalid Quantity",
        text: "Send Qty must be greater than 0 and cannot exceed Balance.",
    });
    return;
}