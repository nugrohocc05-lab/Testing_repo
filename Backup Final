<script setup>
import { ref, computed, onMounted, watch } from "vue";
import { useRouter, useRoute } from "vue-router";
import { MagnifyingGlassIcon, ArrowLeftStartOnRectangleIcon } from "@heroicons/vue/24/outline";

import { decrypt } from "@/utils/crypto";
import { useLoadingStore } from "@/stores/loading";
import { customSwal } from "@/composable/customSwal";
import api from "@/services/api";

import UiButton from "@/components/ui/UiButton.vue";
import UiInput from "@/components/ui/UiInput.vue";
import UiTitle from "@/components/ui/UiTitle.vue";
import UiAgGrid from "@/components/ui/UiAgGrid.vue";
import UiModal from "@/components/ui/UiModal.vue";
import UiCard from "@/components/ui/UiCard.vue";
import UiMultiSelect from "@/components/ui/UiMultiSelect.vue";
import UiGrid from "@/components/ui/UiGrid.vue";
import FileIcon from "@/components/ui/FileIcon.vue";

const { success, warning, error } = customSwal;

const loading = useLoadingStore();
const router = useRouter();
const route = useRoute();

const kk = decrypt(decodeURIComponent(route.params.kk));
const kpno = decrypt(decodeURIComponent(route.params.kpno));
const pro = decrypt(decodeURIComponent(route.params.pro));

const rawData = ref([]);
const rawDataFiles = ref([]);
const rawDataFilesDelivery = ref([]);

const searchKeyword = ref("");
const description = ref("");
const showSendModal = ref(false);
const deliveryOrderFile = ref(null);

const dateOptions = ref([]);
const selectedDo = ref([]);
const all_do = ref([]);
const defaultDo = ref("");

const normalizedDates = computed(() => {
    const v = selectedDo.value;
    const arr = Array.isArray(v) ? v : v ? [v] : [];
    return arr
        .map((d) => (typeof d === "object" && d !== null ? d.value : d))
        .filter(Boolean);
});

const resetDateFilter = () => {
    selectedDo.value = [];
};

const formatDate = (date) => {
    if (!date) return '-';

    const d = new Date(date);

    const isDate = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Jakarta',
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
    }).format(d).replace(/\//g, '-');

    const time = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Jakarta',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
    }).format(d);

    return `${isDate} | ${time}`;
};

watch(
    selectedDo,
    () => {
        loadData();
    },
    { deep: true }
);
const defaultColDef = {
    sortable: true,
    filter: false,
    resizable: true,
};

const getBalance = (data) => {
    return (data?.deliverydetail ?? []).reduce(
        (total, detail) => total + Number(detail.sendqty ?? 0),
        0
    );
};

const handleFile = (event) => {
    const file =
        event?.target?.files?.[0] ??
        event?.files?.[0] ??
        event?.[0] ??
        (event instanceof File ? event : null);

    deliveryOrderFile.value = file;
};

const syncRowData = (api) => {
    api.forEachNode((node) => {
        if (!node.data) return;

        const index = rawData.value.findIndex(
            (item) => item.idmaterial === node.data.idmaterial
        );

        if (index !== -1) {
            rawData.value[index].selected = node.data.selected;
            rawData.value[index].qty = node.data.qty;
        }
    });
};

class SelectAllHeader {
    init(params) {
        this.params = params;

        this.eGui = document.createElement("div");
        this.eGui.style.display = "flex";
        this.eGui.style.alignItems = "center";
        this.eGui.style.justifyContent = "center";
        this.eGui.style.height = "100%";

        this.checkbox = document.createElement("input");
        this.checkbox.type = "checkbox";
        this.checkbox.title = "Select All";

        // this.onChange = (event) => {
        //     const checked = event.target.checked;

        //     this.params.api.forEachNode((node) => {
        //         if (!node.data) return;

        //         const balance = getBalance(node.data);

        //         node.data.selected = checked;
        //         node.data.qty = checked ? balance : 0;

        //         node.setDataValue("selected", checked);
        //         node.setDataValue("qty", node.data.qty);
        //     });

        //     syncRowData(this.params.api);

        //     this.params.api.refreshCells({ force: true });
        // };

        this.onChange = (event) => {
            const checked = event.target.checked;

            this.params.api.forEachNode((node) => {
                if (!node.data) return;

                const receiveQty = checked ? getBalance(node.data) : 0;

                node.setDataValue("selected", checked);
                node.setDataValue("qty", receiveQty);
            });

            syncRowData(this.params.api);
            this.params.api.refreshCells({ force: true });
        };

        this.checkbox.addEventListener("change", this.onChange);
        this.eGui.appendChild(this.checkbox);
    }

    getGui() {
        return this.eGui;
    }

    refresh() {
        return false;
    }

    destroy() {
        this.checkbox.removeEventListener("change", this.onChange);
    }
}


const columnDefs = [
    {
        headerName: "No",
        field: "no",
        width: 80,
        sortable: false,
        filter: false,
        resizable: false,
    },
    {
        field: "itemdesc",
        headerName: "Item Number",
        minWidth: 120,
        flex: 1,
    },
    {
        field: "matcontents",
        headerName: "Item Desc",
        minWidth: 160,
        flex: 1,
    },
    {
        field: "colorcode",
        headerName: "Color Code",
        minWidth: 120,
        flex: 1,
    },
    {
        field: "size",
        headerName: "Size",
        minWidth: 180,
        flex: 1,
    },
    {
        headerName: "Sent Quantity",
        minWidth: 120,
        flex: 1,
        valueGetter: (params) =>
            (params.data?.deliverydetail ?? []).reduce(
                (total, item) => total + Number(item.sendqty ?? 0),
                0
            ),
    },

    // Percobaan
    {
        field: "qty",
        headerName: "Receive Qty",
        minWidth: 120,
        flex: 1,

        editable: (params) => !params.data?.isReceived,

        cellEditor: "agNumberCellEditor",

        valueGetter: (params) => Number(params.data?.qty ?? 0),

        valueSetter: (params) => {
            const value = Number(params.newValue);
            const sentQty = getBalance(params.data);

            if (
                !Number.isFinite(value) ||
                value < 0 ||
                value > sentQty
            ) {
                warning({
                    title: "Invalid Quantity",
                    text: `Receive Qty must be between 0 and ${sentQty}.`,
                });

                return false;
            }

            params.data.qty = value;
            return true;
        },
    },
    {
        field: "unit",
        headerName: "Unit",
        minWidth: 90,
        flex: 1,
    },
    {
        headerName: "",
        field: "selected",
        width: 80,
        sortable: false,
        filter: false,
        resizable: false,
        headerComponent: SelectAllHeader,

        // Percobaan
        cellRenderer: (params) => {
            // Hilangkan checkbox jika material sudah Received
            if (params.data?.isReceived) {
                return "";
            }

            const checkbox = document.createElement("input");

            checkbox.type = "checkbox";
            checkbox.checked = Boolean(params.value);
            checkbox.style.cursor = "pointer";

            checkbox.addEventListener("click", (event) => {
                event.stopPropagation();
            });

            checkbox.addEventListener("change", (event) => {
                const checked = event.target.checked;
                const receiveQty = checked ? getBalance(params.data) : 0;

                params.node.setDataValue("selected", checked);
                params.node.setDataValue("qty", receiveQty);

                syncRowData(params.api);
            });

            return checkbox;
        },
    },
];

