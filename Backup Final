<template>
    <div class="px-6">
        <UiTitle align="center" title="Printing Delivery Order"/>
        <div class="mb-4 grid w-full grid-cols-1 items-end gap-3 sm:grid-cols-2 xl:grid-cols-12">
            <div class="flex w-full items-end justify-end gap-2 xl:col-span-4 xl:col-start-9">
                <div class="min-w-0 w-50">
                    <UiInput
                        v-model="searchKeyword"
                        placeholder="Search"
                        class="w-full rounded-lg"
                    >
                        <template #prefix>
                            <MagnifyingGlassIcon class="h-5 w-5 text-gray-400" />
                        </template>
                    </UiInput>
                </div>
            </div>
        </div>

        <UiAgGrid :rowData="rawData" :columnDefs="columnDefs" :defaultColDef="defaultColDef" class="mb-10 my-zebra-grid"
            :quickFilterText="searchKeyword" @grid-ready="onGridReady"></UiAgGrid>
    </div>
</template>

<script setup>
import { getCurrentDateTime } from '@/utils/date';
import { encrypt } from "@/utils/crypto";

import { ref, onMounted, computed, defineComponent, h, onActivated } from "vue";
import { useRouter } from "vue-router";
import { useLoadingStore } from "@/stores/loading";
import { ArrowRightCircleIcon, MagnifyingGlassIcon, PrinterIcon } from "@heroicons/vue/24/outline";

import { customSwal } from "@/composable/customSwal";
const { confirm, success, warning, error } = customSwal;
const { datetime } = getCurrentDateTime('-', ':');

import UiInput from "@/components/ui/UiInput.vue"
import UiTitle from "@/components/ui/UiTitle.vue"
import UiAgGrid from '@/components/ui/UiAgGrid.vue';

import api from "@/services/api";

defineOptions({name: 'DeliveryOrderArtwork'});

const loading = useLoadingStore();
const router = useRouter();
const rawData = ref([]);
const dataSelected = ref([]);
const searchKeyword = ref('')
const gridApi = ref(null);

const defaultColDef = {
  sortable: true,
  filter: true,
  resizable: true
}

const onGridReady = (params) => {
    gridApi.value = params.api;
};

const ActionRenderer = defineComponent({
    props: {
        params: {
            type: Object,
            required: true,
        },
    },

    setup(props) {
        const handlePrint = () => {
            const data = props.params.data;

            const sameDO = rawData.value.filter(
                item =>
                    item.delivery_order_id_shipment ===
                    data.delivery_order_id_shipment
            );

            if (!sameDO.length) {
                error("Data Delivery Order tidak ditemukan.");
                return;
            }

            printDeliveryOrder(sameDO);
        };

        return () =>
            h(
                "div",
                {
                    class: "flex h-full items-center justify-center px-3",
                },
                [
                    h(
                        "button",
                        {
                            type: "button",
                            title: "Print Delivery Order",
                            class: "cursor-pointer text-sky-500 transition-colors hover:text-sky-700",
                            onClick: handlePrint,
                        },
                        [
                            h(PrinterIcon, {
                                class: "h-5 w-5",
                            }),
                        ],
                    ),
                ],
            );
    },
});


const printDeliveryOrder = (items) => {
    if (!items?.length) {
        error("Data Delivery Order tidak ditemukan.");
        return;
    }

    const printWindow = window.open("", "_blank");

    if (!printWindow) {
        error("Popup diblokir browser.");
        return;
    }

    const escapeHtml = (value) =>
        String(value ?? "-").replace(/[&<>"']/g, char => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
        })[char]);

    const first = items[0];
    const ods = first.ods ?? {};

    const totalQty = items.reduce(
        (sum, item) => sum + Number(item.qty_shipment ?? item.qty ?? 0),
        0
    );

    const totalReject = items.reduce(
        (sum, item) => sum + Number(item.qty_reject ?? 0),
        0
    );

    const total = totalQty + totalReject;

    const rows = items.map((item, index) => {
        const detail = item.ods ?? {};
        const qty = Number(item.qty_shipment ?? item.qty ?? 0);
        const reject = Number(item.qty_reject ?? 0);

        return `
            <tr>
                <td class="center">${escapeHtml(detail.nmsize)}</td>
                <td class="center">${escapeHtml(detail.combine_pro)}</td>
                <td class="right">${qty}</td>
                <td class="right">${reject}</td>
                <td class="right">${qty + reject}</td>
                <td>${escapeHtml(detail.nmpanel)}</td>
                <td>Shell: ${escapeHtml(detail.nmshell)}</td>
            </tr>
        `;
    }).join("");

    const formatDate = (value) => {
        if (!value) return "-";

        const date = new Date(value);

        return Number.isNaN(date.getTime())
            ? "-"
            : date.toLocaleDateString("id-ID", {
                day: "2-digit",
                month: "long",
                year: "numeric",
            });
    };

    printWindow.document.write(`
        <!DOCTYPE html>
        <html>
        <head>
            <title>Delivery Order</title>

            <style>
                @page {
                    size: A4 landscape;
                    margin: 15mm;
                }

                * {
                    box-sizing: border-box;
                }

                body {
                    font-family: Arial, sans-serif;
                    font-size: 12px;
                    color: #000;
                    margin: 0;
                    padding: 10px 15px;
                }

                .header {
                    display: flex;
                    justify-content: space-between;
                    padding-bottom: 15px;
                }

                .company-name {
                    font-size: 18px;
                    font-weight: bold;
                    margin-bottom: 5px;
                }

                .address {
                    line-height: 1.5;
                }

                .destination {
                    text-align: right;
                    line-height: 1.8;
                }

                .divider {
                    border-top: 2px solid #000;
                    margin: 12px 0;
                }

                .title {
                    text-align: center;
                    margin: 20px 0;
                }

                .title h1 {
                    font-size: 22px;
                    margin: 0 0 8px;
                    letter-spacing: 2px;
                }

                .do-number {
                    font-size: 17px;
                    font-weight: bold;
                }

                .metadata {
                    display: flex;
                    justify-content: space-between;
                    margin: 15px 0;
                    padding: 10px 0;
                    font-weight: bold;
                }

                table {
                    width: 100%;
                    border-collapse: collapse;
                }

                th, td {
                    border: 1px solid #000;
                    padding: 12px 10px;
                }

                th {
                    text-align: center;
                    background: #f3f3f3;
                }

                .center {
                    text-align: center;
                }

                .right {
                    text-align: right;
                }

                .total-row {
                    font-weight: bold;
                }

                .signatures {
                    display: grid;
                    grid-template-columns: repeat(4, 1fr);
                    gap: 20px;
                    margin-top: 45px;
                    padding: 0 10px;
                    text-align: center;
                }

                .signature-space {
                    height: 65px;
                }

                .signature-name {
                    border-top: 1px solid #000;
                    padding-top: 6px;
                }

                @media print {
                    body {
                        -webkit-print-color-adjust: exact;
                        print-color-adjust: exact;
                    }
                }
            </style>
        </head>

        <body>
            <div class="header">
                <div>
                    <div class="company-name">
                        PT Kemilau Ungaran Sukses
                    </div>
                    <div class="address">
                        JL. PTPN IX, KARANG JATI, BERGAS<br>
                        Semarang Jawa Tengah 50552
                    </div>
                </div>

                <div class="destination">
                    <div>${escapeHtml(formatDate(first.tgl_shipment))}</div>
                    <div>To : Prima 1</div>
                </div>
            </div>

            <div class="divider"></div>

            <div class="title">
                <h1>DELIVERY ORDER</h1>
                <div class="do-number">
                    ${escapeHtml(first.delivery_order_id_shipment)}
                </div>
            </div>

            <div class="metadata">
                <div>Style : ${escapeHtml(ods.nmstyle)}</div>
                <div>KP : ${escapeHtml(ods.kpno)}</div>
                <div>Color : ${escapeHtml(ods.nmcolor)}</div>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>Size</th>
                        <th>Combine PRO</th>
                        <th>Quantity</th>
                        <th>Reject</th>
                        <th>Total</th>
                        <th>Panel</th>
                        <th>Description</th>
                    </tr>
                </thead>

                <tbody>
                    ${rows}

                    <tr class="total-row">
                        <td colspan="2">Total</td>
                        <td class="right">${totalQty}</td>
                        <td class="right">${totalReject}</td>
                        <td class="right">${total}</td>
                        <td colspan="2"></td>
                    </tr>
                </tbody>
            </table>

            <div class="signatures">
                ${["Recipient", "Courier", "Supervisor", "Head of Whs"]
                    .map(role => `
                        <div>
                            <strong>${role}</strong>
                            <div class="signature-space"></div>
                            <div class="signature-name">(                         )</div>
                        </div>
                    `).join("")}
            </div>
        </body>
        </html>
    `);

    printWindow.document.close();

    printWindow.onload = () => {
        printWindow.focus();
        printWindow.print();
    };
};


const columnDefs = [
    {
        headerName: "No",
        field: "no",
        width: 80,
        filter: false,
        resizable: false,
    },
    {
        field: "ods.nmstyle",
        headerName: "Style",
        minWidth: 100,
        filter: false,
        flex: 1,
    },
    {
        field: "ods.kpno",
        headerName: "KP",
        minWidth: 100,
        filter: false,
        flex: 1,
    },
    {
        field: "ods.combine_pro",
        headerName: "PRO",
        minWidth: 100,
        filter: false,
        flex: 1,
    },
    {
        field: "delivery_order_id_shipment",
        headerName: "Delivery Number",
        minWidth: 100,
        filter: false,
        flex: 1,
    },
    {
        field: "qty",
        headerName: "Qty",
        minWidth: 100,
        filter: false,
        flex: 1,
    },
    {
        headerName: "Action",
        minWidth: 80,
        maxWidth: 100,
        sortable: false,
        filter: false,
        resizable: false,
        cellRenderer: ActionRenderer,
    }
];

const loadData = async () => {
    await loadDataFilter();
};

const loadDataFilter = async () => {
    try {
        loading.show();

        const endpoint = `/api/v1/artwork/delivery-order-artwork/getdata?type=printing`;
        const { data } = await api.get(endpoint);

        rawData.value = (data?.data ?? []).map((item, index) => ({
            ...item,
            no: index + 1,
        }));
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

onMounted(() => {
    loadData();
});

onActivated(() => {
    loadData();
});
</script>

