const handleFile = (event) => {
    const file = event.target.files?.[0] ?? null;

    if (!file) {
        deliveryFile.value = null;
        return;
    }

    const allowedExtensions = ["pdf", "xls", "xlsx"];
    const extension = file.name.split(".").pop().toLowerCase();

    if (!allowedExtensions.includes(extension)) {
        warning({
            title: "Invalid File",
            text: "Only PDF, XLS, or XLSX files are allowed.",
        });
        event.target.value = "";
        return;
    }

    if (file.size > 2 * 1024 * 1024) {
        warning({
            title: "File Too Large",
            text: "Maximum file size is 2MB.",
        });
        event.target.value = "";
        return;
    }

    deliveryFile.value = file;
};


const confirmSend = async () => {
    try {
        const selectedData = rawData.value.filter(
            (item) => Number(item.garmentQty) > 0
        );

        if (selectedData.length === 0) {
            await warning({
                title: "Warning",
                text: "Please select at least one item.",
            });
            return;
        }

        if (!invoice.value.trim()) {
            await warning({
                title: "Warning",
                text: "Invoice is required.",
            });
            return;
        }

        if (!remark.value.trim()) {
            await warning({
                title: "Warning",
                text: "Remark is required.",
            });
            return;
        }

        if (!tanggal.value) {
            await warning({
                title: "Warning",
                text: "Date is required.",
            });
            return;
        }

        if (!["A", "B", "C"].includes(grade.value)) {
            await warning({
                title: "Warning",
                text: "Please select Grade A, B, or C.",
            });
            return;
        }

        const inputqty = {};
        const inputctn = {};

        selectedData.forEach((item) => {
            inputqty[item.iddetail] = Number(item.garmentQty);
            inputctn[item.iddetail] = Number(item.cartonQty);
        });

        const payload = {
            idorder: idorder,
            idcolor: idcolor,
            tanggal: tanggal.value,
            invoice: invoice.value.trim(),
            remark: remark.value.trim(),
            grade: grade.value,
            inputqty,
            inputctn,
        };

        loading.show();

        const { data } = await api.post(
            "/api/v1/receivefinishgood/deliver",
            payload
        );

        loading.hide();

        showSendModal.value = false;

        invoice.value = "";
        remark.value = "";
        grade.value = "";
        tanggal.value = new Date().toISOString().slice(0, 10);

        await success({
            title: "Success",
            text: data?.message || "Receive successfully saved.",
        });

        await loadData();
    } catch (err) {
        loading.hide();
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Receive Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to receive finish goods.",
        });
    } finally {
        loading.hide();
    }
};


