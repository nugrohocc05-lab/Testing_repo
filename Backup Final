    function getbundledata($barcode){
        try{
            preconnect(session('db'));
            if(!$barcode){
                throw new \Exception("Invalid Card ID!");
            }

            $card = MainCardConvert::select('id_convert','id_reference')
                ->where('id_card', $barcode)
                ->first();

            if(!$card){
                throw new \Exception("Card ID Not Found!");
            }

            $barcode = $card->id_convert;
            $status = null;

            if($card->id_reference == '05'){
                $status = 'Bundle';
            }elseif($card->id_reference == '04' || $card->id_reference == '08'){
                throw new \Exception("Wrong Card ID!");
            }else{
                throw new \Exception("Card ID Not Found!");
            }

            $statusprocess = '';
            $lastprocess = '';

            $cb = (new CuttingBundle())->getTable();
            $ods = (new OutputDetailShell())->getTable();

            $data = CuttingBundle::select(
                "$cb.kpno",
                "$cb.combine_pro",
                "$cb.idcolor",
                "$cb.idsize",
                "$cb.sub_style_id",
                "$ods.idpanel",
                "$ods.idshell",
                "$ods.cutplan_header_id",
                "$cb.scandate",
                "$cb.sentdate",
                "$cb.deploydate",
                "$ods.idshell",
                "$ods.process",
                "$ods.numa",
                "$ods.numb",
                "$ods.cutseq",
                "$ods.shellcode",
                "$cb.bundlecode as barcode",
                "$cb.qty"
            )
            ->join("$ods", "$ods.bundlecode", "$cb.bundlecode")
            ->where("$ods.master", 1)
            ->where("$cb.bundlecode", $barcode)
            ->whereNotNull("$cb.scandate")
            ->first();

            if(!$data){
                throw new \Exception("Data Not Found!");
            }

            if($data->sentdate == null && $data->deploydate == null){
                $lastprocess = 'DC';
                $statusprocess = '-';
            }else if($data->sentdate != null && $data->deploydate == null){
                $lastprocess = 'DC';
                $statusprocess = 'Sent to Sewing';
            }else if($data->sentdate != null && $data->deploydate != null){
                $lastprocess = 'Loading';
                $statusprocess = 'Generate Garment ID';
            }

            $po = PurchaseOrder::where('kpno', $data->kpno)
                ->first();

            $sty = Style::find($po->idstyle);
            $clr = Color::find($data->idcolor);
            $sz  = Size::find($data->idsize);
            $sst = SubStyle::find($data->sub_style_id);
            $pnl = Panel::find($data->idpanel);
            $shl = Shell::find($data->idshell);
            $ch  = CutplanHeader::find($data->cutplan_header_id);

            $cpl = str_replace($data->kpno, "", CutplanHeader::find($data->cutplan_header_id)->name ?? "-");
            $data->cutplan = substr($cpl, 3);

            $data->process = $statusprocess;
            $data->lastprocess = $lastprocess;
            $data->idstyle = $sty ? $sty->idstyle : '-';
            $data->style = $sty ? $sty->nmstyle : '-';
            $data->color = $clr ? $clr->nmcolor : '-';
            $data->substyle = $sst ? $sst->name : '-';
            $data->size = $sz ? $sz->nmsize : '-';
            $data->panel = $pnl ? $pnl->nmpanel : '-';
            $data->shell = $shl ? $shl->nmshell : '-';
            $data->group = $ch ? substr($ch->name,13) : '-';
            $data->numbering =  $data->numa .' - '. $data->numb;
            $data->nobundle = substr($data->barcode, strlen($data->barcode)-5);
            $data->setfrom = substr($data->shellcode, -7, -2);

            $data->status = $status ?? '-';

            if(isset($data)){
                return response()->json($data);
            }else{
                throw new \Exception("Card ID Not Found!");
            }

        } catch (\Throwable $e) {
            return response()->json($e->getMessage(), 400);
        }
    }

