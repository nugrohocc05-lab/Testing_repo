            if(!$line){
                throw new \Exception("Line not found!");
            }

            $card = MainCardConvert::find($request->id_card);
            if(!$card){
                throw new \Exception("Card ID not found!");
            }

            if(!session('user')){
                throw new \Exception("Reload Page First!");
            }

            $tpo = (new PurchaseOrder())->getTable();
            $tod = (new OutputDetail())->getTable();
            $tso = (new SewingOutput())->getTable();
            $cek_loading = OutputDetail::join($tso,"$tso.barcode","=","$tod.barcode")
                ->where("$tso.barcode", $card->id_convert)
                ->where("$tso.station_id", 0)
                ->where("$tso.is_assembly", 1)
                ->where("$tso.is_output", 0)
                ->first();
            if($cek_loading){
                throw new \Exception("Already Loading Sewing!");
            }

            // Cek B/C Grade
            $cek_bc = OutputDetail::join($tso,"$tso.barcode","=","$tod.barcode")
                ->where("$tso.barcode", $card->id_convert)
                ->where("$tso.is_qc", 1)
                ->where("$tso.is_output", 1)
                ->orderBy("date", "DESC")
                ->first();
            if($cek_bc){
                if($cek_bc->defect_code != null){
                    throw new \Exception("B/C Grade!");
                }else{
                    $cek_assembly = OutputDetail::join($tso,"$tso.barcode","=","$tod.barcode")
                        ->where("$tso.barcode", $card->id_convert)
                        ->where("$tso.station_id", 1)
                        ->where("$tso.is_assembly", 1)
                        ->where("$tso.is_qc", 1)
                        ->where("$tso.is_output", 1)
                        ->orderBy("date", "DESC")
                        ->first();
                    if($cek_assembly){
                        throw new \Exception("Already Output Assembly Sewing!");
                    }
                }
            }

            $data = OutputDetail::select("$tod.barcode","$tpo.idbuyer","$tpo.idstyle",
                "$tod.kpno","$tod.idcolor","$tod.idsize","$tod.sub_style_id","$tod.combine_pro",
                "$tpo.po")
                ->join($tpo,"$tpo.idpo","=","$tod.idpo")
                ->join($tso,"$tso.barcode","=","$tod.barcode")
                ->where("$tso.barcode", $card->id_convert)
                ->where("$tso.station_id", 1)
                ->where("$tso.is_assembly", 0)
                ->where("$tso.is_output", 1)
                ->first();

            if(!$data){
                throw new \Exception("Output Feeder First!");
            }

            $cek_part = self::check_mps_usage(
                $mode, $data->kpno, $data->combine_pro,
                $data->sub_style_id, $line
            );
            if(
                isset($cek_part->order_part_id) and
                $cek_part->order_part_id != null
            ){
                $pt = OrderPart::find($cek_part->order_part_id);
                throw new \Exception("Use $pt->name!");
            }

            $data->nmbuyer = Buyer::find($data->idbuyer)->nmbuyer ?? "-";
            $data->nmstyle = Style::find($data->idstyle)->nmstyle ?? "-";
            $data->substyle = SubStyle::find($data->sub_style_id)->name ?? "-";
            $data->nmcolor = Color::find($data->idcolor)->nmcolor ?? "-";
            $data->nmsize = Size::find($data->idsize)->nmsize ?? "-";

            return response()->json([
                'barcode' => $card->id_convert,
                'data' => $data
            ]);
        } catch (\Throwable $e) {
            return response()->json($e->getMessage(), 400);
        }
    }

    function finishloadinggarment(Request $request) {
        preconnect(session('db'));
        try {
            $factory_id = strval(session('db')->iddb);
            $line = session('db')->line;
            $idd = $request->idd;

            if(!$factory_id){
                throw new \Exception("Setting Factory!");
            }

            if(!$line){
                throw new \Exception("Setting Line!");
            }

            if(count($idd) <= 0){
                throw new \Exception("Missing Garment ID!");
            }

            $mps = MpsDetail::whereHas("header", function($q)use($line){
                    $q->where("line", $line);
                })
                ->where("date", Carbon::now()->format('Y-m-d'))
                ->first();
            if(!$mps){
                throw new \Exception("MPS not found!");
            }
            $op = OrderPart::find($mps->order_part_id);
            $is_assembly = 0;
            if($op){
                if(str_contains($op->name, "ASSEMBLY")){
                    $is_assembly = 1;
                }
            }

            if(!session('user')){
                throw new \Exception("Reload Page First!");
            }

            DB::beginTransaction();
            foreach ($idd as $c) {
                $card_convert = MainCardConvert::where("factory_id", $factory_id)
                    ->where("id_convert", $c)
                    ->first();
                if(!$card_convert){
                    throw new \Exception("Garment ID $c not found!");
                }
                $so = new SewingOutput();
                $so->barcode = $card_convert->id_convert;
                $so->line = $line;
                $so->date = Carbon::now();
                $so->station_id = 0;
                $so->is_assembly = $is_assembly;
                $so->is_qc = 0;
                $so->is_output = 0;
                $so->save();
            }

            if(collect($request->dtbarcode)->count() > 0) {
                foreach($request->dtbarcode as $bcd){
                    $before = MainCardConvert::where('id_convert',$bcd['barcode'])->first();
                    $before->id_card = $bcd['assembly_card'];
                    $before->save();
                }
            }
            DB::commit();

            return response()->json(true);
        } catch (\Throwable $e) {
            DB::rollback();
            return response()->json($e->getMessage(), 400);
        }
    }

    function getqtysize(Request $request) {
        preconnect(session('db'));
        try {
            $po = (new PurchaseOrder())->getTable();
            $dbr = (new DataBreakdown())->getTable();

            $data_po = PurchaseOrder::selectRaw("SUM(qtysize) as qty")
                ->join($dbr, "$dbr.id","=","$po.id")
                ->where("$po.idpo", $request->idpo)
                ->where("$dbr.idcolor", $request->idcolor)
                ->where("$dbr.idsize", $request->idsize)
                ->first();
            if(!$data_po){
                throw new \Exception("PO not found!");
            }
            $generate = OutputDetail::selectRaw("COUNT(DISTINCT barcode) as qty")
                ->where("idpo", $request->idpo)
                ->where("idcolor", $request->idcolor)
                ->where("idsize", $request->idsize)
                ->first();
            $qty_bundle = CuttingBundleAllocation::selectRaw("SUM(qty) as qty")
                ->where("bundlecode", $request->bundlecode)
                ->whereNull("date_deploy")
                ->first();

            $data = new \stdClass();
            $data->qtypersize = $data_po ? $data_po->qty : 0;
            $data->qtygeneratepersize = $generate ? $generate->qty : 0;
            $not_generate = intval($data->qtypersize) - intval($data->qtygeneratepersize);
            $data->qtynotgeneratepersize = $not_generate ?? 0;
            $data->qtybundle = $qty_bundle ? $qty_bundle->qty : 0;

            return response()->json($data);
        } catch (\Throwable $e) {
            return response()->json($e->getMessage(), 400);
        }
    }

    function dashboard(Request $request) {
        $line = session('db')->line;
        $factory = session('db');
        session(['factory' => $factory]);
        session(['factoryname' => $factory ? $factory->keterangan : '-']);
        session(['idfactory' => $factory->iddb]);
        session(['line' => $line]);
        session(['monitoring' => true]);

        return redirect(route('monitoring_dashboard_dashboard'));
    }
