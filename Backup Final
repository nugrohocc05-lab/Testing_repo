    function checkstatusbundle(Request $request) {
        preconnect(session('db'));
        try {
            $card_id = $request->card_id;
            $line = session('db')->line ?? null;
            $now = Carbon::now();

            if(!$line){
                throw new \Exception("Line not found!");
            }

            $card = MainCardConvert::find($card_id);
            if(!$card){
                throw new \Exception("Card ID not found!");
            }

            $mode = false;
            if($card->id_reference == '06'){
                $mode = 'garment';
            }
            if($card->id_reference == '05'){
                $mode = 'bundle';
            }
            if(!$mode){
                throw new \Exception("Sent Sewing First!");
            }

            if($mode == 'bundle'){
                $_data = OutputDetailShell::where("bundlecode", $card->id_convert)
                    ->first();
            }else{
                $_data = OutputDetail::find($card->id_convert);
            }

            $cek_mps = MpsHeader::whereHas("detail", function($q)use($now){
                    $q->where("date", $now->format('Y-m-d'));
                })
                ->where("line", $line)
                ->where("kpno", $_data->kpno)
                ->where("combine_pro", $_data->combine_pro)
                ->first();

            if(!$cek_mps){
                throw new \Exception("MPS not found!");
            }

            if($cek_mps->dcdate == Carbon::now()->addDay()->format('Y-m-d')){
                throw new \Exception("Input date still tomorrow!");
            }

            $worktime = AbsentMenuController::getabsent($line);
            $factory_id = session('db')->iddb;
            $start_time = $worktime->absent_in;
            $end_time = $worktime->absent_out;

            $cek_attendance = EmployeeAttendance::where("factory_id", $factory_id)
                ->where("group_id", $line)
                ->whereBetween("time", [$start_time, $end_time])
                ->where("is_efficiency", 1)
                ->orderBy('time', 'desc')
                ->get();

            if($cek_attendance->count() <= 0){
                throw new \Exception("Man Power not found!");
            }

            switch ($mode) {
                // MODE BUNDLE
                case 'bundle':
                    $tod = (new OutputDetail())->getTable();
                    $tso = (new SewingOutput())->getTable();
                    $tpo = (new PurchaseOrder())->getTable();
                    $cb = (new CuttingBundle())->getTable();
                    $cba = (new CuttingBundleAllocation())->getTable();

                    $cek_stock = CuttingBundle::where("bundlecode", $card->id_convert)
                        ->first();
                    $validate = false;
                    if($cek_stock and $cek_stock->stock > 0){
                        $validate = true;
                    }

                    if($validate){
                        $cek_loading = OutputDetail::join($tso,"$tso.barcode","=","$tod.barcode")
                            ->where("$tod.bundlecode", $card->id_convert)
                            ->where("$tso.line", $line)
                            ->where("$tso.is_output", 0)
                            ->where("$tso.station_id", 0)
                            ->first();
                        if($cek_loading){
                            throw new \Exception("Already Loading Sewing!");
                        }
                    }

                    $data = CuttingBundle::select("$tpo.idbuyer", "$tpo.idstyle", "$cb.kpno", "$cb.sub_style_id",
                            "$cb.cutplan_header_id", "$cb.combine_pro", "$cb.idcolor", "$cb.idsize",
                            "$cb.bundlecode", DB::raw("SUM($cba.qty) as qtybundle")
                        )
                        ->join($cba, "$cba.bundlecode","=","$cb.bundlecode")
                        ->join($tpo, "$tpo.idpo","=","$cba.idpo")
                        ->where("$cb.bundlecode", $card->id_convert)
                        ->whereNull("$cba.date_deploy")
                        ->first();
                    if(!$data){
                        throw new \Exception("Data not found!");
                    }

                    $cek_part = self::check_mps_usage(
                        $mode, $data->kpno, $data->combine_pro,
                        $data->sub_style_id, $line
                    );
                    if(
                        isset($cek_part->order_part_id) and
                        $cek_part->order_part_id != null
                    ){
                        $pt = OrderPart::find($cek_part->order_part_id);
                        throw new \Exception("Use $pt->name!");
                    }else{
                        $pg = ProsesGarment::where("sub_style_id", $data->sub_style_id)
                            ->where("combine_pro", $data->combine_pro)
                            ->where("kpno", $data->kpno)
                            ->where("idproses", "014")
                            ->where("is_use", 1)
                            ->first();
                        if(
                            ($pg->use_feeder != 1) and
                            ($pg->use_feeder_hanger != 1)
                        ){
                            $op = OrderPart::where(function($q){
                                    $q->where("is_output", 0)
                                    ->where("is_hanger", 0);
                                })
                                ->where("name", "like", "FEEDER%")
                                ->first();
                            $cekmps = MpsHeader::whereHas("detail", function($q)use($data, $op){
                                    $q->where("date", Carbon::now()->format('Y-m-d'))
                                    ->where("sub_style_id", $data->sub_style_id)
                                    ->where("order_part_id", $op->id);
                                })
                                ->where("kpno", $data->kpno)
                                ->where("combine_pro", $data->combine_pro)
                                ->where("sub_style_id", $data->sub_style_id)
                                ->where("line", $line)
                                ->first();

                            if($cekmps){
                                throw new \Exception("Generate to feeder first!");
                            }
                        }
                    }

                    $data->nmbuyer = Buyer::find($data->idbuyer)->nmbuyer ?? "-";
                    $data->nmstyle = Style::find($data->idstyle)->nmstyle ?? "-";
                    $cpl = str_replace($data->kpno, "", CutplanHeader::find($data->cutplan_header_id)->name ?? "-");
                    $data->cutplan = substr($cpl, 3);
                    $data->nmcolor = Color::find($data->idcolor)->nmcolor ?? "-";
                    $data->nmsize = Size::find($data->idsize)->nmsize ?? "-";

                    $_cba = CuttingBundleAllocation::where("bundlecode", $card->id_convert)
                        ->whereNull('date_deploy')
                        ->groupBy("idpo")
                        ->get();

                    if($_cba->count() <= 0){
                        throw new \Exception("Sent sewing first!");
                    }

                    return response()->json([
                        'mode' => $mode,
                        'bundlecode' => $card->id_convert,
                        'count_po' => $_cba->count() ?? 0,
                        'data' => $data
                    ]);
                    break;

                // MODE GARMENT
                case 'garment':
                    $tpo = (new PurchaseOrder())->getTable();
                    $tod = (new OutputDetail())->getTable();
                    $tso = (new SewingOutput())->getTable();
                    $cek_loading = OutputDetail::join($tso,"$tso.barcode","=","$tod.barcode")
                        ->where("$tso.barcode", $card->id_convert)
                        ->where("$tso.station_id", 0)
                        ->where("$tso.is_assembly", 1)
                        ->where("$tso.is_output", 0)
                        ->first();
                    if($cek_loading){
                        throw new \Exception("Already Loading Sewing!");
                    }
                    // Cek B/C Grade
                    $cek_bc = OutputDetail::join($tso,"$tso.barcode","=","$tod.barcode")
                        ->where("$tso.barcode", $card->id_convert)
                        ->where("$tso.is_qc", 1)
                        ->where("$tso.is_output", 1)
                        ->orderBy("date", "DESC")
                        ->first();
                    if($cek_bc){
                        if($cek_bc->defect_code != null){
                            throw new \Exception("B/C Grade!");
                        }else{
                            $cek_assembly = OutputDetail::join($tso,"$tso.barcode","=","$tod.barcode")
                                ->where("$tso.barcode", $card->id_convert)
                                ->where("$tso.station_id", 1)
                                ->where("$tso.is_assembly", 1)
                                ->where("$tso.is_qc", 1)
                                ->where("$tso.is_output", 1)
                                ->orderBy("date", "DESC")
                                ->first();
                            if($cek_assembly){
                                throw new \Exception("Already Output Assembly Sewing!");
                            }
                        }
                    }

                    $data = OutputDetail::select("$tod.barcode","$tpo.idbuyer","$tpo.idstyle",
                        "$tod.kpno","$tod.idcolor","$tod.idsize","$tod.sub_style_id","$tod.combine_pro",
                        "$tpo.po")
                        ->join($tpo,"$tpo.idpo","=","$tod.idpo")
                        ->join($tso,"$tso.barcode","=","$tod.barcode")
                        ->where("$tso.barcode", $card->id_convert)
                        ->where("$tso.station_id", 1)
                        ->where("$tso.is_assembly", 0)
                        ->where("$tso.is_output", 1)
                        ->first();

                    if(!$data){
                        throw new \Exception("Output Feeder First!");
                    }

                    $cek_part = self::check_mps_usage(
                        $mode, $data->kpno, $data->combine_pro,
                        $data->sub_style_id, $line
                    );
                    if(
                        isset($cek_part->order_part_id) and
                        $cek_part->order_part_id != null
                    ){
                        $pt = OrderPart::find($cek_part->order_part_id);
                        throw new \Exception("Use $pt->name!");
                    }

                    $data->nmbuyer = Buyer::find($data->idbuyer)->nmbuyer ?? "-";
                    $data->nmstyle = Style::find($data->idstyle)->nmstyle ?? "-";
                    $data->substyle = SubStyle::find($data->sub_style_id)->name ?? "-";
                    $data->nmcolor = Color::find($data->idcolor)->nmcolor ?? "-";
                    $data->nmsize = Size::find($data->idsize)->nmsize ?? "-";

                    return response()->json([
                        'mode' => $mode,
                        'barcode' => $card->id_convert,
                        'data' => $data
                    ]);
                    break;

                default:
                    throw new \Exception("Sent Sewing First!");
                    break;
            }
            throw new \Exception("Data not found!");
        } catch (\Throwable $e) {
            return response()->json($e->getMessage(), 400);
        }
    }

