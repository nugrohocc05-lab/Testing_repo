    <script>
        $(document).ready(function() {
            function updateClock() {
                var now = new Date();
                var optionsDate = {
                    weekday: 'long',
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                };
                var formattedDate = now.toLocaleDateString('en-US', optionsDate);
                var parts = formattedDate.replace(',', '').split(' ');
                var customDay = parts[0];
                var customDate = parts[1] + ' ' + parts[2] + ' ' + parts[3];

                var hours = String(now.getHours()).padStart(2, '0');
                var minutes = String(now.getMinutes()).padStart(2, '0');
                var seconds = String(now.getSeconds()).padStart(2, '0');
                var formattedTime = hours + ':' + minutes + ':' + seconds;

                $('#live-day').text(customDay);
                $('#live-date').text(customDate);
                $('#live-clock').text(formattedTime);
            }
            updateClock();
            setInterval(updateClock, 1000);
        });
    </script>
