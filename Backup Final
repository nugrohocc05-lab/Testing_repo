<UiDatePicker v-model="form.date_start" label="Delivery Date" placeholder="Date Start"
    :time-config="{ enableTimePicker: false }" model-type="yyyy-MM-dd" format="dd-MM-yyyy"
    class="w-full" @update:model-value="loadData" />

<UiDatePicker v-model="form.date_end" placeholder="Date End"
    :time-config="{ enableTimePicker: false }" model-type="yyyy-MM-dd" format="dd-MM-yyyy"
    class="w-full" @update:model-value="loadData" />

const form = ref({ factory: "", status: "", date_start: "", date_end: "" });

const buildParams = () => {
    const toStr = (v) => Array.isArray(v) ? v.join(",") : v;
    const p = {};
    if (form.value.factory?.length) p.factory = toStr(form.value.factory);
    if (form.value.status?.length) p.status = toStr(form.value.status);
    if (form.value.date_start) p.date_start = form.value.date_start;
    if (form.value.date_end) p.date_end = form.value.date_end;
    return p;
};

const loadData = async () => {
    try {
        loading.show();
        const { data } = await api.get("/api/v1/ppm/getdata", { params: buildParams() });
        const list = Array.isArray(data?.data) ? data.data : Object.values(data?.data ?? {}).flat();
        ListKK.value = [];
        rawData.value = list.map((item, i) => ({ ...item, no: i + 1 }));
    } catch (err) {
        console.error(err);
        if (err?.response?.status === 401) router.push("/login");
    } finally {
        loading.hide();
    }
};

const resetFilter = async () => {
    form.value = { factory: "", status: "", date_start: "", date_end: "" };
    searchKeyword.value = "";
    await loadData();
};