                        <div class="space-y-2">
                            <label class="text-sm font-medium text-gray-600">
                                Length
                            </label>

                            <div class="grid grid-cols-2 gap-2">
                                <UiInput
                                    v-model="form.lengthYard"
                                    placeholder="Yard"
                                />
                                <UiInput
                                    v-model="form.lengthInch"
                                    placeholder="Inch"
                                />
                            </div>
                        </div>
                    </UiGrid>
                </section>
                <!-- Roll Inputs -->
                <section>
                    <div class="space-y-3">
                        <div
                            v-for="(roll, index) in rolls"
                            :key="roll.id"
                            class="rounded-xl  px-4"
                        >
                            <UiAccordion
                                :title="`Roll ${index + 1}`"
                                variant="line"
                                :default-open="index === 0"
                                :sticky="false"
                            >
                                <div class="space-y-5 py-4">
                                    <!-- Roll Header Actions -->
                                    <div class="flex justify-end gap-2">
                                        <button
                                            type="button"
                                            @click="addRoll"
                                            class="flex h-8 w-8 items-center justify-center rounded-lg bg-green-600 text-xl font-bold text-white hover:bg-green-700"
                                            title="Tambah Roll"
                                        >
                                            +
                                        </button>

                                        <button
                                            type="button"
                                            @click="removeRoll(roll.id)"
                                            :disabled="rolls.length <= 1"
                                            class="flex h-8 w-8 items-center justify-center rounded-lg bg-red-500 text-xl font-bold text-white hover:bg-red-600 disabled:cursor-not-allowed disabled:opacity-40"
                                            title="Hapus Roll"
                                        >
                                            −
