const handleFile = (event) => {
    const file =
        event?.target?.files?.[0] ??
        event?.files?.[0] ??
        event?.[0] ??
        null;

    deliveryorders.value = file;
};

if (deliveryorders.value instanceof File) {
    formData.set("deliveryorders", deliveryorders.value);
}

const confirmSend = async () => {
    await sendData();
