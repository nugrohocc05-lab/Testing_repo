<template>
    <div class="px-6">
        <UiTitle :is-back="true" align="center" title="Confirm Material Receive">
            <template #action-left>
                <UiButton variant="teritary" @click="router.back()">
                    <ArrowLeftStartOnRectangleIcon class="h-5 w-5" />
                    <span class="text-xl ml-1">Back</span>
                </UiButton>
            </template>
        </UiTitle>

        <div class="mb-4 grid w-full grid-cols-1 items-end gap-3 sm:grid-cols-2 xl:grid-cols-12">
            <div class="xl:col-span-2">
                <UiMultiSelect
                    v-model="selectedDates"
                    :options="all_date"
                    label="Date"
                    placeholder="-- Select Date --"
                    class="w-full"
                />
            </div>

            <div class="flex w-full gap-2 xl:col-span-3 items-end">
                <UiButton variant="warning" @click="resetDateFilter">
                    Reset
                </UiButton>
            </div>

            <div class="flex w-full items-end justify-end gap-2 xl:col-span-4 xl:col-start-9">
                <div class="min-w-0 w-50">
                    <UiInput
                        v-model="searchKeyword"
                        placeholder="Search"
                        class="w-full rounded-lg"
                    >
                        <template #prefix>
                            <MagnifyingGlassIcon class="h-5 w-5 text-gray-400" />
                        </template>
                    </UiInput>
                </div>
            </div>
        </div>

        <UiCard class="my-4 text-xs md:text-lg">
            <!-- Material Table -->
            <UiAgGrid
                class="my-zebra-grid mt-3"
                :rowData="rawData"
                :columnDefs="columnDefs"
                :quickFilterText="searchKeyword"
                :defaultColDef="defaultColDef"
            />
            <div class="mt-4 flex justify-end">
                <UiButton @click="openReceiveModal">
                    Receive
                </UiButton>
            </div>
        </UiCard>
        <UiCard>
            <div class="flex min-w-0 flex-col gap-2">
                <span class="text-xl font-bold">Receive Files</span>

                <div
                    v-for="f in rawDataFiles"
                    :key="`${f.iddelivery}-${f.filename}`"
                    class="group flex items-center justify-between gap-3 rounded-xl border border-gray-200 bg-white p-3 transition hover:border-gray-300 hover:bg-gray-50"
                >
                    <div
                        class="flex min-w-0 flex-1 cursor-pointer items-center gap-3"
                        @click="downloadFile(f.filename)"
                    >
                        <div
                            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-gray-50"
                        >
                            <FileIcon :extension="f.extension" />
                        </div>

                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-medium text-gray-800">
                                {{ f.filename }}.{{ f.extension }}
                            </p>

                            <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1">
                               
                                <p class="text-xs text-gray-400">
                                    <span class="font-medium text-gray-500">Uploaded:</span>
                                    {{ formatDate(f.modified) }}
                                </p>

                                <p class="text-xs text-gray-400">
                                    <span class="font-medium text-gray-500">Upload By:</span>
                                    {{ f.userid || '-' }}
                                </p>
                            </div>

                            <!-- <p class="mt-1 text-xs text-gray-400">
                                Click to download the file
                            </p> -->
                        </div>
                    </div>
                </div>

                <p
                    v-if="!rawDataFiles.length"
                    class="text-sm italic text-gray-400"
                >
                    No files available.
                </p>
            </div>
        </UiCard>
    </div>

    <UiModal
        v-model="showSendModal"
        title="Receiving Confirmation"
        size="2xl"
    >
        <div class="space-y-4 -mt-3">
            <UiInput
                type="file"
                variant="dropzone"
                label="File Delivery Orders"
                placeholder="Choose File"
                dropzone-hint="Only PDF, XLS, or XLSX formats, up to 8MB"
                accept=".pdf,.xls,.xlsx"
                @change="handleFile"
            />

            <div class="flex justify-end gap-2 pt-3">
                <UiButton variant="teritary" @click="showSendModal = false">
                    Cancel
                </UiButton>

                <UiButton @click="confirmSend">
                    Confirm
                </UiButton>
            </div>
        </div>
    </UiModal>
</template>

<script setup>
import { ref, computed, onMounted, watch } from "vue";
import { useRouter, useRoute } from "vue-router";
import { MagnifyingGlassIcon, ArrowLeftStartOnRectangleIcon } from "@heroicons/vue/24/outline";

import { decrypt } from "@/utils/crypto";
import { useLoadingStore } from "@/stores/loading";
import { customSwal } from "@/composable/customSwal";
import api from "@/services/api";

import UiButton from "@/components/ui/UiButton.vue";
import UiInput from "@/components/ui/UiInput.vue";
import UiTitle from "@/components/ui/UiTitle.vue";
import UiAgGrid from "@/components/ui/UiAgGrid.vue";
import UiModal from "@/components/ui/UiModal.vue";
import UiCard from "@/components/ui/UiCard.vue";
import UiMultiSelect from "@/components/ui/UiMultiSelect.vue";
import UiGrid from "@/components/ui/UiGrid.vue";
import FileIcon from "@/components/ui/FileIcon.vue";

const { success, warning, error } = customSwal;

const loading = useLoadingStore();
const router = useRouter();
const route = useRoute();

const kk = decrypt(decodeURIComponent(route.params.kk));
const kpno = decrypt(decodeURIComponent(route.params.kpno));
const pro = decrypt(decodeURIComponent(route.params.pro));

const rawData = ref([]);
const rawDataFiles = ref([]);
const searchKeyword = ref("");
const description = ref("");
const showSendModal = ref(false);
const deliveryOrderFile = ref(null);

const dateOptions = ref([]);
const selectedDates = ref([]);
const all_date = ref([]);
const defaultDate = ref("");

const normalizedDates = computed(() => {
    const v = selectedDates.value;
    const arr = Array.isArray(v) ? v : v ? [v] : [];
    return arr
        .map((d) => (typeof d === "object" && d !== null ? d.value : d))
        .filter(Boolean);
});

const resetDateFilter = () => {
    selectedDates.value = [];
};

const formatDate = (date) => {
    if (!date) return '-';

    const d = new Date(date);

    const isDate = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Jakarta',
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
    }).format(d).replace(/\//g, '-');

    const time = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Asia/Jakarta',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
    }).format(d);

    return `${isDate} | ${time}`;
};

watch(
    selectedDates,
    () => {
        loadData();
    },
    { deep: true }
);
const defaultColDef = {
    sortable: true,
    filter: false,
    resizable: true,
};

const getBalance = (data) => {
    return (data?.deliverydetail ?? []).reduce(
        (total, detail) => total + Number(detail.qty ?? 0),
        0
    );
};

const handleFile = (event) => {
    const file =
        event?.target?.files?.[0] ??
        event?.files?.[0] ??
        event?.[0] ??
        (event instanceof File ? event : null);

    deliveryOrderFile.value = file;
};

const syncRowData = (api) => {
    api.forEachNode((node) => {
        if (!node.data) return;

        const index = rawData.value.findIndex(
            (item) => item.idmaterial === node.data.idmaterial
        );

        if (index !== -1) {
            rawData.value[index].selected = node.data.selected;
            rawData.value[index].qty = node.data.qty;
        }
    });
};

class SelectAllHeader {
    init(params) {
        this.params = params;

        this.eGui = document.createElement("div");
        this.eGui.style.display = "flex";
        this.eGui.style.alignItems = "center";
        this.eGui.style.justifyContent = "center";
        this.eGui.style.height = "100%";

        this.checkbox = document.createElement("input");
        this.checkbox.type = "checkbox";
        this.checkbox.title = "Select All";

        this.onChange = (event) => {
            const checked = event.target.checked;

            this.params.api.forEachNode((node) => {
                if (!node.data) return;

                const balance = getBalance(node.data);

                node.data.selected = checked;
                node.data.qty = checked ? balance : 0;

                node.setDataValue("selected", checked);
                node.setDataValue("qty", node.data.qty);
            });

            syncRowData(this.params.api);

            this.params.api.refreshCells({ force: true });
        };

        this.checkbox.addEventListener("change", this.onChange);
        this.eGui.appendChild(this.checkbox);
    }

    getGui() {
        return this.eGui;
    }

    refresh() {
        return false;
    }

    destroy() {
        this.checkbox.removeEventListener("change", this.onChange);
    }
}


const columnDefs = [
    {
        headerName: "No",
        field: "no",
        width: 80,
        sortable: false,
        filter: false,
        resizable: false,
    },
    {
        field: "itemdesc",
        headerName: "Item Number",
        minWidth: 120,
        flex: 1,
    },
    {
        field: "matcontents",
        headerName: "Item Desc",
        minWidth: 160,
        flex: 1,
    },
    {
        field: "colorcode",
        headerName: "Color Code",
        minWidth: 120,
        flex: 1,
    },
    {
        field: "size",
        headerName: "Size",
        minWidth: 180,
        flex: 1,
    },
    {
        headerName: "Sent Quantity",
        minWidth: 120,
        flex: 1,
        valueGetter: (params) =>
            (params.data?.deliverydetail ?? []).reduce(
                (total, item) => total + Number(item.qty ?? 0),
                0
            ),
    },
    {
        field: "qty",
        headerName: "Receive Qty",
        minWidth: 120,
        flex: 1,
        editable: true,
        cellEditor: "agNumberCellEditor",
        valueGetter: (params) => {
            return params.data?.qty ??
                params.data?.deliverydetail?.reduce(
                    (total, detail) => total + Number(detail.qty ?? 0),
                    0
                ) ?? 0;
        },
    },
    {
        field: "unit",
        headerName: "Unit",
        minWidth: 90,
        flex: 1,
    },
    {
        headerName: "",
        field: "selected",
        width: 80,
        sortable: false,
        filter: false,
        resizable: false,
        headerComponent: SelectAllHeader,

        cellRenderer: (params) => {
            const checkbox = document.createElement("input");

            checkbox.type = "checkbox";
            checkbox.checked = Boolean(params.value);
            checkbox.style.cursor = "pointer";

            checkbox.addEventListener("click", (event) => {
                event.stopPropagation();
            });

            checkbox.addEventListener("change", (event) => {
                const checked = event.target.checked;
                const balance = getBalance(params.data);

                params.data.selected = checked;
                params.data.qty = checked ? balance : 0;

                params.node.setDataValue("selected", checked);
                params.node.setDataValue("qty", params.data.qty);

                syncRowData(params.api);
            });

            return checkbox;
        },
    },
];

const openReceiveModal = async () => {
    const selectedRows = rawData.value.filter(
        (item) => item.selected === true
    );

    if (selectedRows.length === 0) {
        await warning({
            title: "Incomplete Data",
            text: "Select at least one material first.",
        });
        return;
    }

    showSendModal.value = true;
};

const confirmSend = async () => {
    await sendData();
};

const sendData = async () => {
    try {
        const selectedRows = rawData.value.filter(
            (item) => item.selected === true
        );

        if (selectedRows.length === 0) {
            await warning({
                title: "Incomplete Data",
                text: "Select material with Qty greater than 0.",
            });

            return;
        }

        const invalidQty = selectedRows.some((item) => {
            const qty = Number(item.qty);
            return !Number.isFinite(qty) || qty <= 0 || qty > getBalance(item);
        });

        if (invalidQty) {
            await warning({
                title: "Invalid Quantity",
                text: "The Receive Qty must be greater than 0 and cannot exceed the Balance.",
            });
            return;
        }

        if (!deliveryOrderFile.value) {
            await warning({
                title: "Incomplete Data",
                text: "Upload the Delivery Order file first.",
            });
            return;
        }

        loading.show();

        const formData = new FormData();

        formData.append("kpno", kpno);
        formData.append("combine_pro", pro);
        formData.append("kk", kk);

        const dateToSend =
        normalizedDates.value[0] || defaultDate.value;

        if (!dateToSend) {
            await warning({
                title: "Date Required",
                text: "No delivery date is available for receiving.",
            });
            return;
        }

        formData.append("date", dateToSend);

        selectedRows.forEach((item) => {
            formData.append(
                `inputqty[${item.idmaterial}]`,
                String(item.qty)
            );
        });

        formData.append("deliveryorders", deliveryOrderFile.value);

        const { data } = await api.post(
            `/api/v1/receivematerial/receive`,
            formData
        );

        showSendModal.value = false;
        deliveryOrderFile.value = null;

        await success({
            title: "Success",
            text: data?.message ?? "Material received successfully.",
        });

        if (selectedDates.value.length > 0) {
            selectedDates.value = [];
        } else {
            await loadData();
        }
    } catch (err) {
        loading.hide();
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Receive Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to receive materials.",
        });
    } finally {
        loading.hide();
    }
};

let loadSeq = 0;

const loadData = async () => {
    const seq = ++loadSeq;

    try {
        loading.show();

        const params = new URLSearchParams({
            kpno,
            combine_pro: pro,
            kk,
        });

        if (normalizedDates.value.length > 0) {
            normalizedDates.value.forEach((date) => {
                params.append("dates[]", date);
            });

            params.set("date", normalizedDates.value[0]);
        }


        const { data } = await api.get(
            `/api/v1/receivematerial/input?${params.toString()}`
        );

        if (seq !== loadSeq) return;

        if (!data?.success) {
            rawData.value = [];
            rawDataFiles.value = [];
            description.value = "";
            return;
        }

        description.value =
            data?.data?.deliverymaterial?.description ?? "";

        // Data material
        rawData.value = (data?.data?.materials ?? []).map(
            (item, index) => {
                const qty = (item.deliverydetail ?? []).reduce(
                    (total, detail) =>
                        total + Number(detail.qty ?? 0),
                    0
                );

                return {
                    ...item,
                    no: index + 1,
                    qty,
                    selected: false,
                };
            }
        );

        // Data receive files
        rawDataFiles.value = (data?.data?.receivefiles ?? []).map(
            (item, index) => ({
                ...item,
                no: index + 1,
            })
        );
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Failed to Load Data",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to load material data.",
        });
    } finally {
        loading.hide();
    }
};

const loadDataDate = async () => {
    try {
        loading.show();

        const endpoint =
            `/api/v1/receivematerial/selectdo?kpno=${encodeURIComponent(kpno)}` +
            `&kk=${encodeURIComponent(kk)}` +
            `&combine_pro=${encodeURIComponent(pro)}`;

        const { data } = await api.get(endpoint);

        all_date.value = (data?.data?.do_numbers ?? []).map((item) => ({
            value: item.do_number,
            label: item.do_number,
        }));

        defaultDate.value = all_date.value[0]?.value ?? "";
        selectedDates.value = [];
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Failed to Load Dates",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to load DO numbers.",
        });
    } finally {
        loading.hide();
    }
};

const downloadFile = async (nmfile) => {
    let url;

    try {
        loading.show();

        const endpoint = `/api/v1/deliverymaterial/showfile/${encodeURIComponent(nmfile)}`;

        const response = await api.get(endpoint, {
            responseType: "blob",
        });

        const blob = new Blob([response.data]);
        url = window.URL.createObjectURL(blob);

        // Cari data file berdasarkan filename
        const file = rawDataFiles.value.find(
            (item) => item.filename === nmfile
        );

        const link = document.createElement("a");
        link.href = url;
        link.download = file
            ? `${file.filename}.${file.extension}`
            : nmfile;

        document.body.appendChild(link);
        link.click();
        link.remove();
    } catch (err) {
        console.error("Download error:", err);

        if (err.response?.data instanceof Blob) {
            const text = await err.response.data.text();

            try {
                const errorData = JSON.parse(text);

                await customSwal.error({
                    title: "Download Failed",
                    text:
                        errorData.message ||
                        "An error occurred while downloading the file.",
                });
            } catch {
                await customSwal.error({
                    title: "Download Failed",
                    text: "An error occurred while downloading the file.",
                });
            }
        } else {
            await customSwal.error({
                title: "Download Failed",
                text:
                    err.response?.data?.message ||
                    err.message ||
                    "An error occurred while downloading the file.",
            });
        }
    } finally {
        if (url) {
            window.URL.revokeObjectURL(url);
        }

        loading.hide();
    }
};

onMounted(async () => {
    await loadDataDate();
    await loadData();
});
</script>

<style scoped>
.label {
    white-space: nowrap;
    display: inline-block;
    width: 120px;
    font-weight: 600;
}
</style>
