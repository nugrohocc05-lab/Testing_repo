// 1. Hindari double load: onActivated hanya jalan setelah mount pertama
let isFirstLoad = true;

onMounted(async () => {
    try {
        await Promise.all([
            loadDataFilter(),
            loadDataSeason(),
            loadDataFactory(),
        ]);
    } finally {
        isFirstLoad = false;
    }
});

onActivated(async () => {
    if (isFirstLoad) return;   // skip activation pertama
    await loadDataFilter();
});

// 2. Hapus loading.show()/hide() di onMounted (sudah ditangani tiap fungsi)

// 3. Perbaiki finally supaya loading selalu ditutup
} finally {
    loading.hide();   // selalu hide, bukan hanya kalau request terbaru
}