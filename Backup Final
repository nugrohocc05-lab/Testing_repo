$rows = [];
$colTotals = [];
foreach ($sizes as $s) {
    $colTotals[$s->idsize] = ['order' => 0, 'in' => 0, 'out' => 0, 'wip' => 0];
}
$grand = ['order' => 0, 'in' => 0, 'out' => 0, 'wip' => 0];

foreach ($pos as $p) {
    $rowTotal = ['order' => 0, 'in' => 0, 'out' => 0, 'wip' => 0];
    $cells = [];

    foreach ($sizes as $s) {
        $dt = $this->get_field_data($request->en, $request->kpno, $p->idpo, $s->idsize);
        $cells[$s->idsize] = $dt;

        if ($dt) {
            $rowTotal['order'] += $dt->order_qty;
            $rowTotal['in']    += $dt->in;
            $rowTotal['out']   += $dt->out;
            $rowTotal['wip']   += $dt->wip;

            $colTotals[$s->idsize]['order'] += $dt->order_qty;
            $colTotals[$s->idsize]['in']    += $dt->in;
            $colTotals[$s->idsize]['out']   += $dt->out;
            $colTotals[$s->idsize]['wip']   += $dt->wip;
        }
    }

    foreach ($grand as $k => $v) {
        $grand[$k] += $rowTotal[$k];
    }

    $rows[] = ['po' => $p, 'cells' => $cells, 'total' => $rowTotal];
}

$view = view('monitoring::loadingdashboard.table', [
    'sizes'     => $sizes,
    'rows'      => $rows,
    'colTotals' => $colTotals,
    'grand'     => $grand,
]);

