private function resolveDo($donumber)
{
    $donumber = trim((string) $donumber);

    if ($donumber === '') {
        throw new \Exception("Invalid DO!");
    }

    // process diambil dari DOStock (delivery_order_stocks)
    $dos = DOStock::where('delivery_order', $donumber)->first();
    if (!$dos) {
        throw new \Exception("Data not found!");
    }
    $process = (int) $dos->process;

    if ($process === 6) {
        // Laboratory: cek kode factory (2 digit awal) dan kode jenis (2 digit berikutnya bukan 24)
        $factory = (string) session('db')->iddb;

        if (strlen($donumber) < 4) {
            throw new \Exception("Invalid DO!");
        }
        if (substr($donumber, 0, 2) !== $factory) {
            throw new \Exception("Invalid DO! DO is not from this factory.");
        }
        if (substr($donumber, 2, 2) === '24') {
            throw new \Exception("Invalid DO!");
        }

        $source = self::SRC_LAB;
        $stocks = FGReceiveGarmentStock::where('delivery_order', $donumber)
                    ->whereNull('deleted_at')
                    ->get();
    } else {
        // Storage: process bukan 6 saja, tanpa cek factory dan kode jenis
        $source = self::SRC_STORAGE;
        $stocks = FGStorageStock::where('delivery_order_out', $donumber)
                    ->whereNull('deleted_at')
                    ->get();
    }

    if ($stocks->isEmpty()) {
        throw new \Exception("Data not found!");
    }

    return ['source' => $source, 'stocks' => $stocks];
}
