                </div>

                <div>
                    <span class="label">Color</span> :
                    {{ rawDataHeader?.color }}
                </div>
            </UiGrid>
        </UiCard>
        <UiCard class="mt-5">
            <!-- Filter Section -->
            <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-center">
                 <!-- <div class="w-full md:w-60">
