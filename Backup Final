<script type="text/javascript">
    $(document).ready(function() {
        var dtcartoncode = [];
        var length = 14;
        let cartonData = null;
        let total_qty = 0;

        var dtbarcode = [];
        var dt_barcode = [];
        var count = 0;
        var is_set = '0';
        var isFirst = '1';
        var lastBarcode = '';
        var bcd_len = [];
        let scannedData = null;
        var is_keeping = false;
        var last_kp = '0';
        var set_check = 0;


        $('#cartoncode').focus();

        $('.box').not('.table .btn-md').on('click', function () {
            $('#cartoncode').val('');
            $('#cartoncode').focus();
        });

        $('.info').click(function(){
            $("#barcode").focus();
        })

        var delay = (function(){
            var timer = 0;
            return function(callback, ms){
                clearTimeout (timer);
                    timer = setTimeout(callback, ms);
                };
        })();

        $("#cartoncode").on("input", function() {
            delay(function(){
                if ($("#cartoncode").val().length <= length) {
                    $("#cartoncode").val("");
                }
            }, 20);
        });

        $("#barcode").on("input", function() {
            delay(function(){
                if ($("#barcode").val().length <= 9) {
                    $("#barcode").val("");
                }
            }, 20);
        });

        $('#cartoncode').on("paste",function(e) {
            e.preventDefault();
        });
        $('#barcode').on("paste",function(e) {
            e.preventDefault();
        });

        $("#cartoncode").change(function(e) {
            $('#cartoncode').blur();
            e.preventDefault();
            $('#loading').show();
            const cartoncode = $("#cartoncode").val();
            let totalrecord = $('#totalrecords').text();

            $.ajax({
                type: 'GET',
                url: "{{ route('scanpack_nonshipmentgetdata') }}",
                dataType: "json",
                data: {
                    cartoncode: cartoncode,
                    isFirst: isFirst,
                },
                success: function(r) {
                    isFirst = '2';
                    if(r.is_po_keep){
                        dtcartoncode.push(r.cartoncode);
                        setHeader(r);
                        $('#info-holder').hide();
                        cartonData = r;
                        r.datacarton.forEach(function(carton) {
                            total_qty = total_qty +carton.qty;
                            $('#scanbody').append(`
                                <tr class="tr${carton.cartoncode}">
                                    <td class="row-number">${$('.row-number').length + 1}</td>
                                    <td>${carton.nmstyle}</td>
                                    <td>${carton.nmsubstyle}</td>
                                    <td>${carton.nmcolor}</td>
                                    <td>${carton.nmsize}</td>
                                    <td id="qty-${carton.key}">${carton.qty}</td>
                                    <td id="${carton.key}">0</td>
                                    <td>
                                        <div style="pointer-events: none;">
                                            <input type="checkbox"
                                                id="check-${carton.key}"
                                                style="height:20px;width:20px;"
                                                class="setstyle minimal"
                                                name="setsubstyle[]">
                                        </div>
                                    </td>
                                </tr>
                            `);
                        });
                        $('#totalscan').text(total_qty);


                    }else{
                        $('#nonkeep').show();
                        if (dtcartoncode.includes(r.cartoncode)) {
                            swal("Warning", "Carton Already Scanned!", 'warning').then(() => {
                                $('#cartoncode').val('');
                                $('#cartoncode').focus()
                            });
                            playWarningSound();
                            return;
                        } else {
                            dtcartoncode.push(r.cartoncode);
                        }

                        $('#scanbody-carton').append(`
                            <tr class="tr${r.cartoncode}">
                                <td class="row-number">${$('.row-number').length+1}</td>
                                <td>${r.cartoncode}</td>
                                <td>${r.nmbuyer}</td>
                                <td>${r.season}</td>
                                <td>${r.nmstyle}</td>
                                <td>${r.nmcolor}</td>
                                <td>${r.nmsize}</td>
                                <td>${r.qty}</td>
                                <td>${r.grade}</td>
                                <td>
                                    <a href="#" data-carton="${r.cartoncode}" class="minline">
                                        <i class="fa fa-2x fa-minus-circle text-red"></i>
                                    </a>
                                </td>
                            </tr>
                        `);
                        $('.table-holder, .box-footer').show();
                        $('#cartoncode').focus();
                        $('#totalrecords').text($('.row-number').length);
                    }
                    playSuccessSound();
                },
                error: (e) => {
                    $('#cartoncode').val('');
                    $('#cartoncode').blur();
                    swal("Warning", e.responseJSON, 'warning').then(function(){
                        $('#cartoncode').focus();
                        $('#cartoncode').val('');
                    });
                    playWarningSound();
                },
                complete: () => {
                    $('#cartoncode').val('');
                    $('#loading').hide();
                }
            });
        });

        function setHeader(d){
            $('#nmbuyer').text('');
            $('#kpno').text('');
            $('#nmstyle').text('');
            $('#substyle').text('');
            $('#nmsize').text('');
            $('#nmcolor').text('');
            $('#nmbuyer').text(d.nmbuyer);
            $('#kpno').text(d.kpno);
            $('#nmstyle').text(d.nmstyle);
            $('#substyle').text(d.nmsubstyle);
            $('#nmsize').text(d.nmsize);
            $('#nmcolor').text(d.nmcolor);
            $('#season').text('').text(d.season);
            $('#grade').text('').text(d.grade);
            $('#info-holder').show();
            $('#scancarton').hide();
            $('#keeping_garment').show();
            $('#qtygarment-holder').show();
            $('#keeping').show();
            $('#barcode').focus();
        }

        $("#barcode").change(function(e) {
            e.preventDefault();
            if($(this).val().length >= 23){
                $('#barcode').blur();
                $('#barcode').attr('readonly','readonly');
                let _bcd = $(this).val();
                $('#loading').show();
                setTimeout(function(){
                    $.ajax({
                        type: "GET",
                        url: `{!! route('scanpack_nonshipmentgetdataid') !!}`,
                        dataType: "json",
                        data: {
                            barcode : _bcd
                        },
                        success: function(r){
                            setHeader(r);
                            $('#kpno').text(r.cartoncode);
                            $('#kp-carton').text("Cartoncode")
                            if(checkAllData(r)){
                                if(bcd_len.includes(r.barcode)){
                                    swal('Warning!', 'Garment ID already scanned!', 'warning').then(()=>{
                                        $('#barcode').removeAttr('readonly');
                                        $('#barcode').val('');
                                        $('#barcode').focus();
                                    });
                                    return;
                                }
                                scannedData = r;
                                bcd_len.push(r.barcode);
                                updateCount(r);
                            }
                            $('#barcode').removeAttr('readonly');
                            $('#barcode').val('');
                            $('#table-container').show();
                        },
                        error: function(e){
                            swal("Warning!", e.responseJSON, 'warning').then(()=>{
                                $('#barcode').removeAttr('readonly');
                                $('#barcode').val('');
                                $('#barcode').focus();
                            });
                        },
                        complete: function(e){
                            $('#loading').hide();
                            $('#barcode').val('');
                        }
                    });
                },500);
            }else{
                $('#barcode').val('');
                $('#barcode').focus();
            }
        });

        function updateCount(r) {
                let scannedVal = (parseInt($(`#${r.key}`).text()) || 0) + 1;
                $(`#${r.key}`).text(scannedVal);

                let qty = parseInt($(`#qty-${r.key}`).text()) || 0;

                if (scannedVal === qty) {
                    $(`#check-${r.key}`).iCheck('check');
                }

                updateTotalScanned(r);
            }

        $('body').on('click', '#btn-cancel', function(event) {
            event.preventDefault();
            dtcartoncode = [];
            $('#scanbody').html('');
            $('.table-holder, .box-footer').hide();
        });

        $('body').on('click', '.minline', function(event) {
            event.preventDefault();
            const _id = String($(this).data('carton'));
            $(this).parents('.tr'+_id).remove();
            dtcartoncode = dtcartoncode.filter((v, i) => {
                return v != _id;
            });
            let totalrecord = $('#totalrecords').text();
            const ttlrecord = parseInt(totalrecord)-1;
            $('#totalrecords').text(ttlrecord);
            var n = 1;
            $('.row-number').each(function(){
                $(this).text(n++);
            })
            if(dtcartoncode.length < 1){
                dtcartoncode = [];
                $('#scanbody').html('');
                $('.table-holder, .box-footer').hide();
            }
        });

        function updateTotalScanned(){
                let sum = bcd_len.length;
                $('#qtygarment').text('');
                $('#qtygarment').text(sum);
                $('#sumtotalscan').text(sum);

                if(total_qty == (bcd_len.length)){
                    $('#finishbtn').attr('disabled', false);
                    $('#finishbtn-holder').show();
                }else{
                    $('#finishbtn').attr('disabled', true);
                }

            }

        function checkAllData(data){
            const isSame = cartonData.cartoncode === data.cartoncode;
            if (!isSame){
                swal('Warning!', 'Garment ID not match!', 'warning').then(()=>{
                        $('#barcode').removeAttr('readonly');
                        $('#barcode').val('');
                    });
                    return false;
            }
            return true;
        }

        $('.finishbtn').on('click', function(ev){
            ev.preventDefault();
            swal({
                title: `Are you sure to Finish Scanpack Non Shipment?`,
                text: 'Please do this action carefully!',
                icon: 'warning',
                buttons: true,
                dangerMode: true
            }).then((v) => {
                if(v){
                    finishpackingoutput();
                }
            });
        });

        $(document).on('click', '.cancelbtn', function () {
            swal({
                title: 'Are you sure to Cancel Scanpack Non Shipment?',
                text: 'Please do this action carefully!',
                icon: 'warning',
                buttons: true,
                dangerMode: true
            }).then((v) => {
                if (v) {
                    window.location.reload();
                }
            });
        });

        function finishpackingoutput(){
            $('#loading').show();
            $.ajax({
                type: 'POST',
                url: "{{ route('scanpack_nonshipmentfinish') }}",
                dataType: "json",
                data: {
                    data : dtcartoncode,
                    barcode : bcd_len,
                },
                success: function(r) {
                    playSuccessSound();
                    swal("Success", r, 'success').then(function(){
                        dtcartoncode = [];
                        $('#totalrecords').text('0');
                        $('.table-holder, .box-footer').hide();
                        $('#scanbody').html('');
                        $('#barcode').focus();
                        $('#barcode').val('');
                    });
                },
                error: (e) => {
                    $('#barcode').val('');
                    $('#barcode').blur();
                    swal("Warning", e.responseJSON, 'warning').then(function(){
                        $('#barcode').focus();
                        $('#barcode').val('');
                    });
                    playWarningSound();
                },
                complete: () => {
                    $('#barcode').val('');
                    $('#loading').hide();
                    setTimeout(() => {
                        window.location.reload();
                    }, 2000);
                }
            });
        };

    });
</script>
@endsection
