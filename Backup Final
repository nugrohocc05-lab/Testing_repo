const loading = useLoadingStore();
const router = useRouter();
const rawData = ref([]);
const factories = ref([]);
const all_status = ref([]);
const dataSelected = ref([]);
const ListKK = ref([]);
const action = ref("");
const isPlan = ref(false)
const isCompleted = ref(false)
const isConfirmPlan = ref(false)
const showModal = ref(false)
const searchKeyword = ref('')
const originalForm = ref(null)
const gridApi = ref(null);
const fileMom = ref(null);

const detailPpm = ref({
    plandate: "",
    place: "",
    description: "",
    status: "",
    file_mom: "",
    file_extension: "",
});

const defaultColDef = {
    sortable: true,
    filter: false,
    resizable: true,
};

const confimForm = ref({
    auth_pass: "",
    description: "",
});

const form = ref({
    factory: "",
    status: "",
    date_filter: null,
    date_start: "",
    date_end: "",
    plandate: "",
    place: "",
    description: "",
});

const isFormValid = computed(() => {
    return (
        !!form.value.plandate &&
        !!form.value.place.trim() &&
        !!form.value.description.trim()
    );
});

const isFormChanged = computed(() => {
    if (!originalForm.value) return false

    return Object.keys(confimForm.value).some(
        key => confimForm.value[key] !== originalForm.value[key]
    )
})

const onGridReady = (params) => {
    gridApi.value = params.api;
};

const onBtnExport = () => {
    if (!gridApi.value) {
        alert("Please Wait!");
        return;
    }

    const fileName = `pre-production-meeting-${datetime.replace(' ', '_')}.xlsx`;
    exportToExcel({
        title: `Pre-Production Meeting Report ${datetime}`,
        fileName: fileName,
        sheetName: "Pre-Production Meeting",
        headers: ["NO","KK", "KP", "PO", "Order Number", "Style", "PPM Date", "Order Date", "CM Factory", "Qty", "Status"],
        fields: ["no","orderallocation.kk", "purchaseorder.kpno", "purchaseorder.po", "orderallocation.ordernumber", "purchaseorder.style.namastyle", "plandate", "orderdate", "factory.namafactory", "purchaseorder.total", "status",],
        gridData: gridApi
    });
};

const onBtnExportPdf = () => {
    if (!gridApi.value) {
        alert("Please Wait!");
        return;
    }

    const nameFile = `pre-production-meeting-${datetime.replace(' ', '_')}`;
    exportToPdf({
        title: `Pre-Production Meeting Report ${datetime}`,
        fileName: `${nameFile}`,
        headers: ["NO","KK", "KP", "PO", "Order Number", "Style", "PPM Date", "Order Date", "CM Factory", "Qty", "Status"],
        fields: ["no","orderallocation.kk", "purchaseorder.kpno", "purchaseorder.po", "orderallocation.ordernumber", "purchaseorder.style.namastyle", "plandate", "orderdate", "factory.namafactory", "purchaseorder.total", "status",],
        gridData: gridApi,
        orientation: 'l'
    });
};

const setForm = () => {
    const data = dataSelected.value;

    if (!data) return;
    form.value = {
        buyer: data.buyer ?? "",
        kpno: data.kpno ?? "",
    };
    isPlan.value = false;
    originalForm.value = { ...form.value }
};

const handleFileMom = (value) => {
    const file = value?.target?.files?.[0] ?? value?.[0] ?? value;

    fileMom.value = file instanceof File ? file : null;
};

const setNewForm = () => {
    confimForm.value = {
        password: "",
        description: "",
    };

    originalForm.value = { ...confimForm.value }
    showModal.value = true
};

const closeModal = () => {
    showModal.value = false;
    isPlan.value = false;
};

const triggerDownload = (url, filename) => {
    const link = document.createElement("a");

    link.href = url;
    link.download = filename || "File-MOM";
    document.body.appendChild(link);

    link.click();
    document.body.removeChild(link);
};

const downloadMom = async () => {
    const filename = detailPpm.value?.file_mom;

    if (!filename) {
        await warning({
            title: "File Not Available",
            text: "The MOM file is not yet available for download.",
        });
        return;
    }

    try {
        loading.show();

        const res = await api.get(
            `/api/v1/ppm/showfile/${encodeURIComponent(filename)}`,
            { responseType: "blob" }
        );

        const url = URL.createObjectURL(res.data);

        triggerDownload(url, filename);

        setTimeout(() => URL.revokeObjectURL(url), 1000);
    } catch (err) {
        console.error(
            "Download MOM error:",
            err.response?.data || err
        );

        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Download Failed",
            text: "The file cannot be downloaded. Please try again.",
        });
    } finally {
        loading.hide();
    }
};

const submitPlanPPM = async () => {
    try {
        const idorder = dataSelected.value.idorder;

        const endpoint = `/api/v1/ppm/planning/${idorder}`;

        const body = {
            plandate: form.value.plandate,
            place: form.value.place,
            description: form.value.description,
        };

        const { data } = await api.post(endpoint, body);

        showModal.value = false;
        isPlan.value = false;

        form.value = {
            plandate: "",
            place: "",
            description: "",
        };
        
        loading.show()

        closeModal()
        loading.hide()
        await loadData()
        await success({
            title: "Success",
            text: data?.message || "Plan successfully.",
        });

    } catch (error) {
        console.error(
            "Error submit planning:",
            error.response?.data || error.message
        );
    }
};

const detailPlan = async () => {
    try {
        const idorder = dataSelected.value.idorder;

        loading.show();

        const endpoint = `/api/v1/ppm/info?idorder=${idorder}`;
        const { data } = await api.get(endpoint);

        const result = Array.isArray(data?.data)
            ? data.data[0] ?? {}
            : data?.data ?? {};

        detailPpm.value = {
            plandate: result.plandate ?? "",
            place: result.place ?? "",
            description: result.description ?? "",
            status: result.status ?? "",
            file_mom: result.file.filename ?? "",
            file_extension: result.file.extension ?? "",
        };
    } catch (err) {
        console.error(
            "Failed to retrieve PPM details:",
            err?.response?.data || err.message
        );

        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

const applyDateFilter = async (value) => {
    if (!gridApi.value) return;

    // Hapus filter jika tanggal dikosongkan
    if (!value || !Array.isArray(value) || !value[0] || !value[1]) {
        await gridApi.value.setColumnFilterModel("orderdate", null);
        gridApi.value.onFilterChanged();
        return;
    }

    const [dateFrom, dateTo] = value;

    const formatDateModel = (date) => {
        const d = new Date(date);

        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, "0");
        const day = String(d.getDate()).padStart(2, "0");

        return `${year}-${month}-${day}`;
    };

    await gridApi.value.setColumnFilterModel("orderdate", {
        filterType: "date",
        type: "inRange",
        dateFrom: formatDateModel(dateFrom),
        dateTo: formatDateModel(dateTo),
    });

    gridApi.value.onFilterChanged();
};

const ActionRenderer = defineComponent({
    props: {
        params: {
            type: Object,
            required: true,
        },
    },

    setup(props) {
        const detailData = () => {
            dataSelected.value = props.params.data;

            isPlan.value = false;
            isConfirmPlan.value = false;
            isCompleted.value = false;

            detailPpm.value = {
                plandate: "",
                place: "",
                description: "",
                status: props.params.data.status ?? "",
                file_mom: "",
                file_extension: "",
            };

            showModal.value = true;
        };

        const detailDataReady = () => {
            dataSelected.value = props.params.data;

            isPlan.value = false;
            isConfirmPlan.value = false;
            isCompleted.value = false;

            detailPpm.value = {
                plandate: props.params.data.plandate ?? "",
                place: props.params.data.place ?? "",
                description: props.params.data.description ?? "",
                status: props.params.data.status ?? "",
                file_mom: "",
                file_extension: "",
            };

            console.log('ini detail', detailPpm.value);

            showModal.value = true;
        };

        const completedData = async () => {
            dataSelected.value = props.params.data;

            isPlan.value = false;
            isConfirmPlan.value = false;
            isCompleted.value = true;

            detailPpm.value = {
                plandate: "",
                place: "",
                description: "",
                status: "",
                file_mom: "",
                file_extension: "",
            };

            showModal.value = true;

            await detailPlan();
        };

        const processPlan = () => {
            dataSelected.value = props.params.data;

            isPlan.value = true;
            isConfirmPlan.value = false;
            showModal.value = true;
        };

        const confirmPlan = () => {
            dataSelected.value = props.params.data;
            isPlan.value = false;
            isConfirmPlan.value = true;
            showModal.value = true;
        };

        const detailKK = () => {
            dataSelected.value = props.params.data;
            const kk = dataSelected.value.orderallocation.kk;
            if (!kk) {
                console.error("KK tidak ditemukan:", dataSelected.value);
                return;
            }

            const encryptedKK = encrypt(String(kk));
            router.push({
                name: "ppm-detail",
                params: {
                    kk: encodeURIComponent(encryptedKK),
                },
            });
        };

        return () => {
            const data = props.params.data;
            const status = data.status;

            const buttonClass = (color) =>
                `cursor-pointer text-${color}-500 transition hover:text-${color}-700`;

            const renderButton = (
                title,
                Icon,
                color,
                onClick
            ) =>
                h(
                    "button",
                    {
                        type: "button",
                        title,
                        class: buttonClass(color),
                        onClick,
                    },
                    [
                        h(Icon, {
                            class: "h-5 w-5",
                        }),
                    ]
                );

            // 1. Waiting: Info PPM + Plan PPM
            if (status === "Waiting") {
                return h(
                    "div",
                    {
                        class: "flex h-full px-3 gap-2",
                    },
                    [
                        renderButton(
                            "Info PPM",
                            InformationCircleIcon,
                            "amber",
                            detailData
                        ),

                        renderButton(
                            "Plan PPM",
                            CalendarDaysIcon,
                            "cyan",
                            processPlan
                        ),
                    ]
                );
            }

            // 2. Setelah Plan PPM: konfirmasi upload MOM
            if (status === "Ready") {
                return h(
                    "div",
                    {
                        class: "flex h-full px-3 gap-2",
                    },
                    [
                        renderButton(
                            "Info PPM",
                            InformationCircleIcon,
                            "amber",
                            detailDataReady
                        ),
                        renderButton(
                            "PPM Plan Confirmation",
                            DocumentCheckIcon,
                            "cyan",
                            confirmPlan
                        ),
                    ]
                );
            }

            // 3. Completed: Checklist + Detail PPM
            if (status === "Completed") {
                return h(
                    "div",
                    {
                        class: "flex h-full px-3 gap-2",
                    },
                    [
                        renderButton(
                            "Completed",
                            CheckCircleIcon,
                            "green",
                            completedData
                        ),
                        renderButton(
                            "Info PPM",
                            ClipboardDocumentListIcon,
                            "blue",
                            detailKK
                        ),
                    ]
                );
            }

            // Default: hanya Info PPM
            return h(
                "div",
                {
                    class: "flex h-full px-3 gap-2",
                },
                [
                    renderButton(
                        "Info PPM",
                        InformationCircleIcon,
                        "amber",
                        detailData
                    ),
                    renderButton(
                        "Info PPM",
                        ClipboardDocumentListIcon,
                        "blue",
                        detailKK
                    ),
                ]
            );
        };
    },
});


const columnDefs = [
    {
        field: "no",
        headerName: "No",
        width: 70,
        sortable: false,
        filter: false,
        resizable: false,
    },
    {
        field: "orderallocation.kk",
        headerName: "KK",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "purchaseorder.kpno",
        headerName: "KP",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "purchaseorder.po",
        headerName: "PO",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "orderallocation.sordernumber",
        headerName: "Order Number",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "purchaseorder.style.namastyle",
        headerName: "Style",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "plandate",
        headerName: "PPM Date",
        minWidth: 110,
        flex: 1,
    },
    {
        field: "orderdate",
        headerName: "Order Date",
        minWidth: 125,
        flex: 1,
        filter: "agDateColumnFilter",
        filterParams: {
            comparator: (filterDate, cellValue) => {
                if (!cellValue) return -1;

                const cellDate = new Date(cellValue);

                if (isNaN(cellDate.getTime())) return -1;

                const cellDateOnly = new Date(
                    cellDate.getFullYear(),
                    cellDate.getMonth(),
                    cellDate.getDate()
                );

                if (cellDateOnly < filterDate) return -1;
                if (cellDateOnly > filterDate) return 1;

                return 0;
            },
        },
    },
    {
        field: "factory.namafactory",
        headerName: "CM Factory",
        minWidth: 110,
        flex: 1,
    },
    {
        field: "purchaseorder.qtypo",
        headerName: "Quantity",
        minWidth: 90,
        flex: 1,
    },
    {
        field: "status",
        headerName: "Status",
        minWidth: 70,
        maxWidth: 90,
        flex: 1,
    },
    {
        headerName: "Action",
        minWidth: 80,
        maxWidth: 120,
        sortable: false,
        filter: false,
        resizable: false,
        cellRenderer: ActionRenderer,
    },
];

const loadFilter = async () => {
  await nextTick()
  loadDataFilter()
}

const loadDataFilter = async () => {
    try {
        const status = (form.value?.status ?? '').toLowerCase();

        loading.show();
        const endpoint = `/api/v1/ppm/getdata?factory=${form.value.factory}&status=${status}`;
        const { data } = await api.get(endpoint);

        rawData.value = data?.data ?? [];
        rawData.value = (data?.data ?? []).map((item, index) => ({
            ...item,
            no: index + 1,
        }));
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

const buildParams = () => {
    const toStr = (v) => Array.isArray(v) ? v.join(",") : v;
    const p = {};
    if (form.value.factory?.length) p.factory = toStr(form.value.factory);
    if (form.value.status?.length) p.status = toStr(form.value.status);
    if (form.value.date_start) p.date_start = form.value.date_start;
    if (form.value.date_end) p.date_end = form.value.date_end;
    return p;
};

const loadData = async () => {
    try {
        loading.show();
        const { data } = await api.get("/api/v1/ppm/getdata", { params: buildParams() });
        const list = Array.isArray(data?.data) ? data.data : Object.values(data?.data ?? {}).flat();
        ListKK.value = [];
        rawData.value = list.map((item, i) => ({ ...item, no: i + 1 }));
    } catch (err) {
        console.error(err);
        if (err?.response?.status === 401) router.push("/login");
    } finally {
        loading.hide();
    }
};

const resetFilter = async () => {
    form.value = {
        factory: "",
        status: "",
        date_filter: null,
        date_start: "",
        date_end: "",
    };

    searchKeyword.value = "";

    if (gridApi.value) {
        await gridApi.value.setColumnFilterModel("orderdate", null);
        gridApi.value.onFilterChanged();
    }

    await loadData();
};

const loadDataFactory = async () => {
    try {
