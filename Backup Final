const doExport = (fn, extra) => {
    const api = gridRef.value?.gridApi;   // sudah di-unwrap otomatis oleh expose
    if (!api) return warning("Please wait, grid is not ready");
    fn({
        title: `Orders Artwork Allocation Report ${datetime}`,
        fileName: `orders-artwork-${datetime.replace(' ', '_')}${extra.ext ?? ""}`,
        gridData: { value: api },   // lihat catatan di bawah
        ...exportOptions,
        ...extra.opts,
    });
};

