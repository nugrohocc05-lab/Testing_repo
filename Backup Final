onMounted(() => {
    loadData();
    loadDataFactory();
    loadDataStatus();
});

const submitConfirmPPM = async () => {
    const idorder = dataSelected.value?.idorder;
    const file = fileMom.value;

    if (!idorder) {
        await warning({
            title: "Invalid Data",
            text: "Order ID not found.",
        });
        return;
    }

    if (!file) {
        await warning({
            title: "Invalid Upload",
            text: "Please upload a MOM file in PDF or Excel (.xlsx, .xls) format.",
        });
        return;
    }

    const allowedExtensions = ["pdf", "xls", "xlsx"];
    const extension = file.name.split(".").pop()?.toLowerCase();

    if (!allowedExtensions.includes(extension)) {
        await warning({
            title: "Invalid File Format",
            text: "The file must be in PDF, XLS, or XLSX format.",
        });
        return;
    }

    if (file.size > 2 * 1024 * 1024) {
        await warning({
            title: "File Too Large",
            text: "Maximum file size is 2 MB.",
        });
        return;
    }

    try {
        loading.show();

        const formData = new FormData();
        formData.append("fs[]", file);

        const { data } = await api.post(
            `/api/v1/ppm/complete/${encodeURIComponent(idorder)}`,
            formData
        );

        showModal.value = false;
        isConfirmPlan.value = false;
        fileMom.value = null;

        await loadData();

        await success({
            title: "Success",
            text: data?.message || "The PPM has been successfully completed.",
        });
    } catch (err) {
        console.error(
            "Error completing PPM:",
            err.response?.data || err.message
        );

        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Upload Gagal",
            text:
                err?.response?.data?.message ||
                "The MOM file failed to upload. Please try again.",
        });
    } finally {
        loading.hide();
    }
};


</script>
