import { utils, writeFile } from "xlsx";

const getNestedValue = (obj, path) => {
    return path.split('.').reduce((acc, part) => acc && acc[part], obj);
};

export const exportToExcel = ({ title, fileName, sheetName = "Sheet1", headers, fields, gridData }) => {
        const xlsxPdf = [];
    gridData.value.forEachNodeAfterFilterAndSort((rowNode) => {
        if (rowNode.data) xlsxPdf.push({ ...rowNode.data });
    });


    let safeData = xlsxPdf && xlsxPdf.value ? xlsxPdf.value : xlsxPdf;
    if (!Array.isArray(safeData)) {
        console.error("exportToExcel Error: gridData must be an array");
        return;
    }

    const formattedData = safeData.map(item => {
        const row = {};
        headers.forEach((header, index) => {
            const fieldKey = fields[index];
            row[header] = getNestedValue(item, fieldKey) ?? "-";
        });
        return row;
    });

    const titleHeaderStructure = [
        [title],
        [] 
    ];

    const worksheet = utils.aoa_to_sheet(titleHeaderStructure);

    utils.sheet_add_json(worksheet, formattedData, {
        origin: "A3",
        skipHeader: false
    });

    const workbook = utils.book_new();
    utils.book_append_sheet(workbook, worksheet, sheetName);

    const finalFileName = fileName.endsWith('.xlsx') ? fileName : `${fileName}.xlsx`;
    writeFile(workbook, finalFileName);
};


import { jsPDF } from 'jspdf';
import autoTable from 'jspdf-autotable';

const getNestedValue = (obj, path) => {
    return path.split('.').reduce((acc, part) => acc && acc[part], obj);
};

export const exportToPdf = ({
    title,
    fileName,
    headers,
    fields,
    gridData,
    orientation = 'p',
    format = 'a4'
}) => {

    const dataPDF = [];
    gridData.value.forEachNodeAfterFilterAndSort((rowNode) => {
        if (rowNode.data) {
            dataPDF.push({ ...rowNode.data });
        }
    });

    let safeData = dataPDF && dataPDF.value ? dataPDF.value : dataPDF;

    if (!Array.isArray(safeData)) {
        console.error("exportToPdf Error: gridData must be an array, received:", safeData);
        alert("Failed to export: Invalid data format.");
        return;
    }

    const bodyData = safeData.map(item =>
        fields.map(field => getNestedValue(item, field) ?? "-")
    );

    const doc = new jsPDF(orientation, 'pt', format);

    doc.setFontSize(16);
    doc.text(title, 40, 40);

    autoTable(doc, {
        head: [headers],
        body: bodyData,
        startY: 70,
        theme: 'striped',
        styles: {
            fontSize: 7,
            cellPadding: 6,
            cellWidth: 'wrap'
        },
        headStyles: { fillColor: [41, 128, 185] }
    });

    const finalFileName = fileName.endsWith('.pdf') ? fileName : `${fileName}.pdf`;
    doc.save(finalFileName);
};
