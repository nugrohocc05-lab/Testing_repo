                                            <button
                                                type="button"
                                                @click="removeEndBit(roll, endBit.id)"
                                                :disabled="roll.endBits.length <= 1"
                                                class="mb-1 flex h-8 w-8 items-center justify-center rounded-lg bg-red-500 text-xl font-bold text-white hover:bg-red-600 disabled:cursor-not-allowed disabled:opacity-40"
