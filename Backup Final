    function mpsdatatable(Request $request) {
        preconnect(session('db'));

        $line = session('db')->line;
        $date_a = Carbon::now()->subDay();
        $date_b = Carbon::now()->addDay(3);

        $data = MpsHeader::query()
            ->with('po')
            ->where('line', $line)
            ->whereHas('detail', function($q)use($date_a, $date_b){
                $date_a = $date_a->format('Y-m-d');
                $date_b = $date_b->format('Y-m-d');
                $q->whereBetween('date', [$date_a, $date_b]);
            })
            ->groupBy("idstyle","kpno","combine_pro","sub_style_id","order_step_id");

        return DataTables::of($data)
            ->addIndexColumn()
            ->addColumn('buyer', function ($q) {
                try {
                    $b = Buyer::find($q->po->idbuyer);
                } catch (\Exception $e) {
                    $b = null;
                }

                return $b ? $b->nmbuyer : '-';
            })
            ->addColumn('style', function ($q) {
                try {
                    $s = Style::find($q->idstyle);
                } catch (\Exception $e) {
                    $s = null;
                }

                return $s ? $s->nmstyle : '-';
            })
            ->addColumn('step', function ($q) {
                try {
                    $s = OrderStep::find($q->order_step_id);
                } catch (\Exception $e) {
                    $s = null;
                }

                return $s ? $s->name : '';
            })
            ->filterColumn('style', function($q, $key){
                $sty = Style::select('idstyle')->where('nmstyle', 'like', "%$key%")->get();
                $kpno = PurchaseOrder::select('kpno')->distinct()->whereIn('idstyle', $sty->pluck('idstyle'))->get();
                $q->whereIn('kpno', $kpno->pluck('kpno'));
            })
            ->addColumn('substyle', function ($q) {
                $substyle_id = MpsDetail::where('idmps', $q->id)->first();
                $substyle = SubStyle::find($substyle_id->sub_style_id);

                return $substyle ? $substyle->name : '-';
            })
            ->addColumn('qty', function ($q) {
                $po = PurchaseOrder::select('id')
                    ->where('kpno', $q->kpno)
                    ->get();
                $d = DataBreakdown::selectRaw('SUM(qtysize) as qty')
                    ->whereIn('id', $po->pluck('id'))
                    ->where('combine_pro', $q->combine_pro)
                    ->first();

                return $d->qty;
            })
            ->addColumn('qtyday', function ($q) {
                $date_a = Carbon::now()->subDay();
                $date_b = Carbon::now()->addDay(3);

                $data = [];
                while($date_a <= $date_b){
                    $date = $date_a->format('d/m/Y');
                    $data[$date] = self::getqtymps(
                        $q->idstyle, $q->kpno, $q->combine_pro, $q->sub_style_id,
                        $q->order_step_id, $date
                    ) ?? 0;
                    $date_a->addDay();
                }
                return $data;
            })
            ->toJson();
    }

    static function getqtymps($idstyle, $kpno, $pro, $substyle, $step, $date) {
        preconnect(session('db'));
        try {
            $mph = (new MpsHeader())->getTable();
            $mpd = (new MpsDetail())->getTable();

            $date = Carbon::createFromFormat("d/m/Y", $date)->format('Y-m-d');

            $data = MpsDetail::selectRaw("SUM($mpd.target) as target")
                ->join($mph, "$mph.id","=","$mpd.idmps")
                ->where("$mph.idstyle", $idstyle)
                ->where("$mph.kpno", $kpno)
                ->where("$mph.combine_pro", $pro)
                ->where("$mph.sub_style_id", $substyle)
                ->where("$mph.order_step_id", $step)
                ->where("$mph.line", session('db')->line)
                ->where("$mpd.date", $date)
                ->where("$mpd.continuation", 0)
                ->first();
            return $data ? $data->target : 0;
        } catch (\Throwable $e) {
            return 0;
        }
    }

