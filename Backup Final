                                                class="flex h-8 w-8 items-center justify-center rounded-lg bg-green-600 text-xl font-bold text-white hover:bg-green-700"
                                                title="Tambah End Bits"
                                            >
                                                +
                                            </button>
                                        </div>

                                        <div
                                            v-for="(endBit, bitIndex) in roll.endBits"
                                            :key="endBit.id"
                                            class="mb-3 grid grid-cols-[1fr_1fr_auto] items-end gap-2 last:mb-0"
                                        >
                                            <UiInput
                                                v-model="endBit.yard"
                                                :label="`Yard ${bitIndex + 1}`"
