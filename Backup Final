    );

    if (selectedData.length === 0) {
        await warning({
            title: "Warning",
            text: "Please input Garment Qty for at least one item.",
        });
        return;
    }

    const invalidCarton = selectedData.some(
        (item) =>
            item.cartonQty === null ||
            item.cartonQty === undefined ||
            item.cartonQty === "" ||
            !Number.isFinite(Number(item.cartonQty)) ||
            Number(item.cartonQty) <= 0
    );

    if (invalidCarton) {
        await warning({
            title: "Warning",
            text: "Please input Carton Qty greater than 0 for all selected items.",
        });
        return;
    }

    showSendModal.value = true;
};

