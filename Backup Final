const formatDate = (date) => {
    if (!date) return "-";

    const parsedDate = new Date(date);

    if (isNaN(parsedDate.getTime())) return "-";

    return parsedDate.toLocaleString("id-ID", {
        day: "2-digit",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
    });
};

const loadData = async () => {
    try {
        loading.show();

        const params = new URLSearchParams({
            idorder: idorder,
            idcolor: idcolor,
        });

        if (form.value.date) {
            const selectedDates = Array.isArray(form.value.date)
                ? form.value.date
                : [form.value.date];

            selectedDates.forEach((date) => {
                params.append("date[]", date);
            });
        }

        console.log("Selected Date:", form.value.date);
        console.log("Request URL:", params.toString());


        const endpoint = `/api/v1/receivefinishgood/input?${params.toString()}`;

        const { data } = await api.get(endpoint);

        const detail = data?.data?.detail ?? [];
        const datas = data?.data?.data ?? [];
        const total = data?.data?.total ?? [];

        const totalSentMap = total.reduce((acc, item) => {
            const id = item.iddetail;

            acc[id] = (acc[id] || 0) + Number(item.qty ?? 0);

            return acc;
        }, {});

        const totalReceiveMap = total.reduce((acc, item) => {
            const id = item.iddetail;

            acc[id] = (acc[id] || 0) + Number(item.receiveqty ?? 0);

            return acc;
        }, {});

        const SentMap = datas.reduce((acc, item) => {
            const id = item.iddetail;

            acc[id] = (acc[id] || 0) + Number(item.qty ?? 0);

            return acc;
        }, {});

        const ReceiveMap = datas.reduce((acc, item) => {
            const id = item.iddetail;

            acc[id] = (acc[id] || 0) + Number(item.receiveqty ?? 0);

            return acc;
        }, {});

        const totalCartonSentMap = datas.reduce((acc, item) => {
            const id = item.iddetail;

            acc[id] = (acc[id] || 0) + Number(item.qtyctn ?? 0);

            return acc;
        }, {});

        const totalCartonReceiveMap = datas.reduce((acc, item) => {
            const id = item.iddetail;

            acc[id] = (acc[id] || 0) + Number(item.receiveqtyctn ?? 0);

            return acc;
        }, {});

        rawData.value = detail.map((item, index) => ({
            ...item,
            no: index + 1,

            totalSent: totalSentMap[item.iddetail] ?? 0,
            totalReceive: totalReceiveMap[item.iddetail] ?? 0,
            totalCartonSent: totalCartonSentMap[item.iddetail] ?? 0,
            totalCartonReceive: totalCartonReceiveMap[item.iddetail] ?? 0,
            sent: SentMap[item.iddetail] ?? 0,
            receive: ReceiveMap[item.iddetail] ?? 0,

            garmentQty: 0,
            cartonQty: 0,
            selected: false,
        }));

        rawDataHeader.value = data?.data ?? {};
        rawDataFiles.value = (data?.data?.files ?? []).map((file) => ({
            ...file,
            filename: file.filename ?? "",
            extension: file.extension ?? "",
            userid: file.userid ?? "-",
        }));

        console.log("Response Files:", data?.data?.files);
        console.log("Raw Data Files:", rawDataFiles.value);

        shipmentMode.value = data?.data?.order?.purchaseorder?.shipby ?? "";

        rawDataAll.value = data
            ? [{
                ...data,
                no: 1,
            }]
            : [];

    } catch (err) {
        console.error(err);

        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

const loadDataDate = async () => {
    try {
        const { data } = await api.get(
            `/api/v1/receivefinishgood/selectdate?idorder=${idorder}&idcolor=${idcolor}`
        );

        dates.value = (data?.data ?? []).map((item) => ({
            value: item.date,
            label: item.date,
        }));

        if (dates.value.length > 0 && form.value.date.length === 0) {
            form.value.date = [dates.value[0].value];
        }

    } catch (err) {
        console.error("Failed Load Dates:", err);

        if (err?.response?.status === 401) {
            router.push("/login");
        }
    }
};

onMounted(async () => {
    await loadDataDate();
});
