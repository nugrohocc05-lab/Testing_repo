                    @update:model-value="loadDataFilter"
                />
            </div>

            <div class="xl:col-span-2">
                <UiMultiSelect
                    v-model="form.status"
                    :options="status"
                    label="Status"
                    placeholder="-- Select Status --"
                    class="w-full"
                    @update:model-value="loadDataFilter"
                />
            </div>

            <div class="flex w-full gap-2 xl:col-span-4 items-end">
                <div class="min-w-0 flex-1">
                    <UiDatePicker v-model="form.tgllahir" label="Delivery Date" placeholder="Date Start"
                        :time-config="{ enableTimePicker: false }" model-type="yyyy-MM-dd" format="dd-MM-yyyy"
                        class="w-full" />
                </div>

                <div class="min-w-0 flex-1">
                    <UiDatePicker v-model="form.tgllahir" placeholder="Date End"
                        :time-config="{ enableTimePicker: false }" model-type="yyyy-MM-dd" format="dd-MM-yyyy"
                        class="w-full" />
                </div>
            </div>

            <div class="flex items-end xl:col-span-1">
                <UiButton variant="warning" class="w-full sm:w-auto" @click="resetFilter">
                    Reset
                </UiButton>
            </div>

            <div class="flex w-full items-end justify-end gap-2 xl:col-span-3">
                <div class="flex shrink-0 items-center gap-1">
                    <UiTooltip content="PDF" position="bottom">
                        <UiButton variant="teritary" class="shrink-0" @click="onBtnExportPdf">
                            <i class="fa-regular fa-file-pdf text-2xl"></i>
                        </UiButton>
                    </UiTooltip>

                    <UiTooltip content="Excel" position="bottom">
                        <UiButton variant="teritary" class="shrink-0" @click="onBtnExport">
                            <i class="fa-regular fa-file-excel text-2xl"></i>
                        </UiButton>
                    </UiTooltip>
                </div>

                <div class="min-w-0 flex-1">
                    <UiInput
                        v-model="searchKeyword"
                        placeholder="Search"
                        class="w-full rounded-lg"
                    >
                        <template #prefix>
                            <MagnifyingGlassIcon class="h-5 w-5 text-gray-400" />
                        </template>
                    </UiInput>
                </div>
            </div>

        </div>

        <UiAgGrid :rowData="rawData" :columnDefs="columnDefs" :defaultColDef="defaultColDef" class="mb-10 my-zebra-grid"
            :quickFilterText="searchKeyword" @grid-ready="onGridReady"></UiAgGrid>
    </div>


    <UiModal v-model="showModal" :title="isPlan ? 'PPM Planning' : isConfirmPlan ? 'PPM Complete Confirmation' : 'Detail PPM Planning'" size="md">
        <div class="space-y-3 -mt-3" v-if="isPlan">
            <UiDatePicker label="PPM Date" placeholder="Select Date"
                    :max-date="maxDate" :time-config="{ enableTimePicker: false }" model-type="yyyy-MM-dd"
                    format="dd-MM-yyyy" />
            <UiInput label="Place" placeholder="PPM Place"></UiInput>
            <UiInput label="Description" placeholder="Description"></UiInput>
        </div>
        <div class="space-y-3 -mt-3" v-if="isConfirmPlan">
            <div class="text-center text-xl fw-bold mt-2">
                PPM Complete?
            </div>
            <UiInput type="file" variant="dropzone" label="Upload File MOM" placeholder="Choose File" 
                dropzone-hint="only PDF, XLS, or XLSX Formats, up to 2MB"
                accept=".pdf,.xls,.xlsx"></UiInput>
        </div>
        <div class="space-y-3 -mt-3" v-if="!isPlan && !isConfirmPlan">
            <UiInput label="PPM Date" placeholder="PPM Date is waiting" disabled></UiInput>
            <UiInput label="Place" placeholder="PPM Place" disabled></UiInput>
            <UiInput label="Description" placeholder="Description" disabled></UiInput>
            <UiInput label="Status" placeholder="Status" disabled></UiInput>
            <UiInput label="File MOM" placeholder="File MOM" disabled></UiInput>
        </div>
        <template #footer>
            <div class="flex justify-end">
                <UiButton variant="secondary" @click="showModal = false; isPlan = null; isConfirmPlan = false;">Cancel</UiButton>
                <UiButton @click="process_confirm()" :disabled="!isFormChanged" class="ml-3" v-if="isPlan">Confirm</UiButton>
                <UiButton @click="process_confirm_plan()" :disabled="!isFormChanged" class="ml-3" v-if="isConfirmPlan">Confirm</UiButton>
            </div>
        </template>
    </UiModal>
</template>

<script setup>
import { exportToPdf } from '@/utils/pdfExporter';
import { exportToExcel } from "@/utils/excelExporter";
import { getCurrentDateTime } from '@/utils/date';
import { encrypt } from "@/utils/crypto";

import { ref, onMounted, computed, defineComponent, h, watch } from "vue";
import { useRouter } from "vue-router";
import { useLoadingStore } from "@/stores/loading";
import { InformationCircleIcon, XCircleIcon, MagnifyingGlassIcon, CalendarDaysIcon, DocumentCheckIcon } from "@heroicons/vue/24/outline";

import { customSwal } from "@/composable/customSwal";
const { confirm, success, warning, error } = customSwal;
const { datetime } = getCurrentDateTime('-', '-');

import UiButton from "@/components/ui/UiButton.vue"
import UiInput from "@/components/ui/UiInput.vue"
import UiModal from "@/components/ui/UiModal.vue"
import UiTitle from "@/components/ui/UiTitle.vue"
import UiMultiSelect from "@/components/ui/UiMultiSelect.vue"
import UiDatePicker from '@/components/ui/UiDatePicker.vue';
import UiAgGrid from '@/components/ui/UiAgGrid.vue';

import api from "@/services/api";
import UiTooltip from '@/components/ui/UiTooltip.vue';

const loading = useLoadingStore();
const router = useRouter();
const rawData = ref([]);
const factory = ref([]);
const status = ref([]);
const dataSelected = ref([]);
const ListKK = ref([]);
const action = ref("");
const isPlan = ref(false)
const isConfirmPlan = ref(false)
const showModal = ref(false)
const searchKeyword = ref('')
const originalForm = ref(null)
const gridApi = ref(null);


const defaultColDef = {
    sortable: true,
    filter: false,
    resizable: true,
};

const confimForm = ref({
    auth_pass: "",
    description: "",
});

const form = ref({
    factory: "",
    status: "",
});

const isFormChanged = computed(() => {
    if (!originalForm.value) return false

    return Object.keys(confimForm.value).some(
        key => confimForm.value[key] !== originalForm.value[key]
    )
})

const onGridReady = (params) => {
    gridApi.value = params.api;
};

const onBtnExport = () => {
    if (!gridApi.value) {
        alert("Please Wait!");
        return;
    }

    const fileName = `orders-allocation-${datetime.replace(' ', '_')}.xlsx`;
    exportToExcel({
        title: `Orders Allocation Report ${datetime}`,
        fileName: fileName,
        sheetName: "Orders Allocation",
        headers: ["KK", "KP", "PO", "COMBINE_PRO", "PO_CMT", "STYLE", "DELIVERY_DATE", "CM_VACTORY", "QTY", "STATUS"],
        fields: ["kk", "kpno", "po", "combine_pro", "po_sap", "style", "deliverydate", "factory", "total", "orderstatus.status",],
        gridData: gridApi
    });
};

const onBtnExportPdf = () => {
    if (!gridApi.value) {
        alert("Please Wait!");
        return;
    }

    const nameFile = `orders-allocation-${datetime.replace(' ', '_')}`;
    exportToPdf({
        title: `Orders Allocation Report ${datetime}`,
        fileName: `${nameFile}`,
        headers: ["NO", "KK", "KP", "PO", "Combine PRO", "PO CMT", "STYLE", "DELIVERY DATE", "CM FACTORY", "TOTAL", "STATUS"],
        fields: ["no", "kk", "kpno", "po", "combine_pro", "po_sap", "style", "deliverydate", "factory", "total", "orderstatus.status"],
        gridData: gridApi,
        orientation: 'l'
    });
};

const setForm = () => {
    const data = dataSelected.value;

    if (!data) return;
    form.value = {
        buyer: data.buyer ?? "",
        kpno: data.kpno ?? "",
    };
    isPlan.value = false;
    originalForm.value = { ...form.value }
};


const setNewForm = () => {
    confimForm.value = {
        password: "",
        description: "",
    };

    originalForm.value = { ...confimForm.value }
    showModal.value = true
};

const closeModal = () => {
    showModal.value = false;
    isPlan.value = false;
};

const ActionRenderer = defineComponent({
    props: {
        params: {
            type: Object,
            required: true,
        },
    },

    setup(props) {

        const detailData = () => {
            dataSelected.value = props.params.data;

            const idorder = dataSelected.value.idorder;
            const encryptedIdOrder = encrypt(idorder);
            isPlan.value = false;
            showModal.value = true;
        };

        if (props.params.data.status != "Waiting" && !ListKK.value.includes(props.params.data.kk)) {

            if (!ListKK.value.includes(props.params.data.kk)) {
                ListKK.value.push(props.params.data.kk);
            }

            const processPlan = () => {
                dataSelected.value = props.params.data;

                const idorder = dataSelected.value.idorder;
                const encryptedIDOrder = encrypt(idorder);
                isPlan.value = true;
                showModal.value = true;
            };

            const confirmPlan = () => {
                dataSelected.value = props.params.data;

                const idorder = dataSelected.value.idorder;
                const encryptedIDOrder = encrypt(idorder);
                isConfirmPlan.value = true;
                showModal.value = true;
            };

            return () =>
                h(
                    "div",
                    {
                        class: "flex h-full px-3 gap-2",
                    },
                    [
                        h(
                            "button",
                            {
                                type: "button",
                                title: "Detail",
                                class:
                                    "cursor-pointer text-amber-500 transition hover:text-amber-700",
                                onClick: detailData,
                            },
                            [
                                h(InformationCircleIcon, {
                                    class: "h-5 w-5",
                                }),
                            ],
                        ),
                        h(
                            "button",
                            {
                                type: "button",
                                title: "Process",
                                class: "cursor-pointer text-cyan-500 hover:text-cyan-700",
                                onClick: processPlan,
                            },
                            [
                                h(CalendarDaysIcon, {
                                    class: "h-5 w-5",
                                }),
                            ],
                        ),
                        h(
                            "button",
                            {
                                type: "button",
                                title: "Confirm",
                                class: "cursor-pointer text-cyan-500 hover:text-cyan-700",
                                onClick: confirmPlan,
                            },
                            [
                                h(DocumentCheckIcon, {
                                    class: "h-5 w-5",
                                }),
                            ],
                        ),
                    ],
                );
        } else {
            return () =>
                h(
                    "div",
                    {
                        class: "flex h-full px-3 gap-2",
                    },
                    [
                        h(
                            "button",
                            {
                                type: "button",
                                title: "Detail",
                                class:
                                    "cursor-pointer text-amber-500 transition hover:text-amber-700",
                                onClick: detailData,
                            },
                            [
                                h(InformationCircleIcon, {
                                    class: "h-5 w-5",
                                }),
                            ],
                        ),
                    ],
                );
        }
    },
});

const columnDefs = [
    {
        field: "no",
        headerName: "No",
        width: 70,
        sortable: false,
        filter: false,
        resizable: false,
    },
    {
        field: "orderallocation.kk",
        headerName: "KK",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "purchaseorder.kpno",
        headerName: "KP",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "purchaseorder.po",
        headerName: "PO",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "orderallocation.sordernumber",
        headerName: "Order Number",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "purchaseorder.style.namastyle",
        headerName: "Style",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "plandate",
        headerName: "PPM Date",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "factory.namafactory",
        headerName: "CM Factory",
        minWidth: 110,
        flex: 1,
    },
    {
        field: "purchaseorder.qtypo",
        headerName: "Quantity",
        minWidth: 150,
        flex: 1,
    },
    {
        field: "status",
        headerName: "Status",
        minWidth: 70,
        maxWidth: 90,
        flex: 1,
    },
    {
        headerName: "Action",
        minWidth: 80,
        maxWidth: 120,
        sortable: false,
        filter: false,
        resizable: false,
        cellRenderer: ActionRenderer,
    },
];

const loadData = async () => {
    try {
        loading.show();

        const params = {};

        const { data } = await api.get("/api/v1/ppm/getdata", {
            params,
        });

        rawData.value = (data?.data ?? []).map((item, index) => ({
            ...item,
            no: index + 1,
        }));
    } catch (err) {
        console.error(err);

        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

const loadDataFilter = async () => {
    try {
        const status = form.value?.status ?? '';

        loading.show();

        const endpoint =
            `/api/v1/ppm/getdata?factory=${form.value.factory}&status=${status}`;

        const { data } = await api.get(endpoint);

        const groupedData = data?.data ?? {};

        rawData.value = Object.values(groupedData)
            .flat()
            .map((item, index) => ({
                ...item,
                no: index + 1,
            }));

        console.log("filtered rawData:", rawData.value);

    } catch (err) {
        console.error(err);

        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

const loadDataFactory = async () => {
    try {
        loading.show();
        const endpoint = "/api/v1/ppm/selectfactory";
        const { data } = await api.get(endpoint);
        factory.value = (data?.data ?? []).map((item) => ({
            value: item.idfactory,
            label: item.namafactory,
        }));
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

const loadDataStatus = async () => {
    try {
        loading.show();
        const endpoint = "/api/v1/ppm/selectstatus";
        const { data } = await api.get(endpoint);
        status.value = (data?.data ?? []).map((item) => ({
            value: item.status,
            label: item.status,
        }));
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

const loadDataKp = async (idbuyer) => {
    try {
        data_kp.value = [];
        form.value = {
            kpno: "",
        };

        if (!idbuyer) {
            loadData()
            return;
        }

        loading.show();
        const endpoint = `/api/v1/order-alocation/selectkp?idbuyer=${idbuyer}`;
        const { data } = await api.get(endpoint);

        data_kp.value = (data?.data ?? []).map((item) => ({
            value: item.kpno,
            label: item.kpno,
        }));
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

onMounted(() => {
    loadData();
    loadDataFactory();
    loadDataStatus();
});

const resetFilter = async () => {
    form.value.factory = "";
    form.value.status = "";
    searchKeyword.value = "";

    await loadData();
};

const process_confirm = async () => {
    try {
        if (
            !confimForm.value.auth_pass ||
            !confimForm.value.description
        ) {
            await warning({
                title: "Incomplete Data",
                text: "Please complete all required fields.",
            });
            return
        }

        const result = await confirm({
            title: "Are You Sure to Reject This Data?",
            text: "Please do this action carefully!",
        });

        if (!result.isConfirmed) {
            return
        }

        loading.show()
        const endpoint = `api/v1/order-alocation/reject/${dataSelected.value.idorder}`;
        const { data } = await api.post(
            endpoint,
            confimForm.value
        );

        closeModal()
        loading.hide()
        await success({
            title: "Success",
            text: data?.message || "Data updated successfully.",
        });
        await loadData()
    } catch (err) {
        loading.hide()
        if (err?.response?.status === 401) {
            router.push("/login")
            return
        }

        await error({
            title: "Rejection Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to Reject the Data. Please try again.",
        });
    }
}

</script>


