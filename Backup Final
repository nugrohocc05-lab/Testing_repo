headerClass: "editable-header",
cellClass: (params) =>
    isSendable(params.data) ? "editable-cell" : "readonly-cell",

/* Header kolom editable: tint teal lembut + ikon pensil */
:deep(.ag-header-cell.editable-header) {
    background-color: #e6f8f9 !important;
}
:deep(.ag-header-cell.editable-header .ag-header-cell-text) {
    color: #147f84;
    font-weight: 600;
}
:deep(.ag-header-cell.editable-header .ag-header-cell-text)::after {
    content: " ✎";
    font-size: 0.85em;
}

/* Sel editable: tampak seperti input */
:deep(.ag-cell.editable-cell) {
    background-color: #f0fbfc !important;
    box-shadow: inset 0 0 0 1px #9ddfe2;
    border-radius: 6px;
    cursor: text;
    transition: box-shadow 0.15s;
}
:deep(.ag-cell.editable-cell:hover) {
    box-shadow: inset 0 0 0 1px #1fbcc3;
}

/* Sel yang tidak bisa diedit */
:deep(.ag-cell.readonly-cell) {
    color: #9ca3af !important;
    background-color: transparent;
}

