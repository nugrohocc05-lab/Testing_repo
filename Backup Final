const loadDataFilter = async () => {
    try {
        const status = (form.value?.status ?? '').toLowerCase();

        loading.show();
        const endpoint = `/api/v1/ci/getdata?factory=${form.value.factory}&status=${status}`;
        const { data } = await api.get(endpoint);

        rawData.value = data?.data ?? [];
        rawData.value = (data?.data ?? []).map((item, index) => ({
            ...item,
            no: index + 1,
        }));
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

const buildParams = () => {
    const toStr = (v) => Array.isArray(v) ? v.join(",") : v;
    const p = {};
    if (form.value.factory?.length) p.factory = toStr(form.value.factory);
    if (form.value.status?.length) p.status = toStr(form.value.status);
    if (form.value.date_start) p.date_start = form.value.date_start;
    if (form.value.date_end) p.date_end = form.value.date_end;
    return p;
};

const loadData = async () => {
    try {
        loading.show();
        const { data } = await api.get("/api/v1/ci/getdata", { params: buildParams() });
        const list = Array.isArray(data?.data) ? data.data : Object.values(data?.data ?? {}).flat();
        ListKK.value = [];
        rawData.value = list.map((item, i) => ({ ...item, no: i + 1 }));
    } catch (err) {
        console.error(err);
        if (err?.response?.status === 401) router.push("/login");
    } finally {
        loading.hide();
    }
};


const loadDataCutting = async () => {
    const ordernumber = dataSelected.value?.ordernumber;

    if (!ordernumber) {
        console.error("Order number not found:", dataSelected.value);
        return;
    }

    try {
        loading.show();

        const { data } = await api.get(
            `/api/v1/ci/info/${encodeURIComponent(ordernumber)}`
        );

        cuttingData.value = Array.isArray(data?.data)
            ? data.data
            : [];

    } catch (err) {
        console.error(
            "Failed to retrieve cutting info:",
            err?.response?.data || err.message
        );

        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

const downloadCuttingFile = async (file) => {
    if (!file?.id) {
        console.error("CI file ID not found:", file);
        return;
    }

    try {
        loading.show();

        const response = await api.get(
            `/api/v1/ci/showfile/${encodeURIComponent(file.id)}`,
            {
                responseType: "blob",
            }
        );

        const blob = new Blob([response.data], {
            type: response.headers["content-type"] || "application/octet-stream",
        });

        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");

        link.href = url;
        link.download =
            `${file.filename || "CuttingInstruction"}.${file.extension || "pdf"}`;

        document.body.appendChild(link);
        link.click();
        link.remove();

        setTimeout(() => URL.revokeObjectURL(url), 1000);
    } catch (err) {
        console.error(
            "Failed to download CI file:",
            err?.response?.data || err.message
        );

        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Download Failed",
            text: "The Cutting Instruction file failed to download.",
        });
    } finally {
        loading.hide();
    }
};

const deleteCuttingFile = async (file) => {
    if (!file?.id) {
        console.error("CI file ID not found:", file);
        return;
    }

    try {
        // const confirmed = await confirmDelete({
        //     title: "Delete File?",
        //     text: `Are you sure you want to delete ${file.filename}.${file.extension}?`,
        // });

        // if (!confirmed) return;

        const result = await confirmDelete({
            title: "Delete File?",
            text: `Are you sure you want to delete ${file.filename}.${file.extension}?`,
        });

        if (!result.isConfirmed) return;

        loading.show();

        const { data } = await api.delete(
            `/api/v1/ci/deletefile/${encodeURIComponent(file.id)}`
        );

        if (data?.success) {
            cuttingData.value = cuttingData.value.filter(
                (item) => item.id !== file.id
            );

            loading.hide();

            await success({
                title: "Success",
                text: data.message || "File successfully deleted.",
            });

        } else {
            await error({
                title: "Delete Failed",
                text: data?.message || "Failed to delete the file.",
            });
        }
    } catch (err) {
        console.error(
            "Failed to delete CI file:",
            err?.response?.data || err.message
        );

        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Delete Failed",
            text:
                err?.response?.data?.message ||
                "The Cutting Instruction file failed to delete.",
        });
    } finally {
        loading.hide();
    }
};

