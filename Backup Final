    <div class="px-6">
        <UiTitle align="center" title="Pre-Production Meeting" subtitle="Lorem Ipsum Dolores Amet" />

        <div class="mb-4 grid w-full grid-cols-1 items-end gap-3 sm:grid-cols-2 xl:grid-cols-12">

            <div class="xl:col-span-2">
                <UiMultiSelect
