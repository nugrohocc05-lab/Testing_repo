import { defineStore } from "pinia"

export const useLoadingStore = defineStore("loading", {
  state: () => ({
    loading: false,
    text: "Loading..."
  }),

  actions: {
    show(text = "Loading...") {
      this.text = text
      this.loading = true
    },

    hide() {
      this.loading = false
    }
  }
})
