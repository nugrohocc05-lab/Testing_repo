class SelectAllHeader {
    init(params) {
        this.params = params;

        this.eGui = document.createElement("div");
        this.eGui.style.display = "flex";
        this.eGui.style.alignItems = "center";
        this.eGui.style.justifyContent = "center";
        this.eGui.style.height = "100%";

        this.checkbox = document.createElement("input");
        this.checkbox.type = "checkbox";
        this.checkbox.title = "Select All";
        this.checkbox.style.cursor = "pointer";

        this.onChange = (event) => {
            const checked = event.target.checked;

            this.params.api.forEachNode((node) => {
                if (!node.data) return;
                if (node.data.isReceived) return; // skip yang sudah received

                const receiveQty = checked ? getBalance(node.data) : 0;

                node.setDataValue("selected", checked);
                node.setDataValue("qty", receiveQty);
            });

            syncRowData(this.params.api);
            this.params.api.refreshCells({ force: true });
        };

        this.checkbox.addEventListener("change", this.onChange);
        this.eGui.appendChild(this.checkbox);

        // Update tampilan saat data berubah
        this.onModelUpdated = () => this.updateVisibility();
        this.params.api.addEventListener("modelUpdated", this.onModelUpdated);
        this.params.api.addEventListener("cellValueChanged", this.onModelUpdated);

        this.updateVisibility();
    }

    updateVisibility() {
        let hasUnreceived = false;
        let allSelected = true;

        this.params.api.forEachNode((node) => {
            if (!node.data || node.data.isReceived) return;
            hasUnreceived = true;
            if (!node.data.selected) allSelected = false;
        });

        // Hide kalau semua sudah received
        this.eGui.style.display = hasUnreceived ? "flex" : "none";

        // Sinkronkan status checked header
        this.checkbox.checked = hasUnreceived && allSelected;
    }

    getGui() {
        return this.eGui;
    }

    refresh() {
        return false;
    }

    destroy() {
        this.params.api.removeEventListener("modelUpdated", this.onModelUpdated);
        this.params.api.removeEventListener("cellValueChanged", this.onModelUpdated);
        this.checkbox.removeEventListener("change", this.onChange);
    }
}


