<script setup>
import { useAttrs, ref, watch } from "vue";
import { ArrowUpTrayIcon } from "@heroicons/vue/24/outline";

defineOptions({
    inheritAttrs: false,
});

const props = defineProps({
    modelValue: {
        type: [String, Number, Array, Object, null],
        default: "",
    },
    type: {
        type: String,
        default: "text",
    },

    variant: {
        type: String,
        default: "default",
        validator: (value) => ["default", "dropzone"].includes(value),
    },

    filter: {
        type: String,
        default: "free",
        validator: (value) =>
            [
                "email",
                "number",
                "number-decimal",
                "name-special",
                "text",
                "text-name",
                "text-symbol",
                "free",
                "text-symbol-limit",
            ].includes(value),
    },
    placeholder: { type: String, default: "" },
    disabled: { type: Boolean, default: false },
    readonly: { type: Boolean, default: false },
    label: { type: String, default: "" },
    labelClass: { type: [String, Array, Object], default: "" },
    required: { type: Boolean, default: false },
    name: { type: String, default: undefined },
    autocomplete: { type: String, default: "off" },
    error: { type: [String, Boolean], default: false },
    hint: { type: String, default: "" },
    case: {
        type: String,
        default: "none",
        validator: (value) =>
            ["none", "upper", "lower", "capitalize", "title"].includes(value),
    },
    min: { type: [String, Number], default: undefined },
    max: { type: [String, Number], default: undefined },
    multiple: { type: Boolean, default: false },
    dropzoneText: { type: String, default: "Choose a file or drag & drop here", },
    dropzoneHint: { type: String, default: "", },
    accept: { type: String, default: "",},
    directory: {
        type: Boolean,
        default: false,
    },
});

const emit = defineEmits([
    "update:modelValue",
    "focus",
    "blur",
    "change",
    "keydown",
]);

const attrs = useAttrs();
const fileInput = ref(null);
const selectedFiles = ref([]);
const isDragging = ref(false);

watch(
    () => props.modelValue,
    (newVal) => {
        if (props.type !== "file") return;

        if (!newVal) {
            selectedFiles.value = [];
            return;
        }

        if (Array.isArray(newVal)) {
            selectedFiles.value = newVal;
        } else if (newVal instanceof File) {
            selectedFiles.value = [newVal];
        }
    },
    { immediate: true }
);

const filterValue = (value) => {
    let result = value;

    switch (props.filter) {
        case "text":
            result = result.replace(/[^a-zA-Z0-9\s]/g, "");
            break;

        case "text-name":
            result = result.replace(/[^a-zA-Z0-9\s-]/g, "");
            break;

        case "text-name-slash":
            result = result.replace(/[^a-zA-Z0-9\s/-]/g, "");
            break;

        case "name-special":
            result = result.replace(/[^a-zA-Z0-9\s.,/-]/g, "");
            break;

        case "number":
            result = result.replace(/[^0-9]/g, "");
            break;

        case "number-decimal":
            result = result.replace(/[^0-9.]/g, "");
            break;

        case "text-symbol":
            result = result.replace(
                /[^a-zA-Z0-9\s.,!?'"()\\-\_/&@#:;+=%]/g,
                ""
            );
            break;

        case "text-symbol-limit":
            result = result.replace(/[^a-zA-Z0-9\s.,\\-\_]/g, "");
            break;

        case "email":
            result = result
                .replace(/[^a-zA-Z0-9.!#$%&'*+/=?^_`{|}~@-]/g, "")
                .replace(/(@.*)@/g, "$1");
            break;
    }

    switch (props.case) {
        case "upper":
            result = result.toUpperCase();
            break;

        case "lower":
            result = result.toLowerCase();
            break;

        case "capitalize":
            result = result.replace(/\b\w/g, (char) => char.toUpperCase());
            break;

        case "title":
            result = result
                .toLowerCase()
                .replace(/\b\w/g, (char) => char.toUpperCase());
            break;
    }

    return result;
};

const allowedExtensions = [
    "pdf",
    "xls",
    "xlsx",
    "jpg",
    "jpeg",
    "png",
    "webp",
    "gif",
];


const handleFileChange = (event) => {
    const files = Array.from(event.target.files || []);

    const validFiles = files.filter((file) => {
        const extension = file.name
            .split(".")
            .pop()
            .toLowerCase();

        return allowedExtensions.includes(extension);
    });

    if (validFiles.length !== files.length) {
        event.target.value = "";

        selectedFiles.value = [];

        emit(
            "update:modelValue",
            props.multiple ? [] : null
        );

        return;
    }

    selectedFiles.value = props.multiple
        ? validFiles
        : validFiles.slice(0, 1);

    emit(
        "update:modelValue",
        props.multiple
            ? validFiles
            : (validFiles[0] ?? null)
    );

    emit("change", event);
};

const handleDragOver = (event) => {
    if (
        props.disabled ||
        props.variant !== "dropzone" ||
        props.type !== "file"
    ) {
        return;
    }

    event.preventDefault();
    isDragging.value = true;
};

const handleDragLeave = (event) => {
    if (
        props.disabled ||
        props.variant !== "dropzone" ||
        props.type !== "file"
    ) {
        return;
    }

    if (!event.currentTarget.contains(event.relatedTarget)) {
        isDragging.value = false;
    }
};

const handleDrop = (event) => {
    if (
        props.disabled ||
        props.variant !== "dropzone" ||
        props.type !== "file"
    ) {
        return;
    }

    event.preventDefault();
    isDragging.value = false;

    const files = Array.from(event.dataTransfer?.files || []);

    selectedFiles.value = props.multiple
        ? files
        : files.slice(0, 1);

    const valueToEmit = props.multiple
        ? files
        : (files[0] ?? null);

    emit("update:modelValue", valueToEmit);
    emit("change", event);
};


const handleInput = (event) => {
    if (props.type === "file") return;

    let value = filterValue(event.target.value);

    if (props.max !== undefined && value !== "") {
        value = Math.min(
            Number(value),
            Number(props.max)
        ).toString();
    }

    if (props.min !== undefined && value !== "") {
        value = Math.max(
            Number(value),
            Number(props.min)
        ).toString();
    }

    event.target.value = value;

    emit("update:modelValue", value);
};

const removeFile = (index) => {
    selectedFiles.value.splice(index, 1);

    if (fileInput.value) {
        fileInput.value.value = "";
    }

    emit(
        "update:modelValue",
        props.multiple
            ? [...selectedFiles.value]
            : null
    );
};


</script>

<template>
    <div :class="['w-full', attrs.class]">
        <label v-if="label" :class="[
            'mb-1.5 block font-medium text-gray-700',
            labelClass,
        ]">
            {{ label }}

            <span v-if="required" class="ml-0.5 text-red-500">
                *
            </span>
        </label>

        <div class="relative">
            <!-- PREFIX -->
            <div v-if="$slots.prefix" class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                <slot name="prefix" />
            </div>

            <div v-if="type === 'file' && variant === 'default'" :class="[
                'w-full rounded border bg-white py-2.5 text-sm flex items-center justify-between',

                $slots.prefix ? 'pl-10' : 'pl-3',
                $slots.suffix ? 'pr-10' : 'pr-3',

                error
                    ? 'border-red-400 focus-within:ring-2 focus-within:ring-red-500/20'
                    : 'border-gray-300 focus-within:border-[#1FBCC3] focus-within:ring-2 focus-within:ring-[#1FBCC3]/20',

                disabled
                    ? 'cursor-not-allowed bg-gray-100 text-gray-400'
                    : 'text-gray-900 cursor-pointer hover:bg-gray-50/50',
            ]">
                <span class="truncate text-gray-600 pr-2">
                    {{ selectedFileNames || placeholder || "Select file..." }}
                </span>

                <span class="text-xs font-semibold text-[#1FBCC3] uppercase tracking-wider shrink-0">
                    Browse
                </span>

                <input v-bind="attrs" type="file" :disabled="disabled" :required="required" :name="name"
                    :multiple="multiple" :autocomplete="off"
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer disabled:cursor-not-allowed"
                    @change="handleFileChange" @focus="emit('focus', $event)" @blur="emit('blur', $event)"
                    @keydown="emit('keydown', $event)" />
            </div>

            <div v-else-if="type === 'file' && variant === 'dropzone'" :class="[
                'relative w-full rounded-lg border-2 border-dashed bg-white p-6 text-center transition-all duration-150',

                isDragging
                    ? 'border-[#1FBCC3] bg-[#1FBCC3]/5 ring-2 ring-[#1FBCC3]/20'
                    : error
                        ? 'border-red-400 bg-red-50/30'
                        : 'border-gray-300 hover:border-[#1FBCC3] hover:bg-gray-50/50',

                disabled
                    ? 'cursor-not-allowed bg-gray-100 opacity-60'
                    : 'cursor-pointer',
            ]" @dragover="handleDragOver" @dragleave="handleDragLeave" @drop="handleDrop">
                <input v-bind="attrs" type="file" :disabled="disabled" :required="required" :name="name"
                    :multiple="multiple" ref="fileInput" :accept="accept" :autocomplete="off"
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer disabled:cursor-not-allowed"
                    @change="handleFileChange" @focus="emit('focus', $event)" @blur="emit('blur', $event)"
                    @keydown="emit('keydown', $event)" />

                <div class="flex flex-col items-center">
                    <div v-if="!selectedFiles.length" class="flex flex-col items-center">
                        <ArrowUpTrayIcon class="h-8 w-8 mb-2" :class="isDragging
                            ? 'text-[#1FBCC3]'
                            : 'text-gray-400'
                            " />

                        <p class="text-sm font-medium" :class="isDragging
                            ? 'text-[#1FBCC3]'
                            : 'text-gray-700'
                            ">
                            {{
                                isDragging
                                    ? "Drop file here"
                                    : dropzoneText
                            }}
                        </p>
                    </div>
                    <p v-if="dropzoneHint" class="mt-2 text-xs text-gray-400">
                        {{ dropzoneHint }}
                    </p>

                    <div v-if="selectedFiles.length" class="flex flex-col gap-2 mt-2 w-full">
                        <div v-for="(file, index) in selectedFiles" :key="`${file.name}-${index}`"
                            class="relative flex items-center p-2 border rounded-lg text-[#1FBCC3]">
                            <img v-if="['xls', 'xlsx'].includes(
                                file.name.split('.').pop().toLowerCase()
                            )" src="/images/icons/file/xls.svg" class="h-10 w-10 shrink-0" />

                            <img v-else-if="['png', 'jpg', 'svg', 'jpeg', 'gif', 'webp'].includes(
                                file.name.split('.').pop().toLowerCase()
                            )" src="/images/icons/file/img.svg" class="h-10 w-10 shrink-0" />

                            <img v-else-if="
                                file.name.split('.').pop().toLowerCase() === 'pdf'
                            " src="/images/icons/file/pdf.svg" class="h-10 w-10 shrink-0" />

                            <span class="flex-1 truncate px-3 text-xs font-medium text-left">
                                {{ file.name }}
                            </span>

                            <button type="button"
                                class="relative z-10 ml-2 flex h-6 w-6 shrink-0 cursor-pointer items-center justify-center rounded-full text-gray-400 hover:bg-red-50 hover:text-red-500"
                                @click.stop="removeFile(index)">
                                <span class="text-lg leading-none">&times;</span>
                            </button>
                        </div>
                    </div>


                </div>
            </div>

            <input v-else v-bind="attrs" :type="type" :value="modelValue" :placeholder="placeholder"
                :disabled="disabled" :readonly="readonly" :required="required" :name="name" :autocomplete="off"
                :class="[
                    'w-full rounded border bg-white py-2.5 text-sm placeholder:text-gray-400 transition-colors duration-150 outline-none',

                    $slots.prefix ? 'pl-10' : 'pl-3',
                    $slots.suffix ? 'pr-10' : 'pr-3',

                    error
                        ? 'border-red-400 focus:border-red-500 focus:ring-2 focus:ring-red-500/20'
                        : 'border-gray-300 focus:border-[#1FBCC3] focus:ring-2 focus:ring-[#1FBCC3]/20',

                    disabled
                        ? 'cursor-not-allowed bg-gray-100 text-gray-400'
                        : 'text-gray-900',

                    readonly ? 'bg-gray-50' : '',
                ]" @input="handleInput" @focus="emit('focus', $event)" @blur="emit('blur', $event)"
                @change="emit('change', $event)" @keydown="emit('keydown', $event)" />

            <!-- SUFFIX -->
            <div v-if="$slots.suffix" class="absolute inset-y-0 right-0 flex items-center pr-3">
                <slot name="suffix" />
            </div>
        </div>

        <p v-if="error" class="mt-1.5 text-xs text-red-600">
            {{ typeof error === "string" ? error : "" }}
        </p>

        <p v-else-if="hint" class="mt-1.5 text-xs text-gray-500">
            {{ hint }}
        </p>
    </div>
</template>
