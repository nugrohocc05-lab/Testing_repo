const FILE_KEYS = ["filename", "file_name", "original_name", "originalname", "name", "path", "url", "file"];

const resolveFileName = (val, depth = 0) => {
    if (!val || depth > 3) return "";
    if (typeof val === "string") return val.split(/[\\/]/).pop();
    if (typeof val === "object") {
        for (const k of FILE_KEYS) {
            const r = resolveFileName(val[k], depth + 1);
            if (r) return r;
        }
    }
    return "";
};

const openUploadModal = async (row) => {
    resetUploadState();
    selectedUploadData.value = row;

    const currentKk = pickFirst(row, ["kk", "kkno", "no_kk", "kk_no"]);
    selectedKk.value = currentKk;

    const rawFile = row?.data?.file ?? row?.file ?? row?.kkbc ?? row?.kk_bc;
    kkbcFileName.value = resolveFileName(rawFile);
    showModal.value = true;

    loading.show();
    await loadKkOptions(row?.kpno, currentKk);
    loading.hide();
};

