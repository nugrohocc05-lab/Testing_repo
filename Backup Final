function finish(Request $request) {
        try {
            if(!$request->data){
                throw new \Exception("Select GI First!");
            }

            $data = MainDOStock::where('request_id', $request->data)->get();

            if(!$data){
                throw new \Exception("GI Not Found!");
            }

            if(!session('user')->nik){
                throw new \Exception("You dont have any access!");
            }

            DB::beginTransaction();

            $masterid = MasterId::where('process','do_storage_stock')->first();

            // Ambil kode masterid untuk ditaruh prefx
            // Ikut session login
            // Didepan kode 24 ditambahkan session factory
            $prefix = '24';
            $number = substr($masterid->value, strlen($prefix));
            $nextNumber = intval($number) + 1;
            $do_out = $prefix . str_pad($nextNumber, strlen($number), '0', STR_PAD_LEFT);

            $po = (new PurchaseOrder())->getTable();
            $od = (new OutputDetail())->getTable();

            $dt_barcode = [];

            $datas = OutputDetail::select(
                    "$po.idstyle",
                    "$od.idcolor",
                    "$od.idsize",
                    "$od.sub_style_id"
                )
                ->join($po, "$po.idpo", "=", "$od.idpo")
                ->whereIn("$od.barcode", $request->barcode)
                ->get();

            if ($datas->isEmpty()) {
                return [];
            }

            $dt_barcode = OutputDetail::select("$od.barcode")
                ->join($po, "$po.idpo", "=", "$od.idpo")
                ->where(function ($query) use ($datas, $po, $od) {
                    foreach ($datas as $data) {
                        $query->orWhere(function ($q) use ($data, $po, $od) {
                            $q->where("$od.idcolor", $data->idcolor)
                            ->where("$od.idsize", $data->idsize)
                            ->where("$po.idstyle", $data->idstyle);
                        });
                    }
                })
                ->distinct()
                ->get();

            foreach ($request->barcode as $item) {
                    $storage = FGStorageStock::where('barcode', $item)->first();
                    $storage->date_out =  Carbon::now();
                    $storage->userid_out = session('user')->nik;
                    $storage->delivery_order_out = $do_out;
                    $storage->gi_number = $request->data;
                    $storage->save();
            }

            FGStorageStock::whereNotNull("date_in")
                ->whereNull('gi_number')
                ->whereNull('deleted_at')
                ->where('factory_id', session('db')->iddb)
                ->where('is_lock', '=', '1')
                ->whereIn('barcode', $dt_barcode)
                ->update([
                    'is_lock'=>0,
                    'user_id'=>session('user')->nik
                ]);

            $request = MainDOStock::where('request_id', $request->data)->get();
                foreach($request as $gi){
                    $gi->is_complete = '1';
                    $gi->save();
                }

            $masterid->value = $do_out;
            $masterid->save();

            DB::commit();
            return response()->json('Successfully Sent To Packing!');
        }catch (\Throwable $e) {
            DB::RollBack();
            return response()->json($e->getMessage(), 400);
        }
    }
