.scroll-table {
    max-height: calc(100vh - 560px);
    min-height: 200px;
    overflow-y: auto;
    overflow-x: auto;
}
.scroll-table thead th {
    position: sticky;
    top: 0;
    background: #fff;
    z-index: 2;
}
.scroll-table tfoot td {
    position: sticky;
    bottom: 0;
    background: #fff;
}


