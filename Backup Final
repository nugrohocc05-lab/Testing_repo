<template>
    <div class="px-6">
        <UiTitle :is-back="true" align="center" title="Delivery Material">
            <template #action-left>
                <UiButton variant="teritary" @click="router.back()">
                    <ArrowLeftStartOnRectangleIcon class="h-5 w-5" />
                    <span class="text-xl ml-1">Back</span>
                </UiButton>
            </template>
        </UiTitle>

        <div class="mb-4 grid w-full grid-cols-1 items-end gap-3 sm:grid-cols-2 xl:grid-cols-12">
            <div class="xl:col-span-2">
                <UiMultiSelect
                    v-model="selectedDates"
                    label="Date"    
                    placeholder="-- Select Date --"
                    class="w-full"
                    :options="dateOptions"
                />
            </div>

            <div class="flex w-full gap-2 xl:col-span-3 items-end">

                <UiButton
                    variant="warning"
                    @click="resetDateFilter"
                >
                    Reset
                </UiButton>
            </div>
            
            <div class="flex w-full items-end justify-end gap-2 xl:col-span-4 xl:col-start-9">
                <div class="min-w-0 w-50">
                    <UiInput
                        v-model="searchKeyword"
                        placeholder="Search"
                        class="w-full rounded-lg"
                    >
                        <template #prefix>
                            <MagnifyingGlassIcon class="h-5 w-5 text-gray-400" />
                        </template>
                    </UiInput>
                </div>
            </div>
        </div>

         <UiCard class="my-4 text-xs md:text-lg">
            <UiGrid cols="8" gap="sm">
                <div><span class="label">Description</span> : {{description}} </div>
            </UiGrid>
            <UiAgGrid class="my-zebra-grid mt-3" :rowData="rawData" :columnDefs="columnDefs" :quickFilterText="searchKeyword" :defaultColDef="defaultColDef"/>
        </UiCard>
        <div class="mt-4 flex justify-end">
            <UiButton @click="showSendModal = true">
                Receive
            </UiButton>
        </div>
    </div>

    <UiModal
        v-model="showSendModal"
        title="Receiving Confirmation"
        size="2xl"
    >
        <div class="space-y-4 -mt-3">
            <UiInput
                type="file"
                variant="dropzone"
                label="File Delivery Orders"
                placeholder="Choose File"
                dropzone-hint="Only PDF, XLS, or XLSX formats, up to 8MB"
                accept=".pdf,.xls,.xlsx"
                @change="handleFile"
            />

            <div class="flex justify-end gap-2 pt-3">
                <UiButton
                    variant="teritary"
                    @click="showSendModal = false"
                >
                    Cancel
                </UiButton>

                <UiButton @click="confirmSend">
                    Confirm
                </UiButton>
            </div>
        </div>
    </UiModal>
</template>

<script setup>
import { decrypt } from "@/utils/crypto";
import { ref, onMounted, watch } from "vue";
import { useRouter, useRoute } from "vue-router";
import { useLoadingStore } from "@/stores/loading";
import { MagnifyingGlassIcon, ArrowLeftStartOnRectangleIcon } from "@heroicons/vue/24/outline";
const { confirm, success, warning, error } = customSwal;

import UiButton from "@/components/ui/UiButton.vue"
import UiInput from "@/components/ui/UiInput.vue"
import UiTitle from "@/components/ui/UiTitle.vue"
import UiAgGrid from "@/components/ui/UiAgGrid.vue";

import api from "@/services/api";
import UiModal from "@/components/ui/UiModal.vue";
import { customSwal } from "@/composable/customSwal";
import UiDatePicker from "@/components/ui/UiDatePicker.vue";
import UiCard from "@/components/ui/UiCard.vue";
import UiMultiSelect from "@/components/ui/UiMultiSelect.vue";
import UiGrid from "@/components/ui/UiGrid.vue";

const loading = useLoadingStore();
const router = useRouter();
const route = useRoute();
const rawData = ref([]);
const searchKeyword = ref('');
const id = route.params.id;

const encryptedKK = route.params.kk;
const decodedKK = decodeURIComponent(encryptedKK);
const kk = decrypt(decodedKK);

const encryptedKP = route.params.kpno;
const decodedKP = decodeURIComponent(encryptedKP);
const kpno = decrypt(decodedKP);

const encryptedPRO = route.params.pro;
const decodedPRO = decodeURIComponent(encryptedPRO);
const pro = decrypt(decodedPRO);

const showSendModal = ref(false);  


const dates = ref([]);
const dateOptions = ref([]);
const selectedDates = ref([]);
const appliedDates = ref([]);

const applyDateFilter = () => {
    appliedDates.value = [...selectedDates.value];
    loadData();
};

const resetDateFilter = () => {
    selectedDates.value = [];
    appliedDates.value = [];
    loadData();
};

watch(
    selectedDates,
    async (newDates) => {
        appliedDates.value = [...(newDates ?? [])];
        await loadData();
    },
    { deep: true }
);


const defaultColDef = {
    sortable: true,
    filter: false,
    resizable: true,
};

const description = ref("");
const bppbNumber = ref("");
const doNumber = ref("");
const deliveryOrderFile = ref(null);

const handleFile = (event) => {
    const file = event?.target?.files?.[0] 
        ?? event?.files?.[0]
        ?? event?.[0]
        ?? null;

    deliveryOrderFile.value = file;
};

const confirmSend = async () => {
    await sendData();
};

class SelectAllHeader {
    init(params) {
        this.params = params;

        this.eGui = document.createElement("div");
        this.eGui.style.display = "flex";
        this.eGui.style.alignItems = "center";
        this.eGui.style.justifyContent = "center";
        this.eGui.style.height = "100%";

        this.checkbox = document.createElement("input");
        this.checkbox.type = "checkbox";
        this.checkbox.title = "Select All";

        this.onChange = (event) => {
            const checked = event.target.checked;

            this.params.api.forEachNode((node) => {
                node.setDataValue("selected", checked);
                node.setDataValue(
                    "sendQty",
                    checked ? Number(node.data.balanceQty ?? 0) : 0
                );
            });

            rawData.value = rawData.value.map((item) => ({
                ...item,
                selected: checked,
                sendQty: checked ? Number(item.balanceQty ?? 0) : 0,
            }));
        };

        this.checkbox.addEventListener("change", this.onChange);
        this.eGui.appendChild(this.checkbox);
    }

    getGui() {
        return this.eGui;
    }

    refresh() {
        return false;
    }

    destroy() {
        this.checkbox.removeEventListener("change", this.onChange);
    }
}


const columnDefs = [
    {
        headerName: "No",
        field: "no",
        width: 80,
        sortable: false,
        filter: false,
        resizable: false,
    },
    {
        field: "itemdesc",
        headerName: "Item Number",
        minWidth: 120,
        flex: 1,
    },
    {
        field: "matcontents",
        headerName: "Item Desc",
        minWidth: 160,
        flex: 1,
    },
    {
        field: "colorcode",
        headerName: "Color Code",
        minWidth: 120,
        flex: 1,
    },
    {
        field: "size",
        headerName: "Size",
        minWidth: 180,
        flex: 1,
    },
    {
        headerName: "Sent Quantity",
        minWidth: 120,
        flex: 1,
        valueGetter: (params) => {
            return (params.data?.deliverydetail ?? []).reduce(
                (total, item) => total + Number(item.qty ?? 0),
                0
            );
        },
    },
    {
        field: "sendQty",
        headerName: "Receive Qty",
        minWidth: 120,
        editable: true,
        flex: 1,
        valueSetter: (params) => {
            const value = Number(params.newValue);
            const balance = Number(params.data.balanceQty ?? 0);

            if (
                params.newValue === "" ||
                !Number.isFinite(value) ||
                value < 0 ||
                value > balance
            ) {
                return false;
            }

            params.data.sendQty = value;
            return true;
        },
    },
    {
        field: "unit",
        headerName: "Unit",
        minWidth: 90,
        flex: 1,
    },
    {
        headerName: "",
        field: "selected",
        width: 80,
        sortable: false,
        filter: false,
        resizable: false,
        headerComponent: SelectAllHeader,
        cellRenderer: (params) => {
            const checkbox = document.createElement("input");
            checkbox.type = "checkbox";
            checkbox.checked = params.value ?? false;

            checkbox.addEventListener("change", (event) => {
                const checked = event.target.checked;
                const balance = Number(params.data.balanceQty ?? 0);

                params.node.setDataValue("selected", checked);
                params.node.setDataValue(
                    "sendQty",
                    checked ? balance : 0
                );

                rawData.value = rawData.value.map((item) =>
                    item.idmaterial === params.data.idmaterial
                        ? {
                            ...item,
                            selected: checked,
                            sendQty: checked ? balance : 0,
                        }
                        : item
                );
            });

            return checkbox;
        },
    },
];


const sendData = async () => {
    try {
        const selectedRows = rawData.value.filter(
            (item) => item.selected
        );

        if (!id) {
            await warning({
                title: "Invalid Data",
                text: "ID penerimaan material tidak ditemukan.",
            });
            return;
        }

        if (selectedRows.length === 0) {
            await warning({
                title: "Incomplete Data",
                text: "Select at least one material first.",
            });
            return;
        }

        // API meminta satu field tanggal.
        if (selectedDates.value.length !== 1) {
            await warning({
                title: "Invalid Date",
                text: "Pilih tepat satu tanggal sebelum melakukan receive.",
            });
            return;
        }

        // Validasi kuantitas penerimaan.
        const invalidQty = selectedRows.some((item) => {
            const qty = Number(item.sendQty);
            const balance = Number(item.balanceQty ?? 0);

            return (
                !Number.isFinite(qty) ||
                qty <= 0 ||
                qty > balance
            );
        });

        if (invalidQty) {
            await warning({
                title: "Invalid Quantity",
                text:
                    "Receive Qty harus lebih besar dari 0 dan tidak boleh melebihi Balance.",
            });
            return;
        }

        // Validasi delivery order.
        const deliveryOrderIds = [
            ...new Set(
                selectedRows.flatMap((item) =>
                    (item.balance ?? [])
                        .filter((delivery) => delivery.iddelivery != null)
                        .map((delivery) => delivery.iddelivery)
                )
            ),
        ];

        if (deliveryOrderIds.length === 0) {
            await warning({
                title: "Invalid Data",
                text: "Delivery Order tidak ditemukan.",
            });
            return;
        }

        loading.show();

        const formData = new FormData();

        // Path parameter: /receive/{id}
        // Body sesuai kontrak API.
        formData.append("tanggal", selectedDates.value[0]);

        selectedRows.forEach((item) => {
            formData.append(
                "inputqty[]",
                String(item.sendQty)
            );
        });

        deliveryOrderIds.forEach((deliveryOrderId) => {
            formData.append(
                "deliveryorders[]",
                String(deliveryOrderId)
            );
        });

        const { data } = await api.post(
            `/api/v1/receivematerial/receive/${encodeURIComponent(id)}`,
            formData
        );

        showSendModal.value = false;

        await success({
            title: "Success",
            text: data?.message ?? "Material received successfully.",
        });

        await loadData();
    } catch (err) {
        loading.hide();
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Receive Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to receive materials.",
        });
    } finally {
        loading.hide();
    }
};

const loadData = async () => {
    try {
        loading.show();

        const params = new URLSearchParams({
            kpno,
            combine_pro: pro,
            kk,
        });

        appliedDates.value.forEach((date) => {
            params.append("dates[]", date);
        });

        const endpoint =
            `/api/v1/receivematerial/input?${params.toString()}`;

        const { data } = await api.get(endpoint);

        if (!data?.success) {
            rawData.value = [];
            return;
        }

        description.value = data?.data?.deliverymaterial?.description ?? "";
        dates.value = data?.data?.dates ?? [];

        dateOptions.value = dates.value.map((item) => ({
            label: item.date,
            value: item.date,
        }));
        
        rawData.value = (data?.data?.materials ?? []).map(
            (item, index) => {
                const deliveryDetails = item.deliverydetail ?? [];

                const balanceQty = deliveryDetails.reduce(
                    (total, delivery) =>
                        total + Number(
                            delivery.balanceQty ??
                            delivery.balance_qty ??
                            delivery.qty ??
                            0
                        ),
                    0
                );

                return {
                    ...item,
                    no: index + 1,
                    balance: deliveryDetails,
                    balanceQty,
                    sendQty: 0,
                    selected: false,
                };
            }
        );
    } catch (err) {
        loading.hide();
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Failed to Load Data",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to load material data.",
        });
    } finally {
        loading.hide();
    }
};



onMounted(() => {
    loadData();
});
</script>

<style scoped>
.label {
    white-space: nowrap;
    display: inline-block;
    width: 120px;
    font-weight: 600;
}
</style>
