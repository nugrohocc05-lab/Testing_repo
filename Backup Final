// Percobaan
const openReceiveModal = async () => {
    const selectedRows = rawData.value.filter(
        (item) => item.selected === true && !item.isReceived
    );

    if (selectedRows.length === 0) {
        await warning({
            title: "Incomplete Data",
            text: "Select at least one material that has not been received.",
        });
        return;
    }

    showSendModal.value = true;
};

const confirmSend = async () => {
    await sendData();
};

const sendData = async () => {
    try {
        const selectedRows = rawData.value.filter(
            (item) => item.selected === true && !item.isReceived
        );

        if (selectedRows.length === 0) {
            await warning({
                title: "Incomplete Data",
                text: "Select material with Qty greater than 0.",
            });

            return;
        }

        const invalidQty = selectedRows.some((item) => {
            const qty = Number(item.qty);
            return !Number.isFinite(qty) || qty <= 0 || qty > getBalance(item);
        });

        if (invalidQty) {
            await warning({
                title: "Invalid Quantity",
                text: "The Receive Qty must be greater than 0 and cannot exceed the Balance.",
            });
            return;
        }

        if (!deliveryOrderFile.value) {
            await warning({
                title: "Incomplete Data",
                text: "Upload the Delivery Order file first.",
            });
            return;
        }

        loading.show();

        const formData = new FormData();

        formData.append("kpno", kpno);
        formData.append("combine_pro", pro);
        formData.append("kk", kk);

        const doNumber =
        normalizedDates.value[0] || defaultDo.value;

        formData.append("do_number", doNumber);

        selectedRows.forEach((item) => {
            formData.append(
                `inputqty[${item.idmaterial}]`,
                String(item.qty)
            );
        });

        formData.append("deliveryorders", deliveryOrderFile.value);

        const { data } = await api.post(
            `/api/v1/receivematerial/receive`,
            formData
        );

        showSendModal.value = false;
        deliveryOrderFile.value = null;

        await success({
            title: "Success",
            text: data?.message ?? "Material received successfully.",
        });

        // if (selectedDo.value.length > 0) {
        //     selectedDo.value = [];
        // } else {
        //     await loadData();
        // }
    } catch (err) {
        loading.hide();
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Receive Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to receive materials.",
        });
    } finally {
        loading.hide();
    }
};

let loadSeq = 0;

const loadData = async () => {
    const seq = ++loadSeq;

    try {
        loading.show();

        const params = new URLSearchParams({
            kpno,
            combine_pro: pro,
            kk,
        });

        // const doNumber = normalizedDates.value.length > 0
        //     ? normalizedDates.value
        //     : all_do.value.map((item) => item.value);

        // doNumber.forEach((doNumber) => {
        //     params.append("do_number", doNumber);
        // });

        const doNumber = normalizedDates.value.length > 0
            ? normalizedDates.value
            : defaultDo.value
                ? [defaultDo.value]
                : [];

        doNumber.forEach((doNumber) => {
            params.append("do_number", doNumber);
        });

        const { data } = await api.get(
            `/api/v1/receivematerial/input?${params.toString()}`
        );

        if (seq !== loadSeq) return;

        if (!data?.success) {
            rawData.value = [];
            rawDataFiles.value = [];
            description.value = "";
            return;
        }

        description.value =
            data?.data?.deliverymaterial?.description ?? "";

        // Can
        // rawData.value = (data?.data?.materials ?? []).map((item, index) => {
        //     const isReceived = (item.deliverydetail ?? []).some(
        //         (detail) => detail.status === "Received"
        //     );

        //     const receivedDetail = (item.deliverydetail ?? []).find(
        //         (detail) => detail.status === "Received"
        //     );

        //     return {
        //         ...item,
        //         no: index + 1,
        //         isReceived,
        //         qty: isReceived
        //             ? Number(receivedDetail?.receiveqty ?? 0)
        //             : 0,
        //         selected: false,
        //     };
        // });

        // Hide nilai sent qty jika 0
        rawData.value = (data?.data?.materials ?? [])
            .filter((item) => {
                const sentQty = (item.deliverydetail ?? []).reduce(
                    (total, detail) => total + Number(detail.sendqty ?? 0),
                    0
                );

                return sentQty > 0;
            })
            .map((item, index) => {
                const isReceived = (item.deliverydetail ?? []).some(
                    (detail) => detail.status === "Received"
                );

                const receivedDetail = (item.deliverydetail ?? []).find(
                    (detail) => detail.status === "Received"
                );

                return {
                    ...item,
                    no: index + 1,
                    isReceived,
                    qty: isReceived
                        ? Number(receivedDetail?.receiveqty ?? 0)
                        : 0,
                    selected: false,
                };
            });


        // Data receive files
        rawDataFiles.value = (data?.data?.receivefiles ?? []).map(
            (item, index) => ({
                ...item,
                no: index + 1,
            })
        );

        rawDataFilesDelivery.value = (data?.data?.files ?? []).map(
            (item, index) => ({
                ...item,
                no: index + 1,
            })
        );
    } catch (err) {
        loading.hide();
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Failed to Load Data",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to load material data.",
        });
    } finally {
        loading.hide();
    }
};

const loadDataDO = async () => {
    try {
        loading.show();

        const endpoint =
            `/api/v1/receivematerial/selectdo?kpno=${encodeURIComponent(kpno)}` +
            `&kk=${encodeURIComponent(kk)}` +
            `&combine_pro=${encodeURIComponent(pro)}`;

        const { data } = await api.get(endpoint);

        all_do.value = (data?.data?.do_numbers ?? []).map((item) => ({
            value: item.do_number,
            label: item.do_number,
        }));

        defaultDo.value = all_do.value[0]?.value ?? "";

        selectedDo.value = [];

        defaultDo.value = all_do.value[0]?.value ?? "";

        selectedDo.value = defaultDo.value
            ? [defaultDo.value]
            : [];
    } catch (err) {
        loading.hide();
        if (err?.response?.status === 401) {
            router.push("/login");
            return;
        }

        await error({
            title: "Failed to Load DO",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to load DO options.",
        });
    } finally {
        loading.hide();
    }
};  

const downloadFile = async (nmfile) => {
    let url;

    try {
        loading.show();

        const endpoint = `/api/v1/deliverymaterial/showfile/${encodeURIComponent(nmfile)}`;

        const response = await api.get(endpoint, {
            responseType: "blob",
        });

        const blob = new Blob([response.data]);
        url = window.URL.createObjectURL(blob);

        // Cari data file berdasarkan filename
        const file = rawDataFiles.value.find(
            (item) => item.filename === nmfile
        );

        const link = document.createElement("a");
        link.href = url;
        link.download = file
            ? `${file.filename}.${file.extension}`
            : nmfile;

        document.body.appendChild(link);
        link.click();
        link.remove();
    } catch (err) {
        console.error("Download error:", err);

        if (err.response?.data instanceof Blob) {
            const text = await err.response.data.text();

            try {
                const errorData = JSON.parse(text);

                await customSwal.error({
                    title: "Download Failed",
                    text:
                        errorData.message ||
                        "An error occurred while downloading the file.",
                });
            } catch {
                await customSwal.error({
                    title: "Download Failed",
                    text: "An error occurred while downloading the file.",
                });
            }
        } else {
            await customSwal.error({
                title: "Download Failed",
                text:
                    err.response?.data?.message ||
                    err.message ||
                    "An error occurred while downloading the file.",
            });
        }
    } finally {
        if (url) {
            window.URL.revokeObjectURL(url);
        }

        loading.hide();
    }
};

onMounted(async () => {
    await loadDataDO();
    await loadData();
});
