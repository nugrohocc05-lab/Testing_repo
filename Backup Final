let controller = null;

const loadDataFilter = async () => {
    controller?.abort();                    // batalkan request sebelumnya
    const current = new AbortController();
    controller = current;

    loading.show();

    try {
        const params = new URLSearchParams();
        if (form.value.season) params.append("season", form.value.season);
        if (form.value.factory) params.append("factory", form.value.factory);

        const { data } = await api.get(
            `/api/v1/deliverymaterial/getdata?${params.toString()}`,
            { signal: current.signal }
        );

        rawData.value = (data?.data ?? []).map((item, index) => ({
            ...item,
            no: index + 1,
        }));

        await nextTick();
    } catch (err) {
        // request dibatalkan -> abaikan, request baru yang urus loading
        if (err?.code === "ERR_CANCELED" || err?.name === "CanceledError") return;
        if (err?.response?.status === 401) router.push("/login");
    } finally {
        // hide hanya kalau ini request terbaru
        if (controller === current) loading.hide();
    }
};

import { watch } from "vue";

watch(
    () => [form.value.season, form.value.factory],
    () => loadDataFilter()
);