const isFormChanged = computed(() => {
    if (!originalForm.value) return false

    return Object.keys(confimForm.value).some(
        key => confimForm.value[key] !== originalForm.value[key]
    )
})

const onGridReady = (params) => {
    gridApi.value = params.api;
};

const applyDateFilter = async (value) => {
    if (!gridApi.value) return;

    if (!value || !Array.isArray(value) || !value[0] || !value[1]) {
        await gridApi.value.setColumnFilterModel("deldate", null);
        gridApi.value.onFilterChanged();
        return;
    }

    const [dateFrom, dateTo] = value;

    const formatDateModel = (date) => {
        const d = new Date(date);

        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, "0");
        const day = String(d.getDate()).padStart(2, "0");

        return `${year}-${month}-${day} 00:00:00`;
    };

    await gridApi.value.setColumnFilterModel("deldate", {
        filterType: "date",
        type: "inRange",
        dateFrom: formatDateModel(dateFrom),
        dateTo: formatDateModel(dateTo),
    });

    gridApi.value.onFilterChanged();
};

const getExportColumns = () => {
    return columnDefs
        .filter((col) => {
            return (
                col.field &&
                col.headerName &&
                col.field !== "no" ||
                col.field === "no"
            );
        })
        .map((col) => ({
            header: col.headerName,
            field: col.field,
        }));
};

const onBtnExport = () => {
    if (!gridApi.value) {
        alert("Please Wait!");
        return;
    }

    const columns = getExportColumns();

    const fileName = `delivery-material-${datetime.replace(' ', '_')}.xlsx`;

    exportToExcel({
        title: `Delivery Material ${datetime}`,
        fileName,
        sheetName: "delivery-material",
        headers: columns.map(col => col.header),
        fields: columns.map(col => col.field),
        gridData: gridApi,
    });
};

const onBtnExportPdf = () => {
    if (!gridApi.value) {
        alert("Please Wait!");
        return;
    }

    const columns = getExportColumns();

    const nameFile = `delivery-material-${datetime.replace(' ', '_')}`;

    exportToPdf({
        title: `Delivery Material ${datetime}`,
        fileName: nameFile,
        headers: columns.map(col => col.header),
        fields: columns.map(col => col.field),
        gridData: gridApi,
        orientation: "l",
    });
};

const ActionRenderer = defineComponent({
    props: {
        params: {
            type: Object,
            required: true,
        },
    },

    setup(props) {
        const detailData = () => {
            dataSelected.value = props.params.data;

            const kp = dataSelected.value.kpno;
            const encryptedKP = encrypt(kp);

            router.push({
                name: "material-delivery-detail",
                params: {
                    kpno: encodeURIComponent(encryptedKP),
                },
            });
        };

        const processData = () => {
            dataSelected.value = props.params.data;

            const kk = dataSelected.value.kk;
            const kpno = dataSelected.value.kpno;
            const pro = dataSelected.value.combine_pro;

            router.push({
                name: "material-delivery-input",
                params: {
                    kk: encodeURIComponent(encrypt(kk)),
                    kpno: encodeURIComponent(encrypt(kpno)),
                    pro: encodeURIComponent(encrypt(pro)),
                },
            });
        };

        return () =>
            h("div", {
                class: "flex h-full px-3 gap-2",
            }, [
                h(
                    "button",
                    {
                        type: "button",
                        title: "Detail",
                        class:
