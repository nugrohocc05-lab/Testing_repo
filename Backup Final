    static function generate_barcode($factory_id, $idpo, $seq) : String {
        $format = "0000000";
        $formatedNumber = str_pad($seq, strlen($format), "0", STR_PAD_LEFT);
        $barcode = strval($factory_id).strval($idpo).strval($formatedNumber);

        return strval($barcode);
    }

    static function check_qty($idpo, $idcolor, $idsize, $bundlecode){
        preconnect(session('db'));
        $generate = OutputDetail::selectRaw("COUNT(DISTINCT barcode) as qty")
            ->where("idpo", $idpo)
            ->where("idcolor", $idcolor)
            ->where("idsize", $idsize)
            ->where("bundlecode", $bundlecode)
            ->first();
        $qty_output = $generate->qty ?? 0;

        $qty_bundles = CuttingBundleAllocation::selectRaw("SUM(qty) as qty")
            ->where("bundlecode", $bundlecode)
            ->where("idpo", $idpo)
            ->whereNull("date_deploy")
            ->first();
        $qty_bundle = $qty_bundles->qty ?? 0;
        $total_qty = $qty_bundle - $qty_output;

        return [
            'qty_output' => $qty_output,
            'qty_bundle' => $qty_bundle,
            'total_qty' => $total_qty,
        ];
    }

    function finishgeneratebundle(Request $request) {
        preconnect(session('db'));
        try {
            $factory_id = strval(session('db')->iddb);
            $line = session('db')->line;
            $bundlecode = strval($request->bundlecode);
            $idpo = strval($request->idpo);
            $idd = $request->idd;
            $nik = session('user')->nik;

            if(!$factory_id){
                throw new \Exception("Setting Factory!");
            }

            if(!$line){
                throw new \Exception("Setting Line!");
            }

            if(!$bundlecode){
                throw new \Exception("Missing Bundlecode!");
            }

            if(!$idpo){
                throw new \Exception("Missing PO!");
            }

            if(count($idd) <= 0){
                throw new \Exception("Missing Garment ID!");
            }

            $last_barcode = OutputDetail::where("idpo", $idpo)
                ->orderBy("barcode", "DESC")
                ->first();
            $seq = 0;
            if($last_barcode){
                $seq = substr($last_barcode->barcode, -7);
                $seq = (int) ltrim($seq, "0");
            }

            $cb = (new CuttingBundle())->getTable();
            $cba = (new CuttingBundleAllocation())->getTable();

            $bundle = CuttingBundle::select("$cb.idcolor","$cb.idsize","$cb.sub_style_id",
                "$cba.idpo","$cb.kpno","$cb.combine_pro","$cb.bundlecode")
                ->join($cba,"$cba.bundlecode","=","$cb.bundlecode")
                ->where("$cba.bundlecode", $bundlecode)
                ->where("$cba.idpo", $idpo)
                ->first();
            if(!$bundle){
                throw new \Exception("Wrong bundle allocation!");
            }
            $mps = MpsDetail::whereHas("header", function($q)use($line, $bundle){
                    $q->where("kpno", $bundle->kpno)
                    ->where("line", $line);
                })
                ->where("date", Carbon::now()->format('Y-m-d'))
                ->first();
            if(!$mps){
                throw new \Exception("MPS not found!");
            }
            $op = OrderPart::find($mps->order_part_id);
            $is_assembly = 0;
            if($op){
                if(str_contains($op->name, "ASSEMBLY")){
                    $is_assembly = 1;
                }
            }

            $count = 0;
            $qty = self::check_qty($idpo, $bundle->idcolor, $bundle->idsize, $bundlecode);
            $count = $qty['total_qty'];
            if($qty['qty_output'] >= $qty['qty_bundle'] || $qty['total_qty'] == '0'){
                throw new \Exception("Garment ID quantity is already fulfilled!");
            }

            DB::beginTransaction();
            $id_process_loading = MasterProsesGarment::where("nmproses", "LOADING")
                ->first()->idproses ?? "013";
            foreach ($idd as $card) {
                ++$seq;
                $bcode = self::generate_barcode($factory_id, $idpo, $seq);
                if ($count == 0){
                    $qty = self::check_qty($idpo, $bundle->idcolor, $bundle->idsize, $bundlecode);
                    if($qty['qty_output'] >= $qty['qty_bundle'] || $qty['total_qty'] == '0'){
                        throw new \Exception("Garment ID quantity is already fulfilled!");
                    }
                }
                $count--;

                // Output Detail / Generate Sewing
                $_od = new OutputDetail();
                $_od->barcode = $bcode;
                $_od->idcolor = $bundle->idcolor;
                $_od->idsize = $bundle->idsize;
                $_od->sub_style_id = $bundle->sub_style_id;
                $_od->idpo = $idpo;
                $_od->kpno = $bundle->kpno;
                $_od->combine_pro = $bundle->combine_pro;
                $_od->printby = $nik;
                $_od->printtime = Carbon::now();
                $_od->bundlecode = $bundlecode;
                $_od->save();

                // Card Convert
                $cc = new MainCardConvert();
                $cc->factory_id = $factory_id;
                $cc->id_card = strval($card);
                $cc->id_convert = $bcode;
                $cc->id_reference = "06";
                $cc->save();

                // Loading
                $so = new SewingOutput();
                $so->barcode = $bcode;
                $so->line = $line;
                $so->date = Carbon::now();
                $so->station_id = 0;
                $so->is_assembly = $is_assembly;
                $so->is_qc = 0;
                $so->is_output = 0;
                $so->save();

                // Output Total
                $ot = OutputTotal::where("kpno", $_od->kpno)
                    ->where("combine_pro", $_od->combine_pro)
                    ->where("idpo", $_od->idpo)
                    ->where("sub_style_id", $_od->sub_style_id)
                    ->where("idcolor", $_od->idcolor)
                    ->where("idsize", $_od->idsize)
                    ->first();
                if(!$ot){
                    $ot = new OutputTotal();
                    $ot->kpno = $_od->kpno;
                    $ot->combine_pro = $_od->combine_pro;
                    $ot->idpo = $_od->idpo;
                    $ot->sub_style_id = $_od->sub_style_id;
                    $ot->idcolor = $_od->idcolor;
                    $ot->idsize = $_od->idsize;
                    $ot->printed = 1;
                    $ot->loading = 1;
                }else{
                    $qtyprinted = intval($ot->printed) + 1;
                    $qty = intval($ot->loading) + 1;
                    $ot->printed = $qtyprinted;
                    $ot->loading = $qty;
                }
                $ot->save();

                // update last process
                $card_alloc = CardAllocation::find(strval($card));
                if($card_alloc){
                    $card_alloc->last_process_garment_id = $id_process_loading;
                    $card_alloc->save();
                }
            }
            // Cutting Bundle / Cutting Bundle Allocation
            $_cb = CuttingBundle::where("bundlecode", $bundlecode)
                ->first();
            $_cba = CuttingBundleAllocation::where("bundlecode", $bundlecode)
                ->where("idpo", $idpo)
                ->first();
            $stock = intval($_cb->stock_qty) - intval($_cba->qty);
            $_cb->stock_qty = $stock ?? 0;
            if($stock <= 0){
                $_cb->deploydate = Carbon::now();
                $_cb->deployby = $nik;
            }
            $_cb->save();

            $_cba->date_deploy = Carbon::now();
            $_cba->userid_deploy = $nik;
            $_cba->save();

            if($stock <= 0){
                $mcc = MainCardConvert::where("id_convert", $bundlecode)
                    ->where("id_reference", "05")
                    ->first();

                if($mcc){
                    $mcc->delete();
                }
            }

            $tpo = (new PurchaseOrder())->getTable();
            $cb = (new CuttingBundle())->getTable();
            $cba = (new CuttingBundleAllocation())->getTable();

            $data = CuttingBundle::select("$tpo.idbuyer", "$tpo.idstyle", "$tpo.kpno",
                    "$cb.cutplan_header_id", "$cb.combine_pro", "$cb.idcolor", "$cb.idsize",
                    "$cb.bundlecode", DB::raw("SUM($cba.qty) as qtybundle")
                )
                ->join($cba, "$cba.bundlecode","=","$cb.bundlecode")
                ->join($tpo, "$tpo.idpo","=","$cba.idpo")
                ->where("$cb.bundlecode", $bundlecode)
                ->whereNull("$cb.deploydate")
                ->first();
            if(!$data){
                throw new \Exception("Data not found!");
            }

            $data->nmbuyer = Buyer::find($data->idbuyer)->nmbuyer ?? "-";
            $data->nmstyle = Style::find($data->idstyle)->nmstyle ?? "-";
            $data->cutplan = str_replace($data->kpno, "", CutplanHeader::find($data->cutplan_header_id)->name ?? "-");
            $data->nmcolor = Color::find($data->idcolor)->nmcolor ?? "-";
            $data->nmsize = Size::find($data->idsize)->nmsize ?? "-";
            DB::commit();

            return response()->json($data);
        } catch (\Throwable $e) {
            DB::rollback();
            return response()->json($e->getMessage(), 400);
        }
    }

    static function check_mps_usage($mode, $kpno, $pro, $substyle, $line) {
        preconnect(session('db'));
        try {
            $data = new \stdClass();
            $pg = ProsesGarment::where("sub_style_id", $substyle)
                ->where("combine_pro", $pro)
                ->where("kpno", $kpno)
                ->where("idproses", "014")
                ->where("is_use", 1)
                ->first();
            $order_part_id = null;
            if(!$pg){
                $data->status = false;
                $data->order_part_id = null;
                return $data;
            }

            if($mode == 'bundle'){
                if(
                    ($pg->use_feeder == 1) and
                    ($pg->use_feeder_hanger == 1)
                ){
                    $order_part_id = 1;
                }else{
                    if(
                        ($pg->use_feeder == 1) and
                        ($pg->use_feeder_hanger == 0)
                    ){
                        $cekmps = MpsHeader::whereHas("detail", function($q)use($substyle){
                                $q->where("date", Carbon::now()->format('Y-m-d'))
                                ->where("sub_style_id", $substyle)
                                ->whereIn("order_part_id", [1,4]);
                            })
                            ->where("kpno", $kpno)
                            ->where("combine_pro", $pro)
                            ->where("sub_style_id", $substyle)
                            ->where("line", $line)
                            ->first();
                        if($cekmps){
                            $data->status = false;
                            $data->order_part_id = null;
                            return $data;
                        }else{
                            $order_part_id = 1;
                        }
                    }
                    if(
                        ($pg->use_feeder == 0) and
                        ($pg->use_feeder_hanger == 1)
                    ){
                        $cekmps = MpsHeader::whereHas("detail", function($q)use($substyle){
                                $q->where("date", Carbon::now()->format('Y-m-d'))
                                ->where("sub_style_id", $substyle)
                                ->whereIn("order_part_id", [1,2]);
                            })
                            ->where("kpno", $kpno)
                            ->where("combine_pro", $pro)
                            ->where("sub_style_id", $substyle)
                            ->where("line", $line)
                            ->first();
                        if($cekmps){
                            $data->status = false;
                            $data->order_part_id = null;
                            return $data;
                        }else{
                            $order_part_id = 1;
                        }
                    }

                    $data->status = true;
                    $data->order_part_id = $order_part_id;
                    return $data;
                }
            }else{
                if(
                    ($pg->use_feeder == 1) and
                    ($pg->use_feeder_hanger == 1)
                ){
                    $cekmps = MpsHeader::whereHas("detail", function($q)use($substyle){
                            $q->where("date", Carbon::now()->format('Y-m-d'))
                            ->where("sub_style_id", $substyle)
                            ->whereIn("order_part_id", [2,4]);
                        })
                        ->where("kpno", $kpno)
                        ->where("combine_pro", $pro)
                        ->where("sub_style_id", $substyle)
                        ->where("line", $line)
                        ->first();
                    if($cekmps){
                        $data->status = false;
                        $data->order_part_id = null;
                        return $data;
                    }else{
                        $order_part_id = 1;
                    }

                    $data->status = true;
                    $data->order_part_id = $order_part_id;
                    return $data;
                }else{
                    if($pg->use_feeder == 1){
                        $order_part_id = 2;
                    }
                    if($pg->use_feeder_hanger == 1){
                        $order_part_id = 4;
                    }
                }
            }

            $cekmps = MpsHeader::whereHas("detail", function($q)use($order_part_id, $substyle){
                    $q->where("date", Carbon::now()->format('Y-m-d'))
                    ->where("sub_style_id", $substyle)
                    ->where("order_part_id", $order_part_id);
                })
                ->where("kpno", $kpno)
                ->where("combine_pro", $pro)
                ->where("sub_style_id", $substyle)
                ->where("line", $line)
                ->first();

            if($cekmps){
                return true;
            }

            $data->status = false;
            $data->order_part_id = $order_part_id;
            return $data;
        } catch (\Throwable $e) {
            $data->status = false;
            $data->order_part_id = null;
            return $data;
        }
    }

