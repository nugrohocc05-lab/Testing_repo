function checkallchecklist(){
    let total = $('#scanbody tr').length;
    let ready = 0;

    $('#scanbody tr').each(function(){
        let scanned = $(this).find('.minimal').is(':checked')
                   || $(this).find('.minimal').attr('checked');
        let actionPicked = $(this).find('.action:checked').length > 0;
        if(scanned && actionPicked){
            ready++;
        }
    });

    if(total > 0 && ready === total){
        $('#btn-finish').show();
    }else{
        $('#btn-finish').hide();
    }
}

function setCheck(){
    $('input[type="radio"]').on('change', function(ev){
        let check = $(this).closest('tr').find('input[type="checkbox"]');
        if(!check.is(':checked')){
            $(this).prop('checked', false);
        }else{
            $(this).closest('tr').find('.action').not(this).removeClass('checked');
            $(this).addClass('checked');
        }
        checkallchecklist();
    });
}

setCheck();
checkallchecklist();
isFirst = false;