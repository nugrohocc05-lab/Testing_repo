    <div class="px-6">
        <UiTitle :is-back="true" align="center" title="Delivery Finish Goods Detail">
            <template #action-left>
                <UiButton variant="teritary" @click="router.back()">
                    <ArrowLeftStartOnRectangleIcon class="h-5 w-5" />
                    <span class="text-xl ml-1">Back</span>
                </UiButton>
            </template>
        </UiTitle>
        <UiCard class="mt-10 text-xs md:text-lg">
            <UiGrid cols="3" gap="sm">
                <div>
                    <span class="label">Order Number</span> :
                    {{ rawDataHeader.order?.ordernumber }}
                </div>

                <div>
                    <span class="label">Delivery Date</span> :
                    {{ rawDataHeader.order?.deliverydate }}
                </div>

                <div>
                    <span class="label">Total Qty</span> :
                    {{ rawDataHeader.totalqty }}
                </div>

                <div>
                    <span class="label">PRO</span> :
                    {{ rawDataHeader.order?.combine_pro }}
                </div>

                <div>
                    <span class="label">Style</span> :
