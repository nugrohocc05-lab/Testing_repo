<script type="text/javascript">
    $(document).ready(function() {
        var dtbarcode = [];
        var length = '10';
        var isFirst = true;
        var _do = null;

        $('#barcode').focus();
        $('.box').on('click', function(){
            $('#barcode').val('');
            $('#barcode').focus();
        });

        var delay = (function(){
            var timer = 0;
            return function(callback, ms){
                clearTimeout (timer);
                    timer = setTimeout(callback, ms);
                };
        })();

        $("#barcode").on("input", function() {
            delay(function(){
                if ($("#barcode").val().length <= length) {
                    $("#barcode").val("");
                }
            }, 20 );
        });

        $('#barcode').on("paste",function(e) {
            e.preventDefault();
        });

        $("#barcode").change(function(e) {
            e.preventDefault();
            if ($('#barcode').val().length >= length) {
                $('#loading').show();
                const barcode = $("#barcode").val();
                $('#barcode').attr("readonly","readonly");
                if(isFirst){
                    let totalrecord = $('#totalrecords').text();
                    $.ajax({
                        type: 'POST',
                        url: `{{ route('gilaboratory_getdata') }}`,
                        dataType: "json",
                        data: {
                            barcode: barcode,
                        },
                        success: function(dt) {
                            $.each(dt.data, function(i,v){
                                $('#scanbody').append(`
                                    <tr class="tr${v.barcode}">
                                        <td class="row-number">${++i}</td>
                                        <td>${v.barcode}</td>
                                        <td>${v.nmbuyer}</td>
                                        <td>${v.nmstyle}</td>
                                        <td>${v.nmcolor}</td>
                                        <td>${v.nmsize}</td>
                                        <td>
                                            <div style="pointer-events: none;">
                                                <input type="checkbox" style="height:20px;width:20px;" class="bc${v.barcode} minimal" value="${v.barcode}" name="barcode[]">
                                            </div>
                                        </td>
                                        <td>
                                            <input type="radio" style="height:20px;width:20px;" class="action" value="1" name="action[${v.barcode}]">
                                        </td>
                                        <td>
                                            <input type="radio" style="height:20px;width:20px;" class="action" value="0" name="action[${v.barcode}]">
                                        </td>
                                    </tr>
                                `);
                            });
                            _do = dt.do;
                            dtbarcode.push(dt.barcode);
                            $('body').find(`.bc${dt.barcode}`).iCheck('check');
                            $('body').find(`.bc${dt.barcode}`).attr('checked', 'checked');
                            var idx = $('#scanbody').find('tr').length;
                            $('.table-holder').show();
                            $('.box-footer').show();
                            $('.table-row').scrollTop($('.table-row')[0].scrollHeight);
                            $('#totalrecords').text(idx);
                            setCheck();
                            isFirst = false;
                        },
                        error: (e) => {
                            $('#barcode').val('');
                            $('#barcode').blur();
                            swal("Warning", e.responseJSON, 'warning').then(function(){
                                $('#barcode').focus();
                                $('#barcode').val('');
                            });
                            return;
                        },
                        complete: () => {
                            $('#barcode').focus();
                            $('#barcode').val('');
                            $('#barcode').removeAttr('readonly');
                            $('#loading').hide();
                        }
                    });
                }else{
                    getbarcode(barcode);
                }
            }else{
                $('#barcode').val('');
                $('#barcode').focus();
            }
            checkallchecklist();
        });

        $('#btn-cancel').on('click', function(){
            window.location.reload();
        });

        $('#btn-finish').on('click', function(){
            checkAllAction();
        });

        $('#savebtn').on('click', function(){
            let act = $('.action').serializeArray();
            $('#loading').show();
            $.ajax({
                type: 'POST',
                url: `{{ route('gilaboratory_finish') }}`,
                dataType: "json",
                data: {
                    do: _do,
                    barcode : dtbarcode,
                    action: act,
                    remark: $('#remark').val(),
                    destination: $('#destination').val(),
                },
                success: function(r) {
                    swal("Success", r, 'success').then(function(){
                        dtbarcode = [];
                        isFirst = true;
                        _do = null;
                        $('#totalrecords').text('0');
                        $('.table-holder').hide();
                        $('.box-footer').hide();
                        $('#scanbody').html('');
                        $('#barcode').focus();
                        $('#barcode').val('');
                        $('#remark').val('');
                        $('#destination').val('');
                        $('#modal-form').modal('hide');
                    });
                },
                error: (e) => {
                    $('#barcode').val('');
                    $('#barcode').blur();
                    swal("Warning", e.responseJSON, 'warning').then(function(){
                        $('#barcode').focus();
                        $('#barcode').val('');
                    });
                },
                complete: () => {
                    $('#barcode').val('');
                    $('#loading').hide();
                }
            });
        });

        function getbarcode(_bcd){
            $.ajax({
                type: 'POST',
                url: `{{ route('gilaboratory_getbarcode') }}`,
                dataType: "json",
                data: {
                    barcode: _bcd,
                },
                success: function(r){
                    bcdSet = $('body').find(`.bc${r}`);
                    if(!dtbarcode.includes(r)){
                        bcdSet.iCheck('check');
                        bcdSet.attr('checked', 'checked');
                        dtbarcode.push(r);
                        $('#barcode').focus();
                        $('#barcode').val('');
                        return;
                    }else{
                        swal("Warning", "Garment ID Already Scanned", 'warning').then(function(){
                            $('#barcode').val('');
                            $('#barcode').focus()
                        });
                    }
                },
                error: function(e){
                    $('#barcode').val('');
                    $('#barcode').blur();
                    swal("Warning", e.responseJSON, 'warning').then(function(){
                        $('#barcode').focus();
                        $('#barcode').val('');
                    });
                },
                complete: () => {
                    $('#barcode').focus();
                    $('#barcode').val('');
                    $('#barcode').removeAttr('readonly');
                    checkallchecklist();
                    $('#loading').hide();
                }
            });
        }

        function checkallchecklist(){
            let _len_checked = 0;
            $('.minimal').each(function(idx, el){
                if(el.hasAttribute('checked')){
                    _len_checked += 1;
                }
            });
            let _len_row = $('#scanbody').find('tr').length;
            if(_len_checked == _len_row){
                $('#btn-finish').show();
                return;
            }else{
                $('#btn-finish').hide();
            }
        }

        function setCheck(){
            $('input[type="radio"]').on('change', function(ev){
                let check = $(this).closest('tr').find('input[type="checkbox"]');
                if(!check.is(':checked')){
                    $(this).prop('checked', false);
                    return;
                }else{
                    $(this).closest('tr').find('.action').not(this).removeClass('checked');
                    $(this).addClass('checked');
                }
            });
        }

        function checkAllAction(){
            let _len_checked = 0;
            $('.action').each(function(idx, el){
                if($(this).hasClass('checked')){
                    _len_checked += 1;
                }
            });
            let _len_row = $('#scanbody').find('tr').length;
            if(_len_checked != _len_row){
                swal("Warning!", "Uncomplete action Return/Destroy!", "warning");
                return;
            }
            $('#modal-form').modal('show');
        }
    });
</script>
@endsection
