        </UiCard>
    </div>
    <UiModal
        v-model="showSendModal"
        title="Delivery Order"
        size="2xl"
    >
        <div class="space-y-4 -mt-3">
            <UiInput
                type="file"
                variant="dropzone"
                label="File Delivery Orders"
                placeholder="Choose File"
                dropzone-hint="Only PDF, XLS, or XLSX formats, up to 2MB"
                accept=".pdf,.xls,.xlsx"
                @change="handleFile"
            />

            <UiInput
