const setChecklist = () => {
    const data = rawData.value;

    if (!data) return;

    completed.value = uploadFields.value.some(item =>
        (data[item.key] || []).some(
            file => file.completedate != null && file.completedate !== ""
        )
    );

    allFilled.value = uploadFields.value.every(
        item => data[item.key]?.length > 0
    );

    confimForm.value = {
        dsp: false,
        fs: false,
        ms: false,
        pa: false,
        ps: false,
        sr: false,
        tc: false,
    };

    uploaded.value = {
        dsp: data.dsp?.length ?? 0,
        fs: data.fs?.length ?? 0,
        ms: data.ms?.length ?? 0,
        pa: data.pa?.length ?? 0,
        ps: data.ps?.length ?? 0,
        sr: data.sr?.length ?? 0,
        tc: data.tc?.length ?? 0,
    };

    inputField.value = {
        linksr: "",
        linkms: "",
        linkps: "",
        linktc: "",
        linkfs: "",
        linkdsp: "",
        linkpa: "",
        filesr: [],
        filems: [],
        fileps: [],
        filetc: [],
        filefs: [],
        filedsp: [],
        filepa: [],
    };
};

const inputField = ref({
    idorder: '',

    linksr: '',
    linkms: '',
    linkps: '',
    linktc: '',
    linkfs: '',
    linkdsp: '',
    linkpa: '',

    filesr: [],
    filems: [],
    fileps: [],
    filetc: [],
    filefs: [],
    filedsp: [],
    filepa: [],
})

const go = (url) => {
    if (!url) return;
    const targetUrl = /^https?:\/\//i.test(url) ? url : `https://${url}`;
    window.open(targetUrl, "_blank", "noopener,noreferrer");
};

const openModal = (key) => {
    dataSelected.value = []
    dataSelected.value = uploadFields.value.find(
        (item) => item.key === key
    )
    showModal.value = true
};

const download = async (id, filename) => {
    if (!id) return

    try {
        const { data } = await api.get(
            `/api/v1/samplereference/showfile/${id}`,
            {
                responseType: "blob"
            }
        )
        const blobUrl = URL.createObjectURL(data)
        const link = document.createElement("a")
        link.href = blobUrl
        link.download = `${filename}`
        document.body.appendChild(link)
        link.click()
        link.remove()

        URL.revokeObjectURL(blobUrl)
    } catch (error) {
        console.error("Download gagal:", error)
    }
}

const upload = async (key) => {
    try {
        const field = uploadFields.value.find(
            item => item.key === key
        )

        if (!field) {
            return
        }

        inputField.value.idorder = ID
        const linkValue = inputField.value[field.link]
        const files = inputField.value[field.file]

        const hasLink = !!linkValue
        const hasFile = !!files && files instanceof File

        const MAX_FILE_SIZE = 2 * 1024 * 1024

        if (hasFile && files.size > MAX_FILE_SIZE) {
            await warning({
                title: "File Too Large",
                text: "The maximum file size is 2 MB!",
            })
            return
        }

        const type = confimForm.value[key] ? "Link" : "File"

        if (!hasLink && !hasFile) {
            await warning({
                title: "Incomplete Data",
                text: `${type} is required for ${field.label}!`,
            })
            return
        }

        if (type === "Link" && hasLink) {
            const isValidUrl = URL.canParse(linkValue) 
                && (linkValue.startsWith('http://') || linkValue.startsWith('https://'));

            if (!isValidUrl) {
                await warning({
                    title: "Invalid Link",
                    text: `Please enter a valid URL (e.g., https://example.com) for ${field.label}!`,
                })
                return
            }
        }

        const result = await confirm({
            title: "Are You Sure to Upload This Data?",
            text: "Please do this action carefully!",
        });

        if (!result.isConfirmed) {
            return
        }
        loading.show()

        const formData = new FormData()
        formData.append('idorder', inputField.value.idorder)
        if (linkValue) {
            formData.append(field.link, linkValue)
        }

        if (files) {
            if (files instanceof File) {
                formData.append(`${field.file}`, files)
            }
        }

        if (field.expiredate) {
            const expireValue = inputField.value[field.expiredate]
            if (expireValue) {
                formData.append(field.expiredate, expireValue)
            }
        }

        const endpoint = `/api/v1/samplereference/store/file/Upload/${id.value}`;
        const { data } = await api.post(
            endpoint,
            formData
        );
        loading.hide()

        await success({
            title: "Success",
            text: data?.message || "Data updated successfully.",
        });
        showModal.value = false
        await loadData()
    } catch (err) {
        loading.hide()
        if (err?.response?.status === 401) {
            router.push("/login")
            return
        }

        await error({
            title: "Upload Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to Upload the Data. Please try again.",
        });
    }
}

const remove = async (idItem) => {
    try {
        const result = await confirm({
            title: "Are You Sure to Delete This Data?",
            text: "Please do this action carefully!",
        });

        if (!result.isConfirmed) {
            return
        }
        loading.show()

        const endpoint = `/api/v1/samplereference/delete?id=${idItem}`;
        const { data } = await api.delete(endpoint);
        loading.hide()

        await success({
            title: "Success",
            text: data?.message || "Delete successfully.",
        });
        await loadData()
    } catch (err) {
        loading.hide()
        if (err?.response?.status === 401) {
            router.push("/login")
            return
        }

        await error({
            title: "Upload Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to Upload the Data. Please try again.",
        });
    }
}

const finish = async () => {
    try {
        const formData = new FormData()
        formData.append('idorder', ID)

        const result = await confirm({
            title: "Are You Sure to Complete This Data?",
            text: "Please do this action carefully!",
        });

        if (!result.isConfirmed) {
            return
        }
        loading.show()

        const endpoint = `/api/v1/samplereference/complete/${id.value}`;
        const { data } = await api.post(
            endpoint
        );
        loading.hide()

        await success({
            title: "Success",
            // text: data?.message || "Completion successful.",
            text: "Successfully Confirmed! Now you need to send counter sample",
        });
        await loadData()
    } catch (err) {
        loading.hide()
        if (err?.response?.status === 401) {
            router.push("/login")
            return
        }
 
        await error({
            title: "Completion Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to Completion the Data. Please try again.",
        });
    }
}

