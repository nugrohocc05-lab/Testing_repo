function index()
{
    $data = IntellocutHeader::whereIn('id', function ($query) {
        $query->select('idheader')
            ->from((new IntellocutShellHeader())->getTable());
    })->get();

    $shellHeaders = IntellocutShellHeader::whereIn('idheader', $data->pluck('id'))
        ->get()
        ->groupBy('idheader');

    $shellDetails = IntellocutShellDetail::whereIn(
            'idshellheader',
            $shellHeaders->flatten()->pluck('id')
        )
        ->whereNotNull('idtable')
        ->where('idtable', '<>', '')
        ->orderBy('lay')
        ->get()
        ->groupBy('idshellheader');

    // master, di-key by id
    $styles = MasterIntellocutStyle::get()->keyBy('id');
    $shells = MasterIntellocutShell::get()->keyBy('id');
    $colors = MasterIntellocutColor::get()->keyBy('id');

    $data->each(function ($h) use ($shellHeaders, $shellDetails, $styles, $shells, $colors) {
        $ids = ($shellHeaders[$h->id] ?? collect())->pluck('id');

        $h->style_name = optional($styles->get($h->idstyle))->name ?? $h->idstyle;

        $h->lay_groups = $ids
            ->flatMap(fn ($id) => $shellDetails[$id] ?? collect())
            ->groupBy('lay')
            ->map(function ($rows) use ($shells, $colors) {
                $row = $rows->first();
                $row->shell_name = optional($shells->get($row->idshell))->name ?? $row->idshell;
                $row->color_name = optional($colors->get($row->idcolor))->name ?? $row->idcolor;
                $row->group_count = $rows->count(); // berapa baris yang digabung
                return $row;
            });
    });

    return view('cutting::intellocutlayerman.index', compact('data'));
}



