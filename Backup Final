<?php

namespace Modules\Cutting\Http\Controllers;

use App\Http\Controllers\Controller;
use App\Http\Models\IntellocutDetail;
use App\Http\Models\IntellocutHeader;
use App\Http\Models\IntellocutShellDetail;
use App\Http\Models\IntellocutShellHeader;
use App\Http\Models\MasterIntellocutColor;
use App\Http\Models\MasterIntellocutShell;
use App\Http\Models\MasterIntellocutStyle;
use DB;

class IntellocutLayermanController extends Controller
{
    protected $m_modul = 'cutting';

    function __construct()
    {
        $this->middleware('auth');
    }

    function index()
    {

        $data = IntellocutHeader::whereIn('id', function ($query) {
            $query->select('idheader')
                ->from((new IntellocutShellHeader())->getTable());
        })->get();

        $shellHeaders = IntellocutShellHeader::whereIn('idheader', $data->pluck('id'))
            ->get()
            ->groupBy('idheader');

        $shellDetails = IntellocutShellDetail::whereIn(
                'idshellheader',
                $shellHeaders->flatten()->pluck('id')
            )
            ->whereNotNull('idtable')
            ->where('idtable', '<>', '')
            ->orderBy('lay')
            ->get()
            ->groupBy('idshellheader');


        $styles = MasterIntellocutStyle::get()->keyBy('idstyle');
        $shells = MasterIntellocutShell::get()->keyBy('id');
        $colors = MasterIntellocutColor::get()->keyBy('id');

        $intellocutDetails = IntellocutDetail::whereIn('idheader', $data->pluck('id'))
            ->get()
            ->groupBy('idheader');

        $data->each(function ($h) use (
            $shellHeaders,
            $shellDetails,
            $styles,
            $shells,
            $colors,
            $intellocutDetails
        ) {

            $ids = ($shellHeaders[$h->id] ?? collect())->pluck('id');

            // Relasi Style
            $h->style_name = optional($styles->get($h->idstyle))->nmstyle ?? $h->idstyle;
            $h->color_name = optional($colors->get($h->idcolor))->nmcolor ?? $h->idcolor;

            // Ambil detail berdasarkan idheader
            $details = $intellocutDetails[$h->id] ?? collect();

            $h->lay_groups = $ids
                ->flatMap(fn ($id) => $shellDetails[$id] ?? collect())
                ->groupBy('lay')
                ->map(function ($rows) use ($shells, $colors, $details) {

                    $row = $rows->first();

                    // Relasi Shell
                    $row->shell_name = optional($shells->get($row->idshell))->nmshell
                        ?? $row->idshell;

                    // Relasi Color dari intellocut_details
                    $colorIds = $details->pluck('idcolor')->unique()->filter();

                    $row->color_name = $colorIds
                        ->map(fn ($id) => optional($colors->get($id))->nmcolor)
                        ->filter()
                        ->unique()
                        ->implode(', ');

                    $row->group_count = $rows->count();

                    return $row;
                });
        });

        return view('cutting::intellocutlayerman.index', compact('data'));
    }

    function layassign()
    {
        return view('cutting::intellocutlayerman.layassign');
    }

    function laystarted($id)
    {
        $data = IntellocutDetail::with('header')
            ->where('id',$id)
            ->first();

        return view('cutting::intellocutlayerman.inputlayerman', compact('data'));
    }
}


