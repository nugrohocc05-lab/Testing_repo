function summaryFilter(Request $request) {
       preconnect(session('db'));

        $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
        $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

        $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
        $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

        $headerQuery = OutputDetailFinalInspection::whereBetween('date_output', [$dta, $dtb]);

        if ($request->line && $request->line != 'all') {
            $headerQuery = $headerQuery->where('line', $request->line);
        }

        if ($request->groupbuyer && $request->groupbuyer != 'all') {
            $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)
                ->pluck('idbuyer');

            $poIds = PurchaseOrder::whereIn('idbuyer', $buyerIds)
                ->pluck('idpo');

            $barcodes = OutputDetail::whereIn('idpo', $poIds)
                ->select('barcode')
                ->distinct()
                ->pluck('barcode');

            $fi = OutputDetailFinalInspection::whereIn('barcode', $barcodes)->pluck('id');

            if ($fi->isEmpty()) {
                $headerQuery = $headerQuery->whereRaw('1 = 0');
            } else {
                $headerQuery = $headerQuery
                    ->whereIn('id', $fi)
                    ->where('is_qc', 1);
            }
        }

        $totalPo = (clone $headerQuery)
            ->where('is_output', 1)
            ->count();

        return response()->json([
            'total_po'    => $totalPo,
        ]);

    }
