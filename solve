    function selectline(Request $request)
    {
        $g = (new MasterEmployeeGroup())->getTable();
        $s = (new MasterEmployeeSection())->getTable();

        $data = MasterEmployeeGroup::select(
                "$g.id as kodegroup", "$g.section_id as kodebagian",
                "$g.name as namagroup", "$s.name as namabagian"
            )
            ->join($s, "$s.id", '=', "$g.section_id")
            ->distinct()
            ->whereHas('groupline', function($q){
                $q->where('factory_id', session('db')->iddb)
                    ->where('is_show', 1)
                    ->where('is_line', 1);
            });

        if ($request->q) {
            $data = $data->where(function ($q) use ($request, $g) {
                $q->where("$g.name", 'like', "%$request->q%");
            });
        }
        $data = $data->orderBy('kodegroup')->paginate(15, $request->page);

        return response()->json($data);
    }

    function groupbuyer(Request $request)
    {
        $q = $request->get('q');

        $data = MasterGroupBuyer::select('id', 'group_name')
            ->when($q, function ($query) use ($q) {
                $query->where('group_name', 'like', '%' . $q . '%');
            })
            ->get()
            ->map(function ($item) {
                return [
                    'id' => $item->id,
                    'text' => $item->group_name
                ];
            });

        return response()->json([
            'results' => $data
        ]);
    }

    function getFilterData($request)
    {
        $m_da = $request->datea > $request->dateb ? $request->dateb : $request->datea;
        $m_db = $request->datea > $request->dateb ? $request->datea : $request->dateb;

        $dta = Carbon::parse($m_da);
        $dtb = Carbon::parse($m_db)->endOfDay();

        $headerQuery = InlineHeader::whereBetween('date', [$dta, $dtb]);

            if ($request->line && $request->line != 'all') {
                $headerQuery = $headerQuery->where('group_id', $request->line);
            }

            // Filter Group Buyer -> idpo
            if ($request->groupbuyer && $request->groupbuyer != 'all') {
                $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');
                $poIds = PurchaseOrder::whereIn('idbuyer', $buyerIds)->pluck('idpo');
                $headerQuery = $headerQuery->whereIn('idpo', $poIds);
            }

            $headerIds = (clone $headerQuery)->pluck('id');
            $headerCount = $headerIds->count();

            // Qty Inspect
            $totInspect = $headerCount * 5;

            // Qty Defect
            $totDefect = InlineDetail::whereIn('inline_header_id', $headerIds)->count();

            // RFT
            $rft = $totInspect > 0
                ? (($totInspect - $totDefect) / $totInspect) * 100
                : 0;

            // WFT
            $wft = $totInspect > 0
                ? ($totDefect / $totInspect) * 100
                : 0;

            // Kondisi warna target
            $target = Param::where('header', 'qc')
                ->where('key', 'rft_inline_target')
                ->value('value');

            $rftTarget = $rft <= $target ? true : false;

           // Top Defect
            $topDefect = InlineDetail::whereIn('inline_header_id', $headerIds)
                ->select('defect_id', DB::raw('count(*) as total'))
                ->groupBy('defect_id')
                ->orderByDesc('total')
                ->limit(3)
                ->get();

            $defectIds = $topDefect->pluck('defect_id');

            $masterQcDefects = QCDefect::whereIn('kddefect', $defectIds)
                ->pluck('deskripsi', 'kddefect');

            $topDefect = $topDefect->map(function ($item, $index) use ($masterQcDefects, $totDefect) {
                $colors = [
                    '#2F80ED',
                    '#219653',
                    '#F2C94C'
                ];

                $percent = $totDefect > 0
                    ? ($item->total / $totDefect) * 100
                    : 0;

                return [
                    'defect_id' => $item->defect_id,
                    'nmdefect'  => $masterQcDefects[$item->defect_id] ?? '-',
                    'total'     => $item->total,
                    'percent'   => number_format($percent, 2),
                    'color'     => $colors[$index],
                ];
            });

        return [
            'periode'     => [
                'from' => $dta->format('d-m-Y'),
                'to'   => $dtb->format('d-m-Y'),
            ],
            'tot_inspect' => $totInspect,
            'tot_defect'  => $totDefect,
            'rft'         => number_format($rft,2),
            'wft'         => number_format($wft,2),
            'target'      => $rftTarget,
            'top_defect'  => $topDefect
        ];
    }

