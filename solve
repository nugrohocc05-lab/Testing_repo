<script>
    $(document).ready(function () {
        let savedTime = localStorage.getItem('lastDataUpdate');
        if (savedTime) {
            $('#liveClock2').html(savedTime);
        }
    });

    var QP_DESKTOP_BREAKPOINT = 992;

    function qpIsDesktop() {
        return window.innerWidth >= QP_DESKTOP_BREAKPOINT;
    }

    function qpAdjustDashboardHeight() {
        var wrap = document.getElementById('dashboardWrap');
        if (!wrap) return;

        if (!qpIsDesktop()) {
            wrap.classList.remove('is-kiosk');
            wrap.style.height = 'auto';
            return;
        }

        wrap.classList.add('is-kiosk');
        wrap.style.height = 'auto';

        var top = wrap.getBoundingClientRect().top;
        var available = window.innerHeight - top;

        wrap.style.height = Math.max(available - 8, 300) + 'px';
    }

    function qpEscapeHtml(str) {
        return String(str).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    function qpBuildRowHtml(name, totInspect, rft, wft, totDefect, oilDefect) {

        var more3DefectColor = '#BD3F3F3D';
        var defectColor      = '#F9A51D40';
        var noDefectColor    = '#1D9A5C3B';
        var oilDefectColor   = '#1744B740';

        // class kosong default, nanti diisi 'is-active' sesuai kondisi
        var more3Class = '';
        var defectClass = '';
        var noDefectClass = '';
        var oilClass = '';

        if (oilDefect && totDefect > 3) {
            more3DefectColor = '#BD3F3F';
            oilDefectColor   = '#1744B7';
            more3Class = 'is-active';
            oilClass   = 'is-active';
        } else if (oilDefect) {
            oilDefectColor = '#1744B7';
            oilClass = 'is-active';
        } else if (totDefect >= 3) {
            more3DefectColor = '#BD3F3F';
            more3Class = 'is-active';
        } else if (totDefect > 0) {
            defectColor = '#F9A51D';
            defectClass = 'is-active';
        } else {
            noDefectColor = '#1D9A5C';
            noDefectClass = 'is-active';
        }

        return '' +
            '<div class="qp-grid px-2 px-lg-4">' +

                '<span class="bg-card-line rounded-3 d-flex justify-content-center align-items-center">' +
                    name +
                '</span>' +

                '<span class="bg-card-line rounded-3 d-flex justify-content-center align-items-center text-center">' +
                    totInspect +
                '</span>' +

                '<span class="bg-card-line rounded-3 d-flex justify-content-center align-items-center">' +
                    rft +
                '</span>' +

                '<span class="bg-card-line rounded-3 d-flex justify-content-center align-items-center">' +
                    wft +
                '</span>' +

                '<div class="bg-card-line rounded-3 tls-cell">' +

                    // More 3 Defect
                    '<span class="number-circle ' + more3Class + '" style="background-color: ' +
                        more3DefectColor +
                    ';"></span>' +

                    // 1-2 Defect
                    '<span class="number-circle ' + defectClass + '" style="background-color: ' +
                        defectColor +
                    ';"></span>' +

                    // No Defect
                    '<span class="number-circle ' + noDefectClass + '" style="background-color: ' +
                        noDefectColor +
                    ';"></span>' +

                    // Oil Defect
                    '<span class="number-circle ' + oilClass + '" style="background-color: ' +
                        oilDefectColor +
                    ';"></span>' +

                '</div>' +

            '</div>';
    }

    // Ukur tinggi baris SESUNGGUHNYA dari DOM, dan gap antar baris secara
    // terpisah — supaya rumus kapasitas bisa dihitung dengan benar
    // (baris terakhir tidak butuh gap tambahan di bawahnya).
    function qpMeasureRowMetrics(container) {
        var probe = document.createElement('div');
        probe.style.visibility = 'hidden';
        probe.style.position = 'absolute';
        probe.style.pointerEvents = 'none';
        probe.innerHTML = qpBuildRowHtml('Probe', 0, 0, 0, 0, false);
        container.appendChild(probe);

        var rowEl = probe.firstElementChild;
        var rowHeight = rowEl.getBoundingClientRect().height;

        var computed = getComputedStyle(container);
        var gapValue = parseFloat(computed.rowGap || computed.gap || '0');
        if (isNaN(gapValue)) gapValue = 0;

        container.removeChild(probe);

        return {
            rowHeight: rowHeight > 0 ? rowHeight : 50,
            gap: gapValue
        };
    }

    function qpRenderRows() {
        var dataEl    = document.getElementById('qpRowData');
        var leftList  = document.getElementById('qpListLeft');
        var rightList = document.getElementById('qpListRight');

        if (!dataEl || !leftList || !rightList) return;

        var rows = [];

        try {
            rows = JSON.parse(dataEl.textContent || '[]');
        } catch (e) {
            rows = [];
        }

        leftList.innerHTML  = '';
        rightList.innerHTML = '';

        if (!qpIsDesktop()) {
            leftList.innerHTML = rows.map(function (r) {
                return qpBuildRowHtml(
                    qpEscapeHtml(r.namagroup),
                    r.tot_inspect, r.rft, r.wft, r.tot_defect, r.oil_defect
                );
            }).join('');

            return;
        }

        var metrics = qpMeasureRowMetrics(leftList);
        var availableHeight = leftList.clientHeight;

        // +gap di pembilang: kompensasi karena baris TERAKHIR tidak butuh
        // gap tambahan di bawahnya, jadi rumus polos (tanpa +gap) selalu
        // kehitung kurang 1 baris dari kapasitas sebenarnya.
        var capacity = Math.max(
            1,
            Math.floor((availableHeight + metrics.gap) / (metrics.rowHeight + metrics.gap))
        );

        var leftRows  = rows.slice(0, capacity);
        var rightRows = rows.slice(capacity);

        leftList.innerHTML = leftRows.map(function (r) {
            return qpBuildRowHtml(
                qpEscapeHtml(r.namagroup),
                r.tot_inspect, r.rft, r.wft, r.tot_defect, r.oil_defect
            );
        }).join('');

        rightList.innerHTML = rightRows.map(function (r) {
            return qpBuildRowHtml(
                qpEscapeHtml(r.namagroup),
                r.tot_inspect, r.rft, r.wft, r.tot_defect, r.oil_defect
            );
        }).join('');
    }

    var qpResizeTimer = null;
    function qpRefreshLayout() {
        qpAdjustDashboardHeight();
        requestAnimationFrame(qpRenderRows);
    }

    function qpRefreshLayoutDebounced() {
        clearTimeout(qpResizeTimer);
        qpResizeTimer = setTimeout(qpRefreshLayout, 120);
    }

    window.addEventListener('load', qpRefreshLayout);
    window.addEventListener('resize', qpRefreshLayoutDebounced);
    document.addEventListener('DOMContentLoaded', qpRefreshLayout);
</script>
