// Solve bug dropdown
$(document).on('click', '.dropdown-submenu > a', function(e) {
    // Hentikan aksi default agar link tidak memuat ulang halaman
    e.preventDefault();
    e.stopPropagation();

    // Hanya terapkan logika klik ini jika sedang di layar tablet/mobile (<= 767px).
    // Untuk desktop, kita percayakan penuh pada efek Hover dari CSS.
    if ($(window).width() <= 767) {
        const $li = $(this).parent('.dropdown-submenu');
        const isOpen = $li.hasClass('open');

        // Tutup submenu lain yang setingkat (sibling)
        $li.siblings('.dropdown-submenu').removeClass('open');

        // Toggle class 'open'
        if (isOpen) {
            $li.removeClass('open');
        } else {
            $li.addClass('open');
        }
    }
});

// Bersihkan semua class 'open' di submenu ketika dropdown utama ditutup
$('.navbar-nav').on('hidden.bs.dropdown', function() {
    $(this).find('.dropdown-submenu').removeClass('open');
});
