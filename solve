function exportData(Request $request)
    {
        if (!$request->line) {
            return response()->json(['message' => 'Line belum dipilih'], 422);
        }

        preconnect(session('db'));

        $result = $this->buildInlineLtsData($request->line, $request->date);

        $statusLabel = [
            'empty' => '-',
            'none'  => 'No Defect',
            'one'   => '1 Defect',
            'multi' => '2+ Defect',
            'cap'   => 'CAP Filled',
        ];

        // Kolom pertama = Round, sisanya = nama operator (sesuai urutan sequence_process)
        $headers = array_merge(
            ['Round'],
            $result['operators']->map(function ($op) {
                return $op['nama'] ?? $op['nik'];
            })->toArray()
        );

        $rows = collect($result['rounds'])->map(function ($round) use ($statusLabel) {
            $row = ['Round ' . $round['round']];

            foreach ($round['cells'] as $cell) {
                $row[] = $statusLabel[$cell['status']] ?? '-';
            }

            return $row;
        })->toArray();

        return response()->json([
            'headers'     => $headers,
            'rows'        => $rows,
            'tot_inspect' => $result['tot_inspect'],
            'tot_defect'  => $result['tot_defect'],
            'rft'         => $result['rft'],
            'wft'         => $result['wft'],
        ]);
    }
}