// Defect Aktif (Belum diisi CAP lengkap) per line
$activeDefectMap = SewingOutput::whereDate('date', $date)
    ->whereIn('line', $lineIds)
    ->whereNotNull('defect_code')
    ->where(function ($q) {
        $q->whereNull('problem')
          ->orWhereNull('nik_pic')
          ->orWhereNull('action')
          ->orWhereNull('root_cause');
    })
    ->groupBy('line')
    ->selectRaw('line, COUNT(*) as total')
    ->pluck('total', 'line');

// Oil Defect Aktif (Belum diisi CAP lengkap) per line
$activeOilDefectMap = SewingOutput::whereDate('date', $date)
    ->whereIn('line', $lineIds)
    ->where('is_qc', 1)
    ->whereIn('defect_code', [602])
    ->where(function ($q) {
        $q->whereNull('problem')
          ->orWhereNull('nik_pic')
          ->orWhereNull('action')
          ->orWhereNull('root_cause');
    })
    ->groupBy('line')
    ->selectRaw('line, COUNT(*) as total')
    ->pluck('total', 'line');


$activeDefect    = $activeDefectMap[$lineId] ?? 0;
$activeOilDefect = $activeOilDefectMap[$lineId] ?? 0;

return [
    'kodegroup'         => $line->kodegroup,
    'namagroup'         => $line->namagroup,
    'line_id'           => $lineId,
    'tot_inspect'       => $totInspect,
    'tot_defect'        => $totDefect,        // Tetap untuk display/WFT
    'active_defect'     => $activeDefect,     // Untuk logika TLS
    'active_oil_defect' => $activeOilDefect, // Untuk logika TLS
    'oil_defect'        => $oilDefect,
    'defect_not_oil'    => $defectNotOil,
    'rft'               => $rft,
    'wft'               => $wft,
    'mp'                => $mp,
    'line_off'          => $lineOff,
    'mps_off'           => $mpsOff,
];


if (!$isOff) {
    $activeDefect    = $d['active_defect'] ?? 0;
    $activeOilDefect = $d['active_oil_defect'] ?? 0;

    // 1. Oil defect aktif >= 10 -> Merah & Biru aktif bersamaan
    if ($activeOilDefect >= 10) {
        $more3Color = '#ff0404';
        $more3Class = 'is-active';

        $oilColor   = '#0000FF';
        $oilClass   = 'is-active';

    // 2. Defect aktif > 3 -> Merah
    } elseif ($activeDefect > 3) {
        $more3Color = '#ff0404';
        $more3Class = 'is-active';

    // 3. Defect aktif 1 - 3 -> Kuning
    } elseif ($activeDefect >= 1) {
        $defectColor = '#fff133';
        $defectClass = 'is-active';

    // 4. Tidak ada defect aktif (termasuk jika semua defect lama sudah di-CAP) -> Hijau
    } else {
        $noDefectColor = '#3dff2c';
        $noDefectClass = 'is-active';
    }
}
