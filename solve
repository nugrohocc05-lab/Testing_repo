// SATU-SATUNYA SCRIPT UNTUK SUBMENU (Desktop & Mobile)
$(document).on('click', '.dropdown-submenu > a', function(e) {
    e.preventDefault();
    e.stopPropagation();

    var $submenu = $(this).parent('.dropdown-submenu');
    var isOpen = $submenu.hasClass('open');

    // Tutup semua submenu lain yang sejajar (opsional, agar rapi)
    $submenu.siblings('.dropdown-submenu').removeClass('open');

    // Toggle (Buka/Tutup) submenu yang sedang diklik
    if (isOpen) {
        $submenu.removeClass('open');
    } else {
        $submenu.addClass('open');
    }
});

// Pastikan semua submenu tertutup saat dropdown utama ditutup
$('.navbar-nav').on('hidden.bs.dropdown', function() {
    $(this).find('.dropdown-submenu').removeClass('open');
});

// Menutup navbar saat area di luar navbar diklik (Fix tambahan untuk mobile)
$(document).on('click', function (e) {
    var $navbar = $('#navbar-collapse');
    var $toggle = $('.navbar-toggle');

    if (!$navbar.is(e.target) && $navbar.has(e.target).length === 0 &&
        !$toggle.is(e.target) && $toggle.has(e.target).length === 0) {
        if ($navbar.hasClass('in')) {
            $navbar.collapse('hide');
        }
    }
});
