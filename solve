/* Wrapper untuk scroll horizontal */
.table-scroll-wrapper {
    overflow-x: auto;
    overflow-y: auto;
    width: 100%;
    height: 100%;
}

#datalist {
    /* HAPUS table-layout: fixed, ganti jadi auto supaya kolom bisa selebar isinya */
    table-layout: auto;
    width: max-content; /* biar tabel melebar sesuai jumlah kolom, bukan dipaksa 100% */
    min-width: 100%;
}

#datalist th,
#datalist td {
    min-width: 90px; /* lebar minimum tiap kolom operator, sesuaikan sesuai selera */
    white-space: nowrap;
}

/* Kolom pertama (label ROUND) tetap terlihat saat scroll ke kanan */
#datalist th:first-child,
#datalist td:first-child {
    position: sticky;
    left: 0;
    background-color: #242E3E;
    z-index: 2;
    min-width: 110px;
}

<div class="mt-3 rounded text-white datatable-wrap">
    <div class="col-md-12">
        <div class="table-scroll-wrapper">
            <table id="datalist" class="table table-bordered table-hover round-status-table" width="100%">
                <thead style="background-color: #242E3E;">
                    <tr id="operators">
                        <th class="text-center">OPERATORS</th>
                    </tr>
                </thead>
                <tbody>
                    {{-- diisi dinamis via JS --}}
                </tbody>
            </table>
        </div>
    </div>
</div>