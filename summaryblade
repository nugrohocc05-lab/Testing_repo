function getFilterData($request)
{
    \DB::enableQueryLog();
    $t0 = microtime(true);

    $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
    $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

    $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
    $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

    $headerQuery = InlineHeader::whereBetween('date', [$dta, $dtb]);

    if ($request->line && $request->line != 'all') {
        $headerQuery = $headerQuery->where('group_id', $request->line);
    }

    $debug = [];

    if ($request->groupbuyer && $request->groupbuyer != 'all') {
        $tBuyer = microtime(true);
        $buyerIds = Buyer::query()->where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');
        $debug['buyerIds_count'] = $buyerIds->count();
        $debug['buyerIds_time']  = round((microtime(true) - $tBuyer) * 1000, 2) . ' ms';

        if ($buyerIds->isEmpty()) {
            $headerQuery->whereRaw('1 = 0');
        } else {
            $tPo = microtime(true);
            $poIds = PurchaseOrder::query()->whereIn('idbuyer', $buyerIds)->pluck('idpo');
            $debug['poIds_count'] = $poIds->count();
            $debug['poIds_time']  = round((microtime(true) - $tPo) * 1000, 2) . ' ms';

            if ($poIds->isEmpty()) {
                $headerQuery->whereRaw('1 = 0');
            } else {
                $headerQuery->whereIn('idpo', $poIds);
            }
        }
    }

    // --- Ambil SQL final + bindings sebelum dieksekusi ---
    $debug['final_sql'] = $headerQuery->toSql();
    $debug['final_bindings'] = $headerQuery->getBindings();

    // --- Jalankan EXPLAIN untuk query utama ---
    $bindings = $headerQuery->getBindings();
    $explainSql = 'EXPLAIN ' . $headerQuery->toSql();
    $debug['explain'] = \DB::select($explainSql, $bindings);

    // --- Eksekusi beneran + ukur waktu ---
    $tExec = microtime(true);
    $headerIds = (clone $headerQuery)->pluck('id');
    $debug['headerIds_count'] = $headerIds->count();
    $debug['headerIds_exec_time'] = round((microtime(true) - $tExec) * 1000, 2) . ' ms';

    $debug['total_time'] = round((microtime(true) - $t0) * 1000, 2) . ' ms';
    $debug['query_log'] = \DB::getQueryLog();

    dd($debug);

    // ... sisa kode asli di bawah ini tidak akan pernah tereksekusi selama dd() aktif
}