<script>
document.addEventListener('DOMContentLoaded', function () {

    function renderDonutChart(chartId, passValue, rejectValue, passTextId, rejectTextId, passColor = '#4ade80', rejectColor = '#f87171') {
        const total = passValue + rejectValue;
        const passPct = total > 0 ? ((passValue / total) * 100).toFixed(0) : 0;
        const rejectPct = total > 0 ? ((rejectValue / total) * 100).toFixed(0) : 0;

        if (passTextId && document.getElementById(passTextId)) {
            document.getElementById(passTextId).innerText =
                passValue.toLocaleString('id-ID') + ' (' + passPct + '%)';
        }
        if (rejectTextId && document.getElementById(rejectTextId)) {
            document.getElementById(rejectTextId).innerText =
                rejectValue.toLocaleString('id-ID') + ' (' + rejectPct + '%)';
        }

        const chartDom = document.getElementById(chartId);
        if (!chartDom) return;

        const myChart = echarts.init(chartDom);

        const data = [
            { value: passValue, name: 'PASS', itemStyle: { color: passColor } }
        ];
        if (rejectTextId) {
            data.push({ value: rejectValue, name: 'REJECT', itemStyle: { color: rejectColor } });
        }

        const option = {
            backgroundColor: 'transparent',
            tooltip: {
                trigger: 'item',
                formatter: '{b}: {c} ({d}%)'
            },
            series: [
                {
                    name: 'Inspection Result',
                    type: 'pie',
                    radius: ['50%', '75%'],
                    center: ['51%', '50%'],
                    avoidLabelOverlap: false,
                    label: { show: false },
                    labelLine: { show: false },
                    data: data
                }
            ],
            graphic: [
                {
                    type: 'text',
                    left: 'center',
                    top: '44%',
                    style: {
                        text: total.toLocaleString('id-ID'),
                        textAlign: 'center',
                        fill: '#ffffff',
                        fontSize: 15,
                        fontWeight: 'bold'
                    }
                },
                {
                    type: 'text',
                    left: 'center',
                    top: '58%',
                    style: {
                        text: 'Pcs',
                        textAlign: 'center',
                        fill: '#9ca3af',
                        fontSize: 13
                    }
                }
            ]
        };

        myChart.setOption(option);
        window.addEventListener('resize', () => myChart.resize());
    }

    renderDonutChart('chart-1', 0, 0, 'pass-text-1', 'reject-text-1');
    renderDonutChart('chart-2', 0, 0, 'pass-text-2', null, '#3F3184', '#3F3184'); // OQL - warna ungu
    renderDonutChart('chart-3', 0, 0, 'pass-text-3', 'reject-text-3');

});
</script>

