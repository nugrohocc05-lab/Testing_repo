                        left: 'center',
                        top: '58%',
                        style: {
                            text: 'Pcs',
                            textAlign: 'center',
                            fill: '#9ca3af',
                            fontSize: 13
                        }
                    }
                ]
            };

            myChart.setOption(option);
            window.addEventListener('resize', () => myChart.resize());
        }

        function loadChart(filter) {
