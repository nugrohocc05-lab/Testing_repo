import { reactive, watch, onMounted } from 'vue'
import { useRoute, useRouter } from 'vue-router'

export function useTableFilters(defaultFilters = {}) {
  const route = useRoute()
  const router = useRouter()

  const filters = reactive({ ...defaultFilters })
  let ready = false // biar watch gak nembak waktu load awal

  function loadFromQuery() {
    Object.keys(filters).forEach((key) => {
      const val = route.query[key]
      if (val !== undefined) filters[key] = val
    })
    ready = true
  }

  function syncToQuery() {
    const query = { ...route.query }
    Object.entries(filters).forEach(([key, val]) => {
      if (val === '' || val === null || val === undefined) {
        delete query[key]
      } else {
        query[key] = val
      }
    })
    router.replace({ query })
  }

  onMounted(loadFromQuery)

  watch(filters, () => {
    if (ready) syncToQuery()
  }, { deep: true })

  return { filters, loadFromQuery }
}




