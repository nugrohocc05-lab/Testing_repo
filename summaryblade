        function updateDataTime() {
            let now = new Date();
            let day = String(now.getDate()).padStart(2, '0');
            let month = [
                "January", "February", "March", "April", "May", "June",
                "July", "August", "September", "October", "November", "December"
            ];
            let year = now.getFullYear();
            let hour = String(now.getHours()).padStart(2, '0');
            let minute = String(now.getMinutes()).padStart(2, '0');
            let second = String(now.getSeconds()).padStart(2, '0');

            let formatted = `${day} ${month[now.getMonth()]} ${year} - ${hour} : ${minute} : ${second}`;

            document.getElementById('liveClock').innerHTML = formatted;

            localStorage.setItem('lastDataUpdate', formatted);
        }

        updateDataTime();
        window.updateDataTime = updateDataTime;

        $('#findbtn').on('click', function (e) {
            e.preventDefault();

            currentFilter = {
                groupbuyer: $('#groupbuyer').val(),
                style: $('#selectstyle').val(),
                po: $('#selectpo').val(),
                datea: $('#datea').val(),
                dateb: $('#dateb').val(),
            };

            if (currentFilter.datea == null || currentFilter.datea == '' ||
                currentFilter.dateb == null || currentFilter.dateb == '') {
                swal('Warning!', 'Please select Periode Date first!', 'warning');
                return;
            }

            const start = parseDMY(currentFilter.datea);
            const end = parseDMY(currentFilter.dateb);

            if (start > end) {
                swal('Warning!', 'Start date cannot be later than end date!', 'warning');
                return;
            }

            const diffDays = (end - start) / (1000 * 60 * 60 * 24);

            if (diffDays > 31) {
                swal('Warning!', 'Date Has More Than 31 Days in Range, Cannot View Data.', 'warning');
                return;
            }

            if (currentFilter.groupbuyer == null || currentFilter.groupbuyer == '') {
                swal('Warning!', 'Please select Group Buyer first!', 'warning');
                return;
            }

            if (currentFilter.style == null || currentFilter.style == '') {
                swal('Warning!', 'Please select Style first!', 'warning');
                return;
            }

            if (currentFilter.po == null || currentFilter.po == '') {
                swal('Warning!', 'Please select PO first!', 'warning');
                return;
            }

            hasFiltered = true;
            loadCards(currentFilter);
            loadTable(currentFilter);
            loadTableFinalOver(currentFilter);
            loadChart(currentFilter);
            loadTableTopDefect(currentFilter);
            loadDefectCategoryChart(response);

        });

    });
</script>
