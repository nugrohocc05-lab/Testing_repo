if ($request->groupbuyer && $request->groupbuyer != 'all') {
    $headerQuery->whereIn('idpo', function ($q) use ($request) {
        $q->select('idpo')
          ->from('purchase_order')
          ->whereIn('idbuyer', function ($q2) use ($request) {
              $q2->select('idbuyer')
                 ->from((new Buyer())->getTable())
                 ->where('groupbuyer', $request->groupbuyer);
          });
    });
}