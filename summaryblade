                    show: false
                },
                yAxis: {
                    type: 'value',
                    show: false,
                    min: 0,
                    max: 100
                },
                tooltip: {
                    trigger: 'axis',
                    axisPointer: {
                        type: 'shadow'
                    },
                    formatter: function (params) {
                        const item = params[0];
                        if (!item) {
                            return '';
                        }
                        return `
                            <div>
                                <strong>${item.name}</strong><br>
                                Qty: ${item.name === 'Process'
                                    ? processValue.toLocaleString('id-ID')
                                    : nonProcessValue.toLocaleString('id-ID')
                                }<br>
                                Percentage: ${item.value}%
                            </div>
                        `;
                    }
                },
                series: [
                    {
                        type: 'bar',
                        barWidth: '35%',
                        data: [
                            {
                                value: processPercent.toFixed(0),

                                itemStyle: {
                                    color: '#3b82f6',
                                    borderRadius: [
                                        4,
                                        4,
                                        0,
                                        0
                                    ]
                                }
                            },

