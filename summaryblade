    // Export Inline Lts
    function fetchInlineLtsRaw($line, $date = null)
    {
        preconnect(session('db'));

        $date = $date ? Carbon::parse($date) : Carbon::now();
        $dta = $date->copy()->startOfDay();
        $dtb = $date->copy()->endOfDay();

        $headers = InlineHeader::whereBetween('date', [$dta, $dtb])
            ->where('group_id', $line)
            ->get(['id', 'round', 'sequence_process', 'userid_operator']);

        $headerIds = $headers->pluck('id');
        $headerCount = $headerIds->count();

        $totInspect = $headerCount * 5;
        $totDefect = InlineDetail::whereIn('inline_header_id', $headerIds)->count();

        $rft = $totInspect > 0 ? (($totInspect - $totDefect) / $totInspect) * 100 : 0;
        $wft = $totInspect > 0 ? ($totDefect / $totInspect) * 100 : 0;

        $detailsByHeader = InlineDetail::whereIn('inline_header_id', $headerIds)
            ->get(['inline_header_id', 'problem', 'action', 'rootcause', 'defect_id'])
            ->groupBy('inline_header_id');

        $operatorsMeta = $headers
            ->groupBy('userid_operator')
            ->map(fn($rows) => $rows->sortBy('round')->first())
            ->sortBy('sequence_process')
            ->values();

        $niks = $operatorsMeta->pluck('userid_operator')->unique()->values();
        $employeeNames = Employee::whereIn('nik', $niks)->pluck('name', 'nik');

        $operators = $operatorsMeta->map(function ($h) use ($employeeNames) {
            return [
                'nik'              => $h->userid_operator,
                'nama'             => $employeeNames[$h->userid_operator] ?? null,
                'sequence_process' => $h->sequence_process,
            ];
        })->values();

        $headersByOperatorRound = $headers->groupBy(function ($h) {
            return $h->userid_operator . '-' . $h->round;
        });

        return [
            'date'                   => $date,
            'detailsByHeader'        => $detailsByHeader,
            'operators'              => $operators,
            'headersByOperatorRound' => $headersByOperatorRound,
            'tot_inspect'            => $totInspect,
            'tot_defect'             => $totDefect,
            'rft'                    => number_format($rft, 2),
            'wft'                    => number_format($wft, 2),
            'max_round'              => 5,
            'max_round_actual'       => $headers->max('round') ?? 0,
        ];
    }

    function buildInlineLtsExportData($line, $date = null, $namaline = null)
    {
        $raw = $this->fetchInlineLtsRaw($line, $date);

        $operators              = $raw['operators'];
        $detailsByHeader        = $raw['detailsByHeader'];
        $headersByOperatorRound = $raw['headersByOperatorRound'];

        $allDefectIds = $detailsByHeader
            ->flatten(1)
            ->pluck('defect_id')
            ->filter()
            ->unique()
            ->values();

        $defectMaster = QCDefect::whereIn('kddefect', $allDefectIds)
            ->pluck('deskripsi', 'kddefect');

        $dateFormatted = $raw['date']->format('d F Y');

        $statusLabel = [
            'cap'   => 'CAP Filled',
            'none'  => 'No Defect',
            'one'   => 'Defect Found',
            'multi' => 'Defect Found',
        ];

        $rawRows        = [];
        $maxDefectTypes = 0;

        for ($r = 1; $r <= $raw['max_round_actual']; $r++) {
            foreach ($operators as $op) {
                $key = $op['nik'] . '-' . $r;
                $headerGroup = $headersByOperatorRound->get($key);

                $baseCols = [
                    $dateFormatted,
                    $namaline,
                    $raw['tot_inspect'],
                    $raw['tot_defect'],
                    $raw['rft'] . '%',
                    $raw['wft'] . '%',
                    'Round ' . $r,
                    $op['nama'] ?? $op['nik'],
                ];

                if (!$headerGroup || $headerGroup->isEmpty()) {
                    $rawRows[] = ['base' => $baseCols, 'status' => 'Not Inspected', 'total' => '-', 'defects' => []];
                    continue;
                }

                $hIdsThisCell = $headerGroup->pluck('id');
                $details = collect();
                foreach ($hIdsThisCell as $hid) {
                    $details = $details->merge($detailsByHeader->get($hid, collect()));
                }

                $defectCount = $details->count();
                $hasCap = $details->contains(fn($d) => !empty($d->problem) || !empty($d->action) || !empty($d->rootcause));

                $status = $hasCap
                    ? 'cap'
                    : ($defectCount == 0 ? 'none' : ($defectCount == 1 ? 'one' : 'multi'));

                $inspectionStatus = $statusLabel[$status] ?? '-';

                $defectLabels = $details
                    ->filter(fn($d) => !empty($d->defect_id))
                    ->groupBy('defect_id')
                    ->map(fn($grp, $defectId) => [
                        'count' => $grp->count(),
                        'label' => ($defectMaster[$defectId] ?? '-'),
                    ])
                    ->sortByDesc('count')
                    ->pluck('label')
                    ->values()
                    ->all();

                $maxDefectTypes = max($maxDefectTypes, count($defectLabels));

                $rawRows[] = ['base' => $baseCols, 'status' => $inspectionStatus, 'total' => $defectCount, 'defects' => $defectLabels];
            }
        }

        $defectHeaders = [];
        for ($i = 1; $i <= max($maxDefectTypes, 1); $i++) {
            $defectHeaders[] = 'Defect ' . $i;
        }

        $rows = array_map(function ($row) use ($maxDefectTypes) {
            $defectCols = array_pad($row['defects'], max($maxDefectTypes, 1), '-');
            return array_merge($row['base'], [$row['status'], $row['total']], $defectCols);
        }, $rawRows);

        return [
            'date'           => $dateFormatted,
            'tot_inspect'    => $raw['tot_inspect'],
            'tot_defect'     => $raw['tot_defect'],
            'rft'            => $raw['rft'],
            'wft'            => $raw['wft'],
            'rows'           => $rows,
            'defect_headers' => $defectHeaders,
        ];
    }

    function exportData(Request $request)
    {
        if (!$request->line) {
            return response()->json(['message' => 'Line belum dipilih'], 422);
        }

        preconnect(session('db'));

        $g = (new MasterEmployeeGroup())->getTable();
        $s = (new MasterEmployeeSection())->getTable();

        $groupInfo = MasterEmployeeGroup::select(
                "$g.id as kodegroup", "$g.name as namagroup", "$s.name as namabagian"
            )
            ->join($s, "$s.id", '=', "$g.section_id")
            ->where("$g.id", $request->line)
            ->first();

        $namaline = $groupInfo
            ? $groupInfo->namabagian . ' - ' . $groupInfo->namagroup
            : $request->line;

        $result = $this->buildInlineLtsExportData($request->line, $request->date, $namaline);

        $headers = array_merge(
            ['Date', 'Location', 'Inspect Qty', 'Defect Qty', 'RFT (%)', 'WFT (%)', 'Round', 'Name', 'Inspection Status', 'Total Defect'],
            $result['defect_headers']
        );

        return response()->json([
            'headers'     => $headers,
            'rows'        => $result['rows'],
            'namaline'    => $namaline,
            'date'        => $result['date'],
            'tot_inspect' => $result['tot_inspect'],
            'tot_defect'  => $result['tot_defect'],
            'rft'         => $result['rft'],
            'wft'         => $result['wft'],
        ]);
    }
