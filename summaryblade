// Dipakai: exportData saja
// Menghasilkan qty_inspect, defect_qty, defect_name (gabungan semua nama defect,
// tidak dibatasi jumlahnya), dan breakdown process/non_process per idpo+warna.
private function buildPriorityFinalAdditionalData(Collection $idpoList): Collection
{
    $fi = (new OutputDetailFinalInspection())->getTable();
    $od = (new OutputDetail())->getTable();

    if ($idpoList->isEmpty()) {
        return collect();
    }

    // Expand ke semua idpo dalam family combine_pro yang sama (termasuk idpo lama
    // hasil reroute), karena record final inspection bisa nempel di idpo lama
    // sementara $idpoList di sini adalah idpo AKTIF (pasca reroute).
    $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
        ->pluck('combine_pro')->filter()->unique()->values();

    $allHistoryIdpo = $combineProList->isEmpty()
        ? $idpoList
        : HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
            ->pluck('idpo')->filter()->unique()->values();

    // PENTING: jangan exclude defect_code 800/900 di query dasar ini.
    // qty_inspect harus menghitung SEMUA record yang sudah date_output,
    // sinkron dengan buildSummaryFilterData()::$totalQtyInspect yang juga
    // tidak exclude 800/900. Exclude 800/900 baru dilakukan khusus untuk
    // menurunkan data defect (lihat $defectRows di bawah).
    $rows = OutputDetailFinalInspection::query()
        ->join($od, "$od.barcode", '=', "$fi.barcode")
        ->whereIn("$od.idpo", $allHistoryIdpo)
        ->whereNotNull("$fi.date_output")
        ->select(
            "$od.idpo",
            "$od.idcolor",
            "$fi.id as fi_id",
            "$fi.barcode",
            "$fi.defect_code"
        )
        ->distinct()
        ->get();

    // Remap tiap baris ke idpo aktif (hasil reroute) SEBELUM grouping,
    // supaya data yang nempel di idpo lama tetap tergabung ke PO yang benar.
    $rows = $rows->map(function ($r) {
        $active = $this->remapToReroutedIdpo(collect([(string) $r->idpo]))->first();
        $r->idpo = $active ?: $r->idpo;
        return $r;
    });

    $keyOf = fn ($r) => $r->idpo . '|' . $r->idcolor;

    // qty_inspect: SEMUA fi_id unik yang sudah date_output (termasuk grade 800/900)
    $qtyInspectMap = $rows->groupBy($keyOf)
        ->map(fn ($g) => $g->pluck('fi_id')->unique()->count());

    // defect "beneran": defect_code terisi DAN bukan kode grade 800/900
    // (samakan dengan logic exclude di topDefects())
    $defectRows = $rows->filter(function ($row) {
        return !is_null($row->defect_code)
            && !in_array((string) $row->defect_code, ['800', '900'], true);
    });

    $defectQtyMap = $defectRows->groupBy($keyOf)
        ->map(fn ($g) => $g->pluck('fi_id')->unique()->count());

    $defectCodes = $defectRows->pluck('defect_code')->filter()->unique()->values();
    $defectNames = QCDefect::whereIn('kdcacat', $defectCodes)->pluck('deskripsi', 'kdcacat');
    $defectCategories = QCDefect::whereIn('kdcacat', $defectCodes)->pluck('category', 'kdcacat');

    // Semua nama defect per idpo+warna (bukan cuma yang paling sering), diurutkan
    // dari yang paling banyak muncul lalu digabung jadi satu string.
    $defectNameMap = $defectRows
        ->groupBy($keyOf)
        ->map(function ($g) use ($defectNames) {
            return $g->groupBy('defect_code')
                ->sortByDesc(fn ($items) => $items->count())
                ->keys()
                ->map(fn ($code) => $defectNames->get($code) ?: $code)
                ->implode(', ');
        });

    // Jumlah defect (dihitung per fi_id unik) yang tergolong process vs non-process
    $processMap = collect();
    $nonProcessMap = collect();
    foreach ($defectRows->groupBy($keyOf) as $key => $g) {
        $process = 0;
        $nonProcess = 0;
        foreach ($g->groupBy('fi_id') as $fiRows) {
            $category = (int) $defectCategories->get($fiRows->first()->defect_code, 0);
            $category === 1 ? $process++ : $nonProcess++;
        }
        $processMap->put($key, $process);
        $nonProcessMap->put($key, $nonProcess);
    }

    $result = collect();
    foreach ($qtyInspectMap as $key => $qty) {
        $result->put($key, [
            'qty_inspect' => $qty,
            'defect_qty' => $defectQtyMap->get($key, 0),
            'defect_name' => $defectNameMap->get($key, '-'),
            'process' => $processMap->get($key, 0),
            'non_process' => $nonProcessMap->get($key, 0),
        ]);
    }
    return $result;
}