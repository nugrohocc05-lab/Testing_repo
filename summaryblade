        function renderDonutChart(chartId, passValue, rejectValue, totalValue ,passTextId, rejectTextId, passColor = '#4ade80', rejectColor = '#f87171') {
            const total = totalValue;
            const passPct = total > 0 ? ((passValue / total) * 100).toFixed(0) : 0;
            const rejectPct = total > 0 ? ((rejectValue / total) * 100).toFixed(0) : 0;

            if (passTextId && document.getElementById(passTextId)) {
                document.getElementById(passTextId).innerText =
                    passValue.toLocaleString('id-ID') + ' (' + passPct + '%)';
            }
            if (rejectTextId && document.getElementById(rejectTextId)) {
                document.getElementById(rejectTextId).innerText =
                    rejectValue.toLocaleString('id-ID') + ' (' + rejectPct + '%)';
            }

            const chartDom = document.getElementById(chartId);
            if (!chartDom) return;

            const myChart = echarts.init(chartDom);

            const data = [
                { value: passValue, name: 'PASS', itemStyle: { color: passColor } }
            ];
            if (rejectTextId) {
                data.push({ value: rejectValue, name: 'REJECT', itemStyle: { color: rejectColor } });
            }

            const option = {
                backgroundColor: 'transparent',
                tooltip: {
                    trigger: 'item',
                    formatter: '{b}: {c} ({d}%)'
                },
                series: [
                    {
                        name: 'Inspection Result',
                        type: 'pie',
                        radius: ['50%', '75%'],
                        center: ['51%', '50%'],
                        avoidLabelOverlap: false,
                        label: { show: false },
                        labelLine: { show: false },
                        data: data
                    }
                ],
                graphic: [
                    {
                        type: 'text',
                        left: 'center',
                        top: '44%',
                        style: {
                            text: total.toLocaleString('id-ID'),
                            textAlign: 'center',
                            fill: '#ffffff',
                            fontSize: 15,
                            fontWeight: 'bold'
