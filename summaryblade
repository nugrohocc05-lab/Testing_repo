function buildInlineLtsData($line, $date = null)
{
    $raw = $this->fetchInlineLtsRaw($line, $date);

    $operators              = $raw['operators'];
    $detailsByHeader        = $raw['detailsByHeader'];
    $headersByOperatorRound = $raw['headersByOperatorRound'];

    // Hitung status per operator, berurutan dari round 1 -> max, sambil bawa histori
    $statusByOperatorRound = [];

    foreach ($operators as $op) {
        $okStreak     = 0;
        $everHadIssue = false;

        for ($r = 1; $r <= $raw['max_round']; $r++) {
            $key = $op['nik'] . '-' . $r;
            $headerGroup = $headersByOperatorRound->get($key);

            if (!$headerGroup || $headerGroup->isEmpty()) {
                // Round kosong -> dilewati, tidak mempengaruhi state
                $statusByOperatorRound[$op['nik']][$r] = 'empty';
                continue;
            }

            $hIdsThisCell = $headerGroup->pluck('id');
            $details = collect();
            foreach ($hIdsThisCell as $hid) {
                $details = $details->merge($detailsByHeader->get($hid, collect()));
            }

            $defectCount = $details->count();
            $hasCap = $details->contains(function ($d) {
                return !empty($d->problem) || !empty($d->action) || !empty($d->rootcause);
            });

            if ($defectCount > 0) {
                // Defect baru -> merah, chain diulang dari awal
                $status = $defectCount == 1 ? 'one' : 'multi';
                $okStreak     = 0;
                $everHadIssue = true;
            } elseif ($hasCap) {
                // CAP diisi round ini -> tetap merah + pensil
                $status = 'capped';
                $okStreak     = 0;
                $everHadIssue = true;
            } else {
                // Round bersih (tidak ada defect & tidak ada cap)
                if ($everHadIssue) {
                    $okStreak++;
                    if ($okStreak == 1) {
                        $status = 'recovering'; // kuning, oke pertama setelah issue
                    } else {
                        $status = 'none'; // hijau, sudah 2x oke berturut-turut
                        $everHadIssue = false; // balik ke baseline normal
                    }
                } else {
                    $status = 'none'; // baseline hijau, memang belum pernah ada masalah
                }
            }

            $statusByOperatorRound[$op['nik']][$r] = $status;
        }
    }

    // Susun ulang jadi struktur per-round (untuk tabel)
    $rounds = [];
    for ($r = 1; $r <= $raw['max_round']; $r++) {
        $cells = [];
        $roundHasDefect = false;
        $roundHasCap    = false;

        foreach ($operators as $op) {
            $status = $statusByOperatorRound[$op['nik']][$r] ?? 'empty';
            $cells[] = ['status' => $status];

            if (in_array($status, ['one', 'multi'])) $roundHasDefect = true;
            if ($status === 'capped') $roundHasCap = true;
        }

        $rounds[] = [
            'round'      => $r,
            'cells'      => $cells,
            'has_defect' => $roundHasDefect,
            'has_cap'    => $roundHasCap,
        ];
    }

    return [
        'tot_inspect' => $raw['tot_inspect'],
        'tot_defect'  => $raw['tot_defect'],
        'rft'         => $raw['rft'],
        'wft'         => $raw['wft'],
        'operators'   => $operators,
        'rounds'      => $rounds,
    ];
}



$statusIcon = [
    'none'       => '<img src="' . _asset('svg/inlinePerformance/checklist.svg') . '" alt="No Defect">',
    'one'        => '',
    'multi'      => '<img src="' . _asset('svg/inlinePerformance/defect2.svg') . '" alt="Multi Defect">',
    'capped'     => '<img src="' . _asset('svg/inlinePerformance/pencil-white.svg') . '" alt="CAP Filled">',
    'recovering' => '',
];


.status-none        { background-color: #219653; }
.status-one,
.status-multi       { background-color: #F24C4C; }
.status-capped      { background-color: #F24C4C; }  /* merah + pensil */
.status-recovering  { background-color: #F9E21D; }  /* kuning, oke pertama setelah issue */