// router/index.js (paling bawah, sebelum export default router)
import { useKeepAlive } from '@/stores/keepAlive'

router.beforeEach((to, from) => {
  // butuh cara akses pinia di luar komponen — lihat catatan di bawah
  const keepAliveStore = useKeepAlive()

  const fromGroup = from.meta?.keepAliveGroup
  const toGroup = to.meta?.keepAliveGroup

  // keluar dari grup -> hapus cache komponen asal
  if (fromGroup && fromGroup !== toGroup) {
    const fromComponentName = from.matched[0]?.components?.default?.name
    if (fromComponentName) keepAliveStore.remove(fromComponentName)
  }

  // masuk ke halaman yang perlu di-cache -> daftarkan
  if (to.meta?.keepAlive) {
    const toComponentName = to.matched[0]?.components?.default?.name
    if (toComponentName) keepAliveStore.add(toComponentName)
  }
})

export default router




