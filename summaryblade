       let defectCategoryChart = null;
        function renderDefectCategoryChart(
            chartId,
            processValue,
            nonProcessValue,
            processPercent,
            nonProcessPercent,
            processTextId,
            nonProcessTextId
        ) {

            processValue = Number(processValue) || 0;
            nonProcessValue = Number(nonProcessValue) || 0;
            processPercent = Number(processPercent) || 0;
            nonProcessPercent = Number(nonProcessPercent) || 0;

            const processText = document.getElementById(processTextId);

            if (processText) {
                processText.innerText =
                    processValue.toLocaleString('id-ID') +
                    ' (' +
                    processPercent.toFixed(0) +
                    '%)';
            }

            const nonProcessText = document.getElementById(nonProcessTextId);

            if (nonProcessText) {
                nonProcessText.innerText =
                    nonProcessValue.toLocaleString('id-ID') +
                    ' (' +
                    nonProcessPercent.toFixed(0) +
                    '%)';
            }

            const chartDom = document.getElementById(chartId);

            if (!chartDom) {
                return;
            }

            if (defectCategoryChart) {
                defectCategoryChart.dispose();
                defectCategoryChart = null;
            }

            defectCategoryChart = echarts.init(chartDom);
            const option = {

                backgroundColor: 'transparent',

                grid: {
                    left: '10%',
                    right: '10%',
                    top: '20%',
                    bottom: '5%',
                    containLabel: false
                },
