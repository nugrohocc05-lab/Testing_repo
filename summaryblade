<?php

namespace App\Http\Models;

use App\Http\Models\Main\MasterEmployeeGroup;
use App\Http\Models\Main\QCDefect;
use App\Http\Models\OutputDetail;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Support\Facades\Validator;

class SewingOutput extends Model
{
    protected $connection = 'mysql';

    protected $guarded = [];

    const UPDATED_AT = null;

    private $rules = [
        'barcode' => 'required|string|max:16',
        'line' => 'required|string|max:4',
    ];

    public function validation($data)
    {
        $validator = Validator::make($data, $this->rules);
        return $validator;
    }

    public function save(array $options = [])
    {
        $this->user_id = session('user')->nik ?? null;
        return parent::save($options);
    }

    function groupbagian()
    {
        return $this->belongsTo(MasterEmployeeGroup::class, 'line', 'id');
    }

    function outputdetail()
    {
        return $this->belongsTo(OutputDetail::class, 'barcode', 'barcode');
    }

    function defect()
    {
        return $this->belongsTo(QCDefect::class, 'defect_code', 'kdcacat');
    }
}
