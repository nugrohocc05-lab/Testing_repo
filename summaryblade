<script>
    $(document).on('click', '.loading-target', function (e) {
        e.preventDefault();
        const targetUrl = $(this).attr('href');

        $('#loading').show();

        setTimeout(function () {
            window.location.href = targetUrl;
        }, 100);

        window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
                $('#loading').hide();
            }
        });
    });
</script>
