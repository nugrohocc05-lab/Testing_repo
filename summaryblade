        <UiCard class="mt-5">
            <div class="flex">
                <div class="text-2xl">Status History</div>
                <div class="w-50 flex ml-auto mb-2">
                    <UiInput v-model="searchKeywordStatus" placeholder="Search" class="w-full rounded-lg">
                        <template #prefix>
                            <MagnifyingGlassIcon class="h-5 w-5 text-gray-400" />
                        </template>
                    </UiInput>
                </div>
            </div>
            <UiAgGrid class="my-zebra-grid" :rowData="rawDataStatus" :columnDefs="columnDefsStatus" 
                :quickFilterText="searchKeywordStatus" :defaultColDef="defaultColDef"></UiAgGrid>
        </UiCard>
    </div>
</template>

<script setup>
import { decrypt } from "@/utils/crypto";
import { ref, onMounted} from "vue";
import { useRouter, useRoute } from "vue-router";
import { useLoadingStore } from "@/stores/loading";
import { MagnifyingGlassIcon, ArrowLeftStartOnRectangleIcon } from "@heroicons/vue/24/outline";

import UiButton from "@/components/ui/UiButton.vue"
import UiInput from "@/components/ui/UiInput.vue"
import UiCard from "@/components/ui/UiCard.vue"
import UiTitle from "@/components/ui/UiTitle.vue"
import UiGrid from "@/components/ui/UiGrid.vue";
import UiAgGrid from "@/components/ui/UiAgGrid.vue";

import api from "@/services/api";

const loading = useLoadingStore();
const router = useRouter();
const route = useRoute();
const rawDataBreakdown = ref([]);
const rawDataPO = ref([]);
const rawDataOrderAllocation = ref([]);
const rawDataStatus = ref([]);
const searchKeyword = ref('')
const searchKeywordStatus = ref('')

const encryptedPo = route.params.po;
const decodedPo = decodeURIComponent(encryptedPo);
const po = decrypt(decodedPo);

const defaultColDef = {
    sortable: true,
    filter: false,
    resizable: true,
};

const columnDefs = [
    {
        headerName: "No",
        field: "no",
        width: 80,
        filter: false,
        resizable: false,
    },
    {
        field: "po",
        headerName: "PO",
        minWidth: 125,
        sortable: false,
        flex: 1,
    },
    {
        field: "color",
        headerName: "Color",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "size",
        headerName: "Size",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "quantity",
        headerName: "Quantity",
        minWidth: 125,
        flex: 1,
    },
];

const columnDefsStatus = [
    {
        field: "no",
        headerName: "No",
        width: 80,
        filter: false,
        resizable: false,
    },
    {
        field: "user",
        headerName: "User",
        minWidth: 125,
        sortable: false,
        flex: 1,
    },
    {
        field: "factory",
        headerName: "Factory",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "status",
        headerName: "Status",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "datetime",
        headerName: "Date",
        minWidth: 125,
        flex: 1,
    },
];

const loadData = async () => {
    try {
        loading.show();
        const endpoint = `/api/v1/order-alocation/getDataDetail/${po}`;

        const { data } = await api.get(endpoint);
        rawDataBreakdown.value = data?.data.breakdown ?? [];
        rawDataBreakdown.value = (data?.data.breakdown ?? []).map((item, index) => ({
            ...item,
            no: index + 1,
        }));
        rawDataStatus.value = data?.data.status_history ?? [];
        rawDataStatus.value = (data?.data.status_history ?? []).map((item, index) => ({
            ...item,
            no: index + 1,
        }));
        rawDataPO.value = data?.data.purchase_order ?? [];
        rawDataOrderAllocation.value = data?.data.orderallocation ?? [];
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

onMounted(() => {
