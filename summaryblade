<script setup>
import { exportToPdf } from '@/utils/pdfExporter';
import { exportToExcel } from "@/utils/excelExporter";
import { getCurrentDateTime } from '@/utils/date';
import { encrypt } from "@/utils/crypto";

import { ref, onMounted, computed, defineComponent, h } from "vue";
import { useRouter } from "vue-router";
import { useLoadingStore } from "@/stores/loading";
import { InformationCircleIcon, XCircleIcon, MagnifyingGlassIcon, DocumentArrowUpIcon, DocumentTextIcon }
    from "@heroicons/vue/24/outline";

import { customSwal } from "@/composable/customSwal";
const { confirm, success, warning, error } = customSwal;
const { datetime } = getCurrentDateTime('-', '-');

import UiButton from "@/components/ui/UiButton.vue"
import UiInput from "@/components/ui/UiInput.vue"
import UiModal from "@/components/ui/UiModal.vue"
import UiTitle from "@/components/ui/UiTitle.vue"
import UiMultiSelect from "@/components/ui/UiMultiSelect.vue"
import UiAgGrid from '@/components/ui/UiAgGrid.vue';

import api from "@/services/api";

defineOptions({
    name: "Allocation",
});

const loading = useLoadingStore();
const router = useRouter();
const rawData = ref([]);
const buyers = ref([]);
const data_kp = ref([]);
const dataSelected = ref([]);
const ListKK = ref([]);
const isNewData = ref(false)
const showModal = ref(false)
const searchKeyword = ref('')
const originalForm = ref(null)
const gridApi = ref(null);

const confimForm = ref({
    auth_pass: "",
    description: "",
});

const form = ref({
    buyer: "",
    kpno: "",
});

const isFormChanged = computed(() => {
    if (!originalForm.value) return false

    return Object.keys(confimForm.value).some(
        key => confimForm.value[key] !== originalForm.value[key]
    )
})

const onGridReady = (params) => {
    gridApi.value = params.api;
};

const onGridSizeChanged = () => {
    ListKK.value = [];
}

const onPaginationChanged = () => {
    ListKK.value = [];
};

const onBodyScroll = () => {
    ListKK.value = [];
}

const onBtnExport = () => {
    if (!gridApi.value) {
        alert("Please Wait!");
        return;
    }

    const fileName = `orders-allocation-${datetime.replace(' ', '_')}.xlsx`;
    exportToExcel({
        title: `Orders Allocation Report ${datetime}`,
        fileName: fileName,
        sheetName: "Orders Allocation",
        headers: ["NO","KK", "KP", "PO", "COMBINE_PRO", "PO_CMT", "STYLE", "DELIVERY_DATE", "CM_VACTORY", "QTY", "STATUS"  ], 
        fields: ["no","kk", "kpno", "po", "combine_pro", "po_sap", "style", "deliverydate", "factory", "total", "orderstatus.status", ], 
        gridData: gridApi
    });
};

const onBtnExportPdf = () => {
    if (!gridApi.value) {
        alert("Please Wait!");
        return;
    }

    const nameFile = `orders-allocation-${datetime.replace(' ', '_')}`;
    exportToPdf({
        title: `Orders Allocation Report ${datetime}`,
        fileName: `${nameFile}`,
        headers: ["NO","KK", "KP", "PO", "Combine PRO", "PO CMT", "STYLE", "DELIVERY DATE", "CM FACTORY", "TOTAL", "STATUS"],
        fields: ["no", "kk", "kpno", "po", "combine_pro", "po_sap", "style", "deliverydate", "factory", "total", "orderstatus.status"],
        gridData: gridApi,
        orientation: 'l'
    });
};

const setNewFilter = () => {
    form.value = {
        kpno: "",
        buyer: "",
    };
}

const setNewForm = () => {
    confimForm.value = {
        password: "",
        description: "",
    };

    originalForm.value = { ...confimForm.value }
    showModal.value = true
};

const closeModal = () => {
    showModal.value = false;
    isNewData.value = false;
};

const ActionRenderer = defineComponent({
    props: {
        params: {
            type: Object,
            required: true,
        },
    },
    
    setup(props) {

        const detailData = () => {
            dataSelected.value = props.params.data;
            
            const po = dataSelected.value.po;
            const encryptedPo = encrypt(po);
            router.push({
                name: "order-allocation-detail",
                params: {
                    po: encodeURIComponent(encryptedPo),
                },
            });
        };

        const rejectData = () => {
            dataSelected.value = props.params.data;
            setNewForm();
            showModal.value = true;
        };

        const processData = () => {
            dataSelected.value = props.params.data;

            const idorder = dataSelected.value.idorder;
            const encryptedIDOrder = encrypt(idorder);
            router.push({
                name: "order-allocation-process",
                params: {
                    idorder: encodeURIComponent(encryptedIDOrder),
                },
            })
        };

        if(props.params.data.orderstatus.status != "Rejected" && !ListKK.value.includes(props.params.data.kk)){

            if(!ListKK.value.includes(props.params.data.kk)){
                ListKK.value.push(props.params.data.kk);
            }

            return () =>
                h(
                    "div",
                    {
                        class: "flex h-full gap-2",
                    },
                    [
                        h(
                            "button",
                            {
                                type: "button",
                                title: "Detail",
                                class:
                                    "cursor-pointer text-amber-500 transition hover:text-amber-700",
                                onClick: detailData,
                            },
                            [
                                h(InformationCircleIcon, {
                                    class: "h-5 w-5",
                                }),
                            ],
                        ),
                        h(
                            "button",
                            {
                                type: "button",
                                title: "Process",
                                class: "cursor-pointer text-cyan-500 hover:text-cyan-700",
                                onClick: processData,
                            },
                            [
                                h(DocumentArrowUpIcon, {
                                    class: "h-5 w-5",
                                }),
                            ],
                        ),
                        h(
                            "button",
                            {
                                type: "button",
                                title: "Reject",
                                class: "cursor-pointer text-red-500 hover:text-red-700",
                                onClick: rejectData,
                            },
                            [
                                h(XCircleIcon, {
                                    class: "h-5 w-5",
                                }),
                            ],
                        ),
                    ],
                );
        }else if(props.params.data.orderstatus.status == "Rejected" && !ListKK.value.includes(props.params.data.kk)){
            if(!ListKK.value.includes(props.params.data.kk)){
                ListKK.value.push(props.params.data.kk);
            }

            return () =>
                h(
                    "div",
                    {
                        class: "flex h-full gap-2",
                    },
                    [
                        h(
                            "button",
                            {
                                type: "button",
                                title: "Detail",
                                class:
                                    "cursor-pointer text-amber-500 transition hover:text-amber-700",
                                onClick: detailData,
                            },
                            [
                                h(InformationCircleIcon, {
                                    class: "h-5 w-5",
                                }),
                            ],
                        ),
                        h(
                            "button",
                            {
                                type: "button",
                                title: "Process",
                                class: "cursor-pointer text-cyan-500 hover:text-cyan-700",
                                onClick: processData,
                            },
                            [
                                h(DocumentTextIcon, {
                                    class: "h-5 w-5",
                                }),
                            ],
                        ),
                    ],
                );
        }else{
              return () =>
                h(
                    "div",
                    {
                        class: "flex h-full gap-2",
                    },
                    [
                        h(
                            "button",
                            {
                                type: "button",
                                title: "Detail",
                                class:
                                    "cursor-pointer text-amber-500 transition hover:text-amber-700",
                                onClick: detailData,
                            },
                            [
                                h(InformationCircleIcon, {
                                    class: "h-5 w-5",
                                }),
                            ],
                        ),
                    ],
                );
        }
    },
});

