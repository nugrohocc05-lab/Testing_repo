    function groupbuyer(Request $request)
    {
        preconnect(session('db'));

        $q = $request->get('q');

        $data = MasterGroupBuyer::select('id', 'group_name')
            ->when($q, function ($query) use ($q) {
                $query->where('group_name', 'like', '%' . $q . '%');
            })
            ->orderBy('group_name', 'asc')
            ->get()
            ->map(function ($item) {
                return [
                    'id' => $item->id,
                    'text' => $item->group_name
                ];
            });

        return response()->json([
            'results' => $data
        ]);
    }

    function getFilterData($request)
    {
        $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
        $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

        $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
        $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

        $headerQuery = InlineHeader::whereBetween('date', [$dta, $dtb]);

        if ($request->line && $request->line != 'all') {
            $headerQuery = $headerQuery->where('group_id', $request->line);
        }

        // Filter Group Buyer -> idpo
        if ($request->groupbuyer && $request->groupbuyer != 'all') {
            $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');
            $poIds = PurchaseOrder::whereIn('idbuyer', $buyerIds)->pluck('idpo');
            $headerQuery = $headerQuery->whereIn('idpo', $poIds);
        }

        $headerIds = (clone $headerQuery)->pluck('id');
        $headerCount = $headerIds->count();

        // Qty Inspect
        $totInspect = $headerCount * 5;

        // Qty Defect
        $totDefect = InlineDetail::whereIn('inline_header_id', $headerIds)->count();

        // RFT
        $rft = $totInspect > 0
                ? (($totInspect - $totDefect) / $totInspect) * 100
                : 0;

        // WFT
        $wft = $totInspect > 0
                ? ($totDefect / $totInspect) * 100
                : 0;

        // Kondisi warna target
        $target = Param::where('header', 'qc')
            ->where('key', 'rft_inline_target')
            ->value('value');

        $rftTarget = $rft <= $target ? true : false;

        $allDefect = InlineDetail::whereIn('inline_header_id', $headerIds)
            ->select('defect_id', DB::raw('count(*) as total'))
            ->groupBy('defect_id')
            ->orderByDesc('total')
            ->orderBy('defect_id', 'asc')
            ->get();

        $topDefect = $allDefect->take(3);

        $othersTotal = $allDefect->slice(3)->sum('total');


        $defectIds = $topDefect->pluck('defect_id');

        $masterQcDefects = QCDefect::whereIn('kddefect', $defectIds)
            ->pluck('deskripsi', 'kddefect');

        $colors = [
            '#2F80ED',
            '#219653',
            '#F2C94C',
        ];

        $topDefect = $topDefect->values()->map(function ($item, $index) use ($masterQcDefects, $totDefect, $colors) {

            $percent = $totDefect > 0
                    ? ($item->total / $totDefect) * 100
                    : 0;

            return [
                'defect_id' => $item->defect_id,
                'nmdefect'  => $masterQcDefects[$item->defect_id] ?? '-',
                'total'     => $item->total,
                'percent'   => number_format($percent, 2),
                'color'     => $colors[$index],
            ];
        });

            if ($othersTotal > 0) {
                $percentOthers = $totDefect > 0
                    ? ($othersTotal / $totDefect) * 100
                    : 0;

                $topDefect->push([
                    'defect_id' => null,
                    'nmdefect'  => 'Others',
                    'total'     => $othersTotal,
                    'percent'   => number_format($percentOthers, 2),
                    'color'     => '#BDBDBD',
                ]);
            }

        return [
            'periode'     => [
                'from' => $dta->format('d-m-Y'),
                'to'   => $dtb->format('d-m-Y'),
            ],
            'tot_inspect' => $totInspect,
            'tot_defect'  => $totDefect,
            'rft'         => number_format($rft,2),
            'wft'         => number_format($wft,2),
            'target'      => $rftTarget,
            'top_defect'  => $topDefect,
            'line'        => $request->line,
            'group_buyer' => $request->groupbuyer,
        ];
    }

    function filterData(Request $request)
    {
        preconnect(session('db'));

        $data = $this->getFilterData($request);

        return response()->json($data);
    }

    function getInlinePerformanceTable($dateInput = null)
    {
        $date = $dateInput
            ? Carbon::parse($dateInput)
            : Carbon::today();

        $dta = $date->copy()->startOfDay();
        $dtb = $date->copy()->endOfDay();

        $g = (new MasterEmployeeGroup())->getTable();
        $s = (new MasterEmployeeSection())->getTable();

        $lines = MasterEmployeeGroup::select(
                "$g.id as kodegroup", "$g.name as namagroup", "$s.name as namabagian"
            )
            ->join($s, "$s.id", '=', "$g.section_id")
            ->distinct()
            ->whereHas('groupline', function ($q) {
                $q->where('factory_id', session('db')->iddb)
                    ->where('is_show', 1)
                    ->where('is_line', 1);
            })
            ->orderBy("$g.id", "asc")
            ->get();

        $headers = InlineHeader::whereBetween('date', [$dta, $dtb])
            ->get(['id', 'group_id', 'idpo', 'round']);

        $headersByLine = $headers->groupBy('group_id');

        $allHeaderIds = $headers->pluck('id');

        $defectsByHeader = InlineDetail::whereIn('inline_header_id', $allHeaderIds)
            ->get(['inline_header_id', 'problem', 'action', 'rootcause'])
            ->groupBy('inline_header_id');

        $result = $lines->map(function ($line) use ($headersByLine, $defectsByHeader) {
            $headers = $headersByLine->get($line->kodegroup, collect());
            $hIds = $headers->pluck('id');

            $lastRound = $headers->max('round');

            $lastRoundHeaderIds = $headers->where('round', $lastRound)->pluck('id');
            $lastRoundDefectCount = InlineDetail::whereIn('inline_header_id', $lastRoundHeaderIds)->count();
            $lastRoundHasDefect = $lastRoundDefectCount > 0;

            $idpos = $headers->pluck('idpo')->unique();

            $styles = PurchaseOrder::whereIn('idpo', $idpos)->pluck('idstyle')->unique()->values();
            $nmstyles = Style::whereIn('idstyle', $styles)->pluck('nmstyle')->values();

            $totInspect = $hIds->count() * 5;
            $totDefect = $hIds->sum(function ($id) use ($defectsByHeader) {
                return $defectsByHeader->get($id, collect())->count();
            });

            $hasCap = $lastRoundHeaderIds->contains(function ($id) use ($defectsByHeader) {
            return $defectsByHeader->get($id, collect())->contains(function ($detail) {
                return !empty($detail->problem)
                    || !empty($detail->action)
                    || !empty($detail->rootcause);
            });
        });

            $rft = $totInspect > 0 ? (($totInspect - $totDefect) / $totInspect) * 100 : 0;
            $wft = $totInspect > 0 ? ($totDefect / $totInspect) * 100 : 0;

            return [
                'line'                  => $line->namagroup,
                'kodegroup'             => $line->kodegroup,
                'style'                 => $nmstyles->toArray(),
                'qty_rft'               => $totInspect - $totDefect,
                'qty_inspect'           => $totInspect,
                'qty_defect'            => $totDefect,
                'rft'                   => number_format($rft, 2),
                'wft'                   => number_format($wft, 2),
                'last_round'            => $lastRound,
                'last_round_has_defect' => $lastRoundHasDefect,
                'has_cap'               => $hasCap,
            ];
        });

        return [
            'date' => $date->format('Y-m-d'),
            'data' => $result->values(),
        ];
    }

