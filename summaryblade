    <script>
        $(document).ready(function () {

           $(document).ready(function () {
                let savedTime = localStorage.getItem('lastDataUpdate');
                if (savedTime) {
                    $('#liveClock2').html(savedTime);
                }
            });

            let currentLine      = @json($kodegroup ?? null);
            let currentLineLabel = @json($namaline ?? null);
            let currentDate       = @json($date);
            let skipInitialChange = true;

            const formattedDate = new Date(currentDate).toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'long',
                year: 'numeric'
            });

           function formatDate(date) {
                const d = new Date(date);

                const months = [
                    'January', 'February', 'March', 'April', 'May', 'June',
                    'July', 'August', 'September', 'October', 'November', 'December'
                ];

                const day = d.getDate();
                const monthName = months[d.getMonth()];
                const year = d.getFullYear();

                const hours = String(d.getHours()).padStart(2, '0');
                const minutes = String(d.getMinutes()).padStart(2, '0');
                const seconds = String(d.getSeconds()).padStart(2, '0');

                return `${day} ${monthName} ${year}`;
            }

            function updateLiveClock() {
                const now = new Date();

                const formatted = formatDate(now);

                let currentDate = @json($date);

                const dateTime = currentDate ? formatDate(currentDate) : formatted;

                $('#liveClock').text(dateTime);
            }
            updateLiveClock();

            function updateClock() {
                const now = new Date();
                const hour = String(now.getHours()).padStart(2, '0');
                const minute = String(now.getMinutes()).padStart(2, '0');
                const second = String(now.getSeconds()).padStart(2, '0');

                const formatted = `${day} ${month[now.getMonth()]} ${year} - ${hour} : ${minute} : ${second}`;

                const addDate = `${formattedDate} - ${hour} : ${minute} : ${second}`;
                document.getElementById('liveClock').innerHTML = addDate;
            }

            $('#line').select2({
                placeholder: 'Select Line',
                width: '100%',
                ajax: {
                    url: "{{ route('monitoring_inlineperformanceselectline') }}",
                    type: "GET",
                    dataType: "json",
                    delay: 500,
                    data: function (params) {
                        return {
                            q: params.term,
                            page: params.page || 1
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: $.map(data.data, function (item) {
                                return {
                                    id: item.kodegroup,
                                    text: item.namabagian + ' - ' + item.namagroup
                                };
                            }),
                            pagination: {
                                more: data.to < data.total
                            }
                        };
                    },
                    cache: true
                }
            });

            if (currentLine) {
                const preOption = new Option(currentLineLabel, currentLine, true, true);
                $('#line').append(preOption).trigger('change');
            }

            function fetchInlineLts() {
                if (!currentLine) return;

                $('#datatable-container').css('opacity', 0.5);

                $.ajax({
                    url: "{{ route('monitoring_inlineperformance_filterInlineLts') }}",
                    type: "GET",
                    data: { line: currentLine, date: currentDate },
                    success: function (res) {
                        $('#tot_inspect').text(res.tot_inspect);
                        $('#tot_defect').text(res.tot_defect);
                        $('#rft').text(res.rft);
                        $('#wft').text(res.wft);
                        $('#datatable-container').html(res.html);
                    },
                    error: function (xhr) {
                        console.log(xhr.responseJSON ? xhr.responseJSON.message : 'Request failed');
                    },
                    complete: function () {
                        $('#datatable-container').css('opacity', 1);
                    }
                });
            }

            $('#line').on('change', function () {
                if (skipInitialChange) {
                    skipInitialChange = false;
                    return;
                }
                currentLine = $(this).val();
                fetchInlineLts();
            });

            // Export
            let exportDT = null;
            let lastExportData = null;

            function formatDate(dateStr) {
                if (!dateStr) return dateStr;

                const months = [
                    'January', 'February', 'March', 'April', 'May', 'June',
                    'July', 'August', 'September', 'October', 'November', 'December'
                ];

                const parts = String(dateStr).split('-');
                if (parts.length !== 3) return dateStr;

                const year = parseInt(parts[0], 10);
                const month = parseInt(parts[1], 10) - 1;
                const day = parseInt(parts[2], 10);

                if (isNaN(year) || isNaN(month) || isNaN(day) || !months[month]) {
                    return dateStr;
                }

                return `${day} ${months[month]} ${year}`;
            }


            function doExport() {
                if (!currentLine) {
                    alert('Select the line first before exporting.');
                    return;
                }

                const $btn = $('#btnExport');
                $btn.prop('disabled', true);
                $('#exportTooltip').text('Preparing...');

                $.ajax({
                    url: "{{ route('monitoring_inlineperformance_exportData') }}",
                    type: "GET",
                    data: { line: currentLine, date: currentDate },
                    dataType: "json",
                    success: function (res) {
                        if (!res || !res.rows) {
                            alert('Data export is not available.');
                            return;
                        }

                        let theadHtml = '<tr>' + res.headers.map(function (h) { return '<th>' + h + '</th>'; }).join('') + '</tr>';
                        $('#exportTableHiddenHead').html(theadHtml);

                        let tbodyHtml = res.rows.map(function (row) {
                            return '<tr>' + row.map(function (cell) { return '<td>' + (cell ?? '-') + '</td>'; }).join('') + '</tr>';
                        }).join('');
                        $('#exportTableHiddenBody').html(tbodyHtml);

                        if (exportDT) {
                            exportDT.destroy();
                            exportDT = null;
                        }

                        exportDT = $('#exportTableHidden').DataTable({
                            scrollX: false,
                            paging: false,
                            searching: false,
                            lengthChange: false,
                            info: false,
                            dom: 'B',
                            buttons: [
                                {
                                    extend: 'excelHtml5',
                                    title: 'Report_InlineTLS_' + (currentDate || ''),
                                    filename: 'Report_InlineTLS_' + (currentDate || ''),
                                    exportOptions: { columns: ':visible' }
                                }
                            ]
                        });

                        exportDT.button(0).trigger();
                        exportDT.destroy();
                        exportDT = null;
                        $('#exportTableHiddenHead, #exportTableHiddenBody').empty();
                    },
                    error: function (xhr) {
                        alert('Gagal memuat data export.');
                        console.log(xhr.responseJSON ? xhr.responseJSON.message : 'Request failed');
                    },
                    complete: function () {
                        $btn.prop('disabled', false);
                        $('#exportTooltip').text('Export');
                    }
                });
            }

            $('#btnExport').on('click', doExport);

        });
    </script>
