                    renderDonutChart('chart-2', oql.oql ?? 0, null, oql.oql ?? 0, oql.oql, '#3F3184', '#3F3184');
                    renderDonutChart('chart-3', qo.pass ?? 0, qo.reject ?? 0, qo.total, 'pass-text-3', 'reject-text-3');
