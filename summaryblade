    <script>
        $(function () {
            var filenamePrefix = 'Report_Final_Inspection_{{ str_replace(" ", "_", $filter['periode']) }}';

            function initTable(selector, sheetName) {
                return $(selector).DataTable({
                    dom: 'Bfrtip',
                    paging: selector === '#table-detail-po', // tabel besar aja yg dipaging
                    ordering: true,
                    searching: selector === '#table-detail-po',
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: 'Export Excel',
                            title: sheetName,
                            filename: filenamePrefix + '_' + sheetName.replace(/\s+/g, '_'),
                        }
                    ]
                });
            }

            initTable('#table-detail-po', 'Detail PO');
            initTable('#table-overview', 'Overview per Status');
            initTable('#table-top-defects', 'Top 5 Defects');
            // table-summary sengaja tidak di-DataTable-kan (key-value, bukan tabular list)
        });
    </script>
