// stores/keepAlive.js
import { defineStore } from 'pinia'

export const useKeepAliveStore = defineStore('keepAlive', {
  state: () => ({
    cachedViews: [],
  }),
  actions: {
    add(name) {
      if (name && !this.cachedViews.includes(name)) {
        this.cachedViews.push(name)
      }
    },
    remove(name) {
      this.cachedViews = this.cachedViews.filter(v => v !== name)
    },
  },
})