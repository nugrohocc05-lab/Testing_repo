<script>
    $(function () {
        function parseDMY(str) {
            const [d, m, y] = str.split('-');
            return new Date(`${y}-${m}-${d}`);
        }

        // Urutan cascading baru: ETD -> Group Buyer -> Style -> PO
        function checkDateSelection() {
            let datea = $('#datea').val();
            let dateb = $('#dateb').val();

            $('#groupbuyer').val(null).trigger('change');
            $('#selectstyle').val(null).trigger('change');
            $('#selectpo').val(null).trigger('change');

            $('#selectstyle').prop('disabled', true).trigger('change.select2');
            $('#selectpo').prop('disabled', true).trigger('change.select2');

            if (!datea || !dateb) {
                $('#groupbuyer').prop('disabled', true).trigger('change.select2');
                return;
            }

            const start = parseDMY(datea);
            const end = parseDMY(dateb);

            if (start > end) {
                swal('Warning!', 'Start date cannot be later than end date!', 'warning');
                $('#groupbuyer').prop('disabled', true).trigger('change.select2');
                return;
            }

            const diffDays = (end - start) / (1000 * 60 * 60 * 24);

            if (diffDays > 31) {
                swal('Warning!', 'Date Has More Than 31 Days in Range, Cannot View Data.', 'warning');
                $('#groupbuyer').prop('disabled', true).trigger('change.select2');
                return;
            }

            $('#groupbuyer').prop('disabled', false).trigger('change.select2');
        }

        const dateOpt = {
            dateFormat: "d-m-Y",
            altInput: true,
            altFormat: "d F Y",
            allowInput: false,
            monthSelectorType: "static",
            disableMobile: true,
            defaultDate: "today",
            onChange: function () {
                checkDateSelection();
            }
        };
        flatpickr("#datea", dateOpt);
        flatpickr("#dateb", dateOpt);

        $('#groupbuyer').select2({
            placeholder: 'Select Buyer',
            width: '100%',
            ajax: {
                url: "{{ route('monitoring_endlineperformance_groupbuyer') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function (params) {
                    return {
                        q: params.term || '',
                        page: params.page || 1,
                        datea: $('#datea').val(),
                        dateb: $('#dateb').val()
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    let results = data.results || [];
                    if (params.page === 1 && !params.term) {
                        results = [
                            { id: 'all', text: 'All Buyer' },
                            ...results
                        ];
                    }
                    return {
                        results: results
                    };
                },
                cache: true
            }
        });

        // Style sekarang bergantung ke ETD + Group Buyer (bukan PO lagi)
        $('#selectstyle').select2({
            placeholder: 'Select Style',
            width: '100%',
            ajax: {
                url: "{{ route('monitoring_finalinspection_selectstyle') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function (params) {
                    return {
                        q: params.term || '',
                        page: params.page || 1,
                        datea: $('#datea').val(),
                        dateb: $('#dateb').val(),
                        groupbuyer: $('#groupbuyer').val()
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    let results = data.results || [];

                    if (params.page === 1 && !params.term && results.length > 0) {
                        results = [
                            { id: 'all', text: 'All Style' },
                            ...results
                        ];
                    }

                    return { results: results };
                },
                cache: true
            },
            language: {
                noResults: function () {
                    return 'Style Not Found';
                }
            }
        });

        // PO sekarang bergantung ke ETD + Group Buyer + Style
        $('#selectpo').select2({
            placeholder: 'Select PO',
            width: '100%',
            ajax: {
                url: "{{ route('monitoring_finalinspection_selectpo') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function (params) {
                    return {
                        q: params.term || '',
                        page: params.page || 1,
                        datea: $('#datea').val(),
                        dateb: $('#dateb').val(),
                        groupbuyer: $('#groupbuyer').val(),
                        style: $('#selectstyle').val()
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;
                    let results = data.results || [];

                    if (params.page === 1 && !params.term && results.length > 0) {
                        results = [
                            { id: 'all', text: 'All PO' },
                            ...results
                        ];
                    }

                    return {
                        results: results
                    };
                },
                cache: true
            },
            language: {
                noResults: function () {
                    return 'PO Not Found';
                }
            }
        });

        $('#groupbuyer').prop('disabled', true).trigger('change.select2');
        $('#selectstyle').prop('disabled', true).trigger('change.select2');
        $('#selectpo').prop('disabled', true).trigger('change.select2');

        checkDateSelection();

        // Group Buyer berubah -> reset & enable Style (bukan PO lagi)
        $('#groupbuyer').on('change', function () {
            let buyer = $(this).val();

            $('#selectstyle').val(null).trigger('change');
            $('#selectpo').val(null).trigger('change');

            $('#selectstyle').prop('disabled', !buyer).trigger('change.select2');
            $('#selectpo').prop('disabled', true).trigger('change.select2');
        });

        // Style berubah -> reset & enable PO (posisi ini yang baru)
        $('#selectstyle').on('change', function () {
            let style = $(this).val();

            $('#selectpo').val(null).trigger('change');
            $('#selectpo').prop('disabled', !style).trigger('change.select2');
        });

        window.currentFilter = {
            line: 'all',
            datea: $('#datea').val(),
            dateb: $('#dateb').val(),
            groupbuyer: 'all',
        };

        let hasFiltered = false;

        $('#groupbuyer, #selectstyle, #selectpo, #datea, #dateb').on('change input', function () {
            hasFiltered = false;
        });

        function loadCards(filter) {
            $.ajax({
                url: "{{ route('monitoring_finalinspection_summaryfilter') }}",
                type: "GET",
                data: filter,
                beforeSend: function () {
                    $('#loading').show();
                },
                success: function (response) {
                    $('#totalpo').text(response.total_po ?? '-');
                    $('#totalqty').text(response.total_qty ?? '-');
                    $('#totalqtyinspect').text(response.total_qty_inspect ?? '-');
                    $('#poneedfinal').text(response.po_need_final ?? '-');
                    $('#overdue').text(response.overdue ?? '-');
                    $('#final').text(response.final_completed ?? '-');
                    $('#oql').text(response.oql ?? '-');

                    let passingRate = response.passing_rate ?? 50;
                    let rejectRate = response.reject_rate ?? 80;

                    $('#passingRateValue').text(passingRate + '%');
                    $('#rejectRateValue').text(rejectRate + '%');

                    $('#passingRateBar').css('width', passingRate + '%');
                    $('#rejectRateBar').css('width', rejectRate + '%');

                    updateDataTime();
                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                },
                complete: function () {
                    $('#loading').hide();
                }
            });
        }

        function loadTable(filter) {
            $.ajax({
                url: "{{ route('monitoring_finalinspection_priorityfinal') }}",
                type: "GET",
                data: filter,

                success: function (response) {
                    let rows = response.data || [];
                    let total = response.total || {};

                    let $body = $('#tablePriorityFinalBody');
                    $body.empty();

                    if (rows.length === 0) {
                        $body.append(
                            '<tr><td colspan="12" class="text-center">No Data</td></tr>'
                        );
                    } else {
                        rows.forEach(function (row, idx) {
                            $body.append(`
                                <tr>
                                    <td class="text-center">${idx + 1}</td>
                                    <td class="text-center">${row.po ?? '-'}</td>
                                    <td class="text-center">${row.buyer ?? '-'}</td>
                                    <td class="text-center">${row.style ?? '-'}</td>
                                    <td class="text-center">${row.color ?? '-'}</td>
                                    <td class="text-center">${row.qty_order ?? '-'}</td>
                                    <td class="text-center">${row.output ?? '-'}</td>
                                    <td class="text-center" style="color: #4CF299;">${row.progress_output ?? '-'}%</td>
                                    <td class="text-center">${row.etd ?? '-'}</td>
                                    <td class="text-center">${row.days_to_etd ?? '-'}</td>
                                    <td class="text-center">Need Final</td>
                                </tr>
                            `);
                        });
                    }

                    // Update footer
                    $('#footQtyOrder').text(
                        (total.qty_order ?? 0).toLocaleString()
                    );

                    $('#footOutput').text(
                        (total.output ?? 0).toLocaleString()
                    );

                    $('#footProgressOutput').text(
                        (total.progress_output ?? 0) + '%'
                    );
                },

                error: function (xhr) {
                    console.log(xhr.responseText);
                }
            });
        }


        function updateDataTime() {
            let now = new Date();
            let day = String(now.getDate()).padStart(2, '0');
            let month = [
                "January", "February", "March", "April", "May", "June",
                "July", "August", "September", "October", "November", "December"
            ];
            let year = now.getFullYear();
            let hour = String(now.getHours()).padStart(2, '0');
            let minute = String(now.getMinutes()).padStart(2, '0');
            let second = String(now.getSeconds()).padStart(2, '0');

            let formatted = `${day} ${month[now.getMonth()]} ${year} - ${hour} : ${minute} : ${second}`;

            document.getElementById('liveClock').innerHTML = formatted;

            localStorage.setItem('lastDataUpdate', formatted);
        }

        updateDataTime();
        window.updateDataTime = updateDataTime;

        $('#findbtn').on('click', function (e) {
            e.preventDefault();

            currentFilter = {
                groupbuyer: $('#groupbuyer').val(),
                style: $('#selectstyle').val(),
                po: $('#selectpo').val(),
                datea: $('#datea').val(),
                dateb: $('#dateb').val(),
            };

            if (currentFilter.datea == null || currentFilter.datea == '' ||
                currentFilter.dateb == null || currentFilter.dateb == '') {
                swal('Warning!', 'Please select Periode Date first!', 'warning');
                return;
            }

            const start = parseDMY(currentFilter.datea);
            const end = parseDMY(currentFilter.dateb);

            if (start > end) {
                swal('Warning!', 'Start date cannot be later than end date!', 'warning');
                return;
            }

            const diffDays = (end - start) / (1000 * 60 * 60 * 24);

            if (diffDays > 31) {
                swal('Warning!', 'Date Has More Than 31 Days in Range, Cannot View Data.', 'warning');
                return;
            }

            if (currentFilter.groupbuyer == null || currentFilter.groupbuyer == '') {
                swal('Warning!', 'Please select Group Buyer first!', 'warning');
                return;
            }

            if (currentFilter.style == null || currentFilter.style == '') {
                swal('Warning!', 'Please select Style first!', 'warning');
                return;
            }

            if (currentFilter.po == null || currentFilter.po == '') {
                swal('Warning!', 'Please select PO first!', 'warning');
                return;
            }

            hasFiltered = true;
            loadCards(currentFilter);
            loadTable(currentFilter);
        });

    });
</script>
