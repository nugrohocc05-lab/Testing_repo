<script>
    document.addEventListener('DOMContentLoaded', function () {
        function renderDefectCategoryChart(chartId, processValue, nonProcessValue, processTextId, nonProcessTextId) {
            const total = processValue + nonProcessValue;
            const processPct = total > 0 ? ((processValue / total) * 100).toFixed(0) : 0;
            const nonProcessPct = total > 0 ? ((nonProcessValue / total) * 100).toFixed(0) : 0;

            const MIN_BAR_HEIGHT = 5;

            const processChartValue = Number(processPct) === 0 ? MIN_BAR_HEIGHT : Number(processPct);
            const nonProcessChartValue = Number(nonProcessPct) === 0 ? MIN_BAR_HEIGHT : Number(nonProcessPct);


            if (processTextId && document.getElementById(processTextId)) {
                document.getElementById(processTextId).innerText =
                    processValue.toLocaleString('id-ID') + ' (' + processPct + '%)';
            }
            if (nonProcessTextId && document.getElementById(nonProcessTextId)) {
                document.getElementById(nonProcessTextId).innerText =
                    nonProcessValue.toLocaleString('id-ID') + ' (' + nonProcessPct + '%)';
            }

            const chartDom = document.getElementById(chartId);
            if (!chartDom) return;

            const myChart = echarts.init(chartDom);

            const isSmallDesktop = window.innerWidth >= 992 && window.innerWidth <= 1400;

            const option = {
                backgroundColor: 'transparent',

                grid: {
                    left: '10%',
                    right: '10%',
                    top: '25%',
                    bottom: '5%',
                    containLabel: false
                },

                xAxis: {
                    type: 'category',
                    data: ['Process', 'Non Process'],
                    show: false
                },

                yAxis: {
                    type: 'value',
                    show: false,
                    max: 100
                },

                tooltip: {
                    trigger: 'item',

                    padding: isSmallDesktop ? [5, 8] : [8, 12],

                    textStyle: {
                        fontSize: isSmallDesktop ? 10 : 12
                    },

                    formatter: function (params) {
                        return `
                            ${params.name}<br>
                            <b>${params.data.actualValue}%</b>
                        `;
                    }

                },

                series: [
                    {
                        type: 'bar',

                        barWidth: isSmallDesktop ? '30%' : '35%',

                        data: [
                            {
                                value: processChartValue,
                                actualValue: Number(processPct),
                                itemStyle: {
                                    color: '#3b82f6',
                                    borderRadius: [4, 4, 0, 0]
                                }
                            },
                            {
                                value: nonProcessChartValue,
                                actualValue: Number(nonProcessPct),
                                itemStyle: {
                                    color: '#4ade80',
                                    borderRadius: [4, 4, 0, 0]
                                }
                            }
                        ],


                        label: {
                            show: true,
                            position: 'top',
                            color: '#ffffff',
                            fontSize: isSmallDesktop ? 10 : 13,

                            formatter: function (params) {
                                return params.data.actualValue + ' %';
                            }

                        }
                    }
                ]
            };


            myChart.setOption(option);
            window.addEventListener('resize', () => myChart.resize());
        }

        renderDefectCategoryChart('chart-defect-category', 0, 0, 'process-text', 'non-process-text');
    });
</script>


