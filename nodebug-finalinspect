function finalOverview(Request $request)
{
    preconnect(session('db'));

    $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
    $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

    $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
    $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

    $fi = (new OutputDetailFinalInspection())->getTable();
    $od = (new OutputDetail())->getTable();
    $po = (new PurchaseOrder())->getTable();

    // ===== STEP 1: leaf rows -> qualifiedIdpo (dedup by leaf, qty > 0) =====
    $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);

    $qtyPerIdpo = $leafRows->groupBy('idpo')->map(function ($rows) {
        return (int) $rows->sum('qty_ori');
    });

    $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();

    // ===== STEP 2: qualifiedIdpo -> barcode (OutputDetail) =====
    $barcodes = OutputDetail::whereIn('idpo', $qualifiedIdpo)
        ->pluck('barcode');

    $headerQuery = OutputDetailFinalInspection::query()
        ->join($od, "$od.barcode", '=', "$fi.barcode")
        ->join($po, "$po.idpo", '=', "$od.idpo")
        ->whereIn("$fi.barcode", $barcodes);

    // ===== Final Completed: idpo yang sudah punya barcode is_output = 1 =====
    // PENTING: harus di-dedup reroute di sini (sama seperti getSplitFinalCheckIdpoList()),
    // supaya idpo LAMA yang sudah direroute penuh (qtypo=0 di HistoryPO) tidak ikut
    // terhitung sebagai completed hanya karena masih punya baris barcode/output lama.
    // Tanpa ini, reject/pass/output bisa kelebihan hitung (mis. 17 padahal seharusnya 16).
    $finalComIdpoListRaw = (clone $headerQuery)
        ->where("$fi.is_output", 1)
        ->select("$od.idpo")
        ->distinct()
        ->pluck("$od.idpo");

    $finalComIdpoList = $this->resolveRerouteDuplicates($finalComIdpoListRaw);

    $finalCom = $finalComIdpoList->count();

    $rejectIdpoList = (clone $headerQuery)
        ->whereIn("$od.idpo", $finalComIdpoList)
        ->whereNotNull("$fi.date_output")
        ->whereNotNull("$fi.defect_code")
        ->select("$od.idpo")
        ->distinct()
        ->pluck("$od.idpo");

    $passIdpoList = $finalComIdpoList->diff($rejectIdpoList)->values();

    $poWithDefect = $rejectIdpoList->count();
    $poNoDefect   = $passIdpoList->count();

    // ===== Qty pass/reject: net setelah kurangi qty yang direroute ke idpo lain =====
    $qtyPass = $this->getNetCutoffQty($passIdpoList);

    $qtyReject = $this->getNetCutoffQty($rejectIdpoList);

    $qtyInspectPass = (clone $headerQuery)
        ->whereIn("$od.idpo", $passIdpoList)
        ->whereNotNull("$fi.date_output")
        ->count(DB::raw("DISTINCT $od.barcode"));

    $qtyInspectReject = (clone $headerQuery)
        ->whereIn("$od.idpo", $rejectIdpoList)
        ->whereNotNull("$fi.date_output")
        ->count(DB::raw("DISTINCT $od.barcode"));

    $so = (new SewingOutput())->getTable();

    // ===== not_final: HARUS sama definisi & hasilnya dengan (po_need_final + overdue)
    // di summaryFilter()/priorityFinal(), yaitu lewat getSplitFinalCheckIdpoList().
    // Sebelumnya dihitung dengan $qualifiedIdpo->diff($finalComIdpoList), yang TIDAK
    // melalui syarat requireHasFinalRecord/excludeIfAnyFinalEffective maupun dedup
    // reroute, sehingga bisa tidak match dengan detail per-PO di endpoint priorityFinal().
    $today = Carbon::today()->startOfDay();
    $split = $this->getSplitFinalCheckIdpoList($request, $dta, $dtb, $today);
    $notFinalIdpoList = $split['overdue']->merge($split['need_final'])->unique()->values();

    // ===== Helper: hitung total output (barcode unik is_output=1) untuk sebuah list idpo =====
    $getOutputCount = function ($idpoList) use ($od, $so) {
        return OutputDetail::query()
            ->whereIn("$od.idpo", $idpoList)
            ->whereNotNull("$od.barcode")
            ->join("$so", "$so.barcode", '=', "$od.barcode")
            ->where("$so.is_output", 1)
            ->select("$od.barcode")
            ->distinct()
            ->count();
    };

    $outputPass     = $getOutputCount($passIdpoList);
    $outputReject   = $getOutputCount($rejectIdpoList);
    $outputNotFinal = $getOutputCount($notFinalIdpoList);

    // ===== Qty untuk not_final (buat pembagi progress) =====
    $qtyNotFinal = $this->getNetCutoffQty($notFinalIdpoList);

    // ===== Progress output per bucket =====
    $progressPass = $qtyPass > 0
        ? round(($outputPass / $qtyPass) * 100, 2)
        : 0;

    $progressReject = $qtyReject > 0
        ? round(($outputReject / $qtyReject) * 100, 2)
        : 0;

    $progressNotFinal = $qtyNotFinal > 0
        ? round(($outputNotFinal / $qtyNotFinal) * 100, 2)
        : 0;

    // NOTE: not_final di sini tetap 1 bucket gabungan (bukan dipecah overdue/need_final),
    // sesuai acuan excel kolom S ("Not Final" = R="PO Need Final" OR R="Overdue", digabung).
    // Sekarang gabungannya diambil langsung dari getSplitFinalCheckIdpoList() yang sama
    // dengan yang dipakai summaryFilter()/priorityFinal(), jadi totalnya konsisten.
    // Detail per-PO overdue vs need_final ada di endpoint priorityFinal().

    // Total
    $totalPoAll = $poNoDefect + $poWithDefect + $notFinalIdpoList->count();

    $totalQtyOrderAll = $qtyPass + $qtyReject + $qtyNotFinal;

    $totalQtyInspectAll = $qtyInspectPass + $qtyInspectReject;

    $totalOutputAll = $outputPass + $outputReject + $outputNotFinal;

    $totalProgressOutputAll = $totalQtyOrderAll > 0
        ? round(($totalOutputAll / $totalQtyOrderAll) * 100, 2)
        : 0;

    return response()->json([
        'data' => [[
            'pass' => [
                'count'           => $poNoDefect,
                'qty'             => $qtyPass,
                'qty_inspect'     => $qtyInspectPass,
                'output'          => $outputPass,
                'progress_output' => $progressPass,
            ],
            'reject' => [
                'count'           => $poWithDefect,
                'qty'             => $qtyReject,
                'qty_inspect'     => $qtyInspectReject,
                'output'          => $outputReject,
                'progress_output' => $progressReject,
            ],
            'not_final' => [
                'count'           => $notFinalIdpoList->count(),
                'qty'             => $qtyNotFinal,
                'output'          => $outputNotFinal,
                'progress_output' => $progressNotFinal,
            ],
            'total' => [
                'total_po'        => $totalPoAll,
                'qty_order'       => $totalQtyOrderAll ? $totalQtyOrderAll : 0,
                'qty_inspect'     => $totalQtyInspectAll ? $totalQtyInspectAll : 0,
                'output'          => $totalOutputAll ? $totalOutputAll : 0,
                'progress_output' => $totalProgressOutputAll,
            ],
        ]]
    ]);
}