/* ==========================================================================
   FILTER SECTION — Line, Periode Date, Group Buyer, Export row.
   Used by: filter/filter.blade.php
   ========================================================================== */

.border-end-custom {
    border-right: 1px solid #242E3E !important;
}

.box-custom {
    width: 35px;
    height: 35px;
}

.select2-container {
    width: 100% !important;
}

.select2-container--default .select2-selection--single {
    background: #222F4A;
    border: none;
    display: flex;
    align-items: center;
}

.select2-container--default .select2-selection--single .select2-selection__rendered {
    color: white;
    line-height: 38px;
    padding-left: 0.75rem;
}

.select2-container--default .select2-selection--single .select2-selection__arrow {
    height: 38px;
}

.select2-container--default .select2-selection--single .select2-selection__placeholder {
    color: #ffffff !important;
}

.select2-container--default .select2-results__option--highlighted[aria-selected] {
    background-color: transparent !important;
    color: white !important;
}

.select2-container--default .select2-results__option[aria-selected="true"] {
    background-color: transparent !important;
    color: white !important;
}

.select2-dropdown {
    background: #222F4A;
    color: white;
}

.select2-results__option {
    color: white;
}

.select2-search__field {
    background: #222F4A;
    color: white;
    border: none;
}

.period-date .position-relative {
    flex: 1 1 0;
    min-width: 0;
}

.period-date input {
    font-size: 0.85rem;
}

@media (max-width: 1400px) {
    .period-date .position-relative {
        flex: 1;
    }
    .period-date input {
        font-size: 0.8rem;
        padding-left: .5rem;
        padding-right: 2rem;
    }
}

@media (max-width: 768px) {
    .period-date {
        flex-wrap: wrap;
    }
}

@media (max-width: 767.98px) {
    .border-end-custom {
        border-right: none !important;
        border-bottom: 1px solid rgba(255,255,255,.2);
        padding-bottom: 1rem;
        margin-bottom: 1rem;
    }

    #findbtn {
        width: 100%;
    }

    .period-date {
        flex-direction: column;
        align-items: stretch;
    }
    .period-date .position-relative {
        width: 100%;
    }
    .period-date span.px-2 {
        text-align: center;
        padding: 4px 0 !important;
    }
}

@media (min-width: 992px) and (max-width: 1400px) {
    .row.mt-4 .box-custom {
        width: 26px;
        height: 26px;
    }
    .row.mt-4 img[style*="30px"] {
        width: 22px !important;
        height: 22px !important;
    }
    .row.mt-4.border-custom > [class*="col-"] {
        gap: 0.75rem !important;
        padding-left: 0.5rem;
        padding-right: 0.5rem;
    }
    .row.mt-4 label {
        font-size: 0.8rem;
    }
    #line, #groupbuyer, #datea, #dateb {
        font-size: 0.85rem;
    }
    #findbtn {
        white-space: nowrap;
        padding-left: 0.75rem;
        padding-right: 0.75rem;
    }
}
