<script>
    $(function () {
        function parseDMY(str) {
            const [d, m, y] = str.split('-');
            return new Date(`${y}-${m}-${d}`);
        }

        function checkDateSelection() {
            let datea = $('#datea').val();
            let dateb = $('#dateb').val();

            $('#groupbuyer').val(null).trigger('change');
            $('#selectstyle').val(null).trigger('change');
            $('#selectpo').val(null).trigger('change');
            $('#selectstyle').prop('disabled', true).trigger('change.select2');
            $('#selectpo').prop('disabled', true).trigger('change.select2');

            if (!datea || !dateb) {
                $('#groupbuyer').prop('disabled', true).trigger('change.select2');
                return;
            }

            const start = parseDMY(datea);
            const end = parseDMY(dateb);

            const diffDays = (end - start) / (1000 * 60 * 60 * 24);

            // if (diffDays > 31) {
            //     swal('Warning!', 'Date Has More Than 31 Days in Range, Cannot View Data.', 'warning');
            //     $('#groupbuyer').prop('disabled', true).trigger('change.select2');
            //     return;
            // }

            $('#groupbuyer').prop('disabled', false).trigger('change.select2');
        }

        const dateOpt = {
            dateFormat: "d-m-Y",
            altInput: true,
            altFormat: "d F Y",
            allowInput: false,
            monthSelectorType: "static",
            disableMobile: true,
            defaultDate: "today",
            onChange: function () {
                checkDateSelection();
            }
        };

        flatpickr("#datea", dateOpt);
        flatpickr("#dateb", dateOpt);

        $('#groupbuyer').select2({
            placeholder: 'Select Buyer',
            width: '100%',
            ajax: {
                url: "{{ route('monitoring_finalinspection_groupbuyer') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function (params) {
                    return {
                        q: params.term || '',
                        page: params.page || 1,
                        datea: $('#datea').val(),
                        dateb: $('#dateb').val()
                    };

                },
                processResults: function (data, params) {
                    params.page = params.page || 1;

                    let results = data.results || [];

                    if (params.page === 1 && !params.term && results.length > 0) {
                        results = [
                            { id: 'all', text: 'All Buyer' },
                            ...results
                        ];
                    }

                    return {
                        results: results,
                        pagination: {
                            more: data.pagination?.more || false
                        }
                    };
                },
                cache: true
            }
        });

        $('#selectstyle').select2({
            placeholder: 'Select Style',
            width: '100%',
            ajax: {
                url: "{{ route('monitoring_finalinspection_selectstyle') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function (params) {
                    return {
                        q: params.term || '',
                        page: params.page || 1,
                        datea: $('#datea').val(),
                        dateb: $('#dateb').val(),
                        groupbuyer: $('#groupbuyer').val()
                    };
                },
                processResults: function (data, params) {
                    params.page = params.page || 1;

                    let results = data.results || [];

                    if (params.page === 1 && !params.term && results.length > 0) {
                        results = [
                            { id: 'all', text: 'All Style' },
                            ...results
                        ];
                    }

                    return {
                        results: results,
                        pagination: {
                            more: data.pagination?.more || false
                        }
                    };
                },
                cache: true
            },
            language: {
                noResults: function () {
                    return 'Style Not Found';
                }
            }
        });

        $('#selectpo').select2({
            placeholder: 'Select PO',
            width: '100%',
            ajax: {
                url: "{{ route('monitoring_finalinspection_selectpo') }}",
                type: "GET",
                dataType: "json",
                delay: 500,
                data: function (params) {
                    return {
