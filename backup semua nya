        function generateExcel(data) {
            const wb = XLSX.utils.book_new();

            const styles = {
                title: {
                    font: { bold: true, sz: 16, color: { rgb: "FFFFFF" } },
                    fill: { fgColor: { rgb: "1F4E78" } },
                    alignment: { horizontal: "center", vertical: "center" }
                },
                header: {
                    font: { bold: true, color: { rgb: "FFFFFF" } },
                    fill: { fgColor: { rgb: "4472C4" } },
                    alignment: {
                        horizontal: "center",
                        vertical: "center",
                        wrapText: true
                    },
                    border: {
                        top: { style: "thin", color: { rgb: "BFBFBF" } },
                        bottom: { style: "thin", color: { rgb: "BFBFBF" } },
                        left: { style: "thin", color: { rgb: "BFBFBF" } },
                        right: { style: "thin", color: { rgb: "BFBFBF" } }
                    }
                },
                cell: {
                    alignment: { vertical: "center" },
                    border: {
                        top: { style: "thin", color: { rgb: "D9E1F2" } },
                        bottom: { style: "thin", color: { rgb: "D9E1F2" } },
                        left: { style: "thin", color: { rgb: "D9E1F2" } },
                        right: { style: "thin", color: { rgb: "D9E1F2" } }
                    }
                },
                total: {
                    font: { bold: true },
                    fill: { fgColor: { rgb: "D9EAF7" } }
                }
            };

            function formatHeader(header) {
                return header.replace(/_/g, " ").toUpperCase();
            }

            function styleRange(ws, startRow, endRow, startCol, endCol, style) {
                for (let r = startRow; r <= endRow; r++) {
                    for (let c = startCol; c <= endCol; c++) {
                        const address = XLSX.utils.encode_cell({ r, c });
                        if (!ws[address]) ws[address] = { v: "" };
                        ws[address].s = style;
                    }
                }
            }

            function setColumnWidths(ws, widths) {
                ws["!cols"] = widths.map(w => ({ wch: w }));
            }

            function addSheetTitle(ws, totalColumns) {
                ws["!merges"] = ws["!merges"] || [];
                ws["!merges"].push({
                    s: { r: 0, c: 0 },
                    e: { r: 0, c: totalColumns - 1 }
                });
                ws["A1"].s = styles.title;
                ws["!rows"] = ws["!rows"] || [];
                ws["!rows"][0] = { hpt: 28 };
            }

            const today = new Date();

            const todayFormatted = today.toLocaleDateString('id-ID', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
            });

            const sheet1Rows = [
                ["FINAL INSPECTION EXPORT"],
                [],
                ["ETD", data.filter.periode],
                ["Report Date", todayFormatted],
                [],
                ["Group Buyer", "Style", "PO"],
                [
                    data.filter.groupbuyer,
                    data.filter.style,
                    data.filter.po
                ],
                [],
                [
                    "Total PO",
                    "Total Qty",
                    "Total Qty Inspect",
                    "PO Need Final",
                    "Overdue",
                    "Final Completed",
                    "OQL / Defect Rate",
                    "Passing Rate",
                    "Reject Rate"
                ],
                [
                    data.summary.total_po,
                    data.summary.total_qty,
                    data.summary.total_qty_inspect,
                    data.summary.po_need_final,
                    data.summary.overdue,
                    data.summary.final_completed,
                    `${data.summary.oql}%`,
                    `${data.summary.passing_rate}%`,
                    `${data.summary.reject_rate}%`
                ],
                []
            ];


            const wsMain = XLSX.utils.aoa_to_sheet(sheet1Rows);

            addSheetTitle(wsMain, 9);

            styleRange(wsMain, 1, 1, 0, 2, styles.header);
            styleRange(wsMain, 2, 2, 0, 2, styles.cell);
            styleRange(wsMain, 4, 4, 0, 5, styles.header);
            styleRange(wsMain, 6, 6, 0, 8, styles.header);
            styleRange(wsMain, 7, 7, 0, 8, styles.cell);
            styleRange(wsMain, 7, 7, 0, 8, styles.total);

            setColumnWidths(wsMain, [18, 18, 18, 18, 15, 18, 18, 18, 18]);

            let currentRow = 10;

            if (data.detail_po?.length > 0) {
                const poHeaders = [
                    "NO",
                    "PO",
                    "BUYER",
                    "STYLE",
                    "COLOR",
                    "QTY ORDER",
                    "OUTPUT",
                    "PROGRESS OUTPUT",
                    "ETD",
                    "DAYS TO ETD",
                    "QTY INSPECT",
                    "DEFECT QTY",
                    "DEFECT NAME",
                    "PROCESS",
                    "NON PROCESS",
                    "STATUS",
                ];

                function formatPercentage(value) {
                    const number = Number(value || 0);

                    if (number === 0) {
                        return "0%";
                    }

                    return `${number.toFixed(2)}%`;
                }

                const poRows = data.detail_po.map((row, index) => {

                    return [
                        index + 1,
                        row.po ?? "",
                        row.buyer ?? "",
                        row.style ?? "",
                        row.color ?? "",
                        Number(row.qty_order ?? 0),
                        Number(row.output ?? 0),
                        formatPercentage(row.progress_output),
                        row.etd ?? "",
                        row.days_to_etd ?? "",
                        Number(row.qty_inspect ?? 0),
                        Number(row.defect_qty ?? 0),
                        row.defect_name ?? "-",
                        Number(row.process ?? 0),
                        Number(row.non_process ?? 0),
                        row.status ?? ""
                    ];
                });

                const totalColumns = poHeaders.length;
                // currentRow++;
                 currentRow += 2;

                XLSX.utils.sheet_add_aoa(wsMain, [poHeaders], {
                    origin: {
                        r: currentRow,
                        c: 0
                    }
                });

                styleRange(
                    wsMain,
                    currentRow,
                    currentRow,
                    0,
                    totalColumns - 1,
                    styles.header
                );

                currentRow++;

                XLSX.utils.sheet_add_aoa(wsMain, poRows, {
                    origin: {
                        r: currentRow,
                        c: 0
                    }
                });

                styleRange(
                    wsMain,
                    currentRow,
                    currentRow + poRows.length - 1,
                    0,
                    totalColumns - 1,
                    styles.cell
                );

                const total = data.detail_po_total || {};

                const totalRow = new Array(totalColumns).fill("");

                const qtyOrderIndex = poHeaders.indexOf("QTY ORDER");
                const outputIndex = poHeaders.indexOf("OUTPUT");
                const progressOutputIndex = poHeaders.indexOf("PROGRESS OUTPUT");
                const qtyInspectIndex = poHeaders.indexOf("QTY INSPECT");
                const defectQtyIndex = poHeaders.indexOf("DEFECT QTY");
                const processIndex = poHeaders.indexOf("PROCESS");
                const nonProcessIndex = poHeaders.indexOf("NON PROCESS");

                // Label TOTAL
                totalRow[0] = "TOTAL";

                // QTY ORDER
                if (qtyOrderIndex !== -1) {
                    totalRow[qtyOrderIndex] = Number(total.qty_order || 0);
                }

                // OUTPUT
                if (outputIndex !== -1) {
                    totalRow[outputIndex] = Number(total.output || 0);
                }

                // PROGRESS OUTPUT
                if (progressOutputIndex !== -1) {
                    totalRow[progressOutputIndex] =
                        formatPercentage(total.progress_output);
                }

                // QTY INSPECT
                if (qtyInspectIndex !== -1) {
                    totalRow[qtyInspectIndex] =
                        Number(total.qty_inspect || 0);
                }

                // DEFECT QTY
                if (defectQtyIndex !== -1) {
                    totalRow[defectQtyIndex] =
                        Number(total.defect_qty || 0);
                }

                // PROCESS
                if (processIndex !== -1) {
                    totalRow[processIndex] =
                        Number(total.process || 0);
                }

                // NON PROCESS
                if (nonProcessIndex !== -1) {
                    totalRow[nonProcessIndex] =
                        Number(total.non_process || 0);
                }

                const totalRowIndex = currentRow + poRows.length;

                XLSX.utils.sheet_add_aoa(wsMain, [totalRow], {
                    origin: {
                        r: totalRowIndex,
                        c: 0
                    }
                });

                styleRange(
                    wsMain,
                    totalRowIndex,
                    totalRowIndex,
                    0,
                    totalColumns - 1,
                    styles.total
                );

                const percentageRow = new Array(totalColumns).fill("");

                percentageRow[0] = "PERCENTAGE";

                // PROCESS %
                if (processIndex !== -1) {
                    percentageRow[processIndex] =
                        formatPercentage(total.process_percentage);
                }

                // NON PROCESS %
                if (nonProcessIndex !== -1) {
                    percentageRow[nonProcessIndex] =
                        formatPercentage(total.non_process_percentage);
                }

                const percentageRowIndex = totalRowIndex + 1;

                XLSX.utils.sheet_add_aoa(wsMain, [percentageRow], {
                    origin: {
                        r: percentageRowIndex,
                        c: 0
                    }
                });

                styleRange(
                    wsMain,
                    percentageRowIndex,
                    percentageRowIndex,
                    0,
                    totalColumns - 1,
                    styles.total
                );

                const widths = wsMain["!cols"] || [];

                poHeaders.forEach((header, index) => {

                    const values = poRows.map(row => row[index]);

                    const maxLength = Math.max(
                        String(header).length,
                        ...values.map(value =>
                            value == null
                                ? 0
                                : String(value).length
                        )
                    );

                    widths[index] = {
                        wch: Math.min(
                            Math.max(maxLength + 2, 10),
                            35
                        )
                    };
                });

                const fixedWidths = {
                    0: 8,   // NO
                    1: 20,  // PO
                    2: 12,  // IDPO
                    3: 15,  // STYLE
                    4: 15,  // COLOR
                    5: 15,  // BUYER
                    6: 12,  // QTY ORDER
                    7: 12,  // OUTPUT
                    8: 18,  // PROGRESS OUTPUT
                    9: 14,  // ETD
                    10: 15, // DAYS TO ETD
                    11: 15, // STATUS
                    12: 14, // QTY INSPECT
                    13: 13, // DEFECT QTY
                    14: 35, // DEFECT NAME
                    15: 12, // PROCESS
                    16: 15  // NON PROCESS
                };

                Object.keys(fixedWidths).forEach(index => {
                    widths[index] = {
                        wch: fixedWidths[index]
                    };
                });
                wsMain["!cols"] = widths;
            }


            wsMain["!freeze"] = { xSplit: 0, ySplit: 8 };

            XLSX.utils.book_append_sheet(wb, wsMain, "Final Inspection");

            const periode = data.filter.periode
                .replace(/\s+s\/d\s+/i, "-to-")
                .replace(/\s+/g, "");

            const fileName = `Final-Inspection-${periode}.xlsx`;

            XLSX.writeFile(wb, fileName);

        }

