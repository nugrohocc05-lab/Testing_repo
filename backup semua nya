       let defectCategoryChart = null;
        function renderDefectCategoryChart(
            chartId,
            processValue,
            nonProcessValue,
            processPercent,
            nonProcessPercent,
            processTextId,
            nonProcessTextId
        ) {

            processValue = Number(processValue) || 0;
            nonProcessValue = Number(nonProcessValue) || 0;
            processPercent = Number(processPercent) || 0;
            nonProcessPercent = Number(nonProcessPercent) || 0;

            const MIN_BAR_HEIGHT = 5;

            const processChartValue =
                processPercent === 0 ? MIN_BAR_HEIGHT : processPercent;

            const nonProcessChartValue =
                nonProcessPercent === 0 ? MIN_BAR_HEIGHT : nonProcessPercent;

            const getResponsiveFontSize = () => {
                const width = window.innerWidth;

                if (width <= 480) {
                    return 9;
                } else if (width <= 768) {
                    return 10;
                } else if (width < 1400) {
                    return 10;
                } else {
                    return 13;
                }
            };

            const processText = document.getElementById(processTextId);

            if (processText) {
                processText.innerText =
                    processValue.toLocaleString('id-ID') +
                    ' (' +
                    processPercent.toFixed(2) +
                    '%)';
            }

            const nonProcessText = document.getElementById(nonProcessTextId);

            if (nonProcessText) {
                nonProcessText.innerText =
                    nonProcessValue.toLocaleString('id-ID') +
                    ' (' +
                    nonProcessPercent.toFixed(2) +
                    '%)';
            }

            const chartDom = document.getElementById(chartId);

            if (!chartDom) {
                return;
            }

            if (defectCategoryChart) {
                defectCategoryChart.dispose();
                defectCategoryChart = null;
            }

            defectCategoryChart = echarts.init(chartDom);
            const option = {
                backgroundColor: 'transparent',
                grid: {
                    left: '10%',
                    right: '10%',
                    top: '35%',
                    bottom: '5%',
                    containLabel: false
                },
                xAxis: {
                    type: 'category',
                    data: [
                        'Process',
                        'Non Process'
                    ],
                    show: false
                },
                yAxis: {
                    type: 'value',
                    show: false,
                    min: 0,
                    max: 100
                },
                tooltip: {
                    trigger: 'axis',
                    axisPointer: {
                        type: 'shadow'
                    },
                    formatter: function (params) {
                        const item = params[0];
                        if (!item) {
                            return '';
                        }
                        return `
                            <div>
                                <strong>${item.name}</strong><br>
                                Qty: ${item.name === 'Process'
                                    ? processValue.toLocaleString('id-ID')
                                    : nonProcessValue.toLocaleString('id-ID')
                                }<br>
                                Percentage: ${item.value}%
                            </div>
                        `;
                    }
                },
                series: [
                    {
                        type: 'bar',
                        barWidth: '35%',
                        data: [
                            {
                                value: processChartValue,
                                actualValue: processPercent,
                                itemStyle: {
                                    color: '#3b82f6',
                                    borderRadius: 0,
                                }
                            },
                            {
                                value: nonProcessChartValue,
                                actualValue: nonProcessPercent,
                                itemStyle: {
                                    color: '#4ade80',
                                    borderRadius: 0,
                                }
                            }
                        ],


                        label: {
                            show: true,
                            position: 'top',
                            color: '#ffffff',
                            fontSize: getResponsiveFontSize(),
                            formatter: function (params) {
                                return params.data.actualValue + ' %';
                            }
                        }
                    }
                ]
            };
            defectCategoryChart.setOption(option);
        }

        window.loadDefectCategoryChart = function (response) {

            if (!response) {
                renderDefectCategoryChart('chart-defect-category',0,0,0,0,'process-text','non-process-text');
                return;
            }

            const processValue = Number(response.process || 0);
            const nonProcessValue = Number(response.non_process || 0);
            const processPercent = Number(response.process_percent || 0);
            const nonProcessPercent = Number(response.non_process_percent || 0);

            renderDefectCategoryChart(
                'chart-defect-category',
                processValue,
                nonProcessValue,
                processPercent,
                nonProcessPercent,
                'process-text',
                'non-process-text'
            );
        };

        window.addEventListener('resize', function () {
            if (defectCategoryChart) {
                defectCategoryChart.resize();
