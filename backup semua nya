    private function buildSummaryFilterData(Request $request, Carbon $dta, Carbon $dtb): array
    {
        $fi = (new OutputDetailFinalInspection())->getTable();
        $od = (new OutputDetail())->getTable();
        $po = (new PurchaseOrder())->getTable();

        $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);

        $byIdpoThenColor = $leafRows->groupBy('idpo')->map(fn ($rows) => $rows->groupBy('idcolor'));

        $qtyPerIdpo = $leafRows->groupBy('idpo')->map(fn ($rows) => (int) $rows->sum('qty_ori'));

        $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();
        $this->primeComboUniverse($qualifiedIdpo);

        $today = Carbon::today()->startOfDay();
        $split = $this->getSplitFinalCheckIdpoList($request, $dta, $dtb, $today);

        $headerQuery = OutputDetailFinalInspection::query()
            ->join($od, "$od.barcode", '=', "$fi.barcode")
            ->join($po, "$po.idpo", '=', "$od.idpo")
            ->whereIn("$od.idpo", $qualifiedIdpo);

        $finalComIdpoList = $this->getFinalCompletionStatus($qualifiedIdpo)['finalCom'];

        $finalComIdpoListRemapped = $this->remapToReroutedIdpo($finalComIdpoList);

        $overdueList = $this->remapToReroutedIdpo($split['overdue'])
            ->diff($finalComIdpoListRemapped)
            ->values();

        $needFinalList = $this->remapToReroutedIdpo($split['need_final'])
            ->diff($overdueList)
            ->diff($finalComIdpoListRemapped)
            ->values();


        $originalFinalIdpoList = $split['overdue']->merge($split['need_final'])
            ->merge($finalComIdpoList)->unique()->values();

        $finalIdpoList = $this->remapToReroutedIdpo($originalFinalIdpoList);

        $poList = collect();
        foreach ($finalIdpoList as $idpo) {
            $colorGroups = $byIdpoThenColor->get($idpo);
            if (!$colorGroups) {
                continue;
            }
            foreach ($colorGroups as $idcolor => $rows) {
                $first = $rows->first();
                $poList->push((object) [
                    'idpo' => $idpo,
                    'idcolor' => $idcolor,
                    'po' => $first->po,
                    'idbuyer' => $first->idbuyer,
                    'idstyle' => $first->idstyle,
                    'qty' => (int) $rows->sum('qty_ori'),
                    'etd' => $rows->max('deliverydate'),
                ]);
            }
        }

        $poList = $poList->values();

        $poIdList = $poList
            ->pluck('idpo')
            ->unique()
            ->values();

        $totalQty = $poIdList->sum(
            fn ($idpo) => $qtyPerIdpo->get($idpo, 0)
        );

        $overdueFinalList = $overdueList
            ->intersect($poIdList)
            ->values();

        $needFinalFinalList = $needFinalList
            ->intersect($poIdList)
            ->values();

        $overdue = $overdueFinalList->count();
        $poNeedFinal = $needFinalFinalList->count();


        $totalQtyInspect = (clone $headerQuery)
            ->whereNotNull("$fi.date_output")
            ->count(DB::raw("DISTINCT $fi.id"));

        $finalCom = $finalComIdpoList->count();
        $totalPo = $poNeedFinal + $overdue + $finalCom;

        $totDefect = (clone $headerQuery)
            ->whereNotNull("$fi.date_output")
            ->whereNotNull("$fi.defect_code")
            ->count(DB::raw("DISTINCT $fi.id"));

        $oql = $totalQtyInspect > 0
            ? number_format(($totDefect / $totalQtyInspect) * 100, 2, '.', '')
            : '0.00';

        $rejectIdpoList = (clone $headerQuery)
            ->whereIn("$od.idpo", $finalComIdpoList)
            ->whereNotNull("$fi.defect_code")
            ->select("$od.idpo")->distinct()->pluck("$od.idpo");

        $poWithDefect = $rejectIdpoList->count();
        $poNoDefect = $finalCom - $poWithDefect;
        $passingRate = $finalCom > 0 ? round(($poNoDefect / $finalCom) * 100, 2) : 0;
        $rejectRate = $finalCom > 0 ? round(($poWithDefect / $finalCom) * 100, 2) : 0;

        return [
            'total_po' => $totalPo,
            'total_qty' => $totalQty,
            'total_qty_inspect' => $totalQtyInspect,
            'po_need_final' => $poNeedFinal,
            'overdue' => $overdue,
            'final_completed' => $finalCom,
            'oql' => $oql,
            'passing_rate' => $passingRate,
            'reject_rate' => $rejectRate,
        ];
    }

    private function buildFinalOverviewData(Request $request, Carbon $dta, Carbon $dtb, ?array $priority = null): array
    {
        $fi = (new OutputDetailFinalInspection())->getTable();
        $od = (new OutputDetail())->getTable();
        $po = (new PurchaseOrder())->getTable();

        $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);
        $qtyPerIdpo = $leafRows->groupBy('idpo')->map(fn ($rows) => (int) $rows->sum('qty_ori'));
        $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();
        $this->primeComboUniverse($qualifiedIdpo);

        $headerQuery = OutputDetailFinalInspection::query()
            ->join($od, "$od.barcode", '=', "$fi.barcode")
            ->join($po, "$po.idpo", '=', "$od.idpo")
            ->whereIn("$od.idpo", $qualifiedIdpo);

        $status = $this->getFinalCompletionStatus($qualifiedIdpo);

        $finalComIdpoList = $status['finalCom'];
        $rejectIdpoList = $status['reject'];
        $passIdpoList = $status['pass'];

        $poWithDefect = $rejectIdpoList->count();
        $poNoDefect = $passIdpoList->count();

        $qtyInspectPass = (clone $headerQuery)
            ->whereIn("$od.idpo", $passIdpoList)
            ->whereNotNull("$fi.date_output")
            ->count(DB::raw("DISTINCT $od.barcode"));

        $qtyInspectReject = (clone $headerQuery)
            ->whereIn("$od.idpo", $rejectIdpoList)
            ->whereNotNull("$fi.date_output")
            ->count(DB::raw("DISTINCT $od.barcode"));

        $byIdpoLeaf = $leafRows->groupBy('idpo');

        $activeIdpoList = $this->remapToReroutedIdpo($qualifiedIdpo);

        $notFinalForCount = $activeIdpoList
            ->diff($rejectIdpoList)
            ->diff($passIdpoList)
            ->values();

        $poList = $notFinalForCount->map(function ($idpo) use ($byIdpoLeaf) {
            $rows = $byIdpoLeaf->get($idpo);
            if (!$rows) {
                return null;
            }
            $first = $rows->first();
            return (object) [
                'idpo' => $idpo,
                'po' => $first->po,
                'idbuyer' => $first->idbuyer,
                'idstyle' => $first->idstyle,
                'idcolor' => $first->idcolor,
            ];
        })->filter()->values();

        $countNotFinal = $poList->count();

        $finalComRemapped = $this->remapToReroutedIdpo($finalComIdpoList);
        $rejectRemapped = $this->remapToReroutedIdpo($rejectIdpoList);
        $passRemapped = $finalComRemapped->diff($rejectRemapped)->values();

        $notFinalForQty = $activeIdpoList
            ->diff($finalComRemapped)
            ->values();

        $qtyNotFinal = $notFinalForQty->sum(fn ($idpo) => $qtyPerIdpo->get($idpo, 0));
        $qtyPass = $passRemapped->sum(fn ($idpo) => $qtyPerIdpo->get($idpo, 0));
        $qtyReject = $rejectRemapped->sum(fn ($idpo) => $qtyPerIdpo->get($idpo, 0));

        $priority ??= $this->buildPriorityFinalData($request, $dta, $dtb);
        $outByStatus = $priority['output_by_status'];

        $outputPass = (int) $outByStatus['pass'];
        $outputReject = (int) $outByStatus['reject'];
        $outputNotFinal = (int) $outByStatus['need_final'];

        $qtyInspectNotFinal = 0;

        $progressPass = $qtyPass > 0 ? round(($outputPass / $qtyPass) * 100, 2) : 0;
        $progressReject = $qtyReject > 0 ? round(($outputReject / $qtyReject) * 100, 2) : 0;
        $progressNotFinal = $qtyNotFinal > 0 ? round(($outputNotFinal / $qtyNotFinal) * 100, 2) : 0;

        $totalPoAll = $poNoDefect + $poWithDefect + $countNotFinal;
        $totalQtyOrderAll = $qtyPass + $qtyReject + $qtyNotFinal;
        $totalQtyInspectAll = $qtyInspectPass + $qtyInspectReject;
        $totalOutputAll = $outputPass + $outputReject + $outputNotFinal;

        $totalProgressOutputAll = $totalQtyOrderAll > 0
            ? round(($totalOutputAll / $totalQtyOrderAll) * 100, 2)
            : 0;

        return [
            'data' => [[
                'pass' => [
                    'count' => $poNoDefect,
                    'qty' => $qtyPass,
                    'qty_inspect' => $qtyInspectPass,
                    'output' => $outputPass,
                    'progress_output' => $progressPass,
                ],
                'reject' => [
                    'count' => $poWithDefect,
                    'qty' => $qtyReject,
                    'qty_inspect' => $qtyInspectReject,
                    'output' => $outputReject,
                    'progress_output' => $progressReject,
                ],
                'not_final' => [
                    'count' => $countNotFinal,
                    'qty' => $qtyNotFinal,
                    'qty_inspect' => $qtyInspectNotFinal,
                    'output' => $outputNotFinal,
                    'progress_output' => $progressNotFinal,
                ],
                'total' => [
                    'total_po' => $totalPoAll,
                    'qty_order' => $totalQtyOrderAll ?: 0,
                    'qty_inspect' => $totalQtyInspectAll ?: 0,
                    'output' => $totalOutputAll ?: 0,
                    'progress_output' => $totalProgressOutputAll,
                ],
            ]],
        ];
    }

