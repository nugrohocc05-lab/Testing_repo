private function parseDateRange(Request $request): array
{
    $a = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
    $b = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

    return $a->lessThanOrEqualTo($b)
        ? [$a, $b->copy()->endOfDay()]
        : [$b, $a->copy()->endOfDay()];
}

private function getFilterOptionRows(Request $request): Collection
{
    [$dta, $dtb] = $this->parseDateRange($request);

    $key = 'final_inspection:filteropt:' . session('db') . ':' . md5(json_encode([
        $dta->toDateString(),
        $dtb->toDateString(),
        $request->get('groupbuyer'),
        $request->get('style'),
        Carbon::today()->toDateString(),
    ]));

    $rows = Cache::remember($key, 120, function () use ($request, $dta, $dtb) {
        $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);
        $set = $this->getFinalIdpoList($request, $dta, $dtb)
            ->map(fn ($v) => (string) $v)->flip();

        return $leafRows
            ->filter(fn ($r) => !empty($r->idpo) && $set->has((string) $r->idpo))
            ->unique('idpo')
            ->map(fn ($r) => [
                'idpo' => (string) $r->idpo,
                'po' => $r->po,
                'idbuyer' => $r->idbuyer,
                'idstyle' => $r->idstyle,
            ])
            ->values()
            ->all();
    });

    return collect($rows);
}


function groupbuyer(Request $request)
{
    preconnect(session('db'));
    $q = $request->get('q');
    $page = (int) $request->get('page', 1);

    $buyerIds = $this->getFilterOptionRows($request)
        ->pluck('idbuyer')->filter()->unique()->values();

    $groupIds = Buyer::whereIn('idbuyer', $buyerIds)
        ->pluck('groupbuyer')->filter()->unique()->values();

    $paginator = MasterGroupBuyer::select('id', 'group_name')
        ->whereIn('id', $groupIds)
        ->when($q, fn ($query) => $query->where('group_name', 'like', '%' . $q . '%'))
        ->orderBy('group_name', 'asc')
        ->paginate($this->perPage, ['id', 'group_name'], 'page', $page);

    return response()->json([
        'results' => collect($paginator->items())
            ->map(fn ($i) => ['id' => $i->id, 'text' => $i->group_name])->values(),
        'pagination' => ['more' => $paginator->hasMorePages()],
    ]);
}

function poSelect(Request $request)
{
    preconnect(session('db'));
    $page = (int) $request->get('page', 1);

    $poRows = $this->getFilterOptionRows($request);

    if ($request->filled('q')) {
        $q = $request->q;
        $poRows = $poRows->filter(fn ($r) => stripos($r['po'], $q) !== false)->values();
    }

    $total = $poRows->count();
    $items = $poRows->forPage($page, $this->perPage)->values();

    return response()->json([
        'results' => $items->map(fn ($r) => ['id' => $r['idpo'], 'text' => $r['po']])->values(),
        'pagination' => ['more' => ($page * $this->perPage) < $total],
    ]);
}

function styleSelect(Request $request)
{
    preconnect(session('db'));
    $page = (int) $request->get('page', 1);

    $styleIds = $this->getFilterOptionRows($request)
        ->pluck('idstyle')->filter()->unique()->values();

    $query = Style::whereIn('idstyle', $styleIds);

    if ($request->filled('q')) {
        $query->where('nmstyle', 'like', '%' . $request->q . '%');
    }

    $paginator = $query->select('idstyle', 'nmstyle')
        ->paginate($this->perPage, ['idstyle', 'nmstyle'], 'page', $page);

    return response()->json([
        'results' => collect($paginator->items())
            ->map(fn ($i) => ['id' => $i->idstyle, 'text' => $i->nmstyle])->values(),
        'pagination' => ['more' => $paginator->hasMorePages()],
    ]);
}

