    private function getFinalIdpoList(Request $request, Carbon $dta, Carbon $dtb): Collection
    {
        $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);
        $qtyPerIdpo = $leafRows->groupBy('idpo')->map(fn ($rows) => (int) $rows->sum('qty_ori'));
        $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();
        $this->primeComboUniverse($qualifiedIdpo);

        $today = Carbon::today()->startOfDay();
        $split = $this->getSplitFinalCheckIdpoList($request, $dta, $dtb, $today);

        $finalComIdpoList = $this->getFinalCompletionStatus($qualifiedIdpo)['finalCom'];

        $finalIdpoList = $split['overdue']->merge($split['need_final'])
            ->merge($finalComIdpoList)->unique()->values();

        return $this->getActiveRerouteIdpoList($finalIdpoList);
    }

    private function primeComboUniverse(Collection $qualifiedIdpo): void
    {
        $qualifiedIdpo = $qualifiedIdpo->filter()->unique()->sort()->values();
        $key = md5($qualifiedIdpo->implode(','));

        if ($this->comboUniversePrimedKey === $key) {
            return;
        }

        $this->comboUniverse = $qualifiedIdpo->isEmpty()
            ? collect()
            : HistoryDataBreakdown::whereIn('idpo', $qualifiedIdpo)
                ->pluck('combine_pro')->filter()->unique()->values();

        $this->comboUniversePrimedKey = $key;
    }

    private function getFinalCompletionStatus(Collection $qualifiedIdpo): array
    {
        $key = md5($qualifiedIdpo->sort()->values()->implode(','));
        if (isset($this->finalStatusCache[$key])) {
            return $this->finalStatusCache[$key];
        }

        $fi = (new OutputDetailFinalInspection())->getTable();
        $od = (new OutputDetail())->getTable();
        $po = (new PurchaseOrder())->getTable();

        $headerQuery = OutputDetailFinalInspection::query()
            ->join($od, "$od.barcode", '=', "$fi.barcode")
            ->join($po, "$po.idpo", '=', "$od.idpo")
            ->whereIn("$od.idpo", $qualifiedIdpo);

        $finalComIdpoList = (clone $headerQuery)
            ->where("$fi.is_output", 1)
            ->select("$od.idpo")->distinct()->pluck("$od.idpo");

        $rejectIdpoList = (clone $headerQuery)
            ->whereIn("$od.idpo", $finalComIdpoList)
            ->whereNotNull("$fi.date_output")
            ->whereNotNull("$fi.defect_code")
            ->select("$od.idpo")->distinct()->pluck("$od.idpo");

        $passIdpoList = $finalComIdpoList->diff($rejectIdpoList)->values();

        return $this->finalStatusCache[$key] = [
            'finalCom' => $finalComIdpoList,
            'reject' => $rejectIdpoList,
            'pass' => $passIdpoList,
        ];
    }

    function groupbuyer(Request $request)
    {
        preconnect(session('db'));
        $q = $request->get('q');
        $page = (int) $request->get('page', 1);

        $dateA = Carbon::createFromFormat(
            'd-m-Y',
            $request->datea
        )->startOfDay();

        $dateB = Carbon::createFromFormat(
            'd-m-Y',
            $request->dateb
        )->startOfDay();

        $dta = $dateA->lessThanOrEqualTo($dateB)
            ? $dateA
            : $dateB;

        $dtb = $dateA->lessThanOrEqualTo($dateB)
            ? $dateB->copy()->endOfDay()
            : $dateA->copy()->endOfDay();

        $leafRows = $this->getLeafHistoryRows(
            $request,
            'combine_pro',
            false,
            $dta,
            $dtb
        );

        $finalIdpoList = $this->getFinalIdpoList($request, $dta, $dtb);

        $qualifiedBuyerIds = $leafRows
            ->whereIn('idpo', $finalIdpoList)
            ->pluck('idbuyer')
            ->filter()
            ->unique()
            ->values();

        $qualifiedGroupBuyerIds = Buyer::whereIn(
            'idbuyer',
            $qualifiedBuyerIds
        )
            ->pluck('groupbuyer')
            ->filter()
            ->unique()
            ->values();

        $paginator = MasterGroupBuyer::select(
            'id',
            'group_name'
        )
            ->whereIn('id', $qualifiedGroupBuyerIds)
            ->when($q, function ($query) use ($q) {
                $query->where(
                    'group_name',
                    'like',
                    '%' . $q . '%'
                );
            })
            ->orderBy('group_name', 'asc')
            ->paginate(
                $this->perPage,
                ['id', 'group_name'],
                'page',
                $page
            );

        $data = collect($paginator->items())
            ->map(function ($item) {
                return [
                    'id' => $item->id,
                    'text' => $item->group_name,
                ];
            })
            ->values();

        return response()->json([
            'results' => $data,
            'pagination' => [
                'more' => $paginator->hasMorePages(),
            ],
        ]);
    }

