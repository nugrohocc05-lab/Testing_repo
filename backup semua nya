        const chartInstances = {};

        function getFontScale(width, height) {
            const size = Math.min(width, height);

            if (size <= 90) {
                return {
                    center: 12,
                    sub: 8
                };
            }

            if (size <= 120) {
                return {
                    center: 15,
                    sub: 9
                };
            }

            if (size <= 160) {
                return {
                    center: 18,
                    sub: 10
                };
            }

            return {
                center: 22,
                sub: 11
            };
        }


        function renderDonutChart(
            chartId,
            passValue,
            rejectValue,
            totalValue,
            passTextId,
            rejectTextId,
            passColor = '#4ade80',
            rejectColor = '#f87171',
            centerLabel = 'Pcs',
            firstName = 'PASS',
            valueSuffix = '',
            showPercentage = true,
            customTooltip = null
        ) {
            const total = Number(totalValue) || 0;

            const pass = Number(passValue) || 0;
            const reject = Number(rejectValue) || 0;

            const passPct = total > 0
                ? ((pass / total) * 100).toFixed(2)
                : 0;

            const rejectPct = total > 0
                ? ((reject / total) * 100).toFixed(2)
                : 0;

            if (passTextId && document.getElementById(passTextId)) {
                document.getElementById(passTextId).innerText =
                    showPercentage
                        ? pass.toLocaleString('id-ID') + ' (' + passPct + '%)'
                        : pass.toLocaleString('id-ID');
            }


            if (rejectTextId && document.getElementById(rejectTextId)) {
                document.getElementById(rejectTextId).innerText =
                    reject.toLocaleString('id-ID') + ' (' + rejectPct + '%)';
            }

            const chartDom = document.getElementById(chartId);
            if (!chartDom) return;

            const myChart = echarts.init(chartDom);
            chartInstances[chartId] = myChart;

            const data = [
                {
                    value: pass,
                    name: firstName,
                    itemStyle: {
                        color: passColor
                    }
                }
            ];

            if (rejectTextId) {
                data.push({
                    value: reject,
                    name: 'REJECT',
                    itemStyle: {
                        color: rejectColor
                    }
                });
            }

            function buildOption() {
                const width = chartDom.clientWidth || 150;
                const height = chartDom.clientHeight || 150;

                const { center, sub } = getFontScale(width, height);

                return {
                    backgroundColor: 'transparent',

                    tooltip: {
                        trigger: 'item',
                        formatter: customTooltip || '{b}: {c} ({d}%)'
                    },

                    series: [
                        {
                            name: 'Inspection Result',
                            type: 'pie',
                            radius: ['50%', '70%'],
                            center: ['50%', '50%'],
                            avoidLabelOverlap: false,

                            label: {
                                show: false
                            },

                            labelLine: {
                                show: false
                            },

                            data: data
                        }
                    ],

                    graphic: [
                        {
                            type: 'text',
                            left: 'center',
                            top: 'center',
                            style: {
                                text: '{value|' + total.toLocaleString('id-ID') + valueSuffix + '}\n{label|' + centerLabel + '}',
                                rich: {
                                    value: {
                                        fontSize: center,
                                        fontWeight: 'bold',
                                        fill: '#ffffff',
                                        lineHeight: Math.round(center * 1),
                                        align: 'center'
                                    },
                                    label: {
                                        fontSize: sub,
                                        fontWeight: 'normal',
                                        fill: '#ffffff',
                                        lineHeight: Math.round(sub * 1.4),
                                        align: 'center'
                                    }
                                }
                            }
                        }
                    ]
                };
            }

            myChart.setOption(buildOption());

            const ro = new ResizeObserver(() => {
                myChart.resize();
                myChart.setOption(buildOption());
            });

            ro.observe(chartDom);
        }


