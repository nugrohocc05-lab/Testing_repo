function selecttable()
{
    $tables = IntellocutShellDetail::whereNotNull('idtable')
        ->where('idtable', '<>', '')
        ->distinct()
        ->orderBy('idtable')
        ->pluck('idtable');

    return view('cutting::intellocutlayerman.selecttable', compact('tables'));
}

function settable(Request $request)
{
    $this->validate($request, ['table' => 'required']);

    session(['layerman_table' => $request->table]);

    return redirect()->route('intellocutlayerman_home');
}

