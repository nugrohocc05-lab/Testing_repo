<?php

namespace App\Http\Models;

use Illuminate\Database\Eloquent\Model;

class IntellocutLayermanSplice extends Model
{
    protected $table = 'intellocut_layerman_splices';
    protected $guarded = [];
    public $timestamps = false;

    public function layerman()
    {
        return $this->belongsTo(IntellocutLayermanLay::class, 'idlayerman');
    }
}
