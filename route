function topDefects(Request $request)
{
    preconnect(session('db'));

    $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
    $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();

    $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
    $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

    $fi = (new OutputDetailFinalInspection())->getTable();
    $od = (new OutputDetail())->getTable();
    $po = (new PurchaseOrder())->getTable();

    // ===== STEP 1: leaf rows -> qualifiedIdpo (dedup by leaf, qty > 0) =====
    $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);

    $qtyPerIdpo = $leafRows->groupBy('idpo')->map(function ($rows) {
        return (int) $rows->sum('qty_ori');
    });

    $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();

    // ===== STEP 2: qualifiedIdpo -> barcode (OutputDetail) =====
    $barcodes = OutputDetail::whereIn('idpo', $qualifiedIdpo)
        ->pluck('barcode');

    $headerQuery = OutputDetailFinalInspection::query()
        ->join($od, "$od.barcode", '=', "$fi.barcode")
        ->join($po, "$po.idpo", '=', "$od.idpo")
        ->whereIn("$fi.barcode", $barcodes);

    // ===== STEP 3: ambil semua record yang sudah diinspeksi dan punya defect_code =====
    $defectRows = (clone $headerQuery)
        ->whereNotNull("$fi.date_output")
        ->whereNotNull("$fi.defect_code")
        ->select("$fi.id", "$fi.defect_code")
        ->distinct()
        ->get();

    // Total record ber-defect, dipakai sebagai pembagi persentase
    $totalDefect = $defectRows->count();

    // ===== STEP 4: group per defect_code, hitung qty & persentase =====
    $grouped = $defectRows
        ->groupBy('defect_code')
        ->map(function ($rows, $code) use ($totalDefect) {
            $qty = $rows->count();
            return [
                'defect_code' => $code,
                'qty'         => $qty,
                'percentage'  => $totalDefect > 0
                    ? round(($qty / $totalDefect) * 100, 2)
                    : 0,
            ];
        })
        ->values();

    // ===== STEP 5: mapping nama defect dari master QCDefect =====
    $defectCodes = $grouped->pluck('defect_code')->filter()->unique()->values();

    // NOTE: sesuaikan nama kolom idQCDefect & namaQCDefect dengan schema QCDefect asli
    $defectNames = QCDefect::whereIn('idqcdefect', $defectCodes)
        ->pluck('nmqcdefect', 'idqcdefect');

    $result = $grouped->map(function ($item) use ($defectNames) {
        $item['defect_name'] = $defectNames->get($item['defect_code'], $item['defect_code']);
        return $item;
    })->sortByDesc('qty')->values();

    return response()->json([
        'data'         => $result,
        'total_defect' => $totalDefect,
    ]);
}