if ($request->groupbuyer && $request->groupbuyer != 'all') {
    $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');

    if ($buyerIds->isEmpty()) {
        $headerQuery = $headerQuery->whereRaw('1 = 0');
    } else {
        $headerQuery = $headerQuery
            ->where('is_qc', 1)
            ->whereIn('barcode', function ($q) use ($buyerIds) {
                $q->select('od.barcode')
                  ->from('output_details as od')
                  ->join('purchase_orders as po', 'po.idpo', '=', 'od.idpo')
                  ->whereIn('po.idbuyer', $buyerIds);
            });
    }
}