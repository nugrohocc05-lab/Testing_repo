if ($request->groupbuyer && $request->groupbuyer != 'all') {
    // Buyer di DB berbeda dari PO/OutputDetail — tetap harus query terpisah
    $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)
        ->pluck('idbuyer');

    if ($buyerIds->isEmpty()) {
        $headerQuery = $headerQuery->whereRaw('1 = 0');
    } else {
        // PurchaseOrder & OutputDetail satu DB — join jadi 1 query,
        // idbuyer sudah ada langsung di PurchaseOrder, tak perlu tabel Buyer lagi
        $od = (new OutputDetail())->getTable();
        $po = (new PurchaseOrder())->getTable();

        $barcodes = OutputDetail::query()
            ->join("$po as po", 'po.idpo', '=', "$od.idpo")
            ->whereIn('po.idbuyer', $buyerIds)
            ->select("$od.barcode")
            ->distinct()
            ->pluck('barcode');

        if ($barcodes->isEmpty()) {
            $headerQuery = $headerQuery->whereRaw('1 = 0');
        } else {
            $headerQuery = $headerQuery
                ->where('is_qc', 1)
                ->whereIn('barcode', $barcodes);
        }
    }
}