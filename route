        return response($html)
            ->header('Content-Type', 'application/vnd.ms-excel')
            ->header('Content-Disposition', 'attachment; filename=Report_Endline_Summary.xls');
    }

    private function buildWeeks($year)
    {
        return Cache::remember("weeks_list_{$year}", now()->addDay(), function () use ($year) {
            $startOfYear = Carbon::createFromDate($year, 1, 1)->startOfDay();
            $endOfYear   = Carbon::createFromDate($year, 12, 31)->endOfDay();

            $weeks = [];
            $weekNumber = 1;
            $current = $startOfYear->copy();

            while ($current->lte($endOfYear)) {
                $weekStart = $current->copy();
                $weekEnd   = $current->copy()->addDays(6);

                if ($weekEnd->gt($endOfYear)) {
                    $weekEnd = $endOfYear->copy();
                }

                $weeks[] = [
                    'id'    => $year . '-' . $weekNumber,
                    'year'  => $year,
                    'week'  => $weekNumber,
                    'start' => $weekStart->format('Y-m-d'),
                    'end'   => $weekEnd->format('Y-m-d'),
                    'text'  => 'Week ' . $weekNumber . ' (' . $weekStart->format('d M') . ' - ' . $weekEnd->format('d M Y') . ')',
                ];

                $weekNumber++;
                $current->addDays(7);
            }

            return $weeks;
        });
    }

    private function detectCurrentWeek($date = null)
    {
        $date = $date ? Carbon::parse($date) : Carbon::now();
        $year = $date->year;

        $startOfYear = Carbon::createFromDate($year, 1, 1)->startOfDay();
        $dayOfYear   = $startOfYear->diffInDays($date->copy()->startOfDay()) + 1;
        $weekNumber  = (int) ceil($dayOfYear / 7);

        return [
            'id'   => $year . '-' . $weekNumber,
            'year' => $year,
            'week' => $weekNumber,
        ];
    }

    public function selectWeek(Request $request)
    {
        $year   = Carbon::now()->year;
        $search = trim((string) $request->q);

        $weeks = collect($this->buildWeeks($year));

        $currentWeek = $this->detectCurrentWeek();
        $weeks = $weeks
            ->filter(fn ($w) => $w['week'] <= $currentWeek['week'])
            ->sortByDesc('week')
            ->values();


        if ($search !== '') {
            $needle = mb_strtolower($search);
            $weeks = $weeks->filter(fn ($w) => str_contains(mb_strtolower($w['text']), $needle))->values();
        }

        $perPage = 20;
        $page    = (int) ($request->page ?? 1);
        $paged   = $weeks->slice(($page - 1) * $perPage, $perPage)->values();

        return response()->json([
            'results'    => $paged->map(fn ($w) => ['id' => $w['id'], 'text' => $w['text']]),
            'pagination' => ['more' => $weeks->count() > $page * $perPage],
        ]);
    }

    public function currentWeek()
    {
        $current = $this->detectCurrentWeek();

        $weeks = collect($this->buildWeeks($current['year']));

        $selectedWeek = $weeks->first(function ($week) use ($current) {
            return $week['week'] === $current['week'];
        });

        return response()->json([
            'selected' => [
                'id'   => $selectedWeek['id'],
                'text' => $selectedWeek['text'],
            ],
        ]);
    }

    private function getTopStylesForGroups($headerQuery, array $groups, int $limit = 2): array
    {
        $empty = collect($groups)->mapWithKeys(fn ($codes, $key) => [$key => ['rows' => [], 'total' => 0]])->all();

        $allCodes = collect($groups)->flatten()->unique()->values();

        if ($allCodes->isEmpty()) {
            return $empty;
        }

        $barcodeRows = (clone $headerQuery)
            ->whereIn('defect_code', $allCodes)
            ->select('defect_code', 'barcode')
            ->get();

        if ($barcodeRows->isEmpty()) {
            return $empty;
        }

        $codeToGroup = [];
        foreach ($groups as $key => $codes) {
            foreach ($codes as $c) {
                $codeToGroup[$c] = $key;
            }
        }

        $groupBarcodes = [];
        foreach ($barcodeRows as $row) {
            $key = $codeToGroup[$row->defect_code] ?? null;
            if ($key === null) {
                continue;
            }
            $groupBarcodes[$key][] = $row->barcode;
        }

        $allBarcodes = $barcodeRows->pluck('barcode')->unique()->values();

        $outputRows = OutputDetail::whereIn('barcode', $allBarcodes)
            ->select('idpo', 'barcode')
            ->get();

        $poToStyle = PurchaseOrder::whereIn('idpo', $outputRows->pluck('idpo')->unique())
            ->pluck('idstyle', 'idpo');

        $styleNames = Style::whereIn('idstyle', $poToStyle->values()->unique())
            ->pluck('nmstyle', 'idstyle');

        $result = [];

        foreach ($groups as $key => $codes) {
            $barcodeSet = collect($groupBarcodes[$key] ?? [])->flip();

            if ($barcodeSet->isEmpty()) {
                $result[$key] = ['rows' => [], 'total' => 0];
                continue;
            }

            $styleQty = $outputRows->filter(fn ($r) => $barcodeSet->has($r->barcode))
                ->groupBy('idpo')
                ->map->count();

            $totalDefectQty = $styleQty->sum();

            $grouped = [];
            foreach ($styleQty as $idpo => $total) {
                $idstyle = $poToStyle[$idpo] ?? null;
                $nmstyle = $idstyle ? ($styleNames[$idstyle] ?? '-') : '-';
                $grouped[$nmstyle] = ($grouped[$nmstyle] ?? 0) + $total;
            }

            arsort($grouped);

            $top = array_slice($grouped, 0, $limit, true);
            $othersQty = $totalDefectQty - array_sum($top);

            $rows = [];
            foreach ($top as $nmstyle => $qty) {
                $rows[] = [
                    'style'   => $nmstyle,
                    'qty'     => $qty,
                    'percent' => $totalDefectQty > 0 ? number_format(($qty / $totalDefectQty) * 100, 2) : '0.00',
                ];
            }

            if ($othersQty > 0) {
                $rows[] = [
                    'style'   => 'Others',
                    'qty'     => $othersQty,
                    'percent' => $totalDefectQty > 0 ? number_format(($othersQty / $totalDefectQty) * 100, 2) : '0.00',
                ];
            }

            $result[$key] = ['rows' => $rows, 'total' => $totalDefectQty];
        }

        return $result;
    }

    public function getWeeklyData(Request $request)
    {
        preconnect(session('db'));

        $request->validate([
            'week_id' => 'required|string',
        ]);

        [$year, $weekNumber] = explode('-', $request->week_id);
        $weekNumber = (int) $weekNumber;

        if ($weekNumber < 1 || $weekNumber > 53) {
            abort(422, 'Week tidak valid');
        }

        $dta = Carbon::createFromDate($year, 1, 1)
            ->startOfDay()
            ->addDays(($weekNumber - 1) * 7);

        $dtb = $dta->copy()
            ->addDays(6)
            ->endOfDay();

        $endOfYear = Carbon::createFromDate($year, 12, 31)->endOfDay();

        if ($dtb->gt($endOfYear)) {
            $dtb = $endOfYear->copy();
        }

        $headerQuery = SewingOutput::whereBetween('date', [$dta, $dtb]);

        $totInspect = (clone $headerQuery)->where('is_qc', 1)->count();
        $totDefect  = (clone $headerQuery)->whereNotNull('defect_code')->count();

        $totRft = (clone $headerQuery)->where('is_qc', 1)
            ->where('is_output', 1)
            ->where('qc_seq', 0)
            ->where('defect_code', '=', null)
            ->count();


        $rft = $totInspect > 0 ? round(($totRft /  $totInspect) * 100, 2) : 0;
        $wft = $totInspect > 0
            ? round(($totDefect / $totInspect) * 100, 2)
            : 0;

        // Process dan Non Process
        $defectCodesInRange = (clone $headerQuery)
            ->whereNotNull('defect_code')
            ->pluck('defect_code')
            ->values();

        $categoryMap = QCDefect::whereIn('kdcacat', $defectCodesInRange)
            ->pluck('category', 'kdcacat');

        // Process = category 1
        $processDefectCodes = $defectCodesInRange
            ->filter(fn ($code) => (int) ($categoryMap[$code] ?? 0) === 1)
            ->values();

        // Non Process = category 0
        $nonProcessDefectCodes = $defectCodesInRange
            ->filter(fn ($code) => (int) ($categoryMap[$code] ?? 0) === 0)
            ->values();

        $processQty = $processDefectCodes->count();
        $nonProcessQty = $nonProcessDefectCodes->count();

        $nonProcessQtyNoGrade = $nonProcessDefectCodes
            ->reject(fn ($code) => in_array($code, [800, 900, 888]))
            ->count();

        $totDefectProcess = $processQty + $nonProcessQty;

        $processPercent = $totDefectProcess > 0
            ? round(($processQty / $totDefectProcess) * 100, 2)
            : 0;

        $nonProcessPercent = $totDefectProcess > 0
            ? round(($nonProcessQtyNoGrade / $totDefectProcess) * 100, 2)
            : 0;

        $header = [
            'week'   => 'Week ' . $weekNumber,
            'period' => 'Week ' . $weekNumber . ' (' . $dta->format('d M') . ' - ' . $dtb->format('d M Y') . ')',
        ];

        $topDefect = (clone $headerQuery)
            ->whereNotNull('defect_code')
            ->whereNotIn('defect_code', [800, 900])
            ->select(
                'defect_code',
                DB::raw('COUNT(*) as total')
            )
            ->groupBy('defect_code')
            ->orderByDesc('total')
            ->orderBy('defect_code', 'asc')
            ->limit(4)
            ->get();

        $defectIds = $topDefect->pluck('defect_code');

        $masterQcDefects = QCDefect::whereIn('kdcacat', $defectIds)
            ->pluck('deskripsi', 'kdcacat');

        $colors = [
            '#004FE0',
            '#3DAA25',
            '#F4947E',
            '#F24C4C',
            '#29B1AE',
        ];

        $totTop4DefectQty = $topDefect->sum('total');

        $othersQty = max(0, $totDefect - $totTop4DefectQty);

        $othersPercent = $totDefect > 0
            ? ($othersQty / $totDefect) * 100
            : 0;

        $othersDefectCodes = (clone $headerQuery)
            ->whereNotNull('defect_code')
            ->whereNotIn('defect_code', $defectIds->toArray())
            ->pluck('defect_code')
            ->unique()
            ->values()
            ->toArray();

        $topStyleGroups = ['others' => $othersDefectCodes];
        foreach ($defectIds as $code) {
            $topStyleGroups[(string) $code] = [$code];
        }

        $topStyles = $this->getTopStylesForGroups($headerQuery, $topStyleGroups);

        // Mapping Top 4 Defect + Top Style tiap defect
        $topDefect = $topDefect->values()->map(function ($item, $index) use (
            $masterQcDefects,
            $totDefect,
            $colors,
            $topStyles
        ) {
            $percent = $totDefect > 0 ? ($item->total / $totDefect) * 100 : 0;

            return [
                'defect_id'  => $item->defect_code,
                'nmdefect'   => $masterQcDefects[$item->defect_code] ?? '-',
                'defect_qty' => (int) $item->total,
                'percent'    => number_format($percent, 2),
                'color'      => $colors[$index] ?? '#29B1AE',
                'top_style'  => $topStyles[(string) $item->defect_code]['rows'] ?? [],
            ];
        });

        $topDefect->push([
            'defect_id'  => 'others',
            'nmdefect'   => 'Others',
            'defect_qty' => (int) $othersQty,
            'percent'    => number_format($othersPercent, 2),
            'color'      => '#29B1AE',
            'top_style'  => $topStyles['others']['rows'] ?? [],
        ]);

        $totTopDefect = $topDefect->sum('defect_qty');

        return view('monitoring::endlineperformance.performance.partials.weekly', [
            'header'       => $header,
            'rft_qty'      => $totRft,
            'inspect_qty'  => $totInspect,
            'defect_qty'   => $totDefect,
            'rft'          => $rft,
            'wft'          => $wft,
            'top_defect'   => $topDefect,
            'totTopDefect' => $totTopDefect,
            'process_qty'        => $processQty,
            'non_process_qty'    => $nonProcessQty,
            'process_percent'    => $processPercent,
            'non_process_percent'=> $nonProcessPercent,
        ]);
    }

    // Helper: hitung range tanggal dari week_id
    private function weekRange($year, int $weekNumber): array
    {
        $dta = Carbon::createFromDate($year, 1, 1)->startOfDay()->addDays(($weekNumber - 1) * 7);
        $dtb = $dta->copy()->addDays(6)->endOfDay();

        $endOfYear = Carbon::createFromDate($year, 12, 31)->endOfDay();
        if ($dtb->gt($endOfYear)) {
            $dtb = $endOfYear->copy();
        }

        return [$dta, $dtb];
    }

    private function buildDayBuckets(Carbon $dta, Carbon $dtb): array
    {
        $rows = SewingOutput::whereBetween('date', [$dta, $dtb])
            ->select('id', DB::raw('DATE(date) as dd'))
            ->get()
            ->groupBy('dd');

        $buckets = [];
        $cursor = $dta->copy();

        while ($cursor->lte($dtb)) {
            $key = $cursor->format('Y-m-d');
            $buckets[] = [
                'label' => $cursor->format('d M'),
                'ids'   => $rows->has($key) ? $rows[$key]->pluck('id') : collect(),
            ];
            $cursor->addDay();
        }

        return $buckets;
    }

    // Helper: pecah satu hari jadi bucket per jam
    private function buildHourBuckets(Carbon $date): array
    {
        $rows = SewingOutput::whereDate('date', $date)
            ->select('id', DB::raw('HOUR(date) as hh'))
            ->get()
            ->groupBy('hh');

        $buckets = [];
        foreach (range(7, 23) as $h) {
            $mid = $date->copy()->setTime($h, 30, 0);

            $buckets[] = [
                'label' => sprintf('%02d:00', $h),
                'time'  => $mid->format('Y-m-d H:i:s'),
                'ids'   => $rows->has($h) ? $rows[$h]->pluck('id') : collect(),
            ];
        }

        return $buckets;
    }

    private function buildBucketTopStyles(Collection $rowsMap, array $buckets, Collection $defectCodes, array $inspectQtyPerBucket, int $limit = 3): array
    {
        if ($defectCodes->isEmpty()) {
            return array_fill(0, count($buckets), []);
        }

        $allBarcodes = collect();
        $bucketCodeBarcodes = [];

        foreach ($buckets as $i => $bucket) {
            $rowsInBucket = $bucket['ids']->map(fn ($id) => $rowsMap->get($id))->filter();

            foreach ($defectCodes as $code) {
                $barcodes = $rowsInBucket
                    ->filter(fn ($r) => (int) $r->is_qc === 1 && $r->defect_code == $code)
                    ->pluck('barcode')
                    ->unique()
                    ->values();

                $bucketCodeBarcodes[$i][$code] = $barcodes;
                $allBarcodes = $allBarcodes->merge($barcodes);
            }
        }

        $allBarcodes = $allBarcodes->unique()->values();

        if ($allBarcodes->isEmpty()) {
            return array_fill(0, count($buckets), []);
        }

        $outputRows = OutputDetail::whereIn('barcode', $allBarcodes)
            ->select('idpo', 'barcode')
            ->get();

        $poToStyle = PurchaseOrder::whereIn('idpo', $outputRows->pluck('idpo')->unique())
            ->pluck('idstyle', 'idpo');

        $styleNames = Style::whereIn('idstyle', $poToStyle->values()->unique())
            ->pluck('nmstyle', 'idstyle');

        $results = [];

        foreach ($buckets as $i => $bucket) {
            $inspectQty = $inspectQtyPerBucket[$i] ?? 0;
            $results[$i] = [];

            foreach ($defectCodes as $code) {
                $barcodeSet = ($bucketCodeBarcodes[$i][$code] ?? collect())->flip();

                if ($barcodeSet->isEmpty()) {
                    $results[$i][(string) $code] = [];
                    continue;
                }

                $styleQty = $outputRows->filter(fn ($r) => $barcodeSet->has($r->barcode))
                    ->groupBy('idpo')
                    ->map->count();

                $grouped = [];
                foreach ($styleQty as $idpo => $total) {
                    $idstyle = $poToStyle[$idpo] ?? null;
                    $nmstyle = $idstyle ? ($styleNames[$idstyle] ?? '-') : '-';
                    $grouped[$nmstyle] = ($grouped[$nmstyle] ?? 0) + $total;
                }

                arsort($grouped);
                $top = array_slice($grouped, 0, $limit, true);

                $rows = [];
                foreach ($top as $nmstyle => $qty) {
                    $rows[] = [
                        'style' => $nmstyle,
                        'qty'   => $qty,
                        'wft'   => $inspectQty > 0 ? round(($qty / $inspectQty) * 100, 2) : 0,
                    ];
                }

                $results[$i][(string) $code] = $rows;
            }
        }

        return $results;
    }

    private function generateDistinctColors(int $count): array
    {
        if ($count <= 0) {
            return [];
        }

        $baseColors = $this->defectColors;

        $colors = [];
            for ($i = 0; $i < $count; $i++) {
            if ($i < count($baseColors)) {
                $colors[] = $baseColors[$i];
                continue;
            }

            $hue = fmod($i * 137.508, 360);
            $saturation = 65;
            $lightness  = 55;

            $colors[] = $this->hslToHex($hue, $saturation, $lightness);
        }

        return $colors;
    }

    private function hslToHex(float $h, float $s, float $l): string
    {
        $s /= 100;
        $l /= 100;

        $c = (1 - abs(2 * $l - 1)) * $s;
        $x = $c * (1 - abs(fmod($h / 60, 2) - 1));
        $m = $l - $c / 2;

        if ($h < 60)       { [$r, $g, $b] = [$c, $x, 0]; }
        elseif ($h < 120)  { [$r, $g, $b] = [$x, $c, 0]; }
        elseif ($h < 180)  { [$r, $g, $b] = [0, $c, $x]; }
        elseif ($h < 240)  { [$r, $g, $b] = [0, $x, $c]; }
        elseif ($h < 300)  { [$r, $g, $b] = [$x, 0, $c]; }
        else               { [$r, $g, $b] = [$c, 0, $x]; }

        $r = round(($r + $m) * 255);
        $g = round(($g + $m) * 255);
        $b = round(($b + $m) * 255);

        return sprintf('#%02X%02X%02X', $r, $g, $b);
    }

    private function getDefectColorMap(string $mode): array
    {
        $cacheKey = "defect_color_map_{$mode}_" . Carbon::now()->format('Y-m-d_H:i');

        return Cache::remember($cacheKey, now()->addMinutes(2), function () use ($mode) {
            if ($mode === 'day') {
                $headerQuery = SewingOutput::whereDate('date', Carbon::now());
            } else {
                $dta = Carbon::now()->subDays(6)->startOfDay();
                $dtb = Carbon::now()->endOfDay();
                $headerQuery = SewingOutput::whereBetween('date', [$dta, $dtb]);
            }

            $rankedCodes = (clone $headerQuery)
                ->whereNotNull('defect_code')
                ->whereNotIn('defect_code', [800, 900])
                ->select('defect_code', DB::raw('COUNT(*) as total'))
                ->groupBy('defect_code')
                ->orderByDesc('total')
                ->orderBy('defect_code', 'asc')
                ->pluck('total', 'defect_code')
                ->keys();

            $names = QCDefect::whereIn('kdcacat', $rankedCodes)
                ->pluck('deskripsi', 'kdcacat');

            $palette = $this->generateDistinctColors($rankedCodes->count());

            $map = [];
            foreach ($rankedCodes->values() as $index => $code) {
                $map[(string) $code] = [
                    'name'  => $names[$code] ?? '-',
                    'color' => $palette[$index],
                ];
            }

            return $map;
        });
    }

    public function getDefectChartOptions(Request $request)
    {
        preconnect(session('db'));

        $request->validate([
            'mode' => 'required|in:weekly,day',
        ]);

        $colorMap = $this->getDefectColorMap($request->mode);

        $options = collect($colorMap)
            ->map(function ($item, $code) {
                return [
                    'code'  => $code,
                    'name'  => $item['name'],
                    'color' => $item['color'],
                ];
            })
            ->values();

        return response()->json([
            'options' => $options,
        ]);
    }

    public function getDefectChartData(Request $request)
    {
        preconnect(session('db'));

        $request->validate([
            'mode' => 'required|in:weekly,day',
        ]);

        $defectCodes = collect($request->input('defects', []))->map(fn ($c) => (int) $c);

        if ($request->mode === 'day') {
            $buckets = $this->buildHourBuckets(Carbon::now());
        } else {
            $dta = Carbon::now()->subDays(6)->startOfDay();
            $dtb = Carbon::now()->endOfDay();
            $buckets = $this->buildDayBuckets($dta, $dtb);
        }

        $colorMap = $this->getDefectColorMap($request->mode);

        $names = QCDefect::whereIn('kdcacat', $defectCodes)->pluck('deskripsi', 'kdcacat');

        $allIds = collect($buckets)->pluck('ids')->flatten()->unique()->values();

        $rowsMap = $allIds->isNotEmpty()
            ? SewingOutput::whereIn('id', $allIds)
                ->select('id', 'is_qc', 'defect_code', 'barcode')
                ->get()
                ->keyBy('id')
            : collect();

        $labels = [];
        $seriesData = [];
        $seriesQty  = [];
        foreach ($defectCodes as $c) {
            $seriesData[$c] = [];
            $seriesQty[$c]  = [];
        }

        $inspectQtyPerBucket = [];

        foreach ($buckets as $i => $bucket) {
            $labels[] = $bucket['label'];

            $bucketRows = $bucket['ids']->map(fn ($id) => $rowsMap->get($id))->filter();

            $inspectQty = $bucketRows->where('is_qc', 1)->count();
            $inspectQtyPerBucket[$i] = $inspectQty;

            $defectQtyPerCode = $bucketRows->where('is_qc', 1)
                ->whereIn('defect_code', $defectCodes->toArray())
                ->groupBy('defect_code')
                ->map->count();

            foreach ($defectCodes as $code) {
                $qty = $defectQtyPerCode[$code] ?? 0;
                $wft = $inspectQty > 0 ? round(($qty / $inspectQty) * 100, 2) : 0;

                $seriesData[$code][] = $wft;
                $seriesQty[$code][]  = (int) $qty;
            }
        }

        $topStylesPerBucket = $this->buildBucketTopStyles($rowsMap, $buckets, $defectCodes, $inspectQtyPerBucket);

        $bucketMeta = [];
        foreach ($buckets as $i => $bucket) {
            $bucketMeta[] = [
                'topStyles'  => $topStylesPerBucket[$i] ?? [],
                'inspectQty' => $inspectQtyPerBucket[$i] ?? 0,
            ];
        }

        $series = $defectCodes->values()->map(function ($code) use ($seriesData, $seriesQty, $names, $colorMap) {
            $codeKey = (string) $code;
            $mapped  = $colorMap[$codeKey] ?? null;

            return [
                'code'  => $codeKey,
                'name'  => $mapped['name']  ?? ($names[$code] ?? '-'),
                'color' => $mapped['color'] ?? '#8A93A6',
                'data'  => $seriesData[$code],
                'qty'   => $seriesQty[$code],
            ];
        });

        $times = $request->mode === 'day'
            ? collect($buckets)->pluck('time')->values()
            : [];

        return response()->json([
            'labels'     => $labels,
            'times'      => $times,
            'series'     => $series,
            'bucketMeta' => $bucketMeta,
        ]);
    }

    function endlinetls(Request $request)
    {
        preconnect(session('db'));

        $date = Carbon::today();

        // Line
        $g = (new MasterEmployeeGroup())->getTable();
        $s = (new MasterEmployeeSection())->getTable();

        $lines = MasterEmployeeGroup::select(
                "$g.id as kodegroup",
                "$g.name as namagroup",
            )
            ->join($s, "$s.id", '=', "$g.section_id")
            ->distinct()
            ->whereHas('groupline', function ($q) {
                $q->where('factory_id', session('db')->iddb)
                    ->where('is_show', 1)
                    ->where('is_line', 1);
            });

        if ($request->q) {
            $lines->where(function ($q) use ($request, $g) {
                $q->where("$g.name", 'like', "%$request->q%");
            });
        }

        $lines = $lines->orderBy('kodegroup')->get();

        $lineIds = $lines->pluck('kodegroup');

        try {
            $mpLineParam = ($lp = FactoryParameter::find('line_mapping_tolerance'))
                ? $lp->value * 1
                : 30;
        } catch (\Exception $e) {
            $mpLineParam = 30;
        }

        try {
            $mpMinusParam = FactoryParameter::where('key', 'line_mpminus')->first();
            $mpMinusParam = $mpMinusParam ? $mpMinusParam->value : -3;
        } catch (\Exception $e) {
            $mpMinusParam = -3;
        }

        // totInspect per line
        $totInspectMap = SewingOutput::whereDate('date', $date)
            ->whereIn('line', $lineIds)
            ->where('is_qc', 1)
            ->groupBy('line')
            ->selectRaw('line, COUNT(*) as total')
            ->pluck('total', 'line');

        // totDefect per line
        $totDefectMap = SewingOutput::whereDate('date', $date)
            ->whereIn('line', $lineIds)
            ->whereNotNull('defect_code')
            ->groupBy('line')
            ->selectRaw('line, COUNT(*) as total')
            ->pluck('total', 'line');

        $totDefectCapMap = SewingOutput::whereDate('date', $date)
            ->whereIn('line', $lineIds)
            ->whereNotNull('defect_code')
            ->where(function ($q) {
                $q->whereNull('problem')
                ->orWhereNull('nik_pic')
                ->orWhereNull('action')
                ->orWhereNull('root_cause');
            })
            ->groupBy('line')
            ->selectRaw('line, COUNT(*) as total')
            ->pluck('total', 'line');


        // defectNotOil per line
        $defectNotOilMap = SewingOutput::whereDate('date', $date)
            ->whereIn('line', $lineIds)
            ->whereNotNull('defect_code')
            ->whereNotIn('defect_code', [602])
            ->groupBy('line')
            ->selectRaw('line, COUNT(*) as total')
            ->pluck('total', 'line');

        // oilDefect per line
        $oilDefectMap = SewingOutput::whereDate('date', $date)
            ->whereIn('line', $lineIds)
            ->where('is_qc', 1)
            ->whereIn('defect_code', [602])
            ->where(function ($q) {
                $q->whereNull('problem')
                ->orWhereNull('nik_pic')
                ->orWhereNull('action')
                ->orWhereNull('root_cause');
            })
            ->groupBy('line')
            ->selectRaw('line, COUNT(*) as total')
            ->pluck('total', 'line');

        // totRft per line
        $totRftMap = SewingOutput::whereDate('date', $date)
            ->whereIn('line', $lineIds)
            ->where('is_output', 1)
            ->where('qc_seq', 0)
            ->whereNull('defect_code')
            ->groupBy('line')
            ->selectRaw('line, COUNT(*) as total')
            ->pluck('total', 'line');

        $incompleteCapLines = SewingOutput::whereDate('date', $date)
            ->whereIn('line', $lineIds)
            ->whereNotNull('defect_code')
            ->where(function ($q) {
                $q->whereNull('problem')
                ->orWhereNull('nik_pic')
                ->orWhereNull('action')
                ->orWhereNull('root_cause');
            })
            ->distinct()
            ->pluck('line')
            ->flip();

        $lines = $lines->map(function ($line) use (
            $mpLineParam,
            $mpMinusParam,
            $totInspectMap,
            $totDefectMap,
            $totDefectCapMap,
            $defectNotOilMap,
            $oilDefectMap,
            $totRftMap,
            $incompleteCapLines
        ) {
            $lineId = $line->kodegroup;

            $totInspect    = $totInspectMap[$lineId] ?? 0;
            $totDefect     = $totDefectMap[$lineId] ?? 0;
            $totDefectCap     = $totDefectCapMap[$lineId] ?? 0;
            $defectNotOil  = $defectNotOilMap[$lineId] ?? 0;
            $oilDefect     = $oilDefectMap[$lineId] ?? 0;
            $totRft        = $totRftMap[$lineId] ?? 0;
            $capFilled     = !isset($incompleteCapLines[$lineId]);

            $rft = $totInspect > 0 ? round(($totRft / $totInspect) * 100, 2) : 0;
            $wft = $totInspect > 0 ? round(($totDefect / $totInspect) * 100, 2) : 0;

            // ==== Penentuan Line off & MPS off (berdasarkan worktime) ====
            $lineOff = true;
            $mpsOff  = true;
            $mp      = 0;

            if (session('monitoring')) {
                $wtDate       = Carbon::now();
                $isToday      = true;
                $worktimeline = WorktimeSettingController::getLineWorkingTime($line, $wtDate);
            } else {
                $wtDate       = Carbon::parse(session('endline.date'));
                $isToday      = $wtDate->format('Y-m-d') == Carbon::now()->format('Y-m-d');
                $worktimeline = WorktimeSettingController::getLineWorkingTimeShift($line, $wtDate, session('endline.shift'));
            }

            if ($worktimeline) {
                $lineOff = false;

                $worktime = $worktimeline->workingtime;
                $range    = WorktimeSettingController::get_worktime_range($worktimeline, $worktime);
                $swt      = $range->startworktime;
                $fwt      = $range->finishworktime;

                if ($swt->greaterThan($fwt)) {
                    $fwt->addDay();
                }

                $startTime = Carbon::parse($swt)->subMinute($mpLineParam);
                $endTime   = $isToday
                    ? Carbon::now()->addMinute($mpLineParam)
                    : Carbon::parse($startTime)->addHour();

                try {
                    $attendance = EmployeeAttendance::where('factory_id', session('db')->iddb)
                        ->where('group_id', $lineId)
                        ->whereBetween('time', [$startTime, $endTime])
                        ->where('is_efficiency', 1)
                        ->where('shift', $worktime->shift)
                        ->selectRaw("status, COUNT(*) as total")
                        ->groupBy('status')
                        ->pluck('total', 'status');

                    $inCount  = $attendance['IN'] ?? 0;
                    $outCount = $attendance['OUT'] ?? 0;
                    $allCount = $attendance->sum();

                    if ($isToday) {
                        $mp = max(0, $inCount - $outCount + $mpMinusParam);
                    } else {
                        $mp = max(0, $inCount - ($allCount - $inCount) + $mpMinusParam);
                    }
                } catch (\Exception $e) {
                    $mp = 0;
                }

                $mpsOff = $mp <= 0;
            }

            return [
                'kodegroup'      => $line->kodegroup,
                'namagroup'      => $line->namagroup,
                'line_id'        => $lineId,
                'tot_inspect'    => $totInspect,
                'tot_defect'     => $totDefect,
                'tot_defect_cap'     => $totDefectCap,
                'oil_defect'     => $oilDefect,
                'defect_not_oil' => $defectNotOil,
                'rft'            => $rft,
                'wft'            => $wft,
                'mp'             => $mp,
                'line_off'       => $lineOff,
                'mps_off'        => $mpsOff,
                'cap_filled'     => $capFilled,
            ];
        });

        return view('monitoring::endlineperformance.tls.index', [
            'line' => $lines,
        ]);
    }
