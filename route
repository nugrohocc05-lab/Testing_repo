// Ganti bagian totInspect/totDefect/totRft + Process/Non-Process di getWeeklyData:

// totInspect, totDefect, totRft — 1 query, tanpa join (sama koneksi dgn SewingOutput)
$stats = (clone $headerQuery)->selectRaw("
        SUM(CASE WHEN is_qc = 1 THEN 1 ELSE 0 END) as tot_inspect,
        SUM(CASE WHEN defect_code IS NOT NULL THEN 1 ELSE 0 END) as tot_defect,
        SUM(CASE WHEN is_qc = 1 AND is_output = 1 AND qc_seq = 0 AND defect_code IS NULL
            THEN 1 ELSE 0 END) as tot_rft
    ")
    ->first();

$totInspect = (int) ($stats->tot_inspect ?? 0);
$totDefect  = (int) ($stats->tot_defect ?? 0);
$totRft     = (int) ($stats->tot_rft ?? 0);

$rft = $totInspect > 0 ? round(($totRft / $totInspect) * 100, 2) : 0;
$wft = $totInspect > 0 ? round(($totDefect / $totInspect) * 100, 2) : 0;

// Process / Non-Process — agregasi per defect_code dulu (SQL, koneksi SewingOutput),
// baru category-nya dicocokkan di PHP, TAPI hanya untuk defect_code unik (puluhan),
// bukan per baris defect (ribuan). Tidak ada join lintas-DB.
$defectCountsByCode = (clone $headerQuery)
    ->whereNotNull('defect_code')
    ->select('defect_code', DB::raw('COUNT(*) as total'))
    ->groupBy('defect_code')
    ->get()
    ->pluck('total', 'defect_code');

$categoryMap = QCDefect::whereIn('kdcacat', $defectCountsByCode->keys())
    ->pluck('category', 'kdcacat');

$processQty           = 0;
$nonProcessQty         = 0;
$nonProcessQtyNoGrade = 0;

foreach ($defectCountsByCode as $code => $total) {
    $category = (int) ($categoryMap[$code] ?? 0);

    if ($category === 1) {
        $processQty += $total;
        continue;
    }

    $nonProcessQty += $total;

    if (!in_array($code, [800, 900, 888])) {
        $nonProcessQtyNoGrade += $total;
    }
}

$totDefectProcess = $processQty + $nonProcessQty;

$processPercent = $totDefectProcess > 0
    ? round(($processQty / $totDefectProcess) * 100, 2)
    : 0;

$nonProcessPercent = $totDefectProcess > 0
    ? round(($nonProcessQtyNoGrade / $totDefectProcess) * 100, 2)
    : 0;