// 1 query menggabungkan: totInspect, totDefect, totRft, dan hitung Process/Non-Process
// (sebelumnya: 3 query count + tarik SEMUA baris defect_code ke PHP untuk dihitung manual)
$stats = (clone $headerQuery)
    ->leftJoin("$qc", "$qc.kdcacat", '=', "$so.defect_code")
    ->selectRaw("
        SUM(CASE WHEN $so.is_qc = 1 THEN 1 ELSE 0 END) as tot_inspect,
        SUM(CASE WHEN $so.defect_code IS NOT NULL THEN 1 ELSE 0 END) as tot_defect,
        SUM(CASE WHEN $so.is_qc = 1 AND $so.is_output = 1 AND $so.qc_seq = 0
                 AND $so.defect_code IS NULL
            THEN 1 ELSE 0 END) as tot_rft,
        SUM(CASE WHEN $so.defect_code IS NOT NULL AND COALESCE($qc.category, 0) = 1
            THEN 1 ELSE 0 END) as process_qty,
        SUM(CASE WHEN $so.defect_code IS NOT NULL AND COALESCE($qc.category, 0) = 0
            THEN 1 ELSE 0 END) as non_process_qty,
        SUM(CASE WHEN $so.defect_code IS NOT NULL AND COALESCE($qc.category, 0) = 0
                 AND $so.defect_code NOT IN (800, 900, 888)
            THEN 1 ELSE 0 END) as non_process_qty_no_grade
    ")
    ->first();

