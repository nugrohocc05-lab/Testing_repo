<script>
$(function () {
    let weeklyDataTable = null;
    let isTableLoading = false;

    // Datatables
    function destroyPerformanceDataTable() {
        if ($.fn.DataTable.isDataTable('#tableInlinePerformance')) {
            $('#tableInlinePerformance').DataTable().destroy();
        }
        weeklyDataTable = null;
    }

    function initPerformanceDataTable() {
        if ($('#tableInlinePerformanceBody tr').length === 0) return;

        destroyPerformanceDataTable();

        weeklyDataTable = $('#tableInlinePerformance').DataTable({
            paging: false,
            ordering: false,
            searching: false,
            info: false,
            lengthChange: false,
            autoWidth: false,
            dom: ''
        });
    }

    function exportExcel() {
        const workbook = XLSX.utils.book_new();
        const exportData = [];

        const styleRange = (worksheet, startRow, endRow, startCol, endCol, style) => {
            for (let row = startRow; row <= endRow; row++) {
                for (let col = startCol; col <= endCol; col++) {
                    const cell = XLSX.utils.encode_cell({ r: row, c: col });
                    if (worksheet[cell]) worksheet[cell].s = style;
                }
            }
        };

        // Style Definitions
        const borderBase = { style: 'thin', color: { rgb: 'B7B7B7' } };
        const border = { top: borderBase, bottom: borderBase, left: borderBase, right: borderBase };

        const titleStyle = {
            font: { bold: true, color: { rgb: 'FFFFFF' }, sz: 12 },
            fill: { fgColor: { rgb: '1B2433' } },
            alignment: { horizontal: 'left', vertical: 'center' },
            border: border
        };

        const headerStyle = {
            font: { bold: true, color: { rgb: 'FFFFFF' } },
            fill: { fgColor: { rgb: '242E3E' } },
            alignment: { horizontal: 'center', vertical: 'center', wrapText: true },
            border: border
        };

        const bodyStyle = { alignment: { vertical: 'center' }, border: border };
        const centerStyle = { alignment: { horizontal: 'center', vertical: 'center' }, border: border };

        // --- TABLE 1: Weekly Performance ---
        const performanceTitleRow = exportData.length;
        exportData.push(['WEEKLY ENDLINE PERFORMANCE']);

        const performanceHeaderRow = exportData.length;
        exportData.push([
            'Week', 'Periode Date', 'RFT QTY (Pcs)', 'Inspect QTY (Pcs)',
            'Defect QTY (Pcs)', 'RFT (%)', 'WFT (%)', 'Non Process (%)', 'Process (%)'
        ]);

        const performanceStartRow = exportData.length;
        if (weeklyDataTable && $.fn.DataTable.isDataTable('#tableInlinePerformance')) {
            weeklyDataTable.rows().every(function () {
                const row = this.data();
                exportData.push(row.map(value => $('<div>').html(value).text().trim()));
            });
        } else {
            const performanceTable = document.getElementById('tableInlinePerformance');
            const sheet = XLSX.utils.table_to_sheet(performanceTable, { raw: true });
            const data = XLSX.utils.sheet_to_json(sheet, { header: 1 });
            exportData.push(...data.slice(1));
        }
        const performanceEndRow = exportData.length - 1;

        // Space Between Tables
        exportData.push([]);

        // --- TABLE 2: Top 5 Defect Detail ---
        const defectTitleRow = exportData.length;
        exportData.push(['TOP 5 DEFECT DETAIL']);

        const defectHeaderRow = exportData.length;
        exportData.push([
            'No.', 'Defect', 'Defect QTY', '% of Total Defect',
            'Top Style (Most Contribute)', 'QTY Defect (Pcs)', '% of Defect'
        ]);

        const defectStartRow = exportData.length;
        const defectTable = document.getElementById('tableInlineDefect');
        const defectSheet = XLSX.utils.table_to_sheet(defectTable, { raw: true });
        const defectData = XLSX.utils.sheet_to_json(defectSheet, { header: 1 });
        exportData.push(...defectData.slice(1));
        const defectEndRow = exportData.length - 1;

        const worksheet = XLSX.utils.aoa_to_sheet(exportData);

        // Adjust Column Widths
        worksheet['!cols'] = [
            { wch: 10 }, { wch: 30 }, { wch: 15 }, { wch: 20 },
            { wch: 30 }, { wch: 18 }, { wch: 15 }, { wch: 18 }, { wch: 15 }
        ];

        // Merge Titles
        worksheet['!merges'] = [
            { s: { r: performanceTitleRow, c: 0 }, e: { r: performanceTitleRow, c: 8 } },
            { s: { r: defectTitleRow, c: 0 }, e: { r: defectTitleRow, c: 6 } }
        ];

        // Apply Styles
        styleRange(worksheet, performanceTitleRow, performanceTitleRow, 0, 8, titleStyle);
        styleRange(worksheet, performanceHeaderRow, performanceHeaderRow, 0, 8, headerStyle);

        if (performanceEndRow >= performanceStartRow) {
            styleRange(worksheet, performanceStartRow, performanceEndRow, 0, 8, bodyStyle);
            styleRange(worksheet, performanceStartRow, performanceEndRow, 0, 0, centerStyle);
            styleRange(worksheet, performanceStartRow, performanceEndRow, 2, 8, centerStyle);
        }

        styleRange(worksheet, defectTitleRow, defectTitleRow, 0, 8, titleStyle);
        styleRange(worksheet, defectHeaderRow, defectHeaderRow, 0, 6, headerStyle);

        if (defectEndRow >= defectStartRow) {
            styleRange(worksheet, defectStartRow, defectEndRow, 0, 6, bodyStyle);
            styleRange(worksheet, defectStartRow, defectEndRow, 0, 0, centerStyle);
            styleRange(worksheet, defectStartRow, defectEndRow, 2, 3, centerStyle);
            styleRange(worksheet, defectStartRow, defectEndRow, 5, 6, centerStyle);
        }

        worksheet['!rows'] = [];
        worksheet['!rows'][performanceTitleRow] = { hpt: 25 };
        worksheet['!rows'][performanceHeaderRow] = { hpt: 25 };
        worksheet['!rows'][defectTitleRow] = { hpt: 25 };
        worksheet['!rows'][defectHeaderRow] = { hpt: 25 };
        worksheet['!freeze'] = { xSplit: 0, ySplit: performanceHeaderRow + 1 };

        XLSX.utils.book_append_sheet(workbook, worksheet, 'Weekly Report');

        let selectedWeek = $('#selectWeek option:selected').text() || 'Weekly Performance';
        selectedWeek = selectedWeek.replace(/[\\/:*?"<>|]/g, '-').trim();
        const fileName = `Report_Weekly_Endline_${selectedWeek}.xlsx`;

        XLSX.writeFile(workbook, fileName);
    }

    $('#selectWeek').select2({
        placeholder: 'Select Week',
        width: '100%',
        ajax: {
            url: "{{ route('monitoring_endlineperformance_selectweek') }}",
            type: "GET",
            dataType: "json",
            delay: 500,
            data: params => ({ q: params.term, page: params.page || 1 }),
            processResults: data => ({ results: data.results, pagination: data.pagination }),
            cache: true
        }
    });

    // Fetch Current Week
    $.get("{{ route('monitoring_endlineperformance_currentweek') }}")
        .done(res => {
            if (!res?.selected?.id) {
                console.error('Current week not found.', res);
                return;
            }
            const option = new Option(res.selected.text, res.selected.id, true, true);
            $('#selectWeek').append(option).trigger('change');
        })
        .fail(xhr => console.error('Failed to retrieve the current week.', xhr));

    // Handle Week Change
    $('#selectWeek').on('change', function () {
        const weekId = $(this).val();
        if (!weekId) return;

        isTableLoading = true;
        destroyPerformanceDataTable();

        const week = weekId.split('-')[1];
        $(document).trigger('week:changed', { week_id: weekId });
        $('.subheader').text(`TOP 5 DEFECT DETAIL (WEEK ${week})`);

        $.get("{{ route('monitoring_endlineperformance_data') }}", { week_id: weekId })
            .done(html => {
                const $res = $(html);

                ['#tableInlinePerformanceBody', '#tableInlineDefectBody', '#tableInlineDefectFoot'].forEach(selector => {
                    const content = $res.find(selector);
                    if (content.length) $(selector).html(content.html());
                });

                initPerformanceDataTable();
            })
            .fail(xhr => console.error('Failed to get data.', xhr))
            .always(() => isTableLoading = false);
    });

    $('#export-datatable-btn').off('click.exportExcel').on('click.exportExcel', function (e) {
        e.preventDefault();
        e.stopPropagation();

        if (isTableLoading) {
            console.warn('Data is still loading, export cancelled.');
            return;
        }
        exportExcel();
    });
});
</script>

