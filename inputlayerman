$(document).on('input', DEC_SEL, function() {
    var v = this.value.replace(/[^0-9.]/g, '');
    var dot = v.indexOf('.');

    if (dot !== -1) {
        // hanya satu titik, dan maksimal 4 angka sesudahnya
        v = v.slice(0, dot + 1) + v.slice(dot + 1).replace(/\./g, '').slice(0, 4);
    }

    if (v !== this.value) this.value = v;
});



function numVal(n) {
    if (!n || parseFloat(n) === 0) return '';
    return esc(+parseFloat(n).toFixed(4));
}

