
// Gabungan shade dari semua card, unik, dipisah koma. Contoh: "1,2"
// Card dengan Actual Plies 0 tidak dihitung.
private function shadeText(Request $request)
{
    $shades = [];

    foreach ($request->input('shades', []) as $row) {
        if ((int) data_get($row, 'actual_plies', 0) <= 0) {
            continue;
        }

        foreach (explode(',', (string) data_get($row, 'shade', '')) as $s) {
            $s = trim($s);

            if ($s !== '' && !in_array($s, $shades, true)) {
                $shades[] = $s;
            }
        }
    }

    return implode(',', $shades);
}

$this->partDetailsQuery($header, $detail)
    ->update([
        'actual_plies'   => $lay->actual_plies,
        'shade'          => $this->shadeText($request),
        'lays_completed' => now(),
    ]);

