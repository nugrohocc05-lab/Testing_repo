    <script>
        $(document).ready(function() {
            var urls = {
                play: "{{ route('intellocutlayerman_play', ['id' => $detail->id]) }}",
                stop: "{{ route('intellocutlayerman_stop', ['id' => $detail->id]) }}",
                save: "{{ route('intellocutlayerman_save', ['id' => $detail->id]) }}",
                home: "{{ route('intellocutlayerman_home') }}"
            };
            var saved      = {!! json_encode($saved ?? null, JSON_HEX_TAG | JSON_HEX_AMP) !!};
            var totalRatio = {{ $ratioSize->sum('ratio') }};
            var draftKey   = 'layerman_draft_{{ $header->id }}_{{ $detail->lay }}';

            var started    = false;
            var draftReady = false;
            var draftTimer = null;

            var MEASURE_FIELDS = ['material_width', 'material_length', 'end_loss_1', 'end_loss_2'];

            // Yard & plies: angka saja. Inch: angka dan satu titik. Shade: bebas.
            var INT_SEL = '[data-unit="yard"], .input-endbit-yard, .input-splice-length-yard, ' +
                          '.input-splice-wastage-yard, .input-damages-yard, .input-actual-plies';
            var DEC_SEL = '[data-unit="inch"], .input-endbit-inch, .input-splice-length-inch, ' +
                          '.input-splice-wastage-inch, .input-damages-inch';

            // ---------- Utilitas ----------
            function esc(value) {
                return String(value === null || value === undefined ? '' : value)
                    .replace(/&/g, '&amp;')
                    .replace(/"/g, '&quot;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            }

            function numVal(n) {
                return (n && parseFloat(n) !== 0) ? esc(n) : '';
            }

            function post(url, data) {
                return $.ajax({
                    url: url,
                    type: 'POST',
                    data: JSON.stringify(data || {}),
                    contentType: 'application/json',
                    dataType: 'json',
                    headers: { 'X-CSRF-TOKEN': '{{ csrf_token() }}' }
                });
            }

            function alertBox(icon, title, text, onClose) {
                swal({
                    title: title,
                    text: text,
                    icon: icon,
                    buttons: {
                        confirm: { text: 'Close', value: true, visible: true, closeModal: true }
                    }
                }).then(function() {
                    if (onClose) onClose();
                });
            }

            function showError(xhr) {
                var message = 'An error occurred. Please try again.';

                if (xhr.responseJSON && xhr.responseJSON.errors) {
                    message = xhr.responseJSON.errors[Object.keys(xhr.responseJSON.errors)[0]][0];
                } else if (xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                }

                $('#loading').hide();
                alertBox('warning', 'Warning!', message);
            }

            // ---------- Jam ----------
            function updateClock() {
                var formatted = new Date().toLocaleDateString('en-US', {
                    weekday: 'long',
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                });
                var p = formatted.replace(',', '').split(' ');
                $('#live-date').text(p[0] + ', ' + p[1] + ' ' + p[2] + ' ' + p[3]);
            }
            updateClock();
            setInterval(updateClock, 1000);

            // ---------- Pembatasan input ----------
            $(document).on('input', INT_SEL, function() {
                var v = this.value.replace(/[^0-9]/g, '');
                if (v !== this.value) this.value = v;
            });

            $(document).on('input', DEC_SEL, function() {
                var v = this.value.replace(/[^0-9.]/g, '');
                var dot = v.indexOf('.');
                if (dot !== -1) v = v.slice(0, dot + 1) + v.slice(dot + 1).replace(/\./g, '');
                if (v !== this.value) this.value = v;
            });

            $(document).on('blur', DEC_SEL, function() {
                if (this.value === '.') this.value = '';
            });

            $(document).on('focusin', INT_SEL, function() { this.setAttribute('inputmode', 'numeric'); });
            $(document).on('focusin', DEC_SEL, function() { this.setAttribute('inputmode', 'decimal'); });

            // ---------- Play / Pause ----------
            function setRunning(on) {
                started = on;

                $('.lay-input, .lay-action').prop('disabled', !on);
                $('#topBar').toggleClass('running', on);
                $('#btnPlay').toggleClass('playing', on)
                    .attr('title', on ? 'Pause' : 'Play')
                    .html('<i class="bi bi-' + (on ? 'pause' : 'play') + '-fill" style="font-size: 25px;"></i>');
            }

            $('#btnPlay').on('click', function() {
                var $btn = $(this).prop('disabled', true);
                var turningOn = !started;

                if (!turningOn) saveDraft();

                post(turningOn ? urls.play : urls.stop)
                    .done(function() { setRunning(turningOn); })
                    .fail(showError)
                    .always(function() { $btn.prop('disabled', false); });
            });

            // ---------- Template ----------
            function yardInch(clsYard, clsInch, value, maxWidth) {
                value = value || {};

                var width = maxWidth > 0
                    ? 'max-width: ' + maxWidth + 'px;'
                    : 'min-width: 0; width: 100%; flex: 1;';

                return `
                    <input type="text" inputmode="numeric"
                        class="form-control shadow-none lay-input ${clsYard}"
                        placeholder="0" value="${numVal(value.yard)}" style="${width}">
                    <span class="text-nowrap me-1" style="font-size: 14px; font-weight: 600; color: #64748b;">- Yard</span>
                    <input type="text" inputmode="decimal"
                        class="form-control shadow-none lay-input ${clsInch}"
                        placeholder="0" value="${numVal(value.inch)}" style="${width}">
                    <span class="text-nowrap" style="font-size: 14px; font-weight: 600; color: #64748b;">- Inch</span>`;
            }

            function plusButton(cls) {
                return `
                    <button type="button"
                        class="btn lay-action ${cls} p-0 border-0 rounded-circle d-inline-flex align-items-center justify-content-center text-white"
                        style="width: 24px; height: 24px; background-color: #3b93b8; flex-shrink: 0;">
                        <i class="bi bi-plus-lg" style="font-size: 12px;"></i>
                    </button>`;
            }

            function endbitRowTemplate(value) {
                return `
                    <div class="endbit-row d-flex align-items-center gap-2" style="width: fit-content; flex-shrink: 0;">
                        ${yardInch('input-endbit-yard', 'input-endbit-inch', value, 100)}
                        ${plusButton('btn-add-endbit')}
                    </div>`;
            }

            function spliceRowTemplate(splice) {
                splice = splice || {};

                return `
                    <div class="splice-row d-flex flex-wrap align-items-end gap-4 px-4 py-3" style="border-bottom: 1px solid #f1f5f9;">
                        <div style="width: 56px; flex-shrink: 0;">
                            <label class="form-label mb-2" style="font-size: 14px; font-weight: 600; color: #475569;">Heading</label>
                            <div class="splice-heading d-flex align-items-center"
                                style="height: 34px; font-size: 13px; font-weight: 700; color: #1e293b;">1</div>
                        </div>

                        <div class="flex-grow-1" style="min-width: 200px;">
                            <label class="form-label mb-2" style="font-size: 14px; font-weight: 600; color: #475569;">Length</label>
                            <div class="d-flex align-items-center gap-2 w-100">
                                ${yardInch('input-splice-length-yard', 'input-splice-length-inch', splice.length, 0)}
                            </div>
                        </div>

                        <div class="flex-grow-1" style="min-width: 200px;">
                            <label class="form-label mb-2" style="font-size: 14px; font-weight: 600; color: #475569;">Wastage</label>
                            <div class="d-flex align-items-center gap-2 w-100">
                                ${yardInch('input-splice-wastage-yard', 'input-splice-wastage-inch', splice.wastage, 0)}
                                ${plusButton('btn-add-splice')}
                            </div>
                        </div>
                    </div>`;
            }

            function shadeTemplate(shade, removable) {
                shade = shade || {};

                var endbits = (shade.endbits_generated && shade.endbits_generated.length)
                    ? shade.endbits_generated
                    : [{}];
                var endbitRows = endbits.map(endbitRowTemplate).join('');

                var removeButton = removable ? `
                    <div class="d-flex justify-content-end mb-2">
                        <button type="button" class="btn lay-action btn-remove-shade p-0 border-0 text-danger"
                            style="font-size: 14px; font-weight: 600;">
                            <i class="bi bi-trash"></i> Remove Shade
                        </button>
                    </div>` : '';

                var itemClass = removable ? 'shade-item pt-4 mt-4' : 'shade-item';
                var itemStyle = removable ? 'border-top: 1px solid #e2e8f0;' : '';

                return `
                    <div class="${itemClass}" style="${itemStyle}">
                        ${removeButton}

                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <label class="form-label mb-2" style="font-size: 14px; font-weight: 700; color: #334155;">Shade</label>
                                <input type="text" class="form-control shadow-none lay-input input-shade w-100"
                                    value="${esc(shade.shade || '')}">
                            </div>

                            <div class="col-md-4">
                                <label class="form-label mb-2" style="font-size: 14px; font-weight: 700; color: #334155;">Actual Plies</label>
                                <input type="text" inputmode="numeric"
                                    class="form-control shadow-none lay-input input-actual-plies w-100"
                                    placeholder="0" value="${numVal(shade.actual_plies)}">
                            </div>

                            <div class="col-md-4">
                                <label class="form-label mb-2" style="font-size: 14px; font-weight: 700; color: #334155;">Damages</label>
                                <div class="d-flex align-items-center gap-2 w-75">
                                    ${yardInch('input-damages-yard', 'input-damages-inch', shade.damages, 0)}
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label mb-2" style="font-size: 14px; font-weight: 700; color: #334155;">Endbits Generated</label>
                            <div class="endbits-list d-flex flex-wrap align-items-center gap-2">${endbitRows}</div>
                        </div>
                    </div>`;
            }

            // Baris terakhir memakai tombol +, baris lain tombol -
            function syncRowButtons($rows, addClass, removeClass) {
                $rows.each(function(index) {
                    var $btn = $(this).find('.lay-action').last();
                    var isLast = index === $rows.length - 1;

                    $btn.removeClass(isLast ? removeClass : addClass)
                        .addClass(isLast ? addClass : removeClass)
                        .css('background-color', isLast ? '#3b93b8' : '#ef4444')
                        .html('<i class="bi bi-' + (isLast ? 'plus' : 'dash') + '-lg" style="font-size: 12px;"></i>');
                });
            }

            // ---------- Endbits ----------
            function syncEndbitButtons($list) {
                syncRowButtons($list.find('.endbit-row'), 'btn-add-endbit', 'btn-remove-endbit');
            }

            $(document).on('click', '.btn-add-endbit', function() {
                if (!started) return;
                var $list = $(this).closest('.endbits-list');
                $list.append(endbitRowTemplate());
                syncEndbitButtons($list);
            });

            $(document).on('click', '.btn-remove-endbit', function() {
                if (!started) return;
                var $list = $(this).closest('.endbits-list');
                $(this).closest('.endbit-row').remove();
                syncEndbitButtons($list);
            });

            // ---------- Splice ----------
            function updateSpliceWastage() {
                var totalInch = 0;

                $('#spliceList .splice-row').each(function() {
                    totalInch += (parseFloat($(this).find('.input-splice-wastage-yard').val()) || 0) * 36
                        + (parseFloat($(this).find('.input-splice-wastage-inch').val()) || 0);
                });

                $('#sumWastageYard').val(Math.floor(totalInch / 36));
                $('#sumWastageInch').val(+(totalInch % 36).toFixed(4));
            }

            function syncSpliceRows() {
                var $rows = $('#spliceList .splice-row');

                $rows.each(function(index) {
                    $(this).find('.splice-heading').text(index + 1);
                });

                syncRowButtons($rows, 'btn-add-splice', 'btn-remove-splice');
                updateSpliceWastage();
            }

            function addSpliceRow(splice) {
                $('#spliceList').append(spliceRowTemplate(splice));
                syncSpliceRows();
            }

            $(document).on('input', '.input-splice-wastage-yard, .input-splice-wastage-inch', updateSpliceWastage);

            $('#btnAddSplice').on('click', function() {
                if (started) addSpliceRow();
            });

            $(document).on('click', '.btn-add-splice', function() {
                if (started) addSpliceRow();
            });

            $(document).on('click', '.btn-remove-splice', function() {
                if (!started) return;
                $(this).closest('.splice-row').remove();
                syncSpliceRows();
            });

            // ---------- Shade & plies ----------
            function updateActualPlies() {
                var total = 0;

                $('.input-actual-plies').each(function() {
                    total += parseFloat($(this).val()) || 0;
                });

                $('#topActualPlies, #summaryActualPlies').text(total);
                $('#topCutQty').text(totalRatio * total);
            }

            $(document).on('input', '.input-actual-plies', updateActualPlies);

            function renderShades(list) {
                $('#shadeContainer').empty();

                list.forEach(function(shade, index) {
                    $('#shadeContainer').append(shadeTemplate(shade, index > 0));
                });

                $('.endbits-list').each(function() {
                    syncEndbitButtons($(this));
                });
            }

            $('#btnAddNewShade').on('click', function() {
                if (!started) return;
                var $shade = $(shadeTemplate({}, true));
                $('#shadeContainer').append($shade);
                syncEndbitButtons($shade.find('.endbits-list'));
            });

            $(document).on('click', '.btn-remove-shade', function() {
                if (!started) return;
                $(this).closest('.shade-item').remove();
                updateActualPlies();
            });

            // ---------- Payload ----------
            function readField(field) {
                return {
                    yard: $('[data-field="' + field + '"][data-unit="yard"]').val(),
                    inch: $('[data-field="' + field + '"][data-unit="inch"]').val()
                };
            }

            function collectPayload() {
                var splices = $('#spliceList .splice-row').map(function() {
                    var $row = $(this);
                    return {
                        length: {
                            yard: $row.find('.input-splice-length-yard').val(),
                            inch: $row.find('.input-splice-length-inch').val()
                        },
                        wastage: {
                            yard: $row.find('.input-splice-wastage-yard').val(),
                            inch: $row.find('.input-splice-wastage-inch').val()
                        }
                    };
                }).get();

                var shades = $('.shade-item').map(function() {
                    var $item = $(this);

                    var endbits = $item.find('.endbit-row').map(function() {
                        return {
                            yard: $(this).find('.input-endbit-yard').val(),
                            inch: $(this).find('.input-endbit-inch').val()
                        };
                    }).get();

                    return {
                        shade: $item.find('.input-shade').val(),
                        actual_plies: $item.find('.input-actual-plies').val(),
                        damages: {
                            yard: $item.find('.input-damages-yard').val(),
                            inch: $item.find('.input-damages-inch').val()
                        },
                        endbits_generated: endbits
                    };
                }).get();

                var payload = { splices: splices, shades: shades };

                MEASURE_FIELDS.forEach(function(field) {
                    payload[field] = readField(field);
                });

                return payload;
            }

            // ---------- Draft (hanya di browser, tidak dikirim ke server) ----------
            function saveDraft() {
                if (!draftReady) return;
                try { localStorage.setItem(draftKey, JSON.stringify(collectPayload())); } catch (e) {}
            }

            function readDraft() {
                try { return JSON.parse(localStorage.getItem(draftKey) || 'null'); } catch (e) { return null; }
            }

            function clearDraft() {
                try { localStorage.removeItem(draftKey); } catch (e) {}
            }

            $(document).on('input change click', '.lay-input, .lay-action', function() {
                clearTimeout(draftTimer);
                draftTimer = setTimeout(saveDraft, 300);
            });

            // ---------- Save ----------
            $('#btnSaveChanges').on('click', function() {
                if (!started) return;

                var $btn = $(this).prop('disabled', true);

                post(urls.save, collectPayload())
                    .done(function(res) {
                        clearDraft();
                        alertBox('success', 'Success!', 'Data has been successfully saved.', function() {
                            $('#loading').show();
                            window.location.href = res.redirect || urls.home;
                        });
                    })
                    .fail(function(xhr) {
                        showError(xhr);
                        $btn.prop('disabled', false);
                    });
            });

            // ---------- Isi form saat halaman dibuka ----------
            function fillField(field, value) {
                value = value || {};
                $('[data-field="' + field + '"][data-unit="yard"]').val(numVal(value.yard));
                $('[data-field="' + field + '"][data-unit="inch"]').val(numVal(value.inch));
            }

            function loadForm() {
                var isCompleted = !!(saved && saved.status === 'completed');

                if (isCompleted) clearDraft();

                // Lay selesai: data database. Selain itu: draft browser diutamakan.
                var source = isCompleted ? saved : (readDraft() || saved);

                if (source) {
                    MEASURE_FIELDS.forEach(function(field) {
                        fillField(field, source[field]);
                    });
                    (source.splices || []).forEach(addSpliceRow);
                }

                renderShades(source && source.shades && source.shades.length ? source.shades : [{}]);
                updateSpliceWastage();
                updateActualPlies();

                setRunning(!!(saved && saved.status === 'running'));

                if (isCompleted) {
                    $('#btnPlay, #btnSaveChanges, #btnAddNewShade, #btnAddSplice').hide();
                }

                draftReady = !isCompleted;
            }

            loadForm();
        });
    </script>
@endsection
