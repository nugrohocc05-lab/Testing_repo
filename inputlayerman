// Kolom dan nilai status di tabel intellocut_header. Sesuaikan dengan database.
private const HEADER_STATUS_COLUMN = 'status';
private const HEADER_STATUS_DONE   = 'completed';

// Kalau semua lay di order ini sudah selesai, tandai header completed
$this->completeHeaderIfFinished($header);

// Header ditandai completed hanya kalau SEMUA baris shell detail order ini sudah selesai.
private function completeHeaderIfFinished($header)
{
    $shellHeaderIds = IntellocutShellHeader::where('idheader', $header->id)->pluck('id');

    $hasUnfinished = IntellocutShellDetail::whereIn('idshellheader', $shellHeaderIds)
        ->whereNull('lays_completed')
        ->exists();

    if ($hasUnfinished) {
        return;
    }

    IntellocutHeader::where('id', $header->id)
        ->update([self::HEADER_STATUS_COLUMN => self::HEADER_STATUS_DONE]);
}

