    <script>
        $(document).ready(function() {
            var urls = {
                play: "{{ route('intellocutlayerman_play', ['id' => $detail->id]) }}",
                stop: "{{ route('intellocutlayerman_stop', ['id' => $detail->id]) }}",
                save: "{{ route('intellocutlayerman_save', ['id' => $detail->id]) }}",
                endbits: "{{ route('intellocutlayerman_endbits', ['id' => $detail->id]) }}",
                home: "{{ route('intellocutlayerman_home') }}"
            };
            var saved      = {!! json_encode($saved ?? null, JSON_HEX_TAG | JSON_HEX_AMP) !!};
            var totalRatio = {{ $ratioSize->sum('ratio') }};
            var draftKey   = 'layerman_draft_{{ $header->id }}_{{ $detail->idtable }}_{{ $detail->lay }}_{{ $detail->idshell }}';

            var PLANNED_PLIES = {{ (int) $plannedPlies }};

            var started    = false;
            var draftReady = false;
            var draftTimer = null;

            var endbitData = {};   // id endbit -> data (hasil fetch)
            var EMPTY_LIST = '<span style="font-size: 12px; color: #94a3b8;">No endbits available</span>';

            var MEASURE_FIELDS = ['material_width', 'material_length', 'end_loss'];

            var FIELD_LABELS = {
                material_width: 'Material Width',
                material_length: 'Material Length',
                end_loss: 'End Loss'
            };

            var GROUP_OPTIONS = {!! json_encode($groupOptions, JSON_HEX_TAG | JSON_HEX_AMP) !!}.map(String);
            var DEFAULT_GROUP = "{{ $detail->group }}";

            var DEFAULTS = {
                material_width:  { yard: {{ $defaultWidth }}, inch: {{ $defaultWidthInch }} },
                material_length: { yard: {{ $defaultLength }}, inch: {{ $defaultLengthInch }} },
                end_loss: {
                    yard: '',
                    inch: {{ $defaultEndLoss ?? 0 }}
                }
            };

            function isEmptyMeasure(v) {
                return !v || ((!v.yard || parseFloat(v.yard) === 0) && (!v.inch || parseFloat(v.inch) === 0));
            }

            var INT_SEL = '.input-actual-plies';

            var DEC_SEL = [
                '[data-unit="yard"]',
                '[data-unit="inch"]',
                '.input-endbit-yard',
                '.input-endbit-inch',
                '.input-splice-length-yard',
                '.input-splice-length-inch',
                '.input-splice-wastage-yard',
                '.input-splice-wastage-inch',
                '.input-damages-yard',
                '.input-damages-inch'
            ].join(', ');

            // ---------- Utilitas ----------
            function esc(value) {
                return String(value === null || value === undefined ? '' : value)
                    .replace(/&/g, '&amp;')
                    .replace(/"/g, '&quot;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            }

            function numVal(n) {
                return (n && parseFloat(n) !== 0) ? esc(n) : '';
            }

            function post(url, data) {
                return $.ajax({
                    url: url,
                    type: 'POST',
                    data: JSON.stringify(data || {}),
                    contentType: 'application/json',
                    dataType: 'json',
                    headers: { 'X-CSRF-TOKEN': '{{ csrf_token() }}' }
                });
            }

            function alertBox(icon, title, text, onClose) {
                swal({
                    title: title,
                    text: text,
                    icon: icon,
                    buttons: {
                        confirm: { text: 'Close', value: true, visible: true, closeModal: true }
                    }
                }).then(function() {
                    if (onClose) onClose();
                });
            }

            function showError(xhr) {
                var message = 'An error occurred. Please try again.';

                if (xhr.responseJSON && xhr.responseJSON.errors) {
                    message = xhr.responseJSON.errors[Object.keys(xhr.responseJSON.errors)[0]][0];
                } else if (xhr.responseJSON && xhr.responseJSON.message) {
                    message = xhr.responseJSON.message;
                }

                $('#loading').hide();
                alertBox('warning', 'Warning!', message);
            }

            // ---------- Jam ----------
            function updateClock() {
                var formatted = new Date().toLocaleDateString('en-US', {
                    weekday: 'long',
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                });
                var p = formatted.replace(',', '').split(' ');
                $('#live-date').text(p[0] + ', ' + p[1] + ' ' + p[2] + ' ' + p[3]);
            }
            updateClock();
            setInterval(updateClock, 1000);

            // ---------- Pembatasan input ----------
            $(document).on('input', INT_SEL, function() {
                var v = this.value.replace(/[^0-9]/g, '');
                if (v !== this.value) this.value = v;
            });

            $(document).on('input', DEC_SEL, function() {
                var v = this.value.replace(/[^0-9.]/g, '');
                var dot = v.indexOf('.');

                if (dot !== -1) {
                    v = v.slice(0, dot + 1) + v.slice(dot + 1).replace(/\./g, '');
                }

                if (v !== this.value) this.value = v;
            });

            $(document).on('blur', DEC_SEL, function() {
                if (this.value === '.') this.value = '';
            });

            $(document).on('focusin', INT_SEL, function() { this.setAttribute('inputmode', 'numeric'); });
            $(document).on('focusin', DEC_SEL, function() { this.setAttribute('inputmode', 'decimal'); });

            // Hilangkan tanda merah saat field diisi
            $(document).on('input', '.lay-input', function() {
                $(this).parent().find('.lay-input').removeClass('is-invalid');
            });

            $(document).on('change', '.input-shade-group', function() {
                $(this).closest('.shade-groups').removeClass('is-invalid-group');
                $(this).removeClass('is-invalid');
            });

            // ---------- Play / Pause ----------
            function setRunning(on) {
                started = on;

                $('.lay-input, .lay-action, .lay-check').prop('disabled', !on);

                $('[data-field="material_width"], [data-field="material_length"], [data-field="end_loss"]')
                    .prop('disabled', true);

                $('#topBar').toggleClass('running', on);

                $('#btnPlay').toggleClass('playing', on)
                    .attr('title', on ? 'Pause' : 'Play')
                    .html('<i class="bi bi-' + (on ? 'pause' : 'play') + '-fill" style="font-size: 20px;"></i>');

                // Checkbox endbit ikut aktif/nonaktif sesuai status Play
                syncEndbitChecks();
            }

            $('#btnPlay').on('click', function() {
                var $btn = $(this).prop('disabled', true);
                var turningOn = !started;

                if (!turningOn) saveDraft();

                post(turningOn ? urls.play : urls.stop)
                    .done(function() { setRunning(turningOn); })
                    .fail(showError)
                    .always(function() { $btn.prop('disabled', false); });
            });

            // ---------- Template ----------
            function yardInch(clsYard, clsInch, value, maxWidth, req) {
                value = value || {};

                var width = maxWidth > 0
                    ? 'max-width: ' + maxWidth + 'px;'
                    : 'min-width: 0; width: 100%; flex: 1;';
                var r = req ? 'required' : '';

                return `
                    <input type="text" inputmode="numeric" maxlength="10"
                        class="form-control shadow-none lay-input ${clsYard}"
                        placeholder="0" value="${numVal(value.yard)}" style="${width}" ${r}>
                    <span class="text-nowrap me-1" style="font-size: 14px; font-weight: 600; color: #64748b;">- Yard</span>
                    <input type="text" inputmode="decimal" maxlength="10"
                        class="form-control shadow-none lay-input ${clsInch}"
                        placeholder="0" value="${numVal(value.inch)}" style="${width}" ${r}>
                    <span class="text-nowrap" style="font-size: 14px; font-weight: 600; color: #64748b;">- Inch</span>`;
            }

            function actionButton(cls, color, icon) {
                return `
                    <button type="button"
                        class="btn lay-action ${cls} p-0 border-0 rounded-circle d-inline-flex align-items-center justify-content-center text-white"
                        style="width: 24px; height: 24px; background-color: ${color}; flex-shrink: 0;">
                        <i class="bi bi-${icon}-lg" style="font-size: 12px;"></i>
                    </button>`;
            }

            function rowActions() {
                return `
                    <div class="row-actions d-flex align-items-center gap-1"
                        style="min-width: 52px; flex-shrink: 0;">
                    </div>`;
            }

            // sourceId diisi untuk baris yang terisi otomatis dari endbit pilihan.
            // Baris itu terkunci (readonly) dan tidak disimpan sebagai endbit baru.
            function endbitRowTemplate(value, sourceId) {
                var attr = sourceId ? ' data-source-id="' + esc(sourceId) + '"' : '';
                var fields = yardInch('input-endbit-yard', 'input-endbit-inch', value, 100);

                if (sourceId) {
                    fields = fields.replace(/<input /g, '<input readonly ');
                }

                return `
                    <div class="endbit-row d-flex align-items-center gap-2"${attr} style="width: fit-content; flex-shrink: 0;">
                        ${fields}
                        ${rowActions()}
                    </div>`;
            }

            function spliceRowTemplate(splice) {
                splice = splice || {};

                return `
                    <div class="splice-row d-flex flex-wrap align-items-end gap-4 px-4 py-3" style="border-bottom: 1px solid #f1f5f9;">
                        <div style="width: 56px; flex-shrink: 0;">
                            <label class="form-label mb-2" style="font-size: 14px; font-weight: 600; color: #475569;">Heading</label>
                            <div class="splice-heading d-flex align-items-center"
                                style="height: 34px; font-size: 13px; font-weight: 700; color: #1e293b;">1</div>
                        </div>

                        <div class="flex-grow-1" style="min-width: 200px;">
                            <label class="form-label mb-2" style="font-size: 14px; font-weight: 600; color: #475569;">Length <span class="text-danger">*</span></label>
                            <div class="d-flex align-items-center gap-2 w-100">
                                ${yardInch('input-splice-length-yard', 'input-splice-length-inch', splice.length, 0, true)}
                            </div>
                        </div>

                        <div class="flex-grow-1" style="min-width: 200px;">
                            <label class="form-label mb-2" style="font-size: 14px; font-weight: 600; color: #475569;">Wastage <span class="text-danger">*</span></label>
                            <div class="d-flex align-items-center gap-2 w-100">
                                ${yardInch('input-splice-wastage-yard', 'input-splice-wastage-inch', splice.wastage, 0, true)}
                                ${rowActions()}
                            </div>
                        </div>
                    </div>`;
            }

            /**
             * shade.auto:
             *   ''           kartu manual (Shade = dropdown group)
             *   'suggested'  kartu dari 1 endbit Suggested (shade.source_id = id endbit)
             *   'merged'     kartu gabungan dari Use Endbits (Shade = gabungan, dipisah koma)
             *
             * Kartu manual pertama (removable = false) diberi data-base="1".
             * Kartu ini dihapus saat ada kartu endbit, dan dibuat lagi saat semua endbit dilepas.
             */
            function shadeTemplate(shade, removable) {
                shade = shade || {};
                var auto = shade.auto || '';

                // Roll baru: group lay ini. Data tersimpan: sesuai isi shade, bisa "1,2".
                var selected = (shade.shade === undefined)
                    ? [String(DEFAULT_GROUP)]
                    : String(shade.shade).split(',').map(function(s) { return s.trim(); }).filter(Boolean);

                // Dropdown hanya untuk kartu manual dengan satu group yang ada di daftar.
                // Selain itu (otomatis / gabungan koma) tampil sebagai teks terkunci.
                var useSelect = !auto && (shade.shade === undefined
                    || (selected.length === 1 && GROUP_OPTIONS.indexOf(selected[0]) !== -1));

                var shadeField = useSelect ? `
                    <select class="form-select shadow-none lay-input input-shade-group"
                        style="width: 100%; min-width: 120px; font-size: 14px;">
                        ${GROUP_OPTIONS.map(function(g) {
                            return `
                                <option value="${esc(g)}" ${selected.indexOf(g) !== -1 ? 'selected' : ''}>
                                    ${esc(g)}
                                </option>`;
                        }).join('')}
                    </select>` : `
                    <input type="text" class="form-control shadow-none lay-input input-shade-group w-100"
                        value="${esc(selected.join(','))}" placeholder="Auto" readonly>`;

                var endbits = (shade.endbits_generated && shade.endbits_generated.length)
                    ? shade.endbits_generated
                    : [{}];
                var endbitRows = endbits.map(function(v) {
                    return endbitRowTemplate(v, v.source_id);
                }).join('');

                // Kartu otomatis dihapus lewat uncheck, bukan tombol Remove
                var removeButton = (removable && !auto) ? `
                    <div class="d-flex justify-content-end mb-2">
                        <button type="button" class="btn lay-action btn-remove-shade p-0 border-0 text-danger"
                            style="font-size: 14px; font-weight: 600;">
                            <i class="bi bi-trash"></i> Remove Roll
                        </button>
                    </div>` : '';

                var isBase = !removable && !auto;
                var itemClass = removable ? 'shade-item pt-4 mt-4' : 'shade-item';
                var itemStyle = removable ? 'border-top: 1px solid #e2e8f0;' : '';
                var sourceAttr = (auto === 'suggested' && shade.source_id)
                    ? ' data-source-id="' + esc(shade.source_id) + '"' : '';

                return `
                    <div class="${itemClass}" style="${itemStyle}" data-auto="${esc(auto)}"${sourceAttr}${isBase ? ' data-base="1"' : ''}>
                        ${removeButton}

                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <label class="form-label mb-2" style="font-size: 14px; font-weight: 700; color: #334155;">Shade <span class="text-danger">*</span></label>
                                <div class="shade-groups d-flex flex-wrap gap-2 align-items-center" style="min-height: 34px;">
                                    ${shadeField}
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label mb-2" style="font-size: 14px; font-weight: 700; color: #334155;">Actual Plies <span class="text-danger">*</span></label>
                                <input type="text" inputmode="numeric"
                                    class="form-control shadow-none lay-input input-actual-plies w-100"
                                    placeholder="0" value="${numVal(shade.actual_plies)}" required>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label mb-2" style="font-size: 14px; font-weight: 700; color: #334155;">Damages</label>
                                <div class="d-flex align-items-center gap-2 w-75">
                                    ${yardInch('input-damages-yard', 'input-damages-inch', shade.damages, 0)}
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label mb-2" style="font-size: 14px; font-weight: 700; color: #334155;">Endbits Generated</label>
                            <div class="endbits-list d-flex flex-wrap align-items-center gap-2">${endbitRows}</div>
                        </div>
                    </div>`;
            }

            // Hanya baris terakhir yang punya tombol: - (jika baris > 1) dan +
            function syncRowButtons($rows, addClass, removeClass) {
                $rows.each(function(index) {
                    var isLast = index === $rows.length - 1;
                    var $box = $(this).find('.row-actions').empty();

                    if (!isLast) return;

                    var html = '';

                    if ($rows.length > 1) {
                        html += actionButton(removeClass, '#ef4444', 'dash');
                    }

                    html += actionButton(addClass, '#3b93b8', 'plus');

                    $box.html(html).find('.lay-action').prop('disabled', !started);
                });
            }

            // ---------- Endbits Generated ----------
            // Baris yang terisi dari endbit pilihan (data-source-id) tidak punya tombol +/-.
            // Baris manual tetap bisa ditambah/dihapus.
            function syncEndbitButtons($list) {
                syncRowButtons($list.find('.endbit-row:not([data-source-id])'), 'btn-add-endbit', 'btn-remove-endbit');
            }

            $(document).on('click', '.btn-add-endbit', function() {
                if (!started) return;
                var $list = $(this).closest('.endbits-list');
                $list.append(endbitRowTemplate());
                syncEndbitButtons($list);
            });

            $(document).on('click', '.btn-remove-endbit', function() {
                if (!started) return;
                var $list = $(this).closest('.endbits-list');
                $(this).closest('.endbit-row').remove();
                syncEndbitButtons($list);
            });

            // ---------- Use Endbits ----------
            // Status pilihan dibaca dari DOM, jadi otomatis ikut draft dan tidak bisa selisih.
            function sugIds() {
                return $('.shade-item[data-auto="suggested"]').map(function() {
                    return parseInt($(this).attr('data-source-id'), 10);
                }).get();
            }

            function mergeIds() {
                return $('.shade-item[data-auto="merged"] .endbit-row[data-source-id]').map(function() {
                    return parseInt($(this).attr('data-source-id'), 10);
                }).get();
            }

            function usedIds() {
                return sugIds().concat(mergeIds());
            }

            function fmtLen(e) {
                return (parseFloat(e.length_yard) || 0) + ' yd ' + (parseFloat(e.length_inch) || 0) + ' in';
            }

            function markerText(e) {
                return (e.marker !== null && e.marker !== undefined && e.marker !== '') ? 'M' + e.marker : '-';
            }

            function endbitCheckHtml(e, cls, checkedIds) {
                return `
                    <label class="d-flex align-items-center gap-2 px-2 py-1 mb-1 rounded-1" style="font-size: 13px; color: #475569; cursor: pointer;">
                        <input type="checkbox" class="form-check-input lay-check ${cls}" value="${e.id}"
                            ${checkedIds.indexOf(e.id) !== -1 ? 'checked' : ''} ${started ? '' : 'disabled'}>
                        <span>L-${esc(e.lay)} · ${esc(e.part)} · ${esc(markerText(e))} · Shade ${esc(e.shade)} · ${fmtLen(e)}</span>
                    </label>`;
            }

            // Samakan status centang dan counter dengan kartu yang ada di DOM.
            // Dua daftar tidak punya endbit yang sama, jadi tidak perlu saling mengunci.
            function syncEndbitChecks() {
                var sug = sugIds();
                var mer = mergeIds();

                $('.chk-sug').each(function() {
                    $(this).prop('checked', sug.indexOf(parseInt(this.value, 10)) !== -1)
                        .prop('disabled', !started);
                });

                $('.chk-merge').each(function() {
                    $(this).prop('checked', mer.indexOf(parseInt(this.value, 10)) !== -1)
                        .prop('disabled', !started);
                });

                $('#cntSuggested').text(sug.length + '/' + $('.chk-sug').length);
                $('#cntOther').text(mer.length + '/' + $('.chk-merge').length);
            }

            // Shade kartu gabungan = gabungan shade semua endbit terpilih, unik, dipisah koma
            function refreshMergedShade($card) {
                var out = [];

                $card.find('.endbit-row[data-source-id]').each(function() {
                    var e = endbitData[parseInt($(this).attr('data-source-id'), 10)];
                    if (!e) return;

                    String(e.shade).split(',').forEach(function(t) {
                        t = t.trim();
                        if (t && out.indexOf(t) === -1) out.push(t);
                    });
                });

                $card.find('.input-shade-group').val(out.join(','));
            }

            // --- Suggested: 1 endbit = 1 kartu Shade ---
            function addSuggestedCard(id) {
                var e = endbitData[id];
                if (!e) return;
                if ($('.shade-item[data-auto="suggested"][data-source-id="' + id + '"]').length) return;

                var $card = $(shadeTemplate({
                    auto: 'suggested',
                    source_id: id,
                    shade: e.shade,
                    endbits_generated: [
                        { yard: e.length_yard, inch: e.length_inch, source_id: id },
                        {}
                    ]
                }, true));

                $('#shadeContainer').append($card);
                syncEndbitButtons($card.find('.endbits-list'));
            }

            function removeSuggestedCard(id) {
                $('.shade-item[data-auto="suggested"][data-source-id="' + id + '"]').remove();
            }

            // --- Use Endbits: semua pilihan masuk ke 1 kartu ---
            function addToMerged(id) {
                var e = endbitData[id];
                if (!e) return;

                var $card = $('.shade-item[data-auto="merged"]');

                if (!$card.length) {
                    $card = $(shadeTemplate({ auto: 'merged', shade: '', endbits_generated: [{}] }, true));
                    $('#shadeContainer').append($card);
                }

                var $list = $card.find('.endbits-list');

                if ($list.find('.endbit-row[data-source-id="' + id + '"]').length) return;

                var row = endbitRowTemplate({ yard: e.length_yard, inch: e.length_inch }, id);
                var $firstManual = $list.find('.endbit-row:not([data-source-id])').first();

                if ($firstManual.length) {
                    $firstManual.before(row);
                } else {
                    $list.append(row);
                }

                syncEndbitButtons($list);
                refreshMergedShade($card);
            }

            function removeFromMerged(id) {
                var $card = $('.shade-item[data-auto="merged"]');
                if (!$card.length) return;

                $card.find('.endbit-row[data-source-id="' + id + '"]').remove();

                if (!$card.find('.endbit-row[data-source-id]').length) {
                    $card.remove();
                    return;
                }

                syncEndbitButtons($card.find('.endbits-list'));
                refreshMergedShade($card);
            }

            // Ada card endbit  -> card manual pertama dihapus.
            // Tidak ada        -> card manual pertama dibuat lagi.
            function ensureBaseCard() {
                var hasAuto = $('.shade-item[data-auto="suggested"], .shade-item[data-auto="merged"]').length > 0;
                var $base = $('.shade-item[data-base="1"]');

                if (hasAuto && $base.length) {
                    $base.remove();
                } else if (!hasAuto && !$base.length) {
                    var $card = $(shadeTemplate({}, false));
                    $('#shadeContainer').prepend($card);
                    syncEndbitButtons($card.find('.endbits-list'));
                }
            }

            function afterEndbitChange() {
                ensureBaseCard();
                syncEndbitChecks();
                updateActualPlies();
            }

            $(document).on('change', '.chk-sug', function() {
                if (!started) return;

                var id = parseInt(this.value, 10);

                if (this.checked) addSuggestedCard(id);
                else removeSuggestedCard(id);

                afterEndbitChange();
            });

            $(document).on('change', '.chk-merge', function() {
                if (!started) return;

                var id = parseInt(this.value, 10);

                if (this.checked) addToMerged(id);
                else removeFromMerged(id);

                afterEndbitChange();
            });

            function renderEndbitLists(list) {
                var sug = list.filter(function(e) { return e.suggested; });
                var sugChecked = sugIds();
                var merChecked = mergeIds();

                $('#listSuggested').html(sug.length
                    ? sug.map(function(e) { return endbitCheckHtml(e, 'chk-sug', sugChecked); }).join('')
                    : EMPTY_LIST);

                // Use Endbits = endbit satu order yang TIDAK masuk Suggested
                var oth = list.filter(function(e) { return !e.suggested; });

                $('#listOther').html(oth.length
                    ? oth.map(function(e) { return endbitCheckHtml(e, 'chk-merge', merChecked); }).join('')
                    : EMPTY_LIST);

                syncEndbitChecks();
            }

            // Buang kartu/baris yang endbit sumbernya sudah tidak tersedia (diambil lay lain)
            function pruneMissing() {
                var removed = false;

                sugIds().forEach(function(id) {
                    if (!endbitData[id]) {
                        removeSuggestedCard(id);
                        removed = true;
                    }
                });

                mergeIds().forEach(function(id) {
                    if (!endbitData[id]) {
                        removeFromMerged(id);
                        removed = true;
                    }
                });

                if (removed) {
                    ensureBaseCard();
                    updateActualPlies();
                    if (started) {
                        alertBox('warning', 'Warning!', 'Some selected endbits are no longer available and were removed.');
                    }
                }
            }

            function loadEndbits() {
                return $.getJSON(urls.endbits)
                    .done(function(res) {
                        endbitData = {};
                        (res.endbits || []).forEach(function(e) { endbitData[e.id] = e; });

                        pruneMissing();
                        renderEndbitLists(res.endbits || []);
                    })
                    .fail(showError);
            }

            $(document).on('click', '.btn-refresh-endbits', function() {
                if (started) loadEndbits();
            });

            // ---------- Splice ----------
            function updateSpliceWastage() {
                var totalYard = 0;
                var totalInch = 0;

                $('#spliceList .splice-row').each(function() {
                    totalYard += parseFloat($(this).find('.input-splice-wastage-yard').val()) || 0;
                    totalInch += parseFloat($(this).find('.input-splice-wastage-inch').val()) || 0;
                });

                $('#sumWastageYard').val(+totalYard.toFixed(4));
                $('#sumWastageInch').val(+totalInch.toFixed(4));
            }

            function syncSpliceRows() {
                var $rows = $('#spliceList .splice-row');
                var total = $rows.length;

                $rows.each(function(index) {
                    $(this).find('.splice-heading').text(index + 1);

                    var $box = $(this).find('.row-actions').empty();

                    if (index !== total - 1) return;

                    var html = actionButton('btn-remove-splice', '#ef4444', 'dash')
                             + actionButton('btn-add-splice', '#3b93b8', 'plus');

                    $box.html(html).find('.lay-action').prop('disabled', !started);
                });

                $('#addSpliceWrap').toggle(total === 0);

                updateSpliceWastage();
            }

            function addSpliceRow(splice) {
                $('#spliceList').append(spliceRowTemplate(splice));
                syncSpliceRows();
            }

            $(document).on('input', '.input-splice-wastage-yard, .input-splice-wastage-inch', updateSpliceWastage);

            $('#btnAddSplice').on('click', function() {
                if (started) addSpliceRow();
            });

            $(document).on('click', '.btn-add-splice', function() {
                if (started) addSpliceRow();
            });

            $(document).on('click', '.btn-remove-splice', function() {
                if (!started) return;

                $(this).closest('.splice-row').remove();

                syncSpliceRows();
            });

            // ---------- Roll & plies ----------
            function updateActualPlies() {
                var total = 0;

                $('.input-actual-plies').each(function() {
                    total += parseFloat($(this).val()) || 0;
                });

                $('#topActualPlies, #summaryActualPlies').text(total);
                $('#topCutQty').text(totalRatio * total);
            }

            $(document).on('input', '.input-actual-plies', updateActualPlies);

            function renderShades(list) {
                $('#shadeContainer').empty();

                // Kalau sudah ada card endbit, tidak ada card manual pertama
                var hasAuto = list.some(function(s) { return !!s.auto; });

                list.forEach(function(shade, index) {
                    $('#shadeContainer').append(shadeTemplate(shade, hasAuto || index > 0));
                });

                $('.endbits-list').each(function() {
                    syncEndbitButtons($(this));
                });
            }

            $('#btnAddNewShade').on('click', function() {
                if (!started) return;
                var $shade = $(shadeTemplate({}, true));
                $('#shadeContainer').append($shade);
                syncEndbitButtons($shade.find('.endbits-list'));
            });

            $(document).on('click', '.btn-remove-shade', function() {
                if (!started) return;
                $(this).closest('.shade-item').remove();
                updateActualPlies();
            });

            // ---------- Payload ----------
            function readField(field) {
                return {
                    yard: $('[data-field="' + field + '"][data-unit="yard"]').val(),
                    inch: $('[data-field="' + field + '"][data-unit="inch"]').val()
                };
            }

            function collectPayload() {
                var splices = $('#spliceList .splice-row').map(function() {
                    var $row = $(this);
                    return {
                        length: {
                            yard: $row.find('.input-splice-length-yard').val(),
                            inch: $row.find('.input-splice-length-inch').val()
                        },
                        wastage: {
                            yard: $row.find('.input-splice-wastage-yard').val(),
                            inch: $row.find('.input-splice-wastage-inch').val()
                        }
                    };
                }).get();

                var shades = $('.shade-item').map(function() {
                    var $item = $(this);

                    var endbits = $item.find('.endbit-row').map(function() {
                        return {
                            yard: $(this).find('.input-endbit-yard').val(),
                            inch: $(this).find('.input-endbit-inch').val(),
                            source_id: $(this).attr('data-source-id') || ''
                        };
                    }).get();

                    return {
                        shade: $item.find('.input-shade-group').val() || '',
                        auto: $item.attr('data-auto') || '',
                        source_id: $item.attr('data-source-id') || '',
                        actual_plies: $item.find('.input-actual-plies').val(),
                        damages: {
                            yard: $item.find('.input-damages-yard').val(),
                            inch: $item.find('.input-damages-inch').val()
                        },
                        endbits_generated: endbits
                    };
                }).get();

                var payload = { splices: splices, shades: shades, used_endbits: usedIds() };

                MEASURE_FIELDS.forEach(function(field) {
                    payload[field] = readField(field);
                });

                return payload;
            }

            // ---------- Draft (hanya di browser, tidak dikirim ke server) ----------
            function saveDraft() {
                if (!draftReady) return;
                try { localStorage.setItem(draftKey, JSON.stringify(collectPayload())); } catch (e) {}
            }

            function readDraft() {
                try { return JSON.parse(localStorage.getItem(draftKey) || 'null'); } catch (e) { return null; }
            }

            function clearDraft() {
                try { localStorage.removeItem(draftKey); } catch (e) {}
            }

            $(document).on('input change click', '.lay-input, .lay-action, .lay-check', function() {
                clearTimeout(draftTimer);
                draftTimer = setTimeout(saveDraft, 300);
            });

            // ---------- Validasi ----------
            function validateForm() {
                var errors = [];

                $('.lay-input').removeClass('is-invalid');
                $('.shade-groups').removeClass('is-invalid-group');

                function mark($els, msg) {
                    $els.addClass('is-invalid');
                    errors.push({ msg: msg, $el: $els.first() });
                }

                // Pasangan yard/inch: minimal salah satu terisi
                function checkPair($yard, $inch, msg) {
                    var y = $yard.length ? $.trim($yard.val()) : '';
                    var i = $inch.length ? $.trim($inch.val()) : '';

                    if (y === '' && i === '') {
                        mark($yard.add($inch), msg);
                    }
                }

                ['material_width', 'material_length'].forEach(function(field) {
                    checkPair(
                        $('[data-field="' + field + '"][data-unit="yard"]'),
                        $('[data-field="' + field + '"][data-unit="inch"]'),
                        FIELD_LABELS[field] + ' is required.'
                    );
                });

                $('#spliceList .splice-row').each(function(index) {
                    var $row = $(this);
                    var n = index + 1;

                    checkPair(
                        $row.find('.input-splice-length-yard'),
                        $row.find('.input-splice-length-inch'),
                        'Splice ' + n + ': Length is required.'
                    );
                    checkPair(
                        $row.find('.input-splice-wastage-yard'),
                        $row.find('.input-splice-wastage-inch'),
                        'Splice ' + n + ': Wastage is required.'
                    );
                });

                var blankPlies = false;

                $('.shade-item').each(function(index) {
                    var $item = $(this);
                    var n = index + 1;
                    var $plies = $item.find('.input-actual-plies');

                    if (!$item.find('.input-shade-group').val()) {
                        var $groups = $item.find('.shade-groups').addClass('is-invalid-group');
                        errors.push({ msg: 'Roll ' + n + ': Shade is required.', $el: $groups });
                    }

                    if ($.trim($plies.val()) === '') {
                        blankPlies = true;
                        mark($plies, 'Roll ' + n + ': Actual Plies is required.');
                    }
                });

                // Total Actual Plies semua roll harus sama dengan Planned Plies
                if (!blankPlies && PLANNED_PLIES > 0) {
                    var totalPlies = 0;

                    $('.input-actual-plies').each(function() {
                        totalPlies += parseInt($(this).val(), 10) || 0;
                    });

                    if (totalPlies !== PLANNED_PLIES) {
                        mark($('.input-actual-plies'),
                            'Total Actual Plies (' + totalPlies + ') must equal Planned Plies (' + PLANNED_PLIES + ').');
                    }
                }

                if (errors.length) {
                    var first = errors[0];
                    var text = errors.length > 1
                        ? first.msg + ' (+' + (errors.length - 1) + ' other fields)'
                        : first.msg;

                    alertBox('warning', 'Incomplete Data', text, function() {
                        first.$el.focus();
                        $('html, body').animate({ scrollTop: first.$el.offset().top - 150 }, 200);
                    });

                    return false;
                }

                return true;
            }

            // ---------- Save ----------
            $('#btnSaveChanges').on('click', function() {
                if (!started) return;
                if (!validateForm()) return;

                var $btn = $(this).prop('disabled', true);

                post(urls.save, collectPayload())
                    .done(function(res) {
                        clearDraft();
                        alertBox('success', 'Success!', 'Data has been successfully saved.', function() {
                            $('#loading').show();
                            window.location.href = res.redirect || urls.home;
                        });
                    })
                    .fail(function(xhr) {
                        showError(xhr);
                        $btn.prop('disabled', false);
                    });
            });

            // ---------- Isi form saat halaman dibuka ----------
            function fillField(field, value) {
                value = value || {};
                $('[data-field="' + field + '"][data-unit="yard"]').val(numVal(value.yard));
                $('[data-field="' + field + '"][data-unit="inch"]').val(numVal(value.inch));
            }

            function loadForm() {
                var isCompleted = !!(saved && saved.status === 'completed');

                if (isCompleted) clearDraft();

                // Lay selesai: data database. Selain itu: draft browser diutamakan.
                var source = isCompleted ? saved : (readDraft() || saved);

                MEASURE_FIELDS.forEach(function(field) {
                    var value = source ? source[field] : null;

                    // Kosong dan lay belum selesai: pakai nilai dari index
                    if (!isCompleted && isEmptyMeasure(value) && DEFAULTS[field]) {
                        value = DEFAULTS[field];
                    }

                    fillField(field, value);
                });

                if (source) {
                    (source.splices || []).forEach(addSpliceRow);
                }

                syncSpliceRows();
                renderShades(source && source.shades && source.shades.length ? source.shades : [{}]);
                updateSpliceWastage();
                updateActualPlies();

                setRunning(!!(saved && saved.status === 'running'));

                if (isCompleted) {
                    $('#btnPlay, #btnSaveChanges, #btnAddNewShade, #addSpliceWrap, #endbitCards').hide();
                } else {
                    // Pilihan endbit dipulihkan dari kartu draft (data-auto / data-source-id)
                    loadEndbits();
                }

                draftReady = !isCompleted;
            }

            loadForm();
        });
    </script>
@endsection
