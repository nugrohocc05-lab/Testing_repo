html, body {
    margin: 0;
    background-color: #242E3E;
}

body {
    padding: 1rem;
}

.dashboard-wrap {
    width: 100%;
}

@media (min-width: 992px) {
    html, body {
        height: 100%;
    }
    body {
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .dashboard-wrap {
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    .datatable-wrap {
        flex-grow: 1;
        min-height: 0;
        overflow: hidden;
    }
    .table-scroll-area {
        flex-grow: 1;
        min-height: 0;
        max-height: none;
        height: auto;
    }
}

@media (min-width: 1600px) {
    .dashboard-wrap {
        max-width: 1900px;
        margin: 0 auto;
    }
}

.bg-custom {
    background: #1C2536;
}

.bg-custom-select {
    background: #242E3E;
    color: #fff;
    border: 0;
}

.btn-custom {
    background: #222F4A;
    color: #fff;
    border: none;
    border-radius: 10px;
}

.btn-custom:hover {
    background-color: #242E3E;
}

.border-custom {
    border: 1px solid #576376 !important;
}

.min-h-custom {
    min-height: 250px;
}

.border-color-yellow {
    border: 1px solid #F2C94C;
    border-radius: 5px;
}

.form-control,
.select2-container--default .select2-selection--single {
    height: 38px;
    border-radius: 0.375rem;
}

input[type="text"] {
    background-color: #222F4A;
    color: white;
    border: none;
}

input[type="text"]:focus {
    background-color: #222F4A;
    color: white;
    border-color: #576376;
    box-shadow: none;
}

/* Color */
.text-title { color: #5A587E; }
.text-yellow { color: #F2C94C; }
.text-red { color: #F24C4C; }
.text-blue { color: #4C8CF2; }
.text-green { color: #4CF299; }

.color-box-yellow {
    background-color: #363633;
    border: 1px solid #F2C94C;
    border-radius: 5px;
    color: #F2C94C;
}
.color-box-red {
    background-color: #352837;
    border: 1px solid #F24C4C;
    border-radius: 5px;
}
.color-box-blue {
    background-color: #23304E;
    border: 1px solid #3F5588;
    border-radius: 5px;
}
.color-box-green {
    background-color: #1A3B45;
    border: 1px solid #4CF299;
    border-radius: 5px;
}

/* Stats Card */
.stat-card {
    height: 190px;
    overflow: hidden;
}

.stat-card h2,
.stat-card h6 {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}

.stat-card .d-flex.align-items-end {
    max-width: 100%;
}

#topDefectList {
    max-height: 90px;
    width: 100%;
}

#topDefectList::-webkit-scrollbar {
    width: 1px;
}

#topDefectList::-webkit-scrollbar-thumb {
    background-color: #576376;
    border-radius: 4px;
}

#topDefectList .text-white.small {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: inline-block;
    max-width: 190px;
    vertical-align: middle;
}

.dashboard-title {
    font-size: 2rem;
}

@media (max-width: 768px) {
    .dashboard-title {
        font-size: 1.4rem;
    }
    .dashboard-subtitle {
        font-size: 1rem !important;
    }
}

@media (max-width: 576px) {
    .dashboard-title {
        font-size: 1.1rem;
    }
    .dashboard-subtitle {
        display: none;
    }
    .btn-custom {
        width: 100%;
        justify-content: center;
    }
    .d-flex.flex-wrap > .d-flex {
        width: 100%;
    }
    .color-box-yellow img,
    .color-box-red img,
    .color-box-blue img,
    .color-box-green img {
        width: 40px !important;
        height: 40px !important;
    }
    .color-box-yellow h2,
    .color-box-red h2,
    .color-box-blue h2,
    .color-box-green h2 {
        font-size: 1.4rem;
    }
}

@media (max-width: 1366px) {
    .stat-card {
        padding: 0.75rem !important;
        height: 165px;
    }
    .stat-card img {
        width: 45px !important;
        height: 45px !important;
    }
    .stat-card h2 {
        font-size: 1.4rem;
    }
    .stat-card h6 {
        font-size: 0.8rem;
    }
    #topDefectList {
        max-height: 80px;
    }
}

@media (max-width: 767.98px) {
    .stat-card {
        padding: 0.75rem !important;
        height: 150px;
        font-size: 12px;
    }
    .stat-card img {
        width: 45px !important;
        height: 45px !important;
    }
    #topDefectList {
        max-height: 70px;
    }
}

@media (min-width: 992px) and (max-width: 1400px) {
    .dashboard-title {
        font-size: 1.5rem;
    }
    .dashboard-subtitle {
        font-size: 0.85rem !important;
    }
    .btn-custom {
        padding-left: 0.85rem !important;
        padding-right: 0.85rem !important;
        padding-top: 0.6rem !important;
        padding-bottom: 0.6rem !important;
        font-size: 0.9rem;
        white-space: nowrap;
    }
    .stat-card {
        font-size: 14px;
    }
}

/* Flatpickr (shared: used by #datea/#dateb in filter, #datedatatables in datatables) */
.flatpickr-calendar {
    background: #242E3E;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.35);
    border: none;
    width: 100%;
    max-width: 307px;
}
.flatpickr-calendar.arrowTop:before,
.flatpickr-calendar.arrowTop:after {
    display: none;
}

.flatpickr-months {
    border-radius: 12px 12px 0 0;
    padding: 10px 0;
}
.flatpickr-current-month {
    color: #fff;
    font-weight: 700;
    font-size: 1.1rem;
}
.flatpickr-current-month .flatpickr-monthDropdown-months,
.flatpickr-current-month input.cur-year {
    color: #fff;
    background: transparent;
}
.flatpickr-months .flatpickr-prev-month,
.flatpickr-months .flatpickr-next-month {
    color: #fff;
    fill: #fff;
    top: 12px;
}
.flatpickr-months .flatpickr-prev-month svg,
.flatpickr-months .flatpickr-next-month svg {
    fill: #fff;
}

.flatpickr-weekdays {
    background: #1e2a44;
}
span.flatpickr-weekday {
    background: #1e2a44;
    color: #cfd8ec;
    font-weight: 600;
}

.flatpickr-days {
    background: #1e2a44;
    border: none;
}

.dayContainer {
    background: #1e2a44;
}

.flatpickr-day {
    color: #fff;
    border-radius: 10px;
}
.flatpickr-day:hover {
    background: #33456b;
}
.flatpickr-day.today {
    border-color: #6c8cd5;
}

.flatpickr-day.prevMonthDay,
.flatpickr-day.nextMonthDay {
    color: #5a6785;
}

.flatpickr-day.selected,
.flatpickr-day.selected:hover {
    background: #32549A;
    border-color: #32549A;
    color: #fff;
}

/* Tooltip (shared: refresh button in header, export buttons in filter & datatables) */
.export-btn {
    position: relative;
}

.custom-tooltip {
    position: absolute;
    right: 120%;
    top: 50%;
    transform: translateY(-50%);
    background-color: #000000;
    color: white;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s ease;
    z-index: 10;
}

.custom-tooltip::after {
    content: "";
    position: absolute;
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    border-width: 5px;
    border-style: solid;
    border-color: transparent transparent transparent #000000;
}

.export-btn:hover .custom-tooltip {
    opacity: 1;
    visibility: visible;
    right: 130%;
}
