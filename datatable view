<script>
    $(function () {
        flatpickr("#datedatatables", {
            dateFormat: "d-m-Y",
            altInput: true,
            altFormat: "d F Y",
            allowInput: true,
            monthSelectorType: "static",
            disableMobile: true,
            defaultDate: "{{ \Carbon\Carbon::parse($date)->format('d-m-Y') }}",
            onChange: function (selectedDates, dateStr) {
                if (!dateStr) return;
                reloadTable(dateStr);
            },
            maxDate: "today",
        });

        const initialDate = "{{ \Carbon\Carbon::parse($date)->format('d-m-Y') }}";
        $('#tableInlinePerformanceBody').html(renderSkeletonRows(6));
        initTable();
        reloadTable(initialDate);

        function initTable() {
            window.table = $('#tableInlinePerformance').DataTable({
                paging: false,
                ordering: false,
                info: false,
                footer: true,
                dom: '',
                buttons: [
    {
        extend: 'excelHtml5',
        title: function () {
            const currentDate = $('#datedatatables').val() || '{{ date("d-m-Y") }}';
            return 'Report_Detail_Per_Line_' + currentDate;
        },
        exportOptions: { columns: ':visible' },
        customizeData: function(data) {
            data.body.push([
                'TOTAL',
                '',
                $('#footQtyRft').text(),
                $('#footQtyInspect').text(),
                $('#footQtyDefect').text(),
                '',
                '',
                ''
            ]);
        }
    }
]
            });

            table.off('draw').on('draw', function () {
                updateFooterTotals();
            });

            updateFooterTotals();
        }

        function updateFooterTotals() {
            let totalRft = 0, totalInspect = 0, totalDefect = 0;

            table.rows({ search: 'applied' }).every(function () {
                const cells = $(this.node()).find('td');
                if (cells.length < 8) return;

                totalRft += parseInt($(cells[2]).text().trim()) || 0;
                totalInspect += parseInt($(cells[3]).text().trim()) || 0;
                totalDefect += parseInt($(cells[4]).text().trim()) || 0;
            });

            $('#footQtyRft').text(totalRft);
            $('#footQtyInspect').text(totalInspect);
            $('#footQtyDefect').text(totalDefect);
        }

        function reloadTable(dateStr) {
            table.destroy();
            $('#tableInlinePerformanceBody').html(renderSkeletonRows(7));

            $.get("{{ route('monitoring_inlineperformancedatatables') }}", { date: dateStr })
                .done(function (html) {
                    $('#tableInlinePerformanceBody').html(html);
                    initTable();
                    $('#searchLine').val('');
                    updateDataTime();
                })
                .fail(function (xhr) {
                    console.error(xhr.responseText);
                    $('#tableInlinePerformanceBody').html(
                        '<tr><td colspan="8" class="text-center text-danger">Failed to load data</td></tr>'
                    );
                    initTable();
                });
        }

        // Search
        $('#searchLine, #find').on('keyup click', function (e) {
            if (e.type === 'click' || e.key === 'Enter' || e.type === 'keyup') {
                table.column(0).search($('#searchLine').val()).draw();
            }
        });

        $('#export-datatable-btn').on('click', function () {
            table.button('.buttons-excel').trigger();
        });

        function renderSkeletonRows(rowCount = 6) {
            let rows = '';
            for (let i = 0; i < rowCount; i++) {
                rows += `
                    <tr class="skeleton-row">
                        <td class="text-center skeleton-td"><div class="skeleton-bar" style="width:60%;margin:0 auto;"></div></td>
                        <td class="text-center skeleton-td"><div class="skeleton-bar" style="width:80%;margin:0 auto;"></div></td>
                        <td class="text-center skeleton-td"><div class="skeleton-bar" style="width:50%;margin:0 auto;"></div></td>
                        <td class="text-center skeleton-td"><div class="skeleton-bar" style="width:50%;margin:0 auto;"></div></td>
                        <td class="text-center skeleton-td"><div class="skeleton-bar" style="width:50%;margin:0 auto;"></div></td>
                        <td class="text-center skeleton-td"><div class="skeleton-bar" style="width:40%;margin:0 auto;"></div></td>
                        <td class="text-center skeleton-td"><div class="skeleton-bar" style="width:40%;margin:0 auto;"></div></td>
                        <td class="text-center skeleton-td"><div class="skeleton-bar skeleton-badge"></div></td>
                    </tr>`;
            }
            return rows;
        }

        $(document).on('click', '.target-loading', function (e) {
            e.preventDefault();

            const targetUrl = $(this).attr('href');

            $('#loading').show();

            setTimeout(function () {
                window.location.href = targetUrl;
            }, 100);
        });

        window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
                $('#loading').hide();
            }
        });

        // Copy style in mobile
        (function () {
            let activePopover = null;

            function isMobileOrTablet() {
                return window.matchMedia('(max-width: 991.98px)').matches;
            }

            function removePopover() {
                if (activePopover) {
                    activePopover.remove();
                    activePopover = null;
                }
            }

            function copyToClipboard(text) {
                if (navigator.clipboard && window.isSecureContext) {
                    return navigator.clipboard.writeText(text);
                }
                return new Promise((resolve, reject) => {
                    const ta = document.createElement('textarea');
                    ta.value = text;
                    ta.style.position = 'fixed';
                    ta.style.opacity = '0';
                    document.body.appendChild(ta);
                    ta.focus();
                    ta.select();
                    try {
                        document.execCommand('copy');
                        resolve();
                    } catch (err) {
                        reject(err);
                    } finally {
                        document.body.removeChild(ta);
                    }
                });
            }

            function showCopyBadge(targetEl, value) {
                removePopover();

                const rect = targetEl.getBoundingClientRect();
                const popover = document.createElement('div');
                popover.className = 'copy-badge-popover';
                popover.innerHTML = `
                    <span class="copy-badge-text">${value}</span>
                    <span class="copy-badge-status">Copied!</span>
                `;

                document.body.appendChild(popover);

                const popRect = popover.getBoundingClientRect();
                let top = rect.bottom + 6;
                let left = rect.left;

                if (left + popRect.width > window.innerWidth - 8) {
                    left = window.innerWidth - popRect.width - 8;
                }
                if (top + popRect.height > window.innerHeight - 8) {
                    top = rect.top - popRect.height - 6;
                }

                popover.style.top = top + 'px';
                popover.style.left = Math.max(8, left) + 'px';

                popover.addEventListener('click', function (e) {
                    e.stopPropagation();
                    copyToClipboard(value).then(function () {
                        popover.classList.add('copied');
                        setTimeout(removePopover, 1200);
                    });
                });

                activePopover = popover;
            }

            document.addEventListener('click', function (e) {
                const cell = e.target.closest('.copyable-cell');

                if (cell) {
                    if (!isMobileOrTablet()) return;
                    e.stopPropagation();
                    const value = cell.getAttribute('data-copy-value') || cell.textContent.trim();
                    showCopyBadge(cell, value);
                    return;
                }

                if (!e.target.closest('.copy-badge-popover')) {
                    removePopover();
                }
            });

            window.addEventListener('scroll', removePopover, true);
            window.addEventListener('resize', removePopover);
        })();
    });
</script>
