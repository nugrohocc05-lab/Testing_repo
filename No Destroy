<template>
    <div class="space-y-1">
        <label v-if="label" class="text-sm font-medium text-gray-600">
            {{ label }}
            <span v-if="required" class="text-red-500">*</span>
        </label>

        <div class="flex gap-2">
            <div class="relative flex-1">
                <input
                    :value="yard"
                    inputmode="numeric"
                    placeholder="0"
                    :class="inputClass"
                    @input="onYard"
                />
                <span class="suffix">yd</span>
            </div>

            <div class="relative flex-1">
                <input
                    :value="inch"
                    inputmode="decimal"
                    placeholder="0"
                    :class="inputClass"
                    @input="onInch"
                />
                <span class="suffix">in</span>
            </div>
        </div>

        <p v-if="error" class="text-xs text-red-500">{{ error }}</p>
    </div>
</template>

<script setup>
import { computed } from "vue";

const props = defineProps({
    label: { type: String, default: "" },
    yard: { type: [String, Number], default: "" },
    inch: { type: [String, Number], default: "" },
    error: { type: String, default: "" },
    required: { type: Boolean, default: false },
});

const emit = defineEmits(["update:yard", "update:inch"]);

const inputClass = computed(() => [
    "w-full rounded-lg border bg-white py-2 pl-3 pr-10 text-sm outline-none transition",
    "focus:ring-2 focus:ring-blue-200",
    props.error
        ? "border-red-400 focus:border-red-500"
        : "border-gray-300 focus:border-blue-500",
]);

const onYard = (e) => {
    const clean = e.target.value.replace(/\D/g, "");
    e.target.value = clean;
    emit("update:yard", clean);
};

const onInch = (e) => {
    let clean = e.target.value.replace(/[^\d.]/g, "");
    const parts = clean.split(".");
    if (parts.length > 2) clean = parts[0] + "." + parts.slice(1).join("");
    e.target.value = clean;
    emit("update:inch", clean);
};
</script>

<style scoped>
.suffix {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.75rem;
    color: #9ca3af;
    pointer-events: none;
}
</style>