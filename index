@section('extrascript')
    <script>
        $(document).ready(function() {
            $("#layerman-bar-menu").addClass('active');

            function updateClock() {
                var now = new Date();
                var formatted = now.toLocaleDateString('en-US', {
                    weekday: 'long',
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                });
                var parts = formatted.replace(',', '').split(' ');

                $('#live-day').text(parts[0]);
                $('#live-date').text(parts[1] + ' ' + parts[2] + ' ' + parts[3]);
                $('#live-clock').text(now.toTimeString().slice(0, 8));
            }

            function updateGreeting() {
                var hour = new Date().getHours();
                var greeting = 'Good Night';

                if (hour >= 5 && hour < 12) greeting = 'Good Morning';
                else if (hour >= 12 && hour < 15) greeting = 'Good Afternoon';
                else if (hour >= 15 && hour < 18) greeting = 'Good Evening';

                $('#greeting').text(greeting);
            }

            updateClock();
            updateGreeting();
            setInterval(updateClock, 1000);
            setInterval(updateGreeting, 60000);

            $(document).on('click', '.btn-page-loading', function(e) {
                e.preventDefault();
                var url = $(this).attr('href');

                $('#loading').show();
                setTimeout(function() {
                    window.location.href = url;
                }, 100);
            });
        });
    </script>
