    <script>
        $(document).ready(function () {

            $(document).on('click', '.loading-target', function (e) {
                e.preventDefault();

                const targetUrl = $(this).attr('href');

                $('#loading').show();

                setTimeout(function () {
                    window.location.href = targetUrl;
                }, 100);
            });

            window.addEventListener('pageshow', function (event) {
                if (event.persisted) {
                    $('#loading').hide();
                }
            });

            updateTopDefectChart(null);

            function updateDataTime() {
                let now = new Date();
                let day = String(now.getDate()).padStart(2, '0');
                let month = [
                    "January", "February", "March", "April", "May", "June",
                    "July", "August", "September", "October", "November", "December"
                ];
                let year = now.getFullYear();
                let hour = String(now.getHours()).padStart(2, '0');
                let minute = String(now.getMinutes()).padStart(2, '0');
                let second = String(now.getSeconds()).padStart(2, '0');

                let formatted = `${day} ${month[now.getMonth()]} ${year} - ${hour} : ${minute} : ${second}`;

                document.getElementById('liveClock').innerHTML = formatted;

                localStorage.setItem('lastDataUpdate', formatted);
            }

            updateDataTime();

            window.updateDataTime = updateDataTime;
        });

        function updateTopDefectChart(topDefect) {
            const svg = document.getElementById('topDefectChart');
            const size = 120;
            const strokeWidth = 30;
            const radius = (size - strokeWidth) / 2;
            const circumference = 2 * Math.PI * radius;

            // reset
            svg.innerHTML = '';

            if (!topDefect || topDefect.length === 0 || topDefect === null) {
                // background ring kosong
                svg.innerHTML = `
                    <circle
                        cx="${size / 2}" cy="${size / 2}" r="${radius}"
                        fill="none" stroke="#D9D9D9" stroke-width="${strokeWidth}">
                    </circle>
                `;
                return;
            }


            let offsetAccumulated = 0;
            let svgContent = '';

            topDefect.forEach(function (item) {
                const percent = Number(item.percent) || 0;
                const dashLength = (percent / 100) * circumference;
                const dashArray = `${dashLength} ${circumference - dashLength}`;
                const dashOffset = -offsetAccumulated;

                svgContent += `
                    <circle
                        cx="${size / 2}" cy="${size / 2}" r="${radius}"
                        fill="none"
                        stroke="${item.color}"
                        stroke-width="${strokeWidth}"
                        stroke-dasharray="${dashArray}"
                        stroke-dashoffset="${dashOffset}"
                        transform="rotate(-90 ${size / 2} ${size / 2})"
                        stroke-linecap="butt">
                    </circle>
                `;

                offsetAccumulated += dashLength;
            });

            svg.innerHTML = svgContent;
        }
    </script>
