function poSelect(Request $request)
{
    preconnect(session('db'));

    $page = (int) $request->get('page', 1);

    $dateA = Carbon::createFromFormat(
        'd-m-Y',
        $request->datea
    )->startOfDay();

    $dateB = Carbon::createFromFormat(
        'd-m-Y',
        $request->dateb
    )->startOfDay();

    $dta = $dateA->lessThanOrEqualTo($dateB)
        ? $dateA
        : $dateB;

    $dtb = $dateA->lessThanOrEqualTo($dateB)
        ? $dateB->copy()->endOfDay()
        : $dateA->copy()->endOfDay();

    $leafRows = $this->getLeafHistoryRows(
        $request,
        'combine_pro',
        true,
        $dta,
        $dtb
    );

    $qtyPerIdpo = $leafRows->groupBy('idpo')->map(fn ($rows) => (int) $rows->sum('qty_ori'));
    $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();

    $poRows = $leafRows
        ->filter(fn ($row) => !empty($row->idpo) && $qualifiedIdpo->contains($row->idpo))
        ->unique('idpo')
        ->values();

    if ($request->filled('q')) {
        $q = $request->q;

        $poRows = $poRows
            ->filter(function ($row) use ($q) {
                return stripos($row->po, $q) !== false;
            })
            ->values();
    }

    $total = $poRows->count();

    $items = $poRows
        ->forPage($page, $this->perPage)
        ->values();

    return response()->json([
        'results' => $items->map(fn ($item) => [
            'id' => $item->idpo,
            'text' => $item->po,
        ])->values(),

        'pagination' => [
            'more' => ($page * $this->perPage) < $total,
        ],
    ]);
}