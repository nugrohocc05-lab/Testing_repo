/* ==========================================================================
   GLOBAL CSS - layouts.masternonavbar
   Dipakai lintas modul dashboard (inline performance, endline, finish).
   Jangan taruh style yang cuma dipakai 1 halaman di sini — taruh di CSS
   spesifik modul tsb.
   ========================================================================== */

/* --------------------------------------------------------------------
   1. DESIGN TOKENS (warna & background)
   -------------------------------------------------------------------- */
:root {
    --color-title: #5A587E;
    --color-yellow: #F2C94C;
    --color-red: #F24C4C;
    --color-red-alt: #E65858;
    --color-blue: #4C8CF2;
    --color-green: #4CF299;

    --bg-dark-1: #222F4A; /* input, box biru gelap */
    --bg-dark-2: #242E3E; /* select2/flatpickr bg, table td */
    --bg-dark-3: #1C2536; /* table th, footer table */
    --bg-dark-4: #1e2a44; /* flatpickr weekdays/days */

    --border-muted: #576376;
}

/* --------------------------------------------------------------------
   2. SHELL / LAYOUT DASHBOARD
   -------------------------------------------------------------------- */
html, body {
    height: auto;
    min-height: 100%;
}
body {
    overflow-y: auto;
    padding: 1rem;
}
.dashboard-wrap {
    min-height: 100%;
    display: flex;
    flex-direction: column;
}
.flex-fill-area {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    -webkit-overflow-scrolling: touch;
}
.dashboard-wrap > .d-flex.flex-wrap.justify-content-between,
.dashboard-wrap > .row.g-3.mt-1 {
    flex-shrink: 0;
}

@media (min-width: 992px) {
    html, body { height: 100%; }
    body { overflow: hidden; }
    .dashboard-wrap { height: 100%; min-height: 0; }
    .flex-fill-area { overflow: auto; }
}

/* --------------------------------------------------------------------
   3. TYPOGRAPHY & COLOR UTILITIES
   -------------------------------------------------------------------- */
.dashboard-title { font-size: 2rem; }

.text-title { color: var(--color-title); }
.text-yellow { color: var(--color-yellow); }
.text-red { color: var(--color-red); }
.text-blue { color: var(--color-blue); }
.text-green { color: var(--color-green); }

.border-custom { border: 1px solid var(--border-muted) !important; }
.border-color-yellow {
    border: 1px solid var(--color-yellow);
    border-radius: 5px;
}
.border-end-custom { border-right: 1px solid var(--bg-dark-2) !important; }

@media (max-width: 768px) {
    .border-end-custom {
        border-right: none !important;
        border-bottom: 1px solid rgba(255,255,255,.2);
        padding-bottom: 1rem;
        margin-bottom: 1rem;
    }
}

/* --------------------------------------------------------------------
   4. BUTTONS
   -------------------------------------------------------------------- */
.btn-custom {
    background: var(--bg-dark-1);
    color: #fff;
    border: none;
    border-radius: 10px;
}
.btn-custom:hover { background-color: var(--bg-dark-2); }

.button-inline { width: 100%; justify-content: start; }

@media (max-width: 768px) {
    .button-inline { justify-content: space-between; }
}
@media (max-width: 576px) {
    .btn-custom { width: 100%; justify-content: center; }
}

/* --------------------------------------------------------------------
   5. TOOLTIP (export button, dsb)
   -------------------------------------------------------------------- */
.export-btn { position: relative; }

.custom-tooltip {
    position: absolute;
    right: 120%;
    top: 50%;
    transform: translateY(-50%);
    background-color: #000000;
    color: white;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s ease;
    z-index: 10;
}
.custom-tooltip::after {
    content: "";
    position: absolute;
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    border-width: 5px;
    border-style: solid;
    border-color: transparent transparent transparent #000000;
}
.export-btn:hover .custom-tooltip {
    opacity: 1;
    visibility: visible;
    right: 130%;
}

.custom-tooltip-bottom {
    position: absolute;
    top: 100%;
    right: 0;
    left: auto;
    transform: translateY(4px);
    margin-top: 8px;
    background-color: #000000;
    color: white;
    padding: 6px 18px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s ease;
    z-index: 10;
}
.custom-tooltip-bottom::after {
    content: "";
    position: absolute;
    bottom: 100%;
    right: 12px;
    border-width: 5px;
    border-style: solid;
    border-color: transparent transparent #000000 transparent;
}
.export-btn:hover .custom-tooltip-bottom {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

/* --------------------------------------------------------------------
   6. STAT CARD (kartu ringkasan angka: qty, RFT, WFT, target, dll)
   -------------------------------------------------------------------- */
.stat-card {
    min-height: 110px;
    height: auto;
}
.stat-card h2,
.stat-card h6 {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}
.stat-card .d-flex.align-items-end { max-width: 100%; }

.color-box-yellow {
    background-color: #363633;
    border: 1px solid var(--color-yellow);
    border-radius: 5px;
    color: var(--color-yellow);
}
.color-box-red {
    background-color: #352837;
    border: 1px solid var(--color-red);
    border-radius: 5px;
}
.color-box-blue {
    background-color: #23304E;
    border: 1px solid #3F5588;
    border-radius: 5px;
}
.color-box-green {
    background-color: #1A3B45;
    border: 1px solid var(--color-green);
    border-radius: 5px;
    color: var(--color-green);
}

@media (min-width: 992px) and (max-width: 1400px) {
    .dashboard-title { font-size: 1.5rem; }
    .dashboard-subtitle { font-size: 0.85rem !important; }
    .btn-custom {
        padding-left: 0.85rem !important;
        padding-right: 0.85rem !important;
        padding-top: 0.6rem !important;
        padding-bottom: 0.6rem !important;
        font-size: 0.9rem;
        white-space: nowrap;
    }
    .stat-card { font-size: 14px; padding: 0.75rem !important; min-height: 165px; height: auto; }
    .stat-card img { width: 45px !important; height: 45px !important; }
    .stat-card h2 { font-size: 1.4rem; }
    .stat-card h6 { font-size: 0.8rem; }
}

@media (max-width: 768px) {
    .dashboard-title { font-size: 1.4rem; }
    .dashboard-subtitle { font-size: 1rem !important; }
    .footer-title { padding-top: 30px; }
    .stat-card { padding: 0.75rem !important; min-height: 150px; height: auto; font-size: 12px; }
    .stat-card img { width: 45px !important; height: 45px !important; }
}

@media (max-width: 576px) {
    .dashboard-title { font-size: 1.1rem; }
    .dashboard-subtitle { display: none; }
    .d-flex.flex-wrap > .d-flex { width: 100%; }
    .color-box-yellow img, .color-box-red img,
    .color-box-blue img, .color-box-green img {
        width: 40px !important; height: 40px !important;
    }
    .color-box-yellow h2, .color-box-red h2,
    .color-box-blue h2, .color-box-green h2 {
        font-size: 1.4rem;
    }
}

/* --------------------------------------------------------------------
   7. FILTER COMPONENT (icon+label+input, select2, flatpickr, action-btn)
   Dipakai oleh partial "filter" di semua modul dashboard.
   -------------------------------------------------------------------- */
.bg-custom-select {
    background: var(--bg-dark-2);
    color: #fff;
    border: 0;
}

.box-custom { width: 35px; height: 35px; }

.form-control,
.select2-container--default .select2-selection--single {
    height: 38px;
    border-radius: 0.375rem;
}

input[type="text"] {
    background-color: var(--bg-dark-1);
    color: white;
    border: none;
}
input[type="text"]:focus {
    background-color: var(--bg-dark-1);
    color: white;
    border-color: var(--border-muted);
    box-shadow: none;
}

/* Select2 dark theme */
.select2-container { width: 100% !important; }
.select2-container--default .select2-selection--single {
    background: var(--bg-dark-1);
    border: none;
    display: flex;
    align-items: center;
}
.select2-container--default .select2-selection--single .select2-selection__rendered {
    color: white;
    line-height: 38px;
    padding-left: 0.75rem;
}
.select2-container--default .select2-selection--single .select2-selection__arrow { height: 38px; }
.select2-container--default .select2-selection--single .select2-selection__placeholder { color: #ffffff !important; }
.select2-container--default .select2-results__option--highlighted[aria-selected] {
    background-color: transparent !important;
    color: white !important;
}
.select2-container--default .select2-results__option[aria-selected="true"] {
    background-color: transparent !important;
    color: white !important;
}
.select2-dropdown { background: var(--bg-dark-1); color: white; }
.select2-results__option { color: white; }
.select2-search__field { background: var(--bg-dark-1); color: white; border: none; }
.select2-results__options::-webkit-scrollbar { width: 6px; }
.select2-results__options::-webkit-scrollbar-thumb { background: #D9D9D9; border-radius: 4px; }

/* Flatpickr dark theme */
.flatpickr-calendar {
    background: var(--bg-dark-2);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.35);
    border: none;
    width: 100%;
    max-width: 307px;
}
.flatpickr-calendar.arrowTop:before,
.flatpickr-calendar.arrowTop:after { display: none; }
.flatpickr-months { border-radius: 12px 12px 0 0; padding: 10px 0; }
.flatpickr-current-month { color: #fff; font-weight: 700; font-size: 1.1rem; }
.flatpickr-current-month .flatpickr-monthDropdown-months,
.flatpickr-current-month input.cur-year { color: #fff; background: transparent; }
.flatpickr-months .flatpickr-prev-month,
.flatpickr-months .flatpickr-next-month { color: #fff; fill: #fff; top: 12px; }
.flatpickr-months .flatpickr-prev-month svg,
.flatpickr-months .flatpickr-next-month svg { fill: #fff; }
.flatpickr-weekdays { background: var(--bg-dark-4); }
span.flatpickr-weekday { background: var(--bg-dark-4); color: #cfd8ec; font-weight: 600; }
.flatpickr-days { background: var(--bg-dark-4); border: none; }
.dayContainer { background: var(--bg-dark-4); }
.flatpickr-day { color: #fff; border-radius: 10px; }
.flatpickr-day:hover { background: #33456b; }
.flatpickr-day.today { border-color: #6c8cd5; }
.flatpickr-day.prevMonthDay,
.flatpickr-day.nextMonthDay { color: #5a6785; }
.flatpickr-day.selected,
.flatpickr-day.selected:hover { background: #32549A; border-color: #32549A; color: #fff; }
.flatpickr-day.flatpickr-disabled,
.flatpickr-day.flatpickr-disabled:hover { color: #5a6785; cursor: not-allowed; }

.period-date .position-relative { flex: 1 1 0; min-width: 0; }
.period-date input { font-size: 0.85rem; }

.margin-button { margin-right: 80px; }
.action-btn { display: flex; align-items: end; gap: 12px; }

@media (min-width: 992px) and (max-width: 1400px) {
    #line, #groupbuyer, #datea, #dateb { font-size: 0.85rem; }
    #findbtn { white-space: nowrap; padding-left: 0.75rem; padding-right: 0.75rem; }
    .period-date .position-relative { flex: 1; }
    .period-date input { font-size: 0.8rem; padding-left: .5rem; padding-right: 2rem; }

    /* NOTE: sebelumnya nyasar di index.blade.php, ini sebenarnya styling filter */
    .row.mt-4 .box-custom { width: 26px; height: 26px; }
    .row.mt-4 img[style*="30px"] { width: 22px !important; height: 22px !important; }
    .row.mt-4.border-custom > [class*="col-"] {
        gap: 0.75rem !important;
        padding-left: 0.5rem;
        padding-right: 0.5rem;
    }
    .row.mt-4 label { font-size: 0.8rem; }
}

@media (max-width: 1024px) {
    .period-date { display: flex; flex-direction: column; }
    .icon-filter { display: none; }
    .to { display: none; }
    .wrapper-date { width: 100%; margin: 0; padding: 0 !important; align-items: stretch !important; }
    .margin-button { width: 200px; margin-right: 0; }
}

@media (min-width: 1024px) and (max-width: 1030px) {
    .margin-button { width: 100px; margin-right: 0; }
}

@media (max-width: 767.98px) {
    .period-date { flex-direction: column; align-items: stretch; }
    .period-date .position-relative { width: 100%; }
    .period-date span.px-2 { text-align: center; padding: 4px 0 !important; }
    #findbtn { width: 100%; }
    .icon-filter { display: none; }
    .action-btn { width: 100%; justify-content: space-between; align-items: center; }
    .margin-button { margin-right: 0; width: auto; }
}

/* --------------------------------------------------------------------
   8. TABLE / DATATABLE COMPONENT (theme, header, search, skeleton, copy badge)
   -------------------------------------------------------------------- */
.table-custom { border-collapse: collapse; }
.table-custom th {
    background-color: var(--bg-dark-3) !important;
    color: white;
    text-align: center;
    vertical-align: middle;
}
.table-custom td {
    background-color: var(--bg-dark-2) !important;
    color: white;
    border: 1px solid var(--bg-dark-3) !important;
}

.datatable-wrap {
    display: flex;
    flex-direction: column;
    overflow-y: hidden;
    flex: 1 1 auto;
    min-height: 0;
}
.table-scroll-area {
    flex: 1 1 auto;
    min-height: 200px;
    height: auto;
    max-height: none;
    overflow-y: auto;
    position: relative;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
}

h5.text-nowrap { white-space: nowrap; }

.wrapper-title { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; width: 100%; }
.datatable-header-left { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.datatable-header-right { display: flex; align-items: center; gap: 8px; flex-wrap: nowrap; }

.search-wrapper { position: relative; width: 250px; }
.search-icon {
    position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
    width: 18px; height: 18px; pointer-events: none;
}
.search-input { width: 250px; max-width: 100%; padding-left: 40px; }
.export-text { display: none; }

.position-relative { flex-grow: 0; width: 250px; min-width: 160px; }

/* Skeleton loading */
.skeleton-td { padding: 10px 8px !important; }
.skeleton-bar {
    height: 14px;
    border-radius: 6px;
    background: linear-gradient(90deg, #2a3346 25%, #3a4560 37%, #2a3346 63%);
    background-size: 400% 100%;
    animation: skeleton-shimmer 1.4s ease infinite;
}
.skeleton-badge { height: 28px; width: 90px; margin: 0 auto; border-radius: 999px; }
@keyframes skeleton-shimmer {
    0% { background-position: 100% 50%; }
    100% { background-position: 0 50%; }
}

/* Scrollbar */
.table-scroll-wrapper::-webkit-scrollbar { height: 8px; width: 8px; }
.table-scroll-wrapper::-webkit-scrollbar-track { background: var(--bg-dark-2); border-radius: 4px; }
.table-scroll-wrapper::-webkit-scrollbar-thumb { background: #D9D9D9; border-radius: 4px; }
.table-scroll-wrapper { scrollbar-width: thin; scrollbar-color: #D9D9D9 var(--bg-dark-2); }
.table-responsive { -webkit-overflow-scrolling: touch; }

/* Copy-to-clipboard badge (mobile) */
.copyable-cell { cursor: default; }
@media (max-width: 991.98px) {
    .copyable-cell { cursor: pointer; }
}
.copy-badge-popover {
    position: fixed;
    z-index: 1080;
    background-color: var(--bg-dark-3);
    border: 1px solid var(--color-blue);
    border-radius: 8px;
    padding: 8px 12px;
    color: #fff;
    font-size: 13px;
    max-width: 260px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    gap: 10px;
    animation: copyBadgeFadeIn .15s ease-out;
}
.copy-badge-popover .copy-badge-text { word-break: break-word; flex: 1; line-height: 1.3; }
.copy-badge-popover .copy-badge-icon { flex-shrink: 0; width: 16px; height: 16px; cursor: pointer; opacity: 0.85; }
.copy-badge-popover.copied { border-color: var(--color-green); }
.copy-badge-popover .copy-badge-status { font-size: 11px; color: var(--color-green); display: none; }
.copy-badge-popover.copied .copy-badge-status { display: block; }
.copy-badge-popover.copied .copy-badge-text { display: none; }
@keyframes copyBadgeFadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
}

@media (min-width: 992px) and (max-width: 1400px) {
    #datedatatables { font-size: 0.85rem; }
    .search-input { width: 170px; }
    h5.text-nowrap { font-size: 1.05rem; }
    .datatable-wrap { flex-grow: 1; min-height: 0; }
    .table-scroll-area { flex-grow: 1; min-height: 0; max-height: none; height: auto; }
    .wrapper-title { flex-wrap: nowrap; }
    .datatable-header-left { flex: 1 1 auto; min-width: 0; }
    .datatable-header-right { flex: 0 0 auto; margin-left: auto; }
    #datedatatables { max-width: 100%; }
}

@media (min-width: 768px) and (max-width: 991.98px) {
    .datatable-header-left,
    .datatable-header-right { width: 100%; flex-wrap: wrap; }
    .datatable-header-left h5.text-nowrap { white-space: normal; font-size: 1rem; flex: 1 1 auto; min-width: 0; }
    .datatable-header-left .position-relative { flex: 1 1 220px; min-width: 200px; }
    .datatable-header-right { justify-content: flex-start; }
    .datatable-header-right .search-input { width: 240px; flex: 1 1 240px; }
}

@media (max-width: 767.98px) {
    #datedatatables { width: 100% !important; }
    .search-input { width: 100%; }
    #find { flex-shrink: 0; }
    .wrapper-title { flex-direction: column; align-items: stretch; }
    .datatable-header-left { width: 100%; flex-wrap: wrap; row-gap: 0.5rem; }
    .datatable-header-left h5.text-nowrap { white-space: normal; font-size: 0.95rem; flex: 1 1 auto; min-width: 0; word-break: break-word; }
    .datatable-header-left .position-relative { width: 100%; flex-grow: 0; min-width: 0; }
    .datatable-header-right { width: 100%; justify-content: space-between; }
    .datatable-header-right .search-input { flex: 1 1 100%; }
    .search-wrapper { flex: 1; width: auto; }
    .export-btn { padding: 6px 12px !important; color: white; font-size: 0.85rem; font-weight: 500; }
    .export-text { display: inline-block; }
    .detailIcon { display: none; }
    .position-relative { flex-grow: 1; width: auto; min-width: 0; }
}
