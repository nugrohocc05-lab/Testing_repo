
.border-custom-datatable {
    border: 1px solid #4C8CF2 !important;
    background-color: #212B3E;
}

.table-custom th {
    background-color: #1C2536 !important;
    color: white;
}

.table-custom td {
    background-color: #242E3E !important;
    color: white;
}

#tableInlinePerformance {
    border-collapse: separate;
    border-spacing: 0;
}

#tableInlinePerformance thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    will-change: transform;
}

#tableInlinePerformance tfoot td {
    position: sticky;
    bottom: 0;
    z-index: 2;
    background-color: #1C2536 !important;
    will-change: transform;
}

#tableInlinePerformance tbody td:nth-child(3) { color: #4CF299; }
#tableInlinePerformance tbody td:nth-child(4) { color: #4C8CF2; }
#tableInlinePerformance tbody td:nth-child(5) { color: #E65858; }
#tableInlinePerformance tbody td:nth-child(6) { color: #4CF299; }
#tableInlinePerformance tbody td:nth-child(7) { color: #E65858; }

#searchLine::placeholder {
    color: white;
    opacity: 1;
    font-weight: 300;
}

.datatable-wrap {
    display: flex;
    flex-direction: column;
}

.table-scroll-area {
    overflow-y: auto;
    overscroll-behavior: contain;
    height: max(280px, calc(100vh - 560px));
}

#datedatatables {
    max-width: 100%;
}

.search-input {
    width: 250px;
    max-width: 100%;
}

h5.text-nowrap {
    white-space: nowrap;
}

@media (max-width: 767.98px) {
    #datedatatables {
        width: 100% !important;
    }
    .search-input {
        width: 100%;
    }
    .datatable-header-left,
    .datatable-header-right {
        width: 100%;
    }
    #find {
        flex-shrink: 0;
    }

    /* Detail per line header: stop title/date-input from overflowing */
    .datatable-header-left {
        flex-wrap: wrap;
        row-gap: 0.5rem;
    }
    .datatable-header-left h5.text-nowrap {
        white-space: normal;
        font-size: 0.95rem;
        flex: 1 1 auto;
        min-width: 0;
        word-break: break-word;
    }
    .datatable-header-left .position-relative {
        width: 100% !important;
        flex-grow: 0 !important;
        min-width: 0 !important;
    }
    .datatable-header-right {
        justify-content: space-between;
    }
    .datatable-header-right .search-input {
        flex: 1 1 100%;
    }
}

/* Tablet range: header row wasn't stacking before, causing the title + date
   input + search/find/export to be squeezed into one cramped row */
@media (min-width: 768px) and (max-width: 991.98px) {
    .datatable-header-left,
    .datatable-header-right {
        width: 100%;
        flex-wrap: wrap;
    }
    .datatable-header-left h5.text-nowrap {
        white-space: normal;
        font-size: 1rem;
        flex: 1 1 auto;
        min-width: 0;
    }
    .datatable-header-left .position-relative {
        flex: 1 1 220px !important;
        min-width: 200px !important;
    }
    .datatable-header-right {
        justify-content: flex-start;
    }
    .datatable-header-right .search-input {
        width: 240px;
        flex: 1 1 240px;
    }
}

@media (min-width: 992px) and (max-width: 1400px) {
    #datedatatables {
        font-size: 0.85rem;
    }
    .search-input {
        width: 170px;
    }
    h5.text-nowrap {
        font-size: 1.05rem;
    }
}
