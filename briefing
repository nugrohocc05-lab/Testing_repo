<RouterView v-slot="{ Component, route }">
    <KeepAlive :include="cachedViews">
        <component :is="Component" v-if="route.meta.keepAlive" :key="route.name" />
    </KeepAlive>

    <component :is="Component" v-if="!route.meta.keepAlive" :key="route.name" />
</RouterView>

import { ref, watch } from 'vue'
import { useRoute } from 'vue-router'

const route = useRoute()
const cachedViews = ref([])

watch(
  () => route.fullPath,
  () => {
    const matched = route.matched[route.matched.length - 1]
    const compName = matched?.components?.default?.name
    const family = route.meta.family

    // cek family komponen yang lagi nyangkut di cache saat ini
    // (asumsi 1 keluarga = 1 grup nama komponen, kita simpan mapping family -> names)
    if (route.meta.keepAlive && compName) {
      // kalau family berubah dari yang terakhir di-track, reset cache dulu
      if (window.__lastFamily && window.__lastFamily !== family) {
        cachedViews.value = []
      }
      window.__lastFamily = family

      if (!cachedViews.value.includes(compName)) {
        cachedViews.value.push(compName)
      }
    }
  },
  { immediate: true }
)

const lastFamily = ref(null)

watch(
  () => route.fullPath,
  () => {
    const matched = route.matched[route.matched.length - 1]
    const compName = matched?.components?.default?.name
    const family = route.meta.family

    if (route.meta.keepAlive && compName) {
      if (lastFamily.value && lastFamily.value !== family) {
        cachedViews.value = []
      }
      lastFamily.value = family

      if (!cachedViews.value.includes(compName)) {
        cachedViews.value.push(compName)
      }
    }
  },
  { immediate: true }
)

