<template>
    <div class="px-6">
        <UiTitle align="center" title="Master Factory" subtitle="" />
        <!-- User Type -->
        <div class="mb-4 flex gap-3">
            <UiButton @click="setNewData" class="mr-auto">+Add Data</UiButton>

            <div class="w-50">
                <UiInput v-model="searchKeyword" placeholder="Search" class="rounded-lg">
                    <template #prefix>
                        <MagnifyingGlassIcon class="h-5 w-5 text-gray-400" />
                    </template>
                </UiInput>
            </div>

        </div>

        <UiAgGrid :rowData="rawData" :columnDefs="columnDefs" :defaultColDef="defaultColDef"
            class="mb-10 my-zebra-grid" :quickFilterText="searchKeyword" ></UiAgGrid>
    </div>


    <UiModal v-model="showModal" :title="`${action} - [ ${dataSelected.namafactory ?? 'New Factory'} ]`" size="md">
        <div class="space-y-3 -mt-3">
            <div class="flex space-x-3">
                <div :hidden="isNewData">
                    <UiInput label="ID Factory" :readonly="!isNewData" v-model="form.idfactory" type="text" placeholder="ID Factory"></UiInput>
                </div>
                <UiInput label="Factory Code" filter="text" maxLength="5" required case="upper" labelClass="" v-model="form.kode" type="text" placeholder="Kode"></UiInput>
            </div>
            <UiInput label="Name" labelClass="" filter="text" maxLength="50" required case="capitalize" v-model="form.namafactory" type="text" placeholder="Full Name"></UiInput>
            <div class="flex space-x-3">
                <UiInput label="SAP Code" filter="text" case="upper" maxLength="5" labelClass="" v-model="form.sap_code" type="text" placeholder="SAP Code"></UiInput>
                <UiInput label="Vendor SAP Code" filter="text" maxLength="10" labelClass="" v-model="form.vendor_sap_code" type="text" placeholder="Vendor SAP Code"></UiInput>
            </div>
            <UiInput label="Alamat" case="capitalize" required filter="name-special" maxLength="100" labelClass="" v-model="form.alamat" type="text" placeholder="Alamat"></UiInput>
            <div class="flex space-x-3">
                <UiInput label="Kota" filter="text" maxLength="25" required case="capitalize" labelClass="" v-model="form.kota" type="text" placeholder="Kota"></UiInput>
                <UiInput label="Provinsi" maxLength="25" filter="text" required case="capitalize" labelClass="" v-model="form.provinsi" type="text" placeholder="Provinsi"></UiInput>
            </div>
            
            <div class="flex space-x-3">
                <UiInput label="Kodepos" filter="number" labelClass="" maxLength="10" v-model="form.kodepos" type="text" placeholder="Kodepos"></UiInput>
                <UiInput label="Work Day" maxLength="1" v-model="form.work_day" type="number" min="1" max="7" placeholder="Work Day"></UiInput>
                
            </div>
            <div>
                <UiAccordion
                    v-for="doc in docTypes"
                    :key="doc.key"
                    :title="doc.label"
                    variant="line"
                    :default-open="doc.key === 'npwp'"
                    :sticky="true"
                >
                    <div class="space-y-2">
                        <div
                            v-if="getFileInfo(doc.key)"
                            class="flex items-center gap-2 rounded-lg border border-slate-200 p-2"
                        >
                            <img
                                :src="fileIcon(getFileInfo(doc.key).name)"
                                class="h-10 w-10"
                            />

                            <div class="min-w-0 flex-1">
                                <div class="truncate text-sm sm:text-md">
                                    {{ getFileInfo(doc.key).name }}
                                </div>

                                <div class="text-xs text-slate-500">
                                    {{
                                        getFileInfo(doc.key).pending
                                            ? 'Belum disimpan'
                                            : 'Uploaded: ' + getFileInfo(doc.key).date
                                    }}
                                </div>
                            </div>

                            <UiButton variant="teritary-danger" @click="removeFile(doc.key)">
                                <TrashIcon class="h-7 w-7" />
                            </UiButton>
                        </div>

                        <div v-else class="text-center text-sm text-slate-400">
                            Belum ada file
                        </div>

                        <div class="mb-5 text-center">
                            <UiButton
                                rounded="full"
                                variant="primary"
                                @click="openUpload(doc.key)"
                            >
                                <DocumentPlusIcon class="h-5 w-5" />
                                Upload File
                            </UiButton>
                        </div>
                    </div>
                </UiAccordion>
            </div>
        </div>
        <template #footer>
            <div class="flex justify-end">
                <UiButton @click="showModal = false; isNewData = null; resetFiles()" variant="danger">Cancel</UiButton>
                <UiButton @click="isNewData ? storeNewData() : submit()" :disabled="!isFormChanged" class="ml-3">Save</UiButton>
            </div>
        </template>
    </UiModal>
    <UiModal
        v-model="showModalUpload"
        :title="`Upload ${uploadLabel}`"
        size="md"
    >
        <div class="space-y-3">
            <label class="block font-medium text-gray-700">
                {{ uploadLabel }} Document
            </label>

            <div
                class="relative w-full cursor-pointer rounded-lg border-2 border-dashed bg-white p-6 text-center transition-all duration-150"
                :class="isDragging
                    ? 'border-[#1FBCC3] bg-[#1FBCC3]/5 ring-2 ring-[#1FBCC3]/20'
                    : 'border-gray-300 hover:border-[#1FBCC3] hover:bg-gray-50/50'"
                @click="uploadInput?.click()"
                @dragover.prevent="isDragging = true"
                @dragleave.prevent="isDragging = false"
                @drop.prevent="onDropFile"
            >
                <input
                    ref="uploadInput"
                    type="file"
                    accept=".pdf,.jpg,.jpeg,.png"
                    class="hidden"
                    @change="onPickFile"
                />

                <div v-if="!tempFile" class="flex flex-col items-center">
                    <ArrowUpTrayIcon
                        class="mb-2 h-8 w-8"
                        :class="isDragging ? 'text-[#1FBCC3]' : 'text-gray-400'"
                    />
                    <p
                        class="text-sm font-medium"
                        :class="isDragging ? 'text-[#1FBCC3]' : 'text-gray-700'"
                    >
                        {{ isDragging ? 'Drop file here' : 'Choose a file or drag & drop here' }}
                    </p>
                    <p class="mt-2 text-xs text-gray-400">
                        Only PDF, JPG, JPEG, and PNG files are allowed (max 5MB).
                    </p>
                </div>

                <div
                    v-else
                    class="flex items-center rounded-lg border p-2 text-[#1FBCC3]"
                >
                    <img
                        :src="fileIcon(tempFile.name)"
                        class="h-10 w-10 shrink-0"
                    />
                    <span class="flex-1 truncate px-3 text-left text-xs font-medium">
                        {{ tempFile.name }}
                    </span>
                    <button
                        type="button"
                        class="ml-2 flex h-6 w-6 shrink-0 cursor-pointer items-center justify-center rounded-full text-gray-400 hover:bg-red-50 hover:text-red-500"
                        @click.stop="tempFile = null"
                    >
                        <span class="text-lg leading-none">&times;</span>
                    </button>
                </div>
            </div>
        </div>

        <template #footer>
            <div class="flex justify-end gap-2">
                <UiButton
                    variant="white-danger"
                    @click="showModalUpload = false"
                >
                    Cancel
                </UiButton>

                <UiButton
                    variant="primary"
                    :disabled="!tempFile"
                    @click="saveUpload"
                >
                    Save
                </UiButton>
            </div>
        </template>
    </UiModal>

</template>

<script setup>
import { ref, onMounted, computed, defineComponent, h } from "vue";
import { useRouter } from "vue-router";
import { useLoadingStore } from "@/stores/loading";
import { PencilSquareIcon, TrashIcon, MagnifyingGlassIcon, ArrowUpTrayIcon } from "@heroicons/vue/24/outline";
import { customSwal } from "@/composable/customSwal";
const { confirmDelete, success, warning, error } = customSwal;

import UiButton from "@/components/ui/UiButton.vue"
import UiInput from "@/components/ui/UiInput.vue"
import UiModal from "@/components/ui/UiModal.vue"
import UiTitle from "@/components/ui/UiTitle.vue"

import api from "@/services/api";

import '@vuepic/vue-datepicker/dist/main.css'
import UiAgGrid from "@/components/ui/UiAgGrid.vue";
import UiTooltip from "@/components/ui/UiTooltip.vue";
import { DocumentPlusIcon } from "@heroicons/vue/24/solid";
import UiAccordion from "@/components/ui/UiAccordion.vue";

const loading = useLoadingStore();
const router = useRouter();
const rawData = ref([]);
const dataSelected = ref([]);
const action = ref("");
const isNewData = ref(false)
const showModal = ref(false)
const showModalUpload = ref(false)
const searchKeyword = ref('')
const originalForm = ref(null)

const defaultColDef = {
    sortable: true,
    filter: false,
    resizable: true,
};

const form = ref({
    idfactory: "",
    kode: "",
    work_day: "",
    namafactory: "",
    kota: "",
    sap_code: "",
    vendor_sap_code: "",
    alamat: "",
    kodepos: "",
    provinsi: "",
});

const maxDate = new Date()
maxDate.setFullYear(maxDate.getFullYear() - 5)

// ===== Upload file: NPWP, IUI, SIUP, Faktur =====
const MAX_FILE_SIZE = 5 * 1024 * 1024 // 5MB

const docTypes = [
    { key: 'npwp', label: 'NPWP' },
    { key: 'iui', label: 'IUI' },
    { key: 'siup', label: 'SIUP' },
    { key: 'faktur', label: 'Faktur' },
]
const emptyDocs = () => ({ npwp: null, iui: null, siup: null, faktur: null })

const pendingFiles = ref(emptyDocs())   // file baru yang belum dikirim ke server
const removedFiles = ref(emptyDocs())   // true = hapus file lama di server
const uploadTarget = ref(null)          // dokumen yang sedang di-upload
const tempFile = ref(null)              // file yang dipilih di modal upload
const uploadInput = ref(null)
const isDragging = ref(false)

const uploadLabel = computed(
    () => docTypes.find(d => d.key === uploadTarget.value)?.label ?? ''
)

const resetFiles = () => {
    pendingFiles.value = emptyDocs()
    removedFiles.value = emptyDocs()
}

const fileIcon = (name = '') => {
    const ext = String(name).split('.').pop().toLowerCase()
    return ext === 'pdf'
        ? '/images/icons/file/pdf.svg'
        : '/images/icons/file/img.svg'
}

// Info file yang ditampilkan: file baru (pending) > file lama dari server
// SESUAIKAN nama field `${key}_file` dan `${key}_uploaded_at` dengan respons API Anda
const getFileInfo = (key) => {
    if (pendingFiles.value[key]) {
        return { name: pendingFiles.value[key].name, pending: true }
    }
    if (removedFiles.value[key]) return null

    const path = dataSelected.value?.[`${key}_file`]
    if (!path) return null

    return {
        name: String(path).split('/').pop(),
        date: dataSelected.value?.[`${key}_uploaded_at`] ?? '-',
        pending: false,
    }
}

const openUpload = (key) => {
    uploadTarget.value = key
    tempFile.value = null
    isDragging.value = false
    showModalUpload.value = true
}

// Validasi tipe & ukuran, lalu simpan sementara di tempFile
const validateAndSetTemp = async (f) => {
    if (!f) return

    const okType = /\.(pdf|jpe?g|png)$/i.test(f.name)
    if (!okType || f.size > MAX_FILE_SIZE) {
        await warning({
            title: "File tidak valid",
            text: "Hanya PDF/JPG/PNG, maksimal 5MB.",
        })
        return
    }

    tempFile.value = f
}

const onPickFile = (e) => {
    const f = e.target.files?.[0]
    e.target.value = '' // supaya file yang sama bisa dipilih ulang
    validateAndSetTemp(f)
}

const onDropFile = (e) => {
    isDragging.value = false
    validateAndSetTemp(e.dataTransfer?.files?.[0])
}

// Klik Save di modal upload: simpan ke state, tutup modal upload.
// Modal data (add/edit) tetap terbuka.
const saveUpload = () => {
    if (!tempFile.value) return

    pendingFiles.value[uploadTarget.value] = tempFile.value
    removedFiles.value[uploadTarget.value] = false
    tempFile.value = null
    showModalUpload.value = false
}

const removeFile = (key) => {
    if (pendingFiles.value[key]) {
        pendingFiles.value[key] = null
    } else {
        removedFiles.value[key] = true
    }
}

const buildFormData = () => {
    const fd = new FormData()
    Object.entries(form.value).forEach(([k, v]) => fd.append(k, v ?? ''))

    docTypes.forEach(({ key }) => {
        if (pendingFiles.value[key]) {
            fd.append(`${key}_file`, pendingFiles.value[key])
        } else if (removedFiles.value[key]) {
            fd.append(`delete_${key}`, 1)
        }
    })
    return fd
}
// ===== End upload file =====

const isFormChanged = computed(() => {
    if (!originalForm.value) return false

    const fileChanged = docTypes.some(
        ({ key }) => pendingFiles.value[key] || removedFiles.value[key]
    )

    return (
        fileChanged ||
        Object.keys(form.value).some(
            key => form.value[key] !== originalForm.value[key]
        )
    )
})

const setForm = () => {
    const data = dataSelected.value;

    if (!data) return;
    form.value = {
        idfactory: data.idfactory ?? "",
        kode: data.kode ?? "",
        namafactory: data.namafactory ?? "",
        kota: data.kota ?? "",
        sap_code: data.sap_code ?? null,
        vendor_sap_code: data.vendor_sap_code ?? "",
        alamat: data.alamat ?? "",
        kodepos: data.kodepos ?? "",
        provinsi: data.provinsi ?? "",
        work_day: data.work_day ?? ""
    };
    resetFiles()
    isNewData.value = false;
    originalForm.value = { ...form.value }
};

const setNewData = () => {
    isNewData.value = true
    dataSelected.value = "New Data";
    action.value = "Add";

    form.value = {
        idfactory: "",
        kode: "",
        namafactory: "",
        kota: "",
        sap_code: "",
        vendor_sap_code: "",
        alamat: "",
        kodepos: "",
        provinsi: "",
        work_day: "",
    };

    resetFiles()
    showModal.value = true
    originalForm.value = { ...form.value }
};

const closeModal = () => {
    showModal.value = false;
    isNewData.value = false;
    resetFiles()
};

const ActionRenderer = defineComponent({
    props: {
        params: {
            type: Object,
            required: true,
        },
    },

    setup(props) {

        const editData = () => {
            dataSelected.value = props.params.data;
            action.value = "Edit Data";
            setForm();
            showModal.value = true;
        };

        const deleteData = () => {
            dataSelected.value = props.params.data;
            deleteThisData()
        };

        return () =>
            h(
                "div",
                {
                    class: "flex h-full items-center justify-center gap-3",
                },
                [
                    h(
                        "button",
                        {
                            type: "button",
                            title: "Edit",
                            class:
                                "cursor-pointer text-blue-500 transition hover:text-blue-700",
                            onClick: editData,
                        },
                        [
                            h(PencilSquareIcon, {
                                class: "h-5 w-5",
                            }),
                        ],
                    ),

                    h(
                        "button",
                        {
                            type: "button",
                            title: "Delete",
                            class: "cursor-pointer text-red-500 hover:text-red-700",
                            onClick: deleteData,
                        },
                        [
                            h(TrashIcon, {
                                class: "h-5 w-5",
                            }),
                        ],
                    ),
                ],
            );
    },
});

const columnDefs = [
    {
        headerName: "No",
        field: "no",
        width: 80,
        filter: false,
        resizable: true,
    },
    {
        field: "namafactory",
        headerName: "Name",
        minWidth: 150,
        flex: 1,
    },
    {
        field: "sap_code",
        headerName: "SAP Code",
        minWidth: 150,
        valueGetter: (params) => {
            return params.data?.sap_code ?? "-";
        },
    },
    {
        field: "vendor_sap_code",
        headerName: "Vendor SAP Code",
        minWidth: 100,
        valueGetter: (params) => {
            return params.data?.vendor_sap_code ?? "-";
        },
    },
    {
        field: "kode",
        headerName: "Factory Code",
        minWidth: 100,
        valueGetter: (params) => {
            return params.data?.kode ?? "-";
        },
    },
    {
        headerName: "Action",
        minWidth: 120,
        maxWidth: 120,
        sortable: false,
        filter: false,
        resizable: false,
        cellRenderer: ActionRenderer,
    },
];

const loadData = async () => {
    try {
        loading.show();
        const endpoint = "/api/v1/master/getFactory";

        const { data } = await api.get(endpoint);
        rawData.value = data?.data ?? [];

        rawData.value = (data?.data ?? []).map((item, index) => ({
            ...item,
            no: index + 1,
        }));
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

onMounted(() => {
    loadData();
});

const storeNewData = async () => {
    try {

        if (
            !form.value.namafactory ||
            !form.value.kota ||
            !form.value.alamat ||
            !form.value.provinsi
        ) {
            await warning({
                title: "Incomplete Data",
                text: "Please complete all required fields.",
            });
            return
        }

        loading.show()

        const endpoint = "api/v1/master/add-factory";
        const { data } = await api.post(
            endpoint,
            buildFormData(),
            { headers: { "Content-Type": "multipart/form-data" } }
        );
        isNewData.value = false
        closeModal()
        loading.hide()
        await success({
                title: "Success",
                text: data?.message || "Data Added successfully.",
            });
        await loadData()

    } catch (err) {
        loading.hide()
        if (err?.response?.status === 401) {
            router.push("/login")
            return
        }

await error({
            title:"Add Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to add the data. Please try again.",
        });
    }
}

const submit = async () => {
    try {
        loading.show()
        const endpoint = `api/v1/master/update-factory/${dataSelected.value.idfactory}`;

        const fd = buildFormData()
        // Laravel tidak membaca multipart pada PUT asli, jadi pakai method spoofing.
        // Jika backend BUKAN Laravel: hapus baris ini dan pakai api.put(endpoint, fd)
        fd.append('_method', 'PUT')

        const { data } = await api.post(
            endpoint,
            fd,
            { headers: { "Content-Type": "multipart/form-data" } }
        );
        closeModal()
        loading.hide()
        await success({
            title: "Success",
            text: data?.message || "Data saved successfully.",
        });
        await loadData()
    } catch (err) {
        loading.hide()
        if (err?.response?.status === 401) {
            router.push("/login")
            return
        }

await error({
            title:"Update Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to update the data. Please try again.",
        });
    }
}

const deleteThisData = async () => {

    const result = await confirmDelete();
    if (!result.isConfirmed) {
        return
    }

    try {
        loading.show()

        const { data } = await api.delete(
            `api/v1/master/delete-factory/${dataSelected.value.idfactory}`
        )

        loading.hide()
        await success({
            title: "Success",
            text: data?.message || "Data has been deleted successfully.",
        });
        await loadData()

    } catch (err) {

        if (err?.response?.status === 401) {
            router.push("/login")
            return
        }

        loading.hide()
await error({
            title:"Update Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to update the data. Please try again.",
        });
    }
}
</script>