            ->get(['idpo', 'revisi', 'qtypo']);

        // qty periode (dta-dtb) yang dipakai buildFinalOverviewData — untuk pembanding
        $qtyPeriodeIni = $qtyPerIdpo->get($idpo, 0);

        // seluruh baris OutputDetail utk idpo ini (raw, tanpa filter tanggal)
