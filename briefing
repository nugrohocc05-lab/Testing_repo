<script setup>
import { computed, useId, nextTick } from "vue";
import Multiselect from "@vueform/multiselect";

import "@vueform/multiselect/themes/default.css";

defineOptions({
    inheritAttrs: false,
});

const props = defineProps({
    modelValue: {
        type: [String, Number, Object, Array, Boolean, null],
        default: null,
    },

    canClear: {
        type: Boolean,
        default: true,
    },

    options: {
        type: Array,
        default: () => [],
    },

    label: {
        type: String,
        default: "",
    },

    optionLabel: {
        type: String,
        default: "label",
    },

    valueProp: {
        type: String,
        default: "value",
    },

    placeholder: {
        type: String,
        default: "Select option",
    },

    searchable: {
        type: Boolean,
        default: true,
    },

    multiple: {
        type: Boolean,
        default: false,
    },

    clearable: {
        type: Boolean,
        default: true,
    },

    disabled: {
        type: Boolean,
        default: false,
    },

    required: {
        type: Boolean,
        default: false,
    },

    canClear: {
        type: Boolean,
        default: true,
    },

    closeOnSelect: {
        type: Boolean,
        default: true,
    },

    hideSelected: {
        type: Boolean,
        default: false,
    },

    mode: {
        type: String,
        default: "single",
        validator: (value) =>
            ["single", "multiple", "tags"].includes(value),
    },

    max: {
        type: Number,
        default: undefined,
    },

    error: {
        type: [String, Boolean],
        default: false,
    },

    hint: {
        type: String,
        default: "",
    },

    size: {
        type: String,
        default: "md",
        validator: (value) =>
            ["sm", "md", "lg"].includes(value),
    },

    labelClass: {
        type: [String, Array, Object],
        default: "md",
    },
});

const emit = defineEmits([
    "update:modelValue",
    "change",
    "select",
    "deselect",
    "open",
    "close",
]);

const generatedId = useId();

const inputId = computed(() => {
    return `multiselect-${generatedId}`;
});

const sizeClasses = computed(() => {
    const sizes = {
        sm: {
            container: "min-h-[34px] text-xs",
        },

        md: {
            container: "min-h-[42px] text-sm",
        },

        lg: {
            container: "min-h-[48px] text-base",
        },
    };

    return sizes[props.size];
});

const handleUpdate = async (value) => {
    if (props.mode === "single" && value == null) {
        document.activeElement?.blur();

        await nextTick();

        emit("update:modelValue", "");
        return;
    }

    emit("update:modelValue", value);
};

const handleChange = (value) => {
    emit("change", value);
};

const handleSelect = (value, option) => {
    emit("select", value, option);
};

const handleDeselect = (value, option) => {
    emit("deselect", value, option);
};

const handleOpen = () => {
    emit("open");
};

const handleClose = () => {
    emit("close");
};
</script>

<template>
    <div class="w-full">
        <label v-if="label" :for="inputId" :class="[
            'mb-1.5 block font-medium text-gray-700',
            labelClass,
        ]">
            {{ label }}

            <span v-if="required" class="ml-0.5 text-red-500">
                *
            </span>
        </label>


        <Multiselect v-bind="$attrs" :id="inputId" :model-value="modelValue" :options="options" :label="optionLabel"
            :value-prop="valueProp" :placeholder="placeholder" :searchable="searchable" :mode="mode"
            :clearable="clearable" :can-clear="canClear" :disabled="disabled" :required="required"
            :close-on-select="closeOnSelect" :hide-selected="hideSelected" :max="max" :class="[
                sizeClasses.container,

                error
                    ? 'multiselect-error'
                    : '',
            ]" @update:model-value="handleUpdate" @change="handleChange" @select="handleSelect"
            @deselect="handleDeselect" @open="handleOpen" @close="handleClose" />

        <!-- Error -->
        <p v-if="error" class="mt-1.5 text-xs text-red-600">
            {{ typeof error === "string" ? error : "" }}
        </p>

        <!-- Hint -->
        <p v-else-if="hint" class="mt-1.5 text-xs text-gray-500">
            {{ hint }}
        </p>
    </div>
</template>

