<script setup>
import { computed, ref } from "vue";
import { ChevronDownIcon } from "@heroicons/vue/24/outline";

const props = defineProps({
    title: {
        type: String,
        default: "",
    },

    modelValue: {
        type: Boolean,
        default: undefined,
    },

    defaultOpen: {
        type: Boolean,
        default: false,
    },

    disabled: {
        type: Boolean,
        default: false,
    },

    variant: {
        type: String,
        default: "line",
        validator: (value) => ["line", "card"].includes(value),
    },
});

const emit = defineEmits([
    "update:modelValue",
    "change",
]);

const internalOpen = ref(props.defaultOpen);

const isOpen = computed(() =>
    props.modelValue !== undefined
        ? props.modelValue
        : internalOpen.value
);

const toggle = () => {
    if (props.disabled) return;

    const value = !isOpen.value;

    if (props.modelValue === undefined) {
        internalOpen.value = value;
    }

    emit("update:modelValue", value);
    emit("change", value);
};
</script>

<template>
    <div class="w-full" :class="[
        variant === 'card'
            ? 'overflow-hidden rounded-xl border border-gray-200 bg-white'
            : '',
    ]">
        <template v-if="variant === 'line'">
            <button type="button" :disabled="disabled" class="group flex w-full items-center gap-3 text-left" :class="[
                disabled
                    ? 'cursor-not-allowed opacity-50'
                    : 'cursor-pointer',
            ]" @click="toggle">
                <!-- TITLE -->
                <span class="shrink-0 whitespace-nowrap font-medium text-[#387891]">
                    {{ title }}
                </span>

                <!-- LINE -->
                <div class="h-px flex-1 bg-slate-400 transition-colors duration-150" />

                <!-- ARROW -->
                <ChevronDownIcon class="h-5 w-5 shrink-0 text-[#387891] transition-all duration-200" :class="[
                    isOpen
                        ? 'rotate-180 text-[#1FBCC3]'
                        : 'group-hover:text-[#1FBCC3]',
                ]" />
            </button>

            <!-- CONTENT -->
            <Transition enter-active-class="transition-all duration-200 ease-out"
                enter-from-class="grid-rows-[0fr] opacity-0" enter-to-class="grid-rows-[1fr] opacity-100"
                leave-active-class="transition-all duration-200 ease-in" leave-from-class="grid-rows-[1fr] opacity-100"
                leave-to-class="grid-rows-[0fr] opacity-0">
                <div v-if="isOpen" class="grid">
                    <div class="min-h-0">
                        <div class="pt-2">
                            <slot />
                        </div>
                    </div>
                </div>
            </Transition>
        </template>

        <template v-else>
            <button type="button" :disabled="disabled"
                class="group flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition-colors duration-150"
                :class="[
                    isOpen
                        ? 'bg-[#1FBCC3]/5'
                        : 'bg-white hover:bg-gray-50',
                    disabled
                        ? 'cursor-not-allowed opacity-50'
                        : 'cursor-pointer',
                ]" @click="toggle">
                <div class="flex min-w-0 items-center gap-3">
                    <!-- ACCENT -->
                    <span class="h-5 w-1 shrink-0 rounded-full transition-colors duration-200" :class="isOpen
                        ? 'bg-[#1FBCC3]'
                        : 'bg-gray-200 group-hover:bg-[#1FBCC3]/50'
                        " />

                    <!-- TITLE -->
                    <span class="truncate text-sm font-semibold transition-colors duration-150" :class="isOpen
                        ? 'text-[#1FBCC3]'
                        : 'text-gray-700'
                        ">
                        {{ title }}
                    </span>
                </div>

                <!-- ARROW -->
                <ChevronDownIcon class="h-5 w-5 shrink-0 transition-all duration-200" :class="isOpen
                    ? 'rotate-180 text-[#1FBCC3]'
                    : 'text-gray-400 group-hover:text-[#1FBCC3]'
                    " />
            </button>

            <!-- CONTENT -->
            <Transition enter-active-class="transition-all duration-200 ease-out"
                enter-from-class="grid-rows-[0fr] opacity-0" enter-to-class="grid-rows-[1fr] opacity-100"
                leave-active-class="transition-all duration-200 ease-in" leave-from-class="grid-rows-[1fr] opacity-100"
                leave-to-class="grid-rows-[0fr] opacity-0">
                <div v-if="isOpen" class="grid">
                    <div class="min-h-0">
                        <div class="border-t border-gray-100 px-5 py-5 text-sm text-gray-600">
                            <slot />
                        </div>
                    </div>
                </div>
            </Transition>
        </template>
    </div>
</template>


