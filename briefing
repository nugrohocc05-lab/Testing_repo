if ($request->query('debug_output_priority')) {
    $outputPerIdpoPriority = collect();
    foreach ($outputRows as $row) {
        $activeIdpo = $rerouteMap->get((string) $row->idpo, (string) $row->idpo);
        $outputPerIdpoPriority->put(
            $activeIdpo,
            $outputPerIdpoPriority->get($activeIdpo, 0) + (int) $row->total_output
        );
    }
    dd([
        'combineProList'    => $combineProList->sort()->values()->toArray(),
        'allHistoryIdpo'    => $allHistoryIdpo->sort()->values()->toArray(),
        'idpoList_basis'    => $idpoList->sort()->values()->toArray(),
        'outputPerIdpo'     => $outputPerIdpoPriority->sortKeys()->toArray(),
        'total_output'      => $outputPerIdpoPriority->sum(),
    ]);
}



if ($request->query('debug_output_overview')) {
    dd([
        'allStatusIdpo'   => $allStatusIdpo->sort()->values()->toArray(),
        'outputPerActiveIdpo' => $outputPerActiveIdpo->sortKeys()->toArray(),
        'total_output'    => $outputPerActiveIdpo->sum(),
    ]);
}