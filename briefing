<script type="text/javascript">
    var dtbarcode = [];
    var bcd_len = [];

    var last_barcode = 0;

    var count = 0;
    var qty = 0;

    $(document).ready(function() {
        $('#donumber').focus();
        $('.box:not(.table)').on('click', function () {
            if ($('#donumber-holder').is(':visible')) {
                $('#donumber').focus();
            } else if ($('#modal-scan ').is(':visible')){
                $('#packingid').focus();
            }
            else {
                $('#barcode').focus();
            }
        });

        $('.modal-scan').on('click', function () {
            $('#packingid').focus();
        });

        var delay = (function(){
            var timer = 0;
            return function(callback, ms){
                clearTimeout (timer);
                    timer = setTimeout(callback, ms);
                };
        })();

        function processDoNumber(e) {
            e.preventDefault();

            $('#donumber').attr('readonly','readonly');
            $('#donumber').blur();

            const donumber = $("#donumber").val();
            $('#loading').show();
            $.ajax({
                type: 'GET',
                url: `{{route("packing_packingreceivefromstoragegetdatado") }}`,
                dataType: "json",
                data: {
                    donumber
                },
                success: function(r) {
                    let rows = r.map((item, i) => {
                        qty = qty+1;
                        return `
                            <tr class="tr${item.key}">
                                <td class="row-number">${$('.row-number').length + i + 1}</td>
                                <td>${item.barcode}</td>
                                <td>${item.style}</td>
                                <td>${item.substyle}</td>
                                <td>${item.color}</td>
                                <td>${item.size}</td>
                                <td>
                                    <div style="pointer-events: none;">
                                        <input type="checkbox" style="height:20px;width:20px;" id="${item.barcode}" class="setstyle minimal"" name="setsubstyle[]">
                                    </div>
                                </td>
                            </tr>
                        `;
                    }).join('');

                    if(qty == '0'){
                        swal('Warning!', 'Invalid DO Type! Please scan DO Storage', 'warning').then(()=>{
                            $('#donumber').removeAttr('readonly');
                            $('#donumber').val('');
                        });
                        return;
                    }

                    $('#scanbody').append(rows);
                    $('#donumber-holder').hide();
                    $('#gi-holder').hide();
                    $('#scanout-body').show();
                    $('#table-holder').show();
                    $('#barcode-holder').show();
                    $('#barcode').focus();
                    $('.box-footer').show();
                },
                error: (e) => {
                    swal("Warning", e.responseJSON, 'warning').then(function(){
                        $('#donumber').val('');
                        $('#donumber').removeAttr('readonly');
                        $('#donumber').focus();
                    });
                },
                complete: () => {
                    $('#donumber').val('');
                    $('#donumber').removeAttr('readonly');
                    $('#donumber').focus();
                    $('#loading').hide();
                }
            });
        }

        App.bindBarcodeHandler({
            selector: "#donumber",
            preventCopyPaste: false,
            onChange: processDoNumber,
        })

        function processBarcode(e) {
            e.preventDefault();
            if ($('#barcode').val().length >= 24) {
                $('#barcode').attr('readonly','readonly');
                $('#barcode').blur();

                const barcode = $("#barcode").val();
                let totalrecord = $('#totalrecords').text();
                $('#loading').show();
                $.ajax({
                    type: 'GET',
                    url: `{{route("packing_packingreceivefromstoragegetdata") }}`,
                    dataType: "json",
                    data: {
                        barcode
                    },
                    success: function(r) {
                        if(bcd_len.includes(r.barcode)){
                            swal('Warning!', 'Garment ID already scanned!', 'warning').then(()=>{
                                $('#barcode').removeAttr('readonly');
                                $('#barcode').val('');
                                $('#barcode').focus();
                            });
                            return;
                        } else if (count == qty){
                            swal('Warning!', 'Quantity has been fulfilled!', 'warning').then(()=>{
                                $('#barcode').removeAttr('readonly');
                                $('#barcode').val('');
                                $('#barcode').focus();
                            });
                            return;
                        }else{
                            var $el = $('#' + r.barcode);

                            if ($el.length) {
                                last_barcode = r.barcode;
                                setHeader(r)
                                bcd_len.push(r.barcode);
                                count = count + 1;
                                $("#totalrecords").text(count)

                                $el.on('ifChecked', function () {});
                                $el.iCheck('check');
                                $('#modal-scan').modal('show');
                            } else {
                                swal('Warning!', 'Wrong Garment ID!', 'warning').then(()=>{
                                    $('#barcode').val('');
                                });
                                return;
                            }
                            $('#barcode').val('');
                            if(count === qty){
                                $('#btn-finish').show();
                            }
                        }
                    },
                    error: (e) => {
                        swal("Warning", e.responseJSON, 'warning').then(function(){
                            $('#barcode').val('');
                            $('#barcode').removeAttr('readonly');
                            $('#barcode').focus();
                        });
                    },
                    complete: () => {
                        $('#barcode').val('');
                        $('#barcode').removeAttr('readonly');
                        $('#loading').hide();
                    }
                });
            }else{
                $('#barcode').val('');
                $('#barcode').removeAttr('readonly');
                $('#barcode').focus();
            }
        }

        App.bindBarcodeHandler({
            onChange: processBarcode
        })

        function processPackingId(e) {
            $("#packingid").blur();
            e.preventDefault();
            $('#loading').show();
            const packingid = $("#packingid").val();
            $.ajax({
                type: 'GET',
                url: `{{ route('packing_packingreceivefromstoragegetpackingid') }}`,
                dataType: "json",
                data: {
                    packingid: packingid,
                    barcode: last_barcode,
                },
                success: function(d) {
                    if(d){
                        const found = dtbarcode.some(el => el.packingid === packingid);

                        if (found) {
                            swal("Warning", "Card Convert ID Already Scanned", 'warning').then(() => {
                                $('#packingid').val('');
                            });
                            return;
                        }
                        dtbarcode.push({ "barcode": last_barcode, "packingid": packingid});
                        $('#modal-scan').modal('hide');
                        console.log(dtbarcode);
                    }
                },
                error: (e) => {
                    $('#packingid').val('');
                    $('#packingid').blur();
                    swal("Warning", e.responseJSON, 'warning').then(function(){
                        $('#packingid').focus();
                        $('#packingid').val('');
                    });
                },
                complete: () => {
                    $('#packingid').val('');
                    $('#barcode').focus();
                    $('#loading').hide();
                }
            });
        }

        App.bindBarcodeHandler({
            selector: "#packingid",
            preventCopyPaste: false,
            onChange: processPackingId
        })

        function setHeader(d){
            $('#nmbuyer').text('');
            $('#kpno').text('');
            $('#nmstyle').text('');
            $('#nmsubstyle').text('');
            $('#nmsize').text('');
            $('#nmcolor').text('');
            $('#last-barcode').text(last_barcode);
            $('#nmbuyer').text(d.nmbuyer);
            $('#kpno').text(d.kpno);
            $('#nmstyle').text(d.nmstyle);
            $('#nmsubstyle').text(d.nmsubstyle);
            $('#nmsize').text(d.nmsize);
            $('#nmcolor').text(d.nmcolor);
            $('#season').text('').text(d.season);
            $('#grade').text('').text(d.grade);
            $('#info-holder').show();
        }


        $('body').on('click', '.minline', function(event) {
            event.preventDefault();
            const _id = String($(this).data('bcd'));
            $(this).parents('.tr'+_id).remove();
            dtbarcode = dtbarcode.filter((v, i) => {
                return v != _id;
            });
            let totalrecord = $('#totalrecords').text();
            const ttlrecord = parseInt(totalrecord)-1;
            $('#totalrecords').text(ttlrecord);
            var n = 1;
            $('.row-number').each(function(){
                $(this).text(n++);
            });
            cekminline();
        });

        $('#btn-cancel').on('click', function(){
            $('#loading').show();
            window.location.reload();
        });

        $('#btn-finish').on('click', function(ev){
            ev.preventDefault();
            swal({
                title: `Are you sure to Finish ${dtbarcode.length} Garment?`,
                text: 'Please do this action carefully!',
                icon: 'warning',
                buttons: true,
                dangerMode: true
            }).then((v) => {
                if(v){
                    finishpacking();
                }
            });
        });

        function finishpacking(){
            $('#loading').show();
            $.ajax({
                type: 'POST',
                url: `{{ route("packing_packingreceivefromstoragefinish") }}`,
                dataType: "json",
                data: {
                    barcode : dtbarcode,
                },
                success: function(r) {
                    swal("Success", r, 'success').then(function(){
                        $('#box-footer').hide();
                        $('#table-holder').hide();
                        dtbarcode = [];
                        $('#barcode').attr('readonly','readonly');
                        window.location.reload();
                    });
                },
                error: (e) => {
                    swal("Warning", e.responseJSON, 'warning').then(function(){
                        $('#barcode').val('');
                        $('#barcode').removeAttr('readonly');
                        $('#barcode').focus();
                        $('#loading').hide();
                    });
                },
                complete: () => {
                    $('#barcode').val('');
                    $('#barcode').removeAttr('readonly');
                    $('#barcode').focus();
                    $('#loading').hide();
                }
            });
        }

        function cekminline(){
            if(dtbarcode.length < 2){
                $('.minline').hide();
                $('#barcode').focus();
                $('#barcode').val('');
            }else{
                $('.minline').show();
                $('.table-holder').show();
            }
        }
    });
</script>
@endsection
