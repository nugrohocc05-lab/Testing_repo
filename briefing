onMounted(() => {
    loadDataKk();
});

watch(() => form.value.kk, () => {
    loadDataKp();
});

watch(() => form.value.kp, () => {
    loadData();
});

const loadDataKp = async () => {
    try {
        form.value.kp = "";
        kpno.value = [];
        rawData.value = [];

        if (!form.value.kk) return;

        loading.show();

        const { data } = await api.get(
            `/api/v1/datamaterial/getkpno?kk=${encodeURIComponent(form.value.kk)}`
        );

        console.log("KP RESPONSE:", data?.data);

        kpno.value = (data?.data ?? []).map((item) => {
            const val = String(typeof item === "object" ? item.kpno : item);
            return { value: val, label: val };
        });
    } catch (err) {
        console.error("LOAD KP ERROR:", err);
        if (err?.response?.status === 401) router.push("/login");
    } finally {
        loading.hide();
    }
};

