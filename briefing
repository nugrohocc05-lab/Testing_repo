if ($request->query('debug_compare_active')) {
    $activeOld = $this->getActiveRerouteIdpoList($qualifiedIdpo);
    $activeNew = $this->remapToReroutedIdpo($qualifiedIdpo);

    $onlyInOld = $activeOld->diff($activeNew)->values();
    $onlyInNew = $activeNew->diff($activeOld)->values();

    dd([
        'qualifiedIdpo_count' => $qualifiedIdpo->count(),
        'activeOld_count'     => $activeOld->count(),
        'activeNew_count'     => $activeNew->count(),
        'onlyInOld (hilang kalau ganti ke remapToReroutedIdpo)' => $onlyInOld->toArray(),
        'onlyInNew (baru muncul kalau ganti ke remapToReroutedIdpo)' => $onlyInNew->toArray(),
        'qualifiedIdpo' => $qualifiedIdpo->toArray(),
    ]);
}