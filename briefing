<template v-if="getFileInfo(doc.key)">
    <div
        class="flex w-full min-w-0 items-center gap-3 overflow-hidden rounded-lg bg-slate-50 p-3"
    >
        <button
            type="button"
            class="flex min-w-0 flex-1 cursor-pointer items-center gap-3 overflow-hidden text-left hover:opacity-80"
            :title="getFileInfo(doc.key).name"
            @click="downloadFile(doc.key)"
        >
            <img
                :src="fileIcon(getFileInfo(doc.key).name)"
                class="h-10 w-10 shrink-0"
            />

            <div class="min-w-0 flex-1 overflow-hidden">
                <div
                    class="block w-full truncate text-sm font-medium text-slate-700 hover:underline"
                >
                    {{ getFileInfo(doc.key).name }}
                </div>

                <div class="mt-1 truncate text-xs text-slate-500">
                    {{
                        getFileInfo(doc.key).pending
                            ? 'Not Saved'
                            : 'Uploaded: ' + getFileInfo(doc.key).date
                    }}
                </div>
            </div>
        </button>

        <UiButton
            v-if="getFileInfo(doc.key).pending"
            variant="teritary-danger"
            class="shrink-0"
            @click="removeFile(doc.key)"
        >
            <TrashIcon class="h-5 w-5" />
        </UiButton>
    </div>
</template>