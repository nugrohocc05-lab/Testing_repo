    function getdatado(Request $request) {
        try {
            $storage = FGStorageStock::where('delivery_order_out',$request->donumber)
                        ->whereNull('deleted_at')
                        ->get();
            
            if(!$storage){
                throw new \Exception( "Data not found!");
            }

            foreach($storage as $item){
                if($item->date_receive_packing || $item->date_receive_packing ){
                    throw new \Exception( $item->barcode. " Has been received Packing!");
                }
                if(!$item->gi_number){
                    throw new \Exception("Gi First!");
                }
            }

            $od = (new OutputDetail())->getTable();
            $po = (new PurchaseOrder())->getTable();           

            $data = OutputDetail::select(
                    "$od.barcode",
                    "$od.kpno",
                    "$od.sub_style_id",
                    "$od.combine_pro",
                    "$od.idpo",
                    "$od.idcolor",
                    "$od.idsize",
                    "$po.idstyle",
                    "$po.po",
                    "$po.idbuyer",
                    "$po.season",
                )
                ->whereIn("$od.barcode",$storage->pluck('barcode'))
                ->join($po, function ($join) use ($po, $od) {
                    $join->on("$po.idpo", '=', "$od.idpo");
                    $join->on("$po.kpno", '=', "$od.kpno");
                })
                ->get();

            foreach($data as $d){
                $sty = Style::find($d->idstyle);
                $d->style = $sty->nmstyle ?? '-';
                $substy = SubStyle::find($d->sub_style_id);
                $d->substyle = $substy->name ?? '-';
                $color = Color::find($d->idcolor);
                $d->color = $color->nmcolor ?? '-';
                $size = Size::find($d->idsize);
                $d->size = $size->nmsize ?? '-';
            }
            
           return response()->json($data);

        } catch (\Throwable $e) {
            return response()->json($e->getMessage(), 400);
        }
    }

    function getdata(Request $request) {
        try {
            $card = MainCardConvert::where("id_card", $request->barcode)
                ->first();

            if(!$card){
                throw new \Exception("Barcode not found!");
            }

            $barcode = $card->id_convert;

            $storage = FGStorageStock::where('barcode', $barcode)->first();
            if(!$storage) {
                throw new \Exception("Barcode not match!");
            }

            if($storage->date_receive_packing || $storage->date_receive_packing ) {
                    throw new \Exception( $storage->barcode. " Has been received Packing!");
                }

            $od = (new OutputDetail())->getTable();
            $po = (new PurchaseOrder())->getTable();

            $data = OutputDetail::select(
                    "$od.barcode",
                    "$od.kpno",
                    "$od.sub_style_id",
                    "$od.combine_pro",
                    "$od.idpo",
                    "$od.idcolor",
                    "$od.idsize",
                    "$po.idstyle",
                    "$po.po",
                    "$po.idbuyer",
                    "$po.season",
                )
                ->where("$od.barcode",$barcode)
                ->join($po, function ($join) use ($po, $od) {
                    $join->on("$po.idpo", '=', "$od.idpo");
                    $join->on("$po.kpno", '=', "$od.kpno");
                })
                ->first();

            if(!$data){
                throw new \Exception("Data not found!");
            }
          
            $data->grade = $data->grade ?? "OK";
            $byr = Buyer::find($data->idbuyer);
            $gbyr = MasterGroupBuyer::find($byr->groupbuyer??null);
            $data->nmgroupbuyer = $byr->nmbuyer ?? '-';
            $data->nmbuyer = $gbyr->group_name ?? '-';
            $sty = Style::find($data->idstyle);
            $data->nmstyle = $sty->nmstyle ?? '-';
            $substy = SubStyle::find($data->sub_style_id);
            $data->nmsubstyle = $substy->name ?? '-';
            $color = Color::find($data->idcolor);
            $data->nmcolor = $color->nmcolor ?? '-';
            $size = Size::find($data->idsize);
            $data->nmsize = $size->nmsize ?? '-';
                
            return response()->json($data);

        } catch (\Throwable $e) {
            return response()->json($e->getMessage(), 400);
        }
    }

    function getpackingid(Request $request){
        try {
            preconnect(session('db'));

            if(!$request->packingid){
                throw new \Exception("Invalid Garment ID!");
            }

            if(!$request->barcode){
                throw new \Exception("Scan Garment ID First!");
            }

            $card = MainCardConvert::select('id_convert')
                ->where('id_card', $request->packingid)
                ->first();

            $cek_alloc = CardAllocation::find($request->packingid);

            if(!$cek_alloc || $cek_alloc->line != '104'){
                throw new \Exception("Allocation Packing First!");
            }

            if($card){
                throw new \Exception("Card ID is Used!");
            }

            $data  = $request->barcode;
                    
            return response()->json($data);
        }catch (\Throwable $e) {
            return response()->json($e->getMessage(), 400);
        }
    }
    
    function card_convert(Request $request){
        preconnect(session('db'));
        try {
            foreach($request->data as $d){
                $card = MainCardConvert::where('id_convert', $d['barcode'])
                            ->where('factory_id', session('db')->iddb)
                            ->where('id_reference', '06')
                            ->first();
                if($card){
                    $card->id_card = $d['packingid'];
                    $card->save();
                }
            }
            return response()->json('Successfully Packing Output!');
        } catch (\Throwable $e) {
            return response()->json($e->getMessage(), 400);
        }
    }

    function finish(Request $request) {
        preconnect(session('db'));
        try {
            $db = getconnection(session('db'));
            
            $data = $request->barcode;
            if(count($data)<1){
                throw new \Exception("Scan minimum 1 Garment ID!");
            }

            DB::beginTransaction();
            foreach($data as $d){

                $barcode = $d['barcode'];
                $packingid = $d['packingid'];

                $fgs = FGStorageStock::where('barcode', $barcode)->first();

                if(!$fgs){
                    throw new \Exception($barcode . " is Not Found!");
                }

                if($fgs->date_receive_packing){
                    throw new \Exception($barcode . " Already receive packing!");
                }

                $fgs->date_receive_packing = Carbon::now();
                $fgs->userid_receive_packing = session('user')->nik ?? null;
                $fgs->deleted_at = Carbon::now();
                $fgs->save();

                $odps = OutputDetailPackingStock::on($db)->where('barcode', $barcode)->first();
                if($odps){
                    $odps->tglpackingout = null;
                    $odps->nikpackingout = null;
                    $odps->id_set = null;
                    $odps->cartoncode = null;
                    $odps->save();
                }

                $card = MainCardConvert::where('id_convert', $barcode)->first();

                $cek_alloc = CardAllocation::find($packingid);
                if(!$cek_alloc or ('104' != $cek_alloc->line)){
                    throw new \Exception("Allocation Packing First!");
                }

                if($card){
                    $card->id_card = $packingid;
                    $card->save();
                } else {
                    $mc = new MainCardConvert();
                    $mc->factory_id = session('db')->iddb;
                    $mc->id_card = $packingid;
                    $mc->id_convert = $barcode;
                    $mc->id_reference = "06";
                    $mc->save();
                }
            }
            return response()->json('Successfully Receieve Packing From Storage.');
            DB::commit();
        } catch (\Throwable $e) {
            DB::rollback();
            throw new \Exception($e->getMessage());
        }
    }
}


