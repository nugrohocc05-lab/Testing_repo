    function topDefects(Request $request)
    {
        preconnect(session('db'));
        $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
        $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();
        $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
        $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

        $fi = (new OutputDetailFinalInspection())->getTable();
        $od = (new OutputDetail())->getTable();
        $po = (new PurchaseOrder())->getTable();

        $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);
        $qtyPerIdpo = $leafRows->groupBy('idpo')->map(fn ($rows) => (int) $rows->sum('qty_ori'));
        $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();

        $barcodes = OutputDetail::whereIn('idpo', $qualifiedIdpo)->pluck('barcode');
        $headerQuery = OutputDetailFinalInspection::query()
            ->join($od, "$od.barcode", '=', "$fi.barcode")
            ->join($po, "$po.idpo", '=', "$od.idpo")
            ->whereIn("$fi.barcode", $barcodes);

        $defectRows = (clone $headerQuery)
            ->whereNotNull("$fi.date_output")
            ->whereNotNull("$fi.defect_code")
            ->select("$fi.id", "$fi.defect_code")
            ->distinct()->get();
        $totalDefect = $defectRows->count();

        $grouped = $defectRows
            ->map(function ($row) {
                if (in_array((string) $row->defect_code, ['800', '900'], true)) {
                    $row->defect_code = 'Others';
                }
                return $row;
            })
            ->groupBy('defect_code')
            ->map(fn ($rows, $code) => [
                'defect_code' => $code,
                'qty' => $rows->count(),
                'percentage' => $totalDefect > 0 ? round(($rows->count() / $totalDefect) * 100, 2) : 0,
            ])
            ->values();

        $defectCodes = $grouped->pluck('defect_code')
            ->filter(fn ($code) => $code !== 'Others')->unique()->values();
        $categoryMap = QCDefect::whereIn('kdcacat', $defectCodes)->pluck('category', 'kdcacat');

        $processQty = 0;
        $nonProcessQty = 0;
        $nonProcessQtyNoGrade = 0;

        foreach ($grouped as $item) {
            $code = $item['defect_code'];
            $qty = (int) $item['qty'];
            if ($code === 'Others') {
                continue;
            }
            $category = (int) ($categoryMap->get($code, 0));
            if ($category === 1) {
                $processQty += $qty;
                continue;
            }
            $nonProcessQty += $qty;
            if (!in_array((int) $code, [800, 900, 888], true)) {
                $nonProcessQtyNoGrade += $qty;
            }
        }

        $totDefectProcess = $processQty + $nonProcessQty;
        $processPercent = $totDefectProcess > 0 ? round(($processQty / $totalDefect) * 100, 2) : 0;
        $nonProcessPercent = $totDefectProcess > 0 ? round(($nonProcessQtyNoGrade / $totalDefect) * 100, 2) : 0;

        $defectNames = QCDefect::whereIn('kdcacat', $defectCodes)->pluck('deskripsi', 'kdcacat');

        $result = $grouped
            ->filter(fn ($item) => $item['defect_code'] !== 'Others')
            ->map(function ($item) use ($defectNames) {
                $code = $item['defect_code'];

                $item['defect_name'] = $defectNames->get($code, $code);

                return $item;
            })
            ->sort(function ($a, $b) {
                if ($a['qty'] !== $b['qty']) {
                    return $b['qty'] <=> $a['qty'];
                }

                return (int) $a['defect_code'] <=> (int) $b['defect_code'];
            })
            ->take(5)
            ->values();

        $total = $result->sum('qty');

        return response()->json([
            'data' => $result,
            'total' => $total,
            'total_defect' => $totalDefect,
            'process' => $processQty,
            'non_process' => $nonProcessQty,
            'non_process_no_grade' => $nonProcessQtyNoGrade,
            'process_percent' => $processPercent,
            'non_process_percent' => $nonProcessPercent,
        ]);
    }

    private function getLeafHistoryRows(
        Request $request,
        $familyColumn = 'combine_pro',
        $applyPoFilter = true,
        $fromDate = null,
        $toDate = null
    ) {
        $cacheKey = md5(json_encode([
            'familyColumn' => $familyColumn,
            'applyPoFilter' => $applyPoFilter,
            'fromDate' => $fromDate ? $fromDate->toDateTimeString() : null,
            'toDate' => $toDate ? $toDate->toDateTimeString() : null,
            'groupbuyer' => $request->get('groupbuyer'),
            'po' => $applyPoFilter ? $request->get('po') : null,
            'style' => $request->get('style'),
            'datea' => $request->get('datea'),
            'dateb' => $request->get('dateb'),
        ]));

        if (array_key_exists($cacheKey, $this->leafRowsCache)) {
            return $this->leafRowsCache[$cacheKey];
        }

        $po = (new PurchaseOrder())->getTable();
        $dbr = (new HistoryDataBreakdown())->getTable();

        $rawQuery = HistoryDataBreakdown::query()
            ->join($po, "$po.idpo", '=', "$dbr.idpo")
            ->where("$dbr.production_status", "IH");

        if ($request->filled('groupbuyer') && $request->groupbuyer !== 'all') {
            $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');
            $rawQuery->whereIn("$po.idbuyer", $buyerIds);
        }

        if ($applyPoFilter && $request->filled('po') && $request->po !== 'all') {
            $resolvedIdpo = $this->resolveRerouteIdpo($request->po);
            $rawQuery->whereIn("$dbr.idpo", $resolvedIdpo);
        }

        if ($request->filled('style') && $request->style !== 'all') {
            $rawQuery->where("$po.idstyle", $request->style);
        }

        if ($fromDate && $toDate) {
            $dta = $fromDate->copy()->startOfDay();
            $dtb = $toDate->copy()->endOfDay();
        } elseif ($request->filled('datea') && $request->filled('dateb')) {
            $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
            $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();
            $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
            $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();
        } else {
            $dta = null;
            $dtb = null;
        }

        if ($dta && $dtb) {
            $rawQuery->whereBetween("$dbr.deliverydate", [$dta, $dtb]);
        }

        $rawRows = $rawQuery->select(
            "$dbr.idpo", "$dbr.idcolor", "$dbr.qty_ori", "$dbr.kp_item",
            "$dbr.kp_item_ref", "$dbr.revisi_kp", "$dbr.deliverydate",
            "$dbr.$familyColumn as family_key", "$po.po", "$po.idbuyer", "$po.idstyle"
        )->get();

        $deduped = $rawRows
            ->groupBy(fn ($r) => $r->idpo . '|' . $r->idcolor . '|' . $r->kp_item)
            ->map(fn ($group) => $group->sortByDesc('revisi_kp')->first())
            ->values();

        $refByFamily = $deduped
            ->filter(fn ($r) => !is_null($r->kp_item_ref))
            ->groupBy(fn ($r) => $r->idpo . '|' . $r->family_key)
            ->map(fn ($group) => $group->pluck('kp_item_ref')->unique()->values());

        $leafRows = $deduped->filter(function ($row) use ($refByFamily) {
            $refs = $refByFamily->get($row->idpo . '|' . $row->family_key);
            return !($refs && $refs->contains($row->kp_item));
        })->values();

        return $this->leafRowsCache[$cacheKey] = $leafRows;
    }

    // Dipakai oleh getLeafHistoryRows() saat applyPoFilter=true & ada filter ?po=
    private function resolveRerouteIdpo($idpo)
    {
        if (!$idpo || $idpo === 'all') {
            return collect();
        }

        $combineProList = HistoryDataBreakdown::where('idpo', $idpo)
            ->pluck('combine_pro')->filter()->unique()->values();
        if ($combineProList->isEmpty()) {
            return collect([$idpo]);
        }

        $relatedIdpo = HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
            ->pluck('idpo')->filter()->unique()->values();

        $lastHistory = $this->getLastHistoryPoRevisi($relatedIdpo);
        $activeIdpo = $lastHistory->filter(fn ($row) => (int) $row->qtypo > 0)->keys()->values();

        return $activeIdpo->isNotEmpty() ? $activeIdpo : collect([$idpo]);
    }

    // Dipakai: resolveRerouteIdpo, getActiveRerouteIdpoList, getRerouteIdpoList,
    // resolveRerouteDuplicates, getNetCutoffQty.
    private function getLastHistoryPoRevisi(Collection $idpoList): Collection
    {
        $idpoList = collect($idpoList)->filter()->unique()->values();
        if ($idpoList->isEmpty()) {
            return collect();
        }

        return HistoryPO::whereIn('idpo', $idpoList)
            ->orderBy('idpo')->orderByDesc('revisi')
            ->get(['idpo', 'revisi', 'qtypo'])
            ->groupBy('idpo')
            ->map(fn ($rows) => $rows->sortByDesc('revisi')->first());
    }

    // Dipakai: groupbuyer, styleSelect, poSelect, priorityFinal
    private function getActiveRerouteIdpoList($idpoList)
    {
        $idpoList = collect($idpoList)->filter()->unique()->values();
        if ($idpoList->isEmpty()) {
            return collect();
        }

        $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
            ->pluck('combine_pro')->filter()->unique()->values();
        if ($combineProList->isEmpty()) {
            return $idpoList;
        }

        $allIdpo = HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
            ->pluck('idpo')->filter()->unique()->values();

        $lastHistory = $this->getLastHistoryPoRevisi($allIdpo);

        return $lastHistory->filter(fn ($row) => (int) $row->qtypo > 0)->keys()->values();
    }

    // Dipakai: priorityFinal (basis idpo untuk hitung output)
    private function getRerouteIdpoList($idpoList)
    {
        $idpoList = collect($idpoList)->filter()->unique()->values();
        if ($idpoList->isEmpty()) {
            return collect();
        }

        $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
            ->pluck('combine_pro')->filter()->unique()->values();
        if ($combineProList->isEmpty()) {
            return $idpoList;
        }

        $allIdpo = HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
            ->pluck('idpo')->filter()->unique()->values();

        $lastHistory = $this->getLastHistoryPoRevisi($allIdpo);

        $result = collect();
        foreach ($lastHistory as $idpo => $last) {
            if ((int) $last->qtypo > 0) {
                $result->push($idpo);
            }
        }

        return $result->unique()->values();
    }

    // Dipakai: getSplitFinalCheckIdpoList
    private function resolveRerouteDuplicates(Collection $idpoList): Collection
    {
        if ($idpoList->isEmpty()) {
            return $idpoList;
        }

        $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
            ->pluck('combine_pro')->filter()->unique()->values();
        if ($combineProList->isEmpty()) {
            return $idpoList;
        }

        $rows = HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
            ->select('idpo', 'combine_pro', 'kp_item', 'kp_item_ref', 'revisi_kp')
            ->get();

        $ownerByCombineKpItem = $rows
            ->groupBy(fn ($r) => $r->combine_pro . '|' . $r->kp_item)
            ->map(fn ($group) => (string) $group->sortBy('idpo')->first()->idpo);

        $reroutedPairs = $rows
            ->filter(fn ($r) => $r->revisi_kp == 1 && !is_null($r->kp_item_ref))
            ->map(function ($r) use ($ownerByCombineKpItem) {
                $originalIdpo = $ownerByCombineKpItem->get($r->combine_pro . '|' . $r->kp_item_ref);
                return ($originalIdpo && $originalIdpo !== (string) $r->idpo)
                    ? ['original' => $originalIdpo, 'rerouted' => (string) $r->idpo]
                    : null;
            })
            ->filter()
            ->unique(fn ($p) => $p['original'] . '|' . $p['rerouted'])
            ->values();

        $maxRevisiByIdpo = $this->getLastHistoryPoRevisi($reroutedPairs->pluck('original')->unique()->values());

        $excludedOriginals = collect();
        foreach ($reroutedPairs as $pair) {
            $maxRevisiRow = $maxRevisiByIdpo->get($pair['original']);
            if ($maxRevisiRow && (int) $maxRevisiRow->qtypo === 0) {
                $excludedOriginals->push($pair['original']);
            }
        }

        return $idpoList->reject(fn ($idpo) => $excludedOriginals->contains(
            fn ($excluded) => (string) $excluded === (string) $idpo
        ))->values();
    }

    // Dipakai: poSelect, summaryFilter, priorityFinal, finalOverview, chartData
    private function getSplitFinalCheckIdpoList(Request $request, Carbon $dta, Carbon $dtb, Carbon $today): array
    {
        $fi = (new OutputDetailFinalInspection())->getTable();
        $od = (new OutputDetail())->getTable();
        $po = (new PurchaseOrder())->getTable();
        $dbr = (new HistoryDataBreakdown())->getTable();

        // leaf rows dihitung sekali atas seluruh [dta, dtb], bukan per sub-rentang
        $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);
        $qtyPerIdpo = $leafRows->groupBy('idpo')->map(fn ($rows) => (int) $rows->sum('qty_ori'));
        $etdPerIdpo = $leafRows->groupBy('idpo')->map(fn ($rows) => $rows->max('deliverydate'));
        $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();

        $effectiveIdpoSql = fn () => "(CASE WHEN $dbr.revisi_kp = 1 AND $dbr.kp_item_ref IS NOT NULL
            THEN (SELECT dbr_prev.idpo FROM $dbr as dbr_prev
                WHERE dbr_prev.combine_pro = $dbr.combine_pro
                    AND dbr_prev.idpo < $dbr.idpo
                ORDER BY dbr_prev.idpo DESC LIMIT 1)
            ELSE $dbr.idpo END)";

        $requireHasFinalRecord = function ($query) use ($fi, $od, $effectiveIdpoSql) {
            $expr = $effectiveIdpoSql();
            $query->whereExists(function ($q) use ($fi, $od, $expr) {
                $q->select(DB::raw(1))
                    ->from("$fi as fi3")
                    ->join("$od as od3", "od3.barcode", '=', 'fi3.barcode')
                    ->whereRaw("od3.idpo = $expr");
            });
            return $query;
        };

        $excludeIfAnyFinalEffective = function ($query) use ($fi, $od, $effectiveIdpoSql) {
            $expr = $effectiveIdpoSql();
            $query->whereNotExists(function ($q) use ($fi, $od, $expr) {
                $q->select(DB::raw(1))
                    ->from("$fi as fi2")
                    ->join("$od as od2", "od2.barcode", '=', 'fi2.barcode')
                    ->whereRaw("od2.idpo = $expr")
                    ->where('fi2.is_output', 1);
            });
            return $query;
        };

        $query = HistoryDataBreakdown::query()
            ->join($po, "$po.idpo", '=', "$dbr.idpo")
            ->whereIn("$dbr.idpo", $qualifiedIdpo);
        $requireHasFinalRecord($query);
        $excludeIfAnyFinalEffective($query);

        $candidateIdpoList = $query->select("$dbr.idpo")->distinct()->pluck('idpo');
        $dedupedIdpoList = $this->resolveRerouteDuplicates($candidateIdpoList);

        $overdue = collect();
        $needFinal = collect();
        foreach ($dedupedIdpoList as $idpo) {
            $etd = $etdPerIdpo->get($idpo);
            if (!$etd) {
                continue;
            }
            $etdDate = Carbon::parse($etd)->startOfDay();
            $overdueLimit = $today->copy()->addDay();

            if ($etdDate->lessThanOrEqualTo($overdueLimit)) {
                $overdue->push($idpo);
                continue;
            }
            $needFinal->push($idpo);
        }

        return ['overdue' => $overdue->values(), 'need_final' => $needFinal->values()];
    }

    // Dipakai: poSelect, priorityFinal (idpo lama -> idpo aktif hasil reroute)
    private function remapToReroutedIdpo(Collection $idpoList): Collection
    {
        if ($idpoList->isEmpty()) {
            return $idpoList;
        }

        $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
            ->pluck('combine_pro')->filter()->unique()->values();
        if ($combineProList->isEmpty()) {
            return $idpoList;
        }

        $rows = HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
            ->select('idpo', 'combine_pro', 'kp_item', 'kp_item_ref', 'revisi_kp')
            ->get();

        $ownerByCombineKpItem = $rows
            ->groupBy(fn ($r) => $r->combine_pro . '|' . $r->kp_item)
            ->map(fn ($group) => (string) $group->sortBy('idpo')->first()->idpo);

        $newIdpoByOriginal = $rows
            ->filter(fn ($r) => $r->revisi_kp == 1 && !is_null($r->kp_item_ref))
            ->mapWithKeys(function ($r) use ($ownerByCombineKpItem) {
                $original = $ownerByCombineKpItem->get($r->combine_pro . '|' . $r->kp_item_ref);
                return $original ? [$original => (string) $r->idpo] : [];
            });

        return $idpoList->map(fn ($idpo) => $newIdpoByOriginal->get((string) $idpo, (string) $idpo))
            ->unique()->values();
    }

    // Dipakai: finalOverview saja
    private function redistributeReroutedOutput(Collection $idpoList, Collection $outputPerIdpo): Collection
    {
        if ($idpoList->isEmpty()) {
            return $outputPerIdpo;
        }

        $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
            ->pluck('combine_pro')->filter()->unique()->values();
        if ($combineProList->isEmpty()) {
            return $outputPerIdpo;
        }

        $rows = HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
            ->select('idpo', 'combine_pro', 'kp_item', 'kp_item_ref', 'revisi_kp', 'qty_ori')
            ->get();

        $ownerByCombineKpItem = $rows
            ->groupBy(fn ($r) => $r->combine_pro . '|' . $r->kp_item)
            ->map(fn ($group) => (string) $group->sortBy('idpo')->first()->idpo);

        $childrenByOriginal = collect();
        $rows->filter(fn ($r) => $r->revisi_kp == 1 && !is_null($r->kp_item_ref))
            ->each(function ($r) use ($ownerByCombineKpItem, $childrenByOriginal) {
                $originalIdpo = $ownerByCombineKpItem->get($r->combine_pro . '|' . $r->kp_item_ref);
                $childIdpo = (string) $r->idpo;
                if ($originalIdpo && $originalIdpo !== $childIdpo) {
                    if (!$childrenByOriginal->has($originalIdpo)) {
                        $childrenByOriginal->put($originalIdpo, collect());
                    }
                    $childrenByOriginal->get($originalIdpo)->push([
                        'child' => $childIdpo, 'qty' => (int) $r->qty_ori,
                    ]);
                }
            });

        $result = [];
        foreach ($outputPerIdpo as $idpo => $qty) {
            $result[(string) $idpo] = (int) $qty;
        }

        foreach ($childrenByOriginal as $originalIdpo => $children) {
            $remainingRawOutput = $result[$originalIdpo] ?? 0;
            foreach ($children as $child) {
                $moveQty = min($child['qty'], $remainingRawOutput);
                if ($moveQty <= 0) {
                    continue;
                }
                $result[$child['child']] = ($result[$child['child']] ?? 0) + $moveQty;
                $remainingRawOutput -= $moveQty;
            }
            $result[$originalIdpo] = $remainingRawOutput;
        }

        return collect($result);
    }

    // Dipakai: finalOverview, chartData
    private function getNetCutoffQty(Collection $idpoList): int
    {
        if ($idpoList->isEmpty()) {
            return 0;
        }

        $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
            ->pluck('combine_pro')->filter()->unique()->values();

        if ($combineProList->isEmpty()) {
            return (int) HistoryDataBreakdown::whereIn('idpo', $idpoList)
                ->where('is_cutoff', '1')->sum('qty_ori');
        }

        $familyRows = HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
            ->select('idpo', 'combine_pro', 'combine_pro_set', 'kp_item', 'kp_item_ref', 'revisi_kp', 'qty_ori', 'is_cutoff')
            ->get();

        $ownerByCombineKpItem = $familyRows
            ->groupBy(fn ($r) => $r->combine_pro . '|' . $r->kp_item)
            ->map(fn ($group) => (string) $group->sortBy('idpo')->first()->idpo);

        $reroutedPairs = $familyRows
            ->filter(fn ($r) => $r->revisi_kp == 1 && !is_null($r->kp_item_ref))
            ->map(function ($r) use ($ownerByCombineKpItem) {
                $originalIdpo = $ownerByCombineKpItem->get($r->combine_pro . '|' . $r->kp_item_ref);
                return ($originalIdpo && $originalIdpo !== (string) $r->idpo)
                    ? [
                        'original' => $originalIdpo, 'rerouted' => (string) $r->idpo,
                        'combine_pro' => $r->combine_pro, 'kp_item_ref' => $r->kp_item_ref,
                    ]
                    : null;
            })
            ->filter()
            ->unique(fn ($p) => $p['original'] . '|' . $p['rerouted'])
            ->values();

        $idpoListStr = $idpoList->map(fn ($id) => (string) $id)->values();
        $maxRevisiByIdpo = $this->getLastHistoryPoRevisi($reroutedPairs->pluck('original')->unique()->values());

        $excludedOriginals = collect();
        $qtyTakeoverByNewIdpo = collect();

        foreach ($reroutedPairs as $pair) {
            $maxRevisiRow = $maxRevisiByIdpo->get($pair['original']);
            if ($maxRevisiRow && (int) $maxRevisiRow->qtypo === 0) {
                $excludedOriginals->push($pair['original']);

                // hanya hitung takeover kalau idpo tujuan ada di $idpoList panggilan ini,
                // supaya tidak ke-count dobel di bucket lain (pass/reject/notFinal beda idpoList)
                if (!$idpoListStr->contains($pair['rerouted'])) {
                    continue;
                }

                $originalCutoffQty = $familyRows
                    ->where('idpo', $pair['original'])
                    ->where('kp_item', $pair['kp_item_ref'])
                    ->where('is_cutoff', '1')
                    ->sum('qty_ori');

                $qtyTakeoverByNewIdpo->put(
                    $pair['rerouted'],
                    $qtyTakeoverByNewIdpo->get($pair['rerouted'], 0) + (int) $originalCutoffQty
                );
            }
        }

        $netQty = 0;
        foreach ($idpoList as $idpo) {
            if ($excludedOriginals->contains((string) $idpo)) {
                continue;
            }

            $ownRows = $familyRows->where('idpo', $idpo)->where('is_cutoff', '1');
            $ownQty = $ownRows->filter(fn ($row) => is_null($row->combine_pro_set))->sum('qty_ori');
            $ownQty += $ownRows->filter(fn ($row) => !is_null($row->combine_pro_set))
                ->groupBy('combine_pro_set')
                ->sum(fn ($group) => (int) $group->first()->qty_ori);

            $netQty += (int) $ownQty;
        }

        $netQty += (int) $qtyTakeoverByNewIdpo->sum();

        return $netQty;
    }
