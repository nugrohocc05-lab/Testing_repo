<script setup>
import { ref, shallowRef, watch } from 'vue'
import { AgGridVue } from 'ag-grid-vue3'
import { ModuleRegistry, ClientSideRowModelModule, ValidationModule } from 'ag-grid-community'

ModuleRegistry.registerModules([
  ClientSideRowModelModule,
  ValidationModule
])

defineOptions({
  inheritAttrs: false
})

const props = defineProps({
  rowData: { type: Array, default: () => [] },
  columnDefs: { type: Array, default: () => [] },
  defaultColDef: {
    type: Object,
    default: () => ({
      sortable: true,
      filter: false,
      resizable: true,
    })
  },
  quickFilterText: { type: String, default: '' },
  pagination: { type: Boolean, default: true },
  paginationPageSize: { type: Number, default: 10 },
  paginationPageSizeSelector: {
    type: Array,
    default: () => [5, 10, 20, 50, 100]
  },
  // 'normal' = header sticky + scroll internal
  domLayout: { type: String, default: 'normal' },
  allowCopy: { type: Boolean, default: false },
  disableDrag: { type: Boolean, default: true },

  // batas tinggi maksimal grid, sisanya di-scroll di dalam grid
  maxHeight: { type: String, default: 'calc(100vh - 220px)' },
  // tinggi panel pagination (px)
  pagingHeight: { type: Number, default: 48 }
})

const gridApi = shallowRef(null)
const gridHeight = ref(null) // px, null = belum dihitung

const updateHeight = () => {
  const api = gridApi.value
  if (!api || props.domLayout === 'autoHeight') return

  const sizes = api.getSizesForCurrentTheme?.() ?? {}
  const rowH = sizes.rowHeight ?? 42
  const headerH = sizes.headerHeight ?? 48

  let rows = 0
  if (props.pagination) {
    const pageSize = api.paginationGetPageSize()
    const page = api.paginationGetCurrentPage()
    const total = api.paginationGetRowCount()
    rows = Math.max(0, Math.min(pageSize, total - page * pageSize))
  } else {
    rows = api.getDisplayedRowCount()
  }

  // minimal 1 baris supaya overlay "No Rows" tetap muat
  const bodyH = Math.max(rows, 1) * rowH
  const pagingH = props.pagination ? props.pagingHeight : 0

  gridHeight.value = headerH + bodyH + pagingH + 2 // +2 border
}

const onGridReady = (e) => {
  gridApi.value = e.api
  updateHeight()
}

watch(
  () => [props.rowData, props.paginationPageSize, props.quickFilterText],
  () => updateHeight(),
  { deep: false }
)
</script>

<template>
  <div
    class="ui-grid"
    :style="props.domLayout === 'autoHeight'
      ? {}
      : { height: gridHeight ? gridHeight + 'px' : '400px', maxHeight: props.maxHeight }"
  >
    <AgGridVue
      v-bind="$attrs"
      class="ui-grid-table"

      :rowData="props.rowData"
      :columnDefs="props.columnDefs"
      :defaultColDef="props.defaultColDef"
      :quickFilterText="props.quickFilterText"
      :pagination="props.pagination"
      :paginationPageSize="props.paginationPageSize"
      :paginationPageSizeSelector="props.paginationPageSizeSelector"
      :domLayout="props.domLayout"
      :suppressMovableColumns="props.disableDrag"

      :enableCellTextSelection="props.allowCopy"
      :ensureDomOrder="props.allowCopy"

      style="width: 100%; height: 100%"

      @grid-ready="onGridReady"
      @pagination-changed="updateHeight"
      @model-updated="updateHeight"
    />
  </div>
</template>

<style scoped>
:deep(.ag-cell) {
    display: flex !important;
    align-items: center !important;
}

:deep(.ag-cell-wrapper) {
    display: flex !important;
    align-items: center !important;
    height: 100%;
}
</style>

<UiAgGrid ... max-height="calc(100vh - 260px)" />