    function groupbuyer(Request $request)
    {
        preconnect(session('db'));
        $q = $request->get('q');
        $page = (int) $request->get('page', 1);

        $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
        $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();
        $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
        $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();

        // applyPoFilter=false: belum ada style/po yang dipilih di tahap ini
        $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', false, $dta, $dtb);
        $qtyPerIdpo = $leafRows->groupBy('idpo')->map(fn ($rows) => (int) $rows->sum('qty_ori'));
        $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();
        // buang idpo mati akibat full-reroute (qtypo=0), konsisten dgn poSelect()/priorityFinal()
        $qualifiedIdpo = $this->getActiveRerouteIdpoList($qualifiedIdpo);

        $qualifiedBuyerIds = $leafRows->whereIn('idpo', $qualifiedIdpo)
            ->pluck('idbuyer')->filter()->unique()->values();
        $qualifiedGroupBuyerIds = Buyer::whereIn('idbuyer', $qualifiedBuyerIds)
            ->pluck('groupbuyer')->filter()->unique()->values();

        $paginator = MasterGroupBuyer::select('id', 'group_name')
            ->whereIn('id', $qualifiedGroupBuyerIds)
            ->when($q, fn ($query) => $query->where('group_name', 'like', '%' . $q . '%'))
            ->orderBy('group_name', 'asc')
            ->paginate($this->perPage, ['id', 'group_name'], 'page', $page);

        $data = collect($paginator->items())->map(fn ($item) => [
            'id' => $item->id,
            'text' => $item->group_name,
        ]);

        return response()->json([
            'results' => $data,
            'pagination' => ['more' => $paginator->hasMorePages()],
        ]);
    }

