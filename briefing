private function buildFinalOverviewData(Request $request, Carbon $dta, Carbon $dtb): array
{
    $fi = (new OutputDetailFinalInspection())->getTable();
    $od = (new OutputDetail())->getTable();
    $po = (new PurchaseOrder())->getTable();
    $odp = (new OutputDetailPacking())->getTable();

    $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);
    $qtyPerIdpo = $leafRows->groupBy('idpo')->map(fn ($rows) => (int) $rows->sum('qty_ori'));
    $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();
    $this->primeComboUniverse($qualifiedIdpo);

    $headerQuery = OutputDetailFinalInspection::query()
        ->join($od, "$od.barcode", '=', "$fi.barcode")
        ->join($po, "$po.idpo", '=', "$od.idpo")
        ->whereIn("$od.idpo", $qualifiedIdpo);

    $status = $this->getFinalCompletionStatus($qualifiedIdpo);

    // Basis QTY (pass/reject/not_final) wajib satu set idpo aktif hasil reroute,
    // sama seperti totalQty di buildSummaryFilterData/buildPriorityFinalData.
    // Kalau tidak, qty PO yang direroute bisa kehitung dobel: sekali di pass/reject
    // (pakai idpo lama), sekali lagi di not_final (pakai idpo aktif hasil reroute).
    $finalComRemapped = $this->remapToReroutedIdpo($status['finalCom']);
    $rejectRemapped = $this->remapToReroutedIdpo($status['reject']);
    $passRemapped = $finalComRemapped->diff($rejectRemapped)->values();

    $activeIdpoList = $this->getActiveRerouteIdpoList($qualifiedIdpo);
    $notFinalRemapped = $activeIdpoList->diff($finalComRemapped)->values();

    // Count PO tetap pakai status asli (pass/reject) - ini tidak bermasalah,
    // yang salah cuma sisi qty-nya.
    $poWithDefect = $status['reject']->count();
    $poNoDefect = $status['pass']->count();

    $qtyInspectPass = (clone $headerQuery)
        ->whereIn("$od.idpo", $status['pass'])
        ->whereNotNull("$fi.date_output")
        ->count(DB::raw("DISTINCT $od.barcode"));

    $qtyInspectReject = (clone $headerQuery)
        ->whereIn("$od.idpo", $status['reject'])
        ->whereNotNull("$fi.date_output")
        ->count(DB::raw("DISTINCT $od.barcode"));

    $byIdpoLeaf = $leafRows->groupBy('idpo');

    $today = Carbon::today()->startOfDay();
    $split = $this->getSplitFinalCheckIdpoList($request, $dta, $dtb, $today);

    $originalNotFinalIdpoList = $notFinalRemapped;

    $qtyNotFinal = $originalNotFinalIdpoList->sum(
        fn ($idpo) => $qtyPerIdpo->get($idpo, 0)
    );

    $countNotFinal = $originalNotFinalIdpoList->count();

    $poList = $originalNotFinalIdpoList->map(function ($idpo) use ($byIdpoLeaf) {
        $rows = $byIdpoLeaf->get($idpo);

        if (!$rows) {
            return null;
        }

        $first = $rows->first();

        return (object) [
            'idpo' => $idpo,
            'po' => $first->po,
            'idbuyer' => $first->idbuyer,
            'idstyle' => $first->idstyle,
            'idcolor' => $first->idcolor,
        ];
    })->filter()->values();

    $outputPerIdpo = $this->getOutputPerIdpoFromPacking(
        $originalNotFinalIdpoList
    );

    $outputNotFinal = $outputPerIdpo->sum();
    $qtyInspectNotFinal = 0;

    $getOutputPerIdpo = function ($idpoList) use ($od, $odp) {
        if ($idpoList->isEmpty()) {
            return collect();
        }

        return OutputDetail::query()
            ->whereIn("$od.idpo", $idpoList)
            ->whereNotNull("$od.barcode")
            ->leftJoin("$odp", "$odp.barcode", '=', "$od.barcode")
            ->select(
                "$od.idpo",
                DB::raw("COUNT(DISTINCT $odp.id_set) as total_output")
            )
            ->groupBy("$od.idpo")
            ->get()
            ->mapWithKeys(function ($row) {
                return [
                    (string) $row->idpo => (int) $row->total_output
                ];
            });
    };

    // pakai basis idpo yang sudah di-remap juga di sini, biar konsisten
    // dengan qty-nya (dan sama dengan pola buildPriorityFinalData).
    $outputPassPerIdpo = $this->redistributeReroutedOutput(
        $passRemapped,
        $getOutputPerIdpo($passRemapped)
    );

    $outputRejectPerIdpo = $this->redistributeReroutedOutput(
        $rejectRemapped,
        $getOutputPerIdpo($rejectRemapped)
    );

    $outputPass = $outputPassPerIdpo->sum();
    $outputReject = $outputRejectPerIdpo->sum();

    $qtyPass = $passRemapped->sum(
        fn ($idpo) => $qtyPerIdpo->get($idpo, 0)
    );

    $qtyReject = $rejectRemapped->sum(
        fn ($idpo) => $qtyPerIdpo->get($idpo, 0)
    );

    $progressPass = $qtyPass > 0
        ? round(($outputPass / $qtyPass) * 100, 2)
        : 0;

    $progressReject = $qtyReject > 0
        ? round(($outputReject / $qtyReject) * 100, 2)
        : 0;

    $progressNotFinal = $qtyNotFinal > 0
        ? round(($outputNotFinal / $qtyNotFinal) * 100, 2)
        : 0;

    $totalPoAll = $poNoDefect + $poWithDefect + $countNotFinal;
    $totalQtyOrderAll = $qtyPass + $qtyReject + $qtyNotFinal;
    $totalQtyInspectAll = $qtyInspectPass + $qtyInspectReject;
    $totalOutputAll = $outputPass + $outputReject + $outputNotFinal;

    $totalProgressOutputAll = $totalQtyOrderAll > 0
        ? round(($totalOutputAll / $totalQtyOrderAll) * 100, 2)
        : 0;

    return [
        'data' => [[
            'pass' => [
                'count' => $poNoDefect,
                'qty' => $qtyPass,
                'qty_inspect' => $qtyInspectPass,
                'output' => $outputPass,
                'progress_output' => $progressPass,
            ],
            'reject' => [
                'count' => $poWithDefect,
                'qty' => $qtyReject,
                'qty_inspect' => $qtyInspectReject,
                'output' => $outputReject,
                'progress_output' => $progressReject,
            ],
            'not_final' => [
                'count' => $countNotFinal,
                'qty' => $qtyNotFinal,
                'qty_inspect' => $qtyInspectNotFinal,
                'output' => $outputNotFinal,
                'progress_output' => $progressNotFinal,
            ],
            'total' => [
                'total_po' => $totalPoAll,
                'qty_order' => $totalQtyOrderAll ?: 0,
                'qty_inspect' => $totalQtyInspectAll ?: 0,
                'output' => $totalOutputAll ?: 0,
                'progress_output' => $totalProgressOutputAll,
            ],
        ]],
    ];
}