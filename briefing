// disamakan dengan pendekatan buildPriorityFinalData: tarik allHistoryIdpo
// se-keluarga combine_pro, lalu remap langsung per baris output (bukan
// redistribusi ber-cap qty_ori)
$combineProListNotFinal = HistoryDataBreakdown::whereIn('idpo', $notFinalForQty)
    ->pluck('combine_pro')->filter()->unique()->values();

$allHistoryIdpoNotFinal = $combineProListNotFinal->isEmpty()
    ? $notFinalForQty
    : HistoryDataBreakdown::whereIn('combine_pro', $combineProListNotFinal)
        ->pluck('idpo')->filter()->unique()->values();

$outputRowsNotFinal = OutputDetail::query()
    ->whereIn("$od.idpo", $allHistoryIdpoNotFinal)
    ->whereNotNull("$od.barcode")
    ->leftJoin("$odp", "$odp.barcode", '=', "$od.barcode")
    ->select(
        "$od.idpo",
        DB::raw("COUNT(DISTINCT $odp.id_set) as total_output")
    )
    ->groupBy("$od.idpo")
    ->get();

$rerouteMapNotFinal = $this->buildRerouteMap($outputRowsNotFinal->pluck('idpo')->unique()->values());

$outputNotFinalPerIdpo = collect();
foreach ($outputRowsNotFinal as $row) {
    $activeIdpo = $rerouteMapNotFinal->get((string) $row->idpo, (string) $row->idpo);
    $outputNotFinalPerIdpo->put(
        $activeIdpo,
        ($outputNotFinalPerIdpo->get($activeIdpo, 0) + (int) $row->total_output)
    );
}

$notFinalQtySet = $notFinalForQty->map(fn ($idpo) => (string) $idpo)->flip();

$outputNotFinal = 0;
foreach ($outputNotFinalPerIdpo as $idpo => $qty) {
    if ($notFinalQtySet->has((string) $idpo)) {
        $outputNotFinal += (int) $qty;
    }
}