<template>
    <div class="px-6">
        <UiTitle align="center" title="Order Artwork Allocation"/>

        <div class="mb-4 flex w-full flex-col gap-3 lg:flex-row lg:items-end">

            <div class="flex-col flex gap-3 md:flex-row mb-2 md:mb-0">
                <!-- Pilih Filter -->
                <div class="w-full md:w-60">
                    <UiMultiSelect v-model="form.filter" label="Filter" :options="filters"
                        placeholder="-- Select Filter --" @change="onFilterChange"/>
                </div>

                <!-- Filter PO -->
                <div v-if="form.filter === 'po'" class="w-full md:w-60">
                    <UiMultiSelect v-model="form.po" label="PO" :options="pos"
                        placeholder="-- Select PO --" @change="loadDataByPo"/>
                </div>

                <!-- Filter KP: Buyer dulu, baru KP -->
                <template v-if="form.filter === 'kp'">
                    <div class="w-full md:w-60">
                        <UiMultiSelect v-model="form.buyer" label="Buyer" :options="buyers"
                            placeholder="-- Select Buyer --" @change="onBuyerChange"/>
                    </div>
                    <div v-if="form.buyer" class="w-full md:w-60">
                        <UiMultiSelect v-model="form.kpno" label="KP" :options="data_kp"
                            placeholder="-- Select KP --" @change="loadDataByKp"/>
                    </div>
                </template>
            </div>

            <div class="flex w-full justify-between gap-3 lg:ml-auto lg:w-auto lg:flex-row lg:items-end">
                <div class="flex items-center justify-start gap-1">
                    <UiTooltip content="PDF" position="bottom">
                        <UiButton variant="teritary" class="shrink-0" @click="onBtnExportPdf">
                            <i class="fa-regular text-2xl fa-file-pdf"></i>
                        </UiButton>
                    </UiTooltip>

                    <UiTooltip content="Excel" position="bottom">
                        <UiButton variant="teritary" class="shrink-0" @click="onBtnExport">
                            <i class="fa-regular text-2xl fa-file-excel"></i>
                        </UiButton>
                    </UiTooltip>
                </div>
                <div class="w-full sm:w-50">
                    <UiInput v-model="searchKeyword" placeholder="Search" class="w-full rounded-lg">
                        <template #prefix>
                            <MagnifyingGlassIcon class="h-5 w-5 text-gray-400" />
                        </template>
                    </UiInput>
                </div>
            </div>
        </div>

        <UiAgGrid :rowData="rawData" :columnDefs="columnDefs"
            class="mb-10 my-zebra-grid" :quickFilterText="searchKeyword" @grid-ready="onGridReady"></UiAgGrid>
    </div>
     <UiModal v-model="showModal" title="Upload KK" size="2xl">
            <div class="divide-y divide-gray-200 text-sm md:text-base">

                <!-- KP Number -->
                <div class="grid grid-cols-1 gap-1 py-4 md:grid-cols-[140px_1fr] md:gap-4">
                    <span class="font-semibold text-gray-700">
                        KP Number
                    </span>

                    <span class="wrap-break-word text-gray-900">
                        {{ selectedUploadData?.kpno ?? '-' }}
                    </span>
                </div>

                <!-- Factory -->
                <div class="grid grid-cols-1 gap-1 py-4 md:grid-cols-[140px_1fr] md:gap-4">
                    <span class="font-semibold text-gray-700">
                        Factory
                    </span>

                    <span class="wrap-break-word text-gray-900">
                        {{ selectedUploadData?.factory ?? '-' }}
                    </span>
                </div>

                <!-- KK -->
                <div class="flex items-end gap-3 my-2">
                    <div class="flex-1">
                        <UiMultiSelect
                            v-model="form.buyer"
                            label="KK"
                            :options="buyers"
                            placeholder="-- Select KK --"
                        />
                    </div>

                    <UiButton>
                        Save KK
                    </UiButton>
                </div>

                <div class="space-y-2">
                    <UiInput type="file" variant="dropzone" label="KK BC" placeholder="Choose File" dropzone-hint="only PDF, XLS, or XLSX Formats, up to 2MB" accept=".pdf,.xls,.xlsx"></UiInput>
                    <div class="text-center">
                        <UiButton>
                                Upload
                        </UiButton>
                    </div>
                </div>
            </div>
        <template #footer>
            <div class="mt-4">
                <UiButton
                    variant="primary"
                    @click="submitForm"
                >
                    Complete Upload
                </UiButton>
                </div>
        </template>
    </UiModal>  
    <UiModal
        v-model="showModalUndo"
        size="md"
    >
        <!-- Confirmation -->
        <div
            class="space-y-4 -mt-2"
        >
                <!-- Icon -->
                <div class="flex justify-center">
                    <div class="flex h-32 w-32 items-center justify-center rounded-full bg-amber-100">
                        <ExclamationCircleIcon
                            class="h-28 w-28 text-amber-600"
                        />
                    </div>
                </div>

                <!-- Title -->
                <div class="mt-4 text-center">
                    <p class="mt-1 text-xl font-bold  text-gray-500">
                        Are you sure going to undo waiting list?
                    </p>
                    <p class="mt-1 text-md  text-gray-500">
                        Once data processed, you can`t retrieve it again or recover the data! please do this action carefully!
                    </p>
                </div>
        </div>
        <template #footer>
            <div class="flex justify-end gap-3">
                <UiButton
                    variant="secondary"
                    @click="closeModal"
                >
                    Cancel
                </UiButton>
                <UiButton
                    @click="process"
                >
                    OK
                </UiButton>
            </div>
        </template>
    </UiModal>
</template>

<script setup>
import { exportToPdf } from '@/utils/pdfExporter';
import { exportToExcel } from "@/utils/excelExporter";
import { getCurrentDateTime } from '@/utils/date';
import { encrypt } from "@/utils/crypto";

import { ref, shallowRef, onMounted, computed, defineComponent, h } from "vue";
import { useRouter } from "vue-router";
import { useLoadingStore } from "@/stores/loading";
import { ArrowTurnDownLeftIcon, ArrowUturnDownIcon, ArrowUturnLeftIcon, DocumentArrowUpIcon, ExclamationCircleIcon, InformationCircleIcon, MagnifyingGlassIcon, PaperAirplaneIcon } from "@heroicons/vue/24/outline";

import { customSwal } from "@/composable/customSwal";
const { confirm, success, warning, error } = customSwal;
const { datetime } = getCurrentDateTime('-', '-');

import UiButton from "@/components/ui/UiButton.vue"
import UiInput from "@/components/ui/UiInput.vue"
import UiModal from "@/components/ui/UiModal.vue"
import UiTitle from "@/components/ui/UiTitle.vue"
import UiMultiSelect from "@/components/ui/UiMultiSelect.vue"
import UiAgGrid from '@/components/ui/UiAgGrid.vue';
import UiTooltip from '@/components/ui/UiTooltip.vue';

import api from "@/services/api";

defineOptions({ name: 'Allocation' });

const loading = useLoadingStore();
const router = useRouter();

const rawData = shallowRef([]);
const allData = shallowRef([]);

const buyers = ref([]);
const data_kp = ref([]);
const pos = ref([]);
const dataSelected = ref([]);
const isNewData = ref(false);
const showModal = ref(false);
const showModalUndo = ref(false);
const searchKeyword = ref('');
const originalForm = ref(null);
const gridApi = ref(null);
const selectedUploadData = ref(null);

const filters = ref([
    { value: "po", label: "PO" },
    { value: "kp", label: "KP" },
]);

const confimForm = ref({
    auth_pass: "",
    description: "",
});

const form = ref({
    filter: "",
    buyer: "",
    kpno: "",
    po: "",
});

const isFormChanged = computed(() => {
    if (!originalForm.value) return false;

    return Object.keys(confimForm.value).some(
        key => confimForm.value[key] !== originalForm.value[key]
    );
});

const onGridReady = (params) => {
    gridApi.value = params.api;
};

const onBtnExport = () => {
    if (!gridApi.value) {
        alert("Please Wait!");
        return;
    }

    const fileName = `orders-artwork-${datetime.replace(' ', '_')}.xlsx`;
    exportToExcel({
        title: `Orders Artwork Allocation Report ${datetime}`,
        fileName: fileName,
        sheetName: "Orders Artwork",
        headers: ["NO", "PO", "KP", "Order Number", "Style", "CM Factory", "PO CMT", "Status"],
        fields: ["no", "po", "kpno", "ordernumber", "style", "factory", "po_sap", "status"],
        gridData: gridApi
    });
};

const onBtnExportPdf = () => {
    if (!gridApi.value) {
        alert("Please Wait!");
        return;
    }

    const nameFile = `orders-artwork-${datetime.replace(' ', '_')}`;
    exportToPdf({
        title: `Orders Artwork Allocation Report ${datetime}`,
        fileName: `${nameFile}`,
        headers: ["NO", "PO", "KP", "Order Number", "Style", "CM Factory", "PO CMT", "Status"],
        fields: ["no", "po", "kpno", "ordernumber", "style", "factory", "po_sap", "status"],
        gridData: gridApi,
        orientation: 'l'
    });
};

const setNewFilter = () => {
    form.value = { filter: "", buyer: "", kpno: "", po: "" };
    data_kp.value = [];
};

const closeModal = () => {
    showModal.value = false;
    isNewData.value = false;
};

const ActionRenderer = defineComponent({
    props: {
        params: {
            type: Object,
            required: true,
        },
    },

    setup(props) {
        const detailData = () => {
            dataSelected.value = props.params.data;

            const id = dataSelected.value.id;
            const encryptedid = encrypt(id);

            router.push({
                name: "order-artwork-allocation-detail",
                params: {
                    id: encodeURIComponent(encryptedid),
                },
            });
        };

        const uploadkk = () => {
            selectedUploadData.value = props.params.data;
            showModal.value = true;
        }

        const undoUpload = () => {
            showModalUndo.value = true
        }

        return () => {
            return h(
                "div",
                { class: "flex h-full gap-2" },
                [
                    h(
                        "button",
                        {
                            type: "button",
                            title: "Detail",
                            class: "cursor-pointer text-amber-500 transition hover:text-amber-700",
                            onClick: detailData,
                        },
                        [
                            h(InformationCircleIcon, { class: "h-5 w-5" }),
                        ],
                    ),
                    
                    (props.params.data?.status === "New") &&
                    h(
                        "button",
                        {
                            type: "button",
                            title: "Upload KK",
                            class: "cursor-pointer text-sky-500 transition hover:text-sky-700",
                            onClick: uploadkk,
                        },
                        [
                            h(DocumentArrowUpIcon, { class: "h-5 w-5" }),
                        ],
                    ),
                    (props.params.data?.status === "Waiting") &&
                    h(
                        "button",
                        {
                            type: "button",
                            title: "Undo Waiting List",
                            class: "cursor-pointer text-red-500 transition hover:text-red-700",
                            onClick: undoUpload,
                        },
                        [
                            h(ArrowUturnLeftIcon, { class: "h-5 w-5" }),
                        ],
                    ),
                ],
            );
        };
    },
});

const columnDefs = [
    {
        headerName: "No",
        field: "no",
        width: 80,
        filter: false,
        resizable: false,
    },
    {
        field: "po",
        headerName: "PO",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "kpno",
        headerName: "KP",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "ordernumber",
        headerName: "Order Number",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "style",
        headerName: "Style",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "factory",
        headerName: "CM Factory",
        minWidth: 150,
        valueGetter: (params) => params.data?.factory ?? "-",
        flex: 1,
    },
    {
        field: "po_sap",
        headerName: "PO CMT",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "status",
        headerName: "Status",
        minWidth: 125,
        flex: 1,
    },
    {
        headerName: "Action",
        maxWidth: 150,
        sortable: false,
        filter: false,
        resizable: false,
        cellRenderer: ActionRenderer,
    },
];

let reqId = 0;

const fetchGrid = async (query = "") => {
    const id = ++reqId;
    try {
        loading.show();
        const { data } = await api.get(`/api/v1/order-artwork/getdata${query}`);
        if (id !== reqId) return;

        const rows = (data?.data ?? []).map((item, index) => ({
            ...item,
            no: index + 1,
        }));
        rawData.value = rows;
        if (!query) allData.value = rows;
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
    } finally {
        loading.hide();
    }
};

const loadData = () => fetchGrid();

const showAll = () => {
    if (allData.value.length) rawData.value = allData.value;
    else fetchGrid();
};

const loadDataBuyer = async () => {
    try {
        loading.show();
        const { data } = await api.get("/api/v1/order-artwork/buyers");
        buyers.value = (data?.data ?? []).map((item) => ({
            value: item.idbuyer,
            label: item.namabuyer,
        }));
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
    } finally {
        loading.hide();
    }
};

const loadDataPo = async () => {
    try {
        loading.show();
        const { data } = await api.get("/api/v1/order-artwork/pos");
        pos.value = (data?.data ?? []).map((item) => ({
            value: item.po,
            label: item.po,
        }));
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
    } finally {
        loading.hide();
    }
};

const loadDataKp = async (idbuyer) => {
    try {
        loading.show();
        const { data } = await api.get(`/api/v1/order-artwork/kps?idbuyer=${idbuyer}`);
        data_kp.value = (data?.data ?? []).map((item) => ({
            value: item.kpno,
            label: item.kpno,
        }));
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
    } finally {
        loading.hide();
    }
};

const onFilterChange = (val) => {
    form.value = { filter: val ?? "", buyer: "", kpno: "", po: "" };
    data_kp.value = [];
    showAll();
    if (val === "po" && !pos.value.length) loadDataPo();
};

const onBuyerChange = async (idbuyer) => {
    form.value.kpno = "";
    data_kp.value = [];
    if (!idbuyer) return showAll();
    await loadDataKp(idbuyer);
};

const loadDataByPo = (po) => (po ? fetchGrid(`?po=${po}`) : showAll());
const loadDataByKp = (kpno) => (kpno ? fetchGrid(`?kpno=${kpno}`) : showAll());

onMounted(() => {
    loadData();
    loadDataBuyer();
});
</script>

