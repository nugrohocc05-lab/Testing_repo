<script setup>
import { ref, onMounted, computed, defineComponent, h, watch } from "vue";
import { useRouter } from "vue-router";
import { useLoadingStore } from "@/stores/loading";
import { PencilSquareIcon, TrashIcon, MagnifyingGlassIcon, ArrowUpTrayIcon } from "@heroicons/vue/24/outline";
import { customSwal } from "@/composable/customSwal";
const { confirmDelete, success, warning, error } = customSwal;

import UiButton from "@/components/ui/UiButton.vue"
import UiInput from "@/components/ui/UiInput.vue"
import UiModal from "@/components/ui/UiModal.vue"
import UiTitle from "@/components/ui/UiTitle.vue"

import api from "@/services/api";

import '@vuepic/vue-datepicker/dist/main.css'
import UiAgGrid from "@/components/ui/UiAgGrid.vue";
import UiTooltip from "@/components/ui/UiTooltip.vue";
import { DocumentPlusIcon } from "@heroicons/vue/24/solid";
import UiAccordion from "@/components/ui/UiAccordion.vue";

const loading = useLoadingStore();
const router = useRouter();
const rawData = ref([]);
const dataSelected = ref([]);
const action = ref("");
const isNewData = ref(false)
const showModal = ref(false)
const showModalUpload = ref(false)
const searchKeyword = ref('')
const originalForm = ref(null)

const defaultColDef = {
    sortable: true,
    filter: false,
    resizable: true,
};

const form = ref({
    idfactory: "",
    kode: "",
    work_day: "",
    namafactory: "",
    kota: "",
    sap_code: "",
    vendor_sap_code: "",
    alamat: "",
    kodepos: "",
    provinsi: "",
});

const IP_REGEX = /^(25[0-5]|2[0-4]\d|1?\d?\d)(\.(25[0-5]|2[0-4]\d|1?\d?\d)){3}$/

const ipAddresses = ref([''])
const originalIps = ref([])

const addIp = () => ipAddresses.value.push('')
const removeIp = (index) => ipAddresses.value.splice(index, 1)

watch(ipAddresses, (list) => {
    list.forEach((v, i) => {
        const c = String(v ?? '').replace(/[^0-9.]/g, '')
        if (c !== v) list[i] = c
    })
}, { deep: true })

const normalizeIps = (raw) => {
    if (!raw) return []
    let list = typeof raw === 'string' ? raw.split(/[,;\s]+/) : raw
    if (!Array.isArray(list)) return []
    return list
        .map(i => {
            if (i && typeof i === 'object') {
                return Object.values(i).find(v => IP_REGEX.test(String(v).trim())) ?? ''
            }
            return i
        })
        .map(i => String(i ?? '').trim())
        .filter(Boolean)
}

const extractIps = (data) => {
    if (!data) return []
    const key = Object.keys(data).find(k =>
        /^(ip|ips|ip_address(es)?|ipaddress(es)?|ip_list|list_ip|ip_factory)$/i.test(k)
    )
    return normalizeIps(key ? data[key] : null)
}

const setIps = (raw) => {
    const list = normalizeIps(raw)
    ipAddresses.value = list.length ? [...list] : ['']
    originalIps.value = [...list]
}

const cleanIps = () => [...new Set(
    ipAddresses.value.map(i => String(i ?? '').trim()).filter(Boolean)
)]

const validateIps = async () => {
    const invalid = cleanIps().find(ip => !IP_REGEX.test(ip))
    if (invalid) {
        await warning({
            title: 'IP Address not valid',
            text: `Format IP "${invalid}" salah. Contoh: 192.168.100.100`,
        })
        return false
    }
    return true
}

const maxDate = new Date()
maxDate.setFullYear(maxDate.getFullYear() - 5)

const MAX_FILE_SIZE = 2 * 1024 * 1024

const docTypes = [
    { key: 'npwp', label: 'NPWP' },
    { key: 'iui', label: 'IUI' },
    { key: 'siup', label: 'SIUP' },
    { key: 'faktur', label: 'Faktur' },
]
const emptyDocs = () => ({ npwp: null, iui: null, siup: null, faktur: null })

const pendingFiles = ref(emptyDocs())   
const removedFiles = ref(emptyDocs())   
const uploadTarget = ref(null)          
const tempFile = ref(null)             
const uploadInput = ref(null)
const isDragging = ref(false)

const uploadLabel = computed(
    () => docTypes.find(d => d.key === uploadTarget.value)?.label ?? ''
)

const resetFiles = () => {
    pendingFiles.value = emptyDocs()
    removedFiles.value = emptyDocs()
}

const fileIcon = (name = '') => {
    const ext = String(name).split('.').pop().toLowerCase()

    if (ext === 'pdf') return '/images/icons/file/pdf.svg'
    if (['xls', 'xlsx', 'csv'].includes(ext)) return '/images/icons/file/xls.svg'
    if (['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg'].includes(ext)) {
        return '/images/icons/file/img.svg'
    }

    return '/images/icons/file/pdf.svg' 
}

const getFileInfo = (key) => {
    if (pendingFiles.value[key]) {
        return {
            name: pendingFiles.value[key].name,
            pending: true,
        }
    }

    if (removedFiles.value[key]) {
        return null
    }

    const file = dataSelected.value?.file?.find(
        (item) => item.type?.toLowerCase() === key.toLowerCase()
    )

    if (!file) return null

    return {
        name: `${file.filename}.${file.extension}`,
        date: file.uploaddate ?? '-',
        pending: false,
    }
}

const openUpload = (key) => {
    uploadTarget.value = key
    tempFile.value = null
    isDragging.value = false
    showModalUpload.value = true
}

const validateAndSetTemp = async (f) => {
    if (!f) return

    const okType = /\.(pdf|xls|xlsx|doc|docx)$/i.test(f.name)
    if (!okType || f.size > MAX_FILE_SIZE) {
        await warning({
            title: "File not valid",
            text: "PDF/XLS/XLSX/DOC only, maximum 2MB.",
        })
        return
    }
    tempFile.value = f
}

const onPickFile = (e) => {
    const f = e.target.files?.[0]
    e.target.value = ''
    validateAndSetTemp(f)
}

const onDropFile = (e) => {
    isDragging.value = false
    validateAndSetTemp(e.dataTransfer?.files?.[0])
}

const saveUpload = () => {
    if (!tempFile.value) return

    pendingFiles.value[uploadTarget.value] = tempFile.value
    removedFiles.value[uploadTarget.value] = false
    tempFile.value = null
    showModalUpload.value = false
}

const removeFile = (key) => {
    if (pendingFiles.value[key]) {
        pendingFiles.value[key] = null
    } else {
        removedFiles.value[key] = true
    }
}

const triggerDownload = (href, filename) => {
    const a = document.createElement('a')
    a.href = href
    a.download = filename
    document.body.appendChild(a)
    a.click()
    a.remove()
}

const downloadFile = async (key) => {
    const pending = pendingFiles.value[key]
    if (pending) {
        const url = URL.createObjectURL(pending)
        triggerDownload(url, pending.name)
        setTimeout(() => URL.revokeObjectURL(url), 1000)
        return
    }

    const file = dataSelected.value?.file?.find(
        (item) => item.type?.toLowerCase() === key.toLowerCase()
    )
    if (!file) return

    const fileId = file.idfile ?? file.id
    const filename = `${file.filename}.${file.extension}`

    try {
        loading.show()

        const res = await api.get(
            `/api/v1/master/showfile/${fileId}`,
            { responseType: 'blob' }
        )

        const url = URL.createObjectURL(res.data)
        triggerDownload(url, filename)
        setTimeout(() => URL.revokeObjectURL(url), 1000)
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push('/login')
            return
        }
        await error({
            title: 'Download Failed',
            text: 'File tidak bisa diunduh. Silakan coba lagi.',
        })
    } finally {
        loading.hide()
    }
}

const buildFormData = () => {
    const fd = new FormData()
    Object.entries(form.value).forEach(([k, v]) => fd.append(k, v ?? ''))

    cleanIps().forEach(ip => fd.append('ip[]', ip))

    docTypes.forEach(({ key }) => {
        if (pendingFiles.value[key]) {
            fd.append(`${key}`, pendingFiles.value[key])
        } else if (removedFiles.value[key]) {
            fd.append(`delete_${key}`, 1)
        }
    })
    return fd
}

const isFormChanged = computed(() => {
    if (!originalForm.value) return false

    const fileChanged = docTypes.some(
        ({ key }) => pendingFiles.value[key] || removedFiles.value[key]
    )

    const ipChanged =
        JSON.stringify(cleanIps()) !== JSON.stringify(originalIps.value)

    return (
        fileChanged ||
        ipChanged ||
        Object.keys(form.value).some(
            key => form.value[key] !== originalForm.value[key]
        )
    )
})

const setForm = () => {
    const data = dataSelected.value;

    if (!data) return;
    form.value = {
        idfactory: data.idfactory ?? "",
        kode: data.kode ?? "",
        namafactory: data.namafactory ?? "",
        kota: data.kota ?? "",
        sap_code: data.sap_code ?? null,
        vendor_sap_code: data.vendor_sap_code ?? "",
        alamat: data.alamat ?? "",
        kodepos: data.kodepos ?? "",
        provinsi: data.provinsi ?? "",
        work_day: data.work_day ?? ""
    };
    setIps(extractIps(data))
    resetFiles()
    isNewData.value = false;
    originalForm.value = { ...form.value }
};

const setNewData = () => {
    isNewData.value = true
    dataSelected.value = "New Data";
    action.value = "Add";

    form.value = {
        idfactory: "",
        kode: "",
        namafactory: "",
        kota: "",
        sap_code: "",
        vendor_sap_code: "",
        alamat: "",
        kodepos: "",
        provinsi: "",
        work_day: "",
    };

    setIps([])
    resetFiles()
    showModal.value = true
    originalForm.value = { ...form.value }
};

const closeModal = () => {
    showModal.value = false;
    isNewData.value = false;
    resetFiles()
};

const loadFactoryDetail = async (idfactory) => {
    try {
        loading.show()

        const { data } = await api.get(
            `/api/v1/master/getdatafactory?idfactory=${idfactory}`
        )

        const detail = Array.isArray(data?.data) ? data.data[0] : data?.data

        if (detail) {
            dataSelected.value = { ...dataSelected.value, ...detail }
            setForm()
        }
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login")
        }
    } finally {
        loading.hide()
    }
}

const ActionRenderer = defineComponent({
    props: {
        params: {
            type: Object,
            required: true,
        },
    },

    setup(props) {
        const editData = () => {
            dataSelected.value = props.params.data;
            action.value = "Edit Data";
            setForm();
            showModal.value = true;
            loadFactoryDetail(props.params.data.idfactory);
        };

        const deleteData = () => {
            dataSelected.value = props.params.data;
            deleteThisData()
        };

        return () =>
            h(
                "div",
                {
                    class: "flex h-full items-center justify-center gap-3",
                },
                [
                    h(
                        "button",
                        {
                            type: "button",
                            title: "Edit",
                            class:
                                "cursor-pointer text-blue-500 transition hover:text-blue-700",
                            onClick: editData,
                        },
                        [
                            h(PencilSquareIcon, {
                                class: "h-5 w-5",
                            }),
                        ],
                    ),

                    h(
                        "button",
                        {
                            type: "button",
                            title: "Delete",
                            class: "cursor-pointer text-red-500 hover:text-red-700",
                            onClick: deleteData,
                        },
                        [
                            h(TrashIcon, {
                                class: "h-5 w-5",
                            }),
                        ],
                    ),
                ],
            );
    },
});

const columnDefs = [
    {
        headerName: "No",
        field: "no",
        width: 80,
        filter: false,
        resizable: true,
    },
    {
        field: "namafactory",
        headerName: "Name",
        minWidth: 150,
        flex: 1,
    },
    {
        field: "sap_code",
        headerName: "SAP Code",
        minWidth: 150,
        valueGetter: (params) => {
            return params.data?.sap_code ?? "-";
        },
    },
    {
        field: "vendor_sap_code",
        headerName: "Vendor SAP Code",
        minWidth: 100,
        valueGetter: (params) => {
            return params.data?.vendor_sap_code ?? "-";
        },
    },
    {
        field: "kode",
        headerName: "Factory Code",
        minWidth: 100,
        valueGetter: (params) => {
            return params.data?.kode ?? "-";
        },
    },
    {
        headerName: "Action",
        minWidth: 120,
        maxWidth: 120,
        sortable: false,
        filter: false,
        resizable: false,
        cellRenderer: ActionRenderer,
    },
];

const loadData = async () => {
    try {
        loading.show();
        const endpoint = "/api/v1/master/getFactory";

        const { data } = await api.get(endpoint);
        rawData.value = data?.data ?? [];

        rawData.value = (data?.data ?? []).map((item, index) => ({
            ...item,
            no: index + 1,
        }));
    } catch (err) {
        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

onMounted(() => {
    loadData();
});

const storeNewData = async () => {
    try {

        if (
            !form.value.kode ||
            !form.value.namafactory ||
            !form.value.kota ||
            !form.value.alamat ||
            !form.value.provinsi ||
            docTypes.some(({ key }) => !pendingFiles.value[key] && !getFileInfo(key))
        ) {
            await warning({
                title: 'Incomplete Data',
                text: 'Please complete all required fields.',
            })

            return  
        }

        if (!(await validateIps())) return

        loading.show()

        const endpoint = "api/v1/master/add-factory";
        const { data } = await api.post(
            endpoint,
            buildFormData(),
            { headers: { "Content-Type": "multipart/form-data" } }
        );
        isNewData.value = false
        closeModal()
        loading.hide()
        await success({
                title: "Success",
                text: data?.message || "Data Added successfully.",
            });
        await loadData()

    } catch (err) {
        loading.hide()
        if (err?.response?.status === 401) {
            router.push("/login")
            return
        }

await error({
            title:"Add Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to add the data. Please try again.",
        });
    }
}

const submit = async () => {
    try {

        if (
            !form.value.kode ||
            !form.value.namafactory ||
            !form.value.kota ||
