const fileIcon = (name = '') => {
    const ext = String(name).split('.').pop().toLowerCase()

    if (ext === 'pdf') return '/images/icons/file/pdf.svg'
    if (['xls', 'xlsx'].includes(ext)) return '/images/icons/file/xls.svg'
    if (['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg'].includes(ext)) {
        return '/images/icons/file/img.svg'
    }

    return '/images/icons/file/img.svg' // ikon default
}