            ->count(DB::raw("DISTINCT $od.barcode"));
        $qtyInspectReject = (clone $headerQuery)
            ->whereIn("$od.idpo", $rejectIdpoList)
            ->whereNotNull("$fi.date_output")
            ->count(DB::raw("DISTINCT $od.barcode"));

        $so = (new SewingOutput())->getTable();

        // sudah di-cache dari getLeafHistoryRows di atas (parameter sama)
        $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);
        $byIdpoLeaf = $leafRows->groupBy('idpo');

        $today = Carbon::today()->startOfDay();
        $split = $this->getSplitFinalCheckIdpoList($request, $dta, $dtb, $today);
        $finalIdpoList = $split['overdue']->merge($split['need_final'])->unique()->values();

        $poList = $finalIdpoList->map(function ($idpo) use ($byIdpoLeaf) {
            $rows = $byIdpoLeaf->get($idpo);
            if (!$rows) {
                return null;
            }
            $first = $rows->first();
            return (object) [
                'idpo' => $idpo, 'po' => $first->po, 'idbuyer' => $first->idbuyer,
                'idstyle' => $first->idstyle, 'idcolor' => $first->idcolor,
            ];
        })->filter()->values();

        $idpoList = $poList->pluck('idpo')->unique()->values();

        $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
            ->pluck('combine_pro')->filter()->unique()->values();

        $rows = HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
            ->select('idpo', 'combine_pro', 'kp_item', 'kp_item_ref', 'revisi_kp', 'qty_ori')
            ->get();

        $ownerByCombineKpItem = $rows
            ->groupBy(fn ($r) => $r->combine_pro . '|' . $r->kp_item)
            ->map(fn ($group) => (string) $group->sortBy('idpo')->first()->idpo);

        $originalIdpoList = $rows
            ->filter(fn ($r) => $r->revisi_kp == 1 && !is_null($r->kp_item_ref))
            ->map(fn ($r) => $ownerByCombineKpItem->get($r->combine_pro . '|' . $r->kp_item_ref))
            ->filter()->unique()->values();

        $allIdpoList = $idpoList->merge($originalIdpoList)->unique()->values();

        $combineProList = HistoryDataBreakdown::whereIn('idpo', $idpoList)
            ->pluck('combine_pro')
            ->filter()
            ->unique()
            ->values();

        $allHistoryIdpo = HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
            ->pluck('idpo')
            ->filter()
            ->unique()
            ->values();

        $outputPerIdpo = $this->getOutputPerIdpoFromPacking($allIdpoList);

        $outputPerIdpo = $this->redistributeReroutedOutput(
            $idpoList,
            $outputPerIdpo
        );

        $notFinalIdpoList = $idpoList;
        $qtyInspectNotFinal = 0;

        // tarik output mentah per-idpo dulu, baru redistribute sebelum dijumlahkan
        $getOutputPerIdpo = function ($idpoList) use ($od, $odp) {
            if ($idpoList->isEmpty()) {
                return collect();
            }

            return OutputDetail::query()
                ->whereIn("$od.idpo", $idpoList)
                ->whereNotNull("$od.barcode")
                ->leftJoin("$odp", "$odp.barcode", '=', "$od.barcode")
                ->select(
                    "$od.idpo",
                    DB::raw("COUNT(DISTINCT $odp.id_set) as total_output")
                )
                ->groupBy("$od.idpo")
                ->get()
                ->mapWithKeys(function ($row) {
                    return [
                        (string) $row->idpo => (int) $row->total_output
                    ];
                });
        };

        $outputPassPerIdpo = $this->redistributeReroutedOutput(
            $passIdpoList,
            $getOutputPerIdpo($passIdpoList)
        );

        $outputRejectPerIdpo = $this->redistributeReroutedOutput(
            $rejectIdpoList,
            $getOutputPerIdpo($rejectIdpoList)
        );

        $outputPass = $outputPassPerIdpo->sum();
        $outputReject = $outputRejectPerIdpo->sum();
        $outputNotFinal = $outputPerIdpo->sum();

        $qtyPass = $passIdpoList->sum(
            fn ($idpo) => $qtyPerIdpo->get($idpo, 0)
        );

        $qtyReject = $rejectIdpoList->sum(
            fn ($idpo) => $qtyPerIdpo->get($idpo, 0)
        );

        $qtyNotFinal = $notFinalIdpoList->sum(
            fn ($idpo) => $qtyPerIdpo->get($idpo, 0)
        );

        $progressPass = $qtyPass > 0 ? round(($outputPass / $qtyPass) * 100, 2) : 0;
        $progressReject = $qtyReject > 0 ? round(($outputReject / $qtyReject) * 100, 2) : 0;
        $progressNotFinal = $qtyNotFinal > 0 ? round(($outputNotFinal / $qtyNotFinal) * 100, 2) : 0;

        $totalPoAll = $poNoDefect + $poWithDefect + $notFinalIdpoList->count();
        $totalQtyOrderAll = $qtyPass + $qtyReject + $qtyNotFinal;
        $totalQtyInspectAll = $qtyInspectPass + $qtyInspectReject;
        $totalOutputAll = $outputPass + $outputReject + $outputNotFinal;
        $totalProgressOutputAll = $totalQtyOrderAll > 0
            ? round(($totalOutputAll / $totalQtyOrderAll) * 100, 2) : 0;

        return response()->json([
            'data' => [[
                'pass' => [
                    'count' => $poNoDefect,
                    'qty' => $qtyPass,
                    'qty_inspect' => $qtyInspectPass,
                    'output' => $outputPass,
                    'progress_output' => $progressPass,
                ],
                'reject' => [
                    'count' => $poWithDefect,
                    'qty' => $qtyReject,
                    'qty_inspect' => $qtyInspectReject,
                    'output' => $outputReject,
                    'progress_output' => $progressReject,
                ],
                'not_final' => [
                    'count' => $notFinalIdpoList->count(),
                    'qty' => $qtyNotFinal,
                    'qty_inspect' => $qtyInspectNotFinal,
                    'output' => $outputNotFinal,
                    'progress_output' => $progressNotFinal,
                ],
                'total' => [
                    'total_po' => $totalPoAll,
                    'qty_order' => $totalQtyOrderAll ?: 0,
                    'qty_inspect' => $totalQtyInspectAll ?: 0,
                    'output' => $totalOutputAll ?: 0,
                    'progress_output' => $totalProgressOutputAll,
                ],
            ]],
        ]);
    }

