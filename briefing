<template>
    <div class="px-6">
        <UiTitle align="center" title="CM Counter Sample" subtitle="Lorem Ipsum Dolores Amet" />

        <div class="mb-4 flex flex-col sm:flex-row w-full sm:items-end gap-3 justify-between">
            <div class="flex flex-col sm:flex-row items-stretch sm:items-end gap-2 w-full sm:w-auto">
                <div class="w-full sm:w-60 lg:w-72">
                    <UiMultiSelect
                        v-model="filterStatus"
                        :options="statusOptions"
                        label="Filter by Status"
                        placeholder="-- Select Status --"
                        class="w-full"
                        @change="loadData"
                    />
                </div>
                <div>
                    <UiButton variant="warning" class="w-full sm:w-auto mb-5 sm:mb-0" @click="resetFilter">
                        Reset
                    </UiButton>
                </div>
            </div>

            <div class="w-full sm:w-60 lg:w-72">
                <UiInput v-model="searchKeyword" placeholder="Search" class="w-full rounded-lg">
                    <template #prefix>
                        <MagnifyingGlassIcon class="h-5 w-5 text-gray-400" />
                    </template>
                </UiInput>
            </div>
        </div>

        <UiAgGrid
            :rowData="rawData"
            :columnDefs="columnDefs"
            :defaultColDef="defaultColDef"
            :quickFilterText="searchKeyword"
            class="mb-10 my-zebra-grid"
        />
    </div>

    <UiModal v-model="showModal" title="Sending Counter Sample" size="md">
        <div class="space-y-2 -mt-3">
            <label for="counter-sample-photo" class="block text-sm font-medium text-gray-700">
                Upload Image
            </label>

            <input
                id="counter-sample-photo"
                ref="fileInput"
                type="file"
                :accept="ALLOWED_EXTENSIONS"
                class="block w-full rounded-lg border border-gray-300 p-2 text-sm"
                @change="handleFileChange"
            />

            <div v-if="imageFile" class="text-sm text-gray-600">
                File terpilih:
                <span class="font-medium">{{ imageFile.name }}</span>
            </div>
        </div>

        <template #footer>
            <div class="flex justify-end gap-2">
                <UiButton variant="primary" :loading="isSending" @click="sendCounterSample">
                    Confirm
                </UiButton>
            </div>
        </template>
    </UiModal>
</template>

<script setup>
import { ref, onMounted, defineComponent, h } from "vue";
import { useRouter } from "vue-router";
import { InformationCircleIcon, MagnifyingGlassIcon, DocumentArrowUpIcon } from "@heroicons/vue/24/outline";

import { encrypt } from "@/utils/crypto";
import { useLoadingStore } from "@/stores/loading";
import { customSwal } from "@/composable/customSwal";
import api from "@/services/api";

import UiButton from "@/components/ui/UiButton.vue";
import UiInput from "@/components/ui/UiInput.vue";
import UiModal from "@/components/ui/UiModal.vue";
import UiTitle from "@/components/ui/UiTitle.vue";
import UiMultiSelect from "@/components/ui/UiMultiSelect.vue";
import UiAgGrid from "@/components/ui/UiAgGrid.vue";

defineOptions({ name: "CMCounterSample" });

const { success, warning, error } = customSwal;

/* ---------- Constants ---------- */
const ALLOWED_TYPES = ["image/jpeg", "image/png", "image/webp"];
const ALLOWED_EXTENSIONS = ".jpg,.jpeg,.png,.webp";
const MAX_FILE_SIZE = 5 * 1024 * 1024; // 5 MB

const API = {
    list: "/api/v1/cmcountersample/getdata",
    status: "/api/v1/cmsamplereference/selectstatus",
    sending: (idOrder) => `/api/v1/cmcountersample/sending/${idOrder}`,
};

/* ---------- State ---------- */
const loading = useLoadingStore();
const router = useRouter();

const rawData = ref([]);
const statusOptions = ref([]);
const filterStatus = ref("");
const searchKeyword = ref("");

const showModal = ref(false);
const isSending = ref(false);
const selectedRow = ref(null);
const imageFile = ref(null);
const fileInput = ref(null);

/* ---------- Helpers ---------- */
const handleApiError = (err) => {
    console.error(err);
    if (err?.response?.status === 401) {
        router.push("/login");
    }
};

// UiMultiSelect bisa mengembalikan string atau object option
const getStatusValue = () => {
    const s = filterStatus.value;
    if (s && typeof s === "object") return s.value ?? s.status ?? "";
    return s ?? "";
};

const normalizeData = (data) => {
    const processedKK = new Set();

    return (data ?? []).map((item, index) => {
        const kk = item?.orderallocation?.kk ?? item?.kk ?? null;
        const showProcess = item?.status === "Waiting" && !!kk && !processedKK.has(kk);

        if (showProcess) processedKK.add(kk);

        return { ...item, no: index + 1, kk, showProcess };
    });
};

/* ---------- Data loading ---------- */
const loadData = async () => {
    try {
        loading.show();

        const status = getStatusValue();
        const { data } = await api.get(API.list, {
            params: status ? { status } : {},
        });

        rawData.value = normalizeData(Object.values(data?.data ?? {}).flat());
    } catch (err) {
        handleApiError(err);
    } finally {
        loading.hide();
    }
};

const loadStatusOptions = async () => {
    try {
        const { data } = await api.get(API.status);
        statusOptions.value = (data?.data ?? []).map((item) => ({
            value: item,
            label: item,
        }));
    } catch (err) {
        handleApiError(err);
    }
};

const resetFilter = () => {
    filterStatus.value = "";
    searchKeyword.value = "";
    return loadData();
};

/* ---------- Modal & upload ---------- */
const clearFile = () => {
    imageFile.value = null;
    if (fileInput.value) fileInput.value.value = "";
};

const openProcessModal = (row) => {
    selectedRow.value = row;
    clearFile();
    showModal.value = true;
};

const handleFileChange = (e) => {
    const file = e.target.files?.[0];

    if (!file) {
        imageFile.value = null;
        return;
    }

    if (!ALLOWED_TYPES.includes(file.type)) {
        warning("Format harus JPG, PNG, atau WEBP");
        clearFile();
        return;
    }

    if (file.size > MAX_FILE_SIZE) {
        warning("Ukuran file maksimal 5 MB");
        clearFile();
        return;
    }

    imageFile.value = file;
};

const sendCounterSample = async () => {
    const idOrder = selectedRow.value?.idorder;

    if (!idOrder) {
        warning("ID Order tidak ditemukan");
        return;
    }

    if (!imageFile.value) {
        warning("Silakan upload foto terlebih dahulu");
        return;
    }

    try {
        isSending.value = true;
        loading.show();

        const formData = new FormData();
        formData.append("photo", imageFile.value);

        await api.post(API.sending(idOrder), formData, {
            headers: { "Content-Type": "multipart/form-data" },
        });

        success("Counter sample berhasil dikirim");
        showModal.value = false;
        clearFile();

        await loadData();
    } catch (err) {
        console.error(err);
        error(
            err?.response?.data?.message ||
            err?.response?.data?.error ||
            "Gagal mengirim counter sample"
        );
    } finally {
        isSending.value = false;
        loading.hide();
    }
};

/* ---------- Grid ---------- */
const goToDetail = (row) => {
    const kk = row?.orderallocation?.kk;
    const idOrder = row?.idorder;

    if (!kk || !idOrder) {
        console.error("KK atau ID Order tidak ditemukan:", row);
        return;
    }

    router.push({
        name: "cm-counter-sample-detail",
        params: {
            kk: encodeURIComponent(encrypt(kk)),
            idorder: encodeURIComponent(encrypt(idOrder)),
        },
    });
};

const ActionRenderer = defineComponent({
    props: {
        params: { type: Object, required: true },
    },
    setup(props) {
        return () =>
            h("div", { class: "flex h-full px-3 gap-2" }, [
                h(
                    "button",
                    {
                        type: "button",
                        title: "Detail",
                        class: "cursor-pointer text-amber-500 transition hover:text-amber-700",
                        onClick: () => goToDetail(props.params.data),
                    },
                    [h(InformationCircleIcon, { class: "h-5 w-5" })],
                ),

                props.params.data?.showProcess &&
                    h(
                        "button",
                        {
                            type: "button",
                            title: "Process",
                            class: "cursor-pointer text-cyan-500 hover:text-cyan-700",
                            onClick: () => openProcessModal(props.params.data),
                        },
                        [h(DocumentArrowUpIcon, { class: "h-5 w-5" })],
                    ),
            ]);
    },
});

const defaultColDef = {
    sortable: true,
    filter: false,
    resizable: true,
};

const textColumn = (field, headerName, getter, extra = {}) => ({
    field,
    headerName,
    minWidth: 125,
    flex: 1,
    valueGetter: ({ data }) => getter(data) ?? "-",
    ...extra,
});

const columnDefs = [
    { headerName: "No", field: "no", width: 70, sortable: false, resizable: false },
    textColumn("kk", "KK", (d) => d?.orderallocation?.kk),
    textColumn("combine_pro", "PRO", (d) => d?.purchaseorder?.combine_pro),
    textColumn("style", "Style", (d) => d?.purchaseorder?.style?.namastyle),
    textColumn("total", "Qty", (d) => d?.purchaseorder?.total, { minWidth: 70, maxWidth: 90 }),
    textColumn("comment", "Comment", (d) => d?.comment, { minWidth: 80, maxWidth: 150 }),
    textColumn("status", "Status", (d) => d?.status, { minWidth: 150 }),
    {
        headerName: "Action",
        minWidth: 80,
        maxWidth: 120,
        sortable: false,
        resizable: false,
        cellRenderer: ActionRenderer,
    },
];

/* ---------- Lifecycle ---------- */
onMounted(() => {
    loadData();
    loadStatusOptions();
});
</script>