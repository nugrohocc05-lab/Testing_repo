            'jumlah_row_packing'  => $packingRows->count(),
            'distinct_id_set'     => $packingRows->pluck('id_set')->filter()->unique()->count(),
            'sample_packing_rows' => $packingRows->take(5)->toArray(), // biar keliatan kolom2nya
        ];
    }

    dd($result);
