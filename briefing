private function buildFinalOverviewData(Request $request, Carbon $dta, Carbon $dtb): array
{
    $fi = (new OutputDetailFinalInspection())->getTable();
    $od = (new OutputDetail())->getTable();
    $po = (new PurchaseOrder())->getTable();
    $odp = (new OutputDetailPacking())->getTable();

    $leafRows = $this->getLeafHistoryRows($request, 'combine_pro', true, $dta, $dtb);
    $qtyPerIdpo = $leafRows->groupBy('idpo')->map(fn ($rows) => (int) $rows->sum('qty_ori'));
    $qualifiedIdpo = $qtyPerIdpo->filter(fn ($qty) => $qty > 0)->keys()->values();
    $this->primeComboUniverse($qualifiedIdpo);

    $headerQuery = OutputDetailFinalInspection::query()
        ->join($od, "$od.barcode", '=', "$fi.barcode")
        ->join($po, "$po.idpo", '=', "$od.idpo")
        ->whereIn("$od.idpo", $qualifiedIdpo);

    $status = $this->getFinalCompletionStatus($qualifiedIdpo);

    $finalComIdpoList = $status['finalCom'];   // RAW
    $rejectIdpoList = $status['reject'];       // RAW
    $passIdpoList = $status['pass'];           // RAW

    // COUNT (harus 23): basis RAW, sama seperti buildSummaryFilterData.
    $poWithDefect = $rejectIdpoList->count();
    $poNoDefect = $passIdpoList->count();

    $qtyInspectPass = (clone $headerQuery)
        ->whereIn("$od.idpo", $passIdpoList)
        ->whereNotNull("$fi.date_output")
        ->count(DB::raw("DISTINCT $od.barcode"));

    $qtyInspectReject = (clone $headerQuery)
        ->whereIn("$od.idpo", $rejectIdpoList)
        ->whereNotNull("$fi.date_output")
        ->count(DB::raw("DISTINCT $od.barcode"));

    $byIdpoLeaf = $leafRows->groupBy('idpo');

    $today = Carbon::today()->startOfDay();
    $split = $this->getSplitFinalCheckIdpoList($request, $dta, $dtb, $today);

    $activeIdpoList = $this->getActiveRerouteIdpoList($qualifiedIdpo);

    // List untuk COUNT & poList -> basis RAW, total = 23
    $notFinalForCount = $activeIdpoList
        ->diff($finalComIdpoList)
        ->values();

    $countNotFinal = $notFinalForCount->count();

    $poList = $notFinalForCount->map(function ($idpo) use ($byIdpoLeaf) {
        $rows = $byIdpoLeaf->get($idpo);
        if (!$rows) {
            return null;
        }
        $first = $rows->first();
        return (object) [
            'idpo' => $idpo,
            'po' => $first->po,
            'idbuyer' => $first->idbuyer,
            'idstyle' => $first->idstyle,
            'idcolor' => $first->idcolor,
        ];
    })->filter()->values();

    // List untuk QTY ORDER -> basis REMAPPED, total = 81
    $finalComRemapped = $this->remapToReroutedIdpo($finalComIdpoList);
    $rejectRemapped = $this->remapToReroutedIdpo($rejectIdpoList);
    $passRemapped = $finalComRemapped->diff($rejectRemapped)->values();

    $notFinalForQty = $activeIdpoList
        ->diff($finalComRemapped)
        ->values();

    $qtyNotFinal = $notFinalForQty->sum(fn ($idpo) => $qtyPerIdpo->get($idpo, 0));
    $qtyPass = $passRemapped->sum(fn ($idpo) => $qtyPerIdpo->get($idpo, 0));
    $qtyReject = $rejectRemapped->sum(fn ($idpo) => $qtyPerIdpo->get($idpo, 0));

    // --- OUTPUT: samakan persis dengan mekanisme buildPriorityFinalData ---
    // ambil seluruh idpo dalam keluarga combine_pro (bukan cuma pass/reject/notfinal),
    // query output-nya per idpo, baru remap pakai buildRerouteMap() (full move,
    // bukan proporsional split seperti redistributeReroutedOutput).
    $notFinalRawCandidates = $split['overdue']->merge($split['need_final'])
        ->unique()->values();

    $allRelevantIdpo = $finalComIdpoList
        ->merge($notFinalRawCandidates)
        ->unique()->values();

    $combineProList = $this->comboUniverse ?? HistoryDataBreakdown::whereIn('idpo', $allRelevantIdpo)
        ->pluck('combine_pro')->filter()->unique()->values();

    $allHistoryIdpo = $combineProList->isEmpty()
        ? $allRelevantIdpo
        : HistoryDataBreakdown::whereIn('combine_pro', $combineProList)
            ->pluck('idpo')->filter()->unique()->values();

    $outputRows = OutputDetail::query()
        ->whereIn("$od.idpo", $allHistoryIdpo)
        ->whereNotNull("$od.barcode")
        ->leftJoin("$odp", "$odp.barcode", '=', "$od.barcode")
        ->select(
            "$od.idpo",
            DB::raw("COUNT(DISTINCT $odp.id_set) as total_output")
        )
        ->groupBy("$od.idpo")
        ->get();

    $rerouteMap = $this->buildRerouteMap($outputRows->pluck('idpo')->unique()->values());

    $outputPerIdpo = collect();
    foreach ($outputRows as $row) {
        $activeIdpo = $rerouteMap->get((string) $row->idpo, (string) $row->idpo);
        $outputPerIdpo->put(
            $activeIdpo,
            $outputPerIdpo->get($activeIdpo, 0) + (int) $row->total_output
        );
    }

    $outputPass = $passRemapped->sum(fn ($idpo) => $outputPerIdpo->get((string) $idpo, 0));
    $outputReject = $rejectRemapped->sum(fn ($idpo) => $outputPerIdpo->get((string) $idpo, 0));
    $outputNotFinal = $notFinalForQty->sum(fn ($idpo) => $outputPerIdpo->get((string) $idpo, 0));

    $qtyInspectNotFinal = 0;

    $progressPass = $qtyPass > 0
        ? round(($outputPass / $qtyPass) * 100, 2)
        : 0;

    $progressReject = $qtyReject > 0
        ? round(($outputReject / $qtyReject) * 100, 2)
        : 0;

    $progressNotFinal = $qtyNotFinal > 0
        ? round(($outputNotFinal / $qtyNotFinal) * 100, 2)
        : 0;

    $totalPoAll = $poNoDefect + $poWithDefect + $countNotFinal;
    $totalQtyOrderAll = $qtyPass + $qtyReject + $qtyNotFinal;
    $totalQtyInspectAll = $qtyInspectPass + $qtyInspectReject;
    $totalOutputAll = $outputPass + $outputReject + $outputNotFinal;

    $totalProgressOutputAll = $totalQtyOrderAll > 0
        ? round(($totalOutputAll / $totalQtyOrderAll) * 100, 2)
        : 0;

    return [
        'data' => [[
            'pass' => [
                'count' => $poNoDefect,
                'qty' => $qtyPass,
                'qty_inspect' => $qtyInspectPass,
                'output' => $outputPass,
                'progress_output' => $progressPass,
            ],
            'reject' => [
                'count' => $poWithDefect,
                'qty' => $qtyReject,
                'qty_inspect' => $qtyInspectReject,
                'output' => $outputReject,
                'progress_output' => $progressReject,
            ],
            'not_final' => [
                'count' => $countNotFinal,
                'qty' => $qtyNotFinal,
                'qty_inspect' => $qtyInspectNotFinal,
                'output' => $outputNotFinal,
                'progress_output' => $progressNotFinal,
            ],
            'total' => [
                'total_po' => $totalPoAll,
                'qty_order' => $totalQtyOrderAll ?: 0,
                'qty_inspect' => $totalQtyInspectAll ?: 0,
                'output' => $totalOutputAll ?: 0,
                'progress_output' => $totalProgressOutputAll,
            ],
        ]],
    ];
}