private array $rerouteTargetCache = [];

private function getRerouteTargetMap(Collection $combineProList): Collection
{
    $key = md5($combineProList->sort()->implode(','));
    if (isset($this->rerouteTargetCache[$key])) {
        return $this->rerouteTargetCache[$key];
    }

    $owner = $this->getOwnerByCombineKpItem($combineProList);
    $rows = $this->getHistoryRowsByCombinePro($combineProList);

    $map = $rows
        ->filter(fn ($r) => $r->revisi_kp == 1 && !is_null($r->kp_item_ref))
        ->mapWithKeys(function ($r) use ($owner) {
            $original = $owner->get($r->combine_pro . '|' . $r->kp_item_ref);
            return ($original && $original !== (string) $r->idpo)
                ? [(string) $original => (string) $r->idpo] : [];
        });

    // hanya idpo lama yang qtypo-nya sudah habis yang dipindah ke idpo baru
    $exhausted = $this->getLastHistoryPoRevisi($map->keys()->map(fn ($v) => (string) $v))
        ->filter(fn ($r) => (int) $r->qtypo === 0)
        ->keys()->map(fn ($v) => (string) $v)->flip();

    return $this->rerouteTargetCache[$key] = $map->filter(
        fn ($child, $orig) => $exhausted->has((string) $orig)
    );
}

