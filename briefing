<script setup>
import { ref, onMounted, onUnmounted, computed } from "vue";
import { Bars3Icon, XMarkIcon, ChevronDownIcon, ExclamationTriangleIcon, } from "@heroicons/vue/24/solid";
import { useAuthStore } from "@/stores/auth";
import { useMenuStore } from "@/stores/menus";
import { useRouter } from "vue-router";
import { useLoadingStore } from "@/stores/loading";
import UiButton from "@/components/ui/UiButton.vue";
import { RouterView } from "vue-router";

const authStore = useAuthStore();
const router = useRouter();
const loading = useLoadingStore();
const user_sign_out = ref(false);

const menuStore = useMenuStore();
const menus = computed(() => menuStore.menus);

const sidebarOpen = ref(false);
const openMenu = ref(null);

const toggleMenu = (id) => {
    openMenu.value = openMenu.value === id ? null : id;
};

const sign_out = () => {
    user_sign_out.value = !user_sign_out.value;
};

const handleClickOutside = (event) => {
    const userDetails = document.getElementById("user-sign-out");

    if (userDetails && !userDetails.contains(event.target)) {
        user_sign_out.value = false;
    }
};

onMounted(() => {
    document.addEventListener("click", handleClickOutside);
});

onUnmounted(() => {
    document.removeEventListener("click", handleClickOutside);
});

const initials = computed(() => {
    return (authStore.name || "")
        .trim()
        .split(/\s+/)
        .slice(0, 2)
        .map((name) => name.charAt(0).toUpperCase())
        .join("");
});

const firstName = computed(() => {
    return (authStore.name || "").trim().split(/\s+/)[0];
});

const signOut = async () => {
    loading.show();
    try {
        await authStore.logout();
        await new Promise((resolve) => setTimeout(resolve, 1000));
        await router.push("/login");
    } finally {
        loading.hide();
    }
};
const home = () => {
    loading.show();
    router.push("/mainmenu");
    loading.hide();
};
</script>

