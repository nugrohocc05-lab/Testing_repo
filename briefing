<template>
    <div class="px-6">
        <UiTitle align="center" title="Data Material" subtitle="Lorem Ipsum Dolores Amet" />

        <div class="mb-4 flex w-full flex-col gap-3 lg:flex-row lg:items-end">
            <!-- Buyer -->
            <div class="w-full lg:w-60">
                <UiMultiSelect v-model="form.kk" label="KK" :options="kk" placeholder="-- Select KK --" @change="loadDataKp" />
            </div>

            <!-- KP -->
            <div class="w-full lg:w-60">
                <UiMultiSelect
                    v-model="form.kp"
                    :options="kpno"
                    label="KP"
                    placeholder="-- Select KP --"
                />
            </div>

            <!-- Action -->
            <div class="flex w-full flex-col gap-3 lg:ml-auto lg:w-auto lg:flex-row lg:items-end">
                <!-- Export -->
                <div class="flex items-center justify-start gap-1">
                    <UiButton variant="teritary" class="shrink-0">
                        <i class="fa-regular text-2xl fa-file-pdf"></i>
                    </UiButton>

                    <UiButton variant="teritary" class="shrink-0">
                        <i class="fa-regular text-2xl fa-file-excel"></i>
                    </UiButton>
                </div>
                <!-- Search -->
                <div class="w-full sm:w-50">
                    <UiInput v-model="searchKeyword" placeholder="Search" class="w-full rounded-lg">
                        <template #prefix>
                            <MagnifyingGlassIcon class="h-5 w-5 text-gray-400" />
                        </template>
                    </UiInput>
                </div>
            </div>
        </div>

        <AgGridVue :theme="theme" :rowData="rawData" :columnDefs="columnDefs" :defaultColDef="defaultColDef"
            :pagination="true" :paginationPageSize="10" :paginationPageSizeSelector="[5, 10, 20, 50, 100]"
            domLayout="autoHeight" class="mb-10 my-zebra-grid" style="width: 100%;" :quickFilterText="searchKeyword" />
    </div>

    <UiModal v-model="showModal" :title="`Import KK`" size="md">
        <div class="space-y-3 -mt-3">
            <UiInput label="KK" placeholder="Input KK" v-model="form.kk"></UiInput>
            <UiMultiSelect label="Factory CMT" placeholder="-- Select Factory --"></UiMultiSelect>
        </div>
        <template #footer>
            <div class="flex justify-end">
                <UiButton @click="showModal = false; isNewData = null" variant="danger">Cancel</UiButton>
                <UiButton @click="isNewData ? storeNewData() : submit()" :disabled="!isFormChanged" class="ml-3">Save
                </UiButton>
            </div>
        </template>
    </UiModal>
</template>

<script setup>
import { ref, onMounted, computed, defineComponent, h, watch } from "vue";
import { useRouter } from "vue-router";
import { AgGridVue } from "ag-grid-vue3";
import { ModuleRegistry, AllCommunityModule, themeQuartz } from "ag-grid-community";
import { useLoadingStore } from "@/stores/loading";
import { ChevronDownIcon, PencilSquareIcon, TrashIcon, MagnifyingGlassIcon } from "@heroicons/vue/24/outline";
import { customSwal } from "@/composable/customSwal";
const { confirmDelete, success, warning, error } = customSwal;

import UiButton from "@/components/ui/UiButton.vue"
import UiInput from "@/components/ui/UiInput.vue"
import UiModal from "@/components/ui/UiModal.vue"
import UiCheckbox from "@/components/ui/UiCheckbox.vue"
import UiTitle from "@/components/ui/UiTitle.vue"
import UiMultiSelect from "@/components/ui/UiMultiSelect.vue"


import api from "@/services/api";
import Swal from "sweetalert2"

import "sweetalert2/dist/sweetalert2.min.css"
import '@vuepic/vue-datepicker/dist/main.css'


ModuleRegistry.registerModules([AllCommunityModule]);

const loading = useLoadingStore();
const router = useRouter();
const rawData = ref([]);
const theme = themeQuartz;
const dataSelected = ref([]);
const action = ref("");
const isNewData = ref(false)
const showModal = ref(false)
const showAddress = ref(false)
const searchKeyword = ref('')
const originalForm = ref(null)
const kpno = ref([]);
const kk = ref([]);

const defaultColDef = {
    sortable: true,
    filter: false,
    resizable: true,
};

const form = ref({
    kk: "",
    kp: "",
});

const maxDate = new Date()
maxDate.setFullYear(maxDate.getFullYear() - 5)

const isFormChanged = computed(() => {
    if (!originalForm.value) return false

    return Object.keys(form.value).some(
        key => form.value[key] !== originalForm.value[key]
    )
})

const setForm = () => {
    const data = dataSelected.value;

    if (!data) return;
    form.value = {
        idbuyer: data.idbuyer ?? "",
        namabuyer: data.namabuyer ?? "",
    };
    isNewData.value = false;
    originalForm.value = { ...form.value }
};


const setNewData = () => {
    isNewData.value = true
    dataSelected.value = "New Data";
    action.value = "Add";

    form.value = {
        idbuyer: "",
        namabuyer: "",
    };

    originalForm.value = { ...form.value }
    showModal.value = true
};

const closeModal = () => {
    showModal.value = false;
    isNewData.value = false;
};

const ActionRenderer = defineComponent({
    props: {
        params: {
            type: Object,
            required: true,
        },
    },

    setup(props) {

        const editData = () => {
            dataSelected.value = props.params.data;
            action.value = "Edit Data";
            setForm();
            showModal.value = true;
        };

        const deleteData = () => {
            dataSelected.value = props.params.data;
            deleteThisData()
        };

        return () =>
            h(
                "div",
                {
                    class: "flex h-full items-center justify-center gap-3",
                },
                [
                    h(
                        "button",
                        {
                            type: "button",
                            title: "Edit",
                            class:
                                "cursor-pointer text-blue-500 transition hover:text-blue-700",
                            onClick: editData,
                        },
                        [
                            h(PencilSquareIcon, {
                                class: "h-5 w-5",
                            }),
                        ],
                    ),

                    h(
                        "button",
                        {
                            type: "button",
                            title: "Delete",
                            class: "cursor-pointer text-red-500 hover:text-red-700",
                            onClick: deleteData,
                        },
                        [
                            h(TrashIcon, {
                                class: "h-5 w-5",
                            }),
                        ],
                    ),
                ],
            );
    },
});

const columnDefs = [
    {
        headerName: "No",
        field: "no",
        width: 70,
        sortable: false,
        filter: false,
        resizable: false,
    },
    {
        field: "kk",
        headerName: "KK",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "kpno",
        headerName: "KP",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "po",
        headerName: "PO",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "combine_pro",
        headerName: "PRO",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "po_sap",
        headerName: "PO CMT",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "Style",
        headerName: "Style",
        minWidth: 125,
        flex: 1,
    },
    {
        field: "Delivery Date",
        headerName: "Delivery Date",
        minWidth: 125,
        valueGetter: (params) => {
            return params.data?.alias ?? "-";
        },
        flex: 1,
    },
    {
        field: "CM Factory",
        headerName: "CM Factory",
        minWidth: 150,
        valueGetter: (params) => {
            return params.data?.alias ?? "-";
        },
        flex: 1,
    },
    {
        field: "Qty",
        headerName: "Qty",
        minWidth: 80,
        valueGetter: (params) => {
            return params.data?.qty ?? "-";
        },
        flex: 1,
    },
    {
        field: "status",
        headerName: "status",
        minWidth: 150,
        valueGetter: (params) => {
            return params.data?.negarabill ?? "-";
        },
        flex: 1,
    },
    {
        headerName: "Action",
        minWidth: 80,
        maxWidth: 80,
        sortable: false,
        filter: false,
        resizable: false,
        cellRenderer: ActionRenderer,
    },
];

const loadData = async () => {
    try {
        if (!form.value.kk || !form.value.kp) {
            rawData.value = [];
            return;
        }

        loading.show();

        const endpoint =
            `/api/v1/datamaterial/getdata?` +
            `kk=${encodeURIComponent(form.value.kk)}` +
            `&kpno=${encodeURIComponent(form.value.kp)}`;

        console.log("KK:", form.value.kk);
        console.log("KP:", form.value.kp);
        console.log("Endpoint:", endpoint);

        const { data } = await api.get(endpoint);

        console.log("API Response:", data);

        rawData.value = (data?.data ?? []).map((item, index) => ({
            ...item,
            no: index + 1,
        }));

        console.log("Grid Data:", rawData.value);

    } catch (err) {
        console.error("LOAD DATA ERROR:", err);

        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

const loadDataKk = async () => {
    try {
        loading.show();

        const endpoint = "/api/v1/datamaterial/getkk";

        const { data } = await api.get(endpoint);

        kk.value = (data?.data ?? []).map((item) => ({
            value: item,
            label: item,
        }));
    } catch (err) {
        console.error("LOAD KK ERROR:", err);

        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

const loadDataKp = async () => {
    try {
        form.value.kp = "";
        kpno.value = [];

        if (!form.value.kk) {
            return;
        }

        loading.show();

        const endpoint = `/api/v1/datamaterial/getkpno?kk=${form.value.kk}`;

        console.log(form.value.kk);

        const { data } = await api.get(endpoint);
        kpno.value = (data?.data ?? []).map((item) => ({
            value: item.kpno ?? item,
            label: item.kpno ?? item,
        }));

    } catch (err) {
        console.error("LOAD KP ERROR:", err);

        if (err?.response?.status === 401) {
            router.push("/login");
        }
    } finally {
        loading.hide();
    }
};

onMounted(() => {
    loadDataKk();
    loadDataKp();
});

const storeNewData = async () => {
    try {

        if (
            !form.value.alias ||
            !form.value.namabuyer
        ) {
            await warning({
                title: "Incomplete Data",
                text: "Please complete all required fields.",
            });
            return
        }

        loading.show()
        const endpoint = "api/v1/master/add-buyer";
        const { data } = await api.post(
            endpoint,
            form.value
        );
        isNewData.value = false
        closeModal()
        loading.hide()
        await success({
            title: "Success",
            text: data?.message || "Data updated successfully.",
        });
        await loadData()

    } catch (err) {
        loading.hide()
        if (err?.response?.status === 401) {
            router.push("/login")
            return
        }

        await error({
            title: "Update Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to update the data. Please try again.",
        });
    }
}

const submit = async () => {
    try {
        loading.show()

        const endpoint = `api/v1/master/update-buyer/${dataSelected.value.idbuyer}`;
        const { data } = await api.put(
            endpoint,
            form.value
        );

        closeModal()
        loading.hide()
        await success({
            title: "Success",
            text: data?.message || "Data updated successfully.",
        });
        await loadData()
    } catch (err) {
        loading.hide()
        if (err?.response?.status === 401) {
            router.push("/login")
            return
        }

        await error({
            title: "Update Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to update the data. Please try again.",
        });
    }
}

const deleteThisData = async () => {

    const result = await confirmDelete();
    if (!result.isConfirmed) {
        return
    }

    try {
        loading.show()

        const { data } = await api.delete(
            `api/v1/master/delete-buyer/${dataSelected.value.idbuyer}`
        )

        loading.hide()
        await success({
            title: "Success",
            text: data?.message || "Data has been deleted successfully.",
        });
        await loadData()

    } catch (err) {

        if (err?.response?.status === 401) {
            router.push("/login")
            return
        }

        loading.hide()
        await error({
            title: "Update Failed",
            text:
                err?.response?.data?.message ||
                err?.message ||
                "Failed to update the data. Please try again.",
        });
    }
}
</script>
