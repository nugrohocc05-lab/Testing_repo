<script setup>
import { exportToPdf } from '@/utils/pdfExporter';
import { exportToExcel } from "@/utils/excelExporter";
import { getCurrentDateTime } from '@/utils/date';
import { encrypt } from "@/utils/crypto";

import { ref, shallowRef, onMounted, computed, defineComponent, h } from "vue";
import { useRouter } from "vue-router";
import { useLoadingStore } from "@/stores/loading";
import { ArrowUturnLeftIcon, DocumentArrowUpIcon, ExclamationCircleIcon, InformationCircleIcon, MagnifyingGlassIcon } from "@heroicons/vue/24/outline";

import { customSwal } from "@/composable/customSwal";
const { success, warning, error } = customSwal;
const { datetime } = getCurrentDateTime('-', '-');

import UiButton from "@/components/ui/UiButton.vue"
import UiInput from "@/components/ui/UiInput.vue"
import UiModal from "@/components/ui/UiModal.vue"
import UiTitle from "@/components/ui/UiTitle.vue"
import UiMultiSelect from "@/components/ui/UiMultiSelect.vue"
import UiAgGrid from '@/components/ui/UiAgGrid.vue';
import UiTooltip from '@/components/ui/UiTooltip.vue';

import api from "@/services/api";

defineOptions({ name: 'Allocation' });

const BASE = "/api/v1/order-artwork";
const MAX_FILE_SIZE = 2 * 1024 * 1024; // 2MB
const ALLOWED_EXT = ["pdf", "xls", "xlsx"];

const loading = useLoadingStore();
const router = useRouter();

const rawData = shallowRef([]);
const allData = shallowRef([]);

const buyers = ref([]);
const data_kp = ref([]);
const pos = ref([]);
const dataSelected = ref([]);
const showModal = ref(false);
const showModalUndo = ref(false);
const searchKeyword = ref('');
const gridApi = ref(null);

// state modal upload
const selectedUploadData = ref(null);
const selectedUndoData = ref(null);
const kkOptions = ref([]);
const selectedKk = ref("");
const kkbcFile = ref(null);       // File yang dipilih (belum diupload)
const kkbcFileName = ref("");     // Nama file yang sudah tersimpan di server
const dropzoneKey = ref(0);       // untuk reset dropzone

const hasKkbc = computed(() => !!kkbcFileName.value);

const filters = ref([
    { value: "po", label: "PO" },
    { value: "kp", label: "KP" },
]);

const form = ref({
    filter: "",
    buyer: "",
    kpno: "",
    po: "",
});

const onGridReady = (params) => {
    gridApi.value = params.api;
};

const getErrMsg = (err, fallback = "Something went wrong") =>
    err?.response?.data?.message ?? fallback;

/* ---------------- Export ---------------- */
const onBtnExport = () => {
    if (!gridApi.value) {
        alert("Please Wait!");
        return;
    }

    const fileName = `orders-artwork-${datetime.replace(' ', '_')}.xlsx`;
    exportToExcel({
        title: `Orders Artwork Allocation Report ${datetime}`,
        fileName: fileName,
        sheetName: "Orders Artwork",
        headers: ["NO", "PO", "KP", "Order Number", "Style", "CM Factory", "PO CMT", "Status"],
        fields: ["no", "po", "kpno", "ordernumber", "style", "factory", "po_sap", "status"],
        gridData: gridApi
    });
};

const onBtnExportPdf = () => {
    if (!gridApi.value) {
        alert("Please Wait!");
        return;
    }

    const nameFile = `orders-artwork-${datetime.replace(' ', '_')}`;
    exportToPdf({
        title: `Orders Artwork Allocation Report ${datetime}`,
        fileName: `${nameFile}`,
        headers: ["NO", "PO", "KP", "Order Number", "Style", "CM Factory", "PO CMT", "Status"],
        fields: ["no", "po", "kpno", "ordernumber", "style", "factory", "po_sap", "status"],
        gridData: gridApi,
        orientation: 'l'
    });
};

/* ---------------- Modal helpers ---------------- */
const resetUploadState = () => {
    selectedUploadData.value = null;
    kkOptions.value = [];
    selectedKk.value = "";
    kkbcFile.value = null;
    kkbcFileName.value = "";
    dropzoneKey.value++;
};

const closeModal = () => {
    showModal.value = false;
    resetUploadState();
};

const closeUndoModal = () => {
    showModalUndo.value = false;
    selectedUndoData.value = null;
};

/* ---------------- KK: dropdown & save ---------------- */
const loadKkOptions = async (kpno) => {
    try {
        const { data } = await api.get(`${BASE}/selectkk`, { params: { kpno } });
        kkOptions.value = (data?.data ?? []).map((item) => ({
            value: item.kk,
            label: item.kk,
        }));
    } catch (err) {
        kkOptions.value = [];
        if (err?.response?.status === 401) router.push("/login");
        else error(getErrMsg(err, "Failed to load KK list"));
    }
};

const openUploadModal = async (row) => {
    resetUploadState();
    selectedUploadData.value = row;
    selectedKk.value = row?.kk ?? "";
    kkbcFileName.value = row?.kkbc ?? "";   // nama file KK BC yang sudah ada (jika ada)
    showModal.value = true;

    loading.show();
    await loadKkOptions(row?.kpno);
    loading.hide();
};

const saveKk = async () => {
    if (!selectedKk.value) return warning("Please select KK first");

    try {
        loading.show();
        const id = selectedUploadData.value.id;
        const { data } = await api.put(`${BASE}/update-kk/${id}`, { kk: selectedKk.value });
        success(data?.message ?? "KK saved");
        selectedUploadData.value.kk = selectedKk.value;
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
        else error(getErrMsg(err, "Failed to save KK"));
    } finally {
        loading.hide();
    }
};

/* ---------------- KK BC: pilih, upload, download, delete ---------------- */
const onFileChange = (e) => {
    // dukung event native, FileList, array, atau File langsung
    const file = e?.target?.files?.[0] ?? e?.[0] ?? (e instanceof File ? e : null);

    if (!file) {
        kkbcFile.value = null;
        return;
    }

    const ext = file.name.split(".").pop().toLowerCase();
    if (!ALLOWED_EXT.includes(ext)) {
        warning("Only PDF, XLS, or XLSX formats are allowed");
        kkbcFile.value = null;
        dropzoneKey.value++;
        return;
    }
    if (file.size > MAX_FILE_SIZE) {
        warning("File size must not exceed 2MB");
        kkbcFile.value = null;
        dropzoneKey.value++;
        return;
    }

    kkbcFile.value = file;
};

const uploadKkbc = async () => {
    if (!kkbcFile.value) return warning("Please choose a file first");

    try {
        loading.show();
        const id = selectedUploadData.value.id;
        const fd = new FormData();
        fd.append("file", kkbcFile.value);

        const { data } = await api.post(`${BASE}/upload-kkbc/${id}`, fd, {
            headers: { "Content-Type": "multipart/form-data" },
        });

        success(data?.message ?? "File uploaded");
        kkbcFileName.value = data?.data?.filename ?? kkbcFile.value.name;
        kkbcFile.value = null;
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
        else error(getErrMsg(err, "Failed to upload file"));
    } finally {
        loading.hide();
    }
};

const downloadKkbc = async () => {
    try {
        loading.show();
        const id = selectedUploadData.value.id;
        const res = await api.get(`${BASE}/showfille/${id}`, { responseType: "blob" });

        const url = URL.createObjectURL(res.data);
        const a = document.createElement("a");
        a.href = url;
        a.download = kkbcFileName.value || "kkbc";
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
        else error(getErrMsg(err, "Failed to download file"));
    } finally {
        loading.hide();
    }
};

const deleteKkbc = async () => {
    if (!window.confirm("Delete this KK BC file?")) return;

    try {
        loading.show();
        const id = selectedUploadData.value.id;
        const { data } = await api.delete(`${BASE}/delete/${id}`);
        success(data?.message ?? "File deleted");
        kkbcFileName.value = "";
        kkbcFile.value = null;
        dropzoneKey.value++;
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
        else error(getErrMsg(err, "Failed to delete file"));
    } finally {
        loading.hide();
    }
};

/* ---------------- Complete Upload ---------------- */
const submitForm = async () => {
    if (!hasKkbc.value) return warning("Please upload KK BC file first");

    try {
        loading.show();
        const id = selectedUploadData.value.id;
        const { data } = await api.post(`${BASE}/complete/${id}`);
        success(data?.message ?? "Upload completed");
        closeModal();
        await fetchGrid(currentQuery);
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
        else error(getErrMsg(err, "Failed to complete upload"));
    } finally {
        loading.hide();
    }
};

/* ---------------- Undo / Cancel Complete ---------------- */
const process = async () => {
    if (!selectedUndoData.value) return;

    try {
        loading.show();
        const id = selectedUndoData.value.id;
        const { data } = await api.post(`${BASE}/cancel-complete/${id}`);
        success(data?.message ?? "Waiting list has been undone");
        closeUndoModal();
        await fetchGrid(currentQuery);
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
        else error(getErrMsg(err, "Failed to undo"));
    } finally {
        loading.hide();
    }
};

/* ---------------- Action column ---------------- */
const ActionRenderer = defineComponent({
    props: {
        params: {
            type: Object,
            required: true,
        },
    },

    setup(props) {
        const detailData = () => {
            dataSelected.value = props.params.data;

            const id = dataSelected.value.id;
            const encryptedid = encrypt(id);

            router.push({
                name: "order-artwork-allocation-detail",
                params: {
                    id: encodeURIComponent(encryptedid),
                },
            });
        };

        const uploadkk = () => openUploadModal(props.params.data);

        const undoUpload = () => {
            selectedUndoData.value = props.params.data;
            showModalUndo.value = true;
        };

        return () => {
            return h(
                "div",
                { class: "flex h-full gap-2" },
                [
                    h(
                        "button",
                        {
                            type: "button",
                            title: "Detail",
                            class: "cursor-pointer text-amber-500 transition hover:text-amber-700",
                            onClick: detailData,
                        },
                        [h(InformationCircleIcon, { class: "h-5 w-5" })],
                    ),

                    (props.params.data?.status === "New") &&
                    h(
                        "button",
                        {
                            type: "button",
                            title: "Upload KK",
                            class: "cursor-pointer text-sky-500 transition hover:text-sky-700",
                            onClick: uploadkk,
                        },
                        [h(DocumentArrowUpIcon, { class: "h-5 w-5" })],
                    ),

                    (props.params.data?.status === "Waiting") &&
                    h(
                        "button",
                        {
                            type: "button",
                            title: "Undo Waiting List",
                            class: "cursor-pointer text-red-500 transition hover:text-red-700",
                            onClick: undoUpload,
                        },
                        [h(ArrowUturnLeftIcon, { class: "h-5 w-5" })],
                    ),
                ],
            );
        };
    },
});

const columnDefs = [
    { headerName: "No", field: "no", width: 80, filter: false, resizable: false },
    { field: "po", headerName: "PO", minWidth: 125, flex: 1 },
    { field: "kpno", headerName: "KP", minWidth: 125, flex: 1 },
    { field: "ordernumber", headerName: "Order Number", minWidth: 125, flex: 1 },
    { field: "style", headerName: "Style", minWidth: 125, flex: 1 },
    {
        field: "factory",
        headerName: "CM Factory",
        minWidth: 150,
        valueGetter: (params) => params.data?.factory ?? "-",
        flex: 1,
    },
    { field: "po_sap", headerName: "PO CMT", minWidth: 125, flex: 1 },
    { field: "status", headerName: "Status", minWidth: 125, flex: 1 },
    {
        headerName: "Action",
        maxWidth: 150,
        sortable: false,
        filter: false,
        resizable: false,
        cellRenderer: ActionRenderer,
    },
];

/* ---------------- Fetch data ---------------- */
let reqId = 0;
let currentQuery = "";   // simpan filter aktif supaya refresh tetap di filter yang sama

const fetchGrid = async (query = "") => {
    const id = ++reqId;
    currentQuery = query;
    try {
        loading.show();
        const { data } = await api.get(`${BASE}/getdata${query}`);
        if (id !== reqId) return;

        const rows = (data?.data ?? []).map((item, index) => ({
            ...item,
            no: index + 1,
        }));
        rawData.value = rows;
        if (!query) allData.value = rows;
        else allData.value = [];   // cache "all" dianggap basi setelah ada perubahan
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
    } finally {
        loading.hide();
    }
};

const loadData = () => fetchGrid();

const showAll = () => {
    if (allData.value.length) {
        rawData.value = allData.value;
        currentQuery = "";
    } else fetchGrid();
};

const loadDataBuyer = async () => {
    try {
        loading.show();
        const { data } = await api.get(`${BASE}/buyers`);
        buyers.value = (data?.data ?? []).map((item) => ({
            value: item.idbuyer,
            label: item.namabuyer,
        }));
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
    } finally {
        loading.hide();
    }
};

const loadDataPo = async () => {
    try {
        loading.show();
        const { data } = await api.get(`${BASE}/pos`);
        pos.value = (data?.data ?? []).map((item) => ({
            value: item.po,
            label: item.po,
        }));
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
    } finally {
        loading.hide();
    }
};

const loadDataKp = async (idbuyer) => {
    try {
        loading.show();
        const { data } = await api.get(`${BASE}/kps?idbuyer=${idbuyer}`);
        data_kp.value = (data?.data ?? []).map((item) => ({
            value: item.kpno,
            label: item.kpno,
        }));
    } catch (err) {
        if (err?.response?.status === 401) router.push("/login");
    } finally {
        loading.hide();
    }
};

const onFilterChange = (val) => {
    form.value = { filter: val ?? "", buyer: "", kpno: "", po: "" };
    data_kp.value = [];
    showAll();
    if (val === "po" && !pos.value.length) loadDataPo();
};

const onBuyerChange = async (idbuyer) => {
    form.value.kpno = "";
    data_kp.value = [];
    if (!idbuyer) return showAll();
    await loadDataKp(idbuyer);
};

const loadDataByPo = (po) => (po ? fetchGrid(`?po=${po}`) : showAll());
const loadDataByKp = (kpno) => (kpno ? fetchGrid(`?kpno=${kpno}`) : showAll());

onMounted(() => {
    loadData();
    loadDataBuyer();
});
</script>
```

Asumsi yang tadi masih berlaku, jadi tolong cek lagi. Kalau ada yang tidak cocok dengan backend Anda, kirim contoh response `getdata` dan `selectkk`, nanti saya sesuaikan.