private function getLeafHistoryRows(
    Request $request, $familyColumn = 'combine_pro', $applyPoFilter = true,
    $fromDate = null, $toDate = null
) {
    $cacheKey = md5(json_encode([...])); // sama seperti sebelumnya
    if (array_key_exists($cacheKey, $this->leafRowsCache)) {
        return $this->leafRowsCache[$cacheKey];
    }

    $po = (new PurchaseOrder())->getTable();
    $dbr = (new HistoryDataBreakdown())->getTable();

    // TANPA filter tanggal — supaya baris reroute penerus ikut ke-fetch
    // dan status leaf/superseded terhitung benar.
    $baseQuery = HistoryDataBreakdown::query()
        ->join($po, "$po.idpo", '=', "$dbr.idpo")
        ->where("$dbr.production_status", "IH");

    if ($request->filled('groupbuyer') && $request->groupbuyer !== 'all') {
        $buyerIds = Buyer::where('groupbuyer', $request->groupbuyer)->pluck('idbuyer');
        $baseQuery->whereIn("$po.idbuyer", $buyerIds);
    }
    if ($applyPoFilter && $request->filled('po') && $request->po !== 'all') {
        $resolvedIdpo = $this->resolveRerouteIdpo($request->po);
        $baseQuery->whereIn("$dbr.idpo", $resolvedIdpo);
    }
    if ($request->filled('style') && $request->style !== 'all') {
        $baseQuery->where("$po.idstyle", $request->style);
    }

    $rawRows = $baseQuery->select(
        "$dbr.idpo", "$dbr.idcolor", "$dbr.qty_ori", "$dbr.kp_item",
        "$dbr.kp_item_ref", "$dbr.revisi_kp", "$dbr.deliverydate",
        "$dbr.$familyColumn as family_key", "$po.po", "$po.idbuyer", "$po.idstyle"
    )->get();

    $deduped = $rawRows
        ->groupBy(fn ($r) => $r->idpo . '|' . $r->idcolor . '|' . $r->kp_item)
        ->map(fn ($group) => $group->sortByDesc('revisi_kp')->first())
        ->values();

    $refByFamily = $deduped
        ->filter(fn ($r) => !is_null($r->kp_item_ref))
        ->groupBy(fn ($r) => $r->family_key)          // fix poin 3 sekalian
        ->map(fn ($group) => $group->pluck('kp_item_ref')->unique()->values());

    $leafRows = $deduped->filter(function ($row) use ($refByFamily) {
        $refs = $refByFamily->get($row->family_key);
        return !($refs && $refs->contains($row->kp_item));
    })->values();

    // Filter tanggal DIPINDAH ke sini — diterapkan ke leaf rows yg sudah benar
    if ($fromDate && $toDate) {
        $dta = $fromDate->copy()->startOfDay();
        $dtb = $toDate->copy()->endOfDay();
    } elseif ($request->filled('datea') && $request->filled('dateb')) {
        $dateA = Carbon::createFromFormat('d-m-Y', $request->datea)->startOfDay();
        $dateB = Carbon::createFromFormat('d-m-Y', $request->dateb)->startOfDay();
        $dta = $dateA->lessThanOrEqualTo($dateB) ? $dateA : $dateB;
        $dtb = $dateA->lessThanOrEqualTo($dateB) ? $dateB->copy()->endOfDay() : $dateA->copy()->endOfDay();
    } else {
        $dta = null; $dtb = null;
    }

    if ($dta && $dtb) {
        $leafRows = $leafRows->filter(fn ($row) => $row->deliverydate
            && Carbon::parse($row->deliverydate)->between($dta, $dtb))->values();
    }

    return $this->leafRowsCache[$cacheKey] = $leafRows;
}