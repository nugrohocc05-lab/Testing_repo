    /*
    |--------------------------------------------------------------------
    | CASCADING FILTER ENDPOINTS
    | Urutan baru: ETD (datea/dateb) -> Group Buyer -> Style -> PO
    |
    | Ketiga endpoint ini pakai qualifikasi "union" dari kedua leaf-row
    | logic (getLeafHistoryRowsInRange & getLeafHistoryRows) supaya PO
    | yang qualify di Overdue ATAU di PO Need Final tetap muncul sebagai
    | pilihan. Sengaja TIDAK dipaginate karena rentang ETD sudah dibatasi
    | maksimal 31 hari dari FE, jadi volume datanya wajar ditarik sekaligus.
    |--------------------------------------------------------------------
    */

    function groupbuyer(Request $request)
    {
        preconnect(session('db'));

        if (!$request->filled('datea') || !$request->filled('dateb')) {
            return response()->json([
                'results' => [],
                'pagination' => ['more' => false],
            ]);
        }

        [$from, $to] = $this->parseDateRange($request->datea, $request->dateb);

        $idpoList = $this->getQualifiedIdpoUnion($request, $from, $to);

        if ($idpoList->isEmpty()) {
            return response()->json([
                'results' => [],
                'pagination' => ['more' => false],
            ]);
        }

        $buyerIds = PurchaseOrder::whereIn('idpo', $idpoList)
            ->pluck('idbuyer')
            ->filter()
            ->unique()
            ->values();

        $groupBuyerIds = Buyer::whereIn('idbuyer', $buyerIds)
            ->pluck('groupbuyer')
            ->filter()
            ->unique()
            ->values();

        $query = MasterGroupBuyer::select('id', 'group_name')
            ->whereIn('id', $groupBuyerIds);

        if ($request->filled('q')) {
            $query->where('group_name', 'like', '%' . $request->q . '%');
        }

        $results = $query->orderBy('group_name', 'asc')
            ->get()
            ->map(function ($item) {
                return [
                    'id' => $item->id,
                    'text' => $item->group_name,
                ];
            })
            ->values();

        return response()->json([
            'results' => $results,
            'pagination' => ['more' => false],
        ]);
    }

