    private function debugPush(Request $request, string $label, $data)
    {
        if ($request->boolean('debug')) {
            // append, JANGAN overwrite -- fungsi low-level (buildReroundAwareQualifiedRows,
            // getLeafHistoryRows, dll) bisa dipanggil beberapa kali dalam 1 request
