            // jadi tiap panggilan disimpan sebagai entry terpisah, bukan saling timpa.
            $this->debugLog[$label][] = $data;
        }
    }

    private function attachDebug(Request $request, array $response): array
    {
        if ($request->boolean('debug')) {
            $response['_debug'] = $this->debugLog;
        }
        return $response;
    }

