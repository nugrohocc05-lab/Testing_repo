    function detail($cartoncode)
    {
        $data = DB::table('mesprima1_restore.delivery_order_stocks as do')
            ->where('do.cartoncode', $cartoncode)
            ->first();

        // $id dikirim ke view sebagai identifier untuk ajax datatable (sekarang berisi cartoncode)
        return view('laboratory::reportgoodissuelab.detail', [
            'data' => $data,
            'id'   => $cartoncode,
        ]);
    }
