<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

class HomeController extends Controller
{
    public function __construct()
    {
        $this->middleware('auth');
    }

    public function index()
    {
        return view('home'); 
    }

    // --- TAMBAHKAN FUNGSI BARU ANDA DI SINI ---
    public function countTotalNotif()
    {
        $totalNotif = 0;

        // Contoh: Hitung Approval Stock
        $stockQuery = DB::table('nama_tabel_stock')->where('is_approve', null); 
        if (session('admin') != 'admin') {
            $stockQuery = $stockQuery->where('factory_id', session('db')->iddb)
                                     ->where('userid_approve', session('user')->nik);
        }
        $totalNotif += $stockQuery->count();

        return response()->json($totalNotif);
    }
}

